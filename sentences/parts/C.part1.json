   ]
  },
  {
   "id": "C.1.8-s002",
   "section": "C.1.8",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts an integer value into a float value.",
   "lines": [
    24922,
    24922
   ]
  },
  {
   "id": "C.1.8-s003",
   "section": "C.1.8",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The general error causes in clause 16.1.2 apply.",
   "lines": [
    24924,
    24924
   ]
  },
  {
   "id": "C.1.8-s004",
   "section": "C.1.8",
   "kind": "example-text",
   "context": null,
   "normative": false,
   "text": "EXAMPLE:",
   "lines": [
    24926,
    24926
   ]
  },
  {
   "id": "C.1.8-s005",
   "section": "C.1.8",
   "kind": "example-code",
