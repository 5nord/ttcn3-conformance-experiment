 "units": [
  {
   "id": "C.0-s001",
   "section": "C.0",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This annex defines the TTCN-3 predefined functions.",
   "lines": [
    24769,
    24769
   ]
  },
  {
   "id": "C.0-s002",
   "section": "C.0",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "When the general restrictions specified in clause 16.1.2 are not met, this shall cause a compile time or runtime error.",
   "lines": [
    24771,
    24774
   ]
  },
  {
   "id": "C.0-s003",
   "section": "C.0",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "Error situations for which no explicit exception-handling rule is defined in the relevant clauses of this annex shall cause a TTCN-3 compile-time or runtime error.",
   "lines": [
    24771,
    24774
   ]
  },
  {
   "id": "C.0-s004",
   "section": "C.0",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "Which error situation causes compile-time and which one runtime error is a tool implementation option.",
   "lines": [
    24771,
    24774
   ]
  },
  {
   "id": "C.1.1-s001",
   "section": "C.1.1",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "int2char(in integer invalue) return charstring",
   "lines": [
    24779,
    24781
   ]
  },
  {
   "id": "C.1.1-s002",
   "section": "C.1.1",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts an integer value in the range of 0 to 127 (8-bit encoding) into a single-character-length charstring value.",
   "lines": [
    24783,
    24784
   ]
  },
  {
   "id": "C.1.1-s003",
   "section": "C.1.1",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The integer value describes the 8-bit encoding of the character.",
   "lines": [
    24783,
    24784
   ]
  },
  {
   "id": "C.1.1-s004",
   "section": "C.1.1",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "In addition to the general error causes in clause 16.1.2, error causes are:",
   "lines": [
    24786,
    24786
   ]
  },
  {
   "id": "C.1.1-s005",
   "section": "C.1.1",
   "kind": "list-item",
   "context": null,
   "normative": true,
   "text": "`invalue is less than 0 or greater than 127.`",
   "lines": [
    24788,
    24788
   ]
  },
  {
   "id": "C.1.2-s001",
   "section": "C.1.2",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "int2unichar(in integer invalue) return universal charstring",
   "lines": [
    24791,
    24793
   ]
  },
  {
   "id": "C.1.2-s002",
   "section": "C.1.2",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts an integer value in the range of 0 to 2 147 483 647 (32-bit encoding) into a single-character-length universal charstring value.",
   "lines": [
    24795,
    24797
   ]
  },
  {
   "id": "C.1.2-s003",
   "section": "C.1.2",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The integer value describes the 32-bit encoding of the character.",
   "lines": [
    24795,
    24797
   ]
  },
  {
   "id": "C.1.2-s004",
   "section": "C.1.2",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "In addition to the general error causes in clause 16.1.2, error causes are:",
   "lines": [
    24799,
    24799
   ]
  },
  {
   "id": "C.1.2-s005",
   "section": "C.1.2",
   "kind": "list-item",
   "context": null,
   "normative": true,
   "text": "`invalue is less than 0 or greater than 2147483647.`",
   "lines": [
    24801,
    24801
   ]
  },
  {
   "id": "C.1.3-s001",
   "section": "C.1.3",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "int2bit(in integer invalue, in integer length) return bitstring",
   "lines": [
    24804,
    24806
   ]
  },
  {
   "id": "C.1.3-s002",
   "section": "C.1.3",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts a single integer value to a single bitstring value.",
   "lines": [
    24808,
    24809
   ]
  },
  {
   "id": "C.1.3-s003",
   "section": "C.1.3",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The resulting string is length bits long.",
   "lines": [
    24808,
    24809
   ]
  },
  {
   "id": "C.1.3-s004",
   "section": "C.1.3",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "For the purposes of this conversion, a bitstring shall be interpreted as a positive base 2 integer value.",
   "lines": [
    24811,
    24814
   ]
  },
  {
   "id": "C.1.3-s005",
   "section": "C.1.3",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The rightmost bit is least significant, the leftmost bit is the most significant.",
   "lines": [
    24811,
    24814
   ]
  },
  {
   "id": "C.1.3-s006",
   "section": "C.1.3",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The bits 0 and 1 represent the decimal values 0 and 1 respectively.",
   "lines": [
    24811,
    24814
   ]
  },
  {
   "id": "C.1.3-s007",
   "section": "C.1.3",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "If the conversion yields a value with fewer bits than specified in the length parameter, then the bitstring shall be padded on the left with zeros.",
   "lines": [
    24811,
    24814
   ]
  },
  {
   "id": "C.1.3-s008",
   "section": "C.1.3",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "In addition to the general error causes in clause 16.1.2, error causes are:",
   "lines": [
    24816,
    24816
   ]
  },
  {
   "id": "C.1.3-s009",
   "section": "C.1.3",
   "kind": "list-item",
   "context": null,
   "normative": true,
   "text": "`invalue is less than zero;` the conversion yields a return value with more bits than specified by length.",
   "lines": [
    24818,
    24820
   ]
  },
  {
   "id": "C.1.4-s001",
   "section": "C.1.4",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "int2enum ( in integer inpar, out Enumerated_type outpar)",
   "lines": [
    24828,
    24830
   ]
  },
  {
   "id": "C.1.4-s002",
   "section": "C.1.4",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts an integer value into an enumerated value of a given enumerated type.",
   "lines": [
    24832,
    24834
   ]
  },
  {
   "id": "C.1.4-s003",
   "section": "C.1.4",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The integer value shall be provided as in parameter and the result of the conversion shall be stored in an out parameter.",
   "lines": [
    24832,
    24834
   ]
  },
  {
   "id": "C.1.4-s004",
   "section": "C.1.4",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The type of the out parameter determines the type into which the in parameter is converted.",
   "lines": [
    24832,
    24834
   ]
  },
  {
   "id": "C.1.4-s005",
   "section": "C.1.4",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The general error causes in clause 16.1.2 apply.",
   "lines": [
    24836,
    24836
   ]
  },
  {
   "id": "C.1.4-s006",
   "section": "C.1.4",
   "kind": "example-text",
   "context": null,
   "normative": false,
   "text": "EXAMPLE:",
   "lines": [
    24838,
    24838
   ]
  },
  {
   "id": "C.1.4-s007",
   "section": "C.1.4",
   "kind": "example-code",
   "context": null,
   "normative": false,
   "text": "type enumerated MyFirstEnumType {\n     Monday, Tuesday, Wednesday, Thursday, Friday, Weekend(6..7)\n  };\n  type enumerated MySecondEnumType {\n     Saturday(-3), Sunday (0), Monday\n  };\n  //within a dynamic language element:\n  var MyFirstEnumType v_firstEnum := Tuesday;\n  var MySecondEnumType v_secondEnum := Sunday;\n  int2enum(0, v_firstEnum)  // v_firstEnum == Monday\n  int2enum(1, v_secondEnum)  // v_secondEnum == Monday\n  int2enum(6, v_firstEnum)  // v_firstEnum == Weekend(6)",
   "lines": [
    24839,
    24852
   ]
  },
  {
   "id": "C.1.5-s001",
   "section": "C.1.5",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "int2hex(in integer invalue, in integer length) return hexstring",
   "lines": [
    24856,
    24857
   ]
  },
  {
   "id": "C.1.5-s002",
   "section": "C.1.5",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts a single integer value to a single hexstring value.",
   "lines": [
    24859,
    24860
   ]
  },
  {
   "id": "C.1.5-s003",
   "section": "C.1.5",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The resulting string is length hexadecimal digits long.",
   "lines": [
    24859,
    24860
   ]
  },
  {
   "id": "C.1.5-s004",
   "section": "C.1.5",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "For the purposes of this conversion, a hexstring shall be interpreted as a positive base 16 integer value.",
   "lines": [
    24862,
    24865
   ]
  },
  {
   "id": "C.1.5-s005",
   "section": "C.1.5",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The rightmost hexadecimal digit is least significant, the leftmost hexadecimal digit is the most significant.",
   "lines": [
    24862,
    24865
   ]
  },
  {
   "id": "C.1.5-s006",
   "section": "C.1.5",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The hexadecimal digits 0 to F represent the decimal values 0 to 15 respectively.",
   "lines": [
    24862,
    24865
   ]
  },
  {
   "id": "C.1.5-s007",
   "section": "C.1.5",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "If the conversion yields a value with fewer hexadecimal digits than specified in the length parameter, then the hexstring shall be padded on the left with zeros.",
   "lines": [
    24862,
    24865
   ]
  },
  {
   "id": "C.1.5-s008",
   "section": "C.1.5",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "In addition to the general error causes in clause 16.1.2, error causes are:",
   "lines": [
    24867,
    24867
   ]
  },
  {
   "id": "C.1.5-s009",
   "section": "C.1.5",
   "kind": "list-item",
   "context": null,
   "normative": true,
   "text": "`invalue is less than zero;` the conversion yields a return value with more hexadecimal characters than specified by length.",
   "lines": [
    24869,
    24871
   ]
  },
  {
   "id": "C.1.6-s001",
   "section": "C.1.6",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "int2oct(in integer invalue, in integer length) return octetstring",
   "lines": [
    24874,
    24876
   ]
  },
  {
   "id": "C.1.6-s002",
   "section": "C.1.6",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts a single integer value to a single octetstring value.",
   "lines": [
    24878,
    24879
   ]
  },
  {
   "id": "C.1.6-s003",
   "section": "C.1.6",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The resulting string is length octets long.",
   "lines": [
    24878,
    24879
   ]
  },
  {
   "id": "C.1.6-s004",
   "section": "C.1.6",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "For the purposes of this conversion, an octetstring shall be interpreted as a positive base 16 integer value.",
   "lines": [
    24881,
    24886
   ]
  },
  {
   "id": "C.1.6-s005",
   "section": "C.1.6",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The rightmost hexadecimal digit is least significant, the leftmost hexadecimal digit is the most significant.",
   "lines": [
    24881,
    24886
   ]
  },
  {
   "id": "C.1.6-s006",
   "section": "C.1.6",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The number of hexadecimal digits provided shall be multiples of 2 since one octet is composed of two hexadecimal digits.",
   "lines": [
    24881,
    24886
   ]
  },
  {
   "id": "C.1.6-s007",
   "section": "C.1.6",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The hexadecimal digits 0 to F represent the decimal values 0 to 15 respectively.",
   "lines": [
    24881,
    24886
   ]
  },
  {
   "id": "C.1.6-s008",
   "section": "C.1.6",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "If the conversion yields a value with fewer hexadecimal digits than specified in the length parameter, then the hexstring shall be padded on the left with zeros.",
   "lines": [
    24881,
    24886
   ]
  },
  {
   "id": "C.1.6-s009",
   "section": "C.1.6",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "In addition to the general error causes in clause 16.1.2, error causes are:",
   "lines": [
    24888,
    24888
   ]
  },
  {
   "id": "C.1.6-s010",
   "section": "C.1.6",
   "kind": "list-item",
   "context": null,
   "normative": true,
   "text": "`invalue is less than zero;` the conversion yields a return value with more octets than specified by length.",
   "lines": [
    24890,
    24892
   ]
  },
  {
   "id": "C.1.7-s001",
   "section": "C.1.7",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "int2str(in integer invalue) return charstring",
   "lines": [
    24900,
    24902
   ]
  },
  {
   "id": "C.1.7-s002",
   "section": "C.1.7",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts the integer value into its string equivalent (the base of the return string is always decimal).",
   "lines": [
    24904,
    24904
   ]
  },
  {
   "id": "C.1.7-s003",
   "section": "C.1.7",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The general error causes in clause 16.1.2 apply.",
   "lines": [
    24906,
    24906
   ]
  },
  {
   "id": "C.1.7-s004",
   "section": "C.1.7",
   "kind": "example-text",
   "context": null,
   "normative": false,
   "text": "EXAMPLE:",
   "lines": [
    24908,
    24908
   ]
  },
  {
   "id": "C.1.7-s005",
   "section": "C.1.7",
   "kind": "example-code",
   "context": null,
   "normative": false,
   "text": "int2str(66)  // will return the charstring value \"66\"\n  int2str(-66)  // will return the charstring value \"-66\"\n  int2str(0)  // will return the charstring value \"0\"",
   "lines": [
    24909,
    24913
   ]
  },
  {
   "id": "C.1.8-s001",
   "section": "C.1.8",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "int2float(in integer invalue) return float",
   "lines": [
