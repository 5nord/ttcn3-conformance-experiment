   ]
  },
  {
   "id": "C.1.9-s001",
   "section": "C.1.9",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "float2int(in float invalue) return integer",
   "lines": [
    24934,
    24936
   ]
  },
  {
   "id": "C.1.9-s002",
   "section": "C.1.9",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts a float value into an integer value by removing the fractional part of the argument and returning the resulting integer.",
   "lines": [
    24938,
    24939
   ]
  },
  {
   "id": "C.1.9-s003",
   "section": "C.1.9",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "In addition to the general error causes in clause 16.1.2, error causes are:",
   "lines": [
    24941,
    24941
   ]
  },
  {
   "id": "C.1.9-s004",
   "section": "C.1.9",
   "kind": "list-item",
   "context": null,
   "normative": true,
   "text": "`invalue is infinity, -infinity or not_a_number.`",
   "lines": [
    24943,
    24943
   ]
  },
  {
   "id": "C.1.9-s005",
   "section": "C.1.9",
   "kind": "example-text",
   "context": null,
   "normative": false,
   "text": "EXAMPLE:",
   "lines": [
    24945,
    24945
   ]
  },
  {
   "id": "C.1.9-s006",
   "section": "C.1.9",
   "kind": "example-code",
   "context": null,
   "normative": false,
   "text": "float2int(3.12345E2) = float2int(312.345) = 312",
   "lines": [
    24946,
    24948
   ]
  },
  {
   "id": "C.1.10-s001",
   "section": "C.1.10",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "char2int(in charstring invalue) return integer",
   "lines": [
    24953,
    24955
   ]
  },
  {
   "id": "C.1.10-s002",
   "section": "C.1.10",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts a single-character-length charstring value into an integer value in the range of 0 to 127.",
   "lines": [
    24957,
    24958
   ]
  },
  {
   "id": "C.1.10-s003",
   "section": "C.1.10",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The integer value describes the 8-bit encoding of the character.",
   "lines": [
    24957,
    24958
   ]
  },
  {
   "id": "C.1.10-s004",
   "section": "C.1.10",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "In addition to the general error causes in clause 16.1.2, error causes are:",
   "lines": [
    24960,
    24960
   ]
  },
  {
   "id": "C.1.10-s005",
   "section": "C.1.10",
   "kind": "list-item",
   "context": null,
   "normative": true,
   "text": "length of invalue does not equal 1.",
   "lines": [
    24962,
    24962
   ]
  },
  {
   "id": "C.1.11-s001",
   "section": "C.1.11",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "char2oct(in charstring invalue) return octetstring",
   "lines": [
    24965,
    24967
   ]
  },
  {
   "id": "C.1.11-s002",
   "section": "C.1.11",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts a charstring `invalue to an octetstring.",
   "lines": [
    24969,
    24970
   ]
  },
  {
   "id": "C.1.11-s003",
   "section": "C.1.11",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "Each octet of the octetstring will` contain the Recommendation ITU-T T.50 [4] codes (according to the IRV) of the appropriate characters of invalue.",
   "lines": [
    24969,
    24970
   ]
  },
  {
   "id": "C.1.11-s004",
   "section": "C.1.11",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The general error causes in clause 16.1.2 apply.",
   "lines": [
    24972,
    24972
   ]
  },
  {
   "id": "C.1.11-s005",
   "section": "C.1.11",
   "kind": "example-text",
   "context": null,
   "normative": false,
   "text": "EXAMPLE:",
   "lines": [
    24979,
    24979
   ]
  },
  {
   "id": "C.1.11-s006",
   "section": "C.1.11",
   "kind": "example-code",
   "context": null,
   "normative": false,
   "text": "char2oct (\"Tinky-Winky\") = '54696E6B792D57696E6B79'O",
   "lines": [
    24980,
    24982
   ]
  },
  {
   "id": "C.1.12-s001",
   "section": "C.1.12",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "unichar2int(in universal charstring invalue) return integer",
   "lines": [
    24987,
    24989
   ]
  },
  {
   "id": "C.1.12-s002",
   "section": "C.1.12",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts a single-character-length universal `charstring value into an integer value in the range of` 0 to 2 147 483 647.",
   "lines": [
    24991,
    24992
   ]
  },
  {
   "id": "C.1.12-s003",
   "section": "C.1.12",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The integer value describes the 32-bit encoding of the character.",
   "lines": [
    24991,
    24992
   ]
  },
  {
   "id": "C.1.12-s004",
   "section": "C.1.12",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "In addition to the general error causes in clause 16.1.2, error causes are:",
   "lines": [
    24994,
    24994
   ]
  },
  {
   "id": "C.1.12-s005",
   "section": "C.1.12",
   "kind": "list-item",
   "context": null,
   "normative": true,
   "text": "length of invalue does not equal 1.",
   "lines": [
    24996,
    24996
   ]
  },
  {
   "id": "C.1.13-s001",
   "section": "C.1.13",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "bit2int(in bitstring invalue) return integer",
   "lines": [
    24999,
    25001
   ]
  },
  {
   "id": "C.1.13-s002",
   "section": "C.1.13",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts a single bitstring value to a single integer value.",
   "lines": [
    25003,
    25003
   ]
  },
  {
   "id": "C.1.13-s003",
   "section": "C.1.13",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "For the purposes of this conversion, a bitstring shall be interpreted as a positive base 2 integer value.",
   "lines": [
    25005,
    25007
   ]
  },
  {
   "id": "C.1.13-s004",
   "section": "C.1.13",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The rightmost bit is least significant, the leftmost bit is the most significant.",
   "lines": [
    25005,
    25007
   ]
  },
  {
   "id": "C.1.13-s005",
   "section": "C.1.13",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The bits 0 and 1 represent the decimal values 0 and 1 respectively.",
   "lines": [
    25005,
    25007
   ]
  },
  {
   "id": "C.1.13-s006",
   "section": "C.1.13",
   "kind": "note",
   "context": null,
   "normative": false,
   "text": "NOTE: On real test systems the integer interpretation of invalue may lead to an overflow problem that causes compile time or runtime error.",
   "lines": [
    25009,
    25010
   ]
  },
  {
   "id": "C.1.13-s007",
   "section": "C.1.13",
   "kind": "note",
   "context": null,
   "normative": false,
   "text": "However, this is out of the scope of the present document.",
   "lines": [
    25009,
    25010
   ]
  },
  {
   "id": "C.1.13-s008",
   "section": "C.1.13",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The general error causes in clause 16.1.2 apply.",
   "lines": [
    25012,
    25012
   ]
  },
  {
   "id": "C.1.14-s001",
   "section": "C.1.14",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "bit2hex(in bitstring invalue) return hexstring",
   "lines": [
    25015,
    25017
   ]
  },
  {
   "id": "C.1.14-s002",
   "section": "C.1.14",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts a single bitstring value to a single hexstring.",
   "lines": [
    25019,
    25020
   ]
  },
  {
   "id": "C.1.14-s003",
   "section": "C.1.14",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The resulting hexstring represents the same value as the bitstring.",
   "lines": [
    25019,
    25020
   ]
  },
  {
   "id": "C.1.14-s004",
   "section": "C.1.14",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "For the purpose of this conversion, a bitstring shall be converted into a hexstring, where the bitstring is divided into groups of four bits beginning with the rightmost bit.",
   "lines": [
    25022,
    25023
   ]
  },
  {
   "id": "C.1.14-s005",
   "section": "C.1.14",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "Each group of four bits is converted into a hex digit as follows:",
   "lines": [
    25022,
    25023
   ]
  },
  {
   "id": "C.1.14-s006",
   "section": "C.1.14",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "'0000'B → '0'H, '0001'B → '1'H, '0010'B → '2'H, '0011'B → '3'H, '0100'B → '4'H, '0101'B → '5'H,",
   "lines": [
    25025,
    25025
   ]
  },
  {
   "id": "C.1.14-s007",
   "section": "C.1.14",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "'0110'B → '6'H, '0111'B → '7'H, '1000'B → '8'H, '1001'B → '9'H, '1010'B → 'A'H, '1011'B → 'B'H,",
   "lines": [
    25027,
    25027
   ]
  },
  {
   "id": "C.1.14-s008",
   "section": "C.1.14",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "'1100'B → 'C'H, '1101'B → 'D'H, '1110'B → 'E'H, and '1111'B → 'F'H.",
   "lines": [
    25029,
    25029
   ]
  },
  {
   "id": "C.1.14-s009",
   "section": "C.1.14",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "When the leftmost group of bits does contain less than 4 bits, this group is filled with '0'B from the left until it contains exactly 4 bits and is converted afterwards.",
   "lines": [
    25031,
    25033
   ]
  },
  {
   "id": "C.1.14-s010",
   "section": "C.1.14",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The consecutive order of hex digits in the resulting hexstring is the same as the order of groups of 4 bits in the bitstring.",
   "lines": [
    25031,
    25033
   ]
  },
  {
   "id": "C.1.14-s011",
   "section": "C.1.14",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The general error causes in clause 16.1.2 apply.",
   "lines": [
    25035,
    25035
   ]
  },
  {
   "id": "C.1.14-s012",
   "section": "C.1.14",
   "kind": "example-text",
   "context": null,
   "normative": false,
   "text": "EXAMPLE:",
   "lines": [
    25037,
    25037
   ]
  },
  {
   "id": "C.1.14-s013",
   "section": "C.1.14",
   "kind": "example-code",
   "context": null,
   "normative": false,
   "text": "bit2hex ('111010111'B)= '1D7'H",
   "lines": [
    25038,
    25040
   ]
  },
  {
   "id": "C.1.15-s001",
   "section": "C.1.15",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "bit2oct(in bitstring invalue) return octetstring",
   "lines": [
    25045,
    25047
   ]
  },
  {
   "id": "C.1.15-s002",
   "section": "C.1.15",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts a single bitstring value to a single octetstring.",
   "lines": [
    25049,
    25050
   ]
  },
  {
   "id": "C.1.15-s003",
   "section": "C.1.15",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The resulting octetstring represents the same value as the bitstring.",
   "lines": [
    25049,
    25050
   ]
  },
  {
   "id": "C.1.15-s004",
   "section": "C.1.15",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "For the conversion the following holds: bit2oct(value)=hex2oct(bit2hex(value)).",
   "lines": [
    25057,
    25057
   ]
  },
  {
   "id": "C.1.15-s005",
   "section": "C.1.15",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The general error causes in clause 16.1.2 apply.",
   "lines": [
    25059,
    25059
   ]
  },
  {
   "id": "C.1.15-s006",
   "section": "C.1.15",
   "kind": "example-text",
   "context": null,
   "normative": false,
   "text": "EXAMPLE:",
   "lines": [
    25061,
    25061
   ]
  },
  {
   "id": "C.1.15-s007",
   "section": "C.1.15",
   "kind": "example-code",
   "context": null,
   "normative": false,
   "text": "bit2oct('111010111'B)= '01D7'O",
   "lines": [
    25062,
    25064
   ]
  },
  {
   "id": "C.1.16-s001",
   "section": "C.1.16",
   "kind": "code",
   "context": null,
   "normative": true,
   "text": "bit2str(in bitstring invalue) return charstring",
   "lines": [
    25069,
    25071
   ]
  },
  {
   "id": "C.1.16-s002",
   "section": "C.1.16",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "This function converts a single bitstring value to a single charstring.",
   "lines": [
    25073,
    25074
   ]
  },
  {
   "id": "C.1.16-s003",
   "section": "C.1.16",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The resulting charstring has the same length as the bitstring and contains only the characters '0' and '1'.",
   "lines": [
    25073,
    25074
   ]
  },
  {
   "id": "C.1.16-s004",
   "section": "C.1.16",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "For the purpose of this conversion, a bitstring shall be converted into a charstring.",
   "lines": [
    25076,
    25078
   ]
  },
  {
   "id": "C.1.16-s005",
   "section": "C.1.16",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "Each bit of the bitstring is converted into a character '0' or '1' depending on the value 0 or 1 of the bit.",
   "lines": [
    25076,
    25078
   ]
  },
  {
   "id": "C.1.16-s006",
   "section": "C.1.16",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The consecutive order of characters in the resulting charstring is the same as the order of bits in the bitstring.",
   "lines": [
    25076,
    25078
   ]
  },
  {
   "id": "C.1.16-s007",
   "section": "C.1.16",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The general error causes in clause 16.1.2 apply.",
   "lines": [
    25080,
    25080
   ]
  },
  {
   "id": "C.1.16-s008",
   "section": "C.1.16",
   "kind": "example-text",
   "context": null,
   "normative": false,
   "text": "EXAMPLE:",
   "lines": [
    25082,
    25082
   ]
  },
  {
   "id": "C.1.16-s009",
   "section": "C.1.16",
   "kind": "example-code",
   "context": null,
   "normative": false,
   "text": "bit2str('1110101'B) will return \"1110101\"",
   "lines": [
    25083,
    25085
   ]
  }
 ]
}
