    25098
   ]
  },
  {
   "id": "C.1.17-s006",
   "section": "C.1.17",
   "kind": "note",
   "context": null,
   "normative": false,
   "text": "NOTE: On real test systems the integer interpretation of invalue may lead to an overflow problem that causes compile time or runtime error.",
