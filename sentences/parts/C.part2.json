   ]
  },
  {
   "id": "C.1.17-s004",
   "section": "C.1.17",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The rightmost hexadecimal digit is least significant, the leftmost hexadecimal digit is the most significant.",
