   "id": "C.1.20-s003",
   "section": "C.1.20",
   "kind": "prose",
   "context": null,
   "normative": true,
   "text": "The resulting charstring has the same length as the hexstring and contains only the characters '0' to '9'and 'A' to 'F'.",
