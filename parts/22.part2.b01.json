   "type": "definition",
   "modality": "IS",
   "subject": "ent:test-component",
   "condition": null,
   "canonical": "A test component sends a message with the `send` operation, calls a procedure with the `call` operation, replies to an accepted call with the `reply` operation and raises an exception with the `raise` operation.",
