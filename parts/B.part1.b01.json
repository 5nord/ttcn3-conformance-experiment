   "section": "B.1.1",
   "type": "semantics",
   "modality": "IS",
   "subject": "ent:template-field",
   "condition": null,
   "canonical": "Unless otherwise specified, a template field containing a specific value matches the corresponding field value if, and only if, the field value is exactly the same value as the value to which the expression in the template field evaluates.",
