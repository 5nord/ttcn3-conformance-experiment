 "requirements": [
  {
   "id": "TTCN3-CORE-B.1.0-001a",
   "section": "B.1.0",
   "type": "permission",
   "modality": "MAY",
   "subject": "ent:matching-mechanism",
   "condition": null,
   "canonical": "A matching mechanism specified in annex B MAY be used in a template.",
   "original": "This annex specifies the matching mechanisms that may be used in TTCN-3 templates (and only in templates).",
   "normative": true,
   "testable": true,
   "cross_refs": [],
   "sentence_ids": [
    "B.1.0-s001"
   ],
   "examples": [],
   "ambiguity": {
    "status": "clear"
   }
  },
  {
   "id": "TTCN3-CORE-B.1.0-001b",
   "section": "B.1.0",
   "type": "restriction",
   "modality": "SHALL NOT",
   "subject": "ent:matching-mechanism",
   "condition": null,
   "canonical": "A matching mechanism SHALL NOT be used outside of a template.",
   "original": "This annex specifies the matching mechanisms that may be used in TTCN-3 templates (and only in templates).",
   "normative": true,
   "testable": true,
   "cross_refs": [],
   "sentence_ids": [
    "B.1.0-s001"
   ],
   "examples": [],
   "ambiguity": {
    "status": "ambiguous",
    "issue": "'(and only in templates)' does not say whether e.g. template instances in in-line templates, template variables and template formal parameters count as 'templates'; the broad reading (any template-typed context) is chosen.",
    "readings": [
     "A matching mechanism SHALL NOT be used anywhere except in a template, template variable, template formal parameter or in-line template.",
     "A matching mechanism SHALL NOT be used anywhere except in a global or local template definition."
    ]
   }
  },
  {
   "id": "TTCN3-CORE-B.1.1-001a",
   "section": "B.1.1",
   "type": "definition",
   "modality": "IS",
   "subject": "ent:specific-value",
   "condition": null,
   "canonical": "A specific value IS the basic matching mechanism of TTCN-3 templates.",
   "original": "Specific values are the basic matching mechanism of TTCN-3 templates.",
   "normative": true,
   "testable": false,
   "cross_refs": [],
   "sentence_ids": [
