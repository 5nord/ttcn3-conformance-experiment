// @requirement: 14 -- NOTE 1: The direction of the parameters is as seen by the called party rather than the calling party.
// @id: TTCN3-CORE-14-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_14_test_013 {

    signature S(in integer p_in, out integer p_out);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{ p_in := 3, p_out := ? });
        p.reply(S:{ p_in := 3, p_out := 4 });
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{ p_in := 3, p_out := - }, 1.0) {
            [] p.getreply(S:{ p_in := ?, p_out := 4 }) { setverdict(pass); }
            [] p.getreply { setverdict(fail); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
