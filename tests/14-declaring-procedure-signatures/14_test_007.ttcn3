// @requirement: 14 -- TTCN-3 supports blocking and non-blocking procedure-based communication.
// @id: TTCN3-CORE-14-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_14_test_007 {

    signature S_blocking(in integer p_in);
    signature S_nonBlocking(in integer p_in) noblock;

    type port P procedure { inout S_blocking, S_nonBlocking }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S_nonBlocking:{ p_in := 1 });
        p.getcall(S_blocking:{ p_in := 2 });
        p.reply(S_blocking:{ p_in := 2 });
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S_nonBlocking:{ p_in := 1 });
        p.call(S_blocking:{ p_in := 2 }, 1.0) {
            [] p.getreply(S_blocking:{ p_in := ? }) { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
