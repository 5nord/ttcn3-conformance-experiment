// @requirement: 14 -- Procedure signatures (or signatures for short) are needed for procedure-based communication.
// @id: TTCN3-CORE-14-001b
// @verdict: pass reject
module M_14_declaring_procedure_signatures_001 {

    type port P procedure { inout integer } // error: procedure port lists a type instead of a signature

    type component C {
        port P p;
    }
}
