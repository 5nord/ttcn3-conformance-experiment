// @requirement: 14 -- Procedure-based communication may be used for the communication within the test system, i.e. among test components, or for the communication between the test system and the SUT.
// @id: TTCN3-CORE-14-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_14_declaring_procedure_signatures_002 {

    signature S(in integer p_in) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        var integer v_in;
        p.getcall(S:{ p_in := ? }) -> param(v_in);
        p.reply(S:{ p_in := v_in } value v_in + 1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{ p_in := 1 }, 1.0) {
            [] p.getreply(S:{ p_in := ? } value 2) { setverdict(pass); }
            [] p.getreply { setverdict(fail); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
