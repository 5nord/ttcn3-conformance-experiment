// @requirement: 14 -- Procedure-based communication may be used for the communication within the test system, i.e. among test components, or for the communication between the test system and the SUT.
// @id: TTCN3-CORE-14-002b
// @verdict: pass accept, noexecution
module M_14_declaring_procedure_signatures_003 {

    signature S(in integer p_in) return integer;

    type port P procedure { out S }

    type component C {
        port P p;
    }

    type component SystemC {
        port P p;
    }

    testcase TC() runs on C system SystemC {
        map(mtc:p, system:p);
        p.call(S:{ p_in := 1 }, 1.0) {
            [] p.getreply(S:{ p_in := ? } value ?) { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }
}
