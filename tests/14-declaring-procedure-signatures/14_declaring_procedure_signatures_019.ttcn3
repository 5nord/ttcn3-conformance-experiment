// @requirement: 14 -- The exceptions are defined in the form of an exception list included in the signature definition.
// @id: TTCN3-CORE-14-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_14_declaring_procedure_signatures_019 {

    signature S() exception (integer, charstring);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.raise(S, charstring:"err");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{}, 1.0) {
            [] p.getreply(S:{}) { setverdict(fail); }
            [] p.catch(S, integer:?) { setverdict(fail); }
            [] p.catch(S, charstring:"err") { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
