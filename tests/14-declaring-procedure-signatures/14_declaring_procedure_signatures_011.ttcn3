// @requirement: 14 -- Within a signature definition the parameter list may include parameter identifiers, parameter types and their direction, i.e. in, out, or inout.
// @id: TTCN3-CORE-14-010a
// @verdict: pass accept, noexecution
module M_14_declaring_procedure_signatures_011 {

    signature S(integer p_a, in integer p_b, out float p_c, inout charstring p_d);

    type port P procedure { inout S }

    type component C {
        port P p;
    }
}
