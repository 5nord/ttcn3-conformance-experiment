// @requirement: 21.0 -- Operation: Map; Explanation: Maps the port of one test component to the port of the test system interface; Syntax Examples: map(ptc1:q, system:sutPort1);
// @id: TTCN3-CORE-21.0-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_test_009 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P sutPort;
    }

    testcase TC() runs on C system S {
        if (p.checkstate("Mapped")) {
            setverdict(fail);
        }
        map(self:p, system:sutPort);
        if (p.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
