// @requirement: 21.2.1 -- The argument of the test case stop operation shall follow the same restrictions as the argument of the log statement (see clause 19.11).
// @id: TTCN3-CORE-21.2.1-007a
// @verdict: pass reject
module M_21_02_01_test_006 {

    type component C {}

    function f_noReturn() {
    }

    testcase TC() runs on C {
        testcase.stop(f_noReturn()); // error: function without return clause cannot be logged
    }

    control {
        execute(TC());
    }
}
