// @requirement: 21.3.3 -- NOTE 1: While the `create`, `start`, `running`, `done` and `killed` operations can be used for PTC(s) only, the `stop` operation can also be applied to the MTC.
// @id: TTCN3-CORE-21.3.3-006a
// @verdict: pass reject
module M_21_03_03_the_stop_test_behaviour_operation_005 {

    type component C {}

    testcase TC() runs on C {
        if (mtc.running) { // error: running cannot be applied to the MTC
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
