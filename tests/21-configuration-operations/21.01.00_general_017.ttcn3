// @requirement: 21.1.0 -- Operation: Alive; Explanation: Returns true if the test component has been created and is ready to execute or is already executingbehaviour; otherwise returns false; Syntax Examples: if (c.alive) …
// @id: TTCN3-CORE-21.1.0-011b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_00_general_017 {

    type component C {}

    function f() runs on C {}

    testcase TC() runs on C {
        var C v_normal := C.create;
        var C v_alive := C.create alive;
        v_normal.start(f());
        v_normal.done;
        v_alive.kill;
        if (not v_normal.alive and not v_alive.alive) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
