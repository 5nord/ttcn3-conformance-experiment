// @requirement: 21.0 -- Running Returns true as long as the test `if (c.running) …` component is executing behaviour; otherwise returns false
// @id: TTCN3-CORE-21.0-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_general_027 {

    type component C {}

    function f_behaviour() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C c := C.create;
        c.start(f_behaviour());
        if (c.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        c.stop;
    }

    control {
        execute(TC());
    }
}
