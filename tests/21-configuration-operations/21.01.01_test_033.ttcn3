// @requirement: 21.1.1 -- f) In addition, the restrictions on allowed and disallowed connections described in clause 9.1 apply.
// @id: TTCN3-CORE-21.1.1-035a
// @verdict: pass accept, ttcn3verdict:error
module M_21_01_01_test_033 {

    type port P message { inout integer; }

    type component C { port P p; }
    type component D { port P p1, p2; }

    testcase TC() runs on C {
        var D v_ptc := D.create;
        connect(self:p, v_ptc:p1);
        connect(self:p, v_ptc:p2); // error: port connected with two ports of the same component
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
