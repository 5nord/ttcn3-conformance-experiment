// @requirement: 21.0 -- Alive Returns true if the test component has `if (c.alive) …` been created and is ready to execute or is already executingbehaviour; otherwise returns false
// @id: TTCN3-CORE-21.0-021b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_general_025 {

    type component C {}

    function f_behaviour() runs on C {}

    testcase TC() runs on C {
        var C v_normal := C.create;
        var C v_alive := C.create alive;
        v_normal.start(f_behaviour());
        v_normal.done;
        v_alive.kill;
        if (not v_normal.alive and not v_alive.alive) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
