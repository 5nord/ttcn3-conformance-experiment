// @requirement: 21.3.8 -- In the latter case a killed operation is considered to be a shorthand for an alt statement with the killed operation as the only alternative.
// @id: TTCN3-CORE-21.3.8-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_08_the_killed_operation_008 {

    type component C {
        timer T;
    }

    function f_ptc() runs on C {
        T.start(5.0);
        T.timeout;
    }

    altstep a_killPtc(C p_ptc) runs on C {
        [] T.timeout {
            p_ptc.kill;
            repeat;
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        v_ptc.start(f_ptc());
        T.start(0.5);
        activate(a_killPtc(v_ptc));
        v_ptc.killed; // defaults are evaluated and repeat re-evaluates the implicit alt
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
