// @requirement: 21.3.1 -- The unique reference to the component will typically be stored in a variable (see clause 6.2.10.1) and can be used for connecting instances and for communication purposes such as sending and receiving.
// @id: TTCN3-CORE-21.3.1-014b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_01_the_create_operation_016 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    function f_ptc() runs on C {
        p.receive(integer:1);
        p.send(integer:2);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_ptc());
        p.send(integer:1) to v_ptc;
        T.start;
        alt {
            [] p.receive(integer:2) from v_ptc {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
