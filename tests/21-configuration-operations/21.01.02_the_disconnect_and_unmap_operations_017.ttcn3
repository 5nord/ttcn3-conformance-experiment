// @requirement: 21.1.2 -- Similar to the map operation, unmap provides an optional parameter list for configuration purposes.
// @id: TTCN3-CORE-21.1.2-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_02_the_disconnect_and_unmap_operations_017 {

    type port P message {
        inout integer;
        unmap param (integer p_x);
    }

    type component C { port P p; }

    testcase TC() runs on C system C {
        map(self:p, system:p);
        unmap(self:p, system:p) param (1);
        if (not p.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
