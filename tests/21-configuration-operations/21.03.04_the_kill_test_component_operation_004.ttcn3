// @requirement: 21.3.4 -- kill | ( ( ObjectReference | mtc | self ) "." kill ) | ( all component "." kill )
// @id: TTCN3-CORE-21.3.4-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_04_the_kill_test_component_operation_004 {

    type component C {}

    function f_wait() runs on C {
        timer T_w := 5.0;
        T_w.start;
        T_w.timeout;
    }

    function f_kill() runs on C {
        kill;
    }

    function f_selfKill() runs on C {
        self.kill;
    }

    function f_mtcKill() runs on C {
        mtc.kill;
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var C v_ptc3 := C.create;
        var C v_ptc4 := C.create alive;
        v_ptc1.start(f_kill());
        v_ptc2.start(f_selfKill());
        v_ptc3.start(f_wait());
        v_ptc4.start(f_wait());
        v_ptc1.killed;
        v_ptc2.killed;
        v_ptc3.kill;
        all component.kill;
        setverdict(pass);
        mtc.kill;
    }

    control {
        execute(TC());
    }
}
