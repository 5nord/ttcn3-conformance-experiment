module M_21_01_01_test_011 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    testcase TC() runs on C system C {
        setverdict(pass);
    }

    control {
        var C v_c := null, v_sys := null;
        map(v_c:p, v_sys:p); // error: map in control part
        execute(TC());
    }
