// @requirement: 21.1.1 -- g) In map operations, param clauses are optional.
// @id: TTCN3-CORE-21.1.1-036a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_01_the_connect_and_map_operations_034 {

    type port P message {
        inout integer;
        map param (integer p_x);
    }

    type component C { port P p; }

    testcase TC() runs on C system C {
        map(self:p, system:p);
        if (p.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
