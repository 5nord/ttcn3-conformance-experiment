// @requirement: 21.3.10 -- Operation: stop; Col3: Yes but from MTC only; Example: all component.stop;; Comment: Stop the behaviour on all PTCs.
// @id: TTCN3-CORE-21.3.10-019d
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_the_call_test_component_behaviour_operation_032 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create alive;
        var C v_ptc2 := C.create alive;
        timer T := 1.0;
        v_ptc1.start(f_wait());
        v_ptc2.start(f_wait());
        all component.stop;
        T.start;
        alt {
            [] all component.done {
                if (any component.running or not all component.alive) {
                    setverdict(fail);
                } else {
                    setverdict(pass);
                }
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
