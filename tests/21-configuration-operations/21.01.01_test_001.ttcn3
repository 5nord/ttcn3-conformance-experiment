// @requirement: 21.1.1 -- The connect operation is used to setup connections between test components.
// @id: TTCN3-CORE-21.1.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_01_test_001 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    function f_reply() runs on C {
        if (not p.checkstate("Connected")) {
            setverdict(fail);
        }
        p.send(1);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        if (not p.checkstate("Connected")) {
            setverdict(fail);
        }
        v_ptc.start(f_reply());
        T.start;
        alt {
            [] p.receive(1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
