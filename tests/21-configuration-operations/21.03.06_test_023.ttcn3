// @requirement: 21.3.6 -- Later evaluation of the lazy or fuzzy variable does not lead to repeated invocation of the running operation.
// @id: TTCN3-CORE-21.3.6-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_06_test_023 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_arr[3] := { C.create, C.create, C.create };
        var @lazy integer v_idx;
        var boolean v_res;
        v_arr[1].start(f_wait());
        v_arr[2].start(f_wait());
        v_res := any from v_arr.running -> @index value v_idx;
        v_arr[1].stop;
        if (v_res and v_idx == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
