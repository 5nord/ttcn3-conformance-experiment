// @requirement: 21.3.7 -- When the any from component array notation is used, the components from the referenced array are iterated over and individually checked for being stopped or killed from innermost to outermost dimension from lowest to highest index for each dimension.
// @id: TTCN3-CORE-21.3.7-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_07_the_done_operation_024 {

    type component C {}

    function f_wait(float p_duration) runs on C {
        timer T := p_duration;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_arr[2][2];
        var integer v_idx[2];
        for (var integer i := 0; i < 2; i := i + 1) {
            for (var integer j := 0; j < 2; j := j + 1) {
                v_arr[i][j] := C.create;
            }
        }
        v_arr[0][0].start(f_wait(5.0));
        v_arr[0][1].start(f_wait(0.0));
        v_arr[1][0].start(f_wait(0.0));
        v_arr[1][1].start(f_wait(5.0));
        v_arr[0][1].done;
        v_arr[1][0].done;
        alt {
            [] any from v_arr.done -> @index value v_idx {
                if (v_idx[0] == 0 and v_idx[1] == 1) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [else] {
                setverdict(fail);
            }
        }
        all component.kill;
    }

    control {
        execute(TC());
    }
}
