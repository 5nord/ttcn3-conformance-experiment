// @requirement: 21.3.10 -- Operation: killed; Allowed: Yes but from MTC only; Col3: Yes but from MTC only; Example: any component.killed; all component.killed;; Comment: Is there any PTC that ceased to exist? Did all PTCs cease to exist?
// @id: TTCN3-CORE-21.3.10-018b
// @verdict: pass reject
module M_21_03_10_the_call_test_component_behaviour_operation_026 {

    type component C {}

    function f() runs on C {
        all component.killed; // error: all component.killed used in a PTC
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f());
        v_ptc.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
