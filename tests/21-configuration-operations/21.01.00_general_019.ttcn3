// @requirement: 21.1.0 -- Operation: Running; Explanation: Returns true as long as the test component is executing behaviour; otherwise returns false; Syntax Examples: if (c.running) …
// @id: TTCN3-CORE-21.1.0-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_00_general_019 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    function f_wait() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.receive(1) {}
            [] T.timeout {}
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_wait());
        if (v_ptc.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        p.send(1);
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
