// @requirement: 21.1.0 -- Operation: Kill; Explanation: Causes a test component to cease to exist; Syntax Examples: c.kill;
// @id: TTCN3-CORE-21.1.0-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_00_test_014 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        v_ptc.kill;
        if (not v_ptc.alive) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
