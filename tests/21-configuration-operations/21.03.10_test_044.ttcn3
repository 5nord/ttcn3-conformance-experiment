// @requirement: 21.3.10 -- b) The function or altstep invoked in a call test component operation shall have a runs `on definition` referencing a component type to which the called component is compatible (see clause 6.3.2.7).
// @id: TTCN3-CORE-21.3.10-029a
// @verdict: pass reject
module M_21_03_10_test_044 {

    type component C {}

    type component D {
        var integer v_cnt := 0;
    }

    function f() runs on D {
        v_cnt := v_cnt + 1;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.call(f()); // error: C is not compatible with the runs on type D
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
