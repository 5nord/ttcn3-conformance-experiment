// @requirement: 21.3.8 -- f) The index redirection shall only be used when the operation is used on an any from component array construct.
// @id: TTCN3-CORE-21.3.8-028a
// @verdict: pass reject
module M_21_03_08_test_030 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_idx;
        v_ptc.kill;
        v_ptc.killed -> @index value v_idx; // error: index redirection without any from
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
