// @requirement: 21.3.3 -- NOTE 2: A PTC can stop the test case execution by stopping the MTC.
// @id: TTCN3-CORE-21.3.3-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_03_the_stop_test_behaviour_operation_025 {

    type component C {}

    function f_stopMtc() runs on C {
        setverdict(pass);
        mtc.stop;
    }

    testcase TC() runs on C {
        timer T := 5.0;
        var C v_ptc := C.create;
        setverdict(pass);
        v_ptc.start(f_stopMtc());
        T.start;
        T.timeout;
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
