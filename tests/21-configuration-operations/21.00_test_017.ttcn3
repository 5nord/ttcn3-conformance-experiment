// @requirement: 21.0 -- Start Starting test behaviour on a test `c.start(PTCBehaviour());` component, starting behaviour does not affect the status of component variables, timers or ports
// @id: TTCN3-CORE-21.0-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_test_017 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    function f_behaviour() runs on C {
        p.send(1);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_behaviour());
        T.start;
        alt {
            [] p.receive(1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
