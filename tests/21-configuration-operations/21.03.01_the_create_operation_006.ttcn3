// @requirement: 21.3.1 -- Furthermore, if a port is defined to be of the type in or inout it shall be in a listening state ready to receive traffic over the connection.
// @id: TTCN3-CORE-21.3.1-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_01_the_create_operation_006 {

    type port PIn message {
        in integer
    }

    type port POut message {
        out integer
    }

    type port PIo message {
        inout integer
    }

    type component M {
        port POut p_out;
        port PIo p_io;
    }

    type component C {
        port PIn p_in;
        port PIo p_io;
    }

    function f_ptc() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p_in.receive(integer:1) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
                return;
            }
        }
        alt {
            [] p_io.receive(integer:2) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    testcase TC() runs on M {
        var C v_ptc := C.create;
        connect(mtc:p_out, v_ptc:p_in);
        connect(mtc:p_io, v_ptc:p_io);
        p_out.send(integer:1); // sent before the PTC behaviour is started
        p_io.send(integer:2);
        v_ptc.start(f_ptc());
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
