// @requirement: 21.3.5 -- a) The ObjectReference shall be of component type and shall not resolve to a template.
// @id: TTCN3-CORE-21.3.5-014b
// @verdict: pass reject
module M_21_03_05_test_014 {

    type component C {}

    testcase TC() runs on C {
        var template C vt_ptc := C.create;
        var boolean v_b := vt_ptc.alive; // error: ObjectReference resolves to a template
    }

    control {
        execute(TC());
    }
}
