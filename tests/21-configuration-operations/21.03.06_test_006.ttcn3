// @requirement: 21.3.6 -- In contrast to the done operation, the running operation can be used freely in boolean expressions.
// @id: TTCN3-CORE-21.3.6-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_06_test_006 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    function f_identity(boolean p_b) return boolean {
        return p_b;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var C v_mtc := mtc;
        var integer v_count := 0;
        v_ptc.start(f_wait());
        var boolean v_b := v_ptc.running and v_mtc.running or false;
        while (v_ptc.running and v_count < 1) {
            v_count := v_count + 1;
        }
        if (v_b and v_count == 1 and f_identity(not v_ptc.running) == false
            and (any component.running xor false)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
