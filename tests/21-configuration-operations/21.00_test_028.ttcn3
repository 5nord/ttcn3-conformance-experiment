// @requirement: 21.0 -- Running Returns true as long as the test `if (c.running) …` component is executing behaviour; otherwise returns false
// @id: TTCN3-CORE-21.0-022b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_test_028 {

    type component C {}

    function f_behaviour() runs on C {}

    testcase TC() runs on C {
        var C c := C.create alive;
        if (c.running) {
            setverdict(fail);
        }
        c.start(f_behaviour());
        c.done;
        if (c.running) {
            setverdict(fail);
        } else {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
