// @requirement: 21.3.8 -- It also matches if no PTC has been created.
// @id: TTCN3-CORE-21.3.8-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_08_the_killed_operation_016 {

    type component C {}

    testcase TC() runs on C {
        alt {
            [] all component.killed {
                setverdict(pass);
            }
            [else] {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
