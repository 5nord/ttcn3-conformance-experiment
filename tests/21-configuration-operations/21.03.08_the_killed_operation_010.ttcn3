// @requirement: 21.3.8 -- NOTE 1: When checking normal test components a killed operation matches if it stopped (implicitly or explicitly) the execution of its behaviour or has been killed explicitly, i.e. the operation is equivalent to the done operation (see clause 21.3.7).
// @id: TTCN3-CORE-21.3.8-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_08_the_killed_operation_010 {

    type component C {}

    function f_implicitStop() runs on C {}

    function f_explicitStop() runs on C {
        self.stop;
    }

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var C v_ptc3 := C.create;
        v_ptc1.start(f_implicitStop());
        v_ptc2.start(f_explicitStop());
        v_ptc3.start(f_wait());
        v_ptc3.kill;
        T.start;
        alt {
            [] v_ptc1.killed {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
                stop;
            }
        }
        alt {
            [] v_ptc2.killed {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
                stop;
            }
        }
        alt {
            [] v_ptc3.killed {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
