// @requirement: 21.3.2 -- The start operation shall bind the required behaviour to the test component.
// @id: TTCN3-CORE-21.3.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_02_test_004 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    function f_first() runs on C {
        p.send(integer:1);
    }

    function f_second() runs on C {
        p.send(integer:2);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_second());
        T.start;
        alt {
            [] p.receive(integer:2) from v_ptc {
                setverdict(pass);
            }
            [] p.receive {
                setverdict(fail);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
