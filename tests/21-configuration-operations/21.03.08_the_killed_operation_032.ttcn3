// @requirement: 21.3.8 -- h) If the index redirection is used for multi-dimensional component arrays, the size of the integer array or record of integer type shall exactly be the same as the dimension of the respective array, and its type shall allow storing the highest index (from all dimensions) of the array.
// @id: TTCN3-CORE-21.3.8-030a
// @verdict: pass reject
module M_21_03_08_the_killed_operation_032 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptcs[3][3];
        var integer v_idx[1];
        for (var integer i := 0; i < 3; i := i + 1) {
            for (var integer j := 0; j < 3; j := j + 1) {
                v_ptcs[i][j] := C.create;
            }
        }
        v_ptcs[0][0].kill;
        any from v_ptcs.killed -> @index value v_idx; // error: index array size 1 differs from dimension 2
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
