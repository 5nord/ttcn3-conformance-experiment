// @requirement: 21.0 -- Start Starting test behaviour on a test `c.start(PTCBehaviour());` component, starting behaviour does not affect the status of component variables, timers or ports
// @id: TTCN3-CORE-21.0-018c
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_general_019 {

    type component C {}

    function PTCBehaviour() runs on C {
        setverdict(pass);
    }

    testcase TC() runs on C {
        var C c := C.create;
        c.start(PTCBehaviour());
        c.done;
    }

    control {
        execute(TC());
    }
}
