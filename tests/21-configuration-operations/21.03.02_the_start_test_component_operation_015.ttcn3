// @requirement: 21.3.2 -- If the function's formal parameter list includes any out parameter the actual parameter list may omit actual out parameters using the dash symbol ("-") or be omitted in the same manner as for actual in parameters with default values (see clause 5.4.2), i.e. they can be omitted in the list notation if all following actual parameters are also omitted and their assignment can be omitted altogether in assignment notation.
// @id: TTCN3-CORE-21.3.2-018b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_02_the_start_test_component_operation_015 {

    type component C {}

    function f_ptc(in integer p_in, out integer p_out1, out integer p_out2) runs on C {
        p_out1 := p_in;
        p_out2 := p_in;
        if (p_in == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc(5));
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
