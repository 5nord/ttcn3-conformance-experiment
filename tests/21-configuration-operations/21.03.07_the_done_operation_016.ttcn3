// @requirement: 21.3.7 -- When the all keyword is used with the done operation, it matches if no one PTC is executing its behaviour.
// @id: TTCN3-CORE-21.3.7-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_07_the_done_operation_016 {

    type component C {}

    function f_ptc() runs on C {}

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create alive;
        v_ptc1.start(f_ptc());
        v_ptc2.start(f_ptc());
        T.start;
        alt {
            [] all component.done {
                if (v_ptc1.running or v_ptc2.running) {
                    setverdict(fail);
                } else {
                    setverdict(pass);
                }
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
        v_ptc2.kill;
    }

    control {
        execute(TC());
    }
}
