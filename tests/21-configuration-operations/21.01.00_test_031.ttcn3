module M_21_01_00_test_031 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P sutPort;
    }

    testcase TC() runs on C system S {
        var C c := C.create;
        map(c:p, system:sutPort);
    }
}
