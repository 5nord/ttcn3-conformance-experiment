// @requirement: 21.3.7 -- b) The ObjectReference followed by the done keyword, i.e. used for identifying a specific PTC, shall be of a component type and shall not resolve to a template.
// @id: TTCN3-CORE-21.3.7-026b
// @verdict: pass reject
module M_21_03_07_the_done_operation_029 {

    type component C {}

    function f_ptc() runs on C {}

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var template C vt_ptc := v_ptc;
        v_ptc.start(f_ptc());
        vt_ptc.done; // error: reference resolves to a template
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
