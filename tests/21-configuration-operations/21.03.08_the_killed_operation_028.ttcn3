// @requirement: 21.3.8 -- d) The variable used in the (optional) value clause for storing the final local verdict of a PTC shall be of the type verdicttype.
// @id: TTCN3-CORE-21.3.8-026a
// @verdict: pass reject
module M_21_03_08_the_killed_operation_028 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var boolean v_verdict;
        v_ptc.kill;
        v_ptc.killed -> value v_verdict; // error: variable is not of type verdicttype
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
