// @requirement: 21.0 -- Kill Causes a test component to cease to `c.kill;` exist
// @id: TTCN3-CORE-21.0-020b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_test_023 {

    type component C {}

    testcase TC() runs on C {
        var C c := C.create;
        c.kill;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
