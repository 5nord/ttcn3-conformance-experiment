// @requirement: 21.3.10 -- A timeout duration in seconds can be given explicitly in the form of a SimpleExpression as an additional parameter to the call operation.
// @id: TTCN3-CORE-21.3.10-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_test_004 {

    type component C {}

    function f() runs on C {}

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var float v_base := 1.0;
        v_ptc.call(f(), v_base * 2.0);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
