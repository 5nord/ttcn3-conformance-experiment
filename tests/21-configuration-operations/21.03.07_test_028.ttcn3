// @requirement: 21.3.7 -- b) The ObjectReference followed by the done keyword, i.e. used for identifying a specific PTC, shall be of a component type and shall not resolve to a template.
// @id: TTCN3-CORE-21.3.7-026a
// @verdict: pass reject
module M_21_03_07_test_028 {

    type component C {}

    testcase TC() runs on C {
        var integer v_int := 1;
        v_int.done; // error: reference is not of a component type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
