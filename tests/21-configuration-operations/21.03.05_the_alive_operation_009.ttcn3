// @requirement: 21.3.5 -- The alive operation used in combination with the any keyword returns true if at least one PTC is alive.
// @id: TTCN3-CORE-21.3.5-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_05_the_alive_operation_009 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc1 := C.create alive;
        var C v_ptc2 := C.create alive;
        v_ptc1.kill;
        if (any component.alive) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
