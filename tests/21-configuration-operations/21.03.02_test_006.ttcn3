// @requirement: 21.3.2 -- An alive-type PTC may perform several behaviours in sequential order.
// @id: TTCN3-CORE-21.3.2-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_02_test_006 {

    type component C {
        var integer v_count := 0;
    }

    function f_first() runs on C {
        v_count := v_count + 1;
    }

    function f_second() runs on C {
        v_count := v_count + 1;
        if (v_count == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        v_ptc.start(f_first());
        v_ptc.done;
        v_ptc.start(f_second());
        v_ptc.done;
        v_ptc.kill;
    }

    control {
        execute(TC());
    }
}
