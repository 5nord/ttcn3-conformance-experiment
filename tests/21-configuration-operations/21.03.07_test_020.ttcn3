// @requirement: 21.3.7 -- Otherwise, the match is unsuccessful.
// @id: TTCN3-CORE-21.3.7-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_07_test_020 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        v_ptc1.start(f_wait());
        v_ptc2.start(f_wait());
        alt {
            [] any component.done {
                setverdict(fail);
            }
            [else] {
                setverdict(pass);
            }
        }
        all component.kill;
    }

    control {
        execute(TC());
    }
}
