// @requirement: 21.0 -- Operation: Unmap; Explanation: Unmaps two or more mapped ports; Syntax Examples: unmap(ptc1:q, system:sutPort1);
// @id: TTCN3-CORE-21.0-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_general_011 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P sutPort;
    }

    testcase TC() runs on C system S {
        map(self:p, system:sutPort);
        if (not p.checkstate("Mapped")) {
            setverdict(fail);
        }
        unmap(self:p, system:sutPort);
        if (p.checkstate("Mapped")) {
            setverdict(fail);
        } else {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
