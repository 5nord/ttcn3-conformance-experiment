// @requirement: 21.1.1 -- d) In all other cases, the operations shall not be allowed.
// @id: TTCN3-CORE-21.1.1-032b
// @verdict: pass reject
module M_21_01_01_test_030 {

    type port P1 message { inout integer; }
    type port P2 message { inout charstring; }

    type component C { port P1 p1; }
    type component S { port P2 p2; }

    testcase TC() runs on C system S {
        map(self:p1, system:p2); // error: outlist-PORT1 is not contained in outlist-PORT2
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
