// @requirement: 21.3.7 -- When the done operation is applied to a PTC, it matches only if the behaviour of that PTC has been stopped (implicitly or explicitly) or the PTC has been killed.
// @id: TTCN3-CORE-21.3.7-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_07_test_010 {

    type component C {}

    function f_implicitStop() runs on C {}

    function f_explicitStop() runs on C {
        self.stop;
    }

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var C v_ptc3 := C.create;
        v_ptc1.start(f_implicitStop());
        v_ptc2.start(f_explicitStop());
        v_ptc3.start(f_wait());
        v_ptc3.kill;
        T.start;
        alt {
            [] v_ptc1.done {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
                stop;
            }
        }
        alt {
            [] v_ptc2.done {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
                stop;
            }
        }
        alt {
            [] v_ptc3.done {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
