// @requirement: 21.3.4 -- a) The ObjectReference shall be of component type and shall not resolve to a template.
// @id: TTCN3-CORE-21.3.4-012b
// @verdict: pass reject
module M_21_03_04_the_kill_test_component_operation_015 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var template C vt_ptc := v_ptc;
        vt_ptc.kill; // error: ObjectReference resolves to a template
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
