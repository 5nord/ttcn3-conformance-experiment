// @requirement: 21.3.8 -- When the any keyword is used with the killed operation, it matches if at least one PTC ceased to exist.
// @id: TTCN3-CORE-21.3.8-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_08_test_019 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc1 := C.create alive;
        var C v_ptc2 := C.create alive;
        v_ptc1.start(f_wait());
        v_ptc2.start(f_wait());
        v_ptc1.kill;
        T.start;
        alt {
            [] any component.killed {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
        v_ptc2.kill;
    }

    control {
        execute(TC());
    }
}
