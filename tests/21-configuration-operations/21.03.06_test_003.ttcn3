// @requirement: 21.3.6 -- The running operation returns true for the mtc and PTCs that have been started but not yet terminated or stopped.
// @id: TTCN3-CORE-21.3.6-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_06_test_003 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var C v_mtc := mtc;
        v_ptc.start(f_wait());
        if (v_mtc.running and v_ptc.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
