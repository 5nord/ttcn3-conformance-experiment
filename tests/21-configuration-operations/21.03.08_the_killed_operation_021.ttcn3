// @requirement: 21.3.8 -- When the any from component array notation is used, the components from the referenced array are iterated over and individually checked for being killed from innermost to outermost dimension from lowest to highest index for each dimension.
// @id: TTCN3-CORE-21.3.8-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_08_the_killed_operation_021 {

    type component C {}

    testcase TC() runs on C {
        var C v_arr[2][2];
        var integer v_idx[2];
        for (var integer i := 0; i < 2; i := i + 1) {
            for (var integer j := 0; j < 2; j := j + 1) {
                v_arr[i][j] := C.create alive;
            }
        }
        v_arr[1][0].kill;
        v_arr[0][1].kill;
        alt {
            [] any from v_arr.killed -> @index value v_idx {
                if (v_idx[0] == 0 and v_idx[1] == 1) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [else] {
                setverdict(fail);
            }
        }
        all component.kill;
    }

    control {
        execute(TC());
    }
}
