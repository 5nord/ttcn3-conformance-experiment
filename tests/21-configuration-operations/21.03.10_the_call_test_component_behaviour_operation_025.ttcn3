// @requirement: 21.3.10 -- Operation: killed; Allowed: Yes but from MTC only; Col3: Yes but from MTC only; Example: any component.killed; all component.killed;; Comment: Is there any PTC that ceased to exist? Did all PTCs cease to exist?
// @id: TTCN3-CORE-21.3.10-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_the_call_test_component_behaviour_operation_025 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        v_ptc.kill;
        any component.killed;
        all component.killed;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
