// @requirement: 21.3.10 -- h) The variable in the verdict clause shall be of type verdicttype.
// @id: TTCN3-CORE-21.3.10-034a
// @verdict: pass reject
module M_21_03_10_the_call_test_component_behaviour_operation_050 {

    type component C {}

    function f_behaviour() runs on C {
        setverdict(pass);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_verdict;
        v_ptc.call(f_behaviour()) -> verdict v_verdict; // error: verdict variable not of type verdicttype
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
