// @requirement: 21.3.5 -- Applied on the mtc the operation returns true.
// @id: TTCN3-CORE-21.3.5-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_05_test_007 {

    type component C {}

    testcase TC() runs on C {
        var C v_mtc := mtc;
        if (v_mtc.alive) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
