// @requirement: 21.1.0 -- Operation: Start; Explanation: Starting test behaviour on a test component, starting behaviour does not affect the status of component variables, timers or ports; Syntax Examples: c.start(PTCBehaviour());
// @id: TTCN3-CORE-21.1.0-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_00_test_009 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    function f_behaviour() runs on C {
        p.send(1);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_behaviour());
        T.start;
        alt {
            [] p.receive(1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
