// @requirement: 21.0 -- **Test Case Operations** Stop Terminates the test case with the test `testcase.stop ( … );` verdict error
// @id: TTCN3-CORE-21.0-025b
// @verdict: pass accept, ttcn3verdict:error
module M_21_00_general_035 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        testcase.stop("stopped with value: ", v_i);
    }

    control {
        execute(TC());
    }
}
