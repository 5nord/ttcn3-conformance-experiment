// @requirement: 21.1.0 -- Operation: Mtc; Explanation: Gets the reference to the MTC; Syntax Examples: connect(mtc:p, ptc:p);
// @id: TTCN3-CORE-21.1.0-018b
// @verdict: pass accept, noexecution
module M_21_01_00_test_029 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C ptc := C.create;
        connect(mtc:p, ptc:p);
    }
}
