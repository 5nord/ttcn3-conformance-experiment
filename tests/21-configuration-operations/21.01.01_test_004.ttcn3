// @requirement: 21.1.1 -- connect "(" ComponentRef ":" Port "," ComponentRef ":" Port ")" map "(" ComponentRef ":" Port "," ComponentRef ":" Port ")" [ param "(" [ { ActualPar [","] }+ ] ")" ]
// @id: TTCN3-CORE-21.1.1-003b
// @verdict: pass accept, noexecution
module M_21_01_01_test_004 {

    type port P message {
        inout integer;
        map param (integer p_option, boolean p_lock);
    }

    type component C {
        port P p1;
        port P p2;
        port P p3;
    }

    type component S {
        port P s1;
        port P s2;
        port P s3;
    }

    testcase TC() runs on C system S {
        var C v_ptc := C.create;
        map(v_ptc:p1, system:s1);
        map(mtc:p2, system:s2) param (1, false);
        map(system:s3, self:p3) param (p_option := 2, p_lock := true);
    }
}
