// @requirement: 21.3.7 -- The first component to be found stopped or killed causes done operation to succeed.
// @id: TTCN3-CORE-21.3.7-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_07_test_025 {

    type component C {}

    function f_wait(float p_duration) runs on C {
        timer T := p_duration;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_arr[3];
        var integer v_idx := -1;
        for (var integer i := 0; i < 3; i := i + 1) {
            v_arr[i] := C.create;
        }
        v_arr[0].start(f_wait(5.0));
        v_arr[1].start(f_wait(0.0));
        v_arr[2].start(f_wait(0.0));
        v_arr[1].done;
        v_arr[2].kill;
        alt {
            [] any from v_arr.done -> @index value v_idx {
                if (v_idx == 1) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [else] {
                setverdict(fail);
            }
        }
        all component.kill;
    }

    control {
        execute(TC());
    }
}
