// @requirement: 21.1.1 -- Before either operation is called, the components to be connected shall have been created and their component references shall be known together with the names of the relevant ports.
// @id: TTCN3-CORE-21.1.1-008b
// @verdict: pass reject
module M_21_01_01_the_connect_and_map_operations_013 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:q); // error: port q is not known in component type C
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
