// @requirement: 21.3.3 -- a) The ObjectReference shall be of component type and shall not resolve to a template.
// @id: TTCN3-CORE-21.3.3-024a
// @verdict: pass reject
module M_21_03_03_test_026 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        v_i.stop; // error: ObjectReference is not of component type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
