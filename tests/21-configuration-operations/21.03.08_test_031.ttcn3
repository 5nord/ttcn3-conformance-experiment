// @requirement: 21.3.8 -- g) If the index redirection is used for single-dimensional component arrays, the type of the integer variable shall allow storing the highest index of the respective array.
// @id: TTCN3-CORE-21.3.8-029a
// @verdict: pass reject
module M_21_03_08_test_031 {

    type component C {}

    type integer SmallIndex (0 .. 1);

    testcase TC() runs on C {
        var C v_ptcs[3];
        var SmallIndex v_idx;
        for (var integer i := 0; i < 3; i := i + 1) {
            v_ptcs[i] := C.create;
        }
        v_ptcs[0].kill;
        any from v_ptcs.killed -> @index value v_idx; // error: SmallIndex cannot store the highest index 2
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
