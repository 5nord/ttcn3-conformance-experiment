// @requirement: 21.1.1 -- connect "(" ComponentRef ":" Port "," ComponentRef ":" Port ")" map "(" ComponentRef ":" Port "," ComponentRef ":" Port ")" [ param "(" [ { ActualPar [","] }+ ] ")" ]
// @id: TTCN3-CORE-21.1.1-003a
// @verdict: pass accept, noexecution
module M_21_01_01_test_003 {

    type port P message { inout integer; }

    type component C {
        port P p1;
        port P p2;
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        connect(v_ptc1:p1, v_ptc2:p1);
        connect(mtc:p1, v_ptc1:p2);
        connect(self:p2, v_ptc2:p2);
    }
}
