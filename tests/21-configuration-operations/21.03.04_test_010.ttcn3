// @requirement: 21.3.4 -- In this case the component to be killed shall be addressed using its component reference.
// @id: TTCN3-CORE-21.3.4-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_04_test_010 {

    type component C {}

    function f_wait() runs on C {
        timer T_w := 5.0;
        T_w.start;
        T_w.timeout;
    }

    function f_create() return C {
        var C v_c := C.create alive;
        v_c.start(f_wait());
        return v_c;
    }

    testcase TC() runs on C {
        timer T := 2.0;
        var C v_ptc := C.create alive;
        v_ptc.start(f_wait());
        v_ptc.kill;
        f_create().kill;
        T.start;
        alt {
            [] all component.killed { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
