// @requirement: 21.0 -- Killed Checks whether a component has `c.killed { … }` ceased to exist
// @id: TTCN3-CORE-21.0-024b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_general_033 {

    type component C {}

    testcase TC() runs on C {
        var C c := C.create;
        c.kill;
        alt {
            [] c.killed { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
