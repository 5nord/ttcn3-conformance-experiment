// @requirement: 21.3.10 -- g) The variable in the value clause shall be compatible with the return value of the invoked function.
// @id: TTCN3-CORE-21.3.10-033b
// @verdict: pass reject
module M_21_03_10_the_call_test_component_behaviour_operation_049 {

    type component C {}

    function f_behaviour() runs on C return integer {
        return 1;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var charstring v_res;
        v_ptc.call(f_behaviour()) -> value v_res; // error: charstring variable for integer return type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
