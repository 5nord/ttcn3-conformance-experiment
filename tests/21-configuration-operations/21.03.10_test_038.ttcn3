// @requirement: 21.3.10 -- After complete execution of the started behaviour, the out and inout actual parameters given to the actual parameter list of the called function or altstep instance will be updated in the same manner as if it was a normal function/altstep invocation.
// @id: TTCN3-CORE-21.3.10-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_test_038 {

    type component C {}

    function f(out integer p_out, inout integer p_inout) runs on C {
        p_out := 10;
        p_inout := p_inout * 2;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_out := 0, v_inout := 3;
        v_ptc.call(f(v_out, v_inout));
        if (v_out == 10 and v_inout == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
