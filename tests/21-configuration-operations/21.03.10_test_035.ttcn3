// @requirement: 21.3.10 -- Operation: kill; Col3: Yes but from MTC only; Example: all component.kill;; Comment: Kill all PTCs, i.e. they cease to exist.
// @id: TTCN3-CORE-21.3.10-020c
// @verdict: pass reject
module M_21_03_10_test_035 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        any component.kill; // error: kill used with any component
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
