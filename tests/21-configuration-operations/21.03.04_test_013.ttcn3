// @requirement: 21.3.4 -- The all keyword can be used by the MTC only in order to stop and kill all running PTCs but the MTC itself.
// @id: TTCN3-CORE-21.3.4-010b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_04_test_013 {

    type component C {}

    function f_wait() runs on C {
        timer T_w := 5.0;
        T_w.start;
        T_w.timeout;
    }

    function f_end() runs on C {
    }

    testcase TC() runs on C {
        timer T := 2.0;
        var C v_running := C.create;
        var C v_aliveRunning := C.create alive;
        var C v_aliveInactive := C.create alive;
        var C v_aliveStopped := C.create alive;
        v_running.start(f_wait());
        v_aliveRunning.start(f_wait());
        v_aliveStopped.start(f_end());
        v_aliveStopped.done;
        all component.kill;
        T.start;
        alt {
            [] all component.killed { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
        if (any component.alive) {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
