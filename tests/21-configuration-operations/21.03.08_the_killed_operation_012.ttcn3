// @requirement: 21.3.8 -- Otherwise the killed operation is unsuccessful.
// @id: TTCN3-CORE-21.3.8-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_08_the_killed_operation_012 {

    type component C {}

    function f_ptc() runs on C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        v_ptc.start(f_ptc());
        v_ptc.done;
        alt {
            [] v_ptc.killed {
                setverdict(fail);
            }
            [else] {
                setverdict(pass);
            }
        }
        v_ptc.kill;
    }

    control {
        execute(TC());
    }
}
