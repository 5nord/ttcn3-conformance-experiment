// @requirement: 21.3.8 -- When checking alive-type test components, however, the killed operation matches only if the component has been killed using the kill operation.
// @id: TTCN3-CORE-21.3.8-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_08_test_011 {

    type component C {}

    function f_ptc() runs on C {}

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create alive;
        v_ptc.start(f_ptc());
        v_ptc.done;
        alt {
            [] v_ptc.killed {
                setverdict(fail);
                stop;
            }
            [else] {
                setverdict(pass);
            }
        }
        v_ptc.kill;
        T.start;
        alt {
            [] v_ptc.killed {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
