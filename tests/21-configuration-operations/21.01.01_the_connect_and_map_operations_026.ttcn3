// @requirement: 21.1.1 -- 2) outlist-PORT1 ⊆ outlist-PORT2 and inlist-PORT2 ⊆ inlist-PORT1; and
// @id: TTCN3-CORE-21.1.1-029b
// @verdict: pass reject
module M_21_01_01_the_connect_and_map_operations_026 {

    type port PComp message {
        inout integer;
    }

    type port PSys message {
        inout integer;
        in charstring;
    }

    type component C {
        port PComp p;
    }

    type component S {
        port PSys p;
    }

    testcase TC() runs on C system S {
        map(mtc:p, system:p); // error: inlist of system:p is not a subset of inlist of mtc:p
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
