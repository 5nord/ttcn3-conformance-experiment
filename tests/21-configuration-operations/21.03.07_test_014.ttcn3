// @requirement: 21.3.7 -- When the done operation is applied to a PTC and matches, the final local verdict of the PTC can be retrieved and stored in a variable of the type verdicttype.
// @id: TTCN3-CORE-21.3.7-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_07_test_014 {

    type component C {}

    function f_ptc() runs on C {
        setverdict(pass);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var verdicttype v_verdict := none;
        var C v_ptc := C.create alive;
        v_ptc.start(f_ptc());
        T.start;
        alt {
            [] v_ptc.done -> value v_verdict {
                if (v_verdict == pass) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
        v_ptc.kill;
    }

    control {
        execute(TC());
    }
}
