// @requirement: 21.0 -- Self Gets the reference to the test component that executes this operation
// @id: TTCN3-CORE-21.0-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_test_040 {

    type component C {}

    function f_check(C p_ptc) runs on C {
        if (self == p_ptc) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        if (self != mtc) {
            setverdict(fail);
        }
        v_ptc.start(f_check(v_ptc));
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
