// @requirement: 21.3.8 -- NOTE 2: The execution of a killed operation does not change the state of the test component.
// @id: TTCN3-CORE-21.3.8-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_08_test_013 {

    type component C {}

    function f_ptc() runs on C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        v_ptc.start(f_ptc());
        v_ptc.done;
        alt {
            [] v_ptc.killed {
                setverdict(fail);
                stop;
            }
            [else] {}
        }
        if (v_ptc.alive and not v_ptc.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        v_ptc.kill;
    }

    control {
        execute(TC());
    }
}
