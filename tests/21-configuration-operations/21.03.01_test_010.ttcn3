// @requirement: 21.3.1 -- An alive-type PTC shall be destroyed explicitly using the kill operation (see clause 21.3.4), whereas a non-alive PTC is destroyed implicitly after its behaviour terminates.
// @id: TTCN3-CORE-21.3.1-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_01_test_010 {

    type component C {}

    function f_ptc() runs on C {
        setverdict(pass);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create alive;
        v_ptc.start(f_ptc());
        v_ptc.done;
        if (not v_ptc.alive) {
            setverdict(fail);
        }
        v_ptc.kill;
        T.start;
        alt {
            [] v_ptc.killed {
                if (v_ptc.alive) {
                    setverdict(fail);
                }
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
