// @requirement: 21.3.1 -- If a host id is provided, the create operation shall cause a test case error, if the component cannot be deployed on the specified host.
// @id: TTCN3-CORE-21.3.1-020a
// @verdict: pass accept, ttcn3verdict:error
module M_21_03_01_the_create_operation_025 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc;
        setverdict(pass);
        v_ptc := C.create("MyPTC", "nonexistent.host.invalid"); // test case error: host not available
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
