// @requirement: 21.1.1 -- The operation mtc identifies the MTC, the operation system identifies the test system interface and the operation self identifies the test component in which self has been called (see clause 6.2.11).
// @id: TTCN3-CORE-21.1.1-005c
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_01_the_connect_and_map_operations_008 {

    type port P message { inout integer; }

    type component C {
        port P p1;
    }

    function f_connectSelf() runs on C {
        connect(self:p1, mtc:p1);
        p1.send(1);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_sender;
        var C v_ptc := C.create;
        v_ptc.start(f_connectSelf());
        T.start;
        alt {
            [] p1.receive(1) -> sender v_sender {
                if (v_sender == v_ptc) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [] T.timeout { setverdict(fail); }
        }
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
