// @requirement: 21.1.0 -- Operation: Done; Explanation: Checks whether the function running on a test component has terminated; Syntax Examples: c.done;
// @id: TTCN3-CORE-21.1.0-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_00_test_022 {

    type component C {}

    function f() runs on C {}

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        v_ptc.start(f());
        T.start;
        alt {
            [] v_ptc.done { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
