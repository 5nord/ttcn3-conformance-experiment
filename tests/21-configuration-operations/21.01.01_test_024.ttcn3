// @requirement: 21.1.1 -- 1) PORT1 is a component port reference and PORT2 is a system port reference; and
// @id: TTCN3-CORE-21.1.1-028a
// @verdict: pass reject
module M_21_01_01_test_024 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P p1;
        port P p2;
    }

    testcase TC() runs on C system S {
        map(system:p1, system:p2); // error: no component port reference in map
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
