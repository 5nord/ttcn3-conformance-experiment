// @requirement: 21.3.5 -- e) If the index redirection is used for multi-dimensional component arrays, the size of the integer array or record of integer type shall exactly be the same as the dimension of the respective array, and its type shall allow storing the highest index (from all dimensions) of the array.
// @id: TTCN3-CORE-21.3.5-018a
// @verdict: pass reject
module M_21_03_05_the_alive_operation_018 {

    type component C {}

    testcase TC() runs on C {
        var C v_arr[2][2] := { { C.create, C.create }, { C.create, C.create } };
        var integer v_idx[3];
        var boolean v_b := any from v_arr.alive -> @index value v_idx; // error: size 3 differs from dimension 2
    }

    control {
        execute(TC());
    }
}
