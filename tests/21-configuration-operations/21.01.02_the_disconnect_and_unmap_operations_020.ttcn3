// @requirement: 21.1.2 -- b) In unmap operations, param clauses are optional.
// @id: TTCN3-CORE-21.1.2-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_02_the_disconnect_and_unmap_operations_020 {

    type port P message {
        inout integer;
        unmap param (integer p_x);
    }

    type component C { port P p; }

    testcase TC() runs on C system C {
        map(self:p, system:p);
        unmap(self:p, system:p);
        if (not p.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
