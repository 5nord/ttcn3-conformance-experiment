// @requirement: 21.3.6 -- When the all keyword is used with the running operation, it will return true if all PTCs started but not stopped explicitly by another component are executing their behaviour.
// @id: TTCN3-CORE-21.3.6-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_06_test_007 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var C v_ptc3 := C.create;
        v_ptc1.start(f_wait());
        v_ptc2.start(f_wait());
        v_ptc3.start(f_wait());
        v_ptc3.stop;
        if (all component.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
