// @requirement: 21.3.7 -- In both cases the done operation matches.
// @id: TTCN3-CORE-21.3.7-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_07_the_done_operation_023 {

    type component C {}

    function f_ptc() runs on C {}

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_normal := C.create;
        var C v_alive := C.create alive;
        v_normal.start(f_ptc());
        v_alive.start(f_ptc());
        T.start;
        alt {
            [] v_normal.done {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
                stop;
            }
        }
        alt {
            [] v_alive.done {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
        v_alive.kill;
    }

    control {
        execute(TC());
    }
}
