// @requirement: 21.3.2 -- NOTE 2: As in and inout ports starts listening when the component is created, at the moment, when it starts execution there may be messages in the incoming queues of such ports already waiting to be processed.
// @id: TTCN3-CORE-21.3.2-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_02_test_023 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    function f_ptc() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.receive(integer:1) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.send(integer:1); // sent before the behaviour of the PTC is started
        v_ptc.start(f_ptc());
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
