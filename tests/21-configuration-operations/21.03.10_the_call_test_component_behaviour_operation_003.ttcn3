// @requirement: 21.3.10 -- Similar to the start operation on test components which is not blocking, the blocking call operation implicitly uses a start operation, but waits until either the started behaviour has terminated or some timeout has occurred.
// @id: TTCN3-CORE-21.3.10-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_the_call_test_component_behaviour_operation_003 {

    type component C {}

    function f_wait() runs on C {
        timer T := 1.0;
        T.start;
        T.timeout;
    }

    function f_long() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var boolean v_timedOut := false;
        timer T := 10.0;
        T.start;
        v_ptc1.call(f_wait());
        if (T.read < 1.0 or v_ptc1.running) {
            setverdict(fail);
            stop;
        }
        T.stop;
        T.start;
        v_ptc2.call(f_long(), 1.0) catch (timeout) {
            v_timedOut := true;
        }
        if (T.read < 1.0 or T.read >= 5.0 or not v_timedOut) {
            setverdict(fail);
        } else {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
