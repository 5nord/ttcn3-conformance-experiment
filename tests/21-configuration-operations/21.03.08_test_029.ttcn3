// @requirement: 21.3.8 -- e) The (optional) value clause for storing the final local verdict of a PTC shall not be used in combination with all component or any component.
// @id: TTCN3-CORE-21.3.8-027a
// @verdict: pass reject
module M_21_03_08_test_029 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var verdicttype v_verdict;
        v_ptc.kill;
        any component.killed -> value v_verdict; // error: value clause with any component
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
