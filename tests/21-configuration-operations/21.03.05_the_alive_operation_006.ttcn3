// @requirement: 21.3.5 -- It returns false if the component has been killed.
// @id: TTCN3-CORE-21.3.5-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_05_the_alive_operation_006 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        v_ptc.kill;
        if (not v_ptc.alive) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
