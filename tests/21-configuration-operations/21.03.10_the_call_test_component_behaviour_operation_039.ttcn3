// @requirement: 21.3.10 -- Additionally, a redirect clause can be added to the operation which allows assignment of the return result (in case that the called function has a return clause) to a variable via the value clause and also the assignment of the termination verdict of the called component via the verdict clause.
// @id: TTCN3-CORE-21.3.10-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_the_call_test_component_behaviour_operation_039 {

    type component C {}

    function f() runs on C return integer {
        return 42;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_res := 0;
        v_ptc.call(f()) -> value v_res;
        if (v_res == 42) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
