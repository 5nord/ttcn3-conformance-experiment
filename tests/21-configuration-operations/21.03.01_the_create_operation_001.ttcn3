// @requirement: 21.3.1 -- ComponentType "." create [ "(" Expression ["," Expression] ")" ] [ alive ]
// @id: TTCN3-CORE-21.3.1-002a
// @verdict: pass accept, noexecution
module M_21_03_01_the_create_operation_001 {

    type component C {}

    testcase TC() runs on C {
        var C v_c1, v_c2, v_c3, v_c4, v_c5, v_c6;
        v_c1 := C.create;
        v_c2 := C.create("Name");
        v_c3 := C.create alive;
        v_c4 := C.create("Alive") alive;
        v_c5 := C.create(-, "Host4");
        v_c6 := C.create("Deployed", "Host4") alive;
        setverdict(pass);
    }
}
