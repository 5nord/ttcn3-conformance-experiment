// @requirement: 21.3.10 -- c) All formal parameters of the function or altstep invoked in a call test component operation shall be of a component data type.
// @id: TTCN3-CORE-21.3.10-030a
// @verdict: pass reject
module M_21_03_10_the_call_test_component_behaviour_operation_045 {

    type component C {}

    function f_behaviour(default p_def) runs on C {
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.call(f_behaviour(null)); // error: formal parameter of default type is not a component data type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
