// @requirement: 21.3.1 -- The component instance name is used for logging purposes (see clause 19.11) only and shall not be used to refer to the component instance (the component reference shall be used for this purpose) and has no effect on matching.
// @id: TTCN3-CORE-21.3.1-018b
// @verdict: pass reject
module M_21_03_01_test_021 {

    type component C {}

    function f_ptc() runs on C {
        setverdict(pass);
    }

    testcase TC() runs on C {
        const charstring c_name := "MyPTC";
        var C v_ptc := C.create(c_name);
        c_name.start(f_ptc()); // error: component name used to refer to the component
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
