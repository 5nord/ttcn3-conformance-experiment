// @requirement: 21.1.0 -- Operation: Done; Explanation: Checks whether the function running on a test component has terminated; Syntax Examples: c.done;
// @id: TTCN3-CORE-21.1.0-013b
// @verdict: pass accept, noexecution
module M_21_01_00_general_023 {

    type component C {}

    function f() runs on C {}

    testcase TC() runs on C {
        var C c := C.create;
        c.start(f());
        c.done;
    }
}
