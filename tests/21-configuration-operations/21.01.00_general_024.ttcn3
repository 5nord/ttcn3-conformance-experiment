// @requirement: 21.1.0 -- Operation: Killed; Explanation: Checks whether a component has ceased to exist; Syntax Examples: c.killed { … }
// @id: TTCN3-CORE-21.1.0-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_00_general_024 {

    type component C {}

    function f_kill() runs on C {
        self.kill;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create alive;
        v_ptc.start(f_kill());
        T.start;
        alt {
            [] v_ptc.killed { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
