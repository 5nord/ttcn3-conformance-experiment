// @requirement: 21.3.10 -- If no timeout duration is given, an infinite timeout duration is used.
// @id: TTCN3-CORE-21.3.10-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_the_call_test_component_behaviour_operation_005 {

    type component C {}

    function f_wait() runs on C return integer {
        timer T := 2.0;
        T.start;
        T.timeout;
        return 1;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_res := 0;
        timer T := 10.0;
        T.start;
        v_ptc.call(f_wait()) -> value v_res;
        if (v_res == 1 and T.read >= 2.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
