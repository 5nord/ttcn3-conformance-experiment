// @requirement: 21.3.6 -- When the any keyword is used with the running operation, it will return true if at least one PTC is executing its behaviour.
// @id: TTCN3-CORE-21.3.6-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_06_test_010 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }
    function f_short() runs on C {
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var C v_ptc3 := C.create;
        v_ptc2.start(f_short());
        v_ptc2.done;
        v_ptc3.start(f_wait());
        if (any component.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
