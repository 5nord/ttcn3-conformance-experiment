// @requirement: 21.3.7 -- This means it shall not be used in a boolean expression, but it can be used to determine an alternative in an alt statement or as stand-alone statement in a behaviour description.
// @id: TTCN3-CORE-21.3.7-005b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_07_the_done_operation_006 {

    type component C {}

    function f_ptc() runs on C {}

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        v_ptc.start(f_ptc());
        T.start;
        alt {
            [] T.timeout {
                setverdict(fail);
            }
            [] v_ptc.done {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
