// @requirement: 21.3.2 -- This is done by using the start operation (as PTC creation does not start execution of the component behaviour).
// @id: TTCN3-CORE-21.3.2-004b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_02_the_start_test_component_operation_003 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    function f_ptc() runs on C {
        p.send(integer:1);
    }

    testcase TC() runs on C {
        timer T := 0.5;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        if (v_ptc.running) {
            setverdict(fail);
        }
        T.start;
        alt {
            [] p.receive {
                setverdict(fail); // behaviour executed without start
            }
            [] T.timeout {
                setverdict(pass);
            }
        }
        v_ptc.start(f_ptc());
        p.receive(integer:1);
    }

    control {
        execute(TC());
    }
}
