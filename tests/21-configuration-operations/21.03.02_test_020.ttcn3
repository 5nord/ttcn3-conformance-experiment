// @requirement: 21.3.2 -- a) The ObjectReference shall be of component type and shall not resolve to a template.
// @id: TTCN3-CORE-21.3.2-022b
// @verdict: pass reject
module M_21_03_02_test_020 {

    type component C {}

    function f_ptc() runs on C {
        setverdict(pass);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var template C vt_ptc := v_ptc;
        vt_ptc.start(f_ptc()); // error: ObjectReference resolves to a template
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
