// @requirement: 21.3.9 -- The keywords any and all may be used with configuration operations as indicated in table 21.
// @id: TTCN3-CORE-21.3.9-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_09_summary_of_the_use_of_any_and_all_with_components_001 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        v_ptc.start(f_wait());
        if (not any component.running or not all component.running
            or not any component.alive or not all component.alive) {
            setverdict(fail);
        }
        all component.stop;
        any component.done;
        all component.done;
        all component.kill;
        any component.killed;
        all component.killed;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
