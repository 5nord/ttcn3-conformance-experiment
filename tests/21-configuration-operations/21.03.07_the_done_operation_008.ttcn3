// @requirement: 21.3.7 -- In the latter case a done operation is considered to be a shorthand for an alt statement with the done operation as the only alternative.
// @id: TTCN3-CORE-21.3.7-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_07_the_done_operation_008 {

    type component C {
        timer T;
    }

    function f_ptc() runs on C {
        T.start(5.0);
        T.timeout;
    }

    altstep a_stopPtc(C p_ptc) runs on C {
        [] T.timeout {
            p_ptc.stop;
            repeat;
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc());
        T.start(0.5);
        activate(a_stopPtc(v_ptc));
        v_ptc.done; // defaults are evaluated and repeat re-evaluates the implicit alt
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
