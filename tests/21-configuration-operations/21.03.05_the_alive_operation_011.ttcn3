// @requirement: 21.3.5 -- The first component to be found being inactive or running a behaviour causes the alive operation to return the true value.
// @id: TTCN3-CORE-21.3.5-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_05_the_alive_operation_011 {

    type component C {}

    function f_short() runs on C {
    }

    testcase TC() runs on C {
        var C v_arr[3] := { C.create, C.create, C.create };
        var integer v_idx := -1;
        var boolean v_res;
        v_arr[0].start(f_short());
        v_arr[0].done;
        v_res := any from v_arr.alive -> @index value v_idx;
        if (v_res and v_idx == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
