// @requirement: 21.3.6 -- The running operation allows behaviour executing on a test component to ascertain whether behaviour running on a different component has completed.
// @id: TTCN3-CORE-21.3.6-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_06_the_running_operation_002 {

    type component C {}

    function f_short() runs on C {
    }

    function f_wait() runs on C {
        timer T := 1.0;
        T.start;
        T.timeout;
    }

    function f_observe(C p_other) runs on C {
        if (not p_other.running) {
            setverdict(fail);
            stop;
        }
        p_other.done;
        if (p_other.running) {
            setverdict(fail);
        } else {
            setverdict(pass);
        }
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        v_ptc1.start(f_wait());
        v_ptc2.start(f_observe(v_ptc1));
        v_ptc2.done;
    }

    control {
        execute(TC());
    }
}
