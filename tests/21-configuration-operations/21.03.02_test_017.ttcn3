// @requirement: 21.3.2 -- If a variable is given as an actual out parameter, it will remain unchanged by the started behaviour, even if the behaviour changes the formal parameter during its execution.
// @id: TTCN3-CORE-21.3.2-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_02_test_017 {

    type component C {}

    function f_ptc(out integer p_out) runs on C {
        p_out := 10;
        setverdict(pass);
    }

    testcase TC() runs on C {
        var integer v_int := 1;
        var C v_ptc := C.create;
        v_ptc.start(f_ptc(v_int));
        v_ptc.done;
        if (v_int != 1) {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
