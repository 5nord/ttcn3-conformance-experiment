// @requirement: 21.3.6 -- ( ObjectReference | any component | all component | any from ComponentArrayRef ) "." running [ "->" @index value ValueRef]
// @id: TTCN3-CORE-21.3.6-002a
// @verdict: pass accept, noexecution
module M_21_03_06_test_001 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var C v_arr[2] := { C.create, C.create };
        var integer v_idx;
        var boolean v_b;
        v_ptc.start(f_wait());
        v_b := v_ptc.running;
        v_b := any component.running;
        v_b := all component.running;
        v_b := any from v_arr.running;
        v_b := any from v_arr.running -> @index value v_idx;
    }
}
