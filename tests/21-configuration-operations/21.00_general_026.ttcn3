// @requirement: 21.0 -- Alive Returns true if the test component has `if (c.alive) …` been created and is ready to execute or is already executingbehaviour; otherwise returns false
// @id: TTCN3-CORE-21.0-021c
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_general_026 {

    type component C {}

    testcase TC() runs on C {
        var C c := C.create alive;
        var boolean v_b := c.alive;
        if (c.alive and v_b) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
