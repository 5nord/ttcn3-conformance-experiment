// @requirement: 21.3.10 -- Operation: stop; Col3: Yes but from MTC only; Example: all component.stop;; Comment: Stop the behaviour on all PTCs.
// @id: TTCN3-CORE-21.3.10-019c
// @verdict: pass reject
module M_21_03_10_the_call_test_component_behaviour_operation_031 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_wait());
        any component.stop; // error: stop used with any component
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
