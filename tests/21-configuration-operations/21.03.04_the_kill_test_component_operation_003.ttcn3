// @requirement: 21.3.4 -- Killing a test component destroys the test component.
// @id: TTCN3-CORE-21.3.4-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_04_the_kill_test_component_operation_003 {

    type component C {}

    testcase TC() runs on C {
        timer T := 2.0;
        var C v_ptc := C.create alive;
        v_ptc.kill;
        T.start;
        alt {
            [] v_ptc.killed { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
        if (v_ptc.alive) {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
