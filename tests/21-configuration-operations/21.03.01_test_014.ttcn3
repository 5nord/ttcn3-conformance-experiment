// @requirement: 21.3.1 -- The create operation shall return the unique component reference of the newly created instance.
// @id: TTCN3-CORE-21.3.1-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_01_test_014 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var C v_ptc3 := C.create alive;
        if (v_ptc1 != null and v_ptc2 != null and v_ptc3 != null and
            v_ptc1 != v_ptc2 and v_ptc1 != v_ptc3 and v_ptc2 != v_ptc3 and
            v_ptc1 != mtc and v_ptc2 != mtc and v_ptc3 != mtc) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
