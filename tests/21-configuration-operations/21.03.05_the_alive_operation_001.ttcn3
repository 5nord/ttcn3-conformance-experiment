// @requirement: 21.3.5 -- The alive operation is a Boolean operation that checks whether a test component has been created and is ready to execute or is executing already a behaviour.
// @id: TTCN3-CORE-21.3.5-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_05_the_alive_operation_001 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var boolean v_created := v_ptc.alive;
        v_ptc.start(f_wait());
        var boolean v_executing := v_ptc.alive;
        if (v_created and v_executing) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
