// @requirement: 21.3.1 -- The MTC is the only test component, which is automatically created when a test case starts.
// @id: TTCN3-CORE-21.3.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_01_test_002 {

    type component C {}

    testcase TC() runs on C {
        if (self == mtc and mtc != null and not any component.alive and not any component.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
