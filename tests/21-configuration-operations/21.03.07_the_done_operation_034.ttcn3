// @requirement: 21.3.7 -- g) If the index redirection is used for single-dimensional component arrays, the type of the integer variable shall allow storing the highest index of the respective array.
// @id: TTCN3-CORE-21.3.7-031a
// @verdict: pass reject
module M_21_03_07_the_done_operation_034 {

    type component C {}

    type integer SmallInt (0..1);

    function f_ptc() runs on C {}

    testcase TC() runs on C {
        var C v_arr[3];
        var SmallInt v_idx;
        for (var integer i := 0; i < 3; i := i + 1) {
            v_arr[i] := C.create;
            v_arr[i].start(f_ptc());
        }
        all component.done;
        any from v_arr.done -> @index value v_idx; // error: highest index 2 not storable in SmallInt
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
