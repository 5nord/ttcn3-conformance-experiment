// @requirement: 21.3.2 -- Possible return values of a function invoked in a start test component operation, i.e. templates denoted by return keyword or inout and out parameters, have no effect when the started test component terminates.
// @id: TTCN3-CORE-21.3.2-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_02_the_start_test_component_operation_018 {

    type component C {}

    function f_ptc(out integer p_out, inout integer p_io) runs on C return integer {
        p_out := 10;
        p_io := 20;
        setverdict(pass);
        return 30;
    }

    testcase TC() runs on C {
        var integer v_out := 1;
        var integer v_io := 2;
        var C v_ptc := C.create;
        v_ptc.start(f_ptc(v_out, v_io));
        v_ptc.done;
        if (v_out != 1 or v_io != 2) {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
