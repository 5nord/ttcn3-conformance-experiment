// @requirement: 21.1.0 -- Operation: Running; Explanation: Returns true as long as the test component is executing behaviour; otherwise returns false; Syntax Examples: if (c.running) …
// @id: TTCN3-CORE-21.1.0-012b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_00_test_020 {

    type component C {}

    function f() runs on C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        var boolean v_beforeStart := v_ptc.running;
        v_ptc.start(f());
        v_ptc.done;
        if (not v_beforeStart and not v_ptc.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
