// @requirement: 21.1.1 -- Before either operation is called, the components to be connected shall have been created and their component references shall be known together with the names of the relevant ports.
// @id: TTCN3-CORE-21.1.1-008a
// @verdict: pass accept, ttcn3verdict:error
module M_21_01_01_the_connect_and_map_operations_012 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := null;
        setverdict(pass);
        connect(mtc:p, v_ptc:p); // error: component has not been created
    }

    control {
        execute(TC());
    }
}
