// @requirement: 21.1.0 -- Operation: Start; Explanation: Starting test behaviour on a test component, starting behaviour does not affect the status of component variables, timers or ports; Syntax Examples: c.start(PTCBehaviour());
// @id: TTCN3-CORE-21.1.0-008b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_00_test_010 {

    type port P message { inout integer; }

    type component C {
        var integer v_x := 0;
        timer T_c;
        port P p;
    }

    function f_first() runs on C {
        v_x := 10;
        T_c.start(5.0);
    }

    function f_second() runs on C {
        timer T := 1.0;
        if (v_x != 10 or not T_c.running) {
            setverdict(fail);
            return;
        }
        T.start;
        alt {
            [] p.receive(1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        connect(mtc:p, v_ptc:p);
        p.send(1);
        v_ptc.start(f_first());
        v_ptc.done;
        v_ptc.start(f_second());
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
