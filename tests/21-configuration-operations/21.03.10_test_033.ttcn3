// @requirement: 21.3.10 -- Operation: kill; Col3: Yes but from MTC only; Example: all component.kill;; Comment: Kill all PTCs, i.e. they cease to exist.
// @id: TTCN3-CORE-21.3.10-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_test_033 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        all component.kill;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
