// @requirement: 21.3.2 -- Starting a second behaviour on a non-alive PTC or starting a behaviour on a PTC that is still running results in a test case error.
// @id: TTCN3-CORE-21.3.2-009b
// @verdict: pass accept, ttcn3verdict:error
module M_21_03_02_the_start_test_component_operation_008 {

    type component C {}

    function f_ptc() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
        setverdict(pass);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        v_ptc.start(f_ptc());
        v_ptc.start(f_ptc()); // test case error: PTC is still running
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
