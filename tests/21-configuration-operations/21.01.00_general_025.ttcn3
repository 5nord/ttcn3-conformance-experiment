// @requirement: 21.1.0 -- Operation: Killed; Explanation: Checks whether a component has ceased to exist; Syntax Examples: c.killed { … }
// @id: TTCN3-CORE-21.1.0-014b
// @verdict: pass accept, noexecution
module M_21_01_00_general_025 {

    type component C {}

    testcase TC() runs on C {
        var C c := C.create alive;
        c.kill;
        c.killed;
        alt {
            [] c.killed { setverdict(pass); }
        }
    }
}
