// @requirement: 21.3.7 -- Otherwise, the match is unsuccessful.
// @id: TTCN3-CORE-21.3.7-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_07_test_011 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_wait());
        alt {
            [] v_ptc.done {
                setverdict(fail);
            }
            [else] {
                setverdict(pass);
            }
        }
        v_ptc.kill;
    }

    control {
        execute(TC());
    }
}
