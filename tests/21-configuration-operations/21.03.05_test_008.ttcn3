// @requirement: 21.3.5 -- In particular, in combination with the all keyword it returns true if all (alive-type or normal) PTCs are alive.
// @id: TTCN3-CORE-21.3.5-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_05_test_008 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }
    function f_short() runs on C {
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create alive;
        var C v_ptc3 := C.create alive;
        v_ptc2.start(f_wait());
        v_ptc3.start(f_short());
        v_ptc3.done;
        if (all component.alive) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
