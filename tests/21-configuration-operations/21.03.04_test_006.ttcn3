// @requirement: 21.3.4 -- The kill operation applied on a test component stops the execution of the currently running behaviour - if any - of that component and frees all resources associated to it (including all port connections of the killed component) and removes the component from the test system.
// @id: TTCN3-CORE-21.3.4-005b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_04_test_006 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    function f_wait() runs on C {
        timer T_w := 5.0;
        T_w.start;
        T_w.timeout;
    }

    testcase TC() runs on C {
        timer T := 2.0;
        var C v_ptc := C.create alive;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_wait());
        v_ptc.kill;
        T.start;
        alt {
            [] v_ptc.killed { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
        if (p.checkstate("Connected")) {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
