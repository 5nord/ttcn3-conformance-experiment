// @requirement: 21.0 -- **Test Case Operations** Stop Terminates the test case with the test `testcase.stop ( … );` verdict error
// @id: TTCN3-CORE-21.0-025a
// @verdict: pass accept, ttcn3verdict:error
module M_21_00_general_034 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
        testcase.stop;
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
