// @requirement: 21.0 -- Operation: Connect; Explanation: Connects the port of one test component to the port of another test component; Syntax Examples: connect(ptc1:p1, ptc2:p2);
// @id: TTCN3-CORE-21.0-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_general_005 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    function f_echo() runs on C {
        var integer v_i;
        p.receive(integer:?) -> value v_i;
        p.send(v_i);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_echo());
        p.send(42);
        T.start;
        alt {
            [] p.receive(42) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
