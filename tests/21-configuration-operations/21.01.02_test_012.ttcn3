// @requirement: 21.1.2 -- It disconnects or unmaps all ports of the component that calls the operation.
// @id: TTCN3-CORE-21.1.2-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_02_test_012 {

    type port P message { inout integer; }

    type component C { port P p1, p2; }

    function f_release() runs on C {
        disconnect;
        unmap;
        if (not p1.checkstate("Connected") and not p2.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        var C v_other := C.create;
        connect(self:p1, v_ptc:p1);
        connect(self:p2, v_other:p2);
        map(v_ptc:p2, system:p2);
        v_ptc.start(f_release());
        v_ptc.done;
        if (not p1.checkstate("Connected") and p2.checkstate("Connected")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
