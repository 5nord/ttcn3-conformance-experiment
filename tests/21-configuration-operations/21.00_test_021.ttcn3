// @requirement: 21.0 -- Stop Stopping test behaviour on a test `c.stop;` component
// @id: TTCN3-CORE-21.0-019b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_test_021 {

    type component C {}

    function f_behaviour() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C c := C.create;
        c.start(f_behaviour());
        c.stop;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
