// @requirement: 21.3.3 -- Stopping an alive-type component means that all variables, timers and ports declared in the component type definition of the alive-type component keep their value, contents or state.
// @id: TTCN3-CORE-21.3.3-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_03_the_stop_test_behaviour_operation_018 {

    type port P message { inout integer; }

    type component C {
        port P p;
        var integer v_x := 0;
        timer T_c;
    }

    function f_first() runs on C {
        timer T_w := 5.0;
        v_x := 5;
        T_c.start(10.0);
        p.send(0);
        T_w.start;
        T_w.timeout;
    }

    function f_second() runs on C {
        timer T_g := 1.0;
        if (v_x != 5 or not T_c.running) {
            setverdict(fail);
        }
        T_g.start;
        alt {
            [] p.receive(7) { setverdict(pass); }
            [] T_g.timeout { setverdict(fail); }
        }
    }

    testcase TC() runs on C {
        timer T := 2.0;
        var C v_ptc := C.create alive;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_first());
        T.start;
        alt {
            [] p.receive(0) {}
            [] T.timeout { setverdict(fail); stop; }
        }
        p.send(7);
        v_ptc.stop;
        v_ptc.start(f_second());
        v_ptc.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
