// @requirement: 21.3.10 -- d) The return value of the function invoked from a call test component operation shall be of a component data type.
// @id: TTCN3-CORE-21.3.10-031a
// @verdict: pass reject
module M_21_03_10_the_call_test_component_behaviour_operation_046 {

    type component C {}

    function f_behaviour() runs on C return default {
        return null;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.call(f_behaviour()); // error: return type default is not a component data type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
