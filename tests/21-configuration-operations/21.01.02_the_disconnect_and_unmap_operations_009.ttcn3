// @requirement: 21.1.2 -- This one argument specifies one side of the connections to be disconnected or unmapped.
// @id: TTCN3-CORE-21.1.2-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_02_the_disconnect_and_unmap_operations_009 {

    type port P message { inout integer; }

    type component C { port P p1, p2; }

    testcase TC() runs on C system C {
        var C v_a := C.create;
        var C v_b := C.create;
        connect(self:p1, v_a:p1);
        connect(self:p1, v_b:p1);
        map(self:p2, system:p2);
        disconnect(self:p1);
        unmap(self:p2);
        if (not p1.checkstate("Connected") and not p2.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
