// @requirement: 21.3.1 -- a) The name given by the first Expression shall be a charstring value and when assigned it shall appear as the first argument of the create function.
// @id: TTCN3-CORE-21.3.1-024a
// @verdict: pass reject
module M_21_03_01_the_create_operation_029 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create(42); // error: name is not a charstring
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
