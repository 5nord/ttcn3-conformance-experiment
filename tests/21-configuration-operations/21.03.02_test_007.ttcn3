// @requirement: 21.3.2 -- Starting a second behaviour on a non-alive PTC or starting a behaviour on a PTC that is still running results in a test case error.
// @id: TTCN3-CORE-21.3.2-009a
// @verdict: pass accept, ttcn3verdict:error
module M_21_03_02_test_007 {

    type component C {}

    function f_ptc() runs on C {
        setverdict(pass);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc());
        v_ptc.done;
        v_ptc.start(f_ptc()); // test case error: second behaviour on a non-alive PTC
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
