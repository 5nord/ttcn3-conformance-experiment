// @requirement: 21.3.3 -- The implicit stop has the same effects as an explicit stop, i.e. the global verdict is updated with the local verdict of the stopped test component (see clause 24).
// @id: TTCN3-CORE-21.3.3-010b
// @verdict: pass accept, ttcn3verdict:inconc
module M_21_03_03_the_stop_test_behaviour_operation_009 {

    type component C {}

    function f_implicit() runs on C {
        setverdict(inconc);
    }

    testcase TC() runs on C {
        timer T := 2.0;
        var C v_ptc := C.create;
        setverdict(pass);
        v_ptc.start(f_implicit());
        T.start;
        alt {
            [] v_ptc.done {}
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
