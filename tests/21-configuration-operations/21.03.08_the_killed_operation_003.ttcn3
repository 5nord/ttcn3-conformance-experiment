// @requirement: 21.3.8 -- [ @nodefault ] ( ObjectReference | any component | all component | any from ComponentArrayRef ) "." killed [ "->" [ value ValueRef] [ @index value ValueRef] ]
// @id: TTCN3-CORE-21.3.8-003a
// @verdict: pass accept, noexecution
module M_21_03_08_the_killed_operation_003 {

    type component C {}

    function f_ptc() runs on C {}

    testcase TC() runs on C {
        var verdicttype v_verdict;
        var integer v_idx;
        var C v_ptc := C.create;
        var C v_arr[2] := { C.create, C.create };
        v_ptc.start(f_ptc());
        v_arr[0].start(f_ptc());
        v_arr[1].start(f_ptc());
        v_ptc.killed;
        @nodefault v_ptc.killed;
        any component.killed;
        all component.killed;
        any from v_arr.killed;
        v_ptc.killed -> value v_verdict;
        any from v_arr.killed -> @index value v_idx;
        any from v_arr.killed -> value v_verdict @index value v_idx;
        @nodefault any from v_arr.killed -> value v_verdict @index value v_idx;
    }
}
