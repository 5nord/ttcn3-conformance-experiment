// @requirement: 21.3.4 -- The kill operation can be applied on the current test component itself by a simple kill statement or by addressing itself using the self operation in conjunction with the kill operation.
// @id: TTCN3-CORE-21.3.4-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_04_test_008 {

    type component C {}

    function f_kill() runs on C {
        setverdict(pass);
        kill;
        setverdict(fail);
    }

    function f_selfKill() runs on C {
        setverdict(pass);
        self.kill;
        setverdict(fail);
    }

    testcase TC() runs on C {
        timer T := 2.0;
        var C v_ptc1 := C.create alive;
        var C v_ptc2 := C.create alive;
        v_ptc1.start(f_kill());
        v_ptc2.start(f_selfKill());
        T.start;
        alt {
            [] all component.killed { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
