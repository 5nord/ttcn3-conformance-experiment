// @requirement: 21.3.8 -- j) The @nodefault modifier is allowed only in stand-alone killed statements.
// @id: TTCN3-CORE-21.3.8-032a
// @verdict: pass reject
module M_21_03_08_the_killed_operation_036 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        timer T := 1.0;
        v_ptc.kill;
        T.start;
        alt {
            [] @nodefault v_ptc.killed { // error: @nodefault in an alt branch
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
