// @requirement: 21.1.1 -- NOTE 2: Note that PORT1 and PORT2 can occur in any order, thus the system adapter port can be either the first or the second operand of the map operation.
// @id: TTCN3-CORE-21.1.1-031a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_01_test_028 {

    type port P message { inout integer; }

    type component C { port P p; }

    testcase TC() runs on C system C {
        map(system:p, self:p);
        if (p.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
