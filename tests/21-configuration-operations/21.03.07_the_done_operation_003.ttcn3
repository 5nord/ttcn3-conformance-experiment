module M_21_03_07_the_done_operation_003 {

    type component C {}

    function f_ptc() runs on C {}

    testcase TC() runs on C {
        var verdicttype v_verdict;
        var integer v_idx;
        var C v_ptc := C.create;
        var C v_arr[2] := { C.create, C.create };
        v_ptc.start(f_ptc());
        v_arr[0].start(f_ptc());
        v_arr[1].start(f_ptc());
        v_ptc.done;
        @nodefault v_ptc.done;
        any component.done;
        all component.done;
