// @requirement: 21.1.0 -- Operation: Stop; Explanation: Terminates the test case with the test verdict error; Syntax Examples: testcase.stop ( … );
// @id: TTCN3-CORE-21.1.0-016a
// @verdict: pass accept, ttcn3verdict:error
module M_21_01_00_general_026 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
        testcase.stop("Unexpected Termination");
    }

    control {
        execute(TC());
    }
}
