// @requirement: 21.3.6 -- Otherwise it returns false.
// @id: TTCN3-CORE-21.3.6-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_06_test_008 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }
    function f_short() runs on C {
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        v_ptc1.start(f_wait());
        v_ptc2.start(f_short());
        v_ptc2.done;
        if (not all component.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
