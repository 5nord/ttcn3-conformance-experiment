// @requirement: 21.1.2 -- To ease disconnect and unmap operations related to all connections and mappings of a component or a port, it is allowed to use disconnect and unmap operations with one argument only.
// @id: TTCN3-CORE-21.1.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_02_the_disconnect_and_unmap_operations_008 {

    type port P message { inout integer; }

    type component C { port P p1, p2; }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        connect(self:p1, v_ptc:p1);
        map(self:p2, system:p2);
        disconnect(self:p1);
        unmap(self:p2);
        if (not p1.checkstate("Connected") and not p2.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
