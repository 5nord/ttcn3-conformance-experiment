// @requirement: 21.1.0 -- When connecting a test component to a test system interface the map operation shall be used.
// @id: TTCN3-CORE-21.1.0-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_00_general_003 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P p;
    }

    function f_check() runs on C {
        if (p.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C system S {
        var C v_ptc := C.create;
        map(v_ptc:p, system:p);
        v_ptc.start(f_check());
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
