// @requirement: 21.3.10 -- In all cases of incomplete execution, the variables referenced in the value and verdict clause or in out and inout actual parameters will stay unchanged and no assignment will be made.
// @id: TTCN3-CORE-21.3.10-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_test_041 {

    type component C {}

    function f(out integer p_out, inout integer p_inout) runs on C return integer {
        p_out := 10;
        p_inout := 20;
        setverdict(pass);
        self.stop;
        return 30;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_out := 1, v_inout := 2, v_res := 3;
        var verdicttype v_verdict := inconc;
        v_ptc.call(f(v_out, v_inout)) -> value v_res verdict v_verdict
            catch (stop) {}
        if (v_out == 1 and v_inout == 2 and v_res == 3 and v_verdict == inconc) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
