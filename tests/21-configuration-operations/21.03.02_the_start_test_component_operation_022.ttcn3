// @requirement: 21.3.2 -- c) All formal parameters of the function or altstep invoked in a start test component operation shall be of a component data type.
// @id: TTCN3-CORE-21.3.2-024a
// @verdict: pass reject
module M_21_03_02_the_start_test_component_operation_022 {

    type component C {
        timer T_t := 1.0;
    }

    function f_ptc(timer p_t) runs on C {
        p_t.start;
        setverdict(pass);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc(T_t)); // error: timer parameter in a started function
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
