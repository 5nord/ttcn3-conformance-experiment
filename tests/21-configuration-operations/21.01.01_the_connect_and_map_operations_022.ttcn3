// @requirement: 21.1.1 -- 3) atleast one of outlist-PORT1 or outlist-PORT2 is not empty.
// @id: TTCN3-CORE-21.1.1-026a
// @verdict: pass reject
module M_21_01_01_the_connect_and_map_operations_022 {

    type port P message { in integer; }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p); // error: both outlists are empty
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
