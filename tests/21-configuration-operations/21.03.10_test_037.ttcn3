// @requirement: 21.3.10 -- NOTE: any and all refer to PTCs only, i.e. the MTC is not considered.
// @id: TTCN3-CORE-21.3.10-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_test_037 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        v_ptc.kill;
        if (any component.running or any component.alive) {
            setverdict(fail);
            stop;
        }
        alt {
            [] all component.killed {
                setverdict(pass);
            }
            [else] {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
