// @requirement: 21.3.3 -- If the stopped test component is the MTC, resources of all existing PTCs shall be released, the PTCs shall be removed from the test system and the test case shall terminate (see clause 26.1).
// @id: TTCN3-CORE-21.3.3-011b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_03_test_011 {

    type component C {}

    function f_failLater() runs on C {
        timer T_w := 0.5;
        T_w.start;
        T_w.timeout;
        setverdict(fail);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_failLater());
        setverdict(pass);
        mtc.stop;
    }

    control {
        execute(TC());
    }
}
