// @requirement: 21.3.1 -- a) The name given by the first Expression shall be a charstring value and when assigned it shall appear as the first argument of the create function.
// @id: TTCN3-CORE-21.3.1-024b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_01_test_030 {

    type component C {}

    function f_ptc() runs on C {
        setverdict(pass);
    }

    testcase TC() runs on C {
        var charstring v_name := "MyPTC";
        var C v_ptc1 := C.create("FirstArgName");
        var C v_ptc2 := C.create(v_name) alive;
        v_ptc1.start(f_ptc());
        v_ptc2.start(f_ptc());
        all component.done;
    }

    control {
        execute(TC());
    }
}
