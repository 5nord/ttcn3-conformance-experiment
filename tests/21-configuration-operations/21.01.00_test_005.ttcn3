// @requirement: 21.1.0 -- Operation: Create; Explanation: Creation of a normal or alive test component, the distinction between normal and alive test components is made during creation (MTC behaves as a normal test component); Syntax Examples: Non-alive test components: var PTCType c := PTCType.create; Alive test components: var PTCType c := PTCType.create alive;
// @id: TTCN3-CORE-21.1.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_00_test_005 {

    type component C {}

    testcase TC() runs on C {
        var C v_normal := C.create;
        var C v_alive := C.create alive;
        if (v_normal.alive and v_alive.alive and v_normal != v_alive) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
