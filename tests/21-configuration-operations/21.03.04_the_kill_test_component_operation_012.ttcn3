// @requirement: 21.3.4 -- The all keyword can be used by the MTC only in order to stop and kill all running PTCs but the MTC itself.
// @id: TTCN3-CORE-21.3.4-010a
// @verdict: pass reject
module M_21_03_04_the_kill_test_component_operation_012 {

    type component C {}

    function f_killAll() runs on C {
        all component.kill; // error: all component.kill used outside the MTC
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_killAll());
        v_ptc.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
