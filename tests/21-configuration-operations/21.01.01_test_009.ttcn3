// @requirement: 21.1.1 -- All these operations can be used for identifying and connecting ports.
// @id: TTCN3-CORE-21.1.1-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_01_test_009 {

    type port P message { inout integer; }

    type component C {
        port P p;
        port P q;
    }

    type component S {
        port P q;
    }

    function f_behaviour() runs on C {
        connect(self:p, mtc:p);
        map(self:q, system:q);
        if (q.checkstate("Mapped")) {
            p.send(1);
        }
    }

    testcase TC() runs on C system S {
        timer T := 1.0;
        var C v_ptc := C.create;
        v_ptc.start(f_behaviour());
        T.start;
        alt {
            [] p.receive(1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
