// @requirement: 21.3.6 -- It returns false otherwise.
// @id: TTCN3-CORE-21.3.6-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_06_test_004 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }
    function f_short() runs on C {
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var C v_ptc3 := C.create alive;
        v_ptc2.start(f_short());
        v_ptc2.done;
        v_ptc3.start(f_wait());
        v_ptc3.stop;
        if (not v_ptc1.running and not v_ptc2.running and not v_ptc3.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
