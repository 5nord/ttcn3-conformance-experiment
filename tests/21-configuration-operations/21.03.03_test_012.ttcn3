// @requirement: 21.3.3 -- If the stopped test component is the MTC, resources of all existing PTCs shall be released, the PTCs shall be removed from the test system and the test case shall terminate (see clause 26.1).
// @id: TTCN3-CORE-21.3.3-011c
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_03_test_012 {

    type component C {}

    function f_wait() runs on C {
        timer T_w := 30.0;
        T_w.start;
        T_w.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_wait());
        setverdict(pass);
        mtc.stop;
        setverdict(fail);
    }

    control {
        execute(TC(), 5.0);
    }
}
