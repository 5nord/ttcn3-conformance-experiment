// @requirement: 21.3.8 -- This means it shall not be used in boolean expressions, but it can be used to determine an alternative in an alt statement or as a stand-alone statement in a behaviour description.
// @id: TTCN3-CORE-21.3.8-005c
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_08_the_killed_operation_007 {

    type component C {}

    function f_ptc() runs on C {}

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc());
        v_ptc.killed;
        if (v_ptc.alive) {
            setverdict(fail);
        } else {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
