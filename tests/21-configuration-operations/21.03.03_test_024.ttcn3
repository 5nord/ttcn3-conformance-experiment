// @requirement: 21.3.3 -- The all keyword can be used by the MTC only in order to stop all running PTCs but the MTC itself.
// @id: TTCN3-CORE-21.3.3-020b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_03_test_024 {

    type component C {}

    function f_wait() runs on C {
        timer T_w := 5.0;
        T_w.start;
        T_w.timeout;
        setverdict(fail);
    }

    testcase TC() runs on C {
        timer T := 2.0;
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create alive;
        v_ptc1.start(f_wait());
        v_ptc2.start(f_wait());
        all component.stop;
        T.start;
        alt {
            [] all component.done { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
        if (any component.running) {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
