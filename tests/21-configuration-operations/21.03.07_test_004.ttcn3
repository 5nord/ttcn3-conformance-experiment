// @requirement: 21.3.7 -- The done operation shall be used in the same manner as a receiving operation or a timeout operation.
// @id: TTCN3-CORE-21.3.7-004a
// @verdict: pass reject
module M_21_03_07_test_004 {

    type component C {}

    function f_ptc() runs on C {}

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc());
        var boolean v_b := v_ptc.done; // error: done used as a value
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
