// @requirement: 21.2.1 -- The test case stop operation causes an immediate stop of the entire test case behaviour with the verdict error.
// @id: TTCN3-CORE-21.2.1-004a
// @verdict: pass accept, ttcn3verdict:error
module M_21_02_01_test_case_stop_operation_004 {

    type component C {}

    function f_stop() runs on C {
        testcase.stop("Stopped by PTC");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_stop());
        v_ptc.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
