// @requirement: 21.3.1 -- The test system shall associate the names 'MTC' to the MTC and 'SYSTEM' to the test system interface automatically at creation.
// @id: TTCN3-CORE-21.3.1-016b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_01_the_create_operation_019 {

    type component C {}

    testcase TC() runs on C system C {
        log("System reference: ", system); // the log shall show the name SYSTEM
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
