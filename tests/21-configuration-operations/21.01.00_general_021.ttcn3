// @requirement: 21.1.0 -- Operation: Running; Explanation: Returns true as long as the test component is executing behaviour; otherwise returns false; Syntax Examples: if (c.running) …
// @id: TTCN3-CORE-21.1.0-012c
// @verdict: pass accept, noexecution
module M_21_01_00_general_021 {

    type component C {}

    function f() runs on C {}

    testcase TC() runs on C {
        var C c := C.create;
        c.start(f());
        var boolean v_b := c.running;
        if (c.running) {
            setverdict(pass);
        }
    }
}
