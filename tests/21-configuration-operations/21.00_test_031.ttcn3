// @requirement: 21.0 -- Done Checks whether the function running on a test component has terminated
// @id: TTCN3-CORE-21.0-023b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_test_031 {

    type component C {}

    function f_behaviour() runs on C {}

    testcase TC() runs on C {
        var C c := C.create;
        c.start(f_behaviour());
        c.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
