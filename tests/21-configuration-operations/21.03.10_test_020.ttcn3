// @requirement: 21.3.10 -- Operation: alive; Allowed: Yes but from MTC only; Col3: Yes but from MTC only; Example: any component.alive; all component.alive;; Comment: Is there any alive PTC? Are all PTCs alive?
// @id: TTCN3-CORE-21.3.10-016d
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_test_020 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc1 := C.create alive;
        var C v_ptc2 := C.create alive;
        if (not all component.alive) {
            setverdict(fail);
            stop;
        }
        v_ptc1.kill;
        if (all component.alive) {
            setverdict(fail);
        } else {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
