// @requirement: 21.3.7 -- In addition, the done operation allows to retrieve the final local verdict of completed test components, i.e. the value of the local verdict at the time of test component completion.
// @id: TTCN3-CORE-21.3.7-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_07_the_done_operation_002 {

    type component C {}

    function f_ptc() runs on C {
        setverdict(pass);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var verdicttype v_verdict := none;
        var C v_ptc := C.create;
        v_ptc.start(f_ptc());
        T.start;
        alt {
            [] v_ptc.done -> value v_verdict {
                if (v_verdict == pass) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
