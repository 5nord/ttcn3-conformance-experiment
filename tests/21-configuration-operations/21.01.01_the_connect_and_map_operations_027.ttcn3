// @requirement: 21.1.1 -- 3) at least one of outlist-PORT1 or inlist-PORT2 is not empty.
// @id: TTCN3-CORE-21.1.1-030a
// @verdict: pass reject
module M_21_01_01_the_connect_and_map_operations_027 {

    type port PComp message {
        in integer;
    }

    type port PSys message {
        out integer;
    }

    type component C {
        port PComp p;
    }

    type component S {
        port PSys p;
    }

    testcase TC() runs on C system S {
        map(mtc:p, system:p); // error: outlist of mtc:p and inlist of system:p are both empty
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
