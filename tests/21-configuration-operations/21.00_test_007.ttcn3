// @requirement: 21.0 -- Operation: Disconnect; Explanation: Disconnects two or more connected ports; Syntax Examples: disconnect(ptc1:p1, ptc2:p2);
// @id: TTCN3-CORE-21.0-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_test_007 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        if (not p.checkstate("Connected")) {
            setverdict(fail);
        }
        disconnect(self:p, v_ptc:p);
        if (p.checkstate("Connected")) {
            setverdict(fail);
        } else {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
