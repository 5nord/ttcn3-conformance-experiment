// @requirement: 21.3.3 -- stop | ( ( ObjectReference | mtc | self ) "." stop ) | ( all component "." stop )
// @id: TTCN3-CORE-21.3.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_03_test_001 {

    type component C {}

    function f_wait() runs on C {
        timer T_w := 5.0;
        T_w.start;
        T_w.timeout;
    }

    function f_stop() runs on C {
        stop;
    }

    function f_selfStop() runs on C {
        self.stop;
    }

    function f_mtcStop() runs on C {
        mtc.stop;
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var C v_ptc3 := C.create;
        var C v_ptc4 := C.create;
        v_ptc1.start(f_stop());
        v_ptc2.start(f_selfStop());
        v_ptc3.start(f_wait());
        v_ptc4.start(f_wait());
        v_ptc1.done;
        v_ptc2.done;
        v_ptc3.stop;
        all component.stop;
        setverdict(pass);
        mtc.stop;
    }

    control {
        execute(TC());
    }
}
