// @requirement: 21.3.6 -- f) If a variable referenced in the @index clause is a lazy or fuzzy variable, the expression assigned to this variable is equal to the result produced by the running operation.
// @id: TTCN3-CORE-21.3.6-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_06_the_running_operation_022 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_arr[3] := { C.create, C.create, C.create };
        var @fuzzy integer v_idx;
        var boolean v_res;
        v_arr[1].start(f_wait());
        v_res := any from v_arr.running -> @index value v_idx;
        if (v_res and v_idx == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
