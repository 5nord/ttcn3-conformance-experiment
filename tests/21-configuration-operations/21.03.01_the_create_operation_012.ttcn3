// @requirement: 21.3.1 -- Termination of a test case, i.e. the MTC, terminates all PTCs that still exist, if any.
// @id: TTCN3-CORE-21.3.1-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_01_the_create_operation_012 {

    type component C {}

    function f_ptc() runs on C {
        timer T := 60.0;
        T.start;
        T.timeout;
        setverdict(fail);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create alive;
        var C v_ptc3 := C.create;
        v_ptc1.start(f_ptc());
        v_ptc2.start(f_ptc());
        setverdict(pass);
    }

    testcase TC_check() runs on C {
        if (any component.alive) {
            setverdict(fail);
        } else {
            setverdict(pass);
        }
    }

    control {
        var verdicttype v_verdict := execute(TC(), 5.0);
        if (v_verdict == pass) {
            execute(TC_check());
        }
    }
}
