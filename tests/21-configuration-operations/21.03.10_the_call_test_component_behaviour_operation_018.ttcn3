// @requirement: 21.3.10 -- Operation: alive; Allowed: Yes but from MTC only; Col3: Yes but from MTC only; Example: any component.alive; all component.alive;; Comment: Is there any alive PTC? Are all PTCs alive?
// @id: TTCN3-CORE-21.3.10-016b
// @verdict: pass reject
module M_21_03_10_the_call_test_component_behaviour_operation_018 {

    type component C {}

    function f() runs on C {
        if (all component.alive) { // error: all component.alive used in a PTC
            setverdict(pass);
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f());
        v_ptc.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
