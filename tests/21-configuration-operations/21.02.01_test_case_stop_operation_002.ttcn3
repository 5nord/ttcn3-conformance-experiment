// @requirement: 21.2.1 -- The testcase stop operation defines a user defined immediate termination of a test case with the test verdict error and an (optional) associated reason for the termination.
// @id: TTCN3-CORE-21.2.1-001b
// @verdict: pass accept, ttcn3verdict:error
module M_21_02_01_test_case_stop_operation_002 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
        testcase.stop("Unexpected termination");
    }

    control {
        execute(TC());
    }
}
