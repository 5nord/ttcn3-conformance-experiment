// @requirement: 21.3.2 -- This is done by using the start operation (as PTC creation does not start execution of the component behaviour).
// @id: TTCN3-CORE-21.3.2-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_02_the_start_test_component_operation_002 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    function f_ptc() runs on C {
        p.send(integer:1);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_ptc());
        T.start;
        alt {
            [] p.receive(integer:1) from v_ptc {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
