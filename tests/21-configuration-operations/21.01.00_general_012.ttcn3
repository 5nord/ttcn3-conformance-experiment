// @requirement: 21.1.0 -- Operation: Stop; Explanation: Stopping test behaviour on a test component; Syntax Examples: c.stop;
// @id: TTCN3-CORE-21.1.0-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_00_general_012 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
        setverdict(fail);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        v_ptc.start(f_wait());
        v_ptc.stop;
        T.start;
        alt {
            [] v_ptc.done {
                if (not v_ptc.running) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
