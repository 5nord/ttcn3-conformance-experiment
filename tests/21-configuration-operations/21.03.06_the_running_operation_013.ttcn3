// @requirement: 21.3.6 -- The first component to be found executing causes the running operation to succeed.
// @id: TTCN3-CORE-21.3.6-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_06_the_running_operation_013 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }
    function f_short() runs on C {
    }

    testcase TC() runs on C {
        var C v_arr[3] := { C.create, C.create, C.create };
        var integer v_idx := -1;
        var boolean v_res;
        v_arr[0].start(f_short());
        v_arr[0].done;
        v_arr[1].start(f_wait());
        v_res := any from v_arr.running -> @index value v_idx;
        if (v_res and v_idx == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
