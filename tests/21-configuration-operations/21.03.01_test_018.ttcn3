// @requirement: 21.3.1 -- The test system shall associate the names 'MTC' to the MTC and 'SYSTEM' to the test system interface automatically at creation.
// @id: TTCN3-CORE-21.3.1-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_01_test_018 {

    type component C {}

    testcase TC() runs on C {
        log("MTC reference: ", mtc); // the log shall show the name MTC
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
