// @requirement: 21.3.8 -- b) The ObjectReference followed by the killed keyword, i.e. used for identifying a specific PTC, shall be of a component type and shall not resolve to a template.
// @id: TTCN3-CORE-21.3.8-024b
// @verdict: pass reject
module M_21_03_08_the_killed_operation_026 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var template C vt_ptc := v_ptc;
        v_ptc.kill;
        vt_ptc.killed; // error: ObjectReference resolves to a template
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
