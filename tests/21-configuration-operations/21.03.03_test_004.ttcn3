// @requirement: 21.3.3 -- A component can stop its own behaviour by using a simple `stop` execution statement (see clause 19.9) or by addressing itself in the `stop` operation, e.g. by using the `self` operation.
// @id: TTCN3-CORE-21.3.3-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_03_test_004 {

    type component C {}

    function f_stop() runs on C {
        setverdict(pass);
        stop;
        setverdict(fail);
    }

    function f_selfStop() runs on C {
        setverdict(pass);
        self.stop;
        setverdict(fail);
    }

    testcase TC() runs on C {
        timer T := 2.0;
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        v_ptc1.start(f_stop());
        v_ptc2.start(f_selfStop());
        T.start;
        alt {
            [] all component.done { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
