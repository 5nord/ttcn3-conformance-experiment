// @requirement: 21.3.10 -- If the started behaviour does not terminate in the given timeout duration and a catch timout clause is added to the call operation, the called component is implicitly stopped and the StatementBlock of the catch timeout clause is executed before the call operation terminates.
// @id: TTCN3-CORE-21.3.10-010b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_the_call_test_component_behaviour_operation_009 {

    type component C {}

    function f_long() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_step := 0;
        v_ptc.call(f_long(), 0.5) catch (timeout) {
            if (v_step == 0) {
                v_step := 1;
            }
        }
        if (v_step == 1) {
            v_step := 2;
        }
        if (v_step == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
