// @requirement: 21.1.1 -- All checks, which could not be made at compile-time, shall be made at runtime and shall lead to a test case error when failing.
// @id: TTCN3-CORE-21.1.1-034a
// @verdict: pass accept, ttcn3verdict:error
module M_21_01_01_test_031 {

    type port P message { inout integer; }

    type component C { port P p; }

    function f_connect(C p_comp) runs on C {
        connect(self:p, p_comp:p);
    }

    testcase TC() runs on C system C {
        f_connect(system); // runtime check: connect to a system port reference
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
