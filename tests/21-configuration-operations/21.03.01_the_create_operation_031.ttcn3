// @requirement: 21.3.1 -- b) The host id given by the second Expression shall be a charstring value and, when assigned, it shall appear as the second argument of the create function.
// @id: TTCN3-CORE-21.3.1-025a
// @verdict: pass reject
module M_21_03_01_the_create_operation_031 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create("MyPTC", 4); // error: host id is not a charstring
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
