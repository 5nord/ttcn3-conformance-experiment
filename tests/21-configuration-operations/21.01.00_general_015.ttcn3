// @requirement: 21.1.0 -- Operation: Kill; Explanation: Causes a test component to cease to exist; Syntax Examples: c.kill;
// @id: TTCN3-CORE-21.1.0-010b
// @verdict: pass accept, noexecution
module M_21_01_00_general_015 {

    type component C {}

    testcase TC() runs on C {
        var C c := C.create alive;
        c.kill;
    }
}
