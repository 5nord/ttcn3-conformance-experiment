// @requirement: 21.3.8 -- c) The ComponentArrayRef shall be a reference to a completely initialized component array.
// @id: TTCN3-CORE-21.3.8-025a
// @verdict: pass reject
module M_21_03_08_the_killed_operation_027 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptcs[2];
        v_ptcs[0] := C.create;
        v_ptcs[0].kill;
        any from v_ptcs.killed; // error: v_ptcs[1] is not initialized
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
