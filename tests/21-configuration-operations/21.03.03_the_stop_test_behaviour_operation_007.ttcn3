// @requirement: 21.3.3 -- A test component behaviour terminates also by completing its execution upon reaching the end of the test behaviour that is started on this component or by an explicit `return` statement.
// @id: TTCN3-CORE-21.3.3-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_03_the_stop_test_behaviour_operation_007 {

    type component C {}

    function f_end() runs on C {
        setverdict(pass);
    }

    function f_return() runs on C {
        setverdict(pass);
        return;
        setverdict(fail);
    }

    testcase TC() runs on C {
        timer T := 2.0;
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        v_ptc1.start(f_end());
        v_ptc2.start(f_return());
        T.start;
        alt {
            [] all component.done { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
