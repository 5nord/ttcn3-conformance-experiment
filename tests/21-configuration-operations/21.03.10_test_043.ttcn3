// @requirement: 21.3.10 -- a) The ObjectReference shall be of a component type.
// @id: TTCN3-CORE-21.3.10-028a
// @verdict: pass reject
module M_21_03_10_test_043 {

    type component C {}

    function f() runs on C {}

    testcase TC() runs on C {
        var integer v_ref := 0;
        v_ref.call(f()); // error: ObjectReference is not of a component type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
