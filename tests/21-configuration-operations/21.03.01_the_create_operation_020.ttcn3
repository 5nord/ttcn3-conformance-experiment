// @requirement: 21.3.1 -- Associated component names are not required to be unique.
// @id: TTCN3-CORE-21.3.1-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_01_the_create_operation_020 {

    type component C {}

    function f_ptc() runs on C {
        setverdict(pass);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create("SameName");
        var C v_ptc2 := C.create("SameName");
        if (v_ptc1 == v_ptc2) {
            setverdict(fail);
        }
        v_ptc1.start(f_ptc());
        v_ptc2.start(f_ptc());
        all component.done;
    }

    control {
        execute(TC());
    }
}
