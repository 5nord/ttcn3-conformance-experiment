// @requirement: 21.3.10 -- Operation: running; Allowed: Yes but from MTC only; Col3: Yes but from MTC only; Example: any component.running; all component.running;; Comment: Is there any PTC performing test behaviour? Are all PTCs performing test behaviour?
// @id: TTCN3-CORE-21.3.10-015b
// @verdict: pass reject
module M_21_03_10_test_014 {

    type component C {}

    function f() runs on C {
        if (any component.running) { // error: any component.running used in a PTC
            setverdict(pass);
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f());
        v_ptc.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
