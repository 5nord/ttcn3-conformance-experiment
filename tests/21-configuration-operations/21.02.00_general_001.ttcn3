// @requirement: 21.2.0 -- It specifies an immediate stop of the test case behaviour with an error verdict.
// @id: TTCN3-CORE-21.2.0-003a
// @verdict: pass accept, ttcn3verdict:error
module M_21_02_00_general_001 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
        testcase.stop;
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
