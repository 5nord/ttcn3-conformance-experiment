// @requirement: 21.3.10 -- In all other cases when the execution is incomplete, the call operation ends with a test case error.
// @id: TTCN3-CORE-21.3.10-011a
// @verdict: pass accept, ttcn3verdict:error
module M_21_03_10_the_call_test_component_behaviour_operation_010 {

    type component C {}

    function f_stop() runs on C {
        self.stop;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        setverdict(pass);
        v_ptc.call(f_stop()); // incomplete execution without catch (stop) clause
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
