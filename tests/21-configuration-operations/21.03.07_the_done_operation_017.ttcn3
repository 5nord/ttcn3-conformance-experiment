// @requirement: 21.3.7 -- It also matches if no PTC has been created.
// @id: TTCN3-CORE-21.3.7-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_07_the_done_operation_017 {

    type component C {}

    testcase TC() runs on C {
        alt {
            [] all component.done {
                setverdict(pass);
            }
            [else] {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
