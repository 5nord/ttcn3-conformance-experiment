// @requirement: 21.3.5 -- Applied on an alive-type parallel component, the operation returns true if the component is inactive, running or stopped.
// @id: TTCN3-CORE-21.3.5-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_05_the_alive_operation_005 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }
    function f_short() runs on C {
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create alive;
        var C v_ptc2 := C.create alive;
        var boolean v_inactive := v_ptc1.alive;
        v_ptc1.start(f_wait());
        var boolean v_running := v_ptc1.alive;
        v_ptc2.start(f_short());
        v_ptc2.done;
        var boolean v_stopped := v_ptc2.alive;
        if (v_inactive and v_running and v_stopped) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
