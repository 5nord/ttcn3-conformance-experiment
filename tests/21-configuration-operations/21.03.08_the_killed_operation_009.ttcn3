// @requirement: 21.3.8 -- If the @nodefault modifier is placed before a stand-alone killed operation, the implicit alt statement also contains the @nodefault modifier.
// @id: TTCN3-CORE-21.3.8-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_08_the_killed_operation_009 {

    type component C {
        timer T;
    }

    function f_ptc() runs on C {
        T.start(0.5);
        T.timeout;
        self.kill;
    }

    altstep a_default() runs on C {
        [] T.timeout {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        v_ptc.start(f_ptc());
        T.start(0.1);
        activate(a_default());
        @nodefault v_ptc.killed;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
