// @requirement: 21.0 -- Killed Checks whether a component has `c.killed { … }` ceased to exist
// @id: TTCN3-CORE-21.0-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_test_032 {

    type component C {}

    function f_behaviour() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C c := C.create alive;
        c.start(f_behaviour());
        c.kill;
        T.start;
        alt {
            [] c.killed { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
