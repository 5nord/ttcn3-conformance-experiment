// @requirement: 21.3.1 -- All component variables and timers are reset to their initial value (if any) and all component constants are reset to their assigned values when the component is explicitly or implicitly created.
// @id: TTCN3-CORE-21.3.1-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_01_the_create_operation_007 {

    type component C {
        var integer v_x := 1;
        timer T_t := 5.0;
    }

    function f_check() runs on C {
        if (v_x == 1 and not T_t.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        v_x := 2;
        T_t.start;
    }

    testcase TC() runs on C {
        var C v_ptc1, v_ptc2;
        f_check();
        v_ptc1 := C.create;
        v_ptc1.start(f_check());
        v_ptc1.done;
        v_ptc2 := C.create;
        v_ptc2.start(f_check());
        v_ptc2.done;
    }

    control {
        execute(TC());
        execute(TC());
    }
}
