// @requirement: 21.1.0 -- The ports of a test component can be connected to ports of other components or to the ports of the test system interface (see figure 10).
// @id: TTCN3-CORE-21.1.0-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_01_00_test_001 {

    type port P message { inout integer; }

    type component C {
        port P p_c;
        port P p_s;
    }

    type component S {
        port P p_s;
    }

    function f_check() runs on C {
        if (p_c.checkstate("Connected") and p_s.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C system S {
        var C v_ptc := C.create;
        connect(v_ptc:p_c, mtc:p_c);
        map(v_ptc:p_s, system:p_s);
        v_ptc.start(f_check());
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
