// @requirement: 21.3.10 -- Operation: running; Allowed: Yes but from MTC only; Col3: Yes but from MTC only; Example: any component.running; all component.running;; Comment: Is there any PTC performing test behaviour? Are all PTCs performing test behaviour?
// @id: TTCN3-CORE-21.3.10-015d
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_test_016 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create alive;
        var C v_ptc2 := C.create alive;
        v_ptc1.start(f_wait());
        if (all component.running) {
            setverdict(fail);
            stop;
        }
        v_ptc2.start(f_wait());
        if (all component.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
