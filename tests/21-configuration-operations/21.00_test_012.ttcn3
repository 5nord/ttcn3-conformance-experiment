// @requirement: 21.0 -- Operation: Unmap; Explanation: Unmaps two or more mapped ports; Syntax Examples: unmap(ptc1:q, system:sutPort1);
// @id: TTCN3-CORE-21.0-015b
// @verdict: pass accept, noexecution
module M_21_00_test_012 {

    type port P message { inout integer; }

    type component C {
        port P q;
    }

    type component S {
        port P sutPort1;
    }

    testcase TC() runs on C system S {
        var C ptc1 := C.create;
        map(ptc1:q, system:sutPort1);
        unmap(ptc1:q, system:sutPort1);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
