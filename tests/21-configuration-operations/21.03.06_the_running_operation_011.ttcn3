// @requirement: 21.3.6 -- Otherwise it returns false.
// @id: TTCN3-CORE-21.3.6-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_06_the_running_operation_011 {

    type component C {}

    function f_short() runs on C {
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        v_ptc2.start(f_short());
        v_ptc2.done;
        if (not any component.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
