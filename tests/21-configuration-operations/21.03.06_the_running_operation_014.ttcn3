// @requirement: 21.3.6 -- The index of the matched component can optionally be assigned to an integer variable for single-dimensional arrays or to an integer array or record of integer variable for multi-dimensional component arrays.
// @id: TTCN3-CORE-21.3.6-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_06_the_running_operation_014 {

    type component C {}

    function f_wait() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_arr1[2] := { C.create, C.create };
        var C v_arr2[2][2] := { { C.create, C.create }, { C.create, C.create } };
        var integer v_idx1 := -1;
        var integer v_idx2[2] := { -1, -1 };
        v_arr1[1].start(f_wait());
        v_arr2[1][0].start(f_wait());
        if (any from v_arr1.running -> @index value v_idx1 and
            any from v_arr2.running -> @index value v_idx2 and
            v_idx1 == 1 and v_idx2 == { 1, 0 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
