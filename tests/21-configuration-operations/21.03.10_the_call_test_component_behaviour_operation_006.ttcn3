// @requirement: 21.3.10 -- Complete execution occurs when the started function is terminated by executing a return statement or if it reaches the end of the function body.
// @id: TTCN3-CORE-21.3.10-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_10_the_call_test_component_behaviour_operation_006 {

    type component C {}

    function f_return(boolean p_early) runs on C return integer {
        if (p_early) {
            return 1;
        }
        return 2;
    }

    function f_end(out integer p_out) runs on C {
        p_out := 3;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        var integer v_res := 0, v_out := 0;
        v_ptc.call(f_return(true)) -> value v_res
            catch (stop) {
                setverdict(fail);
            }
        v_ptc.call(f_end(v_out))
            catch (stop) {
                setverdict(fail);
            }
        if (v_res == 1 and v_out == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
