// @requirement: 21.0 -- Operation: Disconnect; Explanation: Disconnects two or more connected ports; Syntax Examples: disconnect(ptc1:p1, ptc2:p2);
// @id: TTCN3-CORE-21.0-013b
// @verdict: pass accept, ttcn3verdict:pass
module M_21_00_test_008 {

    type port P message { inout integer; }

    type component C {
        port P p1;
        port P p2;
    }

    testcase TC() runs on C {
        var C ptc1 := C.create;
        var C ptc2 := C.create;
        connect(ptc1:p1, ptc2:p2);
        disconnect(ptc1:p1, ptc2:p2);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
