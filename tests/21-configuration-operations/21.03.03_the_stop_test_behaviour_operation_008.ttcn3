// @requirement: 21.3.3 -- The implicit stop has the same effects as an explicit stop, i.e. the global verdict is updated with the local verdict of the stopped test component (see clause 24).
// @id: TTCN3-CORE-21.3.3-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_21_03_03_the_stop_test_behaviour_operation_008 {

    type component C {}

    function f_implicit() runs on C {
        setverdict(pass);
    }

    function f_explicit() runs on C {
        setverdict(pass);
        stop;
    }

    testcase TC() runs on C {
        timer T := 2.0;
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        v_ptc1.start(f_implicit());
        v_ptc2.start(f_explicit());
        T.start;
        alt {
            [] all component.killed { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
        if (v_ptc1.alive or v_ptc2.alive or v_ptc1.running or v_ptc2.running) {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
