// @requirement: 26.2 -- Timer operations may also be used explicitly to control test case execution.
// @id: TTCN3-CORE-26.2-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_02_test_009 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        timer T_pause := 0.1;
        execute(TC());
        T_pause.start;
        T_pause.timeout;
        execute(TC());
    }
}
