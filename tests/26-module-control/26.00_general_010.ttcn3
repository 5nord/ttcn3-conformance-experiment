// @requirement: 26.0 -- Statement: Stop execution; Associated keyword or symbol: stop
// @id: TTCN3-CORE-26.0-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_00_general_010 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    testcase TC_notExecuted() runs on C {
        setverdict(fail);
    }

    control {
        execute(TC());
        stop;
        execute(TC_notExecuted());
    }
}
