// @requirement: 26.1 -- a) The TimerValue shall resolve to a non-negative numerical float value (i.e. the value shall be greater or equal 0.0, infinity and not_a_number are disallowed).
// @id: TTCN3-CORE-26.1-051b
// @verdict: pass reject
module M_26_01_the_execute_statement_046 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC(), infinity); // error: infinity is not an allowed timer value
    }
}
