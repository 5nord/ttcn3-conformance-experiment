// @requirement: 26.0 -- Statement: Do while loop; Associated keyword or symbol: do {…} while (…)
// @id: TTCN3-CORE-26.0-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_00_test_007 {

    type component C {}

    testcase TC(integer p_count) runs on C {
        if (p_count == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_count := 0;
        do {
            v_count := v_count + 1;
        } while (v_count < 3);
        execute(TC(v_count));
    }
}
