// @requirement: 26.2 -- If the runs `on clause is missing, an empty control component is created.`
// @id: TTCN3-CORE-26.2-009a
// @verdict: pass reject
module M_26_02_test_suite_execution_006 {

    type component C {}

    type component CtrlC {
        var integer vc_value := 7;
    }

    testcase TC() runs on C {
        setverdict(pass);
    }

    function f_increment() runs on CtrlC {
        vc_value := vc_value + 1;
    }

    function control() {
        f_increment(); // error: the empty control component is not compatible with CtrlC
        execute(TC());
    }
}
