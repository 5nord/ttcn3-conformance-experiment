// @requirement: 26.1 -- Statement: Check if timer running; Associated keyword or symbol: running
// @id: TTCN3-CORE-26.1-032a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_test_032 {

    type component C {}

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var boolean v_before;
        var boolean v_after;
        timer T := 5.0;
        v_before := T.running;
        T.start;
        v_after := T.running;
        execute(TC(not v_before and v_after));
    }
}
