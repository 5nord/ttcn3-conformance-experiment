// @requirement: 26.1 -- Statement: Interleaved behaviour (see note); Associated keyword or symbol: interleave {…}
// @id: TTCN3-CORE-26.1-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_the_execute_statement_026 {

    type component C {}

    testcase TC(integer p_count) runs on C {
        if (p_count == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_count := 0;
        timer T1 := 0.2;
        timer T2 := 0.1;
        T1.start;
        T2.start;
        interleave {
            [] T1.timeout {
                v_count := v_count + 1;
            }
            [] T2.timeout {
                v_count := v_count + 1;
            }
        }
        execute(TC(v_count));
    }
}
