// @requirement: 26.1 -- The result of an executed test case is always a value of type verdicttype.
// @id: TTCN3-CORE-26.1-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_the_execute_statement_004 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    testcase TC_check(verdicttype p_result) runs on C {
        if (p_result == pass) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var verdicttype v_result := execute(TC());
        execute(TC_check(v_result));
    }
}
