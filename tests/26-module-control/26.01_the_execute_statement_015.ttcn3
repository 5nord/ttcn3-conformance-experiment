// @id: TTCN3-CORE-26.1-013a
// @verdict: pass accept, noexecution
module M_26_01_the_execute_statement_015 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        var verdicttype v_myVerdict;
        v_myVerdict := execute(TC(), -, "Host1");
        v_myVerdict := execute(TC(), 5.0, "Host1");
    }
