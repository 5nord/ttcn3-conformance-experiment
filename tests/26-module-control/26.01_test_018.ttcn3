// @requirement: 26.1 -- At the start of each test case, the test configuration shall be reset.
// @id: TTCN3-CORE-26.1-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_test_018 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    function f_wait() runs on C {
        timer T := 3.0;
        T.start;
        T.timeout;
    }

    testcase TC_setup() runs on C {
        var C v_ptc := C.create alive;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_wait());
        setverdict(pass);
    }

    testcase TC() runs on C {
        if (not any component.alive and not p.checkstate("Connected")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC_setup());
        execute(TC());
    }
}
