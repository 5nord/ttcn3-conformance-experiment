// @requirement: 26.1 -- Statement: Alternative behaviour (see note); Associated keyword or symbol: alt {…}
// @id: TTCN3-CORE-26.1-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_test_024 {

    type component C {}

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var boolean v_ok := false;
        timer T1 := 0.1;
        timer T2 := 1.0;
        T1.start;
        T2.start;
        alt {
            [] T1.timeout {
                v_ok := true;
            }
            [] T2.timeout {
                v_ok := false;
            }
        }
        execute(TC(v_ok));
    }
}
