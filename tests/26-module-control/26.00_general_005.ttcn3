// @requirement: 26.0 -- Statement: For loop; Associated keyword or symbol: for (…) {…}
// @id: TTCN3-CORE-26.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_00_general_005 {

    type component C {}

    testcase TC(integer p_count) runs on C {
        if (p_count == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_count := 0;
        for (var integer i := 0; i < 3; i := i + 1) {
            v_count := v_count + 1;
        }
        execute(TC(v_count));
    }
}
