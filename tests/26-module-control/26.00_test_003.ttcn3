// @requirement: 26.0 -- Statement: If-else; Associated keyword or symbol: if (…) {…} else {…}
// @id: TTCN3-CORE-26.0-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_00_test_003 {

    type component C {}

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_value := 1;
        if (v_value > 2) {
            execute(TC(false));
        } else {
            execute(TC(true));
        }
    }
}
