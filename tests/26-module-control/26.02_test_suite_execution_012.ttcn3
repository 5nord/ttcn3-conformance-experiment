// @requirement: 26.2 -- Another way to execute test cases as a group is to collect them in a control function and invoke that function from the module control function.
// @id: TTCN3-CORE-26.2-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_02_test_suite_execution_012 {

    type component C {}

    testcase TC_1() runs on C {
        setverdict(pass);
    }

    testcase TC_2() runs on C {
        setverdict(pass);
    }

    function f_group() {
        execute(TC_1());
        execute(TC_2());
    }

    control {
        f_group();
    }
}
