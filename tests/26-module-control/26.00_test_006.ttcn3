// @requirement: 26.0 -- Statement: While loop; Associated keyword or symbol: while (…) {…}
// @id: TTCN3-CORE-26.0-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_00_test_006 {

    type component C {}

    testcase TC(integer p_count) runs on C {
        if (p_count == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_count := 0;
        while (v_count < 3) {
            v_count := v_count + 1;
        }
        execute(TC(v_count));
    }
}
