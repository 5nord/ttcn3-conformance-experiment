// @requirement: 26.1 -- If a host id is provided, the execute statement shall end with a test case error if the MTC cannot be deployed on the specified host.
// @id: TTCN3-CORE-26.1-049a
// @verdict: pass accept, ttcn3verdict:error
module M_26_01_the_execute_statement_044 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC(), -, "nonexistent.host.invalid"); // MTC cannot be deployed: error verdict
    }
}
