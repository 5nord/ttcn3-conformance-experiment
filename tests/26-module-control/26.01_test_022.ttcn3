// @requirement: 26.1 -- Statement: Next iteration of a loop; Associated keyword or symbol: continue
// @id: TTCN3-CORE-26.1-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_test_022 {

    type component C {}

    testcase TC(integer p_count) runs on C {
        if (p_count == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_count := 0;
        for (var integer i := 0; i < 4; i := i + 1) {
            if (i mod 2 == 0) {
                continue;
            }
            v_count := v_count + 1;
        }
        execute(TC(v_count));
    }
}
