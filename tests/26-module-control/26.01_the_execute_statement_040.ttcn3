// @requirement: 26.1 -- If the test case does not end within this duration, the result of the test case execution shall be an error verdict and the test system shall terminate the test case.
// @id: TTCN3-CORE-26.1-045a
// @verdict: pass accept, ttcn3verdict:error
module M_26_01_the_execute_statement_040 {

    type component C {}

    testcase TC() runs on C {
        timer T := 5.0;
        setverdict(pass);
        T.start;
        T.timeout;
    }

    testcase TC_check(verdicttype p_result) runs on C {
        if (p_result == error) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var verdicttype v_myVerdict;
        v_myVerdict := execute(TC(), 0.5);
        execute(TC_check(v_myVerdict));
    }
}
