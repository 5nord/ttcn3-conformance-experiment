// @requirement: 26.1 -- When a test case is invoked the MTC is created, the ports of the MTC and the test system interface are instantiated and the behaviour specified in the test case definition is started on the MTC.
// @id: TTCN3-CORE-26.1-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_the_execute_statement_008 {

    type component C {
        var integer v_init := 7;
    }

    testcase TC() runs on C {
        if (mtc != null and v_init == 7) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
