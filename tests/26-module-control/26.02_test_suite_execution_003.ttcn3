// @requirement: 26.2 -- If the function contains formal parameters, their actual values shall be provided.
// @id: TTCN3-CORE-26.2-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_02_test_suite_execution_003 {

    type component C {}

    testcase TC(integer p_value) runs on C {
        if (p_value == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    function control(integer p_value := 5) {
        execute(TC(p_value));
    }
}
