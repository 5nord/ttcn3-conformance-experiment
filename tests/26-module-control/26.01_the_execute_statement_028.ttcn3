// @requirement: 26.1 -- Statement: Deactivate a default (see note); Associated keyword or symbol: deactivate
// @id: TTCN3-CORE-26.1-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_the_execute_statement_028 {

    type component C {}

    altstep a_anyTimeout() {
        [] any timer.timeout {
        }
    }

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var boolean v_ok := false;
        var default v_default;
        timer T1 := 0.1;
        timer T2 := 0.5;
        v_default := activate(a_anyTimeout());
        deactivate(v_default);
        T1.start;
        T2.start;
        alt {
            [] T2.timeout {
                v_ok := true;
            }
        }
        execute(TC(v_ok));
    }
}
