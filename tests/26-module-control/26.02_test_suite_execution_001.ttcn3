// @requirement: 26.2 -- The module control function defines, in which order, sequence, loop, under which preconditions, and with which parameters test cases are to be executed.
// @id: TTCN3-CORE-26.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_02_test_suite_execution_001 {

    type component C {}

    testcase TC(integer p_index) runs on C {
        if (p_index == 0 or p_index == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        for (var integer v_i := 0; v_i < 3; v_i := v_i + 1) {
            if (v_i != 1) {
                execute(TC(v_i));
            }
        }
    }
}
