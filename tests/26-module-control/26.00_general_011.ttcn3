// @requirement: 26.0 -- Statement: Leaving a loop, alt or interleave; Associated keyword or symbol: break
// @id: TTCN3-CORE-26.0-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_00_general_011 {

    type component C {}

    testcase TC(integer p_count) runs on C {
        if (p_count == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_count := 0;
        while (true) {
            v_count := v_count + 1;
            if (v_count == 3) {
                break;
            }
        }
        execute(TC(v_count));
    }
}
