// @requirement: 26.1 -- Statement: Start timer; Associated keyword or symbol: start
// @id: TTCN3-CORE-26.1-029a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_the_execute_statement_029 {

    type component C {}

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        timer T := 5.0;
        T.start;
        execute(TC(T.running));
    }
}
