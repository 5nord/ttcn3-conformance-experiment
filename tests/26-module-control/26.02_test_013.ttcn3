// @requirement: 26.2 -- As a test case returns a single value of type verdicttype, it is also possible to control the order of test case execution depending on the outcome of a test case.
// @id: TTCN3-CORE-26.2-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_02_test_013 {

    type component C {}

    testcase TC_First() runs on C {
        setverdict(pass);
    }

    testcase TC_GoOn() runs on C {
        setverdict(pass);
    }

    testcase TC_Recovery() runs on C {
        setverdict(fail);
    }

    control {
        if (execute(TC_First()) == pass) {
            execute(TC_GoOn());
        } else {
            execute(TC_Recovery());
        }
    }
}
