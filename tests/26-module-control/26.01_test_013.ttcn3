// @requirement: 26.1 -- As the result of the execution of a test case, a test case verdict of either none, pass, inconc, fail or error shall be returned and may be assigned to a variable for further processing.
// @id: TTCN3-CORE-26.1-011b
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_test_013 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    testcase TC_check(verdicttype p_result) runs on C {
        if (p_result == pass) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var verdicttype v_myVerdict;
        v_myVerdict := execute(TC());
        execute(TC_check(v_myVerdict));
    }
}
