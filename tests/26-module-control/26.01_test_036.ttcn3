// @requirement: 26.1 -- The final verdict of a test case is calculated based on the final local verdicts of the different test components according to the rules defined in clause 24.1.
// @id: TTCN3-CORE-26.1-039a
// @verdict: pass accept, ttcn3verdict:inconc
module M_26_01_test_036 {

    type component C {}

    function f_inconc() runs on C {
        setverdict(inconc);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_inconc());
        v_ptc.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
