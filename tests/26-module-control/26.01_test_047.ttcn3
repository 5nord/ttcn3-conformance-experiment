// @requirement: 26.1 -- b) When the corresponding formal parameter is not of template type TemplateInstance shall resolve to an _Expression._ c) The execute statement shall not be called from within an existing executing test behaviour chain called from a test case, i.e. test cases can only be executed from a control behaviour.
// @id: TTCN3-CORE-26.1-052a
// @verdict: pass reject
module M_26_01_test_047 {

    type component C {}

    testcase TC(integer p_value) runs on C {
        setverdict(pass);
    }

    control {
        execute(TC(?)); // error: matching symbol for a value parameter
    }
}
