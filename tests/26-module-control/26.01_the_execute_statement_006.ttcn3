// @requirement: 26.1 -- Every test case shall contain one and only one MTC the type of which is referenced in the header of the test case definition.
// @id: TTCN3-CORE-26.1-005b
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_the_execute_statement_006 {

    type component C {
        var integer v_marker := 42;
    }

    testcase TC() runs on C {
        var C v_mtc := mtc;
        if (v_mtc == self and v_marker == 42) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
