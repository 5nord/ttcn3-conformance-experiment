// @requirement: 26.0 -- Statement: Assignments; Associated keyword or symbol: :=
// @id: TTCN3-CORE-26.0-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_00_test_002 {

    type component C {}

    testcase TC(integer p_value) runs on C {
        if (p_value == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_value;
        v_value := 5;
        execute(TC(v_value));
    }
}
