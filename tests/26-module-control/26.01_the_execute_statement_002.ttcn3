// @requirement: 26.1 -- execute "(" TestcaseRef "(" [ { ActualPar [","] } ] ")" [ "," TimerValue [ "," HostId ] ] ")"
// @id: TTCN3-CORE-26.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_the_execute_statement_002 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    testcase TC_par(integer p_a, charstring p_b) runs on C {
        if (p_a == 1 and p_b == "x") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
        execute(TC_par(1, "x"));
        execute(TC_par(1, "x"), 5.0);
    }
}
