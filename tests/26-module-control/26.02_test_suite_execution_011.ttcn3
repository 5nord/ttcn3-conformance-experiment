// @requirement: 26.2 -- This includes, of course, the use of functions that return a boolean value.
// @id: TTCN3-CORE-26.2-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_02_test_suite_execution_011 {

    type component C {}

    function f_select(integer p_level) return boolean {
        return p_level > 1;
    }

    testcase TC_Selected() runs on C {
        setverdict(pass);
    }

    testcase TC_Deselected() runs on C {
        setverdict(fail);
    }

    control {
        if (f_select(2)) {
            execute(TC_Selected());
        }
        if (f_select(0)) {
            execute(TC_Deselected());
        }
    }
}
