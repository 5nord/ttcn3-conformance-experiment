// @requirement: 26.1 -- Statement: Stimulate an (SUT) action externally; Associated keyword or symbol: action
// @id: TTCN3-CORE-26.1-034a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_the_execute_statement_034 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        var integer v_myInt := 1;
        action("Send ", v_myInt, " on lower PCO");
        execute(TC());
    }
}
