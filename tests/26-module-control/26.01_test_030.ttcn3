// @requirement: 26.1 -- Statement: Stop timer; Associated keyword or symbol: stop
// @id: TTCN3-CORE-26.1-030a
// @verdict: pass accept, ttcn3verdict:pass
module M_26_01_test_030 {

    type component C {}

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        timer T := 5.0;
        T.start;
        T.stop;
        execute(TC(not T.running));
    }
}
