// @requirement: 6.2.15.3 -- **unmap "(" ValueRef "," [ SingleExpression | "*"] ")"**
// @id: TTCN3-CORE-6.2.15.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_03_test_001 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var MyMap v_map := { ["a"] := 1, ["b"] := 2 };
        var template MyMap v_tmpl := { *, ["a"] := 1 };
        unmap(v_map, "a");
        unmap(v_tmpl, *);
        if (not isbound(v_map["a"]) and not v_tmpl[*]) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
