// @requirement: 6.5 -- The expression or template body shall be one of the following:
// @id: TTCN3-CORE-6.5-005a
// @verdict: pass reject
module M_06_05_automatic_type_005 {
    type enumerated Colour { yellow, red, blue, green }
    type component C {}

    testcase TC() runs on C {
        var v_auto := red; // error: unqualified enumerated value is not an allowed form
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
