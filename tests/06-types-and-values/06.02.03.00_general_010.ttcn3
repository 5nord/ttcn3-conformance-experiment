// @requirement: 6.2.3.0 -- When re-assigning a previously initialized value, using the not used symbol or just skipping a field or element in an assignment notation, will cause that field or element to remain unchanged.
// @id: TTCN3-CORE-6.2.3.0-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_general_010 {

    type record of integer MyRecordOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro := { 1, 2, 3 };
        v_ro := { [0] := 10, [1] := - };
        if (v_ro == { 10, 2, 3 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
