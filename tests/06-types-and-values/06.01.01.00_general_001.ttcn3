// @requirement: 6.1.1.0 -- TTCN-3 supports the following basic string types:
// @id: TTCN3-CORE-6.1.1.0-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_general_001 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '1'B;
        var hexstring v_h := 'A'H;
        var octetstring v_o := 'AB'O;
        var charstring v_c := "a";
        var universal charstring v_u := "a";
        if (lengthof(v_b) == 1 and lengthof(v_h) == 1 and lengthof(v_o) == 1 and
            lengthof(v_c) == 1 and lengthof(v_u) == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
