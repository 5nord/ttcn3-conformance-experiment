// @requirement: 6.1.1.1 -- Indexing shall begin with the value zero (0).
// @id: TTCN3-CORE-6.1.1.1-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_01_test_004 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_bs := '10'B;
        var charstring v_cs := "xyz";
        if (v_bs[0] == '1'B and v_cs[0] == "x") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
