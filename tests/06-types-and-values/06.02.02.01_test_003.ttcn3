// @requirement: 6.2.2.1 -- For referencing field types of set types, the same rules apply as in clause 6.2.1.1 for fields of **record types.**
// @id: TTCN3-CORE-6.2.2.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_02_01_test_003 {

    type set MySet {
        integer field1 (1 .. 10),
        charstring field2 optional
    }

    type MySet MySubSet ({ field1 := 1, field2 := omit }, { field1 := 2, field2 := "foo" });

    type MySubSet.field1 MyFieldType;

    type component C {}

    testcase TC() runs on C {
        var MyFieldType v_val := 5;
        if (v_val == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
