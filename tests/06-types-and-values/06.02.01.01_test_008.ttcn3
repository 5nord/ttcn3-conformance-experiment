// @requirement: 6.2.1.1 -- When referencing a field of an uninitialized record value or field or omitted field (including omitting a field at a higher level of the embedding hierarchy) on the left hand side of an assignment, the reference shall recursively be expanded up to and including the depth of the referenced subfield as follows:
// @id: TTCN3-CORE-6.2.1.1-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_01_test_008 {

    type component C {}

    type record Inner2 {
        integer a,
        integer b
    }

    type record Inner1 {
        Inner2 sub,
        integer c
    }

    type record MyType4 {
        integer field1 optional,
        Inner1 field2 optional
    }

    testcase TC() runs on C {
        var MyType4 v_rec1;
        var MyType4 v_rec2 := { field1 := 1, field2 := omit };
        v_rec1.field2.sub.a := 5;
        v_rec2.field2.sub.a := 6;
        if (ispresent(v_rec1.field2) and v_rec1.field2.sub.a == 5 and
            ispresent(v_rec2.field2) and v_rec2.field2.sub.a == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
