// @requirement: 6.2.1.0 -- When the assignment notation is used for record-s, fields wished to be changed shall be identified explicitly and a value, the not used symbol "-" or the omit keyword can be associated with them.
// @id: TTCN3-CORE-6.2.1.0-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_test_008 {

    type record MyRecordType {
        integer field1,
        integer field2,
        integer field3
    }

    type component C {}

    testcase TC() runs on C {
        var MyRecordType v_r := { field1 := 1, field2 := 2, field3 := 3 };
        v_r := { field1 := 10, field3 := 30 };
        if (v_r == { 10, 2, 30 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
