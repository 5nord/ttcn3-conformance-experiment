// @requirement: 6.2.7 -- Arrays may be declared as single or multi-dimensional.
// @id: TTCN3-CORE-6.2.7-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_07_arrays_003 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a1[3] := { 1, 2, 3 };
        var integer v_a2[2][3] := { { 1, 2, 3 }, { 4, 5, 6 } };
        var integer v_a3[2][2][2] := { { { 1, 2 }, { 3, 4 } }, { { 5, 6 }, { 7, 8 } } };
        if (v_a1[2] == 3 and v_a2[1][2] == 6 and v_a3[1][1][1] == 8) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
