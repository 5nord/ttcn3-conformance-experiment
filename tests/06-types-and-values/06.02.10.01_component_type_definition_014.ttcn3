// @requirement: 6.2.10.1 -- Every instance of a component type has its own new instances of the ports, constants, variables, templates and timers defined in the component type definition.
// @id: TTCN3-CORE-6.2.10.1-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_10_01_component_type_definition_014 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
        var integer vc_i := 0;
    }

    type component CMain {
        port P p1;
        port P p2;
    }

    function f_ptc() runs on C {
        var integer v_i;
        p.receive(integer:?) -> value v_i;
        vc_i := vc_i + v_i;
        p.send(vc_i);
    }

    testcase TC() runs on CMain {
        timer T := 1.0;
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        connect(self:p1, v_ptc1:p);
        connect(self:p2, v_ptc2:p);
        v_ptc1.start(f_ptc());
        v_ptc2.start(f_ptc());
        p1.send(10);
        p2.send(20);
        T.start;
        alt {
            [] p1.receive(10) {
                alt {
                    [] p2.receive(20) { setverdict(pass); }
                    [] p2.receive { setverdict(fail); }
                    [] T.timeout { setverdict(fail); }
                }
            }
            [] p1.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
        all component.done;
    }

    control {
        execute(TC());
    }
}
