// @requirement: 6.3.5 -- If it is necessary to convert values of one type to values of another type, because their types have different root types, then either one of the predefined conversion functions defined in clause 16.1.2 or a user defined function shall be used.
// @id: TTCN3-CORE-6.3.5-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_05_test_001 {
    type component C {}

    function f_bool2int(boolean p_b) return integer {
        if (p_b) {
            return 1;
        }
        return 0;
    }

    testcase TC() runs on C {
        var hexstring v_h := int2hex(123, 4);
        var integer v_i := f_bool2int(true);
        if (v_h == '007B'H and v_i == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
