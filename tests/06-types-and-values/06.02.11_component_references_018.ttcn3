// @requirement: 6.2.11 -- b) The ObjectReference shall be of a component type and shall not resolve to a template.
// @id: TTCN3-CORE-6.2.11-017b
// @verdict: pass reject
module M_06_02_11_component_references_018 {

    type component C {
    }

    function f_empty() runs on C {
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var template C vt_ptc := v_ptc;
        vt_ptc.start(f_empty()); // error: component reference resolves to a template
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
