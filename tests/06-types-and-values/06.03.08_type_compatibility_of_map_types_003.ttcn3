// @requirement: 6.3.8 -- // every value of Map2 can be used in a variable of Map1 but access to values associated with keys that are not charstring values is not possible
// @id: TTCN3-CORE-6.3.8-004a
// @verdict: pass reject
module M_06_03_08_type_compatibility_of_map_types_003 {
    type map from charstring to universal charstring Map1;
    type map from universal charstring to charstring Map2;
    type component C {}

    const universal charstring c_key := char(0, 0, 0, 228);

    testcase TC() runs on C {
        var Map2 v_m2 := { [c_key] := "value" };
        var Map1 v_m1 := v_m2;
        var universal charstring v_x := v_m1[c_key]; // error: key is not a charstring value
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
