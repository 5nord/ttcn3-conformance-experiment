// @requirement: 6.2.15.5 -- The set of keys that the map associates with a value can be accessed using the from selector.
// @id: TTCN3-CORE-6.2.15.5-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_05_accessing_the_keys_of_a_map_001 {

    type map from charstring to integer MapType;

    type component C {}

    testcase TC() runs on C {
        var MapType v_map := { ["a"] := 1, ["b"] := 2 };
        var MapType.from v_keys := v_map.from;
        var integer v_sum := 0;
        for (var integer i := 0; i < lengthof(v_keys); i := i + 1) {
            v_sum := v_sum + v_map[v_keys[i]];
        }
        if (lengthof(v_keys) == 2 and v_sum == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
