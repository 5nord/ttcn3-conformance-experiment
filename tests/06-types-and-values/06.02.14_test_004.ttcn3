// @requirement: 6.2.14 -- The special value null represents an unspecified timer reference, i.e. can be used for variables to explicitly reference no timer.
// @id: TTCN3-CORE-6.2.14-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_14_test_004 {

    type component C {
        timer T := 5.0;
    }

    testcase TC() runs on C {
        var timer v_timer := T;
        T.start;
        v_timer := null;
        if (v_timer == null and T.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        T.stop;
    }

    control {
        execute(TC());
    }
}
