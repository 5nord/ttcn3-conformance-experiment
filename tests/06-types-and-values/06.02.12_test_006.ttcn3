// @requirement: 6.2.12 -- If several address types exist within a test suite, ambiguities shall be resolved by means of the dot notation.
// @id: TTCN3-CORE-6.2.12-008a
// @verdict: pass accept, noexecution
module M_06_02_12_test_006 {

    type integer address;

    type port P1 message {
        inout integer;
    }

    type port P2 message {
        address charstring;
        inout integer;
    }

    type component C {
        port P1 p1;
        port P2 p2;
    }

    testcase TC() runs on C system C {
        var address v_addr1 := null;
        var P2.address v_addr2 := null;
        map(mtc:p1, system:p1);
        map(mtc:p2, system:p2);
        p1.receive(integer:?) from address:? -> sender v_addr1;
        p2.receive(integer:?) from P2.address:? -> sender v_addr2;
        p1.send(integer:1) to v_addr1;
        p2.send(integer:2) to v_addr2;
        setverdict(pass);
    }
}
