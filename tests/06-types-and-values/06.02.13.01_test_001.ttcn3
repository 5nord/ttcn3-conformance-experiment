// @requirement: 6.2.13.1 -- TTCN-3 permits constraining the number of elements in instances of record of and set of types.
// @id: TTCN3-CORE-6.2.13.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_13_01_test_001 {

    type record length(2) of integer RoI2;
    type set length(1..3) of boolean SoB1_3;

    type component C {}

    testcase TC() runs on C {
        var RoI2 v_rec := { 1, 2 };
        var SoB1_3 v_set := { true, false, true };
        if (lengthof(v_rec) == 2 and lengthof(v_set) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
