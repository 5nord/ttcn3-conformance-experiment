// @requirement: 6.2.1.0 -- When using value list notation in a scope where the optional attribute is implicitly or explicitly set to "explicit omit", all remaining fields at the end of the type definition, missing from the value list notation, are left unchanged.
// @id: TTCN3-CORE-6.2.1.0-039a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_test_029 {

    type component C {}

    type record R {
        integer f1,
        integer f2,
        integer f3 optional
    }

    testcase TC() runs on C {
        var R v_r := { 1, 2, 3 };
        v_r := { 10 };
        if (v_r.f1 == 10 and v_r.f2 == 2 and v_r.f3 == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    } with { optional "explicit omit" }

    control {
        execute(TC());
    }
}
