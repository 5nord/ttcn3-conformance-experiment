// @requirement: 6.2.9 -- Directions shall be seen from the point of view of the test component owning the port with the exception of the test system interface, where directions shall be seen from the point of view of the test component port mapped to the test system interface port.
// @id: TTCN3-CORE-6.2.9-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_09_test_008 {

    type port P_in message {
        in integer;
    }

    type port P_out message {
        out integer;
    }

    type component C_mtc {
        port P_in p;
    }

    type component C_ptc {
        port P_out p;
    }

    function f_send() runs on C_ptc {
        p.send(1);
    }

    testcase TC() runs on C_mtc {
        timer T_guard := 1.0;
        var C_ptc v_ptc := C_ptc.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_send());
        T_guard.start;
        alt {
            [] p.receive(integer:1) {
                setverdict(pass);
            }
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
