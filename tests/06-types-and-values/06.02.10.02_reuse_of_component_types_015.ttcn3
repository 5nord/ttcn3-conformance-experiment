// @requirement: 6.2.10.2 -- c) It is allowed to extend component types that are defined by means of extension, as long as no cyclic chain of definition is created.
// @id: TTCN3-CORE-6.2.10.2-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_10_02_reuse_of_component_types_015 {

    type component CA {
        var integer vc_a := 1;
    }

    type component CB extends CA {
        var integer vc_b := 2;
    }

    type component CC extends CB {
        var integer vc_c := 3;
    }

    testcase TC() runs on CC {
        if (vc_a == 1 and vc_b == 2 and vc_c == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
