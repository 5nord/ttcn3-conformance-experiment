// @requirement: 6.1.1.0 -- The "quadruple" is only capable to denote a single character and denotes the character by the decimal values of its group, plane, row and cell according to ISO/IEC 10646 [2], preceded by the keyword char included into a pair of brackets and separated by commas (e.g. char (0, 0, 1, 113) denotes the Latin small letter u with double acute: "ű").
// @id: TTCN3-CORE-6.1.1.0-040a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_general_031 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_u1 := char(0, 0, 40, 48);
        var universal charstring v_u2 := char (0, 0, 1, 113);
        if (v_u1 == int2unichar(10288) and v_u2 == int2unichar(369)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
