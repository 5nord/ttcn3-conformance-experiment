// @requirement: 6.2.7 -- For assigning values to multi-dimensional arrays, each dimension that is assigned shall resolve to a set of values enclosed in curly braces.
// @id: TTCN3-CORE-6.2.7-032a
// @verdict: pass reject
module M_06_02_07_test_030 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a[2][2];
        v_a := { 1, 2, 3, 4 }; // error: inner dimension is not enclosed in curly braces
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
