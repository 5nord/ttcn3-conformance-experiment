// @requirement: 6.2.15.8 -- TTCN-3 supports the definition of map types with nested structured types for the to part.
// @id: TTCN3-CORE-6.2.15.8-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_08_test_001 {

    type map from charstring to map from charstring to charstring MapType;

    type component C {}

    testcase TC() runs on C {
        var MapType v_map := { ["a"] := { ["b"] := "c" } };
        if (v_map["a"]["b"] == "c") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
