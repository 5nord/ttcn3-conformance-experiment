// @requirement: 6.3.3 -- 3) Mtc compatibility: a function or altstep referring to component type "A" in its mtc clause may be called or started in any context that has a mtc clause of type "B" or a testcase with a runs on clause of type "B" if all the port definitions of "A" have identical definitions in "B".
// @id: TTCN3-CORE-6.3.3-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_03_compatibility_of_component_types_003 {

    type port P message {
        inout integer;
    }

    type component CA {
        port P p;
    }
    type component CB {
        port P p;
        var integer v_x := 1;
    }

    function f_checkMtc() mtc CA {
        var CA v_mtc := mtc;
        if (v_mtc != null) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on CB {
        f_checkMtc();
    }

    control {
        execute(TC());
    }
}
