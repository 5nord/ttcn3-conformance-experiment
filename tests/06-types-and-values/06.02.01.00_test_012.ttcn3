// @requirement: 6.2.1.0 -- Mandatory fields, not explicitly referred to in the notation or explicitly unspecified using the not used symbol "-", shall remain unchanged.
// @id: TTCN3-CORE-6.2.1.0-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_test_012 {

    type record MyRecordType {
        integer field1,
        integer field2,
        integer field3
    }

    type component C {}

    testcase TC() runs on C {
        var MyRecordType v_r := { field1 := 1, field2 := 2, field3 := 3 };
        v_r := { field1 := -, field2 := 20 };
        if (v_r.field1 == 1 and v_r.field2 == 20 and v_r.field3 == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
