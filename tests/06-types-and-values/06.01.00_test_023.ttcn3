// @requirement: 6.1.0 -- Class of type: union; Keyword: list (see note)
// @id: TTCN3-CORE-6.1.0-023b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_test_023 {

    type union MyUnion {
        integer i,
        boolean b
    }

    type MyUnion MyUnionList ({ i := 1 }, { b := true });

    type component C {}

    testcase TC() runs on C {
        var MyUnionList v_union := { b := true };
        if (ischosen(v_union.b)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
