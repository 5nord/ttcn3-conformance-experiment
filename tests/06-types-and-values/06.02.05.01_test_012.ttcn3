// @requirement: 6.2.5.1 -- a) When expanding a value or value field of union type, the alternative referenced in the dot notation becomes the chosen one.
// @id: TTCN3-CORE-6.2.5.1-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_05_01_test_012 {

    type union Inner {
        bitstring subchoice1,
        charstring subchoice2
    }

    type union U {
        integer choice1,
        Inner choice2
    }

    type component C {}

    testcase TC() runs on C {
        var U v_u;
        v_u.choice2.subchoice1 := '1'B;
        if (ischosen(v_u.choice2) and ischosen(v_u.choice2.subchoice1)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
