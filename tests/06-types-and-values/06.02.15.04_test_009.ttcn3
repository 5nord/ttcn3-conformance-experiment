// @requirement: 6.2.15.4 -- The right-hand side of the assignment shall resolve into a boolean value in this case.
// @id: TTCN3-CORE-6.2.15.4-010a
// @verdict: pass reject
module M_06_02_15_04_test_009 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var template MyMap v_tmpl := { ["a"] := 1 };
        v_tmpl[*] := 1; // error: right hand side is not a boolean value
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
