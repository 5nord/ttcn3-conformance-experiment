// @requirement: 6.1.0 -- Values of integer type shall be denoted by one or more digits; the first digit shall not be zero unless the value is 0; the value zero shall be represented by a single zero.
// @id: TTCN3-CORE-6.1.0-003c
// @verdict: pass reject
module M_06_01_00_test_004 {

    type component C {}

    testcase TC() runs on C {
        var integer v_int := 00; // error: zero not represented by a single zero
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
