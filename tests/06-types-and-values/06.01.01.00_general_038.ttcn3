// @requirement: 6.1.1.0 -- Each short identifier represents a single character and it shall be composed of a letter U or u followed by an optional "+" PLUS SIGN character, followed by 1..8 hexadecimal digits.
// @id: TTCN3-CORE-6.1.1.0-047b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_general_038 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_u := char(U0171, u0171, U+0171, u+171, U00000171);
        if (v_u[0] == v_u[1] and v_u[0] == v_u[2] and v_u[0] == v_u[3] and v_u[0] == v_u[4] and
            unichar2int(v_u[0]) == 369) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
