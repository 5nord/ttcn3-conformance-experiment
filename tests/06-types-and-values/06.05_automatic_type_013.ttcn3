// @requirement: 6.5 -- If the literal contains only characters of the charstring type, the automatic type is charstring, otherwise it is universal charstring.
// @id: TTCN3-CORE-6.5-012b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_automatic_type_013 {
    type component C {}

    function f_check(inout universal charstring p_str) return boolean {
        return p_str == char(0, 0, 0, 228) & "bc";
    }

    testcase TC() runs on C {
        var v_auto := "äbc";
        if (f_check(v_auto)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
