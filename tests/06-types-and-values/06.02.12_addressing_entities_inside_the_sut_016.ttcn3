// @requirement: 6.2.12 -- c) The address type shall not be used in the to, from and sender parts of receive and send operations of connected ports, i.e. ports used for the communication among test components.
// @id: TTCN3-CORE-6.2.12-019a
// @verdict: pass reject
module M_06_02_12_addressing_entities_inside_the_sut_016 {

    type integer address;

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var address v_addr := 1;
        connect(mtc:p, v_ptc:p);
        p.send(integer:1) to v_addr; // error: address used in to part of a connected port
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
