// @requirement: 6.1.1.1 -- Only single elements of the string may be accessed.
// @id: TTCN3-CORE-6.1.1.1-004a
// @verdict: pass reject
module M_06_01_01_01_test_002 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_bs := '010'B;
        v_bs[1] := '11'B; // error: more than a single element assigned
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
