// @requirement: 6.2.9 -- a) At most one address type shall be bound to a port type.
// @id: TTCN3-CORE-6.2.9-031a
// @verdict: pass reject
module M_06_02_09_communication_port_types_027 {

    type port P message {
        address integer;
        address charstring; // error: second address type bound to the port type
        inout integer;
    }

    type component C {
        port P p;
    }
}
