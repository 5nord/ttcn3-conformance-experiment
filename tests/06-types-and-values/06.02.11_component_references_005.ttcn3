// @requirement: 6.2.11 -- In addition, component references are returned by the predefined operations system (returns the component reference of the test system interface, which is automatically created when testcase execution is started), mtc (returns the component reference of the MTC, which is automatically created when testcase execution started) and self (returns the component reference of the component in which self is called).
// @id: TTCN3-CORE-6.2.11-005c
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_11_component_references_005 {

    type component CMain {
        var integer vc_m := 0;
    }

    type component C {
    }

    function f_check(CMain p_mtc) runs on C mtc CMain {
        if (mtc == p_mtc) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on CMain {
        var CMain v_mtc := mtc;
        var C v_ptc := C.create;
        if (v_mtc != self) {
            setverdict(fail);
        }
        v_ptc.start(f_check(v_mtc));
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
