// @requirement: 6.1.0 -- Floating point values can be expressed by using two forms of value notations:
// @id: TTCN3-CORE-6.1.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_test_007 {

    type component C {}

    testcase TC() runs on C {
        var float v_dot := 1230.0;
        var float v_exp := 12.3E2;
        if (v_dot == v_exp) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
