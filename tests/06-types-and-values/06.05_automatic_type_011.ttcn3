// @requirement: 6.5 -- f) Character string literal.
// @id: TTCN3-CORE-6.5-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_automatic_type_011 {
    type component C {}

    testcase TC() runs on C {
        var v_auto := "abc";
        if (v_auto == "abc" and lengthof(v_auto) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
