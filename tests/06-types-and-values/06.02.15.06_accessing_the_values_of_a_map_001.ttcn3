// @requirement: 6.2.15.6 -- The set of values that the map contains can be accessed using the to selector.
// @id: TTCN3-CORE-6.2.15.6-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_06_accessing_the_values_of_a_map_001 {

    type map from charstring to integer MapType;

    type component C {}

    testcase TC() runs on C {
        var MapType v_map := { ["a"] := 1, ["b"] := 2 };
        var MapType.to v_values := v_map.to;
        var integer v_sum := 0;
        for (var integer i := 0; i < lengthof(v_values); i := i + 1) {
            v_sum := v_sum + v_values[i];
        }
        if (lengthof(v_values) == 2 and v_sum == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
