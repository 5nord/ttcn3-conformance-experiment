// @requirement: 6.2.6 -- NOTE 2: The user-defined type of anytype "contains" all types imported into the module where it is declared.
// @id: TTCN3-CORE-6.2.6-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_06_test_009 {

    import from M_06_02_06_test_009_A { type MyAnyType };

    type component C {}

    testcase TC() runs on C {
        var MyAnyType v_any;
        v_any.ThirdInt := 3;
        if (ischosen(v_any.ThirdInt) and v_any.ThirdInt == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_06_02_06_test_009_A {

    import from M_06_02_06_test_009_B { type ThirdInt };

    type anytype MyAnyType;
}

module M_06_02_06_test_009_B {
    type integer ThirdInt;
}
