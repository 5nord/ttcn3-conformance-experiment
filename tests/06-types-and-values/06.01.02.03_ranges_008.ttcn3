// @requirement: 6.1.2.3 -- Also for float, -infinity or infinity can be used as the bounds in range restrictions.
// @id: TTCN3-CORE-6.1.2.3-005a
// @verdict: pass accept, noexecution
module M_06_01_02_03_ranges_008 {

    type float MyLessThanPi (-infinity .. 3142E-3);
    type float MyGreaterThanPi (3142E-3 .. infinity);
    type float MyNumbers (-infinity .. infinity);

    const MyLessThanPi c_less := -1.0E10;
    const MyGreaterThanPi c_greater := 1.0E10;
    const MyNumbers c_any := 0.0;
}
