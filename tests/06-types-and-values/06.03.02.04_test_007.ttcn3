// @requirement: 6.3.2.4 -- The rules above make type compatibility along the default alternatives transitive, i.e. the outermost union type is compatible with the type of the innermost default union alternative if all containing alternatives are also default alternatives.
// @id: TTCN3-CORE-6.3.2.4-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_02_04_test_007 {

    type component C {}

    type union UInner { @default integer i, boolean b }
    type union UOuter { @default UInner u, charstring s }

    testcase TC() runs on C {
        var UOuter v_o := 5;
        var integer v_int := v_o;
        if (ischosen(v_o.u) and ischosen(v_o.u.i) and v_o.u.i == 5 and v_int == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
