// @requirement: 6.2.15.2 -- Templates of the map type can use a specific form of the mixed notation, where the first item is and asterisk representing the AnyElementsOrNone matching symbol, followed by one or more indexed assignments (see clause B.1.3.2 for more details).
// @id: TTCN3-CORE-6.2.15.2-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_02_indexed_assignment_notation_005 {

    type map from charstring to integer MyMap;

    template MyMap m_atLeastA := { *, ["a"] := 1 };

    type component C {}

    testcase TC() runs on C {
        var MyMap v_onlyA := { ["a"] := 1 };
        var MyMap v_more := { ["a"] := 1, ["b"] := 2, ["c"] := 3 };
        var MyMap v_noA := { ["b"] := 2 };
        if (match(v_onlyA, m_atLeastA) and match(v_more, m_atLeastA) and not match(v_noA, m_atLeastA)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
