// @requirement: 6.5 -- h) Qualified enumerated value.
// @id: TTCN3-CORE-6.5-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_test_015 {
    type enumerated Colour { yellow, red, blue, green }
    type component C {}

    function f_check(inout Colour p_col) return boolean {
        return p_col == red;
    }

    testcase TC() runs on C {
        var v_auto := Colour.red;
        if (f_check(v_auto)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
