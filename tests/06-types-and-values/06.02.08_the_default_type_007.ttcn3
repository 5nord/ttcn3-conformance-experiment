// @requirement: 6.2.8 -- The special value null represents an unspecific default reference, e.g. can be used for the initialization of variables of default type.
// @id: TTCN3-CORE-6.2.8-006b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_08_the_default_type_007 {

    type component C {
        var default vc_d := null;
    }

    testcase TC() runs on C {
        var default v_d := null;
        if (v_d == null and vc_d == null) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
