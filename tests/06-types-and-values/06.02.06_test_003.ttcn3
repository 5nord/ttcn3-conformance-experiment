// @requirement: 6.2.6 -- The fieldnames of the anytype shall be uniquely identified by the corresponding type names.
// @id: TTCN3-CORE-6.2.6-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_06_test_003 {

    type integer MyInt;

    type component C {}

    testcase TC() runs on C {
        var anytype v_a1, v_a2;
        v_a1.MyInt := 1;
        v_a2.integer := 1;
        if (ischosen(v_a1.MyInt) and not ischosen(v_a1.integer)
            and ischosen(v_a2.integer) and not ischosen(v_a2.MyInt)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
