// @requirement: 6.2.0 -- In these notations each assigned field or index shall not appear more than once and assignments to fields or indexes given in list notation are not allowed.
// @id: TTCN3-CORE-6.2.0-006a
// @verdict: pass reject
module M_06_02_00_general_004 {

    type record MyRecord { integer f1, integer f2 }

    const MyRecord c_r := { f1 := 1, f2 := 2, f1 := 3 }; // error: field f1 assigned twice

}
