// @requirement: 6.3.2.3 -- set types are only compatible with other set types and set of types are only compatible with other set of types.
// @id: TTCN3-CORE-6.3.2.3-001b
// @verdict: pass reject
module M_06_03_02_03_test_002 {

    type component C {}

    type set of integer SoType;
    type record of integer RoType;

    testcase TC() runs on C {
        var RoType v_myVarR := { 1, 2 };
        var SoType v_myVarS := v_myVarR; // error: record of value is not compatible with a set of type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
