// @requirement: 6.1.1.0 -- The USI-like notation is composed of the keyword char followed by parentheses.
// @id: TTCN3-CORE-6.1.1.0-045a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_test_035 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_u := char(U0171);
        if (v_u == char(0, 0, 1, 113)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
