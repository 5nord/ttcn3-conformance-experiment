// @requirement: 6.2.10.1 -- Port names in the same component type definition shall all have unique names.
// @id: TTCN3-CORE-6.2.10.1-003a
// @verdict: pass reject
module M_06_02_10_01_test_002 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
        port P p; // error: port name not unique within the component type
    }

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
