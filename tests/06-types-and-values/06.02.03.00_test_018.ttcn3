// @requirement: 6.2.3.0 -- The index notation, when used on the right-hand side, refers to the value of the identified element of a record of or a set of.
// @id: TTCN3-CORE-6.2.3.0-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_test_018 {

    type set of integer MySetOf;

    type component C {}

    testcase TC() runs on C {
        var MySetOf v_so := { 10, 20, 30 };
        var integer v_int := v_so[1];
        if (v_int == 20) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
