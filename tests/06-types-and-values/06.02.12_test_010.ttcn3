// @requirement: 6.2.12 -- If the type is not defined inside the module, explicit SUT addresses for a global address type shall only be passed in as parameters or be received in message fields or as parameters of remote procedure calls.
// @id: TTCN3-CORE-6.2.12-013a
// @verdict: pass accept, noexecution
module M_06_02_12_test_010 {

    import from M_06_02_12_test_010_A all;

    type component C {
        port P p;
    }

    function f(address p_addr) runs on C {
        var address v_addr := null;
        var R_Msg v_msg;
        p.send(integer:1) to p_addr;
        p.receive(R_Msg:?) -> value v_msg;
        v_addr := v_msg.addr;
        p.send(integer:2) to v_addr;
    }
}

module M_06_02_12_test_010_A {

    type integer address;

    type record R_Msg {
        address addr
    }

    type port P message {
        inout integer, R_Msg;
    }
}
