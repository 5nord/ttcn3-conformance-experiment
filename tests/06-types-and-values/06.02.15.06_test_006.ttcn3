// @requirement: 6.2.15.6 -- Since two different keys might be mapped to the same value in a map value, the values in the set of values might not be unique.
// @id: TTCN3-CORE-6.2.15.6-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_06_test_006 {

    type map from charstring to integer MapType;

    type component C {}

    testcase TC() runs on C {
        var MapType v_map := { ["a"] := 0, ["b"] := 0, ["c"] := 1 };
        var MapType.to v_values := v_map.to;
        var integer v_zeros := 0;
        for (var integer i := 0; i < lengthof(v_values); i := i + 1) {
            if (v_values[i] == 0) {
                v_zeros := v_zeros + 1;
            }
        }
        if (v_zeros == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
