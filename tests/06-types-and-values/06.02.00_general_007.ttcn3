// @requirement: 6.2.0 -- The value list notation can be used for record, record of, set and set `of value notations and` for arrays.
// @id: TTCN3-CORE-6.2.0-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_00_general_007 {

    type record MyRecord { integer f1, boolean f2 }
    type record of integer MyRecordOf;
    type set MySet { integer f1, boolean f2 }
    type set of integer MySetOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecord v_r := { 1, true };
        var MyRecordOf v_ro := { 1, 2, 3 };
        var MySet v_s := { 1, true };
        var MySetOf v_so := { 1, 2, 3 };
        var integer v_a[3] := { 1, 2, 3 };
        if (v_r.f1 == 1 and v_r.f2 == true
            and v_ro[2] == 3
            and v_s.f1 == 1 and v_s.f2 == true
            and lengthof(v_so) == 3
            and v_a[2] == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
