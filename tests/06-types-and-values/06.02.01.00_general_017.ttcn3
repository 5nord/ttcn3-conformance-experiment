// @requirement: 6.2.1.0 -- Omitted optional fields are not present in the record or set value intentionally, i.e. the field is initialized and it does not prevent the whole record or set from being completely initialized.
// @id: TTCN3-CORE-6.2.1.0-026b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_general_017 {

    type record MyRecordType {
        integer field1,
        boolean field2 optional
    }

    type set MySetType {
        integer field1,
        boolean field2 optional
    }

    type component C {}

    testcase TC() runs on C {
        var MyRecordType v_r := { field1 := 1, field2 := omit };
        var MySetType v_s := { field1 := 1, field2 := omit };
        if (isvalue(v_r) and isvalue(v_s)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
