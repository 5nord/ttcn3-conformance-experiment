// @requirement: 6.2.15.4 -- a) The index expression used for index notation and index assignment notation shall be completely initialized and compatible with the from type of the map type.
// @id: TTCN3-CORE-6.2.15.4-013b
// @verdict: pass reject
module M_06_02_15_04_test_013 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var MyMap v_map := { ["a"] := 1 };
        v_map[2] := 2; // error: index is not compatible with the from type charstring
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
