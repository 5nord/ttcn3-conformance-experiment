// @requirement: 6.2.14 -- These constants, variables or parameters can contain a reference to an existing timer or a special value null.
// @id: TTCN3-CORE-6.2.14-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_14_test_002 {

    type component C {
        timer T := 5.0;
    }

    testcase TC() runs on C {
        var timer v_timer := T;
        var timer v_null := null;
        v_timer.start;
        if (T.running and v_null == null) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        T.stop;
    }

    control {
        execute(TC());
    }
}
