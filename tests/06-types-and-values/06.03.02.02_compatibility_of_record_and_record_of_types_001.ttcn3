// @requirement: 6.3.2.2 -- record types are compatible if the number, and optional aspect of the fields in the textual order of definition are identical, the types of each field are compatible and the value of each existing field of the value "b" is compatible with the type of its corresponding field in type "A".
// @id: TTCN3-CORE-6.3.2.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_02_02_compatibility_of_record_and_record_of_types_001 {

    type component C {}

    type record AType {
        integer a(0..10) optional,
        integer b(0..10) optional,
        boolean c
    }
    type record BType {
        integer a optional,
        integer b(0..10) optional,
        boolean c
    }

    testcase TC() runs on C {
        var AType v_myVarA := { 0, 1, false };
        var BType v_myVarB := { 5, 2, true };
        v_myVarA := v_myVarB;
        if (v_myVarA == { 5, 2, true }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
