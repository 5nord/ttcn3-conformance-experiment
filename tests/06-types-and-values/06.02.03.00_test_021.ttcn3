// @requirement: 6.2.3.0 -- The index of the first element shall be zero and the index value shall not exceed the limitation placed by length subtyping.
// @id: TTCN3-CORE-6.2.3.0-022b
// @verdict: pass reject
module M_06_02_03_00_test_021 {

    type record length(3) of integer MyRecordOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro := { 1, 2, 3 };
        v_ro[3] := 4; // error: index exceeds length restriction
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
