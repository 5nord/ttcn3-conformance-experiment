// @requirement: 6.1.1.0 -- The parentheses enclose a comma-separated list of short identifiers .
// @id: TTCN3-CORE-6.1.1.0-046a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_test_036 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_u := char(U4E2D, U56FD, U0171);
        if (v_u == char(U4E2D) & char(U56FD) & char(U0171)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
