// @requirement: 6.2.1.1 -- a) When expanding a value or value field of record type, the subfield referenced in the dot notation shall be set to present and all unreferenced mandatory subfields shall be left uninitialized; when the assignment is used in a scope where the optional attribute is equal to "explicit omit", all unreferenced optional subfields shall be left undefined.
// @id: TTCN3-CORE-6.2.1.1-015c
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_01_test_011 {

    type component C {}

    type record Inner {
        integer subfield1,
        integer subfield2 optional
    }

    type record MyType4 {
        integer field1 optional,
        Inner field2 optional
    }

    testcase TC() runs on C {
        var MyType4 v_rec := { field1 := 1, field2 := omit };
        v_rec.field2.subfield1 := 5;
        if (not isbound(v_rec.field2.subfield2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    } with { optional "explicit omit" }

    control {
        execute(TC());
    }
}
