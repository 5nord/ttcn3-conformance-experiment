// @requirement: 6.2.13.0 -- TTCN-3 allows subtyping of structured types as given in table 3.
// @id: TTCN3-CORE-6.2.13.0-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_13_00_test_001 {

    type record R {
        integer f1,
        boolean f2
    }

    type record of integer RoI;

    type R R_Sub ({ f1 := 1, f2 := true }, { f1 := 2, f2 := false });
    type RoI RoI_Len length(1..3);
    type RoI RoI_List ({ 1 }, { 1, 2 });

    type component C {}

    testcase TC() runs on C {
        var R_Sub v_r := { f1 := 2, f2 := false };
        var RoI_Len v_len := { 7, 8 };
        var RoI_List v_list := { 1, 2 };
        if (v_r.f1 == 2 and lengthof(v_len) == 2 and v_list[1] == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
