// @requirement: 6.2.5.0 -- The assignment notation shall be used for union-s, and the notation shall assign a value to one field only.
// @id: TTCN3-CORE-6.2.5.0-007b
// @verdict: pass reject
module M_06_02_05_00_test_004 {

    type component C {}

    type union U {
        integer number,
        charstring string
    };

    testcase TC() runs on C {
        var U v_u := { number := 34, string := "abc" }; // error: more than one alternative assigned
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
