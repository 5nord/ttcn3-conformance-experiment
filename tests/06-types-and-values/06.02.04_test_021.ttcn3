// @requirement: 6.2.4 -- Each user-assigned integer value shall be distinct within a single enumerated type, all ranges of all the values lists shall be disjoint and shall not include any of the used single integer values.
// @id: TTCN3-CORE-6.2.4-020b
// @verdict: pass reject
module M_06_02_04_test_021 {

    type enumerated E {
        e_a (1 .. 5),
        e_b (4 .. 8) // error: range overlaps with the range of e_a
    };

}
