// @requirement: 6.3.3 -- 4) System compatibility: a function or altstep referring to component type "A" in its system clause may be called or started in any context that has a system clause of type "B" or a test case with a runs on clause of type "B" and no system clause if all the port definitions of "A" have identical definitions in "B".
// @id: TTCN3-CORE-6.3.3-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_03_test_005 {

    type port P message {
        inout integer;
    }

    type component CA {
        port P p;
    }
    type component CB {
        port P p;
        var integer v_x := 1;
    }

    function f_checkSystem() system CA {
        var CA v_system := system;
        if (v_system != null) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on CB {
        f_checkSystem();
    }

    control {
        execute(TC());
    }
}
