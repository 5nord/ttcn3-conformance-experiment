// @requirement: 6.2.3.0 -- For nested record of or set of types, an array or record of integer restricted to a single size can be used as a short-hand notation for a nested index notation.
// @id: TTCN3-CORE-6.2.3.0-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_test_026 {

    type record of integer MyBasicRecordOfType;
    type record of MyBasicRecordOfType My2DRecordOfType;

    type component C {}

    testcase TC() runs on C {
        var My2DRecordOfType v_ro := { { 0, 1 }, { 2, 3 }, { 4, 5 } };
        var integer v_i[2] := { 2, 1 };
        v_ro[v_i] := 9;
        if (v_ro[2][1] == 9 and v_ro[v_i] == 9) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
