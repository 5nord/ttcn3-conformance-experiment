// @requirement: 6.2.15.4 -- When the asterisk symbol is used at the left-hand side of an assignment, only the presence of the AnyElementsOrNone within the template is changed, values and keys remain unchanged.
// @id: TTCN3-CORE-6.2.15.4-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_04_index_notation_008 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var MyMap v_onlyA := { ["a"] := 1 };
        var MyMap v_more := { ["a"] := 1, ["b"] := 2 };
        var MyMap v_noA := { ["b"] := 2 };
        var template MyMap v_tmpl := { ["a"] := 1 };
        v_tmpl[*] := true;
        if (v_tmpl[*] and match(v_onlyA, v_tmpl) and match(v_more, v_tmpl) and not match(v_noA, v_tmpl)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
