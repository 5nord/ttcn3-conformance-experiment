// @requirement: 6.1.0 -- Class of type: Special data type; Keyword: anytype; Subtype: list
// @id: TTCN3-CORE-6.1.0-025b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_test_025 {

    type anytype MyAnyList ({ integer := 1 }, { boolean := true });

    type component C {}

    testcase TC() runs on C {
        var MyAnyList v_any := { integer := 1 };
        if (v_any.integer == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
with {
    extension "anytype integer, boolean"
}
