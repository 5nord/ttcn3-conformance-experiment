// @requirement: 6.1.2.6.1 -- Type: hexstring; Units of Length: hexadecimal digits
// @id: TTCN3-CORE-6.1.2.6.1-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_06_01_mixing_patterns_lists_and_ranges_005 {

    type hexstring MyHex length(3);

    type component C {}

    testcase TC() runs on C {
        var MyHex v_h := 'ABC'H;
        if (lengthof(v_h) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
