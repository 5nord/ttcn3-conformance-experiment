// @requirement: 6.3.2.2 -- Values of elements of the value "b" shall be assigned sequentially to the instance of type "A", including undefined elements.
// @id: TTCN3-CORE-6.3.2.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_02_02_test_004 {

    type component C {}

    type record of integer IType;

    testcase TC() runs on C {
        var IType v_myVarI;
        var integer v_myArrayVar[3];
        v_myVarI[0] := 1;
        v_myVarI[2] := 3;
        v_myArrayVar := v_myVarI;
        if (v_myArrayVar[0] == 1 and not isbound(v_myArrayVar[1]) and v_myArrayVar[2] == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
