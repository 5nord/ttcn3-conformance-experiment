// @requirement: 6.2.5.0 -- Only one of the specified alternatives will ever be present in an actual union value.
// @id: TTCN3-CORE-6.2.5.0-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_05_00_test_002 {

    type component C {}

    type union U {
        integer number,
        charstring string
    };

    testcase TC() runs on C {
        var U v_u;
        v_u.number := 34;
        v_u.string := "abc";
        if (ischosen(v_u.string) and not ischosen(v_u.number)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
