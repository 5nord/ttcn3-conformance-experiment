// @requirement: 6.1.2.5 -- TTCN-3 allows using character patterns specified in clause B.1.5 to constrain permitted values of charstring and universal charstring types.
// @id: TTCN3-CORE-6.1.2.5-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_05_pattern_subtyping_of_character_string_types_001 {

    type charstring MyString (pattern "abc*xyz");
    type universal charstring MyUString (pattern "*\r\n");

    type component C {}

    testcase TC() runs on C {
        var MyString v_s := "abc123xyz";
        var MyUString v_u := "line\r\n";
        if (v_s == "abc123xyz" and v_u == "line\r\n") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
