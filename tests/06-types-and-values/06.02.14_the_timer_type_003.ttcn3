// @requirement: 6.2.14 -- The special value null represents an unspecified timer reference, i.e. can be used for variables to explicitly reference no timer.
// @id: TTCN3-CORE-6.2.14-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_14_the_timer_type_003 {

    type component C {
        timer T := 5.0;
    }

    testcase TC() runs on C {
        var timer v_none := null;
        var timer v_some := T;
        if (v_none == null and v_some != null and v_none != v_some) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
