// @requirement: 6.2.7 -- Slice indexes shall conform to the related array definition dimensions.
// @id: TTCN3-CORE-6.2.7-036a
// @verdict: pass reject
module M_06_02_07_test_034 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a[1 .. 2][3];
        v_a[0] := { 1, 2, 3 }; // error: slice index 0 is outside the dimension range 1 .. 2
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
