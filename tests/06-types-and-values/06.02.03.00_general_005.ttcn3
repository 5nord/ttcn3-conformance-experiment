// @requirement: 6.2.3.0 -- When the assignment notation is used for record of-s and set `of-s, elements wished to be changed are identified` explicitly and either a value or the not used symbol "-" can be assigned to them.
// @id: TTCN3-CORE-6.2.3.0-007b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_general_005 {

    type record of integer MyRecordOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro := { 1, 2, 3 };
        v_ro := { [0] := -, [1] := 5, [2] := - };
        if (v_ro == { 1, 5, 3 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
