// @requirement: 6.2.3.0 -- When using the value list notation, all elements in the structure shall be specified either with a value or the not used symbol "-".
// @id: TTCN3-CORE-6.2.3.0-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_general_011 {

    type record of integer MyRecordOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro := { 1, 2, 3 };
        v_ro := { 9, -, 7 };
        if (v_ro == { 9, 2, 7 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
