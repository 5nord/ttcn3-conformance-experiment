// @requirement: 6.2.7 -- The values of array elements shall be compatible with the corresponding variable or type declaration.
// @id: TTCN3-CORE-6.2.7-022a
// @verdict: pass reject
module M_06_02_07_arrays_019 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a[2];
        v_a[0] := 1;
        v_a[1] := "two"; // error: value of wrong type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
