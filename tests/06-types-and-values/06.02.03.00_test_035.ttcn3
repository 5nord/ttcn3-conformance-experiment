// @requirement: 6.2.3.0 -- NOTE 2: When using on the right-hand side of an assignment for record of-s or set `of-s, the assignment` notation and the indexed notation have similar effect, with the exception that the assignment notation is able to address multiple elements in one notation, while the index notation is able to address a single element only.
// @id: TTCN3-CORE-6.2.3.0-033b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_test_035 {

    type record of integer MyRecordOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro1 := { 0, 1, 2 };
        var MyRecordOf v_ro2 := { 0, 1, 2 };
        v_ro1 := { [0] := 7, [2] := 9 };
        v_ro2[0] := 7;
        v_ro2[2] := 9;
        if (v_ro1 == { 7, 1, 9 } and v_ro1 == v_ro2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
