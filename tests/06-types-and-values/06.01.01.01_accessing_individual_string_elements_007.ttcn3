// @requirement: 6.1.1.1 -- For assigning an element to the end of a string, the length of the string should be used as index.
// @id: TTCN3-CORE-6.1.1.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_01_accessing_individual_string_elements_007 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_bs := '10'B;
        var charstring v_cs := "ab";
        v_bs[lengthof(v_bs)] := '1'B;
        v_cs[lengthof(v_cs)] := "c";
        if (v_bs == '101'B and v_cs == "abc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
