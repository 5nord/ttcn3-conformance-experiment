// @requirement: 6.2.14 -- Timer references have meaning only within the test component instances where the timer is defined, i.e. a timer reference assigned to a timer variable in a test component instance "a1" of type "A" has no meaning in a test component instance "a2" of type "A".
// @id: TTCN3-CORE-6.2.14-004a
// @verdict: pass reject
module M_06_02_14_test_005 {

    type component A {
        timer T := 5.0;
    }

    function f_ptc(timer p_timer) runs on A {
        p_timer.start;
        setverdict(pass);
    }

    testcase TC() runs on A {
        var A v_a2 := A.create;
        v_a2.start(f_ptc(T)); // error: timer reference of the mtc passed to another component instance
        v_a2.done;
    }

    control {
        execute(TC());
    }
}
