// @requirement: 6.1.1.0 -- NOTE 4: The predefined conversion function is able to return single-character-length values only.
// @id: TTCN3-CORE-6.1.1.0-038a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_test_029 {

    type component C {}

    testcase TC() runs on C {
        if (lengthof(int2unichar(20013)) == 1 and lengthof(int2unichar(369)) == 1 and
            lengthof(int2unichar(65)) == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
