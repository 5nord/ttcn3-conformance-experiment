// @requirement: 6.5 -- The automatic type is equal to the type of an expression or template body on the right-hand side of an assignment of the declaration.
// @id: TTCN3-CORE-6.5-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_automatic_type_003 {
    type record R { integer f }
    type component C {}

    const R c_r := { f := 1 };

    function f_check(inout R p_r) return boolean {
        return p_r.f == 1;
    }

    testcase TC() runs on C {
        var v_auto := c_r;
        if (f_check(v_auto)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
