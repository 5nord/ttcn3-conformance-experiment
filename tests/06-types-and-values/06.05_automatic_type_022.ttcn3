// @requirement: 6.5 -- A record field is created as optional if the value in the notation doesn't fulfil requirements of the present template restriction (see clause 15.8 for more details), otherwise it is created without the optional property.
// @id: TTCN3-CORE-6.5-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_automatic_type_022 {
    type component C {}

    testcase TC() runs on C {
        var template v_auto := { a := 1, b := integer:(1 .. 5) ifpresent };
        v_auto.b := omit;
        if (not ispresent(v_auto.b)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
