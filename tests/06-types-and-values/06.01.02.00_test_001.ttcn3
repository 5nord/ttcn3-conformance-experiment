// @requirement: 6.1.2.0 -- User-defined types shall be denoted by the keyword type.
// @id: TTCN3-CORE-6.1.2.0-001a
// @verdict: pass accept, noexecution
module M_06_01_02_00_test_001 {

    type integer MyInteger (0 .. 10);

    type record MyRecord {
        integer f1
    }

    const MyInteger c_int := 5;
    const MyRecord c_rec := { f1 := 1 };
}
