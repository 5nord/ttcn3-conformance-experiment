// @requirement: 6.1.1.0 -- Values of type hexstring shall be denoted by an arbitrary number (possibly zero) of the hexadecimal digits (uppercase and lowercase letters can equally be used as hex digits):
// @id: TTCN3-CORE-6.1.1.0-010b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_general_007 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_upper := 'AB01D'H;
        var hexstring v_lower := 'ab01d'H;
        var hexstring v_mixed := 'Ab01D'H;
        if (v_lower == v_upper and v_mixed == v_upper) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
