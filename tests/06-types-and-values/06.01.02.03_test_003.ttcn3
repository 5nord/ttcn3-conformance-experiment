// @requirement: 6.1.2.3 -- For integer and float, the subtype defined by the range restricts the allowed values of the subtype to the values in the range including or excluding the lower boundary and/or the upper boundary.
// @id: TTCN3-CORE-6.1.2.3-002b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_03_test_003 {

    type integer MyIntInclusive (0 .. 255);
    type integer MyIntExclusive (!-1 .. !256);
    type integer MyIntMixed (0 .. !256);
    type float MyFloatExclusive (!0.0 .. !1.0);
    type float MyFloatMixed (!0.0 .. 1.0);

    type component C {}

    testcase TC() runs on C {
        var MyIntInclusive v_i1 := 0;
        var MyIntExclusive v_i2 := 255;
        var MyIntMixed v_i3 := 255;
        var MyFloatExclusive v_f1 := 0.5;
        var MyFloatMixed v_f2 := 1.0;
        if (v_i1 == 0 and v_i2 == 255 and v_i3 == 255 and v_f1 == 0.5 and v_f2 == 1.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
