// @requirement: 6.1.1.0 -- Such whitespaces, control characters and backslash will be ignored for the value and length calculation.
// @id: TTCN3-CORE-6.1.1.0-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_test_018 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_o1 := 'Ff 96'O;
        var octetstring v_o2 := 'Ff\
        96'O;
        if (v_o1 == 'FF96'O and lengthof(v_o1) == 2 and
            v_o2 == 'FF96'O and lengthof(v_o2) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
