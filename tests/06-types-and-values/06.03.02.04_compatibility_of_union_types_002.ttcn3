// @requirement: 6.3.2.4 -- A union value "b" of union type "B" with a default alternative of type "C" is compatible with an arbitrary type "A" if the alternative selected in "b" is the default alternative and the value of the default alternative is compatible to "A".
// @id: TTCN3-CORE-6.3.2.4-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_02_04_compatibility_of_union_types_002 {

    type component C {}

    type union U3 { @default integer i, boolean b }

    testcase TC() runs on C {
        var U3 v_u3 := { i := 3 };
        var integer v_int := v_u3;
        if (v_int == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
