// @requirement: 6.1.2.6.2 -- Within bitstring, hexstring, `octetstring subtype definitions lists and length restriction may be mixed in` the same subtype definition.
// @id: TTCN3-CORE-6.1.2.6.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_06_02_test_001 {

    type bitstring MyBits ('0'B, '01'B, '0101'B) length(1 .. 2);
    type hexstring MyHex ('A'H, 'AB'H, 'ABC'H) length(2 .. 3);
    type octetstring MyOct ('AB'O, 'ABCD'O, 'ABCDEF'O) length(1 .. 2);

    type component C {}

    testcase TC() runs on C {
        var MyBits v_b := '01'B;
        var MyHex v_h := 'ABC'H;
        var MyOct v_o := 'ABCD'O;
        if (v_b == '01'B and v_h == 'ABC'H and v_o == 'ABCD'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
