// @requirement: 6.2.3.0 -- Referencing an identified element of an uninitialized or omitted record of or set of field or value on the right-hand side of an assignment shall cause an error.
// @id: TTCN3-CORE-6.2.3.0-024a
// @verdict: pass accept, ttcn3verdict:error
module M_06_02_03_00_general_023 {

    type record of integer MyRecordOf;

    type record MyRecord {
        MyRecordOf field1 optional
    }

    type component C {}

    function f_get(MyRecord p_rec) return integer {
        return p_rec.field1[0];
    }

    testcase TC() runs on C {
        var MyRecord v_rec := { field1 := omit };
        var integer v_int;
        setverdict(pass);
        v_int := f_get(v_rec); // error: field1 is omitted
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
