// @requirement: 6.2.5.0 -- Neither the not used symbol "-" nor omit is allowed in union value notations.
// @id: TTCN3-CORE-6.2.5.0-009a
// @verdict: pass reject
module M_06_02_05_00_test_006 {

    type component C {}

    type union U {
        integer number,
        charstring string
    };

    testcase TC() runs on C {
        var U v_u := { number := - }; // error: not used symbol in union value notation
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
