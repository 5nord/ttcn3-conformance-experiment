// @requirement: 6.2.1.0 -- The fields of a record type may be of any TTCN-3 type.
// @id: TTCN3-CORE-6.2.1.0-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_test_001 {

    type enumerated MyEnum { e_one, e_two }
    type union MyUnion { integer ch1, charstring ch2 }
    type record MyOtherRecordType { bitstring field1, boolean field2 }
    type record of integer MyRecordOf;
    type set MySet { integer s1 }
    type set of boolean MySetOf;

    type component C {}

    type record MyRecordType {
        integer f_int,
        float f_float,
        boolean f_bool,
        verdicttype f_verdict,
        bitstring f_bit,
        hexstring f_hex,
        octetstring f_oct,
        charstring f_char,
        universal charstring f_uchar,
        MyEnum f_enum,
        MyUnion f_union,
        MyOtherRecordType f_record,
        MyRecordOf f_recordOf,
        MySet f_set,
        MySetOf f_setOf,
        C f_comp,
        default f_default
    }

    testcase TC() runs on C {
        var MyRecordType v_r := {
            f_int := 1,
            f_float := 1.5,
            f_bool := true,
            f_verdict := pass,
            f_bit := '1'B,
            f_hex := 'A'H,
            f_oct := 'FF'O,
            f_char := "a",
            f_uchar := char(0, 0, 1, 111),
            f_enum := e_two,
            f_union := { ch1 := 5 },
            f_record := { '11001'B, true },
            f_recordOf := { 1, 2 },
            f_set := { s1 := 3 },
            f_setOf := { true },
            f_comp := null,
            f_default := null
        };
        if (v_r.f_int == 1 and v_r.f_enum == e_two and v_r.f_record.field2
            and v_r.f_recordOf[1] == 2 and v_r.f_comp == null) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
