// @requirement: 6.3.3 -- If the type of the mtc is unknown in the calling function, this can lead to runtime errors if the component type "A" is not mtc-compatible with the type of the running mtc.
// @id: TTCN3-CORE-6.3.3-005a
// @verdict: pass accept, ttcn3verdict:error
module M_06_03_03_compatibility_of_component_types_004 {

    type port P message {
        inout integer;
    }

    type component CA {
        port P p;
    }
    type component CX {
        port P q;
    }

    function f_needsMtc() mtc CA {
        setverdict(pass);
    }

    function f_unknownMtc() {
        f_needsMtc(); // mtc type unknown here, running mtc is of incompatible type CX
    }

    testcase TC() runs on CX {
        f_unknownMtc();
    }

    control {
        execute(TC());
    }
}
