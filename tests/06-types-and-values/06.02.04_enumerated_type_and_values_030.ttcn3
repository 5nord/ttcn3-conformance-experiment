// @requirement: 6.2.4 -- When a TTCN-3 module parameter, formal parameter, constant, variable, non-parameterized template or parameterized template with all formal parameters having default values of an imported enumerated type is defined, the name of that definition shall not be the same as any of the enumerated values of that type.
// @id: TTCN3-CORE-6.2.4-030a
// @verdict: pass reject
module M_06_02_04_enumerated_type_and_values_030 {

    import from M_06_02_04_enumerated_type_and_values_030_A all;

    const E e_a := e_b; // error: constant of imported enumerated type named like one of its values

}

module M_06_02_04_enumerated_type_and_values_030_A {

    type enumerated E { e_a, e_b };

}
