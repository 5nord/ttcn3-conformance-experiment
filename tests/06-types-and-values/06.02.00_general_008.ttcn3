// @requirement: 6.2.0 -- The index notation as part of an assignment or mixed notation can be used as the left-hand side of element assignments for record of, set `of and map value notations and for arrays.
// @id: TTCN3-CORE-6.2.0-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_00_general_008 {

    type record of integer MyRecordOf;
    type set of integer MySetOf;
    type map from integer to charstring MyMap;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro := { [0] := 10, [1] := 11 };
        var MySetOf v_so := { 20, [1] := 21 };
        var MyMap v_m := { [5] := "five", [7] := "seven" };
        var integer v_a[2] := { [1] := 31, [0] := 30 };
        if (v_ro[1] == 11 and v_so[1] == 21 and v_m[7] == "seven" and v_a[0] == 30) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
