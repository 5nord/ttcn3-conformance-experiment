// @requirement: 6.2.15.9 -- In map values, both keys and value fields associated with them are mandatory.
// @id: TTCN3-CORE-6.2.15.9-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_09_optionality_of_map_element_values_001 {

    type map from charstring to integer MapType;

    type component C {}

    testcase TC() runs on C {
        var MapType v_map := { ["a"] := 1, ["b"] := 2 };
        unmap(v_map, "a");
        var MapType.from v_keys := v_map.from;
        var boolean v_allPresent := true;
        for (var integer i := 0; i < lengthof(v_keys); i := i + 1) {
            if (not ispresent(v_map[v_keys[i]])) {
                v_allPresent := false;
            }
        }
        if (v_allPresent and lengthof(v_keys) == 1 and not isbound(v_map["a"])) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
