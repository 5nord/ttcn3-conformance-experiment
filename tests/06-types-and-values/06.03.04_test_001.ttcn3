// @requirement: 6.3.4 -- The communication operations (see clause 22) `send, receive, trigger, call, getcall, reply, getreply` and raise and connection operations connect, map, disconnect and unmap (see clause 21.1) are exceptions to the weaker rule of type compatibility and require strong typing.
// @id: TTCN3-CORE-6.3.4-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_04_test_001 {
    type record R1 { integer f }
    type record R2 { integer f }
    type port P message { inout R1, R2 }
    type component C { port P p }

    function f_send() runs on C {
        p.send(R1:{ f := 1 });
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.receive(R2:?) { setverdict(fail); }
            [] p.receive(R1:?) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
