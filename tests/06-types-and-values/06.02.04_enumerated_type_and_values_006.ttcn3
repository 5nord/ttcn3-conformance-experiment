// @requirement: 6.2.4 -- The qualified form consists of the enumerated type reference, followed by a dot and the enumerated value identifier.
// @id: TTCN3-CORE-6.2.4-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_04_enumerated_type_and_values_006 {

    type component C {}

    type enumerated E { e_a, e_b };

    testcase TC() runs on C {
        var E v_e := E.e_b;
        if (enum2int(v_e) == 1 and E.e_a == e_a) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
