// @requirement: 6.2.15.4 -- The index notation, when used on the right-hand side, refers to the value element that the map value or template associates with the key given as the index or with the presence of the AnyElementsOrNone matching symbol if asterisk is used instead of the index.
// @id: TTCN3-CORE-6.2.15.4-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_04_test_003 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var MyMap v_map := { ["a"] := 1, ["b"] := 2 };
        var template MyMap v_tmpl := { ["a"] := (1 .. 5) };
        var integer v_b := v_map["b"];
        var template integer v_ta := v_tmpl["a"];
        if (v_b == 2 and match(3, v_ta) and not match(6, v_ta)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
