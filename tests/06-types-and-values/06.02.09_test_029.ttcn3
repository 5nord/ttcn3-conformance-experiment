// @requirement: 6.2.9 -- c) At most one unmap parameter list shall be defined for a port type.
// @id: TTCN3-CORE-6.2.9-033a
// @verdict: pass reject
module M_06_02_09_test_029 {

    type port P message {
        inout integer;
        unmap param (in integer p_a);
        unmap param (in charstring p_b); // error: second unmap parameter list
    }

    type component C {
        port P p;
    }
}
