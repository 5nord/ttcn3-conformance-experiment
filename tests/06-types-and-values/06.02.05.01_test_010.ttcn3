// @requirement: 6.2.5.1 -- This rule shall apply recursively if the reference contains alternatives of nested unions, choosing all the referenced alternatives.
// @id: TTCN3-CORE-6.2.5.1-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_05_01_test_010 {

    type union U {
        integer choice1,
        union {
            bitstring subchoice1,
            charstring subchoice2
        } choice2
    }

    type component C {}

    testcase TC() runs on C {
        var U v_u := { choice1 := 1 };
        v_u.choice2.subchoice2 := "Hello!";
        if (ischosen(v_u.choice2) and ischosen(v_u.choice2.subchoice2)
            and v_u == { choice2 := { subchoice2 := "Hello!" } }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
