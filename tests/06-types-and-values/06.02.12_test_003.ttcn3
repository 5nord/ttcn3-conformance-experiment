// @requirement: 6.2.12 -- TemplateInstance
// @id: TTCN3-CORE-6.2.12-004a
// @verdict: pass accept, noexecution
module M_06_02_12_test_003 {

    type record R_Addr {
        integer field1,
        boolean field2
    }

    type port P message {
        address R_Addr;
        inout integer;
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C system C {
        map(mtc:p, system:p);
        p.send(integer:5) to R_Addr:{ field1 := 5, field2 := true };
        p.receive(integer:?) from R_Addr:{ field1 := ?, field2 := true };
        setverdict(pass);
    }
}
