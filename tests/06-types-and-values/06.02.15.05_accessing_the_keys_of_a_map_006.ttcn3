// @requirement: 6.2.15.5 -- There is always exactly one value mapped to each key in a map value.
// @id: TTCN3-CORE-6.2.15.5-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_05_accessing_the_keys_of_a_map_006 {

    type map from charstring to integer MapType;

    type component C {}

    testcase TC() runs on C {
        var MapType v_map := { ["a"] := 1 };
        v_map["a"] := 2;
        if (lengthof(v_map) == 1 and v_map["a"] == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
