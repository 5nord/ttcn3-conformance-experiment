// @requirement: 6.2.14 -- TTCN-3 allows to define timer constants, variables and parameters.
// @id: TTCN3-CORE-6.2.14-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_14_test_001 {

    const timer c_noTimer := null;

    type component C {
        timer T := 5.0;
    }

    function f_isRunning(timer p_timer) return boolean {
        return p_timer.running;
    }

    testcase TC() runs on C {
        const timer c_timer := T;
        var timer v_timer := c_timer;
        v_timer.start;
        if (f_isRunning(v_timer) and c_noTimer == null) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        T.stop;
    }

    control {
        execute(TC());
    }
}
