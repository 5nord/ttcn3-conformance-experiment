// @requirement: 6.2.13.2 -- List subtyping is possible when defining a new type based on an existing parent type, but not directly at the declaration of the core type (see table 3).
// @id: TTCN3-CORE-6.2.13.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_13_02_test_001 {

    type record R {
        integer f1,
        charstring f2
    }

    type R R_Sub ({ f1 := 1, f2 := "a" }, { f1 := 2, f2 := "b" });

    type component C {}

    testcase TC() runs on C {
        var R_Sub v_r := { f1 := 2, f2 := "b" };
        if (v_r.f1 == 2 and v_r.f2 == "b") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
