// @requirement: 6.2.4 -- For enumerated values with no value assigned or with a specific integer value assigned, the user shall not directly use associated integer values, but can access them and convert integer values into enumerated values by using the predefined functions enum2int and int2enum (see clauses 16.1.2, C.1.30 and C.1.4).
// @id: TTCN3-CORE-6.2.4-025b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_04_test_029 {

    type component C {}

    type enumerated E {
        e_a,
        e_b (7)
    };

    testcase TC() runs on C {
        var E v_e := e_b;
        var E v_conv;
        int2enum(0, v_conv);
        if (enum2int(v_e) == 7 and v_conv == e_a) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
