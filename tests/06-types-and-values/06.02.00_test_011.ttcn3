// @requirement: 6.2.0 -- It is allowed to mix the two value notations in the same (immediate) context only in such a way that elements in list notation do not follow elements in assignment notation.
// @id: TTCN3-CORE-6.2.0-014a
// @verdict: pass reject
module M_06_02_00_test_011 {

    type record MyRecordType {
        integer field1,
        boolean field2,
        charstring field3
    }

    const MyRecordType c_myRecordValue := { 1, field2 := true, "A string" }; // error: list element after assignment

}
