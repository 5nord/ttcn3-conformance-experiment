// @requirement: 6.1.2.3 -- In the case of charstring and universal charstring types, the range restricts the allowed values for each separate character in the strings.
// @id: TTCN3-CORE-6.1.2.3-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_03_test_015 {

    type charstring MyChars ("a" .. "c");
    type universal charstring MyUChars ("a" .. !"z");

    type component C {}

    testcase TC() runs on C {
        var MyChars v_cs := "cba";
        var MyUChars v_ucs := "yyab";
        if (v_cs == "cba" and v_ucs == "yyab") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
