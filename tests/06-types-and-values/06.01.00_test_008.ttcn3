// @requirement: 6.1.0 -- the decimal notation with a dot in a sequence of numbers like, 1,23 (which represents 123 × 10[-2]), 2,783 (i.e. 2 783 × 10[-3]) or -123,456789 (which represents -123 456 789 × 10[-6]); or
// @id: TTCN3-CORE-6.1.0-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_test_008 {

    type component C {}

    testcase TC() runs on C {
        var float v_a := 1.23;
        var float v_b := 2.783;
        var float v_c := -123.456789;
        if (v_a == 123.0E-2 and v_b == 2783.0E-3 and v_c == -123456789.0E-6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
