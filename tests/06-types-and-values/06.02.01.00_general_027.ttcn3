// @id: TTCN3-CORE-6.2.1.0-037b
// @verdict: pass reject
module M_06_02_01_00_general_027 {

    type component C {}

    type record R {
        integer f1,
        integer f2 optional,
        integer f3
    }

    testcase TC() runs on C {
        var R v_r := { 1, , 3 }; // error: empty assignment
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
