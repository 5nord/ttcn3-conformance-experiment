// @requirement: 6.2.1.0 -- Its result is that the given field is not present in the given value.
// @id: TTCN3-CORE-6.2.1.0-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_general_011 {

    type record MyRecordType {
        integer field1,
        boolean field2 optional
    }

    type component C {}

    testcase TC() runs on C {
        var MyRecordType v_r := { field1 := 1, field2 := omit };
        if (not ispresent(v_r.field2) and isbound(v_r.field2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
