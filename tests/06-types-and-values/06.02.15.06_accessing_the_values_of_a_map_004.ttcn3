// @requirement: 6.2.15.6 -- If MapValue is a value of type MapValueType defined as map `from` _A_ `to` _B then MapValue.to yields a result_ compatible with type set of _B that contains all the values from MapValue.
// @id: TTCN3-CORE-6.2.15.6-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_06_accessing_the_values_of_a_map_004 {

    type map from integer to charstring MapType;
    type set of charstring CharSet;

    type component C {}

    function f_contains(CharSet p_set, charstring p_item) return boolean {
        for (var integer i := 0; i < lengthof(p_set); i := i + 1) {
            if (p_set[i] == p_item) {
                return true;
            }
        }
        return false;
    }

    testcase TC() runs on C {
        var MapType v_map := { [1] := "a", [2] := "b", [3] := "c" };
        var CharSet v_values := v_map.to;
        if (lengthof(v_values) == 3 and f_contains(v_values, "a") and f_contains(v_values, "b")
            and f_contains(v_values, "c")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
