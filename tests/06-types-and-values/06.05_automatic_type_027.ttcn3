// @requirement: 6.5 -- The common type of the indexes and the_ common type of the values shall fulfil requirements for automatic typing.
// @id: TTCN3-CORE-6.5-022a
// @verdict: pass reject
module M_06_05_automatic_type_027 {
    type component C {}

    testcase TC() runs on C {
        var v_auto := { ["a"] := null, ["b"] := null }; // error: common type of the values is not unambiguous
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
