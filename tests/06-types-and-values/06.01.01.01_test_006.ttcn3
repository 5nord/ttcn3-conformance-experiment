// @requirement: 6.1.1.1 -- Trying to retrieve an element from a string with an index outside this range shall cause an error.
// @id: TTCN3-CORE-6.1.1.1-008a
// @verdict: pass accept, ttcn3verdict:error
module M_06_01_01_01_test_006 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_cs := "abc";
        var integer v_idx := 3;
        var charstring v_elem := v_cs[v_idx]; // error: index outside 0 .. lengthof(v_cs) - 1
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
