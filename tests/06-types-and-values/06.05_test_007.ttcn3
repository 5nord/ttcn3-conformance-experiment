// @requirement: 6.5 -- b) Function call returning a value, including predefined functions.
// @id: TTCN3-CORE-6.5-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_test_007 {
    type component C {}

    function f_isEven(integer p_par) return boolean {
        return p_par mod 2 == 0;
    }

    testcase TC() runs on C {
        var v_autoA := f_isEven(4);
        var v_autoB := lengthof("abc");
        if (v_autoA and v_autoB == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
