// @requirement: 6.2.15.4 -- b) When an index operation of a map value with a key as an index is used as the left-hand side of an assignment, the assigned value shall be compatible with the to type of the map type.
// @id: TTCN3-CORE-6.2.15.4-014a
// @verdict: pass reject
module M_06_02_15_04_test_014 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var MyMap v_map := { ["a"] := 1 };
        v_map["b"] := "two"; // error: assigned value is not compatible with the to type integer
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
