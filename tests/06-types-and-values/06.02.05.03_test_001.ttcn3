// @requirement: 6.2.5.3 -- TTCN-3 supports the definition of types for union alternatives nested within the union definition, similar to the mechanism for record types described in clause 6.2.1.3.
// @id: TTCN3-CORE-6.2.5.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_05_03_test_001 {

    type union U {
        record {
            integer f1,
            boolean f2
        } choice1,
        enumerated { e_a, e_b } choice2,
        record of integer choice3
    }

    type component C {}

    testcase TC() runs on C {
        var U v_u1 := { choice1 := { f1 := 1, f2 := true } };
        var U v_u2 := { choice2 := e_b };
        var U v_u3 := { choice3 := { 1, 2 } };
        if (v_u1.choice1.f1 == 1 and v_u2.choice2 == e_b and lengthof(v_u3.choice3) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
