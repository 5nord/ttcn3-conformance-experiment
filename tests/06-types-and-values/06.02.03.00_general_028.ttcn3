// @requirement: 6.2.3.0 -- a) When expanding a value or value field of record of or set of type, the element referenced by the index notation shall be set to present and all elements with a smaller index shall be created with an uninitialized value.
// @id: TTCN3-CORE-6.2.3.0-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_general_028 {

    type record of integer MyRecordOf;

    type record MyRecord {
        MyRecordOf field1 optional
    }

    type component C {}

    testcase TC() runs on C {
        var MyRecord v_rec := { field1 := omit };
        v_rec.field1[0] := 5;
        if (ispresent(v_rec.field1) and ispresent(v_rec.field1[0]) and v_rec.field1[0] == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
