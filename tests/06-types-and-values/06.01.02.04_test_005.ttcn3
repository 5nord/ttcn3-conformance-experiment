// @requirement: 6.1.2.4 -- For the upper bound the keyword infinity should also be used to indicate that there is no upper limit for the length.
// @id: TTCN3-CORE-6.1.2.4-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_04_test_005 {

    type charstring MyStr length(2 .. infinity);

    type component C {}

    testcase TC() runs on C {
        var MyStr v_s := "abcdefghijklmnopqrstuvwxyz";
        if (lengthof(v_s) == 26) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
