// @requirement: 6.2.8 -- Values of the default type are object references and follow specific rules for this kind of values.
// @id: TTCN3-CORE-6.2.8-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_08_test_009 {

    type component C {
        timer T;
        var boolean v_hit := false;
    }

    altstep a_def() runs on C {
        [] T.timeout {
            v_hit := true;
        }
    }

    testcase TC() runs on C {
        timer T_guard;
        var default v_d1 := activate(a_def());
        var default v_d2 := v_d1;
        deactivate(v_d2);
        T.start(0.1);
        T_guard.start(1.0);
        alt {
            [] T_guard.timeout {}
        }
        if (v_d1 == v_d2 and not v_hit) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
