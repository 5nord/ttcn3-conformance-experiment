// @requirement: 6.1.0 -- Class of type: Simple basic types; Keyword: integer; Subtype: range, list
// @id: TTCN3-CORE-6.1.0-009b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_simple_basic_types_and_values_009 {

    type integer IntRange (0 .. 10);

    type integer IntList (1, 2, 3);

    type component C {}

    testcase TC() runs on C {
        var IntRange v_range := 10;
        var IntList v_list := 2;
        if (v_range == 10 and v_list == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
