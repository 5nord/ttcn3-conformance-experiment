// @requirement: 6.1.2.3 -- If both the lower and upper bounds denote infinity, no numerical values are included, only the special value infinity.
// @id: TTCN3-CORE-6.1.2.3-009a
// @verdict: pass reject
module M_06_01_02_03_test_012 {

    type float MyInfinity (infinity .. infinity);

    const MyInfinity c_inf := infinity;
    const MyInfinity c_value := 1.0E300; // error: numerical value not included in the range
}
