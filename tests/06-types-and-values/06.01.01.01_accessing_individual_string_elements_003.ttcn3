// @requirement: 6.1.1.1 -- Trying to assign strings with length 0 or more than 1 to a string element using the array-like syntax shall cause an error.
// @id: TTCN3-CORE-6.1.1.1-005a
// @verdict: pass accept, ttcn3verdict:error
module M_06_01_01_01_accessing_individual_string_elements_003 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_cs := "abc";
        var charstring v_empty := "";
        v_cs[1] := v_empty; // error: string of length 0 assigned to an element
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
