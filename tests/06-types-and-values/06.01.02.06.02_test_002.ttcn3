// @requirement: 6.1.2.6.2 -- Within charstring and universal charstring subtype definitions it is allowed to add a length restriction to constraints containing list, range or pattern subtyping in the same subtype definition.
// @id: TTCN3-CORE-6.1.2.6.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_06_02_test_002 {

    type charstring MyCharStr5 ("gr", "xyz") length (1 .. 9);
    type charstring MyCharStr6 ("a" .. "z") length (3 .. 9);
    type charstring MyCharStr7 (pattern "[a-z]#(3,9)") length (1 .. 9);
    type universal charstring MyUCharStr ("a" .. "z") length (2);

    type component C {}

    testcase TC() runs on C {
        var MyCharStr5 v_5 := "xyz";
        var MyCharStr6 v_6 := "abcd";
        var MyCharStr7 v_7 := "hello";
        var MyUCharStr v_u := "ab";
        if (v_5 == "xyz" and v_6 == "abcd" and v_7 == "hello" and v_u == "ab") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
