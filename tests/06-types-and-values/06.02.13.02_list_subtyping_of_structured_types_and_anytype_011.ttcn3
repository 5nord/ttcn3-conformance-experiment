// @requirement: 6.2.13.2 -- In the latter case, the fields that are not explicitly present shall be considered as containing AnyValue for mandatory fields and _AnyValueOrNone_ for optional fields.
// @id: TTCN3-CORE-6.2.13.2-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_13_02_list_subtyping_of_structured_types_and_anytype_011 {

    type record R {
        integer f1 optional,
        charstring f2,
        charstring f3
    }

    type R R_Sub ({ f2 := "user" });

    type component C {}

    testcase TC() runs on C {
        var R_Sub v_1 := { f1 := omit, f2 := "user", f3 := "a" };
        var R_Sub v_2 := { f1 := 42, f2 := "user", f3 := "b" };
        if (not ispresent(v_1.f1) and v_2.f1 == 42 and v_1.f3 != v_2.f3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
