// @requirement: 6.2.13.3 -- If the innermost type is a basic type, the subtyping rules in clause 6.1.2 shall apply.
// @id: TTCN3-CORE-6.2.13.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_13_03_subtyping_of_the_iterated_type_of_record_ofs_and_set_ofs_003 {

    type record of integer IntArray (1 .. 5, 10);
    type set of charstring CharSet length(2);

    type component C {}

    testcase TC() runs on C {
        var IntArray v_ints := { 1, 5, 10, 3 };
        var CharSet v_strs := { "ab", "cd" };
        if (lengthof(v_ints) == 4 and v_ints[2] == 10 and lengthof(v_strs[1]) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
