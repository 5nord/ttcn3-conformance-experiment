// @requirement: 6.2.7 -- The index of the first element shall be zero or the lower bound if an index range has been given.
// @id: TTCN3-CORE-6.2.7-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_07_arrays_023 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a1[3] := { 10, 20, 30 };
        var integer v_a2[4 .. 6] := { 40, 50, 60 };
        if (v_a1[0] == 10 and v_a2[4] == 40) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
