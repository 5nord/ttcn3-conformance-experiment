// @requirement: 6.1.0 -- Class of type: octetstring; Keyword: list, length
// @id: TTCN3-CORE-6.1.0-015b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_simple_basic_types_and_values_015 {

    type octetstring OctList ('00'O, 'FF'O);

    type octetstring OctLength length(2);

    type component C {}

    testcase TC() runs on C {
        var OctList v_list := 'FF'O;
        var OctLength v_len := '0102'O;
        if (v_list == 'FF'O and lengthof(v_len) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
