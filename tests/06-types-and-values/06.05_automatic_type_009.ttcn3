// @requirement: 6.5 -- d) Expression composed of several operands where the type of the result can be unambiguously resolved using the rules for expressions (clause 7) or automatic types.
// @id: TTCN3-CORE-6.5-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_automatic_type_009 {
    type component C {}

    testcase TC() runs on C {
        var integer v_int := 1;
        var v_autoA := v_int + 6;
        var v_autoB := "ab" & "cd";
        var v_autoC := (v_int > 0) and true;
        if (v_autoA == 7 and v_autoB == "abcd" and v_autoC) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
