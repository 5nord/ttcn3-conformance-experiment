// @requirement: 6.2.0 -- In case of union types, to avoid infinite recursion, at least one of the alternatives shall not reference its own type.
// @id: TTCN3-CORE-6.2.0-022a
// @verdict: pass reject
module M_06_02_00_test_016 {

    type union MyUnion2 { // error: every alternative references the union itself
        MyUnion2 choice1,
        MyUnion2 choice2
    }

}
