// @requirement: 6.2.6 -- The address type shall be included if it has been explicitly defined within that module.
// @id: TTCN3-CORE-6.2.6-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_06_test_002 {

    type charstring address;

    type component C {}

    testcase TC() runs on C {
        var anytype v_any;
        v_any.address := "host";
        if (ischosen(v_any.address) and v_any.address == "host") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
