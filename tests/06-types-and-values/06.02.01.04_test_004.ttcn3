// @requirement: 6.2.1.4 -- Promoted fields act like ordinary fields of a record
// @id: TTCN3-CORE-6.2.1.4-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_04_test_004 {

    type component C {}

    type record Point {
        integer x,
        integer y
    }

    type record Pixel {
        Point,
        charstring color
    }

    testcase TC() runs on C {
        var Pixel v_p := { Point := { 4, 8 }, color := "red" };
        v_p.x := 7;
        var integer v_y := v_p.y;
        if (v_p.Point.x == 7 and v_y == 8) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
