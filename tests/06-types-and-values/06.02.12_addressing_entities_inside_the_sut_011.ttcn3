// @requirement: 6.2.12 -- In addition, the special value null is available for the address type to indicate an undefined address, e.g. for the initialization of variables of the address type.
// @id: TTCN3-CORE-6.2.12-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_12_addressing_entities_inside_the_sut_011 {

    type integer address;

    type component C {}

    testcase TC() runs on C {
        var address v_addr := null;
        if (v_addr == null) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
