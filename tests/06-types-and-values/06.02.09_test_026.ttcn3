// @requirement: 6.2.9 -- Port type values are object references and follow specific rules for this kind of values.
// @id: TTCN3-CORE-6.2.9-029a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_09_test_026 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    function f_send() runs on C {
        p.send(1);
        p.send(2);
    }

    function f_receive(P p_port, integer p_expected) return boolean {
        timer T_guard := 1.0;
        var boolean v_ok := false;
        T_guard.start;
        alt {
            [] p_port.receive(p_expected) {
                v_ok := true;
            }
            [] T_guard.timeout {}
        }
        return v_ok;
    }

    testcase TC() runs on C {
        var P v_copy := p;
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_send());
        if (f_receive(v_copy, 1) and f_receive(p, 2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
