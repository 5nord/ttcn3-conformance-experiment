// @requirement: 6.2.1.1 -- At the end of the expansion, the value at the right hand side of the assignment shall be assigned to the referenced subfield.
// @id: TTCN3-CORE-6.2.1.1-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_01_test_014 {

    type component C {}

    type record MyType4 {
        integer field1 optional,
        record {
            integer subfield1,
            integer subfield2
        } field2 optional
    }

    testcase TC() runs on C {
        var MyType4 v_rec;
        v_rec.field2.subfield1 := 5;
        if (v_rec.field2.subfield1 == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
