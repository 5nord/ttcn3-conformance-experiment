// @requirement: 6.2.13.2 -- For partial (i.e. incomplete) values, all following rules on templates apply.
// @id: TTCN3-CORE-6.2.13.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_13_02_list_subtyping_of_structured_types_and_anytype_007 {

    type record R {
        integer f1 optional,
        charstring f2,
        charstring f3
    }

    type R R_Sub ({ f2 := "user", f3 := pattern "password|Password" }, { f1 := (1..10), f2 := "User" });

    type component C {}

    testcase TC() runs on C {
        var R_Sub v_1 := { f1 := omit, f2 := "user", f3 := "Password" };
        var R_Sub v_2 := { f1 := 5, f2 := "user", f3 := "password" };
        var R_Sub v_3 := { f1 := 10, f2 := "User", f3 := "anything" };
        if (not ispresent(v_1.f1) and v_2.f1 == 5 and v_3.f3 == "anything") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
