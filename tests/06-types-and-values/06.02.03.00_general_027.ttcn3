// @requirement: 6.2.3.0 -- When referencing an element of an uninitialized record of or set of value or field or omitted field (including omitting a field at a higher level of the embedding hierarchy) on the left-hand side of an assignment, the reference shall recursively be expanded up to and including the depth of the referenced element as follows:
// @id: TTCN3-CORE-6.2.3.0-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_general_027 {

    type record of integer MyRecordOf;
    type record of MyRecordOf RoRoI;

    type component C {}

    testcase TC() runs on C {
        var RoRoI v_recof;
        v_recof[1][2] := 0;
        if (not isbound(v_recof[0]) and isbound(v_recof[1]) and not isbound(v_recof[1][0])
            and not isbound(v_recof[1][1]) and v_recof[1][2] == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
