// @requirement: 6.3.3 -- If the type of the system is unknown in the calling function, this can lead to runtime errors if the component type "A" is not system-compatible with the type of the system the current test case was started on.
// @id: TTCN3-CORE-6.3.3-007a
// @verdict: pass accept, ttcn3verdict:error
module M_06_03_03_test_006 {

    type port P message {
        inout integer;
    }

    type component C {}
    type component CA {
        port P p;
    }
    type component CX {
        port P q;
    }

    function f_needsSystem() system CA {
        setverdict(pass);
    }

    function f_unknownSystem() {
        f_needsSystem(); // system type unknown here, system is of incompatible type CX
    }

    testcase TC() runs on C system CX {
        f_unknownSystem();
    }

    control {
        execute(TC());
    }
}
