// @requirement: 6.2.0 -- The type keyword is also used to specify structured types such as record types, record `of types, set types, set` of types, enumerated types, union types and map types.
// @id: TTCN3-CORE-6.2.0-001a
// @verdict: pass accept, noexecution
module M_06_02_00_test_001 {

    type record MyRecord { integer f1, boolean f2 }
    type record of integer MyRecordOf;
    type set MySet { integer f1, boolean f2 }
    type set of integer MySetOf;
    type enumerated MyEnum { e_red, e_green }
    type union MyUnion { integer ch1, boolean ch2 }
    type map from charstring to integer MyMap;

}
