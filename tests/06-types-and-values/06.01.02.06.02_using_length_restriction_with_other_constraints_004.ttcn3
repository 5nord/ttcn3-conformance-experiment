// @requirement: 6.1.2.6.2 -- The length restriction takes effect jointly with other subtyping mechanisms (i.e. the value set of the type consists of the common subset of the value sets identified by the list, range or pattern subtyping and the length restriction).
// @id: TTCN3-CORE-6.1.2.6.2-004a
// @verdict: pass accept, ttcn3verdict:error
module M_06_01_02_06_02_using_length_restriction_with_other_constraints_004 {

    type charstring MyCharStr6 ("a" .. "z") length (3 .. 9);

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abc";
        var MyCharStr6 v_s := v_in;
        if (v_s == "abc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        v_in := "ab";
        v_s := v_in; // "ab" satisfies the range but not the length restriction: error
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
