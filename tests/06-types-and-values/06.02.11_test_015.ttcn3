// @requirement: 6.2.11 -- For components, the effect of an array is achieved by using an array of component references and assigning the relevant array element to the result of the create operation.
// @id: TTCN3-CORE-6.2.11-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_11_test_015 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    function f_send(integer p_i) runs on C {
        p.send(p_i);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptcs[3];
        var integer v_i;
        var integer v_sum := 0;
        var integer v_val;
        for (v_i := 0; v_i < 3; v_i := v_i + 1) {
            v_ptcs[v_i] := C.create;
            connect(self:p, v_ptcs[v_i]:p);
            v_ptcs[v_i].start(f_send(v_i + 1));
        }
        T.start;
        for (v_i := 0; v_i < 3; v_i := v_i + 1) {
            alt {
                [] p.receive(integer:?) -> value v_val { v_sum := v_sum + v_val; }
                [] T.timeout { setverdict(fail); }
            }
        }
        all component.done;
        if (v_sum == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
