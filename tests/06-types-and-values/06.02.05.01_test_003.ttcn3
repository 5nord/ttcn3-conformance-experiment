// @requirement: 6.2.5.1 -- AlternativeId shall resolve to the name of an alternative in the union type or in case of an anytype value or template AlternativeId shall resolve to a known type name or a known type name qualified with a module name.
// @id: TTCN3-CORE-6.2.5.1-002a
// @verdict: pass reject
module M_06_02_05_01_test_003 {

    type union U {
        integer choice1,
        charstring choice2
    }

    type component C {}

    testcase TC() runs on C {
        var U v_u := { choice1 := 1 };
        var integer v_i := v_u.choice3; // error: choice3 is not an alternative of U
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
