// @requirement: 6.2.15.3 -- To remove a mapping from a key to its associated value in a variable of a map type, the unmap statement may be used.
// @id: TTCN3-CORE-6.2.15.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_03_unmapping_keys_002 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var MyMap v_map := { ["a"] := 1, ["b"] := 2 };
        unmap(v_map, "a");
        if (lengthof(v_map) == 1 and not isbound(v_map["a"]) and v_map["b"] == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
