// @requirement: 6.2.11 -- It is the result of a create operation (see clause 21.2.1).
// @id: TTCN3-CORE-6.2.11-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_11_component_references_003 {

    type component C {
    }

    function f_check(C p_expected) runs on C {
        if (self == p_expected) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var C v_ptc := null;
        v_ptc := C.create;
        if (v_ptc == null) {
            setverdict(fail);
        }
        v_ptc.start(f_check(v_ptc));
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
