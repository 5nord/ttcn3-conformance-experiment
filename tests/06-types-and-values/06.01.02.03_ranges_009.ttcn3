// @requirement: 6.1.2.3 -- Using the special value -infinity as the lower bound shall indicate that the allowed numerical values are not restricted downward and the special value -infinity is also included.
// @id: TTCN3-CORE-6.1.2.3-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_03_ranges_009 {

    type float MyLessThanZero (-infinity .. 0.0);

    type component C {}

    testcase TC() runs on C {
        var MyLessThanZero v_large := -1.0E300;
        var MyLessThanZero v_inf := -infinity;
        if (v_large == -1.0E300 and v_inf == -infinity) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
