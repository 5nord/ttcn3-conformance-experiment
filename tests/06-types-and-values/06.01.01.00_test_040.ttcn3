// @requirement: 6.1.1.0 -- In the USI-like notation, the leading zeroes can be omitted, (i.e. char(U171)is equal to char(U0171)).
// @id: TTCN3-CORE-6.1.1.0-050a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_test_040 {

    type component C {}

    testcase TC() runs on C {
        if (char(U171) == char(U0171) and char(U41) == char(U00000041)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
