// @requirement: 6.1.1.0 -- By default, universal charstring shall conform to the UTF-32 encoding specified in clause 9.3 of ISO/IEC 10646 [2].
// @id: TTCN3-CORE-6.1.1.0-053a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_test_042 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_u := char(U10FFFF, U10000);
        if (lengthof(v_u) == 2 and unichar2int(v_u[0]) == 1114111 and unichar2int(v_u[1]) == 65536 and
            lengthof(unichar2oct(v_u[0], "UTF-32")) == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
