// @requirement: 6.2.4 -- The identifiers of enumerated values shall be unique within the enumerated type (but do not have to be globally unique) and are consequently visible in the context of the given type only.
// @id: TTCN3-CORE-6.2.4-008b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_04_test_008 {

    type component C {}

    type enumerated E1 { e_a, e_b };
    type enumerated E2 { e_c, e_b };

    testcase TC() runs on C {
        var E1 v_e1 := e_b;
        var E2 v_e2 := e_b;
        if (enum2int(v_e1) == 1 and enum2int(v_e2) == 1 and v_e1 == e_b and v_e2 == e_b) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
