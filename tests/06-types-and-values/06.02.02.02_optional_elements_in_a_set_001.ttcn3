// @requirement: 6.2.2.2 -- Optional elements in a set shall be specified using the optional keyword.
// @id: TTCN3-CORE-6.2.2.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_02_02_optional_elements_in_a_set_001 {

    type set MySet {
        integer field1,
        charstring field2 optional
    }

    type component C {}

    testcase TC() runs on C {
        var MySet v_set := { field1 := 1, field2 := omit };
        if (not ispresent(v_set.field2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
