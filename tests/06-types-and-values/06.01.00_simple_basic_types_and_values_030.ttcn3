// @requirement: 6.1.0 -- Class of type: Array notation; Keyword: []; Subtype: list (see note)
// @id: TTCN3-CORE-6.1.0-030b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_simple_basic_types_and_values_030 {

    type integer MyArray[2];

    type MyArray MyArrayList ({ 1, 2 }, { 3, 4 });

    type component C {}

    testcase TC() runs on C {
        var MyArrayList v_arr := { 3, 4 };
        if (v_arr[1] == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
