// @requirement: 6.2.5.0 -- Therefore, the assignment notation does not have to be used to denote a value of the union type if the union's default alternative is to be chosen.
// @id: TTCN3-CORE-6.2.5.0-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_05_00_test_012 {

    type component C {}

    type union U {
        @default integer number,
        charstring string
    };

    testcase TC() runs on C {
        var U v_u := { string := "abc" };
        v_u := 34;
        if (ischosen(v_u.number) and v_u.number == 34) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
