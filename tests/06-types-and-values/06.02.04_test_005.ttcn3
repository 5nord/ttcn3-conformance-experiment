// @requirement: 6.2.4 -- The unqualified form uses only the identifier of the enumerated value.
// @id: TTCN3-CORE-6.2.4-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_04_test_005 {

    type component C {}

    type enumerated E { e_a, e_b };

    testcase TC() runs on C {
        var E v_e := e_b;
        if (v_e == e_b and enum2int(v_e) == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
