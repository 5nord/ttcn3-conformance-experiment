// @requirement: 6.2.3.0 -- These records and sets do not have element identifiers and can be considered similar to an ordered array and an unordered collection respectively.
// @id: TTCN3-CORE-6.2.3.0-003a
// @verdict: pass reject
module M_06_02_03_00_test_003 {

    type record of integer MyRecordOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro := { field1 := 1 }; // error: record of elements have no identifiers
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
