// @requirement: 6.2.7 -- Array elements are accessed by means of the index notation ([]), which shall specify a valid index within the array's range.
// @id: TTCN3-CORE-6.2.7-008b
// @verdict: pass reject
module M_06_02_07_arrays_008 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a[3];
        v_a[4] := 12; // error: index shall be between 0 and 2
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
