// @requirement: 6.2.15.5 -- Since the length of the map value is equal to the number of key value pairs in the map value and there is precisely one key per value, the length of the set of keys is equal to the length of the map value.
// @id: TTCN3-CORE-6.2.15.5-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_05_accessing_the_keys_of_a_map_009 {

    type map from charstring to integer MapType;

    type component C {}

    testcase TC() runs on C {
        var MapType v_map := { ["a"] := 1, ["b"] := 1, ["c"] := 2 };
        if (lengthof(v_map.from) == lengthof(v_map) and lengthof(v_map) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
