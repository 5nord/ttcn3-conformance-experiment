// @requirement: 6.2.2.0 -- NOTE: When the value list notation is used for values of set types, the values are assigned to the fields in the sequential order of the fields in the type definition.
// @id: TTCN3-CORE-6.2.2.0-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_02_00_general_005 {

    type component C {}

    type set S {
        integer f1,
        integer f2,
        charstring f3
    }

    testcase TC() runs on C {
        var S v_s := { 1, 2, "a" };
        if (v_s.f1 == 1 and v_s.f2 == 2 and v_s.f3 == "a") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
