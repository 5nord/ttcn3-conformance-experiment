// @requirement: 6.2.3.0 -- In particular, when specifying partial values (i.e. setting the value of only a subset of the fields) using the assignment notation, for example, at initialization, only the elements to be assigned values shall be specified: elements not mentioned are implicitly left uninitialized.
// @id: TTCN3-CORE-6.2.3.0-009b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_general_008 {

    type record of integer MyRecordOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro := { [0] := 1, [2] := 3 };
        if (isbound(v_ro[0]) and not isbound(v_ro[1]) and isbound(v_ro[2])) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
