// @requirement: 6.2.12 -- The global address type may be used if only one type is needed.
// @id: TTCN3-CORE-6.2.12-002a
// @verdict: pass accept, noexecution
module M_06_02_12_test_001 {

    type integer address;

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C system C {
        var address v_addr := 1;
        map(mtc:p, system:p);
        p.send(integer:5) to v_addr;
        p.receive(integer:?) from v_addr;
        setverdict(pass);
    }
}
