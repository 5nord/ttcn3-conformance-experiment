// @requirement: 6.1.2.4 -- TTCN-3 permits the specification of length restrictions on string types.
// @id: TTCN3-CORE-6.1.2.4-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_04_test_001 {

    type bitstring MyByte length(8);
    type hexstring MyHex length(2 .. 4);
    type octetstring MyOct length(1 .. 2);
    type charstring MyStr length(3);
    type universal charstring MyUStr length(0 .. 5);

    type component C {}

    testcase TC() runs on C {
        var MyByte v_b := '00001111'B;
        var MyHex v_h := 'ABC'H;
        var MyOct v_o := 'AB'O;
        var MyStr v_s := "abc";
        var MyUStr v_u := "xy";
        if (lengthof(v_b) == 8 and lengthof(v_h) == 3 and lengthof(v_o) == 1
            and lengthof(v_s) == 3 and lengthof(v_u) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
