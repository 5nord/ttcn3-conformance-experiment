// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_test_006 {

    type set of integer MySetOf;

    type component C {}

    testcase TC() runs on C {
        var MySetOf v_so := { 1, 2, 3, 4 };
        v_so := { [2] := 9 };
        if (lengthof(v_so) == 4 and v_so[0] == 1 and v_so[1] == 2 and v_so[2] == 9 and v_so[3] == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
