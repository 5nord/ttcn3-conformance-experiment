// @requirement: 6.5 -- m) List of templates with two or more items and complemented list of templates where all templates have a common type shall provide automatic type that is equal to the common type.
// @id: TTCN3-CORE-6.5-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_automatic_type_028 {
    type component C {}

    function f_check(inout template integer p_t) return boolean {
        return match(2, p_t);
    }

    testcase TC() runs on C {
        var template v_list := (1, 2, 3);
        var template v_compl := complement(1, 3);
        if (f_check(v_list) and f_check(v_compl) and not match(4, v_list)
            and not match(1, v_compl)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
