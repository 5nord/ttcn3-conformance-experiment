// @requirement: 6.2.15.2 -- When using the indexed assignment notation on the right hand side of an assignment, elements for keys to be changed are identified explicitly and either a value or the not used symbol "-" can be assigned to them.
// @id: TTCN3-CORE-6.2.15.2-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_02_indexed_assignment_notation_007 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var MyMap v_map := { ["a"] := 1, ["b"] := 2 };
        v_map := { ["b"] := 20, ["a"] := 10 };
        if (v_map["a"] == 10 and v_map["b"] == 20) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
