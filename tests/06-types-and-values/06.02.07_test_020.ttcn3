// @requirement: 6.2.7 -- Values may be assigned individually by a value list notation or index notation or more than one or all at once by a value list notation or index assignment notation.
// @id: TTCN3-CORE-6.2.7-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_07_test_020 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a1[4];
        var integer v_a2[4];
        var integer v_a3[4];
        v_a1[0] := 10;
        v_a1[1] := 20;
        v_a1[3] := 30;
        v_a2 := { 10, 20, -, 30 };
        v_a3 := { [0] := 10, [1] := 20, [3] := 30 };
        if (v_a1[0] == 10 and v_a1[3] == 30
            and v_a2[0] == 10 and v_a2[1] == 20 and v_a2[3] == 30 and not isbound(v_a2[2])
            and v_a3[0] == 10 and v_a3[1] == 20 and v_a3[3] == 30 and not isbound(v_a3[2])) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
