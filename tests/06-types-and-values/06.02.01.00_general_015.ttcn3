// @requirement: 6.2.1.0 -- When re-assigning a previously initialized value, using the not used symbol or just skipping a field in an assignment notation, will cause that field to remain unchanged.
// @id: TTCN3-CORE-6.2.1.0-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_general_015 {

    type record MyRecordType {
        bitstring field1,
        boolean field2 optional,
        charstring field3
    }

    type component C {}

    testcase TC() runs on C {
        var MyRecordType v_r := { field1 := '111'B, field2 := false, field3 := "A string" };
        v_r := { field1 := '10111'B, field2 := - };
        if (v_r.field1 == '10111'B and v_r.field2 == false and v_r.field3 == "A string") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
