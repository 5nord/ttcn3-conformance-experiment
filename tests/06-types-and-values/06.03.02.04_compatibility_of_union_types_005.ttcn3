// @requirement: 6.3.2.4 -- The second rule shall only be used to check compatibility, when - using the first rule - no compatibility has been determined.
// @id: TTCN3-CORE-6.3.2.4-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_02_04_compatibility_of_union_types_005 {

    type component C {}

    type union UC { integer i }
    type union UA { integer i, charstring d }
    type union US { @default UC d, boolean b }

    testcase TC() runs on C {
        var US v_s := { d := { i := 1 } };
        var UA v_a := v_s;
        if (ischosen(v_a.i) and v_a.i == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
