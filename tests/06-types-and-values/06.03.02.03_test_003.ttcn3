// @requirement: 6.3.2.3 -- For set types the same compatibility rules shall apply as to record types and for set `of types the same` compatibility rules shall apply as to record `of types.`
// @id: TTCN3-CORE-6.3.2.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_02_03_test_003 {

    type component C {}

    type set FType {
        integer a optional,
        integer b optional,
        boolean c
    }
    type set GType {
        integer d optional,
        integer e optional,
        boolean f
    }

    testcase TC() runs on C {
        var FType v_myVarF := { a := 1, c := false };
        var GType v_myVarG := { f := true, d := 7 };
        v_myVarF := v_myVarG;
        if (v_myVarF.a == 7 and not ispresent(v_myVarF.b) and v_myVarF.c == true) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
