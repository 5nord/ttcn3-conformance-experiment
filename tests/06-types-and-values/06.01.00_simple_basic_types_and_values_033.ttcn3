// @requirement: 6.1.0 -- NOTE 1: In contrast to the general definition of float values, the mantissa of in theTTCN-3 value notation, beside integers, allows decimal numbers as well.
// @id: TTCN3-CORE-6.1.0-034a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_simple_basic_types_and_values_033 {

    type component C {}

    testcase TC() runs on C {
        var float v_f := 1.5E2;
        if (v_f == 150.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
