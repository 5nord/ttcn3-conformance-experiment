// @requirement: 6.2.5.0 -- At most one of the union alternatives can be declared as the default alternative by using the @default modifier before the type of the alternative.
// @id: TTCN3-CORE-6.2.5.0-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_05_00_test_009 {

    type component C {}

    type union U {
        @default integer number,
        charstring string
    };

    testcase TC() runs on C {
        var U v_u := 34;
        if (ischosen(v_u.number) and v_u.number == 34) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
