// @requirement: 6.3.2.2 -- Two array types are compatible if their corresponding `record of` types are compatible.
// @id: TTCN3-CORE-6.3.2.2-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_02_02_compatibility_of_record_and_record_of_types_005 {

    type component C {}

    type integer IntArray[3];
    type integer SmallInt(0..10);
    type SmallInt SmallIntArray[3];

    testcase TC() runs on C {
        var IntArray v_a := { 1, 2, 3 };
        var SmallIntArray v_b := { 0, 0, 0 };
        v_b := v_a;
        v_a := v_b;
        if (v_b[0] == 1 and v_b[1] == 2 and v_b[2] == 3 and v_a[2] == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
