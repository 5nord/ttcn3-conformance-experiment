// @requirement: 6.2.7 -- Sending an array value with undefined elements shall cause an error.
// @id: TTCN3-CORE-6.2.7-029a
// @verdict: pass accept, ttcn3verdict:error
module M_06_02_07_arrays_027 {

    type integer MyArray[3];

    type port P message {
        inout MyArray
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var MyArray v_a;
        v_a[0] := 1;
        v_a[2] := 3;
        connect(mtc:p, mtc:p);
        setverdict(pass);
        p.send(v_a); // error: element 1 is undefined
    }

    control {
        execute(TC());
    }
}
