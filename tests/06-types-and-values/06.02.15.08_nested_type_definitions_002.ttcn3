// @requirement: 6.2.15.8 -- The usage of structured types (record, set, enumerated, set `of, record` `of, union and map) is allowed.`
// @id: TTCN3-CORE-6.2.15.8-002a
// @verdict: pass accept, noexecution
module M_06_02_15_08_nested_type_definitions_002 {

    type map from charstring to record { integer f1, boolean f2 } RecordMap;
    type map from charstring to set { integer f1, boolean f2 } SetMap;
    type map from charstring to enumerated { e_red, e_green } EnumMap;
    type map from charstring to set of integer SetOfMap;
    type map from charstring to record of integer RecordOfMap;
    type map from charstring to union { integer a1, charstring a2 } UnionMap;
    type map from charstring to map from integer to integer MapMap;
}
