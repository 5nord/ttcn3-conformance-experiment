// @requirement: 6.3.7 -- For variables, constants and parameters of timer types, the reference to a timer is compatible with any other timer reference.
// @id: TTCN3-CORE-6.3.7-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_07_type_compatibility_of_timer_types_001 {
    type component C {
        timer T_comp := 0.1;
    }

    function f_wait(timer p_t) {
        p_t.start(0.1);
        p_t.timeout;
    }

    testcase TC() runs on C {
        timer T_local;
        f_wait(T_local);
        f_wait(T_comp);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
