// @requirement: 6.3.2.7 -- Values of all existing TTCN-3 types are compatible with the open type occurring in the left hand side of an assignment.
// @id: TTCN3-CORE-6.3.2.7-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_02_07_compatibility_of_the_open_type_001 {

    type component C {}

    type record R { integer f1, boolean f2 }
    type enumerated E { e_a, e_b }

    testcase TC() runs on C {
        var integer v_int := 5;
        var R v_rec := { 1, true };
        var E v_enum := e_b;
        var universal charstring v_s1 := any2unistr(v_int);
        var universal charstring v_s2 := any2unistr(v_rec);
        var universal charstring v_s3 := any2unistr(v_enum);
        var universal charstring v_s4 := any2unistr("abc");
        if (v_s1 == "5" and lengthof(v_s2) > 0 and lengthof(v_s3) > 0 and lengthof(v_s4) > 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
