// @requirement: 6.2.12 -- Explicit SUT addresses for a globally defined address type shall only be generated inside a TTCN-3 module if the type is defined inside the module itself.
// @id: TTCN3-CORE-6.2.12-012a
// @verdict: pass reject
module M_06_02_12_test_009 {

    import from M_06_02_12_test_009_A all;

    type component C {}

    testcase TC() runs on C {
        var address v_addr := 1; // error: explicit address generated outside the module defining address
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}

module M_06_02_12_test_009_A {

    type integer address;
}
