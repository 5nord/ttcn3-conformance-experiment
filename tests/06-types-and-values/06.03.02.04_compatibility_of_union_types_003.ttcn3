// @requirement: 6.3.2.4 -- A value "a" of an arbitrary type "A" is compatible with a **union type "B" with a default alternative of type "C" if value "a" is compatible to "C".**
// @id: TTCN3-CORE-6.3.2.4-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_02_04_compatibility_of_union_types_003 {

    type component C {}

    type union U3 { @default integer i, boolean b }

    testcase TC() runs on C {
        var integer v_int := 3;
        var U3 v_u3 := v_int;
        if (ischosen(v_u3.i) and v_u3.i == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
