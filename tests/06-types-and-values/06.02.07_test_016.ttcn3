// @requirement: 6.2.7 -- Such an array is corresponding to a record of with a fixed length restriction computed as the difference between upper and lower index bound plus 1 and indexing starting from the lower bound of the array definition.
// @id: TTCN3-CORE-6.2.7-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_07_test_016 {

    type integer MyArrayType[2 .. 5];
    type record length (4) of integer MyRecordOfType;

    type component C {}

    testcase TC() runs on C {
        var MyArrayType v_a := { 10, 20, 30, 40 };
        var MyRecordOfType v_r := v_a;
        var MyArrayType v_b := v_r;
        if (lengthof(v_r) == 4 and v_r[0] == v_a[2] and v_r[3] == v_a[5] and v_b[2] == 10) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
