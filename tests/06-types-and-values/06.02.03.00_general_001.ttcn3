// @requirement: 6.2.3.0 -- TTCN-3 supports the specification of records and sets whose elements are all of the same type.
// @id: TTCN3-CORE-6.2.3.0-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_general_001 {

    type record of integer MyRecordOf;
    type set of charstring MySetOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro := { 1, 2, 3 };
        var MySetOf v_so := { "a", "b" };
        if (v_ro[2] == 3 and lengthof(v_so) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
