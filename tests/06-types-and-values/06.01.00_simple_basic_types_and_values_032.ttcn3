// @requirement: 6.1.0 -- by two numbers separated by E where the first number specifies the mantissa and the second specifies the exponent, for example 12.3E4 (which represents 123 × 10[3]) or -12.3E-4 (which represents -123 × 10[-5]).
// @id: TTCN3-CORE-6.1.0-033a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_simple_basic_types_and_values_032 {

    type component C {}

    testcase TC() runs on C {
        var float v_f1 := 12.3E4;
        var float v_f2 := -12.3E-4;
        if (v_f1 == 123000.0 and v_f2 == -0.00123) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
