// @requirement: 6.1.2.3 -- If exclusive bounds (!infinity or !-infinity) is used instead, only the respective numerical float values are included in the range.
// @id: TTCN3-CORE-6.1.2.3-010a
// @verdict: pass reject
module M_06_01_02_03_ranges_013 {

    type float MyNumericalLessThanZero (!-infinity .. 0.0);

    const MyNumericalLessThanZero c_value := -1.0E300;
    const MyNumericalLessThanZero c_inf := -infinity; // error: -infinity excluded by the exclusive bound
}
