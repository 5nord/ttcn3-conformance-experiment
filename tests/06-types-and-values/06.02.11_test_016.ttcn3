// @requirement: 6.2.11 -- a) The only operations allowed on component references are assignment, equality and non-equality.
// @id: TTCN3-CORE-6.2.11-016a
// @verdict: pass reject
module M_06_02_11_test_016 {

    type component C {
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        if (v_ptc1 < v_ptc2) { // error: relational operator other than == and != on component references
            setverdict(pass);
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
