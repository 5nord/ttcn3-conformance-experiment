// @requirement: 6.2.6 -- The special type anytype is defined as a shorthand for the union of all known data types and the address type in a TTCN-3 module.
// @id: TTCN3-CORE-6.2.6-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_06_the_anytype_001 {

    type record MyRecord {
        integer f1
    }

    type integer address;

    type component C {}

    testcase TC() runs on C {
        var anytype v_a1, v_a2, v_a3, v_a4;
        v_a1.integer := 34;
        v_a2 := { charstring := "abc" };
        v_a3.MyRecord := { f1 := 1 };
        v_a4.address := 5;
        if (ischosen(v_a1.integer) and v_a1.integer == 34
            and ischosen(v_a2.charstring) and v_a3.MyRecord.f1 == 1
            and ischosen(v_a4.address)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
