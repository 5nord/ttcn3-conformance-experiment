// @requirement: 6.2.3.0 -- The index of the first element shall be zero and the index value shall not exceed the limitation placed by length subtyping.
// @id: TTCN3-CORE-6.2.3.0-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_test_020 {

    type record of integer MyRecordOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro := { 7, 8 };
        if (v_ro[0] == 7 and v_ro[1] == 8) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
