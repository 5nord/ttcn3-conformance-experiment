// @requirement: 6.2.1.2 -- Optional elements in a record shall be specified using the optional keyword.
// @id: TTCN3-CORE-6.2.1.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_02_optional_elements_in_a_record_001 {

    type component C {}

    type record R {
        integer f1,
        integer f2 optional
    }

    testcase TC() runs on C {
        var R v_r := { f1 := 1, f2 := omit };
        if (not ispresent(v_r.f2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
