// @requirement: 6.2.1.0 -- When using the value list notation, all fields listed in the notation shall be specified either with a value, the not used symbol "-" or the omit keyword.
// @id: TTCN3-CORE-6.2.1.0-034a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_test_023 {

    type component C {}

    type record R {
        integer f1,
        integer f2 optional,
        charstring f3
    }

    testcase TC() runs on C {
        var R v_r := { 1, omit, "a" };
        v_r := { 2, -, "b" };
        if (v_r == { f1 := 2, f2 := omit, f3 := "b" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
