// @requirement: 6.2.1.4 -- A field defined with a type reference but no explicit field name is called an embedded field.
// @id: TTCN3-CORE-6.2.1.4-001a
// @verdict: pass accept, noexecution
module M_06_02_01_04_test_001 {

    type record Point {
        integer x,
        integer y
    }

    type record Pixel {
        Point,
        charstring color
    }
}
