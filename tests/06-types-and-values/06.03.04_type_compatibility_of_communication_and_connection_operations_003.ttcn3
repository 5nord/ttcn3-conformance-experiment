// @requirement: 6.3.4 -- The types of values or templates directly used as parameters of the operations send, receive and trigger shall also be explicitly defined in the associated port type definition.
// @id: TTCN3-CORE-6.3.4-002a
// @verdict: pass reject
module M_06_03_04_type_compatibility_of_communication_and_connection_operations_003 {
    type record R1 { integer f }
    type record R2 { integer f }
    type port P message { inout R1 }
    type component C { port P p }

    const R2 c_r2 := { f := 1 };

    testcase TC() runs on C {
        connect(mtc:p, mtc:p);
        p.send(c_r2); // error: R2 is not listed in port type P
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
