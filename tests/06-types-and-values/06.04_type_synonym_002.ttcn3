// @requirement: 6.4 -- Type synonyms can be defined for all kinds of types.
// @id: TTCN3-CORE-6.4-002a
// @verdict: pass accept, noexecution
module M_06_04_type_synonym_002 {
    type integer IntAlias;
    type float FloatAlias;
    type boolean BoolAlias;
    type verdicttype VerdictAlias;
    type bitstring BitAlias;
    type hexstring HexAlias;
    type octetstring OctAlias;
    type charstring CharAlias;
    type universal charstring UCharAlias;
    type default DefaultAlias;
    type anytype AnyAlias;
    type record R { integer f }
    type R RAlias;
    type record of integer RoI;
    type RoI RoIAlias;
    type set S { integer f }
    type S SAlias;
    type set of integer SoI;
    type SoI SoIAlias;
    type union U { integer i }
    type U UAlias;
    type enumerated E { e_a, e_b }
    type E EAlias;
    type map from charstring to integer Mp;
    type Mp MpAlias;
    type port P message { inout integer }
    type P PAlias;
    signature Sig(in integer p_x);
    type Sig SigAlias;
    type component C {}
    type C CAlias;
}
