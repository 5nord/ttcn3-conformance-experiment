// @requirement: 6.3.2.4 -- NOTE 2: When a union with a default alternative is used in an expression it will be resolved to its long notation, before the expression is evaluated.
// @id: TTCN3-CORE-6.3.2.4-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_02_04_compatibility_of_union_types_008 {

    type component C {}

    type union U3 { @default integer i, boolean b }

    testcase TC() runs on C {
        var U3 v_u3 := { i := 3 };
        var integer v_int := v_u3 * 2;
        if (v_int == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
