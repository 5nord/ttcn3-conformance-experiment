// @requirement: 6.2.7 -- Array elements are accessed by means of the index notation ([]), which shall specify a valid index within the array's range.
// @id: TTCN3-CORE-6.2.7-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_07_test_007 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a[3] := { 7, 8, 9 };
        v_a[1] := 5;
        if (v_a[0] == 7 and v_a[1] == 5 and v_a[2] == 9) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
