// @requirement: 6.1.1.0 -- NOTE 2: The predefined conversion function is able to return single-character-length values only.
// @id: TTCN3-CORE-6.1.1.0-030a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_general_022 {

    type component C {}

    testcase TC() runs on C {
        if (lengthof(int2char(0)) == 1 and lengthof(int2char(97)) == 1 and
            lengthof(int2char(127)) == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
