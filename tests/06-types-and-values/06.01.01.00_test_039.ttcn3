// @requirement: 6.1.1.0 -- The hexadecimal digits represent the numeric code point of the character.
// @id: TTCN3-CORE-6.1.1.0-048a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_test_039 {

    type component C {}

    testcase TC() runs on C {
        if (unichar2int(char(U4E2D)) == 20013 and unichar2int(char(U41)) == 65 and
            unichar2int(char(U0171)) == 369) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
