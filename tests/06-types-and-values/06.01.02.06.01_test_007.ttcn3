// @requirement: 6.1.2.6.1 -- Type: character strings; Units of Length: characters
// @id: TTCN3-CORE-6.1.2.6.1-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_06_01_test_007 {

    type charstring MyStr length(3);
    type universal charstring MyUStr length(2);

    type component C {}

    testcase TC() runs on C {
        var MyStr v_s := "abc";
        var MyUStr v_u := char(0, 0, 1, 111) & char(0, 0, 1, 112);
        if (lengthof(v_s) == 3 and lengthof(v_u) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
