// @requirement: 6.1.1.1 -- The index shall be between zero and the length of the string minus one for retrieving an element from a string.
// @id: TTCN3-CORE-6.1.1.1-007a
// @verdict: pass reject
module M_06_01_01_01_test_005 {

    type component C {}

    const charstring c_cs := "abc";

    testcase TC() runs on C {
        var charstring v_elem := c_cs[3]; // error: index equals the length of the string
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
