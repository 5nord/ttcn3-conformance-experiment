// @requirement: 6.1.0 -- Class of type: hexstring; Keyword: list, length
// @id: TTCN3-CORE-6.1.0-014b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_simple_basic_types_and_values_014 {

    type hexstring HexList ('A'H, 'B'H);

    type hexstring HexLength length(2);

    type component C {}

    testcase TC() runs on C {
        var HexList v_list := 'A'H;
        var HexLength v_len := 'AB'H;
        if (v_list == 'A'H and lengthof(v_len) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
