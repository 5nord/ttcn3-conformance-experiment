// @requirement: 6.2.4 -- This means that for any instantiation or value reference of an enumerated type, the given type shall be implicitly or explicitly identified.
// @id: TTCN3-CORE-6.2.4-009a
// @verdict: pass reject
module M_06_02_04_test_010 {

    type component C {}

    type enumerated E { e_a, e_b, e_c };

    testcase TC() runs on C {
        if (e_b == e_c) { // error: no type context for the enumerated values
            setverdict(fail);
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
