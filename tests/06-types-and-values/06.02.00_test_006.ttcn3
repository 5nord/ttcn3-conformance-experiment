// @requirement: 6.2.0 -- The assignment notation can also be used for union values.
// @id: TTCN3-CORE-6.2.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_00_test_006 {

    type union MyUnion { integer ch1, boolean ch2 }

    type component C {}

    testcase TC() runs on C {
        var MyUnion v_u := { ch2 := true };
        if (ischosen(v_u.ch2) and v_u.ch2 == true) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
