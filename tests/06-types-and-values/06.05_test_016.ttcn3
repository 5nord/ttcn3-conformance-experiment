// @requirement: 6.5 -- i) Value list where all values have a common type shall provide an automatic type record of _{common type}._ The common type shall fulfil requirements for automatic typing.
// @id: TTCN3-CORE-6.5-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_test_016 {
    type component C {}

    testcase TC() runs on C {
        var v_auto := { 1, 2, 3 };
        v_auto[3] := 4;
        var record of integer v_roi := v_auto;
        if (lengthof(v_auto) == 4 and v_auto[1] == 2 and v_roi == { 1, 2, 3, 4 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
