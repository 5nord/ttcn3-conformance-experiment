// @requirement: 6.2.9 -- Message-based ports shall be identified by the keyword message and procedure-based ports shall be identified by the keyword `procedure` within the associated port type definition.
// @id: TTCN3-CORE-6.2.9-004b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_09_communication_port_types_003 {

    signature S(in integer p_x) return integer;

    type port P procedure {
        inout S;
    }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{?});
        p.reply(S:{-} value 2);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{1}, 1.0) {
            [] p.getreply(S:{-} value 2) {
                setverdict(pass);
            }
            [] p.catch(timeout) {
                setverdict(fail);
            }
        }
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
