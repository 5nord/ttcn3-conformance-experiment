// @requirement: 6.2.1.0 -- When all remaining fields at the end of the type definition are optional and they are wished to be omitted by the implicit mechanism, either the not used symbol "-" can be used for some or all of them or they can simply be left out from the notation.
// @id: TTCN3-CORE-6.2.1.0-041a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_general_031 {

    type component C {}

    type record R {
        integer f1,
        integer f2 optional,
        integer f3 optional
    }

    const R c_x1 := { 1, -, - } with { optional "implicit omit" }
    const R c_x2 := { 1, - } with { optional "implicit omit" }
    const R c_x3 := { 1 } with { optional "implicit omit" }

    testcase TC() runs on C {
        if (c_x1 == { 1, omit, omit } and c_x2 == { 1, omit, omit } and c_x3 == { 1, omit, omit }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
