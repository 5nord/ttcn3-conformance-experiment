// @requirement: 6.2.5.1 -- b) Expansion of record, record of, set, set of, and array values and intermediate fields shall follow the rules of item a) in clauses 6.2.1.1 and 6.2.7, and clause 6.2.2.1 correspondingly.
// @id: TTCN3-CORE-6.2.5.1-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_05_01_referencing_fields_of_a_union_type_013 {

    type union U {
        integer choice1,
        charstring choice2
    }

    type record R {
        integer f1,
        U f2
    }

    type set S {
        integer f1,
        U f2
    }

    type record of U RoU;

    type set of U SoU;

    type U UArr[3];

    type component C {}

    testcase TC() runs on C {
        var R v_r;
        var S v_s;
        var RoU v_ro;
        var SoU v_so;
        var UArr v_arr;
        v_r.f2.choice1 := 1;
        v_s.f2.choice1 := 2;
        v_ro[2].choice1 := 3;
        v_so[1].choice1 := 4;
        v_arr[1].choice1 := 5;
        if (not isbound(v_r.f1) and v_r.f2.choice1 == 1
            and not isbound(v_s.f1) and v_s.f2.choice1 == 2
            and not isbound(v_ro[0]) and not isbound(v_ro[1]) and v_ro[2].choice1 == 3
            and not isbound(v_so[0]) and v_so[1].choice1 == 4
            and not isbound(v_arr[0]) and v_arr[1].choice1 == 5 and not isbound(v_arr[2])) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
