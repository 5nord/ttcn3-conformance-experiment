// @requirement: 6.3.2.7 -- Values of open type occurring on the right hand side of an assignment are compatible with a value "a" of a type "A", if the actual value contained in the open type value is compatible with "A".
// @id: TTCN3-CORE-6.3.2.7-002a
// @verdict: pass accept, noexecution
module M_06_03_02_07_test_002 {

    type record R { integer f1, boolean f2 }

    external function fx_getValue(out any p_data);

    function f_test() {
        var integer v_int;
        var R v_rec;
        fx_getValue(v_int);
        fx_getValue(v_rec);
    }
}
