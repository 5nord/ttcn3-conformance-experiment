// @requirement: 6.2.1.0 -- When using direct assignment notation in a scope where the optional attribute is set to "implicit omit", the uninitialized optional fields in the referenced value, shall implicitly be set to omit after the assignment in the new value, while mandatory fields shall remain unchanged (see also clause 27.7).
// @id: TTCN3-CORE-6.2.1.0-044a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_test_032 {

    type component C {}

    type record R {
        integer f1,
        integer f2 optional,
        integer f3
    }

    const R c_x3 := { f1 := 1, f3 := 2 }
    const R c_x4 := c_x3 with { optional "implicit omit" }

    testcase TC() runs on C {
        if (not ispresent(c_x4.f2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
