// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_05_00_test_013 {

    type component C {}

    type union U {
        @default integer number,
        charstring string
    };

    testcase TC() runs on C {
        var U v_u := { number := 34 };
        var integer v_i := v_u + 1;
        if (v_i == 35) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
