// @requirement: 6.1.2.2 -- TTCN-3 permits the specification of a list of subtypes as listed in table 3 for value lists.
// @id: TTCN3-CORE-6.1.2.2-001a
// @verdict: pass accept, noexecution
module M_06_01_02_02_lists_of_types_001 {

    type bitstring BitStrings1 ('0'B, '1'B);
    type bitstring BitStrings2 ('00'B, '01'B, '10'B);
    type bitstring BitStrings_1_2 (BitStrings1, BitStrings2);

    const BitStrings_1_2 c_value := '1'B;
}
