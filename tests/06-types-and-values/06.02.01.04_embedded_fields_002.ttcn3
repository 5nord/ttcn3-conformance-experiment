// @requirement: 6.2.1.4 -- The unqualified type name acts as the field name.
// @id: TTCN3-CORE-6.2.1.4-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_04_embedded_fields_002 {

    import from M_06_02_01_04_embedded_fields_002_A all;

    type component C {}

    type record Pixel {
        M_06_02_01_04_embedded_fields_002_A.Point,
        charstring color
    }

    testcase TC() runs on C {
        var Pixel v_p := { Point := { 4, 8 }, color := "red" };
        if (v_p.Point.x == 4 and v_p.Point.y == 8) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_06_02_01_04_embedded_fields_002_A {
    type record Point {
        integer x,
        integer y
    }
}
