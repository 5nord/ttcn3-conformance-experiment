// @requirement: 6.2.10.1 -- These instances can be used as the main test component, as the test system interface or as a parallel test component.
// @id: TTCN3-CORE-6.2.10.1-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_10_01_test_013 {

    type component C {
        var integer vc_i := 1;
    }

    function f_ptc() runs on C {
        if (vc_i == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc());
        v_ptc.done;
        f_ptc();
    }

    control {
        execute(TC());
    }
}
