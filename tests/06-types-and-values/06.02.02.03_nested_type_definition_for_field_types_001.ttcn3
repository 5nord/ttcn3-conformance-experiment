// @requirement: 6.2.2.3 -- TTCN-3 supports the definition of types for set fields nested within the set definition, similar to the mechanism for record types described in clause 6.2.1.3.
// @id: TTCN3-CORE-6.2.2.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_02_03_nested_type_definition_for_field_types_001 {

    type set MyNestedSet {
        set {
            integer nestedField1,
            float nestedField2
        } outerField1,
        enumerated { e_one, e_two } outerField2,
        record of boolean outerField3,
        integer outerField4 (1 .. 100)
    }

    type component C {}

    testcase TC() runs on C {
        var MyNestedSet v_set := {
            outerField1 := { nestedField1 := 1, nestedField2 := 2.0 },
            outerField2 := e_two,
            outerField3 := { true, false },
            outerField4 := 50
        };
        if (v_set.outerField1.nestedField1 == 1 and v_set.outerField2 == e_two
            and v_set.outerField3[1] == false and v_set.outerField4 == 50) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
