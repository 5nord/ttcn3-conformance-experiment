// @requirement: 6.2.1.0 -- In particular, when specifying partial values (i.e. setting the value of only a subset of the fields) using the assignment notation, at initialization, only the fields to be assigned values shall be specified.
// @id: TTCN3-CORE-6.2.1.0-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_test_013 {

    type record MyRecordType {
        bitstring field1,
        boolean field2 optional,
        charstring field3
    }

    type component C {}

    testcase TC() runs on C {
        var MyRecordType v_r := { field1 := '111'B, field3 := "A string" };
        if (v_r.field1 == '111'B and v_r.field3 == "A string") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
