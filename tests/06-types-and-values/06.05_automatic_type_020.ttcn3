// @requirement: 6.5 -- The names of record fields are equal to the field names from the notation and record field types are automatic types of the field values in the notation.
// @id: TTCN3-CORE-6.5-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_automatic_type_020 {
    type component C {}

    testcase TC() runs on C {
        var v_auto := { description := "description", val := 23 };
        v_auto.val := 24;
        if (v_auto.description == "description" and v_auto.val == 24) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
