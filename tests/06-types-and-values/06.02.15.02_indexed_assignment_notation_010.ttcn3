// @requirement: 6.2.15.2 -- Re-assigning a previously initialized value, using the not used symbol or just skipping a field or element in an assignment notation, will cause that field or element to remain unchanged.
// @id: TTCN3-CORE-6.2.15.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_02_indexed_assignment_notation_010 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var MyMap v_map := { ["a"] := 1, ["b"] := 2, ["c"] := 3 };
        v_map := { ["a"] := -, ["c"] := 30 };
        if (lengthof(v_map) == 3 and v_map["a"] == 1 and v_map["b"] == 2 and v_map["c"] == 30) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
