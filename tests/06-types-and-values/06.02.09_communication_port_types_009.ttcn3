// @requirement: 6.2.9 -- Directions shall be seen from the point of view of the test component owning the port with the exception of the test system interface, where directions shall be seen from the point of view of the test component port mapped to the test system interface port.
// @id: TTCN3-CORE-6.2.9-009b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_09_communication_port_types_009 {

    type port P_comp message {
        out integer;
    }

    type port P_tsi message {
        out integer;
    }

    type component C {
        port P_comp p;
    }

    type component S {
        port P_tsi p;
    }

    testcase TC() runs on C system S {
        map(self:p, system:p);
        p.send(1);
        unmap(self:p, system:p);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
