// @requirement: 6.2.3.0 -- b) Expansion of record, union and set values and intermediate fields shall follow the rules of item a) in clauses 6.2.1.1 and 6.2.5.1 and clause 6.2.2.1 correspondingly.
// @id: TTCN3-CORE-6.2.3.0-029a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_test_030 {

    type record MyRecord {
        integer a,
        integer b
    }

    type set MySet {
        integer a,
        integer b
    }

    type union MyUnion {
        integer i,
        charstring s
    }

    type record of MyRecord RoRec;
    type record of MySet RoSet;
    type record of MyUnion RoUnion;

    type component C {}

    testcase TC() runs on C {
        var RoRec v_rorec;
        var RoSet v_roset;
        var RoUnion v_rou;
        v_rorec[1].a := 1;
        v_roset[1].b := 2;
        v_rou[1].i := 3;
        if (v_rorec[1].a == 1 and not isbound(v_rorec[1].b) and not isbound(v_rorec[0])
            and v_roset[1].b == 2 and not isbound(v_roset[1].a) and not isbound(v_roset[0])
            and ischosen(v_rou[1].i) and v_rou[1].i == 3 and not isbound(v_rou[0])) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
