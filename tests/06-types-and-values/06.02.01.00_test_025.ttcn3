// @requirement: 6.2.1.0 -- Its result is that the given field is not present in the given value.
// @id: TTCN3-CORE-6.2.1.0-036a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_test_025 {

    type component C {}

    type record R {
        integer f1,
        integer f2 optional,
        integer f3
    }

    testcase TC() runs on C {
        var R v_r := { 1, 2, 3 };
        v_r := { 1, omit, 3 };
        if (not ispresent(v_r.f2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
