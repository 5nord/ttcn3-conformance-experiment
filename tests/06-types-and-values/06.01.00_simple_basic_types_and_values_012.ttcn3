// @requirement: 6.1.0 -- Class of type: verdicttype; Keyword: List
// @id: TTCN3-CORE-6.1.0-012b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_simple_basic_types_and_values_012 {

    type verdicttype PassOrFail (pass, fail);

    type component C {}

    testcase TC() runs on C {
        var PassOrFail v_verdict := pass;
        if (v_verdict == pass) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
