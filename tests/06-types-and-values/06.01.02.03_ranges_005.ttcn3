// @requirement: 6.1.2.3 -- In order to specify an infinite integer range, the keyword -infinity or infinity can be used instead of a value indicating that there is no lower or upper boundary; -infinity shall not be used as the upper bound and infinity shall not be used as the lower bound for integer ranges.
// @id: TTCN3-CORE-6.1.2.3-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_03_ranges_005 {

    type integer MyNegative (-infinity .. -1);
    type integer MyNonNegative (0 .. infinity);

    type component C {}

    testcase TC() runs on C {
        var MyNegative v_neg := -123456789012345;
        var MyNonNegative v_pos := 123456789012345;
        if (v_neg < 0 and v_pos > 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
