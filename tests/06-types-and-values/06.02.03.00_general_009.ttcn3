// @requirement: 6.2.3.0 -- It is also possible to leave fields explicitly unspecified using the not used symbol "-".
// @id: TTCN3-CORE-6.2.3.0-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_general_009 {

    type record of integer MyRecordOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro := { [0] := 1, [1] := -, [2] := 3 };
        if (isbound(v_ro[0]) and not isbound(v_ro[1]) and isbound(v_ro[2])) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
