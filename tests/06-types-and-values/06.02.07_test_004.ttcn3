// @requirement: 6.2.7 -- Array dimensions shall be specified using constant expressions, which shall evaluate to a positive integer values.
// @id: TTCN3-CORE-6.2.7-004a
// @verdict: pass reject
module M_06_02_07_test_004 {

    type component C {}

    testcase TC() runs on C {
        var integer v_size := 3;
        var integer v_a[v_size]; // error: array dimension is not a constant expression
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
