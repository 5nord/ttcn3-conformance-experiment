// @requirement: 6.1.2.3 -- If both the lower and upper bounds denote -infinity, no numerical values are included, only the special value -infinity.
// @id: TTCN3-CORE-6.1.2.3-007a
// @verdict: pass reject
module M_06_01_02_03_ranges_010 {

    type float MyMinusInfinity (-infinity .. -infinity);

    const MyMinusInfinity c_inf := -infinity;
    const MyMinusInfinity c_value := -1.0E300; // error: numerical value not included in the range
}
