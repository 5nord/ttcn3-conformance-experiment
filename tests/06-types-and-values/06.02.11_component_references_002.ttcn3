// @requirement: 6.2.11 -- A unique component reference is generated by the test system at the time when a component is created.
// @id: TTCN3-CORE-6.2.11-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_11_component_references_002 {

    type component C {
    }

    testcase TC() runs on C system C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        if (v_ptc1 != null and v_ptc2 != null and v_ptc1 != v_ptc2
            and v_ptc1 != mtc and v_ptc2 != mtc
            and v_ptc1 != system and v_ptc2 != system) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
