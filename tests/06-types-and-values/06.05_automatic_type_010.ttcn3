module M_06_05_automatic_type_010 {
    type component C {}

    testcase TC() runs on C {
        var v_autoI := 1;
        var v_autoF := 1.5;
        var v_autoB := true;
        var v_autoBs := '0010'B;
        var v_autoH := 'AB'H;
        var v_autoO := 'FF'O;
        var v_autoV := inconc;
        if (v_autoI == 1 and v_autoF == 1.5 and v_autoB and v_autoBs == '0010'B
            and v_autoH == 'AB'H and v_autoO == 'FF'O and v_autoV == inconc) {
            setverdict(pass);
        } else {
