// @requirement: 6.5 -- If the pattern contains only characters or references of the charstring type, the automatic type is charstring, otherwise it is universal charstring.
// @id: TTCN3-CORE-6.5-029a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_automatic_type_034 {
    type component C {}

    function f_check(inout template charstring p_t) return boolean {
        return match("abbc", p_t);
    }

    testcase TC() runs on C {
        var template v_auto := pattern "a*c";
        if (f_check(v_auto)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
