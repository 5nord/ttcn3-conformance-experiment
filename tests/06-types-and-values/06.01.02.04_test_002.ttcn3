// @requirement: 6.1.2.4 -- The length boundaries are based on different units depending on the string type with which they are used.
// @id: TTCN3-CORE-6.1.2.4-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_04_test_002 {

    type bitstring B2 length(2);
    type hexstring H2 length(2);
    type octetstring O2 length(2);
    type charstring C2 length(2);

    type component C {}

    testcase TC() runs on C {
        var B2 v_b := '10'B;
        var H2 v_h := 'AB'H;
        var O2 v_o := 'ABCD'O;
        var C2 v_c := "ab";
        if (lengthof(v_b) == 2 and lengthof(v_h) == 2 and lengthof(v_o) == 2
            and lengthof(v_c) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
