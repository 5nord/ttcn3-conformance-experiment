// @requirement: 6.3.4 -- var MyRec v_x; p.receive (MyRecAlias:?) -> value v_x; // shall not cause an error since storing the value requires no strong typing
// @id: TTCN3-CORE-6.3.4-007b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_04_test_007 {
    type record MyRec { integer f }
    type MyRec MyRecAlias;
    type port MyPort message { inout MyRec, MyRecAlias }
    type component C { port MyPort p }

    template MyRecAlias m_myRecAlias := { f := 1 };

    function f_send() runs on C {
        p.send(m_myRecAlias);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var MyRec v_x;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.receive(MyRecAlias:?) -> value v_x {
                if (v_x.f == 1) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
