// @requirement: 6.3.2.2 -- The value of each field in the value "b" is assigned to the corresponding field in the value of type "A".
// @id: TTCN3-CORE-6.3.2.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_02_02_test_002 {

    type component C {}

    type record BType {
        integer a optional,
        integer b optional,
        boolean c
    }
    type record CType {
        integer d optional,
        integer e optional,
        boolean f
    }

    testcase TC() runs on C {
        var BType v_myVarB := { omit, 2, true };
        var CType v_myVarC := { 3, omit, false };
        v_myVarC := v_myVarB;
        if (not ispresent(v_myVarC.d) and v_myVarC.e == 2 and v_myVarC.f == true) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
