// @requirement: 6.2.3.0 -- In this way, a value with initialized elements can be made empty by using the empty value list notation ("{}").
// @id: TTCN3-CORE-6.2.3.0-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_general_016 {

    type record of integer MyRecordOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro := { 1, 2, 3 };
        v_ro := {};
        if (lengthof(v_ro) == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
