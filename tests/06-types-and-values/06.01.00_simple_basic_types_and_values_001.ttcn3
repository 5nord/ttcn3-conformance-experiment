// @requirement: 6.1.0 -- a) `integer: a type with distinguished values which are the positive and negative whole numbers, including` zero:
// @id: TTCN3-CORE-6.1.0-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_simple_basic_types_and_values_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_pos := 5;
        var integer v_neg := -5;
        var integer v_zero := 0;
        if (v_pos > v_zero and v_neg < v_zero and v_pos + v_neg == v_zero) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
