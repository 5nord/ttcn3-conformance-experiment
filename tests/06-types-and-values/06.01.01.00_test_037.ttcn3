// @requirement: 6.1.1.0 -- Each short identifier represents a single character and it shall be composed of a letter U or u followed by an optional "+" PLUS SIGN character, followed by 1..8 hexadecimal digits.
// @id: TTCN3-CORE-6.1.1.0-047a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_test_037 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_u := char(U41, U4E2D, U10FFFF);
        if (lengthof(v_u) == 3 and v_u[0] == char(U41) and v_u[1] == char(U4E2D) and
            v_u[2] == char(U10FFFF)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
