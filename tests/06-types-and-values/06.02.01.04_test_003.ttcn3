// @requirement: 6.2.1.4 -- A field of an embedded field is called promoted if its name has no conflicts with other field names.
// @id: TTCN3-CORE-6.2.1.4-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_04_test_003 {

    type component C {}

    type record Point {
        integer x,
        integer y,
        integer z
    }

    type record Pixel {
        Point,
        charstring color,
        float z
    }

    testcase TC() runs on C {
        var Pixel v_p := { Point := { 4, 8, 1 }, color := "red", z := 2.0 };
        if (v_p.x == 4 and v_p.y == 8 and v_p.z == 2.0 and v_p.Point.z == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
