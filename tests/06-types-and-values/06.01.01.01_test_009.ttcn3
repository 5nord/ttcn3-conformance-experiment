// @requirement: 6.1.1.1 -- For initializing an uninitialized string with a single element, the index value zero (0) can be used as index.
// @id: TTCN3-CORE-6.1.1.1-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_01_test_009 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_cs;
        var bitstring v_bs;
        v_cs[0] := "a";
        v_bs[0] := '0'B;
        if (v_cs == "a" and v_bs == '0'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
