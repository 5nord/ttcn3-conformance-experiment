// @requirement: 6.1.0 -- c) `boolean: a type consisting of two distinguished values:`
// @id: TTCN3-CORE-6.1.0-038a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_simple_basic_types_and_values_036 {

    type component C {}

    testcase TC() runs on C {
        var boolean v_t := true;
        var boolean v_f := false;
        if (v_t != v_f and not v_t == v_f and (not v_t) == v_f) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
