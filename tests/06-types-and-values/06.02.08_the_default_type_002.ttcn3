// @requirement: 6.2.8 -- Such a unique default reference is generated by a test component when an altstep is activated as a default, i.e. a default reference is the result of an activate operation (see clause 20.5.2).
// @id: TTCN3-CORE-6.2.8-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_08_the_default_type_002 {

    type component C {
        timer T;
    }

    altstep a_def() runs on C {
        [] T.timeout {}
    }

    testcase TC() runs on C {
        var default v_d1 := activate(a_def());
        var default v_d2 := activate(a_def());
        if (v_d1 != null and v_d2 != null and v_d1 != v_d2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        deactivate(v_d1);
        deactivate(v_d2);
    }

    control {
        execute(TC());
    }
}
