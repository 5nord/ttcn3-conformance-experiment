// @requirement: 6.2.1.1 -- Fields of record type definitions shall not reference themselves.
// @id: TTCN3-CORE-6.2.1.1-003a
// @verdict: pass reject
module M_06_02_01_01_referencing_fields_of_a_record_type_004 {

    type record MyType {
        integer field1,
        MyType.field2 field2 optional, // error: field references itself
        boolean field3
    }
}
