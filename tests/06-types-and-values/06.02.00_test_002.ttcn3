// @requirement: 6.2.0 -- Values of these types may be given using an explicit assignment notation or a short-hand value list notation or in a mixed list and assignment notation.
// @id: TTCN3-CORE-6.2.0-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_00_test_002 {

    type record MyRecordType {
        bitstring field1,
        boolean field2,
        charstring field3
    }

    const MyRecordType c_assign := {
        field1 := '11001'B,
        field2 := true,
        field3 := "A string"
    }
    const MyRecordType c_list := {'11001'B, true, "A string"}
    const MyRecordType c_mixed := {'11001'B, field2 := true, field3 := "A string"}

    type component C {}

    testcase TC() runs on C {
        if (c_assign == c_list and c_list == c_mixed) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
