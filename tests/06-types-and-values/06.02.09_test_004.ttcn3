// @requirement: 6.2.9 -- Ports are bidirectional.
// @id: TTCN3-CORE-6.2.9-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_09_test_004 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    function f_echo() runs on C {
        timer T_guard := 1.0;
        var integer v_x;
        T_guard.start;
        alt {
            [] p.receive(integer:?) -> value v_x {
                p.send(v_x + 1);
            }
            [] T_guard.timeout {}
        }
    }

    testcase TC() runs on C {
        timer T_guard := 1.0;
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_echo());
        p.send(1);
        T_guard.start;
        alt {
            [] p.receive(2) {
                setverdict(pass);
            }
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
