// @requirement: 6.2.13.0 -- Values of a subtype shall fulfil conditions specified by its constraint and all constraints existing in all its direct and indirect parent types up to the core type.
// @id: TTCN3-CORE-6.2.13.0-002a
// @verdict: pass reject
module M_06_02_13_00_test_002 {

    type record of integer RoI;
    type RoI RoI_List ({ 1, 2 }, { 3, 4, 5 });
    type RoI_List RoI_Len length(2..3);

    const RoI_Len c_val := { 7, 8 }; // error: fulfils length(2..3) but not the list constraint of the parent type

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
