// @requirement: 6.2.9 -- These constants, variables or parameters can contain a reference to an existing component port or a special value null.
// @id: TTCN3-CORE-6.2.9-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_09_communication_port_types_024 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    function f_send() runs on C {
        p.send(1);
    }

    testcase TC() runs on C {
        timer T_guard := 1.0;
        var P v_none := null;
        var P v_port := p;
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_send());
        T_guard.start;
        alt {
            [] v_port.receive(integer:1) {
                if (v_none == null) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
