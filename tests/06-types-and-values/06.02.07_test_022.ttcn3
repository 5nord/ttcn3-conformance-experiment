// @requirement: 6.2.7 -- Index notation can be used on both the right-hand side and left-hand side of assignments.
// @id: TTCN3-CORE-6.2.7-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_07_test_022 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a[2] := { 1, 2 };
        var integer v_i := v_a[1];
        v_a[0] := v_i;
        if (v_i == 2 and v_a[0] == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
