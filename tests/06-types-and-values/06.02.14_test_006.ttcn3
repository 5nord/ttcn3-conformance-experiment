// @requirement: 6.2.14 -- The values of timer type are object references and follow specific rules for this kind of values.
// @id: TTCN3-CORE-6.2.14-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_14_test_006 {

    type component C {
        timer T := 5.0;
    }

    function f_stop(timer p_timer) {
        p_timer.stop;
    }

    testcase TC() runs on C {
        var timer v_copy := T;
        v_copy.start;
        if (not T.running) {
            setverdict(fail, "starting via the copied reference did not start the referenced timer");
        }
        f_stop(T);
        if (not v_copy.running and v_copy == T) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
