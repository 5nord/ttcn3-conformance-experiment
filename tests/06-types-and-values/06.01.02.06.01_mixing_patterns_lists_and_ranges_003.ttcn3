// @requirement: 6.1.2.6.1 -- Overlapping of different constraints is not an error.
// @id: TTCN3-CORE-6.1.2.6.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_06_01_mixing_patterns_lists_and_ranges_003 {

    type integer MyInt (1 .. 10, 5, 8 .. 12);

    type component C {}

    testcase TC() runs on C {
        var MyInt v_1 := 5;
        var MyInt v_2 := 9;
        if (v_1 == 5 and v_2 == 9) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
