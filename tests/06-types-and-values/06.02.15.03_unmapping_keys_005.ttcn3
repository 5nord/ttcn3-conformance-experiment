// @requirement: 6.2.15.3 -- In this case, the second parameter of the statement shall be an asterisk literal.
// @id: TTCN3-CORE-6.2.15.3-005a
// @verdict: pass reject
module M_06_02_15_03_unmapping_keys_005 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var template MyMap v_tmpl := { *, ["a"] := 1 };
        unmap(v_tmpl, ?); // error: AnyElementsOrNone can only be removed with the asterisk literal
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
