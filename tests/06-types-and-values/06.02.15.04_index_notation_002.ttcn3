// @requirement: 6.2.15.4 -- Index notation can be used on both the right-hand side and left-hand side of assignments.
// @id: TTCN3-CORE-6.2.15.4-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_04_index_notation_002 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var MyMap v_map := { ["a"] := 1 };
        v_map["b"] := v_map["a"] + 1;
        if (v_map["b"] == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
