// @requirement: 6.2.13.1 -- Constants used in the constant expressions of length subtyping shall meet with the restrictions in clause 10.
// @id: TTCN3-CORE-6.2.13.1-007a
// @verdict: pass reject
module M_06_02_13_01_test_011 {

    const integer c_len := float2int(rnd() * 10.0) + 1;

    type record length(c_len) of integer RoI; // error: constant used in a type definition is initialized with rnd

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
