module M_06_01_00_simple_basic_types_and_values_022 {

    type enumerated MyEnum { e_one, e_two, e_three }

    type MyEnum MyEnumList (e_one, e_two);

    type component C {}

    testcase TC() runs on C {
        var MyEnumList v_enum := e_two;
        if (v_enum == e_two) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
