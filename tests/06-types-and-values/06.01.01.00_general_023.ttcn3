// @requirement: 6.1.1.0 -- In cases where it is necessary to define strings that include the character double quote (") the character is represented by a pair of double quotes on the same line with no intervening space characters.
// @id: TTCN3-CORE-6.1.1.0-031a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_general_023 {

    type component C {}

    testcase TC() runs on C {
        const charstring c_char := """ab""cd""";
        if (lengthof(c_char) == 6 and
            c_char == int2char(34) & "ab" & int2char(34) & "cd" & int2char(34)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
