// @requirement: 6.5 -- A record field is created as optional if the value in the notation doesn't fulfil requirements of the present template restriction (see clause 15.8 for more details), otherwise it is created without the optional property.
// @id: TTCN3-CORE-6.5-018b
// @verdict: pass reject
module M_06_05_test_023 {
    type component C {}

    testcase TC() runs on C {
        var v_auto := { a := 1, b := 2 };
        v_auto.b := omit; // error: field b is not optional
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
