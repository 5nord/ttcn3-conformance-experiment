// @requirement: 6.2.10.2 -- The effect of this definition is that the extended type will implicitly also contain all definitions from the supertype.
// @id: TTCN3-CORE-6.2.10.2-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_10_02_reuse_of_component_types_003 {

    type port P message {
        inout integer;
    }

    type component CBase {
        port P p1, p2;
        const integer cc_i := 1;
        var integer vc_i := 2;
        template integer m_i := 3;
        timer tc_t := 1.0;
    }

    type component CExt extends CBase {
    }

    testcase TC() runs on CExt {
        connect(self:p1, self:p2);
        tc_t.start;
        p1.send(cc_i + vc_i + valueof(m_i));
        alt {
            [] p2.receive(6) { setverdict(pass); }
            [] p2.receive { setverdict(fail); }
            [] tc_t.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
