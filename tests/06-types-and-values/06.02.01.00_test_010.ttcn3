// @requirement: 6.2.1.0 -- The `omit` keyword shall only be used for optional fields.
// @id: TTCN3-CORE-6.2.1.0-018a
// @verdict: pass reject
module M_06_02_01_00_test_010 {

    type record MyRecordType {
        integer field1,
        boolean field2 optional
    }

    const MyRecordType c_r := {
        field1 := omit, // error: omit used for a mandatory field
        field2 := true
    }

}
