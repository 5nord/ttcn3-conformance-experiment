// @requirement: 6.2.1.1 -- When the assignment is used in a scope where the optional attribute is equal to "implicit omit", all unreferenced optional subfields shall be set to omit.
// @id: TTCN3-CORE-6.2.1.1-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_01_test_012 {

    type component C {}

    type record Inner {
        integer subfield1,
        integer subfield2 optional
    }

    type record MyType4 {
        integer field1 optional,
        Inner field2 optional
    }

    testcase TC() runs on C {
        var MyType4 v_rec := { field1 := 1, field2 := omit };
        v_rec.field2.subfield1 := 5;
        if (isbound(v_rec.field2.subfield2) and not ispresent(v_rec.field2.subfield2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    } with { optional "implicit omit" }

    control {
        execute(TC());
    }
}
