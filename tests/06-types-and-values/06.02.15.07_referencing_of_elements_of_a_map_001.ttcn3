// @requirement: 6.2.15.7 -- When referencing an element of an uninitialized map value or field or omitted field (including omitting a field at a higher level of the embedding hierarchy) on the left-hand side of an assignment, the reference shall recursively be expanded up to and including the depth of the referenced element as follows:
// @id: TTCN3-CORE-6.2.15.7-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_07_referencing_of_elements_of_a_map_001 {

    type map from charstring to integer MapType;
    type record R {
        integer f1,
        MapType f2 optional
    }

    type component C {}

    testcase TC() runs on C {
        var R v_rec := { f1 := 0, f2 := omit };
        v_rec.f2["k"] := 1;
        if (ispresent(v_rec.f2) and lengthof(v_rec.f2) == 1 and v_rec.f2["k"] == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
