// @requirement: 6.2.7 -- When specifying values for multi-dimensional arrays, the leftmost dimension corresponds to the outermost structure of the value, and the rightmost dimension to the innermost structure.
// @id: TTCN3-CORE-6.2.7-033a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_07_test_031 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a[2][3] := { { 1, 2, 3 }, { 4, 5, 6 } };
        if (v_a[0][2] == 3 and v_a[1][0] == 4 and v_a[1][2] == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
