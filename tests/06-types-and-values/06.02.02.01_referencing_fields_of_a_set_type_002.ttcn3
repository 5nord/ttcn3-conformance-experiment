// @requirement: 6.2.2.1 -- Elements of set type definitions shall not reference themselves.
// @id: TTCN3-CORE-6.2.2.1-002a
// @verdict: pass reject
module M_06_02_02_01_referencing_fields_of_a_set_type_002 {

    type set MySet {
        integer field1,
        MySet.field2 field2 optional // error: field references itself
    }
}
