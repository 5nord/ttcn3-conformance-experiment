// @requirement: 6.2.2.4 -- Embedded Fields with the set definition are similar to the mechanism for record types described in clause 6.2.1.4.
// @id: TTCN3-CORE-6.2.2.4-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_02_04_test_001 {

    type record Point {
        integer x,
        integer y
    }

    type set Pixel {
        Point,
        charstring color
    }

    type component C {}

    testcase TC() runs on C {
        var Pixel v_pixel := { Point := { 4, 8 }, color := "red" };
        if (v_pixel.Point.x == 4 and v_pixel.y == 8) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
