// @requirement: 6.1.2.3 -- In order to specify an infinite integer range, the keyword -infinity or infinity can be used instead of a value indicating that there is no lower or upper boundary; -infinity shall not be used as the upper bound and infinity shall not be used as the lower bound for integer ranges.
// @id: TTCN3-CORE-6.1.2.3-004c
// @verdict: pass reject
module M_06_01_02_03_test_007 {

    type integer MyIntRange (infinity .. infinity); // error: infinity used as lower bound of an integer range
}
