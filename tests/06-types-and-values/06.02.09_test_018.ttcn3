// @requirement: 6.2.9 -- To support such addressing schemes, TTCN-3 allows to bind an address type to a port.
// @id: TTCN3-CORE-6.2.9-019a
// @verdict: pass accept, noexecution
module M_06_02_09_test_018 {

    type record AddrType {
        integer host,
        integer portNum
    }

    type port P message {
        address AddrType;
        inout integer;
    }

    type component C {
        port P p;
    }
}
