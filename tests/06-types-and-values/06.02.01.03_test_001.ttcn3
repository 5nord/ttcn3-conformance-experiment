// @requirement: 6.2.1.3 -- TTCN-3 supports the definition of types for record fields nested within the record definition.
// @id: TTCN3-CORE-6.2.1.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_03_test_001 {

    type component C {}

    type record R {
        record {
            integer nestedField1,
            float nestedField2
        } outerField1
    }

    testcase TC() runs on C {
        var R v_r := { outerField1 := { nestedField1 := 1, nestedField2 := 2.0 } };
        if (v_r.outerField1.nestedField1 == 1 and v_r.outerField1.nestedField2 == 2.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
