// @requirement: 6.2.15.7 -- c) At the end of the expansion, the value at the right-hand side of the assignment shall be assigned to the referenced element.
// @id: TTCN3-CORE-6.2.15.7-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_07_referencing_of_elements_of_a_map_004 {

    type map from charstring to map from charstring to integer MapType;

    type component C {}

    testcase TC() runs on C {
        var MapType v_map;
        v_map["x"]["y"] := 42;
        if (v_map["x"]["y"] == 42) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
