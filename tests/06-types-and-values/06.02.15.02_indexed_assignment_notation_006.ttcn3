// @requirement: 6.2.15.2 -- Templates of the map type can use a specific form of the mixed notation, where the first item is and asterisk representing the AnyElementsOrNone matching symbol, followed by one or more indexed assignments (see clause B.1.3.2 for more details).
// @id: TTCN3-CORE-6.2.15.2-003b
// @verdict: pass reject
module M_06_02_15_02_indexed_assignment_notation_006 {

    type map from charstring to integer MyMap;

    template MyMap m_tmpl := { ["a"] := 1, * }; // error: AnyElementsOrNone is not the first item

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
