// @requirement: 6.2.5.1 -- When referencing an alternative of a union type on the left hand side of an assignment, the referenced alternative shall become the chosen one.
// @id: TTCN3-CORE-6.2.5.1-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_05_01_referencing_fields_of_a_union_type_009 {

    type union U {
        integer choice1,
        charstring choice2
    }

    type component C {}

    testcase TC() runs on C {
        var U v_u := { choice1 := 1 };
        v_u.choice2 := "a";
        if (ischosen(v_u.choice2) and v_u == { choice2 := "a" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
