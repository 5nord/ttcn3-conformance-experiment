// @requirement: 6.2.13.1 -- The length keyword followed by a value or a range (with inclusive boundaries only) within brackets and used between the record or set and the of keywords, restricts the allowed number of elements for the given record of or set of type.
// @id: TTCN3-CORE-6.2.13.1-002b
// @verdict: pass accept, ttcn3verdict:error
module M_06_02_13_01_length_subtyping_of_record_ofs_and_set_ofs_003 {

    type record of integer RoI;
    type record length(1..3) of integer RoI1_3;

    type component C {}

    testcase TC() runs on C {
        var RoI v_src := {};
        var RoI1_3 v_dst := { 1, 2, 3 };
        for (var integer i := 0; i < 4; i := i + 1) {
            v_src[i] := i;
        }
        v_dst := v_src; // 4 elements are not allowed by length(1..3): test case error
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
