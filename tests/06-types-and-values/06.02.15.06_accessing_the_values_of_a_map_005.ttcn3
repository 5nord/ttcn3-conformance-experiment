// @requirement: 6.2.15.6 -- This type can also be referenced as_ _MapValueType.to;_
// @id: TTCN3-CORE-6.2.15.6-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_06_accessing_the_values_of_a_map_005 {

    type map from charstring to integer MapType;
    type set of integer IntSet;

    type component C {}

    testcase TC() runs on C {
        var MapType.to v_values := { 7, 8 };
        var IntSet v_set := v_values;
        if (lengthof(v_set) == 2 and v_set[0] == 7 and v_set[1] == 8) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
