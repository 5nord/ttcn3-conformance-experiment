// @requirement: 6.2.3.0 -- c) At the end of the expansion, the value at the right-hand side of the assignment shall be assigned to the referenced element.
// @id: TTCN3-CORE-6.2.3.0-030a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_general_031 {

    type record of integer MyRecordOf;
    type record of MyRecordOf RoRoI;

    type component C {}

    testcase TC() runs on C {
        var RoRoI v_recof;
        v_recof[0][1] := 7;
        if (v_recof[0][1] == 7) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
