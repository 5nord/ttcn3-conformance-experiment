// @requirement: 6.2.7 -- In such cases, the lower and upper values of the range syntax define the lower and upper index values.
// @id: TTCN3-CORE-6.2.7-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_07_test_014 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a[3 .. 6];
        v_a[3] := 30;
        v_a[6] := 60;
        if (v_a[3] == 30 and v_a[6] == 60 and not isbound(v_a[4]) and not isbound(v_a[5])) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
