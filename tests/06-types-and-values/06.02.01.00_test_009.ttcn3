// @requirement: 6.2.1.0 -- When the assignment notation is used for record-s, fields wished to be changed shall be identified explicitly and a value, the not used symbol "-" or the omit keyword can be associated with them.
// @id: TTCN3-CORE-6.2.1.0-017b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_01_00_test_009 {

    type record MyRecordType {
        bitstring field1,
        boolean field2 optional,
        charstring field3
    }

    type component C {}

    testcase TC() runs on C {
        var MyRecordType v_r := { field1 := '111'B, field2 := false, field3 := "A string" };
        v_r := {
            field1 := '10111'B,
            field2 := omit,
            field3 := -
        };
        if (v_r.field1 == '10111'B and not ispresent(v_r.field2) and v_r.field3 == "A string") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
