// @requirement: 6.1.0 -- b) `float: a type to describe floating-point numbers and special float values:`
// @id: TTCN3-CORE-6.1.0-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_test_005 {

    type component C {}

    testcase TC() runs on C {
        var float v_num := 1.5;
        var float v_inf := infinity;
        var float v_neginf := -infinity;
        var float v_nan := not_a_number;
        if (v_num * 2.0 == 3.0 and v_inf > v_num and v_neginf < v_num and v_nan == not_a_number) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
