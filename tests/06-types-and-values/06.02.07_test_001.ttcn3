// @requirement: 6.2.7 -- Arrays can be used in TTCN-3 as a shorthand notation to specify record of types.
// @id: TTCN3-CORE-6.2.7-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_07_test_001 {

    type integer MyArrayType[3];
    type record length (3) of integer MyRecordOfType;

    type component C {}

    testcase TC() runs on C {
        var MyArrayType v_a := { 7, 8, 9 };
        var MyRecordOfType v_r := v_a;
        var integer v_b[3] := v_r;
        if (v_r == { 7, 8, 9 } and v_b[0] == 7 and v_b[2] == 9) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
