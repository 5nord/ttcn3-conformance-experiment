// @requirement: 6.2.13.2 -- > NOTE: Users should assign new values to single fields of values/templates based on types using list subtyping cautiously: it may happen that the new field value would be valid with other combination(s) of the rest of the fields but causes an erroneous record/set value, when combining with the actual values of the other fields.
// @id: TTCN3-CORE-6.2.13.2-010b
// @verdict: pass accept, ttcn3verdict:error
module M_06_02_13_02_test_012 {

    type record R {
        integer k,
        integer i,
        integer j
    }

    type R R2 ({ k := 1, i := 2 }, { k := 2, i := 3 });

    type component C {}

    function f_two() return integer {
        return 2;
    }

    testcase TC() runs on C {
        var R2 v_x := { 1, 2, 5 };
        v_x.j := 6;
        v_x.k := f_two(); // { 2, 2, 6 } is not a value of R2: test case error
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
