// @requirement: 6.2.4 -- TTCN-3 supports enumerated types.
// @id: TTCN3-CORE-6.2.4-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_04_test_001 {

    type component C {}

    type enumerated E { e_a, e_b, e_c };

    testcase TC() runs on C {
        var E v_e := e_b;
        if (v_e == e_b and v_e != e_c) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
