// @requirement: 6.1.0 -- Class of type: set; Keyword: list (see note)
// @id: TTCN3-CORE-6.1.0-020b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_test_020 {

    type set MySet {
        integer a,
        boolean b
    }

    type MySet MySetList ({ a := 1, b := true }, { a := 2, b := false });

    type component C {}

    testcase TC() runs on C {
        var MySetList v_set := { b := false, a := 2 };
        if (v_set.a == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
