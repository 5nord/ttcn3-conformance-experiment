// @requirement: 6.2.10.2 -- Any of the supertypes may also be defined by means of extension.
// @id: TTCN3-CORE-6.2.10.2-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_10_02_test_005 {

    type component CA {
        var integer vc_a := 1;
    }

    type component CB extends CA {
        var integer vc_b := 2;
    }

    type component CC {
        var integer vc_c := 3;
    }

    type component CExt extends CC, CB {
    }

    testcase TC() runs on CExt {
        if (vc_a == 1 and vc_b == 2 and vc_c == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
