// @requirement: 6.2.5.1 -- When an alternative of a union type is referenced on the right hand side of an assignment an error shall occur if the referenced alternative is not the currently chosen alternative or if the referenced union field or value is omitted or uninitialized.
// @id: TTCN3-CORE-6.2.5.1-007a
// @verdict: pass accept, ttcn3verdict:error
module M_06_02_05_01_test_007 {

    type union U {
        integer choice1,
        charstring choice2
    }

    type component C {}

    testcase TC() runs on C {
        var U v_u := { choice1 := 1 };
        setverdict(pass);
        var charstring v_c := v_u.choice2; // error: choice2 is not the chosen alternative
        log(v_c);
    }

    control {
        execute(TC());
    }
}
