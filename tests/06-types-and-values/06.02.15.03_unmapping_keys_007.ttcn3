// @requirement: 6.2.15.3 -- a) ValueRef shall be an initialized variable of map type and SingleExpression shall be a value compatible with the key type of the map type of ValueRef.
// @id: TTCN3-CORE-6.2.15.3-007a
// @verdict: pass reject
module M_06_02_15_03_unmapping_keys_007 {

    type map from charstring to integer MyMap;

    const MyMap c_map := { ["a"] := 1, ["b"] := 2 };

    type component C {}

    testcase TC() runs on C {
        unmap(c_map, "a"); // error: ValueRef is a constant, not a variable of map type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
