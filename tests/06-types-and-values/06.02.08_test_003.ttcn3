// @requirement: 6.2.8 -- Such a unique default reference is generated by a test component when an altstep is activated as a default, i.e. a default reference is the result of an activate operation (see clause 20.5.2).
// @id: TTCN3-CORE-6.2.8-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_08_test_003 {

    type component C {
        timer T;
    }

    altstep a_def() runs on C {
        [] T.timeout {}
    }

    testcase TC() runs on C {
        var default v_d := null;
        v_d := activate(a_def());
        if (v_d != null) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        deactivate(v_d);
    }

    control {
        execute(TC());
    }
}
