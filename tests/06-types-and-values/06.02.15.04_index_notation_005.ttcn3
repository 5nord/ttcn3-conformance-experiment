// @requirement: 6.2.15.4 -- When the index notation is used at the left-hand side, only the value associated with the index key is changed, values with other keys remain unchanged.
// @id: TTCN3-CORE-6.2.15.4-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_04_index_notation_005 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var MyMap v_map := { ["a"] := 1, ["b"] := 2, ["c"] := 3 };
        v_map["b"] := 20;
        if (lengthof(v_map) == 3 and v_map["a"] == 1 and v_map["b"] == 20 and v_map["c"] == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
