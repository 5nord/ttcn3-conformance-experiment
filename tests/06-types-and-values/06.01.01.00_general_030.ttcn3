// @requirement: 6.1.1.0 -- In cases where it is necessary to define strings that include the character double quote (") the character is represented by a pair of double quotes on the same line with no intervening space characters.
// @id: TTCN3-CORE-6.1.1.0-039a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_general_030 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_u := """ű""a";
        if (lengthof(v_u) == 4 and unichar2int(v_u[0]) == 34 and v_u[1] == char(0, 0, 1, 113) and
            unichar2int(v_u[2]) == 34 and v_u[3] == char(0, 0, 0, 97)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
