// @requirement: 6.5 -- If the pattern contains only characters or references of the charstring type, the automatic type is charstring, otherwise it is universal charstring.
// @id: TTCN3-CORE-6.5-029b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_test_035 {
    type component C {}

    function f_check(inout template universal charstring p_t) return boolean {
        return match(char(0, 0, 0, 228) & "bc", p_t);
    }

    testcase TC() runs on C {
        var template v_auto := pattern "\q{0, 0, 0, 228}*";
        if (f_check(v_auto)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
