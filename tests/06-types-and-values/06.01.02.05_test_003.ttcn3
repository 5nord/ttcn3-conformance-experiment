// @requirement: 6.1.2.5 -- All values denoted by the pattern shall be a subset of the type being sub typed.
// @id: TTCN3-CORE-6.1.2.5-003a
// @verdict: pass reject
module M_06_01_02_05_test_003 {

    type charstring MyString (pattern "abc*xyz");
    type MyString MyString3 (pattern "d*xyz"); // error: values not a subset of MyString

}
