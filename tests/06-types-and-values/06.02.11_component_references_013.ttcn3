// @requirement: 6.2.11 -- The configuration operations (see clause 21) do not work directly on arrays of components.
// @id: TTCN3-CORE-6.2.11-012a
// @verdict: pass reject
module M_06_02_11_component_references_013 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptcs[2];
        v_ptcs[0] := C.create;
        v_ptcs[1] := C.create;
        connect(self:p, v_ptcs:p); // error: connect applied to an array of component references
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
