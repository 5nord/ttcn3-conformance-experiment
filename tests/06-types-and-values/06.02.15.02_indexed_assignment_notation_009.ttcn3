// @requirement: 6.2.15.2 -- Other elements, not referred to by keys in the notation, shall remain unchanged.
// @id: TTCN3-CORE-6.2.15.2-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_02_indexed_assignment_notation_009 {

    type map from charstring to integer MyMap;

    type component C {}

    testcase TC() runs on C {
        var MyMap v_map := { ["a"] := 1, ["b"] := 2, ["c"] := 3 };
        v_map := { ["b"] := 20 };
        if (lengthof(v_map) == 3 and v_map["a"] == 1 and v_map["b"] == 20 and v_map["c"] == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
