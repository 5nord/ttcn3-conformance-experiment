// @requirement: 6.1.1.0 -- NOTE 3: If applying the double quote format all characters from any character set defined in ISO/IEC 10646 [2] are allowed.
// @id: TTCN3-CORE-6.1.1.0-036a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_01_00_test_028 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_u := "ű中";
        if (lengthof(v_u) == 2 and v_u == char(0, 0, 1, 113) & char(0, 0, 78, 45)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
