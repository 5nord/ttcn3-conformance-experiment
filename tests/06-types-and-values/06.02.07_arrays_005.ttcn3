// @requirement: 6.2.7 -- Array dimensions shall be specified using constant expressions, which shall evaluate to a positive integer values.
// @id: TTCN3-CORE-6.2.7-004b
// @verdict: pass reject
module M_06_02_07_arrays_005 {

    const integer c_size := 2 - 3;

    type integer MyArray[c_size]; // error: array dimension is not a positive integer

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
