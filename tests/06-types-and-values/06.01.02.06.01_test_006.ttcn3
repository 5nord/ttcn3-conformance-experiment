// @requirement: 6.1.2.6.1 -- Type: octetstring; Units of Length: octets
// @id: TTCN3-CORE-6.1.2.6.1-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_02_06_01_test_006 {

    type octetstring MyOct length(2);

    type component C {}

    testcase TC() runs on C {
        var MyOct v_o := 'ABCD'O;
        if (lengthof(v_o) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
