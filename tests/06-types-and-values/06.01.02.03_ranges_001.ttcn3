// @requirement: 6.1.2.3 -- TTCN-3 permits the specification of range constraints for the types integer, charstring, `universal` charstring and float (or derivations of these types).
// @id: TTCN3-CORE-6.1.2.3-001a
// @verdict: pass accept, noexecution
module M_06_01_02_03_ranges_001 {

    type integer MyIntRange (0 .. 255);
    type float MyFloatRange (3.14 .. 3142E-3);
    type charstring MyCharRange ("a" .. "z");
    type universal charstring MyUCharRange (char(0, 0, 1, 111) .. char(0, 0, 1, 113));

    type integer MyInt;
    type MyInt MyDerivedIntRange (1 .. 10);

    const MyIntRange c_int := 255;
    const MyFloatRange c_float := 3.141;
    const MyCharRange c_char := "abc";
    const MyUCharRange c_uchar := char(0, 0, 1, 112);
    const MyDerivedIntRange c_derived := 10;
}
