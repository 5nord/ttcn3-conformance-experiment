// @requirement: 6.2.13.2 -- In case of `enumerated` types, the template list subtyping shall contain only values of the parent type.
// @id: TTCN3-CORE-6.2.13.2-012a
// @verdict: pass reject
module M_06_02_13_02_test_013 {

    type enumerated E { e1, e2, e3 }
    type E E_Sub1 (e1, e2);
    type E_Sub1 E_Sub2 (e1, e3); // error: e3 is not a value of the parent type E_Sub1

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
