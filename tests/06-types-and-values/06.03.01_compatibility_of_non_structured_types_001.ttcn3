// @requirement: 6.3.1 -- For variables, constants, templates, etc. of simple basic types and basic string types the value "b" is compatible to type "A" if type "B" resolves to the same root type as type "A" (e.g. integer) and it does not violate subtyping (e.g. ranges, length restrictions) of type "A".
// @id: TTCN3-CORE-6.3.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_01_compatibility_of_non_structured_types_001 {

    type integer MyInteger (1 .. 10);
    type charstring MyString length (1 .. 3);

    type component C {}

    testcase TC() runs on C {
        var integer v_x := 5;
        var MyInteger v_y := v_x;
        var charstring v_s := "ab";
        var MyString v_t := v_s;
        if (v_y == 5 and v_t == "ab") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
