// @requirement: 6.5 -- o) Pattern.
// @id: TTCN3-CORE-6.5-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_automatic_type_033 {
    type component C {}

    testcase TC() runs on C {
        var template v_auto := pattern "a*c";
        if (match("abbc", v_auto) and not match("abd", v_auto)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
