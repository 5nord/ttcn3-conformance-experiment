// @requirement: 6.1.0 -- Values of boolean type shall be denoted by true and false.
// @id: TTCN3-CORE-6.1.0-039a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_test_037 {

    type component C {}

    testcase TC() runs on C {
        var boolean v_b1 := true;
        var boolean v_b2 := false;
        if (v_b1 and not v_b2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
