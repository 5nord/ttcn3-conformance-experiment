// @requirement: 6.2.1.0 -- The values of a record shall be compatible with the types of the record fields.
// @id: TTCN3-CORE-6.2.1.0-003a
// @verdict: pass reject
module M_06_02_01_00_general_002 {

    type record MyRecordType {
        integer field1,
        charstring field2
    }

    const MyRecordType c_r := {
        field1 := "A string", // error: value not compatible with integer
        field2 := "B string"
    }

}
