// @requirement: 6.2.11 -- This means, for example, that a variable for handling component references shall use the corresponding component type name in its declaration.
// @id: TTCN3-CORE-6.2.11-011a
// @verdict: pass reject
module M_06_02_11_test_012 {

    type component CA {
        var integer vc_a := 1;
    }

    type component CB {
        var float vc_b := 1.0;
    }

    testcase TC() runs on CA {
        var CA v_ref := CB.create; // error: variable type does not correspond to the component type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
