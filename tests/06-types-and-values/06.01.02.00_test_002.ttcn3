// @requirement: 6.1.2.0 -- With user-defined types it is possible to create subtypes (such as lists, ranges and length restrictions) on basic types, structured types and anytype according to table 3.
// @id: TTCN3-CORE-6.1.2.0-002a
// @verdict: pass accept, noexecution
module M_06_01_02_00_test_002 {

    type integer MyRange (0 .. 10);
    type boolean MyTrue (true);
    type charstring MyString length(1 .. 3);

    type record MyRecord {
        integer f1
    }
    type MyRecord MyRecordList ({ f1 := 1 }, { f1 := 2 });

    type record of integer MyIntList;
    type MyIntList MyShortIntList length(0 .. 2);

    type anytype MyAnyList ({ integer := 1 }, { boolean := true });

    const MyRange c_range := 10;
    const MyTrue c_true := true;
    const MyString c_str := "abc";
    const MyRecordList c_rec := { f1 := 2 };
    const MyShortIntList c_list := { 1, 2 };
    const MyAnyList c_any := { integer := 1 };
}
