// @requirement: 6.2.12 -- If TemplateInstance is of type address, it may be an address type value, an address type variable, etc.
// @id: TTCN3-CORE-6.2.12-017b
// @verdict: pass accept, noexecution
module M_06_02_12_addressing_entities_inside_the_sut_014 {

    type integer address;

    const address c_addr := 2;

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    function f_addr() return address {
        return 4;
    }

    testcase TC() runs on C system C {
        var address v_addr := 3;
        map(mtc:p, system:p);
        p.send(integer:1) to 1;
        p.send(integer:2) to c_addr;
        p.send(integer:3) to v_addr;
        p.send(integer:4) to f_addr();
        setverdict(pass);
    }
}
