// @requirement: 6.2.7 -- For using the value list or assignment notation for arrays, the rules described in clause 6.2.2.4 are valid for arrays as well.
// @id: TTCN3-CORE-6.2.7-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_07_test_021 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a[3] := { 1, 2, 3 };
        v_a := { -, 20, - };
        v_a := { [2] := 30 };
        if (v_a[0] == 1 and v_a[1] == 20 and v_a[2] == 30) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
