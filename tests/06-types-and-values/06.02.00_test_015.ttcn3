// @requirement: 6.2.0 -- In case of record and set types, to avoid infinite recursion, fields referencing to its own type, shall be optional.
// @id: TTCN3-CORE-6.2.0-019a
// @verdict: pass reject
module M_06_02_00_test_015 {

    type record MyRecord2 {
        integer field1,
        MyRecord2 field2, // error: self-referencing field is not optional
        charstring field3
    }

}
