// @requirement: 6.5 -- If both bounds are set to infinity, the integer type is provided.
// @id: TTCN3-CORE-6.5-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_05_test_032 {
    type component C {}

    function f_check(inout template integer p_t) return boolean {
        return match(100, p_t);
    }

    testcase TC() runs on C {
        var template v_auto := (-infinity .. infinity);
        if (f_check(v_auto)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
