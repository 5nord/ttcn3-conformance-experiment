// @requirement: 6.2.10.1 -- It is also possible to declare constants, variables, templates and timers local to a particular component type.
// @id: TTCN3-CORE-6.2.10.1-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_10_01_test_004 {

    type component C {
        const integer cc_i := 1;
        var integer vc_i := 2;
        template integer mw_i := (1 .. 3);
        timer tc_t := 1.0;
    }

    testcase TC() runs on C {
        tc_t.start;
        if (match(cc_i, mw_i) and match(vc_i, mw_i) and tc_t.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        tc_t.stop;
    }

    control {
        execute(TC());
    }
}
