// @requirement: 6.1.0 -- Class of type: set of; Keyword: list (see note), length
// @id: TTCN3-CORE-6.1.0-021b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_test_021 {

    type set of integer SoI;

    type SoI SoIList ({ 1 }, { 1, 2 });

    type SoI SoILength length(2);

    type component C {}

    testcase TC() runs on C {
        var SoIList v_list := { 2, 1 };
        var SoILength v_len := { 3, 4 };
        if (v_list == { 1, 2 } and lengthof(v_len) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
