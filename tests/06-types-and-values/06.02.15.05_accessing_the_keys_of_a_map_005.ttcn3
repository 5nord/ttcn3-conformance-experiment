// @requirement: 6.2.15.5 -- This type can also be referenced as _MapValueType.from._
// @id: TTCN3-CORE-6.2.15.5-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_15_05_accessing_the_keys_of_a_map_005 {

    type map from charstring to integer MapType;
    type set of charstring CharSet;

    type component C {}

    testcase TC() runs on C {
        var MapType.from v_keys := { "x", "y" };
        var CharSet v_set := v_keys;
        if (lengthof(v_set) == 2 and v_set[0] == "x" and v_set[1] == "y") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
