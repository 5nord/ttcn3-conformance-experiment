// @requirement: 6.2.10.2 -- The effective component type definition shall be name clash free.
// @id: TTCN3-CORE-6.2.10.2-009a
// @verdict: pass reject
module M_06_02_10_02_reuse_of_component_types_007 {

    type component CBase {
        timer tc_x;
    }

    type component CExt extends CBase {
        var float tc_x; // error: name clash with timer tc_x of the supertype
    }

    testcase TC() runs on CExt {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
