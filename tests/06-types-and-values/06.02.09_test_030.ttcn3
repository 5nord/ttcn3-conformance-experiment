// @requirement: 6.2.9 -- d) Formal parameters of map param and unmap param declarations shall be value parameters of a data type.
// @id: TTCN3-CORE-6.2.9-034a
// @verdict: pass reject
module M_06_02_09_test_030 {

    type port P message {
        inout integer;
        unmap param (in default p_d); // error: default is not a data type
    }

    type component C {
        port P p;
    }
}
