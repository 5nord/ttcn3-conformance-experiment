// @requirement: 6.1.0 -- The special values of the float type consist of infinity (positive infinity), -infinity (negative infinity) and the value not_a_number.
// @id: TTCN3-CORE-6.1.0-035a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_test_034 {

    type component C {}

    testcase TC() runs on C {
        var float v_pinf := infinity;
        var float v_ninf := -infinity;
        var float v_nan := not_a_number;
        if (v_pinf > 1.0E300 and v_ninf < -1.0E300 and v_nan > v_pinf) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
