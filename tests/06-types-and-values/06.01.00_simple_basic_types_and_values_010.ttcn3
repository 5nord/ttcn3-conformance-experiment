// @requirement: 6.1.0 -- Class of type: float; Keyword: range, list
// @id: TTCN3-CORE-6.1.0-010b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_simple_basic_types_and_values_010 {

    type float FloatRange (0.0 .. 1.0);

    type float FloatList (1.5, 2.5);

    type component C {}

    testcase TC() runs on C {
        var FloatRange v_range := 0.5;
        var FloatList v_list := 2.5;
        if (v_range == 0.5 and v_list == 2.5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
