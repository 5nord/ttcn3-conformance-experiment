// @requirement: 6.2.13.3 -- A type restriction following the identifier of a newly defined record of or set of type (i.e. when the keywords record and of or set and of are used in the definition) shall constrain the innermost type.
// @id: TTCN3-CORE-6.2.13.3-001a
// @verdict: pass reject
module M_06_02_13_03_test_001 {

    type record of charstring String23Array length(2 .. 3);

    type component C {}

    testcase TC() runs on C {
        var String23Array v_arr := { "aa", "bbbb" }; // error: element "bbbb" violates length(2 .. 3) of the innermost type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
