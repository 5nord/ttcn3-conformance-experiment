// @requirement: 6.3.2.3 -- For set types the same compatibility rules shall apply as to record types and for set `of types the same` compatibility rules shall apply as to record `of types.`
// @id: TTCN3-CORE-6.3.2.3-002b
// @verdict: pass accept, ttcn3verdict:pass
module M_06_03_02_03_test_004 {

    type component C {}

    type set of integer SType;
    type integer SmallInt(0..10);
    type set length(2) of SmallInt TType;

    testcase TC() runs on C {
        var SType v_myVarS := { 3, 4 };
        var TType v_myVarT := { 0, 0 };
        v_myVarT := v_myVarS;
        if (v_myVarT[0] == 3 and v_myVarT[1] == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
