// @requirement: 6.1.0 -- In TTCN-3, the floating-point number value notation is restricted to a base with the value of 10.
// @id: TTCN3-CORE-6.1.0-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_01_00_test_006 {

    type component C {}

    testcase TC() runs on C {
        var float v_exp1 := 1.0E1;
        var float v_exp2 := 25.0E-2;
        if (v_exp1 == 10.0 and v_exp2 == 0.25) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
