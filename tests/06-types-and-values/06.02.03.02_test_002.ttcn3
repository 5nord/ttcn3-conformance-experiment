// @requirement: 6.2.3.2 -- The notation TypeId[-], where TypeId resolves to the name of a record of or set of type, references the inner type of TypeId.
// @id: TTCN3-CORE-6.2.3.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_02_test_002 {

    type component C {}

    type record of record {
        integer f1,
        set { integer s1, boolean s2 } f2
    } MyRecordOfRecord;
    type set of set of charstring MySetOfSetOfStr;

    type MyRecordOfRecord[-] MyInnerRecord;
    type MySetOfSetOfStr[-] MyInnerSetOf;
    type MySetOfSetOfStr[-][-] MyInnerStr;

    testcase TC() runs on C {
        var MyInnerRecord v_rec := { f1 := 1, f2 := { s1 := 0, s2 := true } };
        var MyInnerStr v_str := "x";
        var MyInnerSetOf v_inner := { v_str };
        var MyRecordOfRecord v_outer := { v_rec };
        var MySetOfSetOfStr v_outer2 := { v_inner };
        if (v_outer[0].f1 == 1 and v_outer2[0][0] == "x") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
