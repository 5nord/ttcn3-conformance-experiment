// @requirement: 6.2.3.0 -- Index notation can be used on both the right-hand side and left-hand side of assignments.
// @id: TTCN3-CORE-6.2.3.0-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_06_02_03_00_test_017 {

    type record of integer MyRecordOf;

    type component C {}

    testcase TC() runs on C {
        var MyRecordOf v_ro := { 1, 2, 3 };
        v_ro[2] := v_ro[0];
        if (v_ro == { 1, 2, 1 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
