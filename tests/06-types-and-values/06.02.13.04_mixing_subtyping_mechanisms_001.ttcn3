// @requirement: 6.2.13.4 -- In the case of structured types and the special type anytype, it is forbidden to mix different subtyping mechanisms (e.g. list and length) in the same definition.
// @id: TTCN3-CORE-6.2.13.4-001a
// @verdict: pass reject
module M_06_02_13_04_mixing_subtyping_mechanisms_001 {

    type record of integer IntList;
    type IntList IntListSub ({ 1, 2 }, { 3, 4, 5 }) length(2); // error: list and length subtyping mixed

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
