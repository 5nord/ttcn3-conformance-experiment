// @requirement: 19.2 -- NOTE 2: if "(" (VarInstance | Assignment) ";" BooleanExpression ")" StatementBlock [else _StatementBlock] is a shorthand_ notation for **"{" (VarInstance | Assignment) ";" if "(" BooleanExpression ")" StatementBlock [ else** _StatementBlock] "}"._
// @id: TTCN3-CORE-19.2-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_02_test_003 {

    type component C {}

    function f_short(integer p_value) return integer {
        if (var integer v_x := p_value * 2; v_x > 4) {
            return v_x;
        } else {
            return -v_x;
        }
    }

    function f_long(integer p_value) return integer {
        {
            var integer v_x := p_value * 2;
            if (v_x > 4) {
                return v_x;
            } else {
                return -v_x;
            }
        }
    }

    testcase TC() runs on C {
        if (f_short(1) == f_long(1) and f_short(5) == f_long(5)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
