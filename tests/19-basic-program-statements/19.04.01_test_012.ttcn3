// @requirement: 19.4.1 -- The index variable of a for loop can be declared before being used in the for statement or can be declared and initialized in the for statement header.
// @id: TTCN3-CORE-19.4.1-011b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_04_01_test_012 {

    type component C {}

    testcase TC() runs on C {
        var integer v_count := 0;
        for (var float v_i := 1.0; v_i < 7.9; v_i := v_i * 1.35) {
            v_count := v_count + 1;
        }
        if (v_count == 7) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
