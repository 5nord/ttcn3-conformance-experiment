// @requirement: 19.12 -- On executing a break statement the innermost, currently executed loop, alt statement or interleave statement is left.
// @id: TTCN3-CORE-19.12-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_12_the_break_statement_004 {
    type component C {}

    testcase TC() runs on C {
        var integer v_outer := 0;
        var integer v_inner := 0;
        do {
            v_outer := v_outer + 1;
            for (var integer v_j := 1; v_j <= 10; v_j := v_j + 1) {
                if (v_j == 2) {
                    break;
                }
                v_inner := v_inner + 1;
            }
        } while (v_outer < 3);
        if (v_outer == 3 and v_inner == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
