// @requirement: 19.12 -- Execution continues with the statement following the construct which is left.
// @id: TTCN3-CORE-19.12-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_12_test_005 {
    type component C {}

    testcase TC() runs on C {
        var integer v_i := 0;
        var integer v_after := 0;
        while (v_i < 10) {
            v_i := v_i + 1;
            if (v_i == 4) {
                break;
            }
        }
        v_after := v_i;
        if (v_after == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
