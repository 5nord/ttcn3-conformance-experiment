// @requirement: 19.4.1 -- The boolean expression terminates the loop and the second assignment is used to manipulate the index variable.
// @id: TTCN3-CORE-19.4.1-005b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_04_01_the_counter_loop_005 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i;
        var integer v_trace := 0;
        for (v_i := 1; v_i < 100; v_i := v_i * 3) {
            v_trace := v_trace * 100 + v_i;
        }
        if (v_trace == 103092781 and v_i == 243) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
