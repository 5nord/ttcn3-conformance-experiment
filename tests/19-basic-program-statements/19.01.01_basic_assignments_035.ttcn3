// @requirement: 19.1.1 -- e) Using a reference to an omitted field in the right-hand side of the assignment has the same effect as using the omit keyword.
// @id: TTCN3-CORE-19.1.1-038a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_basic_assignments_035 {

    type component C {}

    type record R {
        integer a,
        integer b optional
    }

    testcase TC() runs on C {
        var R v_src := { a := 1, b := omit };
        var R v_dst1 := { a := 2, b := 3 };
        var R v_dst2 := { a := 2, b := 3 };
        v_dst1.b := v_src.b;
        v_dst2.b := omit;
        if (not ispresent(v_dst1.b) and v_dst1 == v_dst2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
