// @requirement: 19.7 -- a) A label statement can be used freely like other TTCN-3 behavioural program statements according to the syntax rules defined in annex A.
// @id: TTCN3-CORE-19.7-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_07_the_label_statement_004 {

    type component C {
        timer T;
    }

    testcase TC() runs on C {
        var integer v_i := 0;
        label L_1;
        if (v_i == 0) {
            label L_2;
            v_i := v_i + 1;
        } else {
            label L_3;
        }
        while (v_i < 3) {
            label L_4;
            v_i := v_i + 1;
        }
        T.start(0.1);
        alt {
            [] T.timeout {
                label L_5;
                v_i := v_i + 1;
            }
        }
        if (v_i == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
