// @requirement: 19.13 -- continue
// @id: TTCN3-CORE-19.13-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_13_the_continue_statement_002 {
    type component C {}

    testcase TC() runs on C {
        var integer v_i := 0;
        var integer v_count := 0;
        while (v_i < 4) {
            v_i := v_i + 1;
            if (v_i == 2) {
                continue
            }
            v_count := v_count + 1;
        }
        if (v_count == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
