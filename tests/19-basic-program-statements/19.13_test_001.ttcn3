// @requirement: 19.13 -- A continue statement causes the start of the next iteration of a loop.
// @id: TTCN3-CORE-19.13-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_13_test_001 {
    type component C {}

    testcase TC() runs on C {
        var integer v_sum := 0;
        for (var integer v_i := 1; v_i <= 5; v_i := v_i + 1) {
            if (v_i mod 2 == 0) {
                continue;
            }
            v_sum := v_sum + v_i;
        }
        if (v_sum == 9) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
