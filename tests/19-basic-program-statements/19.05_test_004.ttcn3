// @requirement: 19.5 -- The loop condition may be preceded by an init statement (variable declaration or assignment), which executes before the expression is evaluated.
// @id: TTCN3-CORE-19.5-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_05_test_004 {

    type component C {}

    testcase TC() runs on C {
        var integer v_j := 100;
        var integer v_count := 0;
        while (v_j := 0; v_j < 3) {
            v_j := v_j + 1;
            v_count := v_count + 1;
            if (v_count > 10) {
                break;
            }
        }
        if (v_count == 3 and v_j == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
