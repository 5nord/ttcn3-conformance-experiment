// @requirement: 19.1.1 -- Table 17: Overview of TTCN-3 basic program statements: For loop; Col2: for (…) {…}
// @id: TTCN3-CORE-19.1.1-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_test_020 {

    type component C {}

    testcase TC() runs on C {
        var integer v_sum := 0;
        for (var integer i := 1; i <= 4; i := i + 1) {
            v_sum := v_sum + i;
        }
        if (v_sum == 10) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
