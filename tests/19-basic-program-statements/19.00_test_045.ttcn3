// @requirement: 19.0 -- Statement: Set local verdict; Associated keyword or symbol: setverdict; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-018c
// @verdict: pass reject
module M_19_00_test_045 {

    type component C {}

    function f_guard() runs on C return boolean {
        setverdict(pass); // error: setverdict in function called from an alt guard
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
