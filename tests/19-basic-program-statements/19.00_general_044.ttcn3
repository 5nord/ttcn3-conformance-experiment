// @requirement: 19.0 -- Statement: Set local verdict; Associated keyword or symbol: setverdict; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-018b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_00_general_044 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
        if (getverdict != pass) {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
