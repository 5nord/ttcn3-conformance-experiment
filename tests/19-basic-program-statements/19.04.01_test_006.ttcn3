// @requirement: 19.4.1 -- The termination criterion of the loop shall be expressed by a boolean expression.
// @id: TTCN3-CORE-19.4.1-007a
// @verdict: pass reject
module M_19_04_01_test_006 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i;
        for (v_i := 3; v_i; v_i := v_i - 1) { // error: termination criterion is not boolean
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
