// @requirement: 19.1.1 -- b) When the right-hand side of the assignment evaluates to a template (global or local template, in-line template, template variable or a matching mechanism), the variable at the left hand side shall be a template variable.
// @id: TTCN3-CORE-19.1.1-035a
// @verdict: pass reject
module M_19_01_01_test_032 {

    type component C {}

    testcase TC() runs on C {
        var template integer v_tmpl := 5;
        var integer v_int;
        v_int := v_tmpl; // error: template assigned to a value variable
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
