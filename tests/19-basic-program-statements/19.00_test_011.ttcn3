// @requirement: 19.0 -- Statement: Check (current) message/call received; Associated keyword or symbol: check; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-005b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_00_test_011 {

    type port M message { inout integer }

    type component C {
        port M p1;
        port M p2;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(mtc:p1, mtc:p2);
        p1.send(1);
        T.start;
        alt {
            [] p2.check(receive(1)) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
