// @requirement: 19.8 -- The goto statement can be used in functions, test cases and altsteps to transfer control to a labelled statement.
// @id: TTCN3-CORE-19.8-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_08_test_003 {

    type component C {
        timer T;
        var integer v_count := 0;
    }

    function f_goto() runs on C {
        goto L_F;
        v_count := v_count + 100;
        label L_F;
        v_count := v_count + 1;
    }

    altstep a_goto() runs on C {
        [] T.timeout {
            goto L_A;
            v_count := v_count + 100;
            label L_A;
            v_count := v_count + 1;
        }
    }

    testcase TC() runs on C {
        goto L_TC;
        v_count := v_count + 100;
        label L_TC;
        v_count := v_count + 1;
        f_goto();
        T.start(0.1);
        a_goto();
        if (v_count == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
