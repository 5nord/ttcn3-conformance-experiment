// @requirement: 19.0 -- Statement: Timeout event; Associated keyword or symbol: timeout; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-016c
// @verdict: pass reject
module M_19_00_test_042 {

    type component C {
        timer T_c;
    }

    function f_guard() runs on C return boolean {
        alt {
            [] T_c.timeout {} // error: timeout in function called from an alt guard
            [else] {}
        }
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
