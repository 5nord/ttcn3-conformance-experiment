// @requirement: 19.4.1 -- The boolean expression terminates the loop and the second assignment is used to manipulate the index variable.
// @id: TTCN3-CORE-19.4.1-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_04_01_the_counter_loop_004 {

    type component C {}

    testcase TC() runs on C {
        var integer v_count := 0;
        for (var integer v_i := 0; v_i < 5; v_i := v_i + 1) {
            v_count := v_count + 1;
        }
        if (v_count == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
