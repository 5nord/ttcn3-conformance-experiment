// @requirement: 19.0 -- Statement: Clear queue and enable sending & receiving at a to port; Associated keyword or symbol: start; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-007c
// @verdict: pass reject
module M_19_00_general_018 {

    type port M message { inout integer }

    type component C {
        port M p;
    }

    function f_guard() runs on C return boolean {
        p.start; // error: port start in function called from an alt guard
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
