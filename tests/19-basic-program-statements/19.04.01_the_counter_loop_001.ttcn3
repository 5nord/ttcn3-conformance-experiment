// @requirement: 19.4.1 -- for "(" ( VarInstance | Assignment ) ";" BooleanExpression ";" Assignment ")" StatementBlock
// @id: TTCN3-CORE-19.4.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_04_01_the_counter_loop_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_j;
        var integer v_sum := 0;
        for (v_j := 1; v_j <= 3; v_j := v_j + 1) {
            v_sum := v_sum + v_j;
        }
        for (var integer v_i := 10; v_i > 7; v_i := v_i - 1) {
            v_sum := v_sum + v_i;
        }
        if (v_sum == 33) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
