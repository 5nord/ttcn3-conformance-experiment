// @requirement: 19.1.1 -- Thus, if the variable is fully assigned, it does not need to be evaluated before assignment. When a direct or indirect element or field of a lazy or fuzzy variable is assigned, the variable is also evaluated as much as necessary before assignment, i.e. if an ancestor of that element or field is initialized with a function call, it shall be evaluated.
// @id: TTCN3-CORE-19.1.1-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_test_016 {

    type component C {
        var integer v_calls := 0;
    }

    function f_compute() runs on C return integer {
        v_calls := v_calls + 1;
        return 1;
    }

    testcase TC() runs on C {
        var @lazy integer v_lazy := f_compute();
        var integer v_result;
        v_lazy := 5;
        v_result := v_lazy;
        if (v_result == 5 and v_calls == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
