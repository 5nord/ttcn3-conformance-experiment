// @requirement: 19.0 -- Statement: Clear queue and enable sending & receiving at a to port; Associated keyword or symbol: start; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-007b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_00_test_017 {

    type port M message { inout integer }

    type component C {
        port M p1;
        port M p2;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(mtc:p1, mtc:p2);
        p1.stop;
        p1.start;
        p1.send(1);
        T.start;
        alt {
            [] p2.receive(1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
