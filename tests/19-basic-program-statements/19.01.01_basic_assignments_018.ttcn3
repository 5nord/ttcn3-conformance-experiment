// @id: TTCN3-CORE-19.1.1-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_basic_assignments_018 {

    type component C {}

    testcase TC() runs on C {
        var integer v_int := 1;
        if (v_int > 5) {
            setverdict(fail);
        } else {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
