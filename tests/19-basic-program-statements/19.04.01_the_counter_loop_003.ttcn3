// @requirement: 19.4.1 -- The first assignment is necessary to initialize the index (or counter) variable of the loop.
// @id: TTCN3-CORE-19.4.1-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_04_01_the_counter_loop_003 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 100;
        var integer v_first := -1;
        for (v_i := 3; v_i < 6; v_i := v_i + 1) {
            if (v_first == -1) {
                v_first := v_i;
            }
        }
        if (v_first == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
