// @requirement: 19.11 -- Used in a log statement: running operation (component or timer); What is logged: return value; Comment: true or false. In case of component or timer arrays, array element specification shall be included.
// @id: TTCN3-CORE-19.11-011c
// @verdict: pass reject
module M_19_11_the_log_statement_010 {
    type component C {}

    testcase TC() runs on C {
        timer T_arr[2] := { 1.0, 1.0 };
        T_arr[0].start;
        log(T_arr.running); // error: array element specification missing
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
