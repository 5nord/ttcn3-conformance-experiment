// @requirement: 19.4.1 -- The for statement contains two assignments and a boolean expression.
// @id: TTCN3-CORE-19.4.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_04_01_test_002 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i;
        var integer v_count := 0;
        for (v_i := 0; v_i < 4; v_i := v_i + 2) {
            v_count := v_count + 1;
        }
        for (var float v_f := 1.0; v_f < 7.9; v_f := v_f * 2.0) {
            v_count := v_count + 1;
        }
        if (v_count == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
