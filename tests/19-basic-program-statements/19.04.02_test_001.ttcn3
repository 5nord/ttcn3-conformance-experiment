// @requirement: 19.4.2 -- for "(" [ var TypeOrNestedTypeDef ] ValueRef in Expression ")" StatementBlock
// @id: TTCN3-CORE-19.4.2-002a
// @verdict: pass accept, noexecution
module M_19_04_02_test_001 {

    type record of integer RoI;

    function f_loops() {
        var RoI v_list := {1, 2, 3};
        var integer v_e;
        for (var integer x in v_list) {
            log(x);
        }
        for (var hexstring h in '12D'H) {
            log(h);
        }
        for (v_e in v_list) {
            log(v_e);
        }
    }
}
