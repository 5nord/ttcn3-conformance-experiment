// @requirement: 19.3.1 -- The expression may be preceded by an _init statement (variable declaration or assignment), which executes before the expression is evaluated.
// @id: TTCN3-CORE-19.3.1-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_03_01_the_select_case_statement_005 {

    type component C {}

    testcase TC() runs on C {
        var integer v_y;
        var boolean v_ok := false;
        select (var integer v_x := 1; v_x) {
            case (1) {
                v_ok := true;
            }
        }
        select (v_y := 2; v_y) {
            case (2) {
                if (v_ok) {
                    setverdict(pass);
                }
            }
        }
    }

    control {
        execute(TC());
    }
}
