// @requirement: 19.11 -- Used in a log statement: module parameter identifier; What is logged: actual value
// @id: TTCN3-CORE-19.11-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_test_001 {
    type component C {}

    modulepar integer PX_INT := 1;

    testcase TC() runs on C {
        log(PX_INT);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
