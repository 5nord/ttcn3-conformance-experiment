// @requirement: 19.10 -- If there is no statement block, test execution continues with the first statement following the alt statement.
// @id: TTCN3-CORE-19.10-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_10_the_return_statement_008 {
    type component C {
        var integer v_x := 0;
        timer T;
        timer T2;
    }

    altstep a_ret() runs on C {
        [] T.timeout {
            v_x := 1;
            return;
        }
    }

    testcase TC() runs on C {
        T.start(0.01);
        T2.start(5.0);
        alt {
            [] a_ret();
            [] T2.timeout {
                setverdict(fail);
            }
        }
        if (v_x == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
