// @requirement: 19.3.2 -- The expression in the header may be preceded by an init statement (variable declaration or assignment), which executes before the expression is evaluated.
// @id: TTCN3-CORE-19.3.2-006b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_03_02_the_select_union_statement_006 {

    type component C {}

    type union U {
        integer a,
        boolean b
    }

    testcase TC() runs on C {
        var U v_u := { a := 1 };
        select union (v_u := { b := true }; v_u) {
            case (a) {
                setverdict(fail);
            }
            case (b) {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
