// @requirement: 19.10 -- a) The return statement shall not be present in testcase definitions.
// @id: TTCN3-CORE-19.10-010a
// @verdict: pass reject
module M_19_10_test_010 {
    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
        return; // error: return statement in a testcase
    }

    control {
        execute(TC());
    }
}
