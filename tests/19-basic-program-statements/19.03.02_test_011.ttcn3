// @requirement: 19.3.2 -- If the template instance has type anytype, each branch shall start with the case keyword followed by one or more type names (a list branch) or in the last branch the case keyword may be followed by the else keyword (an else branch) and a statement block.
// @id: TTCN3-CORE-19.3.2-010b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_03_02_test_011 {

    type component C {}

    testcase TC() runs on C {
        var anytype v_any := { boolean := true };
        setverdict(fail);
        select union (v_any) {
            case (integer) {
                setverdict(fail);
            }
            case (charstring) {
                setverdict(fail);
            }
            case else {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
} with {
    extension "anytype integer, charstring, boolean"
}
