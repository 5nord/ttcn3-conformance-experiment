// @requirement: 19.1.1 -- Table 17: Overview of TTCN-3 basic program statements: Next iteration of a loop; Col2: continue
// @id: TTCN3-CORE-19.1.1-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_basic_assignments_027 {

    type component C {}

    testcase TC() runs on C {
        var integer v_sum := 0;
        for (var integer i := 1; i <= 5; i := i + 1) {
            if (i rem 2 == 0) {
                continue;
            }
            v_sum := v_sum + i;
        }
        if (v_sum == 9) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
