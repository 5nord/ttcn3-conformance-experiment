// @requirement: 19.0 -- Statement: Check if timer running; Associated keyword or symbol: running; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-015c
// @verdict: pass reject
module M_19_00_general_039 {

    type component C {
        timer T_c;
    }

    function f_guard() runs on C return boolean {
        return not T_c.running; // error: timer running in function called from an alt guard
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
