// @requirement: 19.0 -- Statement: Stimulate an (SUT) action externally; Associated keyword or symbol: action; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-021c
// @verdict: pass reject
module M_19_00_test_051 {

    type component C {}

    function f_guard() runs on C return boolean {
        action("Stimulus from guard"); // error: action in function called from an alt guard
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
