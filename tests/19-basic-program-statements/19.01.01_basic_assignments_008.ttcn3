// @requirement: 19.1.1 -- In all other cases, the content being assigned shall be a copy of the evaluated right-hand side. If the variable being assigned is of a type whose values are object references, only the reference is copied, but the referenced object (e.g. component, timer or port) is not.
// @id: TTCN3-CORE-19.1.1-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_basic_assignments_008 {

    type component C {}

    type record MyRecord {
        charstring field1,
        charstring field2,
        charstring field3
    }

    testcase TC() runs on C {
        var MyRecord v_myList1, v_myList2;
        v_myList1 := { "value1", "value2", "value3" };
        v_myList2 := v_myList1;
        v_myList2.field1 := "missing";
        if (v_myList1 == { "value1", "value2", "value3" } and
            v_myList2 == { "missing", "value2", "value3" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
