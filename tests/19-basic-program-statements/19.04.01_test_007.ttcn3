// @requirement: 19.4.1 -- It is checked at the beginning of each new loop iteration.
// @id: TTCN3-CORE-19.4.1-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_04_01_test_007 {

    type component C {}

    testcase TC() runs on C {
        var integer v_count := 0;
        var boolean v_continue := true;
        for (var integer v_i := 0; v_i > 0; v_i := v_i + 1) {
            v_count := v_count + 100;
        }
        for (var integer v_i := 0; v_continue; v_i := v_i + 1) {
            v_count := v_count + 1;
            if (v_i == 2) {
                v_continue := false;
            }
        }
        if (v_count == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
