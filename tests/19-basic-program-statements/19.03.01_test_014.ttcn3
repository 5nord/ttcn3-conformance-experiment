// @requirement: 19.3.1 -- The statement block of an else branch is always executed if no other branch textually preceding the else branch has been selected.
// @id: TTCN3-CORE-19.3.1-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_03_01_test_014 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_x := "none";
        setverdict(fail);
        select (v_x) {
            case ("first") {
                setverdict(fail);
            }
            case ("second", "third") {
                setverdict(fail);
            }
            case else {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
