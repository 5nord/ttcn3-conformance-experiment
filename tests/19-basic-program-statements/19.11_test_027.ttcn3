// @requirement: 19.11 -- log "(" { ( FreeText | TemplateInstance ) [","] } ")"
// @id: TTCN3-CORE-19.11-037a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_test_027 {
    type component C {}

    template integer t_int := ?;

    testcase TC() runs on C {
        var integer v_x := 1;
        log("free text");
        log(v_x);
        log("value: ", v_x, " template: ", t_int, integer:(1 .. 2));
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
