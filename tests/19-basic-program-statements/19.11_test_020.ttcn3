// @requirement: 19.11 -- Used in a log statement: valueof operation; What is logged: return value
// @id: TTCN3-CORE-19.11-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_test_020 {
    type component C {}

    template integer t_int := 5;

    testcase TC() runs on C {
        log(valueof(t_int));
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
