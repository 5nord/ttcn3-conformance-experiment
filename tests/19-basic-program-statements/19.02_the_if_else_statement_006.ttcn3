// @requirement: 19.2 -- The optional else specifies a statement block that will be executed if all the "if" and "else if" conditions before are false.
// @id: TTCN3-CORE-19.2-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_02_the_if_else_statement_006 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a := 10;
        if (v_a < 0) {
            setverdict(fail);
        } else if (v_a == 0) {
            setverdict(fail);
        } else if (v_a < 5) {
            setverdict(fail);
        } else {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
