// @requirement: 19.11 -- Used in a log statement: alive operation (component); What is logged: return value; Comment: true or false. In case of arrays, array element specifications shall be included.
// @id: TTCN3-CORE-19.11-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_the_log_statement_011 {
    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        log(v_ptc.alive);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
