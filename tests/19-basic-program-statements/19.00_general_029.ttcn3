// @requirement: 19.0 -- Statement: Start timer; Associated keyword or symbol: start; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-012b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_00_general_029 {

    type component C {}

    testcase TC() runs on C {
        timer T;
        T.start(5.0);
        if (T.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
