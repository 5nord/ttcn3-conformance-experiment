// @requirement: 19.13 -- On executing a continue statement, the subsequent statements of the body of the innermost, currently executed loop are skipped and the next iteration starts.
// @id: TTCN3-CORE-19.13-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_13_the_continue_statement_003 {
    type component C {}

    testcase TC() runs on C {
        var integer v_i := 0;
        var integer v_skipped := 0;
        do {
            v_i := v_i + 1;
            if (v_i > 0) {
                continue;
            }
            v_skipped := v_skipped + 1;
        } while (v_i < 3);
        if (v_i == 3 and v_skipped == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
