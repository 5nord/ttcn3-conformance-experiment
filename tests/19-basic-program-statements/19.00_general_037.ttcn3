// @requirement: 19.0 -- Statement: Check if timer running; Associated keyword or symbol: running; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_00_general_037 {

    type component C {}

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        timer T;
        var boolean v_before := T.running;
        T.start(5.0);
        execute(TC(not v_before and T.running));
    }
}
