// @requirement: 19.4.2 -- The assignment to the iteration variable follows the rules specified in clause 19.1.1 with the exception that assignment of uninitialized elements is permitted.
// @id: TTCN3-CORE-19.4.2-009a
// @verdict: pass reject
module M_19_04_02_the_range_based_loop_011 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var RoI v_range := {1, 2, 3};
        for (var charstring e in v_range) { // error: integer element not compatible with charstring
            log(e);
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
