// @requirement: 19.6 -- The do-while loop is identical to a while loop with the exception that the loop condition shall be checked at the end of each loop iteration.
// @id: TTCN3-CORE-19.6-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_06_test_004 {

    type component C {
        var integer v_evals := 0;
        var integer v_body := 0;
    }

    function f_cond(integer p_limit) runs on C return boolean {
        v_evals := v_evals + 1;
        if (v_evals != v_body) {
            setverdict(fail);
        }
        return v_body < p_limit;
    }

    testcase TC() runs on C {
        setverdict(pass);
        do {
            v_body := v_body + 1;
        } while (f_cond(3));
        if (v_evals != 3 or v_body != 3) {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
