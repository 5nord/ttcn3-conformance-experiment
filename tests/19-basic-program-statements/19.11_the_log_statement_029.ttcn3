// @requirement: 19.11 -- Log items may be individual language elements specified in table 18 or expressions composed of such log items.
// @id: TTCN3-CORE-19.11-040a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_the_log_statement_029 {
    type component C {}

    const charstring c_str := "abc";

    function f_ret() return integer {
        return 2;
    }

    testcase TC() runs on C {
        var integer v_x := 1;
        log(v_x + 1, c_str & "def", f_ret() * v_x, lengthof(c_str) > v_x);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
