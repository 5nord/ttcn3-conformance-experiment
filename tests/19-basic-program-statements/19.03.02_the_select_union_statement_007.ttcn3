// @requirement: 19.3.2 -- The scope of variables declared within an init statement shall be limited to the select union statement.
// @id: TTCN3-CORE-19.3.2-007a
// @verdict: pass reject
module M_19_03_02_the_select_union_statement_007 {

    type component C {}

    type union U {
        integer a,
        boolean b
    }

    testcase TC() runs on C {
        select union (var U v_u := { a := 1 }; v_u) {
            case (a) {
                setverdict(pass);
            }
        }
        v_u := { b := true }; // error: v_u is not visible outside the select union statement
    }

    control {
        execute(TC());
    }
}
