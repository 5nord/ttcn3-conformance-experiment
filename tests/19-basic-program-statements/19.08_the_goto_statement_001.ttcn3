// @requirement: 19.8 -- A goto statement performs a jump to a label.
// @id: TTCN3-CORE-19.8-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_08_the_goto_statement_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        goto L_1;
        v_i := 2;
        label L_1;
        if (v_i == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
