// @requirement: 19.3.2 -- In the header part of the select union statement a template instance of union type or anytype shall be given.
// @id: TTCN3-CORE-19.3.2-005a
// @verdict: pass reject
module M_19_03_02_the_select_union_statement_004 {

    type component C {}

    testcase TC() runs on C {
        var integer v_x := 1;
        select union (v_x) { // error: header is of type integer, not a union type or anytype
            case (a) {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
