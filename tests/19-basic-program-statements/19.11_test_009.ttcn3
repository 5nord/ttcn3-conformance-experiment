// @requirement: 19.11 -- Used in a log statement: running operation (component or timer); What is logged: return value; Comment: true or false. In case of component or timer arrays, array element specification shall be included.
// @id: TTCN3-CORE-19.11-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_test_009 {
    type component C {
        timer T;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        log(v_ptc.running);
        T.start(1.0);
        log(T.running);
        T.stop;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
