// @requirement: 19.3.1 -- The scope of_ variables declared within an init statement shall be limited to the select case statement.
// @id: TTCN3-CORE-19.3.1-008a
// @verdict: pass reject
module M_19_03_01_test_007 {

    type component C {}

    testcase TC() runs on C {
        select (var integer v_x := 1; v_x) {
            case (1) {
                setverdict(pass);
            }
        }
        v_x := 2; // error: v_x is not visible outside the select case statement
    }

    control {
        execute(TC());
    }
}
