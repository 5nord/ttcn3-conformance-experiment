// @requirement: 19.0 -- NOTE: Note that the restriction applies to component of statements defined in the present document, like the boolean condition of if statements, but not to the content of statement blocks embedded into the statements. a) Unless specified differently in the relevant clause, all values and templates used in a basic program statement shall be completely initialized (for exemption see e.g. clause 19.1).
// @id: TTCN3-CORE-19.0-035a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_00_test_056 {

    type component C {}

    type record R {
        integer a,
        integer b
    }

    testcase TC() runs on C {
        var R v_r := { a := 1, b := - };
        if (v_r.a > 0) {
            v_r.b := 2;
        }
        if (isbound(v_r.b) and v_r.b == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
