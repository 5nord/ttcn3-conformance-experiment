// @requirement: 19.0 -- Statement: Catch exception (from called entity); Associated keyword or symbol: catch; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-004c
// @verdict: pass reject
module M_19_00_test_009 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_guard() runs on C return boolean {
        alt {
            [] p.catch(S, integer:?) {} // error: catch in function called from an alt guard
            [else] {}
        }
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
