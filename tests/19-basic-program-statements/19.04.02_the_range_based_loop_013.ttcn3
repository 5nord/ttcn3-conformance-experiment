// @requirement: 19.4.2 -- When an uninitialized value is assigned to the iterator variable, the iterator variable becomes uninitialized.
// @id: TTCN3-CORE-19.4.2-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_04_02_the_range_based_loop_013 {

    type record of charstring RoC;

    type component C {}

    testcase TC() runs on C {
        var RoC v_range := {"a", -, "c"};
        var charstring v_e := "x";
        var integer v_i := 0;
        setverdict(pass);
        for (v_e in v_range) {
            if (v_i == 1 and isbound(v_e)) {
                setverdict(fail);
            }
            v_i := v_i + 1;
        }
    }

    control {
        execute(TC());
    }
}
