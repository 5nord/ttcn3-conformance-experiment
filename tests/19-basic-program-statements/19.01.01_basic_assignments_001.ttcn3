// @requirement: 19.1.1 -- Values or templates may be assigned to variables or template variables (see clause 11).
// @id: TTCN3-CORE-19.1.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_basic_assignments_001 {

    type component C {}

    template integer m_range := (1 .. 10);

    testcase TC() runs on C {
        var integer v_int;
        var template integer v_tmpl;
        v_int := 5;
        v_tmpl := m_range;
        if (v_int == 5 and match(v_int, v_tmpl)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
