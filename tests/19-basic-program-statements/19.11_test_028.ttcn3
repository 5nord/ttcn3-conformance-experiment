// @requirement: 19.11 -- Items to be logged shall be identified by a comma-separated list in the argument of the log statement.
// @id: TTCN3-CORE-19.11-039a
// @verdict: pass reject
module M_19_11_test_028 {
    type component C {}

    testcase TC() runs on C {
        var integer v_x := 1;
        log("value: " v_x); // error: log items not separated by a comma
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
