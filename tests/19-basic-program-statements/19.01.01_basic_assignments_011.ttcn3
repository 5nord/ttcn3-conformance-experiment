// @requirement: 19.1.1 -- Unless the assignment is to a lazy or fuzzy variable or parameter, the right hand side is evaluated completely before the resulting value or template is bound to the evaluated left-hand side of the assignment.
// @id: TTCN3-CORE-19.1.1-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_basic_assignments_011 {

    type component C {}

    type record R {
        integer a,
        integer b
    }

    testcase TC() runs on C {
        var R v_rec := { a := 1, b := 2 };
        v_rec := { a := v_rec.b, b := v_rec.a };
        if (v_rec == { a := 2, b := 1 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
