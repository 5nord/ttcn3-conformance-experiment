// @requirement: 19.5 -- A while statement defines a loop that is executed as long as the loop condition holds.
// @id: TTCN3-CORE-19.5-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_05_test_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 0;
        var integer v_count := 0;
        while (v_i < 5) {
            v_i := v_i + 1;
            v_count := v_count + 1;
        }
        if (v_count == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
