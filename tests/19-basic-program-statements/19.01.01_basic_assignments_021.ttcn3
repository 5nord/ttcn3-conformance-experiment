// @requirement: 19.1.1 -- Table 17: Overview of TTCN-3 basic program statements: While loop; Col2: while (…) {…}
// @id: TTCN3-CORE-19.1.1-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_basic_assignments_021 {

    type component C {}

    testcase TC() runs on C {
        var integer v_count := 0;
        while (v_count < 5) {
            v_count := v_count + 1;
        }
        if (v_count == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
