// @requirement: 19.0 -- Statement: Handle response from a previous call; Associated keyword or symbol: getreply; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_00_test_005 {

    signature S();

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.getcall(S:{}) { p.reply(S:{}); }
            [] T.timeout {}
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{}, 1.0) {
            [] p.getreply(S:{}) { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
