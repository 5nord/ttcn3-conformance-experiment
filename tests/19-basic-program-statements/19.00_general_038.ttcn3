// @requirement: 19.0 -- Statement: Check if timer running; Associated keyword or symbol: running; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-015b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_00_general_038 {

    type component C {}

    testcase TC() runs on C {
        timer T;
        var boolean v_before := T.running;
        T.start(5.0);
        if (not v_before and T.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
