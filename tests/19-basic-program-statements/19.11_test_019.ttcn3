// @requirement: 19.11 -- Used in a log statement: match operation; What is logged: return value; Comment: true or false.
// @id: TTCN3-CORE-19.11-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_test_019 {
    type component C {}

    template integer t_range := (1 .. 5);

    testcase TC() runs on C {
        log(match(3, t_range));
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
