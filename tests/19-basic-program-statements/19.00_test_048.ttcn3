// @requirement: 19.0 -- Statement: Get local verdict; Associated keyword or symbol: getverdict; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes NOTE 1: Specific places are defined in clause 16.1.4.
// @id: TTCN3-CORE-19.0-019c
// @verdict: pass accept, ttcn3verdict:pass
module M_19_00_test_048 {

    type component C {}

    function f_guard() runs on C return boolean {
        return getverdict == none;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
