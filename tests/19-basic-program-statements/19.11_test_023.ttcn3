// @requirement: 19.11 -- Used in a log statement: function instance; What is logged: return value; Comment: Only functions with return clause are allowed.
// @id: TTCN3-CORE-19.11-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_test_023 {
    type component C {}

    function f_ret() return integer {
        return 1;
    }

    testcase TC() runs on C {
        log(f_ret());
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
