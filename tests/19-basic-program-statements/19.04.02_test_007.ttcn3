// @requirement: 19.4.2 -- In each iteration the appropriate element is assigned to the iteration variable and the statement block is executed.
// @id: TTCN3-CORE-19.4.2-006b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_04_02_test_007 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_range := "abc";
        var charstring v_result := "";
        var integer v_count := 0;
        for (var charstring e in v_range) {
            v_count := v_count + 1;
            v_result := v_result & e;
        }
        if (v_count == 3 and v_result == "abc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
