// @requirement: 19.6 -- do StatementBlock while "(" BooleanExpression ")"
// @id: TTCN3-CORE-19.6-002a
// @verdict: pass accept, noexecution
module M_19_06_the_do_while_statement_002 {

    function f_loop() {
        var integer v_j := 0;
        do {
            v_j := v_j + 1;
        } while (v_j < 10);
    }
}
