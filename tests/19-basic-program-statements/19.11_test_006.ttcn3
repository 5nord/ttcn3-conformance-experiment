// @requirement: 19.11 -- Used in a log statement: variable identifier; What is logged: actual value or "UNINITIALIZED"; Comment: See notes 3 and 4.
// @id: TTCN3-CORE-19.11-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_test_006 {
    type component C {}

    testcase TC() runs on C {
        var integer v_init := 1;
        var integer v_uninit;
        log(v_init);
        log(v_uninit);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
