// @requirement: 19.0 -- Statement: Catch exception (from called entity); Associated keyword or symbol: catch; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-004b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_00_general_008 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.getcall(S:{}) { p.raise(S, 1); }
            [] T.timeout {}
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{}, 1.0) {
            [] p.catch(S, integer:1) { setverdict(pass); }
            [] p.getreply(S:{}) { setverdict(fail); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
