// @requirement: 19.1.1 -- Table 17: Overview of TTCN-3 basic program statements: Select case; Col2: select case (…) { case (…) {…} case else {…}}
// @id: TTCN3-CORE-19.1.1-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_test_019 {

    type component C {}

    testcase TC() runs on C {
        var integer v_int := 3;
        select (v_int) {
            case (1) {
                setverdict(fail);
            }
            case (3) {
                setverdict(pass);
            }
            case else {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
