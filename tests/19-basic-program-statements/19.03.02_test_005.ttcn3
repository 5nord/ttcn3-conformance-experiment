// @requirement: 19.3.2 -- The expression in the header may be preceded by an init statement (variable declaration or assignment), which executes before the expression is evaluated.
// @id: TTCN3-CORE-19.3.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_03_02_test_005 {

    type component C {}

    type union U {
        integer a,
        boolean b
    }

    testcase TC() runs on C {
        var U v_w;
        var boolean v_ok := false;
        select union (var U v_u := { a := 1 }; v_u) {
            case (a) {
                v_ok := true;
            }
        }
        select union (v_w := { b := true }; v_w) {
            case (b) {
                if (v_ok) {
                    setverdict(pass);
                }
            }
        }
    }

    control {
        execute(TC());
    }
}
