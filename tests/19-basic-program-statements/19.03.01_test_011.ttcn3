// @requirement: 19.3.1 -- All templateInstance in all list branches shall be of a type compatible with the type of the expression in the header.
// @id: TTCN3-CORE-19.3.1-010a
// @verdict: pass reject
module M_19_03_01_test_011 {

    type component C {}

    testcase TC() runs on C {
        var integer v_x := 1;
        select (v_x) {
            case (1) {
                setverdict(pass);
            }
            case ("two") { // error: charstring template is not compatible with integer
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
