// @requirement: 19.1.1 -- Assignments use the rules of passing by value.
// @id: TTCN3-CORE-19.1.1-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_basic_assignments_006 {

    type component C {}

    type record of integer RoI;

    testcase TC() runs on C {
        var RoI v_a := { 1, 2, 3 };
        var RoI v_b;
        v_b := v_a;
        v_a[0] := 10;
        v_b[2] := 30;
        if (v_a == { 10, 2, 3 } and v_b == { 1, 2, 30 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
