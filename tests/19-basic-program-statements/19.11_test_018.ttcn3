// @requirement: 19.11 -- Used in a log statement: read operation; What is logged: return value; Comment: See clause 23.4.
// @id: TTCN3-CORE-19.11-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_test_018 {
    type component C {
        timer T;
    }

    testcase TC() runs on C {
        T.start(1.0);
        log(T.read);
        T.stop;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
