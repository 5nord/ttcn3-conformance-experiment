// @requirement: 19.7 -- The label is used by the goto statement (see clause 19.8) to transfer control to a labelled statement.
// @id: TTCN3-CORE-19.7-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_07_test_003 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 0;
        goto L_Target;
        v_i := 100;
        label L_Target;
        v_i := v_i + 1;
        if (v_i == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
