// @requirement: 19.3.2 -- a) The SingleExpression in the header of the select union statement shall be of a union type.
// @id: TTCN3-CORE-19.3.2-014a
// @verdict: pass reject
module M_19_03_02_the_select_union_statement_015 {

    type component C {}

    type record R {
        integer a,
        boolean b
    }

    testcase TC() runs on C {
        var R v_r := { a := 1, b := true };
        select union (v_r) { // error: header expression is of a record type, not a union type
            case (a) {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
