// @requirement: 19.3.1 -- Each branch starts with the case keyword followed by a list of templateInstance (a list branch, which may also contain a single element) or in the last branch the case keyword may be followed by the else keyword (an else branch) and a statement block.
// @id: TTCN3-CORE-19.3.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_03_01_test_008 {

    type component C {}

    template integer m_odd := (1, 3, 5);

    testcase TC() runs on C {
        var integer v_x := 4;
        setverdict(fail);
        select (v_x) {
            case (0) {
                setverdict(fail);
            }
            case (m_odd, integer:7, (8 .. 9)) {
                setverdict(fail);
            }
            case (2, 4, 6) {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
