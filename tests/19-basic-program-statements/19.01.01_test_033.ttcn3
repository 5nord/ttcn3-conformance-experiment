// @requirement: 19.1.1 -- c) The right-hand side of an assignment shall evaluate to an object that is at least partially initialized.
// @id: TTCN3-CORE-19.1.1-036a
// @verdict: pass accept, ttcn3verdict:error
module M_19_01_01_test_033 {

    type component C {}

    type record R {
        integer a,
        integer b
    }

    testcase TC() runs on C {
        var R v_src;
        var R v_dst := { a := 1, b := 2 };
        setverdict(pass);
        v_dst := v_src; // error: right-hand side is completely uninitialized
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
