// @requirement: 19.12 -- Execution continues with the statement following the surrounding alt statement.
// @id: TTCN3-CORE-19.12-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_12_test_008 {
    type component C {
        timer T_step;
    }

    altstep a_step() runs on C {
        [] T_step.timeout {
            break;
        }
    }

    testcase TC() runs on C {
        var integer v_iterations := 0;
        var integer v_afterAlt := 0;
        for (var integer v_i := 0; v_i < 2; v_i := v_i + 1) {
            v_iterations := v_iterations + 1;
            T_step.start(0.05);
            alt {
                [] a_step() {
                    setverdict(fail);
                }
            }
            v_afterAlt := v_afterAlt + 1;
        }
        if (v_iterations == 2 and v_afterAlt == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
