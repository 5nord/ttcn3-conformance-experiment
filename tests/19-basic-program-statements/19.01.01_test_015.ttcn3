// @requirement: 19.1.1 -- When a direct or indirect element or field of a lazy or fuzzy variable is assigned, the variable is also evaluated as much as necessary before assignment, i.e. if an ancestor of that element or field is initialized with a function call, it shall be evaluated.
// @id: TTCN3-CORE-19.1.1-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_test_015 {

    type component C {
        var integer v_cCalls := 0;
        var integer v_aCalls := 0;
    }

    type record Point {
        float x,
        float y
    }

    type record MyRecord {
        Point c,
        integer a
    }

    function f_computeC() runs on C return Point {
        v_cCalls := v_cCalls + 1;
        return { x := 1.0, y := 2.0 };
    }

    function f_computeA() runs on C return integer {
        v_aCalls := v_aCalls + 1;
        return 3;
    }

    testcase TC() runs on C {
        var @lazy MyRecord v_r := {
            c := f_computeC(),
            a := f_computeA()
        };
        v_r.c.x := 5.0;
        if (v_cCalls == 1 and v_aCalls == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        if (v_r.c.x != 5.0 or v_r.c.y != 2.0) {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
