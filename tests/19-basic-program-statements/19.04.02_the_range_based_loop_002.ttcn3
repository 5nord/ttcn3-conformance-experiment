// @requirement: 19.4.2 -- The range expression is evaluated once before beginning the loop and may be partially initialized.
// @id: TTCN3-CORE-19.4.2-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_04_02_the_range_based_loop_002 {

    type record of integer RoI;

    type component C {
        var integer v_calls := 0;
    }

    function f_range() runs on C return RoI {
        v_calls := v_calls + 1;
        return {1, 2, 3};
    }

    testcase TC() runs on C {
        var integer v_sum := 0;
        for (var integer x in f_range()) {
            v_sum := v_sum + x;
        }
        if (v_calls == 1 and v_sum == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
