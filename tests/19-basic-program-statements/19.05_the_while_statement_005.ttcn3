// @requirement: 19.5 -- The scope of variables declared within an init statement shall be limited to the while statement.
// @id: TTCN3-CORE-19.5-004a
// @verdict: pass reject
module M_19_05_the_while_statement_005 {

    type component C {}

    testcase TC() runs on C {
        while (var integer v_k := 0; v_k < 3) {
            v_k := v_k + 1;
        }
        log(v_k); // error: v_k is not visible outside the while statement
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
