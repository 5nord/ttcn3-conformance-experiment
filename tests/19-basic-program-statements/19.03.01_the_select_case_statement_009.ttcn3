// @requirement: 19.3.1 -- Each branch starts with the case keyword followed by a list of templateInstance (a list branch, which may also contain a single element) or in the last branch the case keyword may be followed by the else keyword (an else branch) and a statement block.
// @id: TTCN3-CORE-19.3.1-009b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_03_01_the_select_case_statement_009 {

    type component C {}

    testcase TC() runs on C {
        var integer v_x := 3;
        select (v_x) {
            case (1) {
                setverdict(fail);
            }
            case (2) {
                setverdict(fail);
            }
            case else {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
