// @requirement: 19.6 -- A do-while statement defines a loop that is executed up until the loop condition does not hold.
// @id: TTCN3-CORE-19.6-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_06_the_do_while_statement_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 0;
        var integer v_count := 0;
        do {
            v_i := v_i + 1;
            v_count := v_count + 1;
        } while (v_i < 5);
        if (v_count == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
