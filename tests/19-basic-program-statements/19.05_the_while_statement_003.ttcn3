// @requirement: 19.5 -- The loop condition may be preceded by an init statement (variable declaration or assignment), which executes before the expression is evaluated.
// @id: TTCN3-CORE-19.5-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_05_the_while_statement_003 {

    type component C {}

    testcase TC() runs on C {
        var integer v_j := 10;
        var integer v_count := 0;
        while (var integer v_k := 0; v_k < 3) {
            v_k := v_k + 1;
            v_count := v_count + 1;
        }
        while (v_j := 0; v_j < 2) {
            v_j := v_j + 1;
            v_count := v_count + 1;
        }
        if (v_count == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
