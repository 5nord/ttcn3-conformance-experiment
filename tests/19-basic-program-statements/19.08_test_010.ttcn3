// @requirement: 19.8 -- c) It is not allowed to use the goto statement within an interleave statement.
// @id: TTCN3-CORE-19.8-009a
// @verdict: pass reject
module M_19_08_test_010 {

    type component C {
        timer T;
    }

    testcase TC() runs on C {
        T.start(0.1);
        interleave {
            [] T.timeout {
                goto L_1; // error: goto within an interleave statement
                label L_1;
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
