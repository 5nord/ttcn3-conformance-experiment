// @requirement: 19.0 -- a) Unless specified differently in the relevant clause, all values and templates used in a basic program statement shall be completely initialized (for exemption see e.g. clause 19.1).
// @id: TTCN3-CORE-19.0-034a
// @verdict: pass accept, ttcn3verdict:error
module M_19_00_test_055 {

    type component C {}

    type record R {
        integer a,
        integer b
    }

    testcase TC() runs on C {
        var R v_r := { a := 1, b := - };
        if (v_r.b > 0) { // error: condition uses an uninitialized value
            setverdict(fail);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
