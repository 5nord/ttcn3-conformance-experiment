// @requirement: 19.11 -- Used in a log statement: predefined functions; What is logged: return value; Comment: See annex C.
// @id: TTCN3-CORE-19.11-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_test_022 {
    type component C {}

    testcase TC() runs on C {
        log(lengthof("abc"));
        log(int2str(5));
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
