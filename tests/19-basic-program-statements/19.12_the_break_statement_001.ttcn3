// @requirement: 19.12 -- A break statement causes the exit from a loop, from an altstep or from an alt or interleave statement.
// @id: TTCN3-CORE-19.12-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_12_the_break_statement_001 {
    type component C {}

    testcase TC() runs on C {
        var integer v_i := 0;
        var boolean v_altLeft := false;
        timer T_guard := 0.1;
        while (true) {
            v_i := v_i + 1;
            if (v_i == 3) {
                break;
            }
        }
        T_guard.start;
        alt {
            [] T_guard.timeout {
                if (v_i == 3) {
                    break;
                }
                setverdict(fail);
            }
        }
        v_altLeft := true;
        if (v_i == 3 and v_altLeft) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
