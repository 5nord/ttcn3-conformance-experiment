// @requirement: 19.11 -- Used in a log statement: port instance; What is logged: actual state; Comment: Port states shall be logged according to note 6.
// @id: TTCN3-CORE-19.11-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_test_014 {
    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        log(p);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
