// @requirement: 19.3.1 -- a) The select _SingleExpression and the case TemplateInstance-s shall be type compatible._
// @id: TTCN3-CORE-19.3.1-023a
// @verdict: pass reject
module M_19_03_01_test_018 {

    type component C {}

    type record R1 {
        integer f1
    }

    type record R2 {
        boolean f1
    }

    testcase TC() runs on C {
        var R1 v_r := { f1 := 1 };
        select (v_r) {
            case (R2:{ f1 := true }) { // error: R2 is not type compatible with R1
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
