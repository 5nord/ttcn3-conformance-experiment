// @requirement: 19.1.1 -- Table 17: Overview of TTCN-3 basic program statements: Do while loop; Col2: do {…} while (…)
// @id: TTCN3-CORE-19.1.1-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_basic_assignments_022 {

    type component C {}

    testcase TC() runs on C {
        var integer v_count := 10;
        do {
            v_count := v_count + 1;
        } while (v_count < 5);
        if (v_count == 11) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
