// @requirement: 19.11 -- Used in a log statement: timer name; What is logged: actual state; Comment: Timer states shall be logged according to note 8.
// @id: TTCN3-CORE-19.11-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_test_017 {
    type component C {
        timer T;
    }

    testcase TC() runs on C {
        log(T);
        T.start(1.0);
        log(T);
        T.stop;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
