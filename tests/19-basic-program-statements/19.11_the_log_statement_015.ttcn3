// @requirement: 19.11 -- Used in a log statement: default type variable identifier; What is logged: actual state or "UNINITIALIZED"; Comment: Default states shall be logged according to note 7. See also notes 2 to 4.
// @id: TTCN3-CORE-19.11-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_the_log_statement_015 {
    type component C {
        timer T;
    }

    altstep a_def() runs on C {
        [] T.timeout {}
    }

    testcase TC() runs on C {
        var default v_def;
        log(v_def);
        v_def := activate(a_def());
        log(v_def);
        deactivate(v_def);
        log(v_def);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
