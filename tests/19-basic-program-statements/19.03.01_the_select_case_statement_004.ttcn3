// @requirement: 19.3.1 -- In the header part of the select case statement an expression shall be given.
// @id: TTCN3-CORE-19.3.1-006a
// @verdict: pass reject
module M_19_03_01_the_select_case_statement_004 {

    type component C {}

    testcase TC() runs on C {
        select () { // error: no expression in the header
            case (1) {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
