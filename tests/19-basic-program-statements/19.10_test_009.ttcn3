// @requirement: 19.10 -- The return value or template is first evaluated before returning.
// @id: TTCN3-CORE-19.10-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_10_test_009 {
    type component C {}

    function f_value(integer p_x) return integer {
        var integer v_y := p_x * 2;
        return v_y + 1;
    }

    function f_template(integer p_x) return template integer {
        var integer v_low := p_x;
        return (v_low .. v_low + 1);
    }

    testcase TC() runs on C {
        if (f_value(3) == 7 and match(5, f_template(4)) and not match(3, f_template(4))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
