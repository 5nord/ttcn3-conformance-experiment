// @requirement: 19.4.2 -- The assignment to the iteration variable follows the rules specified in clause 19.1.1 with the exception that assignment of uninitialized elements is permitted.
// @id: TTCN3-CORE-19.4.2-009b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_04_02_the_range_based_loop_012 {

    type record of charstring RoC;

    type component C {}

    testcase TC() runs on C {
        var RoC v_range := {"a", -, "c"};
        var charstring v_e;
        var integer v_count := 0;
        for (v_e in v_range) {
            v_count := v_count + 1;
        }
        if (v_count == 3 and v_e == "c") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
