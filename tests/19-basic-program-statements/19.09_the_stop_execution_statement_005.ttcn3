// @requirement: 19.9 -- NOTE: The semantics of a stop statement that terminates a test component is identical to the stop component operation self.stop (see clause 21.3.3).
// @id: TTCN3-CORE-19.9-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_09_the_stop_execution_statement_005 {
    type component C {}

    function f_stop() runs on C {
        var boolean v_stop := true;
        setverdict(pass);
        if (v_stop) {
            stop;
        }
        setverdict(fail);
    }

    function f_self_stop() runs on C {
        var boolean v_stop := true;
        setverdict(pass);
        if (v_stop) {
            self.stop;
        }
        setverdict(fail);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        v_ptc1.start(f_stop());
        v_ptc2.start(f_self_stop());
        v_ptc1.done;
        v_ptc2.done;
        if (v_ptc1.running == v_ptc2.running and v_ptc1.alive == v_ptc2.alive) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
