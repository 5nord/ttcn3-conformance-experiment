// @requirement: 19.13 -- On executing a continue statement, the subsequent statements of the body of the innermost, currently executed loop are skipped and the next iteration starts.
// @id: TTCN3-CORE-19.13-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_19_13_test_004 {
    type component C {}

    testcase TC() runs on C {
        var integer v_outer := 0;
        var integer v_innerIterations := 0;
        var integer v_afterInner := 0;
        while (v_outer < 2) {
            v_outer := v_outer + 1;
            for (var integer v_j := 1; v_j <= 3; v_j := v_j + 1) {
                v_innerIterations := v_innerIterations + 1;
                if (v_j >= 1) {
                    continue;
                }
                setverdict(fail);
            }
            v_afterInner := v_afterInner + 1;
        }
        if (v_innerIterations == 6 and v_afterInner == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
