// @requirement: 19.9 -- When invoked in a test case, altstep or function that are executed on a test component, it terminates the relevant test component.
// @id: TTCN3-CORE-19.9-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_09_test_004 {
    type component C {
        timer T;
    }

    altstep a_stop() runs on C {
        [] T.timeout {
            setverdict(pass);
            stop;
        }
    }

    function f_ptc() runs on C {
        T.start(0.01);
        a_stop();
        setverdict(fail);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc());
        v_ptc.done;
        if (v_ptc.running) {
            setverdict(fail);
        } else {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
