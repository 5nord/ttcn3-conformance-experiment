// @requirement: 19.11 -- Used in a log statement: literal value; What is logged: value; Comment: This includes also free text.
// @id: TTCN3-CORE-19.11-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_test_002 {
    type component C {}

    testcase TC() runs on C {
        log(1, 1.5, true, 'FF'O, '0101'B, "abc", pass);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
