// @requirement: 19.10 -- When used in functions, a return statement may be optionally associated with a return value or template.
// @id: TTCN3-CORE-19.10-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_10_test_004 {
    type component C {
        var integer v_x := 0;
    }

    function f_value() return integer {
        return 5;
    }

    function f_template() return template integer {
        return (1 .. 3);
    }

    function f_no_value() runs on C {
        v_x := 1;
        return;
    }

    testcase TC() runs on C {
        f_no_value();
        if (f_value() == 5 and match(2, f_template()) and v_x == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
