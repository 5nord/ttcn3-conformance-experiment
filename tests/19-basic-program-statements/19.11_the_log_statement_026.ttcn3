// @requirement: 19.11 -- Used in a log statement: external function instance; What is logged: return value; Comment: Only external functions with return clause are allowed.
// @id: TTCN3-CORE-19.11-024c
// @verdict: pass reject
module M_19_11_the_log_statement_026 {
    type component C {}

    external function xf_no_ret();

    function f() {
        log(xf_no_ret()); // error: external function without return clause
    }
}
