// @requirement: 19.2 -- Boolean expressions may be preceded by an init statement (variable declaration or assignment), which executes before the expression is evaluated.
// @id: TTCN3-CORE-19.2-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_02_the_if_else_statement_007 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a := 0;
        var boolean v_ok := false;
        if (var integer v_x := 3; v_x > 5) {
            setverdict(fail);
        } else if (v_a := v_x; v_a == 3) {
            v_ok := true;
        }
        if (v_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
