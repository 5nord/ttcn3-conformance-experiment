// @requirement: 19.4.1 -- The index variable of a for loop can be declared before being used in the for statement or can be declared and initialized in the for statement header.
// @id: TTCN3-CORE-19.4.1-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_04_01_the_counter_loop_011 {

    type component C {}

    testcase TC() runs on C {
        var integer v_j;
        var integer v_count := 0;
        for (v_j := 1; v_j <= 10; v_j := v_j + 1) {
            v_count := v_count + 1;
        }
        if (v_count == 10 and v_j == 11) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
