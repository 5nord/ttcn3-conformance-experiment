// @requirement: 19.1.1 -- The evaluations obey the operator precedence defined in table 6.
// @id: TTCN3-CORE-19.1.1-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_basic_assignments_010 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a, v_b;
        var boolean v_c;
        v_a := 2 + 3 * 4;
        v_b := 20 - 6 / 2 - 1;
        v_c := not false and false or true;
        if (v_a == 14 and v_b == 16 and v_c) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
