// @requirement: 19.6 -- The do-while loop is identical to a while loop with the exception that the loop condition shall be checked at the end of each loop iteration.
// @id: TTCN3-CORE-19.6-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_06_test_003 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 0;
        var integer v_sum1 := 0;
        var integer v_sum2 := 0;
        while (v_i < 4) {
            v_i := v_i + 1;
            v_sum1 := v_sum1 + v_i;
        }
        v_i := 0;
        do {
            v_i := v_i + 1;
            v_sum2 := v_sum2 + v_i;
        } while (v_i < 4);
        if (v_sum1 == 10 and v_sum2 == v_sum1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
