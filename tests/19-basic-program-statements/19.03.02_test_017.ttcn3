// @requirement: 19.3.2 -- b) Every Identifier in a case of the select union statement shall be an identifier of an alternative of the union type of the template instance given to the statement's header.
// @id: TTCN3-CORE-19.3.2-016a
// @verdict: pass reject
module M_19_03_02_test_017 {

    type component C {}

    type union U {
        integer a,
        boolean b
    }

    testcase TC() runs on C {
        var U v_u := { a := 1 };
        select union (v_u) {
            case (a) {
                setverdict(pass);
            }
            case (z) { // error: z is not an alternative of U
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
