// @requirement: 19.11 -- Used in a log statement: alive operation (component); What is logged: return value; Comment: true or false. In case of arrays, array element specifications shall be included.
// @id: TTCN3-CORE-19.11-012c
// @verdict: pass reject
module M_19_11_test_012 {
    type component C {}

    testcase TC() runs on C {
        var C v_ptcs[2];
        v_ptcs[0] := C.create alive;
        v_ptcs[1] := C.create alive;
        log(v_ptcs.alive); // error: array element specification missing
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
