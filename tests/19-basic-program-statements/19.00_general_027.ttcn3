// @requirement: 19.0 -- Statement: Check the state of a port; Associated keyword or symbol: checkstate; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-19.0-010c
// @verdict: pass reject
module M_19_00_general_027 {

    type port M message { inout integer }

    type component C {
        port M p;
    }

    function f_guard() runs on C return boolean {
        return p.checkstate("Started"); // error: checkstate in function called from an alt guard
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
