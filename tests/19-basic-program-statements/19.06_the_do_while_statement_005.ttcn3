// @requirement: 19.6 -- This means when using a do-while loop the behaviour is executed at least once before the loop condition is evaluated for the first time.
// @id: TTCN3-CORE-19.6-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_06_the_do_while_statement_005 {

    type component C {}

    testcase TC() runs on C {
        var integer v_body := 0;
        do {
            v_body := v_body + 1;
        } while (false);
        if (v_body == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
