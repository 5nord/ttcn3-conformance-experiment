// @requirement: 19.11 -- Used in a log statement: function instance; What is logged: return value; Comment: Only functions with return clause are allowed.
// @id: TTCN3-CORE-19.11-023c
// @verdict: pass reject
module M_19_11_the_log_statement_024 {
    type component C {}

    function f_no_ret() {
    }

    testcase TC() runs on C {
        log(f_no_ret()); // error: function without return clause
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
