// @requirement: 19.5 -- while "(" [(VarInstance|Assignment) ";"] BooleanExpression ")" StatementBlock
// @id: TTCN3-CORE-19.5-002a
// @verdict: pass accept, noexecution
module M_19_05_the_while_statement_002 {

    function f_loops() {
        var integer v_j := 0;
        while (v_j < 10) {
            v_j := v_j + 1;
        }
        while (var integer v_k := 0; v_k < 10) {
            v_k := v_k + 1;
        }
        while (v_j := 0; v_j < 10) {
            v_j := v_j + 1;
        }
    }
}
