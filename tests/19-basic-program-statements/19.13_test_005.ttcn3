// @requirement: 19.13 -- Using continue outside the body of a loop (for, while, do-while) shall cause an error.
// @id: TTCN3-CORE-19.13-004a
// @verdict: pass reject
module M_19_13_test_005 {
    type component C {}

    function f_test() {
        var integer v_i := 1;
        if (v_i == 1) {
            continue; // error: continue outside the body of a loop
        }
    }

    testcase TC() runs on C {
        f_test();
        setverdict(pass);
    }
}
