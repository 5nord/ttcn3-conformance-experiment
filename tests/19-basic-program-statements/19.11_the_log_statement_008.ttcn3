// @requirement: 19.11 -- Used in a log statement: create operation; What is logged: actual state and the component instance name; Comment: The actual state is always set to Inactive.
// @id: TTCN3-CORE-19.11-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_the_log_statement_008 {
    type component C {}

    testcase TC() runs on C {
        log(C.create);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
