// @requirement: 19.11 -- Used in a log statement: checkstate operation; What is logged: return value; Comment: true or false.
// @id: TTCN3-CORE-19.11-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_11_the_log_statement_013 {
    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        log(p.checkstate("Started"));
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
