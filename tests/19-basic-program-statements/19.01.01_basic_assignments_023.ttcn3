// @requirement: 19.1.1 -- Table 17: Overview of TTCN-3 basic program statements: Label and Goto; Col2: label / goto
// @id: TTCN3-CORE-19.1.1-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_01_01_basic_assignments_023 {

    type component C {}

    testcase TC() runs on C {
        var integer v_count := 0;
        label L_start;
        v_count := v_count + 1;
        if (v_count < 3) {
            goto L_start;
        }
        if (v_count == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
