// @requirement: 19.3.1 -- Never more than one of the branches is executed.
// @id: TTCN3-CORE-19.3.1-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_03_01_test_003 {

    type component C {}

    testcase TC() runs on C {
        var integer v_x := 5;
        var template integer v_any := ?;
        var template integer v_range := (1 .. 10);
        var integer v_count := 0;
        select (v_x) {
            case (5) {
                v_count := v_count + 1;
            }
            case (v_range) {
                v_count := v_count + 1;
            }
            case (v_any) {
                v_count := v_count + 1;
            }
            case else {
                v_count := v_count + 1;
            }
        }
        if (v_count == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
