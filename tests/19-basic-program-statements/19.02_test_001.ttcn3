// @requirement: 19.2 -- if "(" [ ( VarInstance | Assignment ) ";" ] BooleanExpression ")" StatementBlock { else if "(" [ ( VarInstance | Assignment ) ";" ] BooleanExpression ")" StatementBlock } [ else StatementBlock]
// @id: TTCN3-CORE-19.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_19_02_test_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a := 0;
        var integer v_result := 0;
        if (v_a > 0) {
            v_result := 1;
        }
        if (var integer v_x := 5; v_x < 3) {
            v_result := 2;
        } else if (v_a := 7; v_a < v_x) {
            v_result := 3;
        } else if (v_a == 0) {
            v_result := 4;
        } else {
            v_result := 5;
        }
        if (v_result == 5 and v_a == 7) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
