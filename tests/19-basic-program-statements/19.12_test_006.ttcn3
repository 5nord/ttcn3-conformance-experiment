// @requirement: 19.12 -- Using break outside the body of a loop (for, while, do-while) or an alternative of an alt or interleave statement shall cause an error.
// @id: TTCN3-CORE-19.12-016a
// @verdict: pass reject
module M_19_12_test_006 {
    type component C {}

    function f_test() {
        var integer v_i := 1;
        if (v_i == 1) {
            break; // error: break outside loop, alt, interleave or altstep
        }
    }

    testcase TC() runs on C {
        f_test();
        setverdict(pass);
    }
}
