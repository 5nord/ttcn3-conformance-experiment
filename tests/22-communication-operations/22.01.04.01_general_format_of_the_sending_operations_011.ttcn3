// @requirement: 22.1.4.1 -- The response and exception handling part of the call operation makes use of getreply and catch operations to provide the required functionality.
// @id: TTCN3-CORE-22.1.4.1-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_04_01_general_format_of_the_sending_operations_011 {

    signature S(in integer p_x) return integer exception (charstring);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        var integer v_x;
        p.getcall(S:{?}) -> param(v_x);
        if (v_x > 0) {
            p.reply(S:{-} value v_x);
        } else {
            p.raise(S, charstring:"invalid");
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{0}, 1.0) {
            [] p.getreply(S:{-}) { setverdict(fail); }
            [] p.catch(S, charstring:"invalid") { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
