// @requirement: 22.1.1 -- Table 22: Overview of TTCN-3 communication operations: Clear port queue; Col2: clear; Col3: Yes; Col4: Yes
// @id: TTCN3-CORE-22.1.1-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_01_principles_of_message_based_communication_025 {

    signature S(in integer p_x) noblock;

    type port P message {
        inout integer
    }

    type port PP procedure {
        inout S
    }

    type component C {
        port P pm;
        port PP pp;
    }

    testcase TC() runs on C {
        pm.clear;
        pp.clear;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
