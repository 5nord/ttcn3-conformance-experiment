// @requirement: 22.1.2 -- TTCN-3 supports blocking and non-blocking procedure-based communication.
// @id: TTCN3-CORE-22.1.2-002b
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_02_principles_of_procedure_based_communication_002 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_server() runs on C {
        T.start;
        alt {
            [] p.getcall(S:{1}) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{1});
        setverdict(pass);
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
