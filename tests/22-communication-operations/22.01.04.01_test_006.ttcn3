// @requirement: 22.1.4.1 -- The address part (denoted by the to keyword) is optional and need only be specified in cases of one-to-many connections where:
// @id: TTCN3-CORE-22.1.4.1-007b
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_04_01_test_006 {

    signature S(in integer p_x) return integer exception (charstring);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        var integer v_x;
        p.getcall(S:{?}) -> param(v_x);
        p.reply(S:{-} value v_x + 1);
        p.getcall(S:{?});
        p.raise(S, charstring:"error");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var boolean v_ok1 := false, v_ok2 := false;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{1}, 1.0) {
            [] p.getreply(S:{-} value 2) { v_ok1 := true; }
            [] p.catch(timeout) {}
        }
        p.call(S:{2}, 1.0) {
            [] p.catch(S, charstring:"error") { v_ok2 := true; }
            [] p.catch(timeout) {}
        }
        if (v_ok1 and v_ok2) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
