// @requirement: 22.3.3 -- The reply operation is used to reply to a previously accepted call according to the procedure signature.
// @id: TTCN3-CORE-22.3.3-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_03_the_reply_operation_003 {

    signature S(in integer p_x, out integer p_y) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        var integer v_x;
        p.getcall(S:{?, -}) -> param(v_x := p_x);
        p.reply(S:{-, v_x + 1} value v_x * 10);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{4, -}, 1.0) {
            [] p.getreply(S:{-, 5} value 40) { setverdict(pass); }
            [] p.getreply { setverdict(fail); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
