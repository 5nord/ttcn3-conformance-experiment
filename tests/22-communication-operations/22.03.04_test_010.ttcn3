// @requirement: 22.3.4 -- The assignment of out and inout parameter values to variables shall be made in the assignment part of the getreply operation.
// @id: TTCN3-CORE-22.3.4-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_04_test_010 {

    signature S(out integer p_y, inout integer p_z);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        var integer v_z;
        p.getcall(S:{-, ?}) -> param(v_z := p_z);
        p.reply(S:{10, v_z + 1});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_y, v_z;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{-, 1}, nowait);
        p.getreply(S:{?, ?}) -> param(v_y, v_z);
        if (v_y == 10 and v_z == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
