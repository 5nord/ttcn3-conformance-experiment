// @requirement: 22.2.2 -- Each assignment notation member of the list allows storing the value of the field or element of the received message, which is referenced on the right hand side of the assignment notation (:=), in the variable or formal parameter on the left hand side.
// @id: TTCN3-CORE-22.2.2-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_the_receive_operation_022 {

    type record of integer RoI;

    type record R {
        integer a,
        RoI b
    }

    type port P message { inout R }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_send() runs on C {
        p.send(R:{1, {10, 20}});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_a, v_b1;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.receive(R:?) -> value (v_a := a, v_b1 := b[1]) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        if (v_a == 1 and v_b1 == 20) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
