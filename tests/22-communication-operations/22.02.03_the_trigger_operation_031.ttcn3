// @requirement: 22.2.3 -- c) Type mismatch at storing the received value or parts of the received value and storing the sender shall cause an error.
// @id: TTCN3-CORE-22.2.3-036a
// @verdict: pass reject
module M_22_02_03_the_trigger_operation_031 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var charstring v_cs;
        p.trigger(integer:?) -> value v_cs; // error: integer value stored in charstring variable
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
