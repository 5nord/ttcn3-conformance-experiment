// @requirement: 22.3.1 -- A non-blocking procedure has no out and inout parameters, no return value and the non-blocking property is indicated in the corresponding signature definition by means of a noblock keyword.
// @id: TTCN3-CORE-22.3.1-034b
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_test_022 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_server() runs on C {
        T.start;
        alt {
            [] p.getcall(S:{1}) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{1}); // non-blocking: no response and exception handling part
        setverdict(pass);
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
