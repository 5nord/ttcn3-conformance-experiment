// @requirement: 22.3.4 -- f) The index redirection shall only be used when the operation is used on an any from port array construct.
// @id: TTCN3-CORE-22.3.4-043a
// @verdict: pass reject
module M_22_03_04_test_041 {

    signature S() return integer;

    type port P procedure { inout S }

    type component C {
        port P p[2];
    }

    function f_server() runs on C {
        p[1].getcall(S:{});
        p[1].reply(S:{} value 1);
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        var integer v_i;
        timer T := 1.0;
        for (var integer i := 0; i < 2; i := i + 1) {
            connect(self:p[i], v_ptc:p[i]);
        }
        v_ptc.start(f_server());
        p[1].call(S:{}, nowait);
        T.start;
        alt {
            [] p[1].getreply(S:{} value 1) -> @index value v_i { setverdict(pass); } // error: index redirection without any from
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
