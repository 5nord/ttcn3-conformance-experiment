// @requirement: 22.3.1 -- The use of else branches and the invocation of altsteps is not allowed.
// @id: TTCN3-CORE-22.3.1-060b
// @verdict: pass reject
module M_22_03_01_the_call_operation_050 {

    signature S(in integer p_x);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    altstep a_reply() runs on C {
        [] p.getreply(S:{-}) {}
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.call(S:{1}, 1.0) {
            [] a_reply() {} // error: altstep invocation in a call body
            [] p.catch(timeout) {}
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
