// @requirement: 22.3.2 -- When assigning individual parameters of a call, encoded parameters can be decoded prior to assignment using the @decoded modifier.
// @id: TTCN3-CORE-22.3.2-015a
// @verdict: pass accept, noexecution
module M_22_03_02_test_012 {

    signature S(in octetstring p_enc) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_getcall() runs on C {
        var integer v_i;
        p.getcall(S:{?}) -> param(v_i := @decoded p_enc);
    }
}
