// @requirement: 22.5.2 -- The start operation enables sending and receiving operations on the port(s).
// @id: TTCN3-CORE-22.5.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_02_test_001 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        all port.stop;
        all port.start;
        p1.send(1);
        T.start;
        alt {
            [] p2.receive(1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
