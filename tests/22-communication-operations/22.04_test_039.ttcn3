// @requirement: 22.4 -- e) If the index redirection is used for single-dimensional arrays, the type of the integer variable shall allow storing the highest index of the respective port array.
// @id: TTCN3-CORE-22.4-036a
// @verdict: pass reject
module M_22_04_test_039 {

    type port MP message { inout integer; }

    type integer SmallIndex (0..2);

    type component C {
        port MP src;
        port MP pa[5];
        timer T := 1.0;
    }

    testcase TC() runs on C {
        var SmallIndex v_idx;
        connect(mtc:src, mtc:pa[0]);
        src.send(5);
        T.start;
        alt {
            [] any from pa.check(receive(5) -> @index value v_idx) { setverdict(pass); } // error: highest index 4 not in SmallIndex
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
