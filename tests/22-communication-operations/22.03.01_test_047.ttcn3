// @requirement: 22.3.1 -- h) The selection of the alternatives to a call shall only be based on getreply and catch operations for the called procedure.
// @id: TTCN3-CORE-22.3.1-058b
// @verdict: pass reject
module M_22_03_01_test_047 {

    signature S1(in integer p_x);
    signature S2(in integer p_x);

    type port P procedure { inout S1, S2 }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.call(S1:{1}, 1.0) {
            [] p.getreply(S2:{-}) {} // error: getreply for a procedure other than the called one
            [] p.catch(timeout) {}
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
