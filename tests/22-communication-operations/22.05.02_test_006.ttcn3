// @requirement: 22.5.2 -- By default, all ports of a component shall be started implicitly when a component is created.
// @id: TTCN3-CORE-22.5.2-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_02_test_006 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
    }

    function f_check() runs on C {
        if (all port.checkstate("Started")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        f_check();
        v_ptc.start(f_check());
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
