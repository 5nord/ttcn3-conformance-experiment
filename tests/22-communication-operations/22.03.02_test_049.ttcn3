// @requirement: 22.3.2 -- NOTE 3: An error due to a type mismatch may happen if the types in the receive part are not compatible to the types in the assignment part or, if the from clause is missing, but the type of the sender can be determined and it is not type compatible with the type in the sender clause.
// @id: TTCN3-CORE-22.3.2-050a
// @verdict: pass reject
module M_22_03_02_test_049 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_getcall() runs on C {
        var charstring v_cs;
        p.getcall(S:{?}) -> param(v_cs); // error: integer parameter assigned to charstring variable
    }
}
