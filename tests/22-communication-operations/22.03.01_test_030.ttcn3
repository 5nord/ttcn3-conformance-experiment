// @requirement: 22.3.1 -- In case of a multicast or broadcast call operation of a non-blocking procedure, all exceptions which may be raised from the different communication partners can be handled in subsequent catch, alt or interleave statements.
// @id: TTCN3-CORE-22.3.1-042a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_test_030 {

    signature S(in integer p_x) noblock exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 2.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server(integer p_exc) runs on C {
        alt {
            [] p.getcall(S:{?}) { p.raise(S, p_exc); repeat; }
        }
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc1.start(f_server(1));
        v_ptc2.start(f_server(2));
        activate(a_guard());
        T.start;
        p.call(S:{0}) to (v_ptc1, v_ptc2);
        interleave {
            [] p.catch(S, integer:1) from v_ptc1 {}
            [] p.catch(S, integer:2) from v_ptc2 {}
        }
        p.call(S:{0}) to all component;
        p.catch(S, integer:?) from v_ptc1;
        alt {
            [] p.catch(S, integer:?) from v_ptc2 { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
