// @requirement: 22.3.2 -- g) The PortArrayRef shall be a reference to a completely initialized port array.
// @id: TTCN3-CORE-22.3.2-043a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_02_test_040 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component CS {
        port P pa[2][2];
        timer T := 1.0;
    }

    type component CC {
        port P p;
    }

    altstep a_guard() runs on CS {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_client() runs on CC {
        p.call(S:{1});
    }

    testcase TC() runs on CS {
        var CC v_ptc := CC.create;
        var integer v_idx[2];
        connect(mtc:pa[1][1], v_ptc:p);
        v_ptc.start(f_client());
        activate(a_guard());
        T.start;
        any from pa.getcall(S:{1}) -> @index value v_idx;
        if (v_idx == {1, 1}) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
