// @requirement: 22.2.3 -- k) The ObjectReference shall be of a port type.
// @id: TTCN3-CORE-22.2.3-046a
// @verdict: pass reject
module M_22_02_03_test_046 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T;
    }

    testcase TC() runs on C {
        T.trigger(integer:?); // error: ObjectReference is a timer
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
