// @requirement: 22.3.1 -- The call operation may optionally include a timeout.
// @id: TTCN3-CORE-22.3.1-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_the_call_operation_013 {

    signature S(in integer p_x) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    const float c_timeout := 1.0;

    function f_server() runs on C {
        var integer v_x;
        alt {
            [] p.getcall(S:{?}) -> param(v_x) { p.reply(S:{-} value v_x); repeat; }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{1}, 1.0) {
            [] p.getreply(S:{-} value 1) { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
        p.call(S:{2}, c_timeout) {
            [] p.getreply(S:{-} value 2) { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
        p.call(S:{3}) {
            [] p.getreply(S:{-} value 3) { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
