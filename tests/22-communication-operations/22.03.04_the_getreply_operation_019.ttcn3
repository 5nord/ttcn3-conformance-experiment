// @requirement: 22.3.4 -- In case the parameter or referenced field of the return value is of the universal `charstring type, the @decoded clause can contain an` optional parameter defining the encoding format.
// @id: TTCN3-CORE-22.3.4-021a
// @verdict: pass accept, noexecution
module M_22_03_04_the_getreply_operation_019 {

    type record R {
        universal charstring f
    }

    signature S(out universal charstring p_enc) return R;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_getreply() runs on C {
        var integer v_i, v_j;
        p.getreply(S:{?} value ?) -> value (v_j := @decoded("UTF-16") f) param(v_i := @decoded("UTF-8") p_enc);
    }
}
