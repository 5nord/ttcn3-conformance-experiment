// @requirement: 22.2.2 -- In the case of one-to-many connections the receive operation may be restricted to a certain communication partner.
// @id: TTCN3-CORE-22.2.2-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_test_011 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_send() runs on C {
        p.send(1);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc1.start(f_send());
        T.start;
        alt {
            [] p.receive(integer:1) from v_ptc2 { setverdict(fail); }
            [] p.receive(integer:1) from v_ptc1 { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
