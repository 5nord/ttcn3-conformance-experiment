// @requirement: 22.2.1 -- The send operation places a message on an outgoing message port.
// @id: TTCN3-CORE-22.2.1-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_01_test_003 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_receive() runs on C {
        T.start;
        alt {
            [] p.receive(integer:5) { setverdict(pass); }
            [] p.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_receive());
        p.send(5);
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
