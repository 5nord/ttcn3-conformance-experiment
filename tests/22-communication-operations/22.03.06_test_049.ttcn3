// @requirement: 22.3.6 -- No AddressRef in the from clause shall contain the special value null at the time of the operation.
// @id: TTCN3-CORE-22.3.6-053a
// @verdict: pass accept, ttcn3verdict:error
module M_22_03_06_test_049 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.raise(S, integer:1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var C v_null := null;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{}, nowait);
        p.catch(S, integer:?) from v_null; // error: from clause contains null
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
