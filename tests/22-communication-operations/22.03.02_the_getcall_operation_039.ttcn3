// @requirement: 22.3.2 -- No AddressRef in the from clause shall contain the special value null at the time of the operation.
// @id: TTCN3-CORE-22.3.2-042a
// @verdict: pass accept, ttcn3verdict:error
module M_22_03_02_the_getcall_operation_039 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_client() runs on C {
        p.call(S:{1});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var C v_null := null;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_client());
        activate(a_guard());
        T.start;
        p.check(getcall);
        p.getcall(S:{?}) from v_null; // error: AddressRef is null
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
