// @requirement: 22.2.3 -- The matching criteria as defined in clause 22.2.2 apply also to the trigger operation.
// @id: TTCN3-CORE-22.2.3-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_test_009 {

    type record R { integer a, charstring b }

    type port P message { inout R }

    type component C {
        port P p;
        port P q;
        timer T := 1.0;
    }

    template R mw_r := { a := (1 .. 3), b := pattern "ab*" };

    testcase TC() runs on C {
        var R v_r;
        connect(mtc:p, mtc:q);
        q.send(R:{ a := 5, b := "ab" });
        q.send(R:{ a := 2, b := "xy" });
        q.send(R:{ a := 2, b := "abb" });
        T.start;
        alt {
            [] p.trigger(mw_r) -> value v_r {
                if (v_r == { a := 2, b := "abb" }) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
