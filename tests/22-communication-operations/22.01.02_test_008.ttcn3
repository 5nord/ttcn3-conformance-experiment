// @requirement: 22.1.2 -- The CALLEE accepts the call by means of a getcall operation and reacts by either using a reply operation to answer the call or by raising (raise operation) an exception.
// @id: TTCN3-CORE-22.1.2-007b
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_02_test_008 {

    signature S(in integer p_x) return integer exception (charstring);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        var integer v_x;
        p.getcall(S:{?}) -> param(v_x);
        p.reply(S:{-} value v_x);
        p.getcall(S:{?}) -> param(v_x);
        p.raise(S, charstring:"failed");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var boolean v_replied := false;
        var boolean v_raised := false;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{1}, 1.0) {
            [] p.getreply(S:{-} value 1) { v_replied := true; }
            [] p.catch(S, charstring:?) {}
            [] p.catch(timeout) {}
        }
        p.call(S:{2}, 1.0) {
            [] p.getreply(S:{-}) {}
            [] p.catch(S, charstring:"failed") { v_raised := true; }
            [] p.catch(timeout) {}
        }
        if (v_replied and v_raised) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
