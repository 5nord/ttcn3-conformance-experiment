// @requirement: 22.2.1 -- d) A to clause shall be present in case of one-to-many connections.
// @id: TTCN3-CORE-22.2.1-024a
// @verdict: pass accept, ttcn3verdict:error
module M_22_02_01_the_send_operation_015 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        setverdict(pass);
        p.send(1); // error: no to clause on a one-to-many connection
    }

    control {
        execute(TC());
    }
}
