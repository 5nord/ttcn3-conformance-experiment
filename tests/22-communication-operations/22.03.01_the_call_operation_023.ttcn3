// @requirement: 22.3.1 -- Possible exceptions raised by non-blocking procedures have to be removed from the port queue by using catch operations in subsequent alt or interleave statements.
// @id: TTCN3-CORE-22.3.1-035a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_the_call_operation_023 {

    signature S(in integer p_x) noblock exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{?});
        p.raise(S, 1);
        p.getcall(S:{?});
        p.raise(S, 2);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{1});
        p.call(S:{2});
        interleave {
            [] p.catch(S, integer:1) {}
            [] p.catch(S, integer:2) {}
        }
        alt {
            [] p.catch { setverdict(fail); } // all exceptions have been removed
            [else] { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
