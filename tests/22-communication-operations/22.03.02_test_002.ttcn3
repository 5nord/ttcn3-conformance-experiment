// @requirement: 22.3.2 -- NOTE 1: _Address may be an AddressRef, a list of AddressRef-s or "any component"._
// @id: TTCN3-CORE-22.3.2-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_02_test_002 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_client() runs on C {
        p.call(S:{1});
        p.call(S:{2});
        p.call(S:{3});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var C v_other := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_client());
        activate(a_guard());
        T.start;
        p.getcall(S:{1}) from v_ptc;
        p.getcall(S:{2}) from (v_other, v_ptc);
        p.getcall(S:{3}) from any component;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
