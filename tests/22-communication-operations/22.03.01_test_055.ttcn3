// @requirement: 22.3.1 -- l) The call operation for a non-blocking procedure shall have no response and exception handling part, shall raise no timeout exception and shall not use the nowait keyword.
// @id: TTCN3-CORE-22.3.1-065b
// @verdict: pass reject
module M_22_03_01_test_055 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.call(S:{1}, 1.0); // error: timeout value for a non-blocking procedure
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
