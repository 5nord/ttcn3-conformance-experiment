// @requirement: 22.1.4.2 -- The matching part needs only be present if the content of the received communication shall be restricted.
// @id: TTCN3-CORE-22.1.4.2-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_04_02_general_format_of_the_receiving_operations_005 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_ptc() runs on C {
        p.send(integer:42);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_ptc());
        T.start;
        alt {
            [] p.receive { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
