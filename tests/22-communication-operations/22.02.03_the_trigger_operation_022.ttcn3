// @requirement: 22.2.3 -- The first port which matches all the criteria will cause the operation to be successful even if other ports in the array would also meet the criteria.
// @id: TTCN3-CORE-22.2.3-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_the_trigger_operation_022 {

    type port P message { inout integer }

    type component C {
        port P p[3];
        port P q[3];
        timer T := 1.0;
        timer T_wait := 0.2;
    }

    function f_connect() runs on C {
        for (var integer i := 0; i < 3; i := i + 1) {
            connect(mtc:p[i], mtc:q[i]);
        }
    }

    testcase TC() runs on C {
        var integer v_i;
        f_connect();
        q[0].send(5);
        q[2].send(5);
        T_wait.start;
        T_wait.timeout;
        T.start;
        alt {
            [] any from p.trigger(integer:5) -> @index value v_i {
                if (v_i != 0) { setverdict(fail); stop; }
            }
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] p[2].receive(integer:5) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
