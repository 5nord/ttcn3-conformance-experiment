// @requirement: 22.2.2 -- j) If the index redirection is used for multi-dimensional port arrays, the size of the integer array or record of integer type shall exactly be the same as the dimension of the respective array, and its type shall allow storing the highest index (from all dimensions) of the array.
// @id: TTCN3-CORE-22.2.2-067a
// @verdict: pass reject
module M_22_02_02_the_receive_operation_061 {

    type port P message { inout integer }

    type component C {
        port P p[2][2];
    }

    testcase TC() runs on C {
        var integer v_idx[3];
        any from p.receive(integer:?) -> @index value v_idx; // error: array size 3 for 2-dimensional port array
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
