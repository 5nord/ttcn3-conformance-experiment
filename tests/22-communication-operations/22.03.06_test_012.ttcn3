// @requirement: 22.3.6 -- In this case, the referenced field on the right hand sided of the assignment shall be one of the bitstring, hexstring, octetstring, charstring or universal charstring types.
// @id: TTCN3-CORE-22.3.6-014a
// @verdict: pass reject
module M_22_03_06_test_012 {

    type record E {
        integer id,
        octetstring payload
    }

    signature S() exception (E);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_catch() runs on C {
        var integer v_i;
        p.catch(S, E:?) -> value (v_i := @decoded id); // error: decoded field of type integer
    }
}
