// @requirement: 22.3.6 -- Failure of this decoding shall cause a test case error.
// @id: TTCN3-CORE-22.3.6-016a
// @verdict: pass accept, ttcn3verdict:error
module M_22_03_06_the_catch_operation_014 {

    type record E {
        octetstring payload
    }

    signature S() exception (E);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.raise(S, E:{payload := ''O});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_i;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{}, nowait);
        p.catch(S, E:?) -> value (v_i := @decoded payload); // error: empty octetstring cannot be decoded
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
