// @requirement: 22.2.3 -- The trigger operation can be used as a stand-alone statement in a behaviour description.
// @id: TTCN3-CORE-22.2.3-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_test_025 {

    type port P message { inout integer }

    type component C {
        port P p;
        port P q;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(mtc:p, mtc:q);
        q.send(1);
        p.trigger(integer:1);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
