// @requirement: 22.2.3 -- e) The PortArrayRef shall be a reference to a completely initialized port array.
// @id: TTCN3-CORE-22.2.3-040a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_test_038 {

    type port P message { inout integer }

    type component C {
        port P p[2];
        timer T := 1.0;
    }

    type component S {
        port P p;
    }

    function f_send() runs on S {
        p.send(1);
    }

    testcase TC() runs on C {
        var S v_ptc0 := S.create, v_ptc1 := S.create;
        var integer v_i;
        connect(mtc:p[0], v_ptc0:p);
        connect(mtc:p[1], v_ptc1:p);
        v_ptc1.start(f_send());
        T.start;
        alt {
            [] any from p.trigger(integer:1) -> @index value v_i {
                if (v_i == 1) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
