// @requirement: 22.1.4.2 -- For message-based ports it is used when it is required to store received messages.
// @id: TTCN3-CORE-22.1.4.2-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_04_02_test_008 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_ptc() runs on C {
        p.send(integer:42);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_msg := 0;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_ptc());
        T.start;
        alt {
            [] p.receive(integer:?) -> value v_msg {}
            [] T.timeout {}
        }
        if (v_msg == 42) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
