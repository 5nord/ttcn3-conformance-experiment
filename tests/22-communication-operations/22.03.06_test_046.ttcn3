// @requirement: 22.3.6 -- f) If CatchAnyException is used in the response and exception handling part of a call operation, it shall only treat exceptions raised by the procedure invoked by the call operation.
// @id: TTCN3-CORE-22.3.6-051a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_test_046 {

    signature S1() exception (integer);
    signature S2() exception (integer);

    type port P procedure { inout S1, S2 }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S2:{});
        p.raise(S2, integer:2);
        p.getcall(S1:{});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S2:{}, nowait);
        p.check(catch(S2, integer:2));
        p.call(S1:{}, 0.2) {
            [] p.catch(timeout) { setverdict(pass); }
            [] p.catch { setverdict(fail); } // must not treat the exception of S2
        }
    }

    control {
        execute(TC());
    }
}
