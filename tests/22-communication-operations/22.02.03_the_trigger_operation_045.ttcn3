// @requirement: 22.2.3 -- j) If the trigger operation contains both from and sender clause, the variable or parameter referenced in the sender clause shall be type compatible with the template in the from clause.
// @id: TTCN3-CORE-22.2.3-045a
// @verdict: pass reject
module M_22_02_03_the_trigger_operation_045 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    type component D {
        port P p;
        timer T;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var D v_d;
        connect(mtc:p, v_ptc:p);
        p.trigger(integer:?) from v_ptc -> sender v_d; // error: D is not compatible with C
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
