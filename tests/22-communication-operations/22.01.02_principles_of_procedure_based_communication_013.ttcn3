// @requirement: 22.1.2 -- The CALLER may handle the exception by using a catch operation in an alt statement.
// @id: TTCN3-CORE-22.1.2-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_02_principles_of_procedure_based_communication_013 {

    signature S(in integer p_x) noblock exception (charstring);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_server() runs on C {
        p.getcall(S:{?});
        p.raise(S, charstring:"failed");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var charstring v_exc := "";
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{1});
        T.start;
        alt {
            [] p.catch(S, charstring:?) -> value v_exc {
                if (v_exc == "failed") { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
