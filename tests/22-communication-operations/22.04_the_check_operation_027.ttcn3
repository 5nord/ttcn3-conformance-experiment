// @requirement: 22.4 -- To check on any port from a specific port array, indices use the any from PortArrayRef syntax where PortArrayRef shall be a reference to a port array identifier.
// @id: TTCN3-CORE-22.4-025b
// @verdict: pass reject
module M_22_04_the_check_operation_027 {

    type port MP message { inout integer; }

    type component C {
        port MP p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(mtc:p1, mtc:p2);
        p1.send(5);
        T.start;
        alt {
            [] any from p2.check(receive(5)) { setverdict(pass); } // error: p2 is not a port array
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
