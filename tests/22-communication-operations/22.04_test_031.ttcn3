// @requirement: 22.4 -- If the port array is multi-dimensional, then the ports are iterated over from innermost to outermost array dimension from lowest to highest index for each dimension, e.g. [0][0], [0][1], [1][0], [1][1].
// @id: TTCN3-CORE-22.4-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_04_test_031 {

    type port MP message { inout integer; }

    type component C {
        port MP src[2][2];
        port MP pa[2][2];
        timer T := 1.0;
    }

    testcase TC() runs on C {
        var integer v_idx[2] := {-1, -1};
        connect(mtc:src[1][0], mtc:pa[1][0]);
        connect(mtc:src[0][1], mtc:pa[0][1]);
        src[1][0].send(10);
        src[0][1].send(1);
        T.start;
        alt {
            [] pa[1][0].check { }
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] pa[0][1].check { }
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] any from pa.check(receive(integer:?) -> @index value v_idx) { }
            [else] { setverdict(fail); stop; }
        }
        if (v_idx[0] == 0 and v_idx[1] == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
