// @requirement: 22.4 -- It is also possible to store the index of a port in a single-dimensional port array at which the operation was successful to a variable of type integer or, in case of multi-dimensional port arrays the index of the successful port to an integer array or record of integer variable.
// @id: TTCN3-CORE-22.4-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_04_test_028 {

    type port MP message { inout integer; }

    type component C {
        port MP src;
        port MP pa[3];
        timer T := 1.0;
    }

    testcase TC() runs on C {
        var integer v_idx := -1;
        connect(mtc:src, mtc:pa[2]);
        src.send(5);
        T.start;
        alt {
            [] any from pa.check(receive(5) -> @index value v_idx) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        if (v_idx == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
