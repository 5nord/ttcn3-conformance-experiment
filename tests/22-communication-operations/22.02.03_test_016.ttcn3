// @requirement: 22.2.3 -- To trigger on a message at any port from a specific port array, use the any from PortArrayRef syntax where PortArrayRef shall be a reference to a port array identifier.
// @id: TTCN3-CORE-22.2.3-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_test_016 {

    type port P message { inout integer }

    type component C {
        port P p[3];
        port P q[3];
        timer T := 1.0;
        timer T_wait := 0.2;
    }

    function f_connect() runs on C {
        for (var integer i := 0; i < 3; i := i + 1) {
            connect(mtc:p[i], mtc:q[i]);
        }
    }

    testcase TC() runs on C {
        f_connect();
        q[1].send(1);
        T.start;
        alt {
            [] any from p.trigger(integer:1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
