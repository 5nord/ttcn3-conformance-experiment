// @requirement: 22.3.1 -- The actual assignment of the procedure return value and out and inout parameter values to variables shall explicitly be made in the response and exception handling part of the call operation by means of getreply and catch operations.
// @id: TTCN3-CORE-22.3.1-053a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_the_call_operation_041 {

    signature S(out integer p_o, inout integer p_io) return integer exception (charstring);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{-, 1});
        p.reply(S:{10, 20} value 30);
        p.getcall(S:{-, 2});
        p.raise(S, "exc");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_o := 0, v_io := 1, v_res := 0;
        var charstring v_exc := "";
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{-, v_io}, 1.0) {
            [] p.getreply(S:{?, ?} value ?) -> value v_res param(v_o, v_io) {}
            [] p.catch(timeout) { setverdict(fail); stop; }
        }
        p.call(S:{-, 2}, 1.0) {
            [] p.catch(S, charstring:?) -> value v_exc {}
            [] p.catch(timeout) { setverdict(fail); stop; }
        }
        if (v_o == 10 and v_io == 20 and v_res == 30 and v_exc == "exc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
