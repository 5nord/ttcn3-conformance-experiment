// @requirement: 22.3.6 -- To catch an exception on any port use the any keyword.
// @id: TTCN3-CORE-22.3.6-034a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_the_catch_operation_028 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p1;
        port P p2;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p1.getcall(S:{});
        p1.raise(S, integer:1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p2, v_ptc:p1);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p2.call(S:{}, nowait);
        any port.catch;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
