// @requirement: 22.5.2 -- If a port is defined as allowing receiving operations such as receive, getcall, etc. the start operation clears the incoming queue of the named port and starts listening for traffic over the port.
// @id: TTCN3-CORE-22.5.2-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_02_the_start_port_operation_004 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p2.stop;
        p2.start;
        p1.send(1);
        T.start;
        alt {
            [] p2.receive(1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
