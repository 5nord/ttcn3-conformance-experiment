// @requirement: 22.3.4 -- The parameter shall be of the charstring type and it shall contain one of the strings allowed for the decvalue_unichar function (specified in clause C.5.4).
// @id: TTCN3-CORE-22.3.4-022b
// @verdict: pass reject
module M_22_03_04_test_021 {

    signature S(out universal charstring p_enc);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_getreply() runs on C {
        var integer v_i;
        p.getreply(S:{?}) -> param(v_i := @decoded("UTF-9") p_enc); // error: not an allowed encoding format
    }
}
