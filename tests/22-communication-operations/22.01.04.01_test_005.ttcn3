// @requirement: 22.1.4.1 -- The address part (denoted by the to keyword) is optional and need only be specified in cases of one-to-many connections where:
// @id: TTCN3-CORE-22.1.4.1-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_04_01_test_005 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_ptc() runs on C {
        T.start;
        alt {
            [] p.receive(integer:1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_ptc());
        p.send(integer:1);
        v_ptc.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
