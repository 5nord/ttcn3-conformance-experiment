// @requirement: 22.1.4.1 -- multicast communication is used and a set of receiving entities has to be explicitly identified;
// @id: TTCN3-CORE-22.1.4.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_04_01_test_008 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 0.5;
    }

    function f_server(boolean p_expect) runs on C {
        T.start;
        alt {
            [] p.getcall(S:{1}) {
                if (p_expect) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout {
                if (p_expect) { setverdict(fail); } else { setverdict(pass); }
            }
        }
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create, v_ptc3 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        connect(mtc:p, v_ptc3:p);
        v_ptc1.start(f_server(true));
        v_ptc2.start(f_server(false));
        v_ptc3.start(f_server(true));
        p.call(S:{1}) to (v_ptc1, v_ptc3);
        all component.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
