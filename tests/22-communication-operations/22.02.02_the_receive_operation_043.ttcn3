// @requirement: 22.2.2 -- If the port array is multi-dimensional, then the ports are iterated over from innermost to outermost array dimension from lowest to highest index for each dimension, e.g. [0][0], [0][1], [1][0], [1][1].
// @id: TTCN3-CORE-22.2.2-050a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_the_receive_operation_043 {

    type port P message { inout integer }

    type component C {
        port P p[2][2];
        port P q[2][2];
        timer T := 1.0;
        timer T_wait := 0.2;
    }

    testcase TC() runs on C {
        var integer v_idx[2];
        for (var integer i := 0; i < 2; i := i + 1) {
            for (var integer j := 0; j < 2; j := j + 1) {
                connect(mtc:p[i][j], mtc:q[i][j]);
            }
        }
        q[1][0].send(10);
        q[0][1].send(1);
        T_wait.start;
        T_wait.timeout;
        T.start;
        alt {
            [] any from p.receive(integer:?) -> @index value v_idx {
                if (v_idx == {0, 1}) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
