// @requirement: 22.5.1 -- Table 25: Overview of TTCN-3 port operations: Stop port; Col2: stop
// @id: TTCN3-CORE-22.5.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_01_test_007 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1;
    }

    testcase TC() runs on C {
        p1.stop;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
