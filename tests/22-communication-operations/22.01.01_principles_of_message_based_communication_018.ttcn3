// @requirement: 22.1.1 -- Table 22: Overview of TTCN-3 communication operations: Raise exception (to an accepted call); Col2: raise; Col4: Yes
// @id: TTCN3-CORE-22.1.1-016b
// @verdict: pass reject
module M_22_01_01_principles_of_message_based_communication_018 {

    signature S(in integer p_x) return integer exception (charstring);

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.raise(S, "err"); // error: raise used at a message-based port
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
