// @requirement: 22.3.4 -- m) The @nodefault modifier is allowed only in stand-alone getreply statements.
// @id: TTCN3-CORE-22.3.4-052a
// @verdict: pass reject
module M_22_03_04_the_getreply_operation_051 {

    signature S() return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.reply(S:{} value 1);
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        timer T := 1.0;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{}, nowait);
        T.start;
        alt {
            [] @nodefault p.getreply(S:{} value 1) { setverdict(pass); } // error: @nodefault in an alt branch
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
