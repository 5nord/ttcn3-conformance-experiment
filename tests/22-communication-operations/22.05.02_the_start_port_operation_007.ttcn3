// @requirement: 22.5.2 -- The start port operation will cause unstopped ports to be restarted by removing all messages waiting in the incoming queue.
// @id: TTCN3-CORE-22.5.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_02_the_start_port_operation_007 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(1);
        T.start;
        alt {
            [] p2.check(receive) { T.stop; }
            [] T.timeout { setverdict(fail); stop; }
        }
        p2.start;
        alt {
            [] p2.receive { setverdict(fail); stop; }
            [else] { }
        }
        p1.send(2);
        T.start;
        alt {
            [] p2.check(receive) { T.stop; }
            [] T.timeout { setverdict(fail); stop; }
        }
        p2.halt;
        p2.start;
        alt {
            [] p2.receive { setverdict(fail); }
            [else] { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
