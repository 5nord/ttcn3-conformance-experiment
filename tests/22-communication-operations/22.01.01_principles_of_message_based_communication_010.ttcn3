// @requirement: 22.1.1 -- Table 22: Overview of TTCN-3 communication operations: Trigger on message; Col2: trigger; Col3: Yes
// @id: TTCN3-CORE-22.1.1-011b
// @verdict: pass reject
module M_22_01_01_principles_of_message_based_communication_010 {

    signature S(in integer p_x) noblock;

    type port PP procedure {
        inout S
    }

    type component C {
        port PP p;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.trigger(integer:?) { // error: trigger used at a procedure-based port
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
