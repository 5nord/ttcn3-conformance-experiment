// @requirement: 22.3.3 -- f) The optional value clause for a return value shall only be present if the signature definition of the procedure to which the reply operation belongs defines a return type.
// @id: TTCN3-CORE-22.3.3-022a
// @verdict: pass reject
module M_22_03_03_the_reply_operation_020 {

    signature S(out integer p_y);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_reply() runs on C {
        p.reply(S:{1} value 5); // error: S has no return type
    }
}
