// @requirement: 22.3.2 -- The matching criteria for the signature may either be specified in-line or be derived from a signature template.
// @id: TTCN3-CORE-22.3.2-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_02_the_getcall_operation_006 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    template S s_call := { p_x := 1 };

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_client() runs on C {
        p.call(S:{1});
        p.call(S:{2});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_client());
        activate(a_guard());
        T.start;
        p.getcall(s_call);
        p.getcall(S:{2});
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
