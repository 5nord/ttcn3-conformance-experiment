// @requirement: 22.3.1 -- If the nowait option is used, the handling of responses or exceptions to call operations is done by using getreply (see clause 22.3.4) and catch (see clause 22.3.6) operations as alternatives in alt statements.
// @id: TTCN3-CORE-22.3.1-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_the_call_operation_005 {

    signature S(in integer p_x) return integer exception (charstring);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_server() runs on C {
        p.getcall(S:{1});
        p.reply(S:{-} value 1);
        p.getcall(S:{2});
        p.raise(S, "exc");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        T.start;
        p.call(S:{1}, nowait);
        alt {
            [] p.getreply(S:{-} value 1) { setverdict(pass); }
            [] p.catch { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
        p.call(S:{2}, nowait);
        alt {
            [] p.getreply { setverdict(fail); }
            [] p.catch(S, charstring:"exc") { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
