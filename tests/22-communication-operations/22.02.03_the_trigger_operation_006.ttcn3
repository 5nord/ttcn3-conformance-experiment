// @requirement: 22.2.3 -- The trigger operation requires the port name, matching criteria for type and value, an optional from restriction (i.e. selection of communication partner) and an optional assignment of the matching message and sender component to variables.
// @id: TTCN3-CORE-22.2.3-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_the_trigger_operation_006 {

    type port P message { inout integer, charstring }

    type component C {
        port P p;
        port P q;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        var integer v_x;
        connect(mtc:p, mtc:q);
        q.send("x");
        q.send(4);
        q.send(5);
        T.start;
        alt {
            [] p.trigger(integer:5) -> value v_x {
                if (v_x == 5) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
