// @requirement: 22.3.6 -- It shall be decoded into a value of the same type as the variable on the left hand side of the assignment.
// @id: TTCN3-CORE-22.3.6-015a
// @verdict: pass accept, noexecution
module M_22_03_06_test_013 {

    type record R {
        integer f1,
        boolean f2
    }

    type record E {
        bitstring payload
    }

    signature S() exception (E);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_catch() runs on C return R {
        var R v_r;
        p.catch(S, E:?) -> value (v_r := @decoded payload);
        return v_r;
    }
}
