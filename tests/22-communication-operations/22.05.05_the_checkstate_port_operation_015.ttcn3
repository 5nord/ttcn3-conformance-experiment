// @requirement: 22.5.5 -- 3) "Stopped"
// @id: TTCN3-CORE-22.5.5-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_05_the_checkstate_port_operation_015 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1;
    }

    testcase TC() runs on C {
        p1.stop;
        if (p1.checkstate("Stopped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
