// @requirement: 22.3.4 -- Any other value shall cause an error.
// @id: TTCN3-CORE-22.3.4-023a
// @verdict: pass accept, ttcn3verdict:error
module M_22_03_04_the_getreply_operation_022 {

    signature S(out universal charstring p_enc);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{-});
        p.reply(S:{"1"});
    }

    testcase TC(charstring p_format) runs on C {
        var C v_ptc := C.create;
        var integer v_i;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{-}, nowait);
        p.getreply(S:{?}) -> param(v_i := @decoded(p_format) p_enc); // error: not an allowed encoding format
        setverdict(pass);
    }

    control {
        execute(TC("UTF-9"));
    }
}
