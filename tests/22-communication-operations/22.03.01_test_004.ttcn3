// @requirement: 22.3.1 -- In case of non-blocking procedure-based communication the handling of exceptions to call operations is done by using catch (see clause 22.3.6) operations as alternatives in alt statements.
// @id: TTCN3-CORE-22.3.1-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_test_004 {

    signature S(in integer p_x) noblock exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_server() runs on C {
        p.getcall(S:{?});
        p.raise(S, 42);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{1});
        T.start;
        alt {
            [] p.catch(S, integer:42) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
