// @requirement: 22.1.1 -- Table 22: Overview of TTCN-3 communication operations: Clear queue and enable sending and receiving at a port; Col2: start; Col3: Yes; Col4: Yes
// @id: TTCN3-CORE-22.1.1-023b
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_01_principles_of_message_based_communication_028 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    function f_echo() runs on C {
        timer T := 2.0;
        p.send(1);
        T.start;
        alt {
            [] p.receive(2) {
                p.send(3);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_echo());
        T.start;
        alt {
            [] p.check(receive(1)) {}
            [] T.timeout {
                setverdict(fail);
                stop;
            }
        }
        p.stop;
        p.start;
        p.send(2);
        alt {
            [] p.receive(3) {
                setverdict(pass);
            }
            [] p.receive {
                setverdict(fail);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
