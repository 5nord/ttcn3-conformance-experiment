// @requirement: 22.3.2 -- The parameter shall be of the charstring type and it shall contain one of the strings allowed for the decvalue_unichar function (specified in clause C.5.4).
// @id: TTCN3-CORE-22.3.2-020a
// @verdict: pass reject
module M_22_03_02_the_getcall_operation_017 {

    signature S(in universal charstring p_enc) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_getcall() runs on C {
        var integer v_i;
        p.getcall(S:{?}) -> param(v_i := @decoded(8) p_enc); // error: encoding format of type integer
    }
}
