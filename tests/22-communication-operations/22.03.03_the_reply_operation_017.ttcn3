// @requirement: 22.3.3 -- d) A to clause shall be present in case of one-to-many connections.
// @id: TTCN3-CORE-22.3.3-019a
// @verdict: pass accept, ttcn3verdict:error
module M_22_03_03_the_reply_operation_017 {

    signature S(out integer p_y);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_client() runs on C {
        p.call(S:{-}, nowait);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc1.start(f_client());
        v_ptc2.start(f_client());
        activate(a_guard());
        T.start;
        p.getcall(S:{-});
        p.reply(S:{1}); // error: no to clause on a one-to-many connection
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
