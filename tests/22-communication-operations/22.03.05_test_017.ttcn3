// @requirement: 22.3.5 -- f) The TemplateInstance shall conform to the template(value) restriction (see clause 15.8).
// @id: TTCN3-CORE-22.3.5-024a
// @verdict: pass reject
module M_22_03_05_test_017 {

    signature S() exception(integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    template integer mw_exc := (1, 2);

    function f_client() runs on C {
        p.call(S:{}, 1.0) {
            [] p.catch(S, integer:?) { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_client());
        p.getcall(S:{});
        p.raise(S, mw_exc); // error: template does not conform to template(value)
        v_ptc.done;
    }

    control {
        execute(TC(), 5.0);
    }
}
