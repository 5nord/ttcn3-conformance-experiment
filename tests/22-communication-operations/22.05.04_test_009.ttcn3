// @requirement: 22.5.4 -- NOTE 2: If a port stop operation is performed on a halted port before all entries in the queue ahead of the marker have been processed, further receive operations are disallowed immediately (i.e. the marker is virtually moved to the top of the queue).
// @id: TTCN3-CORE-22.5.4-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_04_test_009 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(1);
        T.start;
        alt {
            [] p2.check(receive) { T.stop; }
            [] T.timeout { setverdict(fail); stop; }
        }
        p2.halt;
        p2.stop;
        alt {
            [] p2.receive { setverdict(fail); }
            [else] { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
