// @requirement: 22.1.3 -- In this case, one, several or all entities within the SUT can be reached via the specified mapped port.
// @id: TTCN3-CORE-22.1.3-008a
// @verdict: pass accept, noexecution
module M_22_01_03_principles_of_unicast_multicast_and_broadcast_communication_007 {

    type record SutAddress {
        charstring host,
        integer portNumber
    }

    type port P message {
        address SutAddress;
        inout integer
    }

    type component C {
        port P p;
    }

    type component S {
        port P p;
    }

    testcase TC() runs on C system S {
        var SutAddress v_e1 := { host := "e1", portNumber := 1 };
        var SutAddress v_e2 := { host := "e2", portNumber := 2 };
        var SutAddress v_sender;
        map(mtc:p, system:p);
        p.send(1) to v_e1;
        p.send(2) to (v_e1, v_e2);
        p.send(3) to all component;
        p.receive(integer:?) from v_e2 -> sender v_sender;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
