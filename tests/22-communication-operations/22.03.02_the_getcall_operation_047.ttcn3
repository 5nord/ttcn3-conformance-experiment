// @requirement: 22.3.2 -- l) If the getcall operation contains both from and sender clause, the variable or parameter referenced in the sender clause shall be type compatible with the template in the from clause.
// @id: TTCN3-CORE-22.3.2-048a
// @verdict: pass reject
module M_22_03_02_the_getcall_operation_047 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component CA {
        port P p;
    }

    type component CB {
        var integer v_x;
    }

    function f_getcall(CA p_peer) runs on CA {
        var CB v_sender;
        p.getcall(S:{?}) from p_peer -> sender v_sender; // error: CB variable not compatible with CA template
    }
}
