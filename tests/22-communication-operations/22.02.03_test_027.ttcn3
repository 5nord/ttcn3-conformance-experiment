// @requirement: 22.2.3 -- Rules in clause 22.2.2 shall apply.
// @id: TTCN3-CORE-22.2.3-032a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_test_027 {

    type record R { integer a, charstring b }

    type port P message { inout R }

    type component C {
        port P p;
        port P q;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        var R v_r;
        var integer v_a;
        var charstring v_b;
        var C v_sender;
        connect(mtc:p, mtc:q);
        q.send(R:{ a := 1, b := "x" });
        T.start;
        alt {
            [] p.trigger(R:?) -> value (v_r, v_a := a, v_b := b) sender v_sender {
                if (v_r == { a := 1, b := "x" } and v_a == 1 and v_b == "x" and v_sender == mtc) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
