// @requirement: 22.3.3 -- The type definition of the port shall include the name of the procedure to which the reply operation belongs in its in or inout list.
// @id: TTCN3-CORE-22.3.3-016a
// @verdict: pass reject
module M_22_03_03_test_014 {

    signature S(out integer p_y);

    type port P procedure { out S }

    type component C {
        port P p;
    }

    function f_reply() runs on C {
        p.reply(S:{1}); // error: S is only in the out list of the port type
    }
}
