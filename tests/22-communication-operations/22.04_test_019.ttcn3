// @requirement: 22.4 -- In the case of one-to-many connections the check operation may be restricted to a certain communication partner. **Check from a specific sender**
// @id: TTCN3-CORE-22.4-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_04_test_019 {

    type port MP message { inout integer; }

    type component C {
        port MP p;
        timer T := 1.0;
    }

    function f_send(integer p_value) runs on C {
        p.send(p_value);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        connect(v_ptc1:p, mtc:p);
        connect(v_ptc2:p, mtc:p);
        v_ptc1.start(f_send(5));
        T.start;
        alt {
            [] p.check(receive(integer:?) from v_ptc2) { setverdict(fail); }
            [] p.check(receive(integer:?) from v_ptc1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
