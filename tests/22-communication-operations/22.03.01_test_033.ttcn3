// @requirement: 22.3.1 -- Alternatively, several or all responses and exceptions are processed in the response and exception handling part of the call operation by means of nested alt statements or by using the repeat operation causing the re-evaluation of the call body.
// @id: TTCN3-CORE-22.3.1-045a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_test_033 {

    signature S(in integer p_x) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server(integer p_res) runs on C {
        p.getcall(S:{?});
        p.reply(S:{-} value p_res);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create, v_ptc3 := C.create;
        var integer v_count := 0;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        connect(mtc:p, v_ptc3:p);
        v_ptc1.start(f_server(1));
        v_ptc2.start(f_server(2));
        v_ptc3.start(f_server(3));
        p.call(S:{0}, 1.0) to all component {
            [] p.getreply(S:{-} value 1) from v_ptc1 {
                v_count := v_count + 1;
                if (v_count < 3) { repeat; }
            }
            [] p.getreply(S:{-} value 2) from v_ptc2 {
                v_count := v_count + 1;
                alt {
                    [] p.getreply(S:{-} value 3) from v_ptc3 { v_count := v_count + 1; }
                    [] p.getreply(S:{-} value 1) from v_ptc1 { v_count := v_count + 1; }
                }
                if (v_count < 3) { repeat; }
            }
            [] p.getreply(S:{-} value 3) from v_ptc3 {
                v_count := v_count + 1;
                if (v_count < 3) { repeat; }
            }
            [] p.catch(timeout) { setverdict(fail); stop; }
        }
        if (v_count == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
