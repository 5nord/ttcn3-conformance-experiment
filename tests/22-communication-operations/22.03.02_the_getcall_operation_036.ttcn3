// @requirement: 22.3.2 -- e) Parameters of calls accepted by accepting any call shall not be assigned to a variable, i.e. the param clause shall not be present.
// @id: TTCN3-CORE-22.3.2-040a
// @verdict: pass reject
module M_22_03_02_the_getcall_operation_036 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_getcall() runs on C {
        var integer v_x;
        p.getcall -> param(v_x); // error: param clause when accepting any call
    }
}
