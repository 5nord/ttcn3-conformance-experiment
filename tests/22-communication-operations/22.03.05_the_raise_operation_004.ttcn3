// @requirement: 22.3.5 -- The value part of the raise operation consists of the signature reference followed by the exception value.
// @id: TTCN3-CORE-22.3.5-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_05_the_raise_operation_004 {

    signature S() exception(integer, charstring);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_client() runs on C {
        p.call(S:{}, 1.0) {
            [] p.catch(S, charstring:"err") { setverdict(pass); }
            [] p.catch { setverdict(fail); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_client());
        p.getcall(S:{});
        p.raise(S, charstring:"err");
        v_ptc.done;
    }

    control {
        execute(TC(), 5.0);
    }
}
