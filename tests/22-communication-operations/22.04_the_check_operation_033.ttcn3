// @requirement: 22.4 -- a) Using the check operation in a wrong manner, e.g. check for an exception at a message-based port shall cause a test case error.
// @id: TTCN3-CORE-22.4-031a
// @verdict: pass accept, ttcn3verdict:error
module M_22_04_the_check_operation_033 {

    signature S() exception (charstring);

    type port MP message { inout charstring; }

    type component C {
        port MP p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(mtc:p1, mtc:p2);
        p1.send(charstring:"e");
        T.start;
        alt {
            [] p2.check(catch(S, charstring:?)) { } // causes test case error: catch at a message-based port
            [] T.timeout { }
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
