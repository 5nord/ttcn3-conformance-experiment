// @requirement: 22.3.4 -- NOTE 1: _Address may be an AddressRef, a list of AddressRef-s or "any component"._
// @id: TTCN3-CORE-22.3.4-003a
// @verdict: pass accept, noexecution
module M_22_03_04_test_002 {

    signature S(out integer p_y);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_getreply(C p_peer1, C p_peer2) runs on C {
        p.getreply(S:{?}) from p_peer1;
        p.getreply(S:{?}) from (p_peer1, p_peer2);
        p.getreply(S:{?}) from any component;
    }
}
