// @requirement: 22.3.2 -- The keyword sender is used when it is required to retrieve the address of the sender (e.g. for addressing a reply or exception to the calling party in a one-to-many configuration).
// @id: TTCN3-CORE-22.3.2-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_02_test_021 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_client() runs on C {
        p.call(S:{1});
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create;
        var C v_sender;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc2.start(f_client());
        activate(a_guard());
        T.start;
        p.getcall(S:{?}) -> sender v_sender;
        if (v_sender == v_ptc2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
