// @requirement: 22.3.6 -- The catch operation removes the top exception from the associated incoming port queue if, and only if, that top exception satisfies all the matching criteria associated with the catch operation.
// @id: TTCN3-CORE-22.3.6-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_the_catch_operation_005 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.raise(S, integer:1);
        p.getcall(S:{});
        p.raise(S, integer:2);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{}, nowait);
        p.call(S:{}, nowait);
        p.check(catch(S, integer:1));
        alt {
            [] p.catch(S, integer:2) { setverdict(fail); stop; } // top exception does not match
            [else] {}
        }
        p.catch(S, integer:1);
        alt {
            [] p.catch(S, integer:2) { setverdict(pass); }
            [] p.catch { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
