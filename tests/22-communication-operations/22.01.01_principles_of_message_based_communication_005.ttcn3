// @requirement: 22.1.1 -- Table 22: Overview of TTCN-3 communication operations: Send message; Col2: send; Col3: Yes
// @id: TTCN3-CORE-22.1.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_01_principles_of_message_based_communication_005 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    function f_receive() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.receive(1) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_receive());
        p.send(1);
        v_ptc.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
