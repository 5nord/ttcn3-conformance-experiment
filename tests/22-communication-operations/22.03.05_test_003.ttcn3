// @requirement: 22.3.5 -- For testing it is allowed to specify a raise operation without an associated getcall operation.
// @id: TTCN3-CORE-22.3.5-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_05_test_003 {

    signature S() exception(integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_client() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.catch(S, 1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_client());
        p.raise(S, 1);
        v_ptc.done;
    }

    control {
        execute(TC(), 5.0);
    }
}
