// @requirement: 22.3.6 -- When checking the port array for matching exceptions, the port indices to be checked are iterated from lowest to highest.
// @id: TTCN3-CORE-22.3.6-038a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_test_033 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component CS {
        port P pa[3];
        timer T := 1.0;
    }

    type component CC {
        port P p;
    }

    altstep a_guard() runs on CS {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server(integer p_exc) runs on CC {
        p.getcall(S:{});
        p.raise(S, integer:p_exc);
    }

    testcase TC() runs on CS {
        var CC v_ptc1 := CC.create, v_ptc2 := CC.create;
        var integer v_idx := -1;
        connect(mtc:pa[1], v_ptc1:p);
        connect(mtc:pa[2], v_ptc2:p);
        v_ptc1.start(f_server(1));
        v_ptc2.start(f_server(2));
        activate(a_guard());
        T.start;
        pa[2].call(S:{}, nowait);
        pa[1].call(S:{}, nowait);
        pa[2].check(catch);
        pa[1].check(catch);
        any from pa.catch(S, integer:?) -> @index value v_idx;
        if (v_idx == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
