// @requirement: 22.1.3 -- This means, it is only possible to address one, several or all test components that are connected to the specified port.
// @id: TTCN3-CORE-22.1.3-006a
// @verdict: pass accept, ttcn3verdict:error
module M_22_01_03_principles_of_unicast_multicast_and_broadcast_communication_005 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        setverdict(pass);
        p.send(1) to v_ptc2; // error: v_ptc2 is not connected to p
    }

    control {
        execute(TC());
    }
}
