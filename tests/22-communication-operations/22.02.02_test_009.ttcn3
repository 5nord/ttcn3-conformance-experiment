// @requirement: 22.2.2 -- An optional type field in the matching criteria to the receive operation shall be used to avoid any ambiguity of the type of the value being received.
// @id: TTCN3-CORE-22.2.2-011a
// @verdict: pass reject
module M_22_02_02_test_009 {

    type record R1 {
        integer a
    }

    type record R2 {
        integer b
    }

    type port P message { inout R1, R2 }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.receive({ 1 }); // error: type of in-line template is ambiguous (R1 or R2)
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
