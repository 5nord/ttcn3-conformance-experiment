// @requirement: 22.2.3 -- a) The trigger operation shall only be used on message-based ports and the type of the value to be received shall be included in the list of incoming types of the port type definition.
// @id: TTCN3-CORE-22.2.3-034a
// @verdict: pass reject
module M_22_02_03_the_trigger_operation_028 {

    signature S();

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        p.trigger(integer:?); // error: trigger on a procedure-based port
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
