// @requirement: 22.3.1 -- In case of a multicast or broadcast call operation of a blocking procedure, responses and exceptions can be handled in several ways: one possibility is to handle only one response or exception in the response and exception handling part of the call operation.
// @id: TTCN3-CORE-22.3.1-043a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_the_call_operation_031 {

    signature S(in integer p_x) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{?});
        p.reply(S:{-} value 1);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc1.start(f_server());
        v_ptc2.start(f_server());
        p.call(S:{0}, 1.0) to (v_ptc1, v_ptc2) {
            [] p.getreply(S:{-} value 1) { setverdict(pass); } // only the first response is handled here
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
