// @requirement: 22.1.1 -- Message-based communication is non-blocking on the send operation, as illustrated in figure 11, where processing in the SENDER continues immediately after the send operation occurs.
// @id: TTCN3-CORE-22.1.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_01_test_001 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_count := 0;
        connect(mtc:p, v_ptc:p);
        for (var integer i := 0; i < 3; i := i + 1) {
            p.send(i);
            v_count := v_count + 1;
        }
        if (v_count == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC(), 5.0);
    }
}
