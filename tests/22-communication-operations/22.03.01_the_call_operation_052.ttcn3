// @requirement: 22.3.1 -- j) The call operation for a blocking procedures without return value, out parameters, inout parameters and exceptions shall also have a response and exception handling part to handle the blocking in a uniform manner.
// @id: TTCN3-CORE-22.3.1-063a
// @verdict: pass reject
module M_22_03_01_the_call_operation_052 {

    signature S(in integer p_x);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.call(S:{1}); // error: blocking call without response and exception handling part
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
