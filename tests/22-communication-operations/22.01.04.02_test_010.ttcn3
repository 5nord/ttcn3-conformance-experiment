// @requirement: 22.1.4.2 -- For the message or parameter value assignment part strong typing is not required, e.g. the variable used for storing a message shall be type-compatible to the type of the incoming message.
// @id: TTCN3-CORE-22.1.4.2-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_04_02_test_010 {

    type integer Small (0..10);

    type port P message { inout Small }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_ptc() runs on C {
        p.send(Small:5);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_msg := 0;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_ptc());
        T.start;
        alt {
            [] p.receive(Small:?) -> value v_msg {}
            [] T.timeout {}
        }
        if (v_msg == 5) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
