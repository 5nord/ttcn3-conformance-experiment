// @requirement: 22.3.1 -- The response and exception handling part of a call operation is executed like an alt statement without any active default.
// @id: TTCN3-CORE-22.3.1-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_test_009 {

    signature S(in integer p_x) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    altstep a_default() runs on C {
        [] p.getreply { setverdict(fail); }
    }

    function f_server() runs on C {
        p.getcall(S:{?});
        p.reply(S:{-} value 1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_default());
        p.call(S:{1}, 0.5) {
            [] p.getreply(S:{-} value 2) { setverdict(fail); }
            [] p.catch(timeout) { setverdict(pass); } // reached only if the active default is not invoked
        }
    }

    control {
        execute(TC());
    }
}
