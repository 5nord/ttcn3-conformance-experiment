// @requirement: 22.2.3 -- If that top message does not fulfil the matching criteria, it shall be removed from the queue without any further action.
// @id: TTCN3-CORE-22.2.3-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_test_005 {

    type port P message { inout integer }

    type component C {
        port P p;
        port P q;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(mtc:p, mtc:q);
        q.send(1);
        q.send(2);
        T.start;
        alt {
            [] p.trigger(integer:2) {}
            [] T.timeout { setverdict(fail); stop; }
        }
        T.stop;
        T.start(0.3);
        alt {
            [] p.receive { setverdict(fail); }
            [] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
