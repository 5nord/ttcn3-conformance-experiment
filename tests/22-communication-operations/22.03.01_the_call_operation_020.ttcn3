// @requirement: 22.3.1 -- The call operation for such a procedure shall also have a response and exception handling part to handle the blocking in a uniform manner.
// @id: TTCN3-CORE-22.3.1-032a
// @verdict: pass reject
module M_22_03_01_the_call_operation_020 {

    signature S(in integer p_x, in boolean p_y);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.call(S:{7, false}); // error: blocking call without response and exception handling part
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
