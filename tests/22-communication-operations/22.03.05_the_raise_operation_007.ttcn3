// @requirement: 22.3.5 -- Exceptions to one or more call operations may be sent to one, several or all peer entities connected to the addressed port.
// @id: TTCN3-CORE-22.3.5-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_05_the_raise_operation_007 {

    signature S() exception(integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_client(integer p_first) runs on C {
        p.call(S:{}, 1.0) {
            [] p.catch(S, p_first) {}
            [] p.catch { setverdict(fail); stop; }
            [] p.catch(timeout) { setverdict(fail); stop; }
        }
        p.call(S:{}, 1.0) {
            [] p.catch(S, 3) { setverdict(pass); }
            [] p.catch { setverdict(fail); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    testcase TC() runs on C system C {
        var C v_ptc[3];
        for (var integer i := 0; i < 3; i := i + 1) {
            v_ptc[i] := C.create;
            connect(self:p, v_ptc[i]:p);
        }
        v_ptc[0].start(f_client(1));
        v_ptc[1].start(f_client(2));
        v_ptc[2].start(f_client(2));
        for (var integer i := 0; i < 3; i := i + 1) {
            p.getcall(S:{});
        }
        p.raise(S, 1) to v_ptc[0];
        p.raise(S, 2) to (v_ptc[1], v_ptc[2]);
        for (var integer i := 0; i < 3; i := i + 1) {
            p.getcall(S:{});
        }
        p.raise(S, 3) to all component;
        all component.done;
    }

    control {
        execute(TC(), 5.0);
    }
}
