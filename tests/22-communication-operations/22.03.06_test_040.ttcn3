// @requirement: 22.3.6 -- c) No binding of the incoming values to the terms of the expression or to the template shall occur.
// @id: TTCN3-CORE-22.3.6-046a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_test_040 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.raise(S, integer:5);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_x := 7;
        var template integer t_exc := v_x;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{}, nowait);
        p.check(catch);
        alt {
            [] p.catch(S, v_x) { setverdict(fail); } // v_x is a matching value, not a target variable
            [] p.catch(S, t_exc) { setverdict(fail); }
            [] p.catch(S, integer:?) {
                if (v_x == 7 and valueof(t_exc) == 7) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
        }
    }

    control {
        execute(TC());
    }
}
