// @requirement: 22.3.5 -- b) The type of the exception shall be specified in the signature of the called procedure.
// @id: TTCN3-CORE-22.3.5-018a
// @verdict: pass reject
module M_22_03_05_test_011 {

    signature S() exception(integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_client() runs on C {
        p.call(S:{}, 1.0) {
            [] p.catch { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_client());
        p.getcall(S:{});
        p.raise(S, charstring:"err"); // error: charstring is not an exception type of S
        v_ptc.done;
    }

    control {
        execute(TC(), 5.0);
    }
}
