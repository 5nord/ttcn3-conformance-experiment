// @requirement: 22.5.5 -- If a port is in the state specified by the parameter, the checkstate operation returns the Boolean value true.
// @id: TTCN3-CORE-22.5.5-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_05_test_002 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p2.stop;
        if (p1.checkstate("Started") == true and p1.checkstate("Connected") == true
            and p2.checkstate("Stopped") == true) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
