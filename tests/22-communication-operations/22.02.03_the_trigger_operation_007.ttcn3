// @requirement: 22.2.3 -- The trigger operation requires the port name, matching criteria for type and value, an optional from restriction (i.e. selection of communication partner) and an optional assignment of the matching message and sender component to variables.
// @id: TTCN3-CORE-22.2.3-007b
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_the_trigger_operation_007 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_send(integer p_value) runs on C {
        p.send(p_value);
    }

    testcase TC() runs on C {
        var integer v_x;
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc1.start(f_send(1));
        v_ptc2.start(f_send(2));
        T.start;
        alt {
            [] p.trigger(integer:?) from v_ptc2 -> value v_x {
                if (v_x == 2) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
