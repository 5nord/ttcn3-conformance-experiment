// @requirement: 22.2.2 -- Any other value shall cause an error.
// @id: TTCN3-CORE-22.2.2-033a
// @verdict: pass accept, ttcn3verdict:error
module M_22_02_02_test_031 {

    type record Inner {
        integer x
    } with {
        encode "JSON"
    }

    type record Msg {
        integer id,
        universal charstring payload
    }

    type port P message { inout Msg }

    type component C {
        port P p;
        timer T := 1.0;
    }

    const Inner c_inner := { x := 5 };

    function f_send() runs on C {
        p.send(Msg:{ id := 1, payload := encvalue_unichar(c_inner, "UTF-8") });
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var Inner v_inner;
        var charstring v_format := "UTF-7";
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send());
        setverdict(pass);
        T.start;
        alt {
            [] p.receive(Msg:?) -> value (v_inner := @decoded(v_format) payload) { } // error: format value not allowed
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
