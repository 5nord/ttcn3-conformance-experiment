// @requirement: 22.3.2 -- In case the referenced field is not a universal **charstring, the optional** parameter shall not be present.
// @id: TTCN3-CORE-22.3.2-022a
// @verdict: pass reject
module M_22_03_02_the_getcall_operation_020 {

    signature S(in octetstring p_enc) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_getcall() runs on C {
        var integer v_i;
        p.getcall(S:{?}) -> param(v_i := @decoded("UTF-8") p_enc); // error: encoding format for an octetstring parameter
    }
}
