// @requirement: 22.5.4 -- If a port allows receiving operations such as receive, trigger and getcall, the halt operation disallows receiving operations to succeed for messages and procedure call elements that enter the port queue after performing the halt operation at that port.
// @id: TTCN3-CORE-22.5.4-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_04_test_003 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        timer T := 0.5;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p2.halt;
        p1.send(1);
        T.start;
        alt {
            [] p2.receive { setverdict(fail); }
            [] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
