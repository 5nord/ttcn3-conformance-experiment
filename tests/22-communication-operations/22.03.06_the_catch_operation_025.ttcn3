// @requirement: 22.3.6 -- A catch operation with no argument list allows any valid exception to be caught.
// @id: TTCN3-CORE-22.3.6-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_the_catch_operation_025 {

    signature S1() exception (integer);
    signature S2() exception (charstring);

    type port P procedure { inout S1, S2 }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S1:{});
        p.raise(S1, integer:1);
        p.getcall(S2:{});
        p.raise(S2, charstring:"x");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S1:{}, nowait);
        p.call(S2:{}, nowait);
        p.catch;
        p.catch;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
