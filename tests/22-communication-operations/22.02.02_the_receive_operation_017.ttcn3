// @requirement: 22.2.2 -- When the keyword value is followed by a name of a variable or formal parameter, the whole received message shall be stored in the variable or formal parameter.
// @id: TTCN3-CORE-22.2.2-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_the_receive_operation_017 {

    type record R {
        integer a,
        charstring b
    }

    type port P message { inout R }

    type component C {
        port P p;
        timer T := 1.0;
    }

    const R c_r1 := { 1, "x" };
    const R c_r2 := { 2, "y" };

    function f_send() runs on C {
        p.send(c_r1);
        p.send(c_r2);
    }

    function f_receive(out R p_r) runs on C {
        p.receive(R:?) -> value p_r;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var R v_r1, v_r2;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.receive(R:?) -> value v_r1 { }
            [] T.timeout { setverdict(fail); stop; }
        }
        f_receive(v_r2);
        if (v_r1 == c_r1 and v_r2 == c_r2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
