// @requirement: 22.3.6 -- If a Signature is given in the parameter list, it is possible to omit the TemplateInstance part if the catch operation shall match any exception value of any of the exception types declared in the definition of the referenced Signature.
// @id: TTCN3-CORE-22.3.6-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_the_catch_operation_004 {

    signature S() exception (integer, charstring);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.raise(S, integer:1);
        p.getcall(S:{});
        p.raise(S, charstring:"x");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{}, nowait);
        p.call(S:{}, nowait);
        p.catch(S);
        p.catch(S);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
