// @requirement: 22.1.1 -- Table 22: Overview of TTCN-3 communication operations: Check the state of a port; Col2: checkstate; Col3: Yes; Col4: Yes
// @id: TTCN3-CORE-22.1.1-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_01_principles_of_message_based_communication_033 {

    signature S(in integer p_x) noblock;

    type port P message {
        inout integer
    }

    type port PP procedure {
        inout S
    }

    type component C {
        port P pm;
        port PP pp;
    }

    testcase TC() runs on C {
        if (pm.checkstate("Started") and pp.checkstate("Started")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
