// @requirement: 22.3.1 -- c) Only out parameters may be omitted or specified with a matching attribute.
// @id: TTCN3-CORE-22.3.1-051a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_test_039 {

    signature S(out integer p_o, in integer p_i) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        var integer v_x;
        alt {
            [] p.getcall(S:{-, ?}) -> param(v_x := p_i) { p.reply(S:{v_x, -} value v_x); repeat; }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{-, 1}, 1.0) {
            [] p.getreply(S:{1, -} value 1) { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
        p.call(S:{?, 2}, 1.0) {
            [] p.getreply(S:{2, -} value 2) { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
