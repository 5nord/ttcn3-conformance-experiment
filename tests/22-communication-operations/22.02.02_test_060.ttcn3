// @requirement: 22.2.2 -- i) If the index redirection is used for single-dimensional port arrays, the type of the integer variable shall allow storing the highest index of the respective array.
// @id: TTCN3-CORE-22.2.2-066a
// @verdict: pass reject
module M_22_02_02_test_060 {

    type port P message { inout integer }

    type integer SmallIndex (0..1);

    type component C {
        port P p[3];
    }

    testcase TC() runs on C {
        var SmallIndex v_i;
        any from p.receive(integer:?) -> @index value v_i; // error: index 2 cannot be stored in v_i
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
