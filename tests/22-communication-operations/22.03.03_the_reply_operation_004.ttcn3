// @requirement: 22.3.3 -- For testing it is allowed to specify a reply operation without an associated getcall operation.
// @id: TTCN3-CORE-22.3.3-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_03_the_reply_operation_004 {

    signature S(out integer p_y);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.reply(S:{1}); // no preceding getcall
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{-}, nowait);
        p.getreply(S:{1});
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
