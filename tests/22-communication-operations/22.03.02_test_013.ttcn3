// @requirement: 22.3.2 -- In this case, the referenced parameter on the right hand sided of the assignment shall be one of the bitstring, hexstring, octetstring, charstring or universal `charstring types.
// @id: TTCN3-CORE-22.3.2-016a
// @verdict: pass reject
module M_22_03_02_test_013 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_getcall() runs on C {
        var integer v_i;
        p.getcall(S:{?}) -> param(v_i := @decoded p_x); // error: decoded parameter of type integer
    }
}
