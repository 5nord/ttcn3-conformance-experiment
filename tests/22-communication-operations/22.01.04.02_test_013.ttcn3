// @requirement: 22.1.4.2 -- For receiving operations using the any port from a port array construction (see clause 22.2.2), the assignment part may also be used to store the indices that identify the specific port instance where the receiving operation matched.
// @id: TTCN3-CORE-22.1.4.2-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_04_02_test_013 {

    type port P message { inout integer }

    type component C {
        port P p[3];
        timer T := 1.0;
    }

    type component D {
        port P p;
    }

    function f_ptc() runs on D {
        p.send(integer:5);
    }

    testcase TC() runs on C {
        var D v_ptc := D.create;
        var integer v_x := 0, v_i := -1;
        connect(mtc:p[1], v_ptc:p);
        v_ptc.start(f_ptc());
        T.start;
        alt {
            [] any from p.receive(integer:?) -> value v_x @index value v_i {}
            [] T.timeout {}
        }
        if (v_x == 5 and v_i == 1) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
