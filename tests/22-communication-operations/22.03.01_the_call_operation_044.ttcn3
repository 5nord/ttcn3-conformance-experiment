// @requirement: 22.3.1 -- f) All AddressRef items in the to clause shall be of type address, component or of the address type bound to the port type (see clause 6.2.9) of the port instance referenced in the call operation.
// @id: TTCN3-CORE-22.3.1-056a
// @verdict: pass reject
module M_22_03_01_the_call_operation_044 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_addr := 1;
        connect(mtc:p, v_ptc:p);
        p.call(S:{1}) to v_addr; // error: AddressRef of type integer
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
