// @requirement: 22.2.2 -- l) If the receive operation contains both from and sender clause, the variable or parameter referenced in the sender clause shall be type compatible with the template in the from clause.
// @id: TTCN3-CORE-22.2.2-069a
// @verdict: pass reject
module M_22_02_02_test_065 {

    type port P message { inout integer }

    type component C {
        port P p;
        var integer v_c;
    }

    type component D {
        port P p;
        var integer v_d;
    }

    testcase TC() runs on C {
        var C v_peer := mtc;
        var D v_sender;
        p.receive(integer:?) from v_peer -> sender v_sender; // error: D is not compatible with C
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
