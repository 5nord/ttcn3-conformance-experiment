// @requirement: 22.3.3 -- This means, the argument of the to clause of a reply operation is for unicast responses the address of one receiving entity, for multicast responses a list of addresses of a set of receivers and for broadcast responses the all component keywords.
// @id: TTCN3-CORE-22.3.3-011b
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_03_test_008 {

    signature S(out integer p_y);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 0.5;
    }

    function f_client(boolean p_expected) runs on C {
        p.call(S:{-}, nowait);
        T.start;
        alt {
            [] p.getreply(S:{1}) {
                if (p_expected) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout {
                if (p_expected) { setverdict(fail); } else { setverdict(pass); }
            }
        }
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create, v_ptc3 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        connect(mtc:p, v_ptc3:p);
        v_ptc1.start(f_client(true));
        v_ptc2.start(f_client(true));
        v_ptc3.start(f_client(false));
        p.getcall(S:{-});
        p.getcall(S:{-});
        p.getcall(S:{-});
        p.reply(S:{1}) to (v_ptc1, v_ptc2);
        all component.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
