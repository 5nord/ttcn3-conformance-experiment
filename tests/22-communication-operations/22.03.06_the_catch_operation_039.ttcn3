// @requirement: 22.3.6 -- b) The type definition of the port shall include in its out or inout list the name of the procedure to which the exception belongs.
// @id: TTCN3-CORE-22.3.6-045a
// @verdict: pass reject
module M_22_03_06_the_catch_operation_039 {

    signature S() exception (integer);

    type port P procedure { in S }

    type component C {
        port P p;
    }

    function f_catch() runs on C {
        p.catch(S, integer:?); // error: S is not in the out or inout list of P
    }
}
