// @requirement: 22.2.2 -- To receive a message on any port from a specific port array, use the any from PortArrayRef syntax where PortArrayRef shall be a reference to a port array identifier.
// @id: TTCN3-CORE-22.2.2-047a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_test_038 {

    type port P message { inout integer }

    type component C {
        port P p[3];
        timer T := 1.0;
    }

    type component CP {
        port P p;
    }

    function f_send() runs on CP {
        p.send(1);
    }

    testcase TC() runs on C {
        var CP v_ptc := CP.create;
        connect(mtc:p[2], v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] any from p.receive(integer:1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
