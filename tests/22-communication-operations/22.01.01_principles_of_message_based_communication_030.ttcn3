// @requirement: 22.1.1 -- Table 22: Overview of TTCN-3 communication operations: Disable sending and disallow receiving operations to match at a port; Col2: stop; Col3: Yes; Col4: Yes
// @id: TTCN3-CORE-22.1.1-024b
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_01_principles_of_message_based_communication_030 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    function f_send() runs on C {
        p.send(1);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        timer T_wait := 0.5;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.check(receive(1)) {}
            [] T.timeout {
                setverdict(fail);
                stop;
            }
        }
        p.stop;
        if (not p.checkstate("Stopped")) {
            setverdict(fail);
        }
        T_wait.start;
        alt {
            [] p.receive {
                setverdict(fail);
            }
            [] T_wait.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
