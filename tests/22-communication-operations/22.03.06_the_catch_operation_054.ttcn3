// @requirement: 22.3.6 -- k) If the index redirection is used for multi-dimensional arrays, the size of the integer array or record of integer type shall exactly be the same as the dimension of the respective port array, and the its type shall allow storing the highest index (from all dimensions) of the port array.
// @id: TTCN3-CORE-22.3.6-057b
// @verdict: pass reject
module M_22_03_06_the_catch_operation_054 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type integer Index (0..1);

    type component C {
        port P pa[3][2];
    }

    function f_catch() runs on C {
        var Index v_idx[2];
        any from pa.catch(S, integer:?) -> @index value v_idx; // error: Index cannot store the highest index 2
    }
}
