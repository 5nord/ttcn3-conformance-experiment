// @requirement: 22.5.4 -- Subsequent halt operations have no effect on the state of the port or its queue.
// @id: TTCN3-CORE-22.5.4-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_04_the_halt_port_operation_006 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(1);
        T.start;
        alt {
            [] p2.check(receive) { T.stop; }
            [] T.timeout { setverdict(fail); stop; }
        }
        p2.halt;
        p2.halt;
        if (not p2.checkstate("Halted")) {
            setverdict(fail);
            stop;
        }
        alt {
            [] p2.receive(1) { setverdict(pass); }
            [else] { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
