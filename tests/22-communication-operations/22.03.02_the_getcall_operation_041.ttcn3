// @requirement: 22.3.2 -- h) The index redirection shall only be used when the operation is used on an any from port array construct.
// @id: TTCN3-CORE-22.3.2-044a
// @verdict: pass reject
module M_22_03_02_the_getcall_operation_041 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P pa[2];
    }

    function f_getcall() runs on C {
        var integer v_idx;
        pa[0].getcall(S:{?}) -> @index value v_idx; // error: index redirect without any from
    }
}
