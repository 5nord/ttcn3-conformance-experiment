// @requirement: 22.2.2 -- NOTE 6: An error due to a type mismatch may happen if the types in the receive part are not compatible to the types in the assignment part or, if the from clause is missing, but the type of the sender can be determined and it is not type compatible with the type in the sender clause.
// @id: TTCN3-CORE-22.2.2-061a
// @verdict: pass reject
module M_22_02_02_the_receive_operation_054 {

    type record R { integer a }

    type port P message { inout R }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var charstring v_cs;
        p.receive(R:?) -> value (v_cs := a); // error: integer field stored in charstring variable
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
