// @requirement: 22.2.2 -- c) No binding of the incoming values to the terms of the expression or to the template shall occur.
// @id: TTCN3-CORE-22.2.2-058a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_the_receive_operation_050 {

    type port P message { inout integer }

    type component C {
        port P p;
        port P q;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        var integer v_x := 5;
        connect(mtc:p, mtc:q);
        q.send(7);
        T.start;
        alt {
            [] p.receive(v_x) { setverdict(fail); }
            [] p.receive(integer:?) {
                if (v_x == 5) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
