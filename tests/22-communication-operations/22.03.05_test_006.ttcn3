// @requirement: 22.3.5 -- The optional type field in the value specification to the raise operation shall be used in cases where it is necessary to avoid any ambiguity of the type of the value being sent.
// @id: TTCN3-CORE-22.3.5-010a
// @verdict: pass reject
module M_22_03_05_test_006 {

    type record R1 { integer f }
    type record R2 { integer f }

    signature S() exception(R1, R2);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_client() runs on C {
        p.call(S:{}, 1.0) {
            [] p.catch { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_client());
        p.getcall(S:{});
        p.raise(S, { f := 1 }); // error: type of the exception value is ambiguous (R1 or R2)
        v_ptc.done;
    }

    control {
        execute(TC(), 5.0);
    }
}
