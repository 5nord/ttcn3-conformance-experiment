// @requirement: 22.5.2 -- ( ObjectReference | ( all port ) ) "." start
// @id: TTCN3-CORE-22.5.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_02_the_start_port_operation_002 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        p1.start;
        all port.start;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
