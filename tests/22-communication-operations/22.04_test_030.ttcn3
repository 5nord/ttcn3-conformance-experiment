// @requirement: 22.4 -- When checking the port array for a matching message, call, reply or exception, the port indices to be checked are iterated from lowest to highest.
// @id: TTCN3-CORE-22.4-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_04_test_030 {

    type port MP message { inout integer; }

    type component C {
        port MP src[3];
        port MP pa[3];
        timer T := 1.0;
    }

    testcase TC() runs on C {
        var integer v_idx := -1;
        var integer v_val := -1;
        connect(mtc:src[1], mtc:pa[1]);
        connect(mtc:src[2], mtc:pa[2]);
        src[2].send(2);
        src[1].send(1);
        T.start;
        alt {
            [] pa[1].check { }
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] pa[2].check { }
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] any from pa.check(receive(integer:?) -> value v_val @index value v_idx) { }
            [else] { setverdict(fail); stop; }
        }
        if (v_idx == 1 and v_val == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
