// @requirement: 22.3.1 -- If no timeout value part is present in the call operation, no timeout exception shall be generated.
// @id: TTCN3-CORE-22.3.1-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_the_call_operation_016 {

    signature S(in integer p_x) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_server() runs on C {
        p.getcall(S:{?});
        T.start;
        T.timeout;
        p.reply(S:{-} value 1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{1}) {
            [] p.getreply(S:{-} value 1) { setverdict(pass); } // the delayed reply is still handled
        }
    }

    control {
        execute(TC());
    }
}
