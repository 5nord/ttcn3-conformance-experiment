// @requirement: 22.2.2 -- e) Type mismatch at storing the received value or parts of the received value and storing the sender shall cause an error.
// @id: TTCN3-CORE-22.2.2-060a
// @verdict: pass reject
module M_22_02_02_the_receive_operation_052 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var charstring v_cs;
        p.receive(integer:?) -> value v_cs; // error: integer value stored in charstring variable
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
