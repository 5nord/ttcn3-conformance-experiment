// @requirement: 22.5.5 -- Using the checkstate operation with all port allows to check if all ports of a component are in the specified state.
// @id: TTCN3-CORE-22.5.5-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_05_test_010 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2, p3;
    }

    testcase TC() runs on C {
        p1.stop;
        p2.stop;
        var boolean v_some := all port.checkstate("Stopped");
        p3.stop;
        var boolean v_every := all port.checkstate("Stopped");
        if (not v_some and v_every) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
