// @requirement: 22.3.2 -- The getcall operation shall remove the top call from the incoming port queue, if, and only if, the matching criteria associated to the getcall operation are fulfilled.
// @id: TTCN3-CORE-22.3.2-005b
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_02_the_getcall_operation_005 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_client() runs on C {
        p.call(S:{1});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_client());
        activate(a_guard());
        T.start;
        p.check(getcall(S:{1}));
        alt {
            [] p.getcall(S:{2}) { setverdict(fail); }
            [else] {}
        }
        p.getcall(S:{1}); // the non-matching getcall shall not have removed the call
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
