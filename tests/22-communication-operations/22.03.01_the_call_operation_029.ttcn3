// @requirement: 22.3.1 -- A multicast or broadcast call operation may cause several responses and exceptions from different communication partners.
// @id: TTCN3-CORE-22.3.1-041a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_the_call_operation_029 {

    signature S(in integer p_x) return integer exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 2.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_reply() runs on C {
        p.getcall(S:{?});
        p.reply(S:{-} value 1);
    }

    function f_raise() runs on C {
        p.getcall(S:{?});
        p.raise(S, 2);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create, v_ptc3 := C.create;
        var integer v_replies := 0, v_exceptions := 0;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        connect(mtc:p, v_ptc3:p);
        v_ptc1.start(f_reply());
        v_ptc2.start(f_reply());
        v_ptc3.start(f_raise());
        activate(a_guard());
        T.start;
        p.call(S:{0}, nowait) to all component;
        alt {
            [] p.getreply(S:{-} value 1) {
                v_replies := v_replies + 1;
                if (v_replies + v_exceptions < 3) { repeat; }
            }
            [] p.catch(S, integer:2) {
                v_exceptions := v_exceptions + 1;
                if (v_replies + v_exceptions < 3) { repeat; }
            }
        }
        if (v_replies == 2 and v_exceptions == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
