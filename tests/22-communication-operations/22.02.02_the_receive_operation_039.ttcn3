// @requirement: 22.2.2 -- To receive a message on any port from a specific port array, use the any from PortArrayRef syntax where PortArrayRef shall be a reference to a port array identifier.
// @id: TTCN3-CORE-22.2.2-047b
// @verdict: pass reject
module M_22_02_02_the_receive_operation_039 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        any from p.receive(integer:1); // error: p is not a port array
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
