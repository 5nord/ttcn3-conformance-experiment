// @requirement: 22.3.6 -- NOTE 3: An error due to a type mismatch may happen if the types in the receive part are not compatible to the types in the assignment part or, if the from clause is missing, but the type of the sender can be determined and it is not type compatible with the type in the sender clause.
// @id: TTCN3-CORE-22.3.6-061a
// @verdict: pass reject
module M_22_03_06_the_catch_operation_059 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_catch() runs on C {
        var charstring v_cs;
        p.catch(S, integer:?) -> value v_cs; // error: integer exception assigned to charstring variable
    }
}
