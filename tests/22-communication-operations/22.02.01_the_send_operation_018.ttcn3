// @requirement: 22.2.1 -- f) Applying a send operation to an unmapped or disconnected port shall cause a test case error.
// @id: TTCN3-CORE-22.2.1-027a
// @verdict: pass accept, ttcn3verdict:error
module M_22_02_01_the_send_operation_018 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        disconnect(mtc:p, v_ptc:p);
        setverdict(pass);
        p.send(1); // error: port is disconnected
    }

    control {
        execute(TC());
    }
}
