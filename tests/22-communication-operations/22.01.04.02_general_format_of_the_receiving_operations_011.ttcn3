// @requirement: 22.1.4.2 -- For the message or parameter value assignment part strong typing is not required, e.g. the variable used for storing a message shall be type-compatible to the type of the incoming message.
// @id: TTCN3-CORE-22.1.4.2-012b
// @verdict: pass reject
module M_22_01_04_02_general_format_of_the_receiving_operations_011 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var charstring v_msg;
        connect(mtc:p, v_ptc:p);
        p.receive(integer:?) -> value v_msg; // error: charstring variable not compatible with integer
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
