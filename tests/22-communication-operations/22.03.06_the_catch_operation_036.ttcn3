// @requirement: 22.3.6 -- The catch on any port from a port array operation cannot be used to catch a call timeout.
// @id: TTCN3-CORE-22.3.6-041a
// @verdict: pass reject
module M_22_03_06_the_catch_operation_036 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P pa[2];
    }

    function f_call() runs on C {
        pa[0].call(S:{}, 1.0) {
            [] any from pa.catch(timeout) {} // error: any from catch of a call timeout
        }
    }
}
