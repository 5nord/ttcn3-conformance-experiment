// @requirement: 22.5.1 -- If a port queue is already empty then this operation shall have no action on that port.
// @id: TTCN3-CORE-22.5.1-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_01_test_004 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p2.clear;
        if (not p2.checkstate("Started") or not p2.checkstate("Connected")) {
            setverdict(fail);
            stop;
        }
        p1.send(1);
        T.start;
        alt {
            [] p2.receive(1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
