// @requirement: 22.2.3 -- NOTE 2: The one-to-one connection is considered to be a simple case of the one-to-many connections and allows the usage of the from-clause.
// @id: TTCN3-CORE-22.2.3-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_the_trigger_operation_012 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_send(integer p_value) runs on C {
        p.send(p_value);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send(1));
        T.start;
        alt {
            [] p.trigger(integer:1) from v_ptc { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
