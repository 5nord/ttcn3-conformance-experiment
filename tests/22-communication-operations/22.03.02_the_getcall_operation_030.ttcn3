// @requirement: 22.3.2 -- The first port which matches all the criteria will cause the operation to be successful even if other ports in the array would also meet the criteria.
// @id: TTCN3-CORE-22.3.2-033a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_02_the_getcall_operation_030 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component CS {
        port P pa[2];
        timer T := 1.0;
    }

    type component CC {
        port P p;
    }

    altstep a_guard() runs on CS {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_client() runs on CC {
        p.call(S:{1});
    }

    testcase TC() runs on CS {
        var CC v_ptc1 := CC.create, v_ptc2 := CC.create;
        var integer v_idx;
        connect(mtc:pa[0], v_ptc1:p);
        connect(mtc:pa[1], v_ptc2:p);
        activate(a_guard());
        T.start;
        v_ptc1.start(f_client());
        v_ptc2.start(f_client());
        pa[0].check(getcall);
        pa[1].check(getcall);
        any from pa.getcall(S:{1}) -> @index value v_idx;
        alt {
            [v_idx == 0] pa[1].check(getcall(S:{1})) { setverdict(pass); } // only the first port was served
            [else] { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
