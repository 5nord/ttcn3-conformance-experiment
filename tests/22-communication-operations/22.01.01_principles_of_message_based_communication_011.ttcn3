// @requirement: 22.1.1 -- Table 22: Overview of TTCN-3 communication operations: Invoke procedure call; Col2: call; Col4: Yes
// @id: TTCN3-CORE-22.1.1-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_01_principles_of_message_based_communication_011 {

    signature S(in integer p_x) return integer exception (charstring);

    type port PP procedure {
        inout S
    }

    type component C {
        port PP p;
    }

    function f_server() runs on C {
        var integer v_x;
        timer T := 1.0;
        T.start;
        alt {
            [] p.getcall(S:{p_x := ?}) -> param(v_x) {
                p.reply(S:{p_x := -} value v_x + 1);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{p_x := 1}, 1.0) {
            [] p.getreply(S:{p_x := -} value 2) {
                setverdict(pass);
            }
            [] p.catch(timeout) {
                setverdict(fail);
            }
        }
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
