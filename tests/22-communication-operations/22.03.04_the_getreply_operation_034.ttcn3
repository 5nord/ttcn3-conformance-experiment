// @requirement: 22.3.4 -- a) A getreply operation shall only be used at a procedure-based port.
// @id: TTCN3-CORE-22.3.4-037a
// @verdict: pass reject
module M_22_03_04_the_getreply_operation_034 {

    signature S() return integer;

    type port MP message { inout integer }

    type component C {
        port MP p;
    }

    testcase TC() runs on C system C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.getreply(S:{} value 1) { setverdict(pass); } // error: getreply on a message-based port
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
