// @requirement: 22.3.5 -- NOTE 1: _Address may be an AddressRef, a list of AddressRef-s or "all component"._
// @id: TTCN3-CORE-22.3.5-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_05_test_002 {

    signature S() exception(integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_client() runs on C {
        for (var integer i := 1; i <= 3; i := i + 1) {
            p.call(S:{}, 1.0) {
                [] p.catch(S, i) {}
                [] p.catch { setverdict(fail); stop; }
                [] p.catch(timeout) { setverdict(fail); stop; }
            }
        }
        setverdict(pass);
    }

    testcase TC() runs on C system C {
        var C v_ptc1 := C.create, v_ptc2 := C.create;
        connect(self:p, v_ptc1:p);
        connect(self:p, v_ptc2:p);
        v_ptc1.start(f_client());
        v_ptc2.start(f_client());
        p.getcall(S:{});
        p.getcall(S:{});
        p.raise(S, 1) to v_ptc1;
        p.raise(S, 1) to v_ptc2;
        p.getcall(S:{});
        p.getcall(S:{});
        p.raise(S, 2) to (v_ptc1, v_ptc2);
        p.getcall(S:{});
        p.getcall(S:{});
        p.raise(S, 3) to all component;
        all component.done;
    }

    control {
        execute(TC(), 5.0);
    }
}
