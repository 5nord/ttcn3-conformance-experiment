// @requirement: 22.2.2 -- In this case, the referenced field on the right hand side of the assignment shall be one of the bitstring, hexstring, octetstring, charstring or universal charstring types.
// @id: TTCN3-CORE-22.2.2-028a
// @verdict: pass reject
module M_22_02_02_test_025 {

    type record Inner {
        integer x
    } with {
        encode "JSON"
    }

    type record Msg {
        integer id,
        integer payload
    }

    type port P message { inout Msg }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var Inner v_inner;
        connect(mtc:p, v_ptc:p);
        p.receive(Msg:?) -> value (v_inner := @decoded payload); // error: payload is of type integer
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
