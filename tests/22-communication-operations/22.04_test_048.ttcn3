// @requirement: 22.4 -- NOTE 4: An error due to a type mismatch may happen if the types in the receive part are not compatible to the types in the assignment part or, if the from clause is missing, but the type of the sender can be determined and it is not type compatible with the type in the sender clause.
// @id: TTCN3-CORE-22.4-044b
// @verdict: pass accept, ttcn3verdict:error
module M_22_04_test_048 {

    type port MP message { inout integer; }

    type component C {
        port MP p;
        timer T := 1.0;
    }

    type component P {
        port MP q;
    }

    type component D {
        port MP x;
        var integer v_d;
    }

    function f_send() runs on P {
        q.send(5);
    }

    testcase TC() runs on C {
        var P v_ptc := P.create;
        var D v_sender;
        connect(v_ptc:q, mtc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.check(-> sender v_sender) { } // causes test case error: sender of type P not compatible with D
            [] T.timeout { }
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
