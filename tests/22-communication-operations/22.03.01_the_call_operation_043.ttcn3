// @requirement: 22.3.1 -- e) A to clause shall be present in case of one-to-many connections.
// @id: TTCN3-CORE-22.3.1-055a
// @verdict: pass accept, ttcn3verdict:error
module M_22_03_01_the_call_operation_043 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        p.call(S:{1}); // error: no to clause on a one-to-many connection
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
