// @requirement: 22.5.3 -- ( ObjectReference | ( all port ) ) "." stop
// @id: TTCN3-CORE-22.5.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_03_test_003 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        p1.stop;
        all port.stop;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
