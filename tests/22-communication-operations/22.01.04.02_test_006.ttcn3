// @requirement: 22.1.4.2 -- The identification of the communication partner (denoted by the from keyword) is optional and need only be specified in cases of one-to-many connections where the receiving entity needs to be explicitly identified.
// @id: TTCN3-CORE-22.1.4.2-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_04_02_test_006 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_ptc() runs on C {
        p.send(integer:1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var C v_sender;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_ptc());
        T.start;
        alt {
            [] p.receive(integer:1) -> sender v_sender {
                if (v_sender == v_ptc) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
