// @requirement: 22.5.1 -- Table 25: Overview of TTCN-3 port operations: Halt port; Col2: halt
// @id: TTCN3-CORE-22.5.1-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_01_the_clear_port_operation_008 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1;
    }

    testcase TC() runs on C {
        p1.halt;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
