// @requirement: 22.1.4.2 -- The port name and operation name shall be present.
// @id: TTCN3-CORE-22.1.4.2-006a
// @verdict: pass reject
module M_22_01_04_02_general_format_of_the_receiving_operations_004 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.(integer:?); // error: operation name missing
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
