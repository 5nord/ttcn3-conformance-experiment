// @requirement: 22.1.3 -- Broadcast communication is from one sender to all receivers (being connected or mapped to the sender).
// @id: TTCN3-CORE-22.1.3-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_03_principles_of_unicast_multicast_and_broadcast_communication_004 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_ptc() runs on C {
        T.start;
        alt {
            [] p.receive(integer:1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create, v_ptc3 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        connect(mtc:p, v_ptc3:p);
        v_ptc1.start(f_ptc());
        v_ptc2.start(f_ptc());
        v_ptc3.start(f_ptc());
        p.send(1) to all component;
        all component.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
