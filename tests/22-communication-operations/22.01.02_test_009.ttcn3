// @requirement: 22.1.2 -- The CALLER handles the reply or exception by using getreply or catch operations.
// @id: TTCN3-CORE-22.1.2-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_02_test_009 {

    signature S(in integer p_x) return integer exception (charstring);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        var integer v_x;
        p.getcall(S:{?}) -> param(v_x);
        p.reply(S:{-} value v_x * 10);
        p.getcall(S:{?}) -> param(v_x);
        p.raise(S, charstring:"error");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_ret := 0;
        var charstring v_exc := "";
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{3}, 1.0) {
            [] p.getreply(S:{-}) -> value v_ret {}
            [] p.catch(timeout) {}
        }
        p.call(S:{4}, 1.0) {
            [] p.catch(S, charstring:?) -> value v_exc {}
            [] p.catch(timeout) {}
        }
        if (v_ret == 30 and v_exc == "error") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
