// @requirement: 22.4 -- To check on any port, use the any port keywords. **Check on any port**
// @id: TTCN3-CORE-22.4-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_04_the_check_operation_025 {

    type port MP message { inout integer; }

    type component C {
        port MP p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(mtc:p1, mtc:p2);
        p1.send(5);
        T.start;
        alt {
            [] any port.check { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
