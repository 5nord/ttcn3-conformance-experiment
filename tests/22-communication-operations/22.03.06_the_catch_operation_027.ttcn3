// @requirement: 22.3.6 -- A catch operation using only a Signature reference in the argument list allows any valid exception for that signature to be caught.
// @id: TTCN3-CORE-22.3.6-032a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_the_catch_operation_027 {

    signature S1() exception (integer, charstring);
    signature S2() exception (charstring);

    type port P procedure { inout S1, S2 }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S1:{});
        p.raise(S1, charstring:"x");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S1:{}, nowait);
        alt {
            [] p.catch(S2) { setverdict(fail); }
            [] p.catch(S1) { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
