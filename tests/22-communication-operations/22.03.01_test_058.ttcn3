// @requirement: 22.3.1 -- n) The ObjectReference shall be of a port type.
// @id: TTCN3-CORE-22.3.1-067a
// @verdict: pass reject
module M_22_03_01_test_058 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var integer v_i := 0;
        v_i.call(S:{1}); // error: ObjectReference is not of a port type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
