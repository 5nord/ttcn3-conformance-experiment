// @requirement: 22.5.5 -- b) Calling the checkstate operation with a charstring parameter not listed in a) shall lead to an error.
// @id: TTCN3-CORE-22.5.5-024a
// @verdict: pass accept, ttcn3verdict:error
module M_22_05_05_the_checkstate_port_operation_019 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1;
    }

    testcase TC() runs on C {
        var charstring v_state := "Run" & "ning";
        var boolean v_b;
        setverdict(pass);
        v_b := p1.checkstate(v_state); // error: value not in the allowed list
    }

    control {
        execute(TC());
    }
}
