// @requirement: 22.3.4 -- e) The PortArrayRef shall be a reference to a completely initialized port array.
// @id: TTCN3-CORE-22.3.4-042a
// @verdict: pass reject
module M_22_03_04_test_040 {

    signature S() return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.reply(S:{} value 1);
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        timer T := 1.0;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{}, nowait);
        T.start;
        alt {
            [] any from p.getreply(S:{} value 1) { setverdict(pass); } // error: p is not a port array
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
