// @requirement: 22.2.3 -- In the case of one-to-many connections the trigger operation may be restricted to a certain communication partner.
// @id: TTCN3-CORE-22.2.3-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_the_trigger_operation_010 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_send(integer p_value) runs on C {
        p.send(p_value);
    }

    testcase TC() runs on C {
        var C v_sender;
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc1.start(f_send(1));
        v_ptc2.start(f_send(1));
        T.start;
        alt {
            [] p.trigger(integer:1) from v_ptc1 -> sender v_sender {
                if (v_sender == v_ptc1) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
