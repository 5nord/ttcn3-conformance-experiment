// @requirement: 22.3.1 -- This is defined as an explicit value or constant of float type and defines the length of time after the call operation has started that a timeout exception shall be generated by the test system.
// @id: TTCN3-CORE-22.3.1-025a
// @verdict: pass reject
module M_22_03_01_test_014 {

    signature S(in integer p_x) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    const integer c_timeout := 1;

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.call(S:{1}, c_timeout) { // error: timeout value of integer type
            [] p.getreply { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
