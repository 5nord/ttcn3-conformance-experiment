// @requirement: 22.1.2 -- The CALLER calls a remote procedure in the CALLEE by using the call operation and continues its execution, i.e. does not wait for a reply or exception.
// @id: TTCN3-CORE-22.1.2-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_02_test_010 {

    signature S(in integer p_x) noblock exception (charstring);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T_meas := 5.0;
        timer T_delay := 0.5;
    }

    function f_server() runs on C {
        T_delay.start;
        T_delay.timeout;
        p.getcall(S:{?});
        p.getcall(S:{?});
        p.raise(S, charstring:"late");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        T_meas.start;
        p.call(S:{1});
        p.call(S:{2});
        if (T_meas.read < 0.4) { setverdict(pass); } else { setverdict(fail); }
        T_delay.start(2.0);
        alt {
            [] p.catch(S, charstring:"late") {}
            [] T_delay.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
