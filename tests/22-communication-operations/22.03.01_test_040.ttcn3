// @requirement: 22.3.1 -- d) The signature arguments of the call operation are not used to retrieve variable names for out and inout parameters.
// @id: TTCN3-CORE-22.3.1-052a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_test_040 {

    signature S(inout integer p_x);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{?});
        p.reply(S:{5});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_x := 1;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{v_x}, 1.0) {
            [] p.getreply(S:{5}) {}
            [] p.catch(timeout) { setverdict(fail); stop; }
        }
        if (v_x == 1) { // the inout value of the reply is not assigned to v_x
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
