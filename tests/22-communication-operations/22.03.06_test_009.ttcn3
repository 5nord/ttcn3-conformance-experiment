// @requirement: 22.3.6 -- The keyword value is used to retrieve the value of an exception and/or the parts of it and the keyword sender is used when it is required to retrieve the address of the sender.
// @id: TTCN3-CORE-22.3.6-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_test_009 {

    type record R {
        integer f1,
        boolean f2
    }

    signature S() exception (R);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.raise(S, R:{f1 := 5, f2 := true});
        p.getcall(S:{});
        p.raise(S, R:{f1 := 7, f2 := false});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var R v_r;
        var integer v_i;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{}, nowait);
        p.call(S:{}, nowait);
        p.catch(S, R:?) -> value v_r;
        p.catch(S, R:?) -> value (v_i := f1);
        if (v_r == {f1 := 5, f2 := true} and v_i == 7) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
