// @requirement: 22.3.2 -- In case the referenced field is of the universal `charstring type, the @decoded` clause can contain an optional parameter defining the encoding format.
// @id: TTCN3-CORE-22.3.2-019a
// @verdict: pass accept, noexecution
module M_22_03_02_test_016 {

    signature S(in universal charstring p_enc) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_getcall() runs on C {
        var integer v_i;
        p.getcall(S:{?}) -> param(v_i := @decoded("UTF-8") p_enc);
    }
}
