// @requirement: 22.1.4.2 -- b) defines an optional matching part which specifies the acceptable input which will match the statement;
// @id: TTCN3-CORE-22.1.4.2-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_04_02_general_format_of_the_receiving_operations_002 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_ptc() runs on C {
        p.send(integer:50);
        p.send(integer:5);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_ptc());
        T.start;
        alt {
            [] p.receive(integer:(1..10)) { setverdict(fail); }
            [] p.receive(integer:(11..100)) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
        alt {
            [] p.receive(integer:(11..100)) { setverdict(fail); }
            [] p.receive(integer:(1..10)) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
