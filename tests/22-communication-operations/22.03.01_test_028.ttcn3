// @requirement: 22.3.1 -- In case of one-to-one connections, the to clause may be omitted, because the receiving entity is uniquely identified by the system structure.
// @id: TTCN3-CORE-22.3.1-039a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_test_028 {

    signature S(in integer p_x) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{?});
        p.reply(S:{-} value 1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{1}, 1.0) {
            [] p.getreply(S:{-} value 1) from v_ptc { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
