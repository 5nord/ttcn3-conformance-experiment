// @requirement: 22.3.1 -- A blocking procedure may have no return values, no out and inout parameters and may raise no exception.
// @id: TTCN3-CORE-22.3.1-031a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_the_call_operation_019 {

    signature S(in integer p_x, in boolean p_y);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{?, ?});
        p.reply(S:{-, -});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{7, false}, 1.0) {
            [] p.getreply(S:{-, -}) { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
