// @requirement: 22.3.1 -- m) Applying a call operation to an unmapped or disconnected port shall cause a test case error.
// @id: TTCN3-CORE-22.3.1-066a
// @verdict: pass accept, ttcn3verdict:error
module M_22_03_01_test_057 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        p.call(S:{1}); // error: port is neither connected nor mapped
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
