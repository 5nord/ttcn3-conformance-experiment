// @requirement: 22.2.2 -- To receive a message on any port, use the any port keywords.
// @id: TTCN3-CORE-22.2.2-045a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_test_037 {

    type port P message { inout integer }

    type component C {
        port P p1;
        port P p2;
        timer T := 1.0;
    }

    type component CP {
        port P p;
    }

    function f_send() runs on CP {
        p.send(1);
    }

    testcase TC() runs on C {
        var CP v_ptc := CP.create;
        connect(mtc:p2, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] any port.receive(integer:1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
