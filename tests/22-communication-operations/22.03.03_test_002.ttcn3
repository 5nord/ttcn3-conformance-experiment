// @requirement: 22.3.3 -- NOTE 1: _Address may be an AddressRef, a list of AddressRef-s or "all component"._
// @id: TTCN3-CORE-22.3.3-003a
// @verdict: pass accept, noexecution
module M_22_03_03_test_002 {

    signature S(out integer p_y);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_reply(C p_peer1, C p_peer2) runs on C {
        p.reply(S:{1}) to p_peer1;
        p.reply(S:{1}) to (p_peer1, p_peer2);
        p.reply(S:{1}) to all component;
    }
}
