// @requirement: 22.5.4 -- The halt operation is comparable to the stop operation, but allows entries being already in the queue to be processed with receiving operations.
// @id: TTCN3-CORE-22.5.4-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_04_the_halt_port_operation_001 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(1);
        T.start;
        alt {
            [] p2.check(receive) { T.stop; }
            [] T.timeout { setverdict(fail); stop; }
        }
        p2.halt;
        alt {
            [] p2.receive(1) { setverdict(pass); }
            [else] { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
