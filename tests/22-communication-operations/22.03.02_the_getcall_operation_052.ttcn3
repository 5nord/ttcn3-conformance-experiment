// @requirement: 22.3.2 -- o) The @nodefault modifier is allowed only in stand-alone getcall statements.
// @id: TTCN3-CORE-22.3.2-053a
// @verdict: pass reject
module M_22_03_02_the_getcall_operation_052 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_getcall() runs on C {
        T.start;
        alt {
            [] @nodefault p.getcall(S:{?}) {} // error: @nodefault in an alt branch
            [] T.timeout {}
        }
    }
}
