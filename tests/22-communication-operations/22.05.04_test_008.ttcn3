// @requirement: 22.5.4 -- After all entries in the queue ahead of the marker have been processed, the state of the port is equivalent to the stopped state.
// @id: TTCN3-CORE-22.5.4-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_04_test_008 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(1);
        T.start;
        alt {
            [] p2.check(receive) { T.stop; }
            [] T.timeout { setverdict(fail); stop; }
        }
        p2.halt;
        alt {
            [] p2.receive(1) { }
            [else] { setverdict(fail); stop; }
        }
        p1.send(2);
        T.start(0.5);
        alt {
            [] p2.receive { setverdict(fail); }
            [] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
