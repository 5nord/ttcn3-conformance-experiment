// @requirement: 22.4 -- i) The ObjectReference shall be of a port type.
// @id: TTCN3-CORE-22.4-041a
// @verdict: pass reject
module M_22_04_the_check_operation_045 {

    type port MP message { inout integer; }

    type component C {
        port MP p;
    }

    testcase TC() runs on C {
        var integer v_i := 0;
        v_i.check(receive(5)); // error: ObjectReference is not of a port type
    }

    control {
        execute(TC());
    }
}
