// @requirement: 22.5.5 -- ( ObjectReference | ( all port ) | ( any port )) "." checkstate "(" SingleExpression ")"
// @id: TTCN3-CORE-22.5.5-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_05_the_checkstate_port_operation_001 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        var boolean v_b1 := p1.checkstate("Started");
        var boolean v_b2 := all port.checkstate("Started");
        var boolean v_b3 := any port.checkstate("Start" & "ed");
        if (v_b1 and v_b2 and v_b3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
