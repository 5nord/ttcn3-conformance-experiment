// @requirement: 22.2.2 -- p) The @nodefault modifier is allowed only in stand-alone receive statements.
// @id: TTCN3-CORE-22.2.2-072b
// @verdict: pass reject
module M_22_02_02_the_receive_operation_069 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [] @nodefault p.receive(integer:?) { setverdict(pass); } // error: @nodefault in an alt branch
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
