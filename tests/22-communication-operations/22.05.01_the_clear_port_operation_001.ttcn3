// @requirement: 22.5.1 -- ( ObjectReference | ( all port ) ) "." clear
// @id: TTCN3-CORE-22.5.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_01_the_clear_port_operation_001 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        p1.clear;
        all port.clear;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
