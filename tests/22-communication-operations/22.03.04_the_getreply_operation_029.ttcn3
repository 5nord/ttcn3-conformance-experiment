// @requirement: 22.3.4 -- It is also possible to store the index of a port in a single-dimensional port array at which the operation was successful to a variable of type integer or, in case of multi-dimensional port arrays the index of the successful port to an integer array or record of integer variable.
// @id: TTCN3-CORE-22.3.4-032a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_04_the_getreply_operation_029 {

    signature S(out integer p_y);

    type port P procedure { inout S }

    type component CS {
        port P p;
    }

    type component CC {
        port P pa[3];
        timer T := 1.0;
    }

    altstep a_guard() runs on CC {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on CS {
        p.getcall(S:{-});
        p.reply(S:{1});
    }

    testcase TC() runs on CC {
        var CS v_ptc := CS.create;
        var integer v_idx;
        connect(mtc:pa[2], v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        pa[2].call(S:{-}, nowait);
        any from pa.getreply(S:{1}) -> @index value v_idx;
        if (v_idx == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
