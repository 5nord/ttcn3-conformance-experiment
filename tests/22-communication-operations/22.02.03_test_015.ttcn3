// @requirement: 22.2.3 -- To trigger on a message at any port, use the any port keywords.
// @id: TTCN3-CORE-22.2.3-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_test_015 {

    type port P message { inout integer }

    type component C {
        port P p1;
        port P p2;
        port P q;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(mtc:p2, mtc:q);
        q.send(1);
        T.start;
        alt {
            [] any port.trigger { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
