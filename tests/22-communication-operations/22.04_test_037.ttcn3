// @requirement: 22.4 -- c) The PortArrayRef shall be a reference to a completely initialized port array.
// @id: TTCN3-CORE-22.4-034a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_04_test_037 {

    type port MP message { inout integer; }

    type component C {
        port MP src;
        port MP pa[2][2];
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(mtc:src, mtc:pa[1][1]);
        src.send(5);
        T.start;
        alt {
            [] any from pa.check(receive(5)) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
