// @requirement: 22.3.1 -- The use of else branches and the invocation of altsteps is not allowed.
// @id: TTCN3-CORE-22.3.1-060a
// @verdict: pass reject
module M_22_03_01_the_call_operation_049 {

    signature S(in integer p_x);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.call(S:{1}, 1.0) {
            [] p.getreply(S:{-}) {}
            [else] {} // error: else branch in a call body
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
