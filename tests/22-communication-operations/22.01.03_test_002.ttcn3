// @requirement: 22.1.3 -- Unicast communication means one sender to one receiver.
// @id: TTCN3-CORE-22.1.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_03_test_002 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 0.5;
    }

    function f_ptc(boolean p_expect) runs on C {
        T.start;
        alt {
            [] p.receive(integer:1) {
                if (p_expect) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout {
                if (p_expect) { setverdict(fail); } else { setverdict(pass); }
            }
        }
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc1.start(f_ptc(true));
        v_ptc2.start(f_ptc(false));
        p.send(1) to v_ptc1;
        all component.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
