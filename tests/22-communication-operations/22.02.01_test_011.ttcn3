// @requirement: 22.2.1 -- a) The TemplateInstance (and all parts of it) shall have a specific value i.e. the use of matching mechanisms such as AnyValue is not allowed.
// @id: TTCN3-CORE-22.2.1-013b
// @verdict: pass reject
module M_22_02_01_test_011 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.send(integer:?); // error: AnyValue in sent template
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
