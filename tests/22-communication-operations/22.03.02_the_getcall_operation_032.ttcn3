// @requirement: 22.3.2 -- The type definition of the port shall include the name of the procedure to which the getcall operation belongs in its in or inout list.
// @id: TTCN3-CORE-22.3.2-036a
// @verdict: pass reject
module M_22_03_02_the_getcall_operation_032 {

    signature S(in integer p_x) noblock;

    type port P procedure { out S }

    type component C {
        port P p;
    }

    function f_getcall() runs on C {
        p.getcall(S:{?}); // error: S is only in the out list of the port type
    }
}
