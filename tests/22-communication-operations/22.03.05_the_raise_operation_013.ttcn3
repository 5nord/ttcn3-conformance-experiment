// @requirement: 22.3.5 -- c) A to clause shall be present in case of one-to-many connections.
// @id: TTCN3-CORE-22.3.5-020a
// @verdict: pass accept, ttcn3verdict:error
module M_22_03_05_the_raise_operation_013 {

    signature S() exception(integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_client() runs on C {
        p.call(S:{}, 1.0) {
            [] p.catch(S, 1) {}
            [] p.catch(timeout) {}
        }
    }

    testcase TC() runs on C system C {
        var C v_ptc1 := C.create, v_ptc2 := C.create;
        connect(self:p, v_ptc1:p);
        connect(self:p, v_ptc2:p);
        v_ptc1.start(f_client());
        v_ptc2.start(f_client());
        p.getcall(S:{});
        p.getcall(S:{});
        p.raise(S, 1); // error: no to clause for a one-to-many connection
        all component.done;
        setverdict(pass);
    }

    control {
        execute(TC(), 5.0);
    }
}
