// @requirement: 22.2.2 -- The variable or formal parameter shall be type compatible with the type of the referenced field or element.
// @id: TTCN3-CORE-22.2.2-026a
// @verdict: pass reject
module M_22_02_02_the_receive_operation_023 {

    type record R {
        integer a,
        charstring b
    }

    type port P message { inout R }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var charstring v_cs;
        connect(mtc:p, v_ptc:p);
        p.receive(R:?) -> value (v_cs := a); // error: charstring variable for integer field a
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
