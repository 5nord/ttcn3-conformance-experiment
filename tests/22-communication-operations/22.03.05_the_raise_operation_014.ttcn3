// @requirement: 22.3.5 -- d) All AddressRef items in the to clause shall be of type address, component or of the address type bound to the port type (see clause 6.2.9) of the port instance referenced in the raise operation.
// @id: TTCN3-CORE-22.3.5-021a
// @verdict: pass reject
module M_22_03_05_the_raise_operation_014 {

    signature S() exception(integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_client() runs on C {
        p.call(S:{}, 1.0) {
            [] p.catch(S, 1) { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create("PTC");
        var charstring v_name := "PTC";
        connect(self:p, v_ptc:p);
        v_ptc.start(f_client());
        p.getcall(S:{});
        p.raise(S, 1) to v_name; // error: charstring in the to clause
        v_ptc.done;
    }

    control {
        execute(TC(), 5.0);
    }
}
