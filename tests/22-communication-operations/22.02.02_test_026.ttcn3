// @requirement: 22.2.2 -- It shall be decoded into a value of the same type as the variable on the left hand side of the assignment.
// @id: TTCN3-CORE-22.2.2-029a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_test_026 {

    type record Inner {
        integer x,
        charstring y
    } with {
        encode "JSON"
    }

    type record Msg {
        integer id,
        bitstring payload
    }

    type port P message { inout Msg }

    type component C {
        port P p;
        timer T := 1.0;
    }

    const Inner c_inner := { x := 5, y := "abc" };

    function f_send() runs on C {
        p.send(Msg:{ id := 1, payload := encvalue(c_inner) });
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var Inner v_inner;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.receive(Msg:?) -> value (v_inner := @decoded payload) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        if (v_inner == c_inner) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
