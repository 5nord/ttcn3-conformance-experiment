// @requirement: 22.1.1 -- Table 22: Overview of TTCN-3 communication operations: Reply to procedure call from remote entity; Col2: reply; Col4: Yes
// @id: TTCN3-CORE-22.1.1-015b
// @verdict: pass reject
module M_22_01_01_test_016 {

    signature S(in integer p_x) return integer exception (charstring);

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.reply(S:{p_x := -} value 1); // error: reply used at a message-based port
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
