// @requirement: 22.2.2 -- This restriction shall be denoted using the from keyword followed by a specification of an address or component reference, a list of address or component references or any component.
// @id: TTCN3-CORE-22.2.2-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_test_012 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_send() runs on C {
        p.send(1);
        p.send(2);
        p.send(3);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var C v_ptc3 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        connect(mtc:p, v_ptc3:p);
        v_ptc2.start(f_send());
        T.start;
        alt {
            [] p.receive(integer:1) from v_ptc1 { setverdict(fail); stop; }
            [] p.receive(integer:1) from v_ptc2 { }
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] p.receive(integer:2) from (v_ptc1, v_ptc3) { setverdict(fail); stop; }
            [] p.receive(integer:2) from (v_ptc1, v_ptc2) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] p.receive(integer:3) from any component { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
