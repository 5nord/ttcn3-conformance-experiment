// @requirement: 22.2.2 -- When the message is received on a connected port, only the component reference is stored in the following the sender keyword, but the test system shall internally store the component name too, if any (to be used in logging).
// @id: TTCN3-CORE-22.2.2-041a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_test_035 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_send() runs on C {
        p.send(1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create("sender_ptc");
        var C v_sender := null;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.receive(integer:1) -> sender v_sender { }
            [] T.timeout { setverdict(fail); stop; }
        }
        log(v_sender);
        if (v_sender == v_ptc) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
