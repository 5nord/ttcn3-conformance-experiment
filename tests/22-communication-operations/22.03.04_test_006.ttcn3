// @requirement: 22.3.4 -- Matching against a received return value can be specified by using the value keyword.
// @id: TTCN3-CORE-22.3.4-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_04_test_006 {

    signature S(out integer p_y) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{-});
        p.reply(S:{1} value 7);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{-}, nowait);
        p.check(getreply);
        alt {
            [] p.getreply(S:{1} value 8) { setverdict(fail); }
            [] p.getreply(S:{1} value 7) { setverdict(pass); }
            [else] { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
