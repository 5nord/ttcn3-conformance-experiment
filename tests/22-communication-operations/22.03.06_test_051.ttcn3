// @requirement: 22.3.6 -- i) The index redirection shall only be used when the operation is used on an any from port array construct.
// @id: TTCN3-CORE-22.3.6-055a
// @verdict: pass reject
module M_22_03_06_test_051 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_catch() runs on C {
        var integer v_idx;
        p.catch(S, integer:?) -> @index value v_idx; // error: index redirection without any from
    }
}
