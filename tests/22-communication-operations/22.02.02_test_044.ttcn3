// @requirement: 22.2.2 -- The first port which matches all the criteria will cause the operation to be successful even if other ports in the array would also meet the criteria.
// @id: TTCN3-CORE-22.2.2-051a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_test_044 {

    type port P message { inout integer }

    type component C {
        port P p[3];
        port P q[3];
        timer T := 1.0;
        timer T_wait := 0.2;
    }

    testcase TC() runs on C {
        var integer v_i;
        for (var integer i := 0; i < 3; i := i + 1) {
            connect(mtc:p[i], mtc:q[i]);
        }
        q[1].send(5);
        q[2].send(5);
        T_wait.start;
        T_wait.timeout;
        T.start;
        alt {
            [] any from p.receive(integer:5) -> @index value v_i {
                if (v_i != 1) { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
        alt {
            [] p[2].receive(integer:5) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
