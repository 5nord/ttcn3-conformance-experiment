// @requirement: 22.3.6 -- If the operation contains a sender clause but no from clause, the sender shall be type compatible with the variable or parameter referenced in the sender clause.
// @id: TTCN3-CORE-22.3.6-060a
// @verdict: pass accept, ttcn3verdict:error
module M_22_03_06_the_catch_operation_058 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    type component D {
        var integer v_x;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.raise(S, integer:1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var D v_sender;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{}, nowait);
        p.catch(S, integer:?) -> sender v_sender; // error: sender of type C is not compatible with D
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
