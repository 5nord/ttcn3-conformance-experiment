// @requirement: 22.3.1 -- All further responses and exceptions are handled in subsequent alt or interleave statements.
// @id: TTCN3-CORE-22.3.1-044a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_test_032 {

    signature S(in integer p_x) return integer exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 2.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_reply() runs on C {
        p.getcall(S:{?});
        p.reply(S:{-} value 1);
    }

    function f_raise() runs on C {
        p.getcall(S:{?});
        p.raise(S, 2);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create, v_ptc3 := C.create;
        var integer v_handled := 0;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        connect(mtc:p, v_ptc3:p);
        v_ptc1.start(f_reply());
        v_ptc2.start(f_reply());
        v_ptc3.start(f_raise());
        p.call(S:{0}, 1.0) to all component {
            [] p.getreply(S:{-} value 1) { v_handled := v_handled + 1; }
            [] p.catch(S, integer:2) { v_handled := v_handled + 1; }
            [] p.catch(timeout) { setverdict(fail); stop; }
        }
        activate(a_guard());
        T.start;
        alt {
            [] p.getreply(S:{-} value 1) {
                v_handled := v_handled + 1;
                if (v_handled < 3) { repeat; }
            }
            [] p.catch(S, integer:2) {
                v_handled := v_handled + 1;
                if (v_handled < 3) { repeat; }
            }
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
