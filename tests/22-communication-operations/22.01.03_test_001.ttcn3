// @requirement: 22.1.3 -- TTCN-3 supports unicast, multicast and broadcast communication:
// @id: TTCN3-CORE-22.1.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_03_test_001 {

    type port P message { inout integer }

    type record of integer IntList;

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_ptc(IntList p_expected) runs on C {
        T.start;
        for (var integer i := 0; i < lengthof(p_expected); i := i + 1) {
            alt {
                [] p.receive(p_expected[i]) {}
                [] p.receive { setverdict(fail); stop; }
                [] T.timeout { setverdict(fail); stop; }
            }
        }
        setverdict(pass);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create, v_ptc3 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        connect(mtc:p, v_ptc3:p);
        v_ptc1.start(f_ptc({1, 2, 3}));
        v_ptc2.start(f_ptc({2, 3}));
        v_ptc3.start(f_ptc({3}));
        p.send(1) to v_ptc1;
        p.send(2) to (v_ptc1, v_ptc2);
        p.send(3) to all component;
        all component.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
