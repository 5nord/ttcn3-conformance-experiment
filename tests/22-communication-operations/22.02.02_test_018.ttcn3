// @requirement: 22.2.2 -- The variable or formal parameter shall be type compatible with the received message.
// @id: TTCN3-CORE-22.2.2-021a
// @verdict: pass reject
module M_22_02_02_test_018 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var charstring v_cs;
        connect(mtc:p, v_ptc:p);
        p.receive(integer:?) -> value v_cs; // error: charstring variable for integer message
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
