// @requirement: 22.3.2 -- b) The signature argument of the getcall operation shall not be used to pass in variable names for in and inout parameters.
// @id: TTCN3-CORE-22.3.2-037a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_02_test_033 {

    signature S(in integer p_x) noblock;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_client() runs on C {
        p.call(S:{5});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_x := 7;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_client());
        activate(a_guard());
        T.start;
        p.check(getcall);
        alt {
            [] p.getcall(S:{v_x}) { setverdict(fail); } // v_x is a matching value, not a target variable
            [] p.getcall(S:{?}) -> param(v_x) {
                if (v_x == 5) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
        }
    }

    control {
        execute(TC());
    }
}
