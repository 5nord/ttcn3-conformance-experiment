// @requirement: 22.5.3 -- If a port is defined as allowing receiving operations such as receive and getcall, the stop operation causes listening at the named port to cease.
// @id: TTCN3-CORE-22.5.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_03_test_004 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        timer T := 0.5;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p2.stop;
        p1.send(1);
        T.start;
        alt {
            [] p2.receive { setverdict(fail); }
            [] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
