// @requirement: 22.4 -- d) The index redirection shall only be used when the operation is used on an any from port array construct.
// @id: TTCN3-CORE-22.4-035a
// @verdict: pass reject
module M_22_04_test_038 {

    type port MP message { inout integer; }

    type component C {
        port MP p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        var integer v_idx;
        connect(mtc:p1, mtc:p2);
        p1.send(5);
        T.start;
        alt {
            [] p2.check(receive(5) -> @index value v_idx) { setverdict(pass); } // error: @index without any from
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
