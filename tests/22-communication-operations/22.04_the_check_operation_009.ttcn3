// @requirement: 22.4 -- It is the top element of an incoming port queue that shall be checked (it is not possible to look into the queue).
// @id: TTCN3-CORE-22.4-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_04_the_check_operation_009 {

    type port MP message { inout integer; }

    type component C {
        port MP p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(mtc:p1, mtc:p2);
        p1.send(1);
        p1.send(2);
        T.start;
        alt {
            [] p2.check(receive(2)) { setverdict(fail); }
            [] p2.check(receive(1)) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
