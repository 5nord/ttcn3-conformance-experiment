// @requirement: 22.0 -- TTCN-3 supports message-based and procedure-based _unicast, multicast and broadcast communication.
// @id: TTCN3-CORE-22.0-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_00_general_001 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    function f_receive(integer p_first) runs on C {
        timer T := 1.0;
        T.start;
        for (var integer i := p_first; i <= 3; i := i + 1) {
            alt {
                [] p.receive(i) {}
                [] T.timeout {
                    setverdict(fail);
                    stop;
                }
            }
        }
        setverdict(pass);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc1.start(f_receive(1));
        v_ptc2.start(f_receive(2));
        p.send(1) to v_ptc1;
        p.send(2) to (v_ptc1, v_ptc2);
        p.send(3) to all component;
        all component.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
