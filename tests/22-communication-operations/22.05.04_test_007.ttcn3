// @requirement: 22.5.4 -- Entries ahead of the marker can be processed normally.
// @id: TTCN3-CORE-22.5.4-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_04_test_007 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        var integer v_rec := 0;
        connect(self:p1, self:p2);
        p1.send(3);
        T.start;
        alt {
            [] p2.check(receive) { T.stop; }
            [] T.timeout { setverdict(fail); stop; }
        }
        p2.halt;
        alt {
            [] p2.check(receive(3)) { }
            [else] { setverdict(fail); stop; }
        }
        alt {
            [] p2.receive(integer:?) -> value v_rec { }
            [else] { setverdict(fail); stop; }
        }
        if (v_rec == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
