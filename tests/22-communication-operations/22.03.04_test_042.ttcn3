// @requirement: 22.3.4 -- g) If the index redirection is used for single-dimensional arrays, the type of the integer variable shall allow storing the highest index of the respective port array.
// @id: TTCN3-CORE-22.3.4-044a
// @verdict: pass reject
module M_22_03_04_test_042 {

    signature S() return integer;

    type port P procedure { inout S }

    type component C {
        port P p[3];
    }

    type integer SmallIndex (0 .. 1);

    function f_server() runs on C {
        p[1].getcall(S:{});
        p[1].reply(S:{} value 1);
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        var SmallIndex v_i;
        timer T := 1.0;
        for (var integer i := 0; i < 3; i := i + 1) {
            connect(self:p[i], v_ptc:p[i]);
        }
        v_ptc.start(f_server());
        p[1].call(S:{}, nowait);
        T.start;
        alt {
            [] any from p.getreply(S:{} value 1) -> @index value v_i { setverdict(pass); } // error: type cannot hold index 2
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
