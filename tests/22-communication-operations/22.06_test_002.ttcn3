// @requirement: 22.6 -- The keywords any port and all port address all ports owned by a test component and not only the ports known in the scope of the function or altstep that is executed on the component.
// @id: TTCN3-CORE-22.6-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_06_test_002 {

    type port P message { inout integer }

    type component CB {}

    type component C extends CB {
        port P p1;
        port P p2;
    }

    function f_receive() runs on CB {
        timer T := 1.0;
        T.start;
        alt {
            [] any port.receive {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(1);
        f_receive();
    }

    control {
        execute(TC());
    }
}
