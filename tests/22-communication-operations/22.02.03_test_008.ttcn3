// @requirement: 22.2.3 -- The trigger operation requires the port name, matching criteria for type and value, an optional from restriction (i.e. selection of communication partner) and an optional assignment of the matching message and sender component to variables.
// @id: TTCN3-CORE-22.2.3-007c
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_test_008 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_send(integer p_value) runs on C {
        p.send(p_value);
    }

    testcase TC() runs on C {
        var integer v_x;
        var C v_sender;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send(1));
        T.start;
        alt {
            [] p.trigger(integer:?) -> value v_x sender v_sender {
                if (v_x == 1 and v_sender == v_ptc) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
