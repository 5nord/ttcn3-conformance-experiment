// @requirement: 22.4 -- In this case, the value, sender or parameter storing parts of the receiving operation, if any, are executed, i.e. the message and/or a part of it, the sender's address or component reference, the parameter(s) of the call or reply or the value of the exception are stored in the associated variables. The check operation is successful if the receiving operation is successful.
// @id: TTCN3-CORE-22.4-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_04_the_check_operation_017 {

    type record R {
        integer f1,
        integer f2
    }

    const R c_msg := {f1 := 1, f2 := 2};

    type port MP message { inout R; }

    signature S(inout integer p_x) return integer exception (charstring);

    type port PP procedure { inout S; }

    type component C {
        port MP p1, p2;
        port PP q1, q2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        var R v_msg;
        var integer v_field, v_call_par, v_reply_par, v_ret;
        var charstring v_exc;
        var C v_sender, v_call_sender;
        connect(mtc:p1, mtc:p2);
        connect(mtc:q1, mtc:q2);
        p1.send(c_msg);
        q1.call(S:{4}, nowait);
        q1.call(S:{5}, nowait);
        T.start;
        alt {
            [] p2.check(receive(R:?) -> value v_msg sender v_sender) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] p2.check(receive(R:?) -> value (v_field := f2)) { }
            [else] { setverdict(fail); stop; }
        }
        T.start;
        alt {
            [] q2.check(getcall(S:{?}) -> param(v_call_par) sender v_call_sender) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        q2.getcall(S:{4});
        q2.reply(S:{8} value 9);
        T.start;
        alt {
            [] q2.check(getcall(S:{5})) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        q2.getcall(S:{5});
        q2.raise(S, charstring:"exc");
        T.start;
        alt {
            [] q1.check(getreply(S:{?} value ?) -> value v_ret param(v_reply_par)) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        q1.getreply;
        T.start;
        alt {
            [] q1.check(catch(S, charstring:?) -> value v_exc) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        if (v_msg == c_msg and v_sender == mtc and v_field == 2 and
            v_call_par == 4 and v_call_sender == mtc and
            v_ret == 9 and v_reply_par == 8 and v_exc == "exc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
