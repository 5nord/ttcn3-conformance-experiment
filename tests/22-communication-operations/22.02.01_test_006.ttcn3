// @requirement: 22.2.1 -- A to clause can be omitted in case of a one-to-one connection where unicast communication is used and the message receiver is uniquely determined by the test system structure.
// @id: TTCN3-CORE-22.2.1-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_01_test_006 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_receive() runs on C {
        T.start;
        alt {
            [] p.receive(integer:7) { setverdict(pass); }
            [] p.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_receive());
        p.send(7);
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
