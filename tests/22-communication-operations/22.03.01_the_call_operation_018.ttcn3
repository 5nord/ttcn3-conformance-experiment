// @requirement: 22.3.1 -- If the nowait keyword is used, a possible response or exception of the called procedure has to be removed from the port queue by using a getreply or a catch operation in a subsequent alt statement.
// @id: TTCN3-CORE-22.3.1-029a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_the_call_operation_018 {

    signature S(in integer p_x) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_server() runs on C {
        p.getcall(S:{?});
        p.reply(S:{-} value 1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{1}, nowait);
        T.start;
        alt {
            [] p.getreply(S:{-} value 1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
        alt {
            [] p.getreply { setverdict(fail); } // the reply has been removed
            [else] {}
        }
    }

    control {
        execute(TC());
    }
}
