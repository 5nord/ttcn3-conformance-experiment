// @requirement: 22.3.6 -- The timeout exception is an emergency exit for cases where a called procedure neither replies nor raises an exception within a predetermined time (see clause 22.3.1).
// @id: TTCN3-CORE-22.3.6-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_test_024 {

    signature S(in boolean p_reply) exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{true});
        p.reply(S:{-});
        p.getcall(S:{false});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{true}, 1.0) {
            [] p.getreply(S:{-}) {}
            [] p.catch(timeout) { setverdict(fail); stop; } // procedure replied in time
        }
        p.call(S:{false}, 0.1) {
            [] p.getreply(S:{-}) { setverdict(fail); }
            [] p.catch(timeout) { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
