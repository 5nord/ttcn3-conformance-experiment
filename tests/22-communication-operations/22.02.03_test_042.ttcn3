// @requirement: 22.2.3 -- h) If the index redirection is used for multi-dimensional port arrays, the size of the integer array or record of integer type shall exactly be the same as the dimension of the respective array, and its type shall allow storing the highest index (from all dimensions) of the array.
// @id: TTCN3-CORE-22.2.3-043b
// @verdict: pass reject
module M_22_02_03_test_042 {

    type port P message { inout integer }

    type integer Idx (0..1);

    type component C {
        port P p[2][4];
    }

    testcase TC() runs on C {
        var Idx v_i[2];
        any from p.trigger(integer:?) -> @index value v_i; // error: Idx cannot store index 3
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
