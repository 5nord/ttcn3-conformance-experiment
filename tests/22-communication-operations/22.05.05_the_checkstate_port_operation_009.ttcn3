// @requirement: 22.5.5 -- Using the checkstate operation with any port allows to test if at least one port of a test component is in the specified state.
// @id: TTCN3-CORE-22.5.5-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_05_the_checkstate_port_operation_009 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2, p3;
    }

    testcase TC() runs on C {
        var boolean v_before := any port.checkstate("Stopped");
        p2.stop;
        var boolean v_after := any port.checkstate("Stopped");
        if (not v_before and v_after) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
