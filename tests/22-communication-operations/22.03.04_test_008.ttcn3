// @requirement: 22.3.4 -- This restriction shall be denoted by using the from keyword followed by a specification of an address or component reference, a list of address or component references or any component.
// @id: TTCN3-CORE-22.3.4-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_04_test_008 {

    signature S(out integer p_y);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        for (var integer i := 1; i <= 3; i := i + 1) {
            p.getcall(S:{-});
            p.reply(S:{i});
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create, v_other := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{-}, nowait);
        p.call(S:{-}, nowait);
        p.call(S:{-}, nowait);
        p.getreply(S:{1}) from v_ptc;
        p.getreply(S:{2}) from (v_other, v_ptc);
        p.getreply(S:{3}) from any component;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
