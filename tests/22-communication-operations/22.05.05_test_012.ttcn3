// @requirement: 22.5.5 -- a) The parameter of the checkstate operation shall be of type charstring and shall have one of the following values: 1) "Started" 2) "Halted" 3) "Stopped" 4) "Connected" 5) "Mapped" 6) "Linked"
// @id: TTCN3-CORE-22.5.5-015b
// @verdict: pass reject
module M_22_05_05_test_012 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1;
    }

    testcase TC() runs on C {
        var boolean v_b := p1.checkstate("Running"); // error: value not in the allowed list
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
