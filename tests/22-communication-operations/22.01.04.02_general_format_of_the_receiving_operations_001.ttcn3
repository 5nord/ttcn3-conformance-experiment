// @requirement: 22.1.4.2 -- a) specifies the port at which the operation shall take place;
// @id: TTCN3-CORE-22.1.4.2-003a
// @verdict: pass reject
module M_22_01_04_02_general_format_of_the_receiving_operations_001 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        receive(integer:?); // error: no port specified
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
