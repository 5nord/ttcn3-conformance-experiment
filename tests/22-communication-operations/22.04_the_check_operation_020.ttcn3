// @requirement: 22.4 -- This restriction shall be denoted using the from keyword followed by a specification of an address or component reference, a list of address or component references or any component.
// @id: TTCN3-CORE-22.4-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_04_the_check_operation_020 {

    type port MP message { inout integer; }

    type component C {
        port MP p;
        timer T := 1.0;
    }

    function f_send(integer p_value) runs on C {
        p.send(p_value);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var C v_ptc3 := C.create;
        connect(v_ptc1:p, mtc:p);
        connect(v_ptc2:p, mtc:p);
        connect(v_ptc3:p, mtc:p);
        v_ptc1.start(f_send(5));
        T.start;
        alt {
            [] p.check(receive(5) from v_ptc1) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] p.check(receive(5) from (v_ptc2, v_ptc3)) { setverdict(fail); stop; }
            [] p.check(receive(5) from (v_ptc3, v_ptc1)) { }
            [else] { setverdict(fail); stop; }
        }
        alt {
            [] p.check(receive(5) from any component) { setverdict(pass); }
            [else] { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
