// @requirement: 22.3.4 -- b) The signature argument of the getreply operation shall not be used to pass in variable names for out and inout parameters.
// @id: TTCN3-CORE-22.3.4-039a
// @verdict: pass reject
module M_22_03_04_the_getreply_operation_036 {

    signature S(out integer p_out, inout integer p_inout);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{ -, ? });
        p.reply(S:{ 1, 2 });
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        var integer v_out, v_inout;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{ -, 0 }, 1.0) {
            [] p.getreply(S:{ v_out, v_inout }) { // error: variable names passed in the signature argument
                setverdict(pass);
            }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
