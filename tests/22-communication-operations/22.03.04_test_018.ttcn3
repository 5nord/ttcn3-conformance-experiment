// @requirement: 22.3.4 -- Failure of this decoding shall cause a test case error.
// @id: TTCN3-CORE-22.3.4-020a
// @verdict: pass accept, ttcn3verdict:error
module M_22_03_04_test_018 {

    signature S(out octetstring p_enc);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{-});
        p.reply(S:{''O});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_i;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{-}, nowait);
        p.getreply(S:{?}) -> param(v_i := @decoded p_enc); // error: empty octetstring cannot be decoded
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
