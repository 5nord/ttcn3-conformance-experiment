// @requirement: 22.2.2 -- It is also possible to retrieve and store the component reference or address of the sender of a message.
// @id: TTCN3-CORE-22.2.2-039a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_test_033 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_send() runs on C {
        p.send(1);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var C v_sender := null;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc2.start(f_send());
        T.start;
        alt {
            [] p.receive(integer:1) -> sender v_sender { }
            [] T.timeout { setverdict(fail); stop; }
        }
        if (v_sender == v_ptc2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
