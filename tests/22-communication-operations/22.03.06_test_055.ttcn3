// @requirement: 22.3.6 -- l) If a variable referenced in the value, sender or @index clause is a lazy or fuzzy variable, the expression assigned to this variable is equal to the result produced by the catch operation, i.e. later evaluation of the lazy or fuzzy variable does not lead to repeated invocation of the catch operation.
// @id: TTCN3-CORE-22.3.6-058a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_test_055 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component CS {
        port P pa[2];
        timer T := 1.0;
    }

    type component CC {
        port P p;
    }

    altstep a_guard() runs on CS {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on CC {
        p.getcall(S:{});
        p.raise(S, integer:5);
    }

    testcase TC() runs on CS {
        var CC v_ptc := CC.create;
        var @lazy integer v_val;
        var @fuzzy CC v_sender;
        var @lazy integer v_idx;
        connect(mtc:pa[1], v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        pa[1].call(S:{}, nowait);
        any from pa.catch(S, integer:?) -> value v_val sender v_sender @index value v_idx;
        if (v_val == 5 and v_sender == v_ptc and v_idx == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
