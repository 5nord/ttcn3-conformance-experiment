// @requirement: 22.5.5 -- 2) "Halted"
// @id: TTCN3-CORE-22.5.5-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_05_test_014 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1;
    }

    testcase TC() runs on C {
        p1.halt;
        if (p1.checkstate("Halted")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
