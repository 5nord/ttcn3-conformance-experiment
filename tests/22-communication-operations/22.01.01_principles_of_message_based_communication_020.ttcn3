// @requirement: 22.1.1 -- Table 22: Overview of TTCN-3 communication operations: Handle response from a previous call; Col2: getreply; Col4: Yes
// @id: TTCN3-CORE-22.1.1-017b
// @verdict: pass reject
module M_22_01_01_principles_of_message_based_communication_020 {

    signature S(in integer p_x) return integer exception (charstring);

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.getreply(S:{p_x := -}) { // error: getreply used at a message-based port
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
