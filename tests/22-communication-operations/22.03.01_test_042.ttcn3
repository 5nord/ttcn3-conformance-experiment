// @requirement: 22.3.1 -- This allows the use of signature templates in call operations in the same manner as templates can be used for types.
// @id: TTCN3-CORE-22.3.1-054a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_test_042 {

    signature S(out integer p_o, in integer p_i) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    template S s_base(integer p_v) := { p_o := ?, p_i := p_v };
    template S s_modified(integer p_v) modifies s_base := { p_i := p_v + 1 };

    function f_server() runs on C {
        var integer v_x;
        alt {
            [] p.getcall(S:{-, ?}) -> param(v_x := p_i) { p.reply(S:{v_x, -} value v_x); repeat; }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(s_base(2), 1.0) {
            [] p.getreply(S:{2, -} value 2) { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
        p.call(s_modified(2), 1.0) {
            [] p.getreply(S:{3, -} value 3) { setverdict(pass); }
            [] p.catch(timeout) { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
