// @requirement: 22.3.6 -- Any other value shall cause an error.
// @id: TTCN3-CORE-22.3.6-019a
// @verdict: pass accept, ttcn3verdict:error
module M_22_03_06_test_018 {

    type record E {
        universal charstring payload
    }

    signature S() exception (E);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.raise(S, E:{payload := "1"});
    }

    testcase TC(charstring p_format) runs on C {
        var C v_ptc := C.create;
        var integer v_i;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{}, nowait);
        p.catch(S, E:?) -> value (v_i := @decoded(p_format) payload); // error: not an allowed encoding format
        setverdict(pass);
    }

    control {
        execute(TC("UTF-9"));
    }
}
