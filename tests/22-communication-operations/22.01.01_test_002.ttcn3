// @requirement: 22.1.1 -- The RECEIVER is blocked on the receive operation until it processes the received message.
// @id: TTCN3-CORE-22.1.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_01_test_002 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    function f_send() runs on C {
        timer T := 0.5;
        T.start;
        T.timeout;
        p.send(1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_res;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send());
        p.receive(integer:?) -> value v_res;
        if (isbound(v_res) and v_res == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC(), 5.0);
    }
}
