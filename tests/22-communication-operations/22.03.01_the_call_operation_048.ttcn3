// @requirement: 22.3.1 -- Unqualified getreply and catch operations shall only treat replies from and exceptions raised by the called procedure.
// @id: TTCN3-CORE-22.3.1-059a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_the_call_operation_048 {

    signature S1(in integer p_x) return integer;
    signature S2(in integer p_x) return integer;

    type port P procedure { inout S1, S2 }

    type component C {
        port P p;
        timer T := 2.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S2:{?});
        p.reply(S2:{-} value 2);
        p.getcall(S1:{?});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S2:{2}, nowait);
        p.check(getreply(S2:{-}));
        p.call(S1:{1}, 0.5) {
            [] p.getreply { setverdict(fail); } // the queued reply of S2 shall not be treated
            [] p.catch(timeout) { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
