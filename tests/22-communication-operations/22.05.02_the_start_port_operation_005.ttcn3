// @requirement: 22.5.2 -- If the port is defined to allow sending operations then the operations such as send, call, raise, etc. are also allowed to be performed at that port.
// @id: TTCN3-CORE-22.5.2-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_05_02_the_start_port_operation_005 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.stop;
        p1.start;
        p1.send(1);
        T.start;
        alt {
            [] p2.receive(1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
