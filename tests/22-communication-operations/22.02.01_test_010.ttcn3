// @requirement: 22.2.1 -- a) The TemplateInstance (and all parts of it) shall have a specific value i.e. the use of matching mechanisms such as AnyValue is not allowed.
// @id: TTCN3-CORE-22.2.1-013a
// @verdict: pass reject
module M_22_02_01_test_010 {

    type record R {
        integer a,
        integer b
    }

    type port P message { inout R }

    type component C {
        port P p;
    }

    template R mw_r := {
        a := 1,
        b := (1 .. 5)
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.send(mw_r); // error: field b is not a specific value
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
