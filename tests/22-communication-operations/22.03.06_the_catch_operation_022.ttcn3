module M_22_03_06_the_catch_operation_022 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_call() runs on C {
        p.call(S:{}, 1.0) {
            [] catch(S, integer:1) {} // error: port name not repeated
            [] p.catch(timeout) {}
        }
    }
}
