// @requirement: 22.3.1 -- k) In case of a multicast or broadcast call operation of a blocking procedure, where the nowait keyword is used, all responses and exceptions have to be handled in subsequent alt or interleave statements.
// @id: TTCN3-CORE-22.3.1-064a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_test_053 {

    signature S(in integer p_x) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 2.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server(integer p_res) runs on C {
        p.getcall(S:{?});
        p.reply(S:{-} value p_res);
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc1.start(f_server(1));
        v_ptc2.start(f_server(2));
        activate(a_guard());
        T.start;
        p.call(S:{0}, nowait) to (v_ptc1, v_ptc2);
        interleave {
            [] p.getreply(S:{-} value 1) from v_ptc1 {}
            [] p.getreply(S:{-} value 2) from v_ptc2 {}
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
