// @requirement: 22.3.6 -- There is one special timeout exception that can be caught by the catch operation.
// @id: TTCN3-CORE-22.3.6-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_test_023 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        p.call(S:{}, 0.1) {
            [] p.catch(timeout) { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
