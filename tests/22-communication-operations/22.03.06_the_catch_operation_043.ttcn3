// @requirement: 22.3.6 -- No further matching criteria (including a from part) and no assignment part is allowed for a catch operation that handles a timeout exception.
// @id: TTCN3-CORE-22.3.6-049a
// @verdict: pass reject
module M_22_03_06_the_catch_operation_043 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_call(C p_peer) runs on C {
        p.call(S:{}, 1.0) {
            [] p.catch(timeout) from p_peer {} // error: from clause in timeout catch
        }
    }
}
