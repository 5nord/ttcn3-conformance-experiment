// @requirement: 22.4 -- In this case the copy of the top element of the queue is discarded and test execution continues in the normal manner, i.e. the statement or alternative next to the check operation is evaluated. The check operation fails if the receiving operation fails i.e. the matching criteria are not fulfilled.
// @id: TTCN3-CORE-22.4-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_04_test_014 {

    type port MP message { inout integer; }

    type component C {
        port MP p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        var integer v_val := 0;
        connect(mtc:p1, mtc:p2);
        p1.send(5);
        T.start;
        alt {
            [] p2.check { }
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] p2.check(receive(integer:(6..9)) -> value v_val) { setverdict(fail); stop; }
            [else] { }
        }
        if (v_val != 0) {
            setverdict(fail);
            stop;
        }
        alt {
            [] p2.receive(5) { setverdict(pass); }
            [else] { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
