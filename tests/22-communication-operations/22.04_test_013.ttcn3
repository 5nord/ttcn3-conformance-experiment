// @requirement: 22.4 -- The check operation fails if the receiving operation fails i.e. the matching criteria are not fulfilled.
// @id: TTCN3-CORE-22.4-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_04_test_013 {

    type port MP message { inout integer; }

    type component C {
        port MP p1, p2;
        timer T := 1.0;
    }

    testcase TC() runs on C {
        connect(mtc:p1, mtc:p2);
        p1.send(5);
        T.start;
        alt {
            [] p2.check(receive(6)) { setverdict(fail); stop; }
            [] T.timeout { }
        }
        alt {
            [] p2.receive(5) { setverdict(pass); }
            [else] { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
