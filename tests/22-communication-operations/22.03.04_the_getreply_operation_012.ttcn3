// @requirement: 22.3.4 -- The keyword value is used to retrieve return values and the keyword param is used to retrieve the parameter values of a reply.
// @id: TTCN3-CORE-22.3.4-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_04_the_getreply_operation_012 {

    signature S(out integer p_y) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{-});
        p.reply(S:{1} value 7);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_ret;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{-}, nowait);
        p.getreply(S:{?} value ?) -> value v_ret;
        if (v_ret == 7) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
