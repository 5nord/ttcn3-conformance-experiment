// @requirement: 22.3.6 -- The parameter shall be of the charstring type and it shall contain one of the strings allowed for the decvalue_unichar function (specified in clause C.5.4).
// @id: TTCN3-CORE-22.3.6-018b
// @verdict: pass reject
module M_22_03_06_the_catch_operation_017 {

    type record E {
        universal charstring payload
    }

    signature S() exception (E);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_catch() runs on C {
        var integer v_i;
        p.catch(S, E:?) -> value (v_i := @decoded("UTF-9") payload); // error: not an allowed encoding format
    }
}
