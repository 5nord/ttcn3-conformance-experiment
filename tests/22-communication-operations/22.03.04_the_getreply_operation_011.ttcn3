// @requirement: 22.3.4 -- The (optional) assignment part of the getreply operation comprises the assignment of out and inout parameter values to variables and the retrieval of the address of the sender of the reply.
// @id: TTCN3-CORE-22.3.4-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_04_the_getreply_operation_011 {

    signature S(out integer p_y);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{-});
        p.reply(S:{5});
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var C v_sender;
        var integer v_y;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{-}, nowait);
        p.getreply(S:{?}) -> param(v_y) sender v_sender;
        if (v_y == 5 and v_sender == v_ptc) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
