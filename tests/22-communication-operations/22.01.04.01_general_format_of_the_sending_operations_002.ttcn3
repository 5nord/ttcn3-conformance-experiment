// @requirement: 22.1.4.1 -- defines the message or procedure call to be transmitted;
// @id: TTCN3-CORE-22.1.4.1-004a
// @verdict: pass reject
module M_22_01_04_01_general_format_of_the_sending_operations_002 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.send(); // error: no message to be transmitted
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
