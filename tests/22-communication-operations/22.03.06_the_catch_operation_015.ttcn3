// @requirement: 22.3.6 -- In case the referenced field is of the universal `charstring type, the @decoded` clause can contain an optional parameter defining the encoding format.
// @id: TTCN3-CORE-22.3.6-017a
// @verdict: pass accept, noexecution
module M_22_03_06_the_catch_operation_015 {

    type record E {
        universal charstring payload
    }

    signature S() exception (E);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_catch() runs on C {
        var integer v_i;
        p.catch(S, E:?) -> value (v_i := @decoded("UTF-8") payload);
    }
}
