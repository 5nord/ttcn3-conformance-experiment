// @requirement: 22.3.1 -- This is defined as an explicit value or constant of float type and defines the length of time after the call operation has started that a timeout exception shall be generated by the test system.
// @id: TTCN3-CORE-22.3.1-025b
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_01_the_call_operation_015 {

    signature S(in integer p_x) return integer;

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 5.0;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var float v_elapsed;
        connect(mtc:p, v_ptc:p);
        T.start;
        p.call(S:{1}, 0.5) {
            [] p.getreply { setverdict(fail); }
            [] p.catch(timeout) {
                v_elapsed := T.read;
                if (v_elapsed >= 0.5 and v_elapsed < 5.0) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
        }
    }

    control {
        execute(TC());
    }
}
