// @requirement: 22.3.2 -- The keyword param is used to retrieve the parameter values of a call.
// @id: TTCN3-CORE-22.3.2-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_02_test_011 {

    signature S(in integer p_a, inout integer p_b);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_client() runs on C {
        p.call(S:{5, 6}, nowait);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var integer v_a, v_b;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_client());
        activate(a_guard());
        T.start;
        p.getcall(S:{?, ?}) -> param(v_b := p_b, v_a := p_a);
        if (v_a == 5 and v_b == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
