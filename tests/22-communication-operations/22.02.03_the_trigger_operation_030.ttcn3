// @requirement: 22.2.3 -- b) A message received by TriggerOnAnyMessage shall not be assigned to a variable.
// @id: TTCN3-CORE-22.2.3-035a
// @verdict: pass reject
module M_22_02_03_the_trigger_operation_030 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var integer v_x;
        p.trigger -> value v_x; // error: message of trigger on any message assigned to a variable
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
