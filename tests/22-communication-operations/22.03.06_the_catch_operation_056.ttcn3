// @requirement: 22.3.6 -- l) If a variable referenced in the value, sender or @index clause is a lazy or fuzzy variable, the expression assigned to this variable is equal to the result produced by the catch operation, i.e. later evaluation of the lazy or fuzzy variable does not lead to repeated invocation of the catch operation.
// @id: TTCN3-CORE-22.3.6-058b
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_06_the_catch_operation_056 {

    signature S() exception (integer);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.raise(S, integer:5);
        p.getcall(S:{});
        p.raise(S, integer:7);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        var @fuzzy integer v_val;
        var integer v_first, v_second;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{}, nowait);
        p.call(S:{}, nowait);
        p.catch(S, integer:?) -> value v_val;
        p.check(catch(S, integer:7));
        v_first := v_val;
        v_second := v_val;
        alt {
            [v_first == 5 and v_second == 5] p.catch(S, integer:7) { setverdict(pass); } // second exception still queued
            [else] { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
