// @requirement: 22.1.2 -- Signatures of procedures that are used for non-blocking procedure-based communication shall be specified according to the rules in clause 13.
// @id: TTCN3-CORE-22.1.2-004a
// @verdict: pass reject
module M_22_01_02_test_005 {

    signature S(inout integer p_x) noblock; // error: noblock signature with inout parameter

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.call(S:{1});
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
