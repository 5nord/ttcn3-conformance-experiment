// @requirement: 22.2.1 -- c) The send operation shall only be used on message-based ports and the type of the template to be sent shall be in the list of outgoing types of the port type definition.
// @id: TTCN3-CORE-22.2.1-015b
// @verdict: pass reject
module M_22_02_01_test_014 {

    type port P message {
        inout integer;
        in charstring
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        p.send(charstring:"abc"); // error: charstring is not an outgoing type of P
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
