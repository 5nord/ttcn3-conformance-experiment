// @requirement: 22.3.5 -- No AddressRef in the to clause shall contain the special value null at the time of the operation.
// @id: TTCN3-CORE-22.3.5-022a
// @verdict: pass accept, ttcn3verdict:error
module M_22_03_05_the_raise_operation_015 {

    signature S() exception(integer);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    function f_client() runs on C {
        p.call(S:{}, 1.0) {
            [] p.catch(S, 1) {}
            [] p.catch(timeout) {}
        }
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        var C v_ref := null;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_client());
        p.getcall(S:{});
        p.raise(S, 1) to v_ref; // error: null in the to clause
        v_ptc.done;
        setverdict(pass);
    }

    control {
        execute(TC(), 5.0);
    }
}
