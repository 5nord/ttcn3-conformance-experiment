// @requirement: 22.3.3 -- a) A reply operation shall only be used at a procedure-based port.
// @id: TTCN3-CORE-22.3.3-015a
// @verdict: pass reject
module M_22_03_03_test_013 {

    signature S(out integer p_y);

    type port M message { inout integer }

    type component C {
        port M m;
    }

    function f_reply() runs on C {
        m.reply(S:{1}); // error: reply at a message-based port
    }
}
