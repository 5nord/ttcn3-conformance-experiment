// @requirement: 22.2.2 -- NOTE 3: The one-to-one connection is considered to be a simple case of the one-to-many connections and allows the usage of the from-clause.
// @id: TTCN3-CORE-22.2.2-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_02_test_013 {

    type port P message { inout integer }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_send() runs on C {
        p.send(1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.receive(integer:1) from v_ptc { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
