// @requirement: 22.2.3 -- If any port in the port array which is checked for matching contains a message that does not match, this message is removed and the containing alt statement is re-evaluated, regardless of whether or not other ports in the port array would meet the trigger criteria.
// @id: TTCN3-CORE-22.2.3-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_02_03_the_trigger_operation_023 {

    type port P message { inout integer }

    type component C {
        port P p[3];
        port P q[3];
        timer T := 1.0;
        timer T_wait := 0.2;
    }

    function f_connect() runs on C {
        for (var integer i := 0; i < 3; i := i + 1) {
            connect(mtc:p[i], mtc:q[i]);
        }
    }

    testcase TC() runs on C {
        var integer v_i;
        f_connect();
        q[0].send(9);
        q[1].send(5);
        T_wait.start;
        T_wait.timeout;
        T.start;
        alt {
            [] any from p.trigger(integer:5) -> @index value v_i {
                if (v_i != 1) { setverdict(fail); stop; }
            }
            [] T.timeout { setverdict(fail); stop; }
        }
        T.stop;
        T.start(0.3);
        alt {
            [] p[0].receive { setverdict(fail); }
            [] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
