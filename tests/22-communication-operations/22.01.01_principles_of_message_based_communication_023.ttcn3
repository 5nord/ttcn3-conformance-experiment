// @requirement: 22.1.1 -- Table 22: Overview of TTCN-3 communication operations: Check msg/call/exception/reply received; Col2: check; Col3: Yes; Col4: Yes
// @id: TTCN3-CORE-22.1.1-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_01_01_principles_of_message_based_communication_023 {

    signature S(in integer p_x) noblock;

    type port P message {
        inout integer
    }

    type port PP procedure {
        inout S
    }

    type component C {
        port P pm;
        port PP pp;
    }

    function f_send() runs on C {
        pm.send(1);
        pp.call(S:{p_x := 1});
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(mtc:pm, v_ptc:pm);
        connect(mtc:pp, v_ptc:pp);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] pm.check(receive(1)) {}
            [] T.timeout {
                setverdict(fail);
                stop;
            }
        }
        alt {
            [] pp.check(getcall(S:{p_x := 1})) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
