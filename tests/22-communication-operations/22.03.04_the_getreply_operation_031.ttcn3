// @requirement: 22.3.4 -- When checking the port array for matching replies, the port indices to be checked are iterated from lowest to highest.
// @id: TTCN3-CORE-22.3.4-033a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_04_the_getreply_operation_031 {

    signature S() return integer;

    type port P procedure { inout S }

    type component C {
        port P p[3];
    }

    function f_server() runs on C {
        p[2].getcall(S:{});
        p[2].reply(S:{} value 2);
        p[1].getcall(S:{});
        p[1].reply(S:{} value 1);
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        var integer v_i;
        var integer v_res;
        timer T := 1.0;
        for (var integer i := 0; i < 3; i := i + 1) {
            connect(self:p[i], v_ptc:p[i]);
        }
        v_ptc.start(f_server());
        p[2].call(S:{}, nowait);
        p[1].call(S:{}, nowait);
        T.start;
        alt {
            [] p[1].check(getreply) {}
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] p[2].check(getreply) {}
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] any from p.getreply(S:{} value ?) -> value v_res @index value v_i {
                if (v_i == 1 and v_res == 1) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
