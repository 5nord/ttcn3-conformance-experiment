// @requirement: 22.3.4 -- The keyword sender is used when it is required to retrieve the address of the sender.
// @id: TTCN3-CORE-22.3.4-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_22_03_04_the_getreply_operation_014 {

    signature S(out integer p_y);

    type port P procedure { inout S }

    type component C {
        port P p;
        timer T := 1.0;
    }

    altstep a_guard() runs on C {
        [] T.timeout { setverdict(fail); stop; }
    }

    function f_server() runs on C {
        p.getcall(S:{-});
        p.reply(S:{1});
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create, v_ptc2 := C.create;
        var C v_sender;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc2.start(f_server());
        activate(a_guard());
        T.start;
        p.call(S:{-}, nowait) to v_ptc2;
        p.getreply -> sender v_sender;
        if (v_sender == v_ptc2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
