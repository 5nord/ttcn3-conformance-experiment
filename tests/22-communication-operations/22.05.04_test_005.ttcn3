// @requirement: 22.5.4 -- If the port allows sending operations then halt port immediately disallows sending operations such as send, call, raise, etc. to be performed.
// @id: TTCN3-CORE-22.5.4-005a
// @verdict: pass accept, ttcn3verdict:error
module M_22_05_04_test_005 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        setverdict(pass);
        p1.halt;
        p1.send(1); // error: sending on a halted port
    }

    control {
        execute(TC());
    }
}
