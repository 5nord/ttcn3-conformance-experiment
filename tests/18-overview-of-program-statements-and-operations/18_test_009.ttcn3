// @requirement: 18 -- Statement: Assignments; Associated keyword or symbol: :=; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes (see note 3)
// @id: TTCN3-CORE-18-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_009 {

    type component C {}

    testcase TC(integer p_x) runs on C {
        if (p_x == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_x := 0;
        v_x := 5;
        execute(TC(v_x));
    }
}
