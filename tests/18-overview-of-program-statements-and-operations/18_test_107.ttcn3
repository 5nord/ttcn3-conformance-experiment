// @requirement: 18 -- Statement: Wait for termination of a PTC behaviour; Associated keyword or symbol: done; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-049c
// @verdict: pass reject
module M_18_test_107 {

    type component C {}

    function f_guard(C p_c) runs on C return boolean {
        p_c.done; // error: done in function called from a guard
        return true;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        timer T := 0.1;
        T.start;
        alt {
            [f_guard(v_ptc)] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
