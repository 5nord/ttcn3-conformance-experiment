// @requirement: 18 -- Statement: Alternative behaviour; Associated keyword or symbol: alt {…}; Can be invoked by control behaviour: Yes (see note 2); Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-029c
// @verdict: pass reject
module M_18_overview_of_program_statements_and_operations_050 {

    type component C {}

    function f_check() return boolean {
        var boolean v_ok := false;
        alt { // error: alt in a function called from an alt guard
            [else] {
                v_ok := true;
            }
        }
        return v_ok;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_check()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
