// @requirement: 18 -- Statement: If-else; Associated keyword or symbol: if (…) {…} else {…}; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_012 {

    type component C {}

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_x := 2;
        if (v_x > 5) {
            execute(TC(false));
        } else {
            execute(TC(true));
        }
    }
}
