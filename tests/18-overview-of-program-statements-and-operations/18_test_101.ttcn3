// @requirement: 18 -- Statement: Check termination of a PTC behaviour; Associated keyword or symbol: running; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-047c
// @verdict: pass reject
module M_18_test_101 {

    type component C {}

    function f_guard(C p_c) runs on C return boolean {
        return p_c.running; // error: component running in function called from a guard
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        timer T := 0.1;
        T.start;
        alt {
            [not f_guard(v_ptc)] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
