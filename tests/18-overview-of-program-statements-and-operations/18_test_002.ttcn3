// @requirement: 18 -- Statements shall be executed in the order of their appearance, i.e. sequentially, as illustrated in figure 8.
// @id: TTCN3-CORE-18-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_002 {

    type component C {}

    testcase TC() runs on C {
        var integer v_x := 1;
        v_x := v_x * 2;
        v_x := v_x + 3;
        v_x := v_x * 10;
        if (v_x == 50) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
