// @requirement: 18 -- Statement: Select case; Associated keyword or symbol: select case (…) { case (…) {…} case else {…}}; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_015 {

    type component C {}

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_x := 2;
        select (v_x) {
            case (1) {
                execute(TC(false));
            }
            case (2) {
                execute(TC(true));
            }
            case else {
                execute(TC(false));
            }
        }
    }
}
