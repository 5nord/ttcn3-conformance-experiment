// @requirement: 18 -- Statement: Activate a default; Associated keyword or symbol: activate; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-032b
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_058 {

    type component C {}

    altstep a_def() runs on C {
        [else] {}
    }

    testcase TC() runs on C {
        timer T := 5.0;
        var default v_def := activate(a_def());
        T.start;
        alt {
            [] T.timeout {}
        }
        if (T.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
