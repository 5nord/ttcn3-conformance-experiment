// @requirement: 18 -- Statement: Terminating the testcase with an error verdict; Associated keyword or symbol: testcase.stop; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-045c
// @verdict: pass accept, ttcn3verdict:error
module M_18_test_095 {

    type component C {}

    function f_guard() runs on C return boolean {
        testcase.stop("stopped from guard");
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        setverdict(pass);
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
