// @requirement: 18 -- NOTE 3: Changing of component variables is disallowed.
// @id: TTCN3-CORE-18-071a
// @verdict: pass reject
module M_18_overview_of_program_statements_and_operations_131 {

    type component C {
        var integer v_count := 0;
    }

    function f_guard() runs on C return boolean {
        v_count := v_count + 1; // error: component variable changed in function called from a guard
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
