// @requirement: 18 -- Statement: Deactivate a default; Associated keyword or symbol: deactivate; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-033c
// @verdict: pass reject
module M_18_overview_of_program_statements_and_operations_062 {

    type component C {}

    function f_check() runs on C return boolean {
        deactivate; // error: deactivate in a function called from an alt guard
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_check()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
