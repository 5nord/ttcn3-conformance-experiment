// @id: TTCN3-CORE-18-043b
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_088 {

    type component C {}

    function f_ptc() runs on C {
        setverdict(pass);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc());
        v_ptc.done;
    }

    control {
