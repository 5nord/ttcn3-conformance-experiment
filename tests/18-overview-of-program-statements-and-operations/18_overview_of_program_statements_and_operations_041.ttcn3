// @requirement: 18 -- Statement: Leaving a loop, alt, altstep or interleave; Associated keyword or symbol: break; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-025c
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_041 {

    type component C {}

    function f_check() return boolean {
        var integer v_i;
        for (v_i := 0; v_i < 10; v_i := v_i + 1) {
            if (v_i == 3) {
                break;
            }
        }
        return v_i == 3;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_check()] T.timeout {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
