// @requirement: 18 -- Statement: Leaving a loop, alt, altstep or interleave; Associated keyword or symbol: break; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_039 {

    type component C {}

    testcase TC(integer p_i) runs on C {
        if (p_i == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_i;
        for (v_i := 0; v_i < 10; v_i := v_i + 1) {
            if (v_i == 3) {
                break;
            }
        }
        execute(TC(v_i));
    }
}
