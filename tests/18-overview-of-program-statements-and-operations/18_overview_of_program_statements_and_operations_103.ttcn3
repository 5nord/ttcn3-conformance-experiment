// @requirement: 18 -- Statement: Check if a PTC exists in the test system; Associated keyword or symbol: alive; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-048b
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_103 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create;
        if (v_ptc.alive) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
