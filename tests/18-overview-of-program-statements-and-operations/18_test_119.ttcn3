// @requirement: 18 -- Statement: Reply to procedure call from remote entity; Associated keyword or symbol: reply; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-054c
// @verdict: pass reject
module M_18_test_119 {

    signature S();

    type port P procedure {
        inout S;
    }

    type component C {
        port P p;
    }

    function f_guard() runs on C return boolean {
        p.reply(S:{}); // error: reply in function called from a guard
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
