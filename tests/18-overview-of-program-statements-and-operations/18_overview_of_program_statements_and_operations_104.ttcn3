// @requirement: 18 -- Statement: Check if a PTC exists in the test system; Associated keyword or symbol: alive; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-048c
// @verdict: pass reject
module M_18_overview_of_program_statements_and_operations_104 {

    type component C {}

    function f_guard(C p_c) runs on C return boolean {
        return p_c.alive; // error: alive in function called from a guard
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        timer T := 0.1;
        T.start;
        alt {
            [f_guard(v_ptc)] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
