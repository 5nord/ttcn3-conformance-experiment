// @requirement: 18 -- Statement: Activate a default; Associated keyword or symbol: activate; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-032a
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_057 {

    type component C {}

    altstep a_def() {
        [else] {}
    }

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var boolean v_ok;
        timer T := 5.0;
        var default v_def := activate(a_def());
        T.start;
        alt {
            [] T.timeout {}
        }
        v_ok := T.running;
        T.stop;
        execute(TC(v_ok));
    }
}
