// @requirement: 18 -- Statement: Receive message; Associated keyword or symbol: receive; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-056b
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_124 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    function f_ptc() runs on C {
        p.send(1);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        timer T := 1.0;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_ptc());
        T.start;
        alt {
            [] p.receive(integer:1) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
