// @requirement: 18 -- Statement: Check termination of a PTC behaviour; Associated keyword or symbol: running; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-047b
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_100 {

    type component C {}

    function f_ptc() runs on C {
        timer T := 5.0;
        T.start;
        T.timeout;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc());
        if (v_ptc.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        v_ptc.stop;
    }

    control {
        execute(TC());
    }
}
