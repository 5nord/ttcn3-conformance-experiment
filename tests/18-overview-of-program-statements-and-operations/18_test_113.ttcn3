// @requirement: 18 -- Statement: Send message; Associated keyword or symbol: send; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-052c
// @verdict: pass reject
module M_18_test_113 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    function f_guard() runs on C return boolean {
        p.send(1); // error: send in function called from a guard
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
