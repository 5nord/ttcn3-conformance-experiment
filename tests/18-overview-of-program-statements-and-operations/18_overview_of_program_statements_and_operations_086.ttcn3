// @requirement: 18 -- Statement: Get own component reference value; Associated keyword or symbol: self; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-042c
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_086 {

    type component C {}

    function f_guard() runs on C return boolean {
        return self == mtc;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
