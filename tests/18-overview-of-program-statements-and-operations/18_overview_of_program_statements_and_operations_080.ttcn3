// @requirement: 18 -- Statement: Get MTC component reference value; Associated keyword or symbol: mtc; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-040c
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_080 {

    type component C {}

    function f_check() runs on C mtc C return boolean {
        var C v_mtc := mtc;
        return v_mtc == self;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_check()] T.timeout {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
