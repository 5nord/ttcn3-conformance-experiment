// @requirement: 18 -- Statement: Wait for termination of a PTC behaviour; Associated keyword or symbol: done; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-049b
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_106 {

    type component C {}

    function f_ptc() runs on C {
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        timer T := 1.0;
        v_ptc.start(f_ptc());
        T.start;
        alt {
            [] v_ptc.done {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
