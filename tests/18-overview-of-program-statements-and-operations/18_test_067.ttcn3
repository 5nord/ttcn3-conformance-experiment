// @requirement: 18 -- Statement: Connect component port to component port; Associated keyword or symbol: connect; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-036b
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_067 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    function f_echo() runs on C {
        var integer v_i;
        p.receive(integer:?) -> value v_i;
        p.send(v_i);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_echo());
        p.send(1);
        T.start;
        alt {
            [] p.receive(1) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
