// @requirement: 18 -- The specification of an empty statement block, i.e. {}, may be found in compound statements, e.g. a branch in an alt statement, and implies that no actions are taken.
// @id: TTCN3-CORE-18-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_004 {

    type component C {
        timer T;
    }

    testcase TC() runs on C {
        T.start(0.1);
        alt {
            [] T.timeout {}
        }
        if (true) {} else {}
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
