// @requirement: 18 -- Statement: Interleaved behaviour; Associated keyword or symbol: interleave {…}; Can be invoked by control behaviour: Yes (see note 2); Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-031c
// @verdict: pass reject
module M_18_overview_of_program_statements_and_operations_056 {

    type component C {}

    function f_check(timer p_t) return boolean {
        interleave { // error: interleave in a function called from an alt guard
            [] p_t.timeout {}
        }
        return true;
    }

    testcase TC() runs on C {
        timer T1 := 0.1;
        timer T2 := 0.05;
        T1.start;
        T2.start;
        alt {
            [f_check(T2)] T1.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
