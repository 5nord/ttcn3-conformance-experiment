// @requirement: 18 -- Statement: Alternative behaviour; Associated keyword or symbol: alt {…}; Can be invoked by control behaviour: Yes (see note 2); Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-029a
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_048 {

    type component C {}

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var boolean v_ok := false;
        timer T := 0.1;
        T.start;
        alt {
            [] T.timeout {
                v_ok := true;
            }
        }
        execute(TC(v_ok));
    }
}
