// @requirement: 18 -- Statement: Label and Goto; Associated keyword or symbol: label / goto; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-022d
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_030 {

    type component C {}

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var boolean v_ok := true;
        goto L_END;
        v_ok := false;
        label L_END;
        execute(TC(v_ok));
    }
}
