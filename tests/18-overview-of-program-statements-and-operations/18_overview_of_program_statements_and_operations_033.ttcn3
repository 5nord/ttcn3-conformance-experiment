// @requirement: 18 -- Statement: Stop execution; Associated keyword or symbol: stop; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_033 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    testcase TC_NotExecuted() runs on C {
        setverdict(fail);
    }

    control {
        execute(TC());
        stop;
        execute(TC_NotExecuted());
    }
}
