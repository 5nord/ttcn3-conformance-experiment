// @requirement: 18 -- Statement: Remove a test component from the system; Associated keyword or symbol: kill; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-046b
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_097 {

    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        v_ptc.kill;
        if (not v_ptc.alive) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
