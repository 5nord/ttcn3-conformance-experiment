// @requirement: 18 -- Statement: While loop; Associated keyword or symbol: while (…) {…}; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_021 {

    type component C {}

    testcase TC(integer p_sum) runs on C {
        if (p_sum == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_sum := 0;
        var integer v_i := 1;
        while (v_i <= 3) {
            v_sum := v_sum + v_i;
            v_i := v_i + 1;
        }
        execute(TC(v_sum));
    }
}
