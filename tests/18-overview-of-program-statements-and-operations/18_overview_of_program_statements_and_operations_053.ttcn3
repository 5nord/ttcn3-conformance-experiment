// @requirement: 18 -- Statement: Re-evaluation of alternative behaviour; Associated keyword or symbol: repeat; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-030c
// @verdict: pass reject
module M_18_overview_of_program_statements_and_operations_053 {

    type component C {}

    function f_check(boolean p_again) return boolean {
        alt {
            [else] {
                if (p_again) {
                    repeat; // error: repeat in a function called from an alt guard
                }
            }
        }
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_check(false)] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
