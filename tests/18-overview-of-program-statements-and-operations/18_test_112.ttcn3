// @requirement: 18 -- Statement: Send message; Associated keyword or symbol: send; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-052b
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_112 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    function f_ptc() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.receive(integer:1) {
                p.send(2);
            }
            [] T.timeout {
            }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        timer T := 1.0;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_ptc());
        p.send(1);
        T.start;
        alt {
            [] p.receive(integer:2) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
