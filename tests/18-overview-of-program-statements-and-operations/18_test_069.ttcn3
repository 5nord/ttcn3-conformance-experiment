// @requirement: 18 -- Statement: Disconnect two component ports; Associated keyword or symbol: disconnect; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-037a
// @verdict: pass reject
module M_18_test_069 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        var C v_a;
        var C v_b;
        disconnect(v_a:p, v_b:p); // error: disconnect in control behaviour
        execute(TC());
    }
}
