// @requirement: 18 -- Statement: Returning control; Associated keyword or symbol: return; Can be invoked by test behaviour: Yes (see note 4); Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-024c
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_038 {

    type component C {}

    function f_check(integer p_i) return boolean {
        if (p_i > 0) {
            return true;
        }
        return false;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_check(1)] T.timeout {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
