// @requirement: 18 -- Statement: Label and Goto; Associated keyword or symbol: label / goto; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-022f
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_032 {

    type component C {}

    function f_check() return boolean {
        var boolean v_ok := true;
        goto L_END;
        v_ok := false;
        label L_END;
        return v_ok;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_check()] T.timeout {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
