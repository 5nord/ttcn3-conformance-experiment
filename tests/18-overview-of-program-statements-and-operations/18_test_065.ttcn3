// @requirement: 18 -- Statement: Create parallel test component; Associated keyword or symbol: create; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-035c
// @verdict: pass reject
module M_18_test_065 {

    type component C {}

    function f_check() runs on C return boolean {
        var C v_ptc := C.create; // error: create in a function called from an alt guard
        return v_ptc != null;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_check()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
