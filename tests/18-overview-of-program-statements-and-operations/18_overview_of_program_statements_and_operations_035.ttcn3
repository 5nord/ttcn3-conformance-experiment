// @requirement: 18 -- Statement: Stop execution; Associated keyword or symbol: stop; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-023c
// @verdict: pass reject
module M_18_overview_of_program_statements_and_operations_035 {

    type component C {}

    function f_check(boolean p_stop) return boolean {
        if (p_stop) {
            stop; // error: stop in a function called from an alt guard
        }
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_check(false)] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
