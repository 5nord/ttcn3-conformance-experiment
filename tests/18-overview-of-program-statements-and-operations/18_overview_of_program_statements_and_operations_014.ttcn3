// @requirement: 18 -- Statement: If-else; Associated keyword or symbol: if (…) {…} else {…}; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-017c
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_014 {

    type component C {
        timer T;
    }

    function f_check(integer p_a) return boolean {
        if (p_a > 5) {
            return false;
        } else {
            return true;
        }
    }

    testcase TC() runs on C {
        T.start(0.1);
        alt {
            [f_check(2)] T.timeout {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
