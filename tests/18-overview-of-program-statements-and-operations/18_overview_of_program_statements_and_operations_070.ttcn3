// @requirement: 18 -- Statement: Disconnect two component ports; Associated keyword or symbol: disconnect; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-037b
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_070 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        disconnect(self:p, v_ptc:p);
        if (not p.checkstate("Connected")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
