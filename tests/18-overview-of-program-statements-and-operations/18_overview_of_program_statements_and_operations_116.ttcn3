// @requirement: 18 -- Statement: Invoke procedure call; Associated keyword or symbol: call; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-053c
// @verdict: pass reject
module M_18_overview_of_program_statements_and_operations_116 {

    signature S();

    type port P procedure {
        inout S;
    }

    type component C {
        port P p;
    }

    function f_guard() runs on C return boolean {
        p.call(S:{}, nowait); // error: call in function called from a guard
        return true;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
