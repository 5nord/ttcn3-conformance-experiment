// @requirement: 18 -- Statement: Label and Goto; Associated keyword or symbol: label / goto; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-022b
// @verdict: pass accept, ttcn3verdict:pass
module M_18_overview_of_program_statements_and_operations_028 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 0;
        label L_LOOP;
        v_i := v_i + 1;
        if (v_i < 3) {
            goto L_LOOP;
        }
        if (v_i == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
