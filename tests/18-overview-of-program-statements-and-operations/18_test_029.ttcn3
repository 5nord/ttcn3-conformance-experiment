// @requirement: 18 -- Statement: Label and Goto; Associated keyword or symbol: label / goto; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes
// @id: TTCN3-CORE-18-022c
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_029 {

    type component C {}

    function f_check() return boolean {
        var integer v_i := 0;
        label L_LOOP;
        v_i := v_i + 1;
        if (v_i < 3) {
            goto L_LOOP;
        }
        return v_i == 3;
    }

    testcase TC() runs on C {
        timer T := 0.1;
        T.start;
        alt {
            [f_check()] T.timeout {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
