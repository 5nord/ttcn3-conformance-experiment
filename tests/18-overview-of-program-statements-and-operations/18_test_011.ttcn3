// @requirement: 18 -- Statement: Assignments; Associated keyword or symbol: :=; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes; Can be directly or indirectly invoked from specific places (see note 1): Yes (see note 3)
// @id: TTCN3-CORE-18-016c
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_011 {

    type component C {
        timer T;
    }

    function f_check(integer p_a) return boolean {
        var integer v_local := 0;
        v_local := p_a + 1;
        return v_local == 6;
    }

    testcase TC() runs on C {
        T.start(0.1);
        alt {
            [f_check(5)] T.timeout {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
