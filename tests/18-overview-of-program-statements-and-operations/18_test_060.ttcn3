// @requirement: 18 -- Statement: Deactivate a default; Associated keyword or symbol: deactivate; Can be invoked by control behaviour: Yes; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-033a
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_060 {

    type component C {}

    altstep a_def() {
        [else] {}
    }

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var boolean v_ok := false;
        timer T := 0.05;
        var default v_def := activate(a_def());
        deactivate(v_def);
        T.start;
        alt {
            [] T.timeout {
                v_ok := true;
            }
        }
        execute(TC(v_ok));
    }
}
