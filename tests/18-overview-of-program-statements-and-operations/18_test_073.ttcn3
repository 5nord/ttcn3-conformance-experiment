// @requirement: 18 -- Statement: Map port to test interface; Associated keyword or symbol: map; Can be invoked by test behaviour: Yes
// @id: TTCN3-CORE-18-038b
// @verdict: pass accept, ttcn3verdict:pass
module M_18_test_073 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    type component S {
        port P p;
    }

    testcase TC() runs on C system S {
        map(self:p, system:p);
        if (p.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
