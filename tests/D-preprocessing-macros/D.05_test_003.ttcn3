// @requirement: D.5 -- A preprocessor or compiler shall replace all occurrences of __SCOPE__ with a charstring value which includes:
// @id: TTCN3-CORE-D.5-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_05_test_003 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_first := __SCOPE__;
        var charstring v_second := __SCOPE__;
        if (v_first == "TC" and v_second == "TC") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
