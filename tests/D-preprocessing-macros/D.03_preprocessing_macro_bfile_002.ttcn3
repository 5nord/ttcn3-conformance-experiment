// @requirement: D.3 -- A preprocessor or compiler shall replace all occurrences of __BFILE__ with the actual basic (relative) file name in form of a charstring value.
// @id: TTCN3-CORE-D.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_03_preprocessing_macro_bfile_002 {

    type component C {}

    const charstring c_file := __BFILE__;

    function f_file() return charstring {
        return __BFILE__;
    }

    testcase TC(charstring p_controlFile) runs on C {
        var charstring v_file := __BFILE__;
        if (c_file == "D.03_test_002.ttcn3" and f_file() == "D.03_test_002.ttcn3" and
            v_file == "D.03_test_002.ttcn3" and p_controlFile == "D.03_test_002.ttcn3") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC(__BFILE__));
    }
}
