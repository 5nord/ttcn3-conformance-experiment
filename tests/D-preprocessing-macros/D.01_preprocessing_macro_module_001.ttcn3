// @requirement: D.1 -- The __MODULE__ preprocessing macro denotes the module name in which the macro is used.
// @id: TTCN3-CORE-D.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_01_preprocessing_macro_module_001 {

    type component C {}

    testcase TC() runs on C {
        if (__MODULE__ == "M_D_01_preprocessing_macro_module_001") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
