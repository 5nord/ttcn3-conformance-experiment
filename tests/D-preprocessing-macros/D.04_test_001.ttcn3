// @requirement: D.4 -- The __LINE__ preprocessing macro denotes the line number of the file in which the macro is used.
// @id: TTCN3-CORE-D.4-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_04_test_001 {

    type component C {}

    testcase TC() runs on C {
        if (__LINE__ == 9) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
