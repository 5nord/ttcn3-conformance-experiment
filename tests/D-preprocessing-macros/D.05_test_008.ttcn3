// @requirement: D.5 -- e) an altstep name, if the lowest named scope is an altstep definition;
// @id: TTCN3-CORE-D.5-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_05_test_008 {

    type component C {}

    altstep a_scope(inout charstring p_scope) {
        var charstring v_scope := __SCOPE__;
        [else] {
            p_scope := v_scope;
        }
    }

    testcase TC() runs on C {
        var charstring v_result := "";
        a_scope(v_result);
        if (v_result == "a_scope") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
