// @requirement: D.0 -- Preprocessing macros shall not be replaced inside literal charstring values and templates and not in TTCN-3 comments.
// @id: TTCN3-CORE-D.0-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_D_00_general_003 {

    type component C {}

    template charstring t_str := pattern "__MODULE__";

    testcase TC() runs on C {
        if (match("_" & "_MODULE__", t_str) and not match("M_D_00_general_003", t_str)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
