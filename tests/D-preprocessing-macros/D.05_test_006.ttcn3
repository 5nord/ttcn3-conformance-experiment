// @requirement: D.5 -- c) a component type name, if the lowest named scope unit is a component type definition;
// @id: TTCN3-CORE-D.5-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_05_test_006 {

    type component C {
        var charstring v_scope := __SCOPE__;
    }

    testcase TC() runs on C {
        if (v_scope == "C") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
