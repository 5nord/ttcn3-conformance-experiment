// @requirement: D.0 -- Preprocessing macros shall not be replaced inside literal charstring values and templates and not in TTCN-3 comments.
// @id: TTCN3-CORE-D.0-003c
// @verdict: pass accept, ttcn3verdict:pass
module M_D_00_general_004 {

    type component C {}

    testcase TC() runs on C {
        var integer v_first := __LINE__;
        /* __LINE__ __MODULE__ __FILE__ __BFILE__ __SCOPE__ */
        // __LINE__ __MODULE__ __FILE__ __BFILE__ __SCOPE__
        var integer v_second := __LINE__;
        if (v_first == 9 and v_second == 12) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
