// @requirement: D.5 -- d) a test case name, if the lowest named scope unit is a test case definition;
// @id: TTCN3-CORE-D.5-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_05_preprocessing_macro_scope_007 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_scope := __SCOPE__;
        if (v_scope == "TC") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
