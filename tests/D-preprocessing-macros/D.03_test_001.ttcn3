// @requirement: D.3 -- The __BFILE__ preprocessing macro denotes the basic (relative) file name, i.e. without path, in which the macro is used.
// @id: TTCN3-CORE-D.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_03_test_001 {

    type component C {}

    testcase TC() runs on C {
        if (__BFILE__ == "D.03_test_001.ttcn3") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
