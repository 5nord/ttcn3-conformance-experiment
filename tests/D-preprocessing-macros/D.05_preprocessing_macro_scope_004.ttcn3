// @requirement: D.5 -- a) the module name, if the lowest named scope unit is the module definitions part;
// @id: TTCN3-CORE-D.5-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_05_preprocessing_macro_scope_004 {

    type component C {}

    const charstring c_scope := __SCOPE__;

    testcase TC() runs on C {
        if (c_scope == "M_D_05_preprocessing_macro_scope_004") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
