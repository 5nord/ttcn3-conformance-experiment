// @requirement: D.1 -- A preprocessor or compiler shall replace all occurrences of __MODULE__ with the actual module name in form of a charstring value.
// @id: TTCN3-CORE-D.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_01_preprocessing_macro_module_002 {

    type component C {}

    const charstring c_name := __MODULE__;

    function f_name() return charstring {
        return __MODULE__;
    }

    testcase TC(charstring p_controlName) runs on C {
        var charstring v_name := __MODULE__;
        if (c_name == "M_D_01_preprocessing_macro_module_002" and f_name() == "M_D_01_preprocessing_macro_module_002" and
            v_name == "M_D_01_preprocessing_macro_module_002" and p_controlName == "M_D_01_preprocessing_macro_module_002") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC(__MODULE__));
    }
}
