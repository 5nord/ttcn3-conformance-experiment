// @requirement: D.4 -- A file starts with line number 1.
// @id: TTCN3-CORE-D.4-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_04_preprocessing_macro_line_003 { const integer c_line := __LINE__;

    type component C {}

    testcase TC() runs on C {
        if (c_line == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
