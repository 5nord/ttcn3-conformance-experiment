// @requirement: D.2 -- The __FILE__ preprocessing macro denotes the canonical (absolute) file name, i.e. the full path and the basic file name, in which the macro is used.
// @id: TTCN3-CORE-D.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_02_test_001 {

    type component C {}

    testcase TC() runs on C {
        if (match(__FILE__, pattern "?*D-preprocessing-macros?D.02_test_001.ttcn3")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
