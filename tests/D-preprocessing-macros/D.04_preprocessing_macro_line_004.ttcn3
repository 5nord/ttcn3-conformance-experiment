// @requirement: D.4 -- Each newline shall increase the line number by 1 (see clause A.1.5.1).
// @id: TTCN3-CORE-D.4-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_D_04_preprocessing_macro_line_004 {

    type component C {}

    testcase TC() runs on C {
        var integer v_first := __LINE__;
        var integer v_second := __LINE__;


        var integer v_third := __LINE__;
        if (v_second - v_first == 1 and v_third - v_second == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
