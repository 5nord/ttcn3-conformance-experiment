// @requirement: B.1.2.1 -- e) Templates in the template list shall obey the template (present) restriction (see clause 15.8).
// @id: TTCN3-CORE-B.1.2.1-012a
// @verdict: pass reject
module M_B_01_02_01_template_list_011 {

    type component C {}

    type record R {
        integer f1 optional
    }

    template integer mw_any := *;

    template R mw_r := {
        f1 := (1, mw_any) // error: mw_any does not obey the present restriction
    }

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
