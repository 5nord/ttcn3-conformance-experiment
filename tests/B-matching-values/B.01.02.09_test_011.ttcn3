// @requirement: B.1.2.9 -- Any other value shall cause an error.
// @id: TTCN3-CORE-B.1.2.9-008a
// @verdict: pass accept, ttcn3verdict:error
module M_B_01_02_09_test_011 {

    type component C {}

    type integer Payload with { encode "JSON" }

    function f_format() return charstring {
        return "UTF-7";
    }

    testcase TC() runs on C {
        var charstring v_format := f_format();
        var Payload v_val := 1;
        var universal charstring v_enc := encvalue_unichar(v_val, "UTF-8");
        var template universal charstring vt_dec := decmatch (v_format) Payload:1;
        if (match(v_enc, vt_dec)) { // error: format value not allowed for decvalue_unichar
            setverdict(fail);
        }
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
