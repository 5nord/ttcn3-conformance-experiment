// @requirement: B.1.5.4 -- A notation of the form "\N{reference}", where reference is denoting a one-character-length template, constant, variable, formal parameter or module parameter, matches the character in the referenced value or template.
// @id: TTCN3-CORE-B.1.5.4-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_04_test_001 {

    modulepar charstring mp_char := "m";

    const charstring c_char := "c";
    template charstring m_char := "t";

    type component C {}

    function f_match(charstring p_char, charstring p_value) return boolean {
        template charstring m_p := pattern "\N{p_char}";
        return match(p_value, m_p);
    }

    testcase TC() runs on C {
        var charstring v_char := "v";
        template charstring m_pc := pattern "\N{c_char}";
        template charstring m_pt := pattern "\N{m_char}";
        template charstring m_pv := pattern "\N{v_char}";
        template charstring m_pm := pattern "\N{mp_char}";
        if (match("c", m_pc) and not match("x", m_pc) and
            match("t", m_pt) and not match("x", m_pt) and
            match("v", m_pv) and not match("x", m_pv) and
            match("m", m_pm) and not match("x", m_pm) and
            f_match("p", "p") and not f_match("p", "x")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
