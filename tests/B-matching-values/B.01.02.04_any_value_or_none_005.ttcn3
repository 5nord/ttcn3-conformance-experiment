// @requirement: B.1.2.4 -- a) It can be assigned to templates of any type as a whole or to optional fields of set or record templates or to values associated with keys of map templates.
// @id: TTCN3-CORE-B.1.2.4-006a
// @verdict: pass reject
module M_B_01_02_04_any_value_or_none_005 {

    type component C {}

    type record R {
        integer f1,
        boolean f2 optional
    }

    template R mw_r := {
        f1 := *, // error: AnyValueOrNone assigned to a mandatory field
        f2 := *
    }

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
