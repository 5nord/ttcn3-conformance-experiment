// @requirement: B.1.3.2.0 -- If a "*" appears at the highest level inside a binary string, a record of, set of or array, it shall be interpreted as _AnyElementsOrNone._
// @id: TTCN3-CORE-B.1.3.2.0-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_02_00_general_004 {

    type record of integer RoI;
    type set of integer SoI;

    type component C {}

    template RoI mw_roi := {1, *, 3};
    template SoI mw_soi := {1, *};
    template octetstring mw_oct := 'AB*'O;

    testcase TC() runs on C {
        if (match({1, 3}, mw_roi) and match({1, 2, 2, 3}, mw_roi) and
            match({5, 1, 6, 7}, mw_soi) and
            match('AB'O, mw_oct) and match('AB0102'O, mw_oct)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
