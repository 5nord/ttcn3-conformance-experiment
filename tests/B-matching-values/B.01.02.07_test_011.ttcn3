// @requirement: B.1.2.7 -- d) The template in the all from clause shall resolve either into a matching mechanism or combined template.
// @id: TTCN3-CORE-B.1.2.7-010a
// @verdict: pass reject
module M_B_01_02_07_test_011 {

    type component C {}

    type record of integer RoI;
    type set of integer SoI;

    template RoI mw_any := ?;
    template SoI mw_subset := subset (all from mw_any); // error: all from template is a matching mechanism, not a value or combined template
}
