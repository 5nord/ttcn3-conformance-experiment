// @requirement: B.1.2.2 -- A complemented value list may also contain templates obeying the present template restriction (see clause 15.8).
// @id: TTCN3-CORE-B.1.2.2-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_02_complemented_template_list_002 {

    type component C {}

    template(present) integer mw_range := (6 .. 9);
    template integer mw_c := complement(1, mw_range);

    testcase TC() runs on C {
        if (match(5, mw_c) and not match(1, mw_c) and not match(7, mw_c)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
