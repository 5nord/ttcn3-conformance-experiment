// @requirement: B.1.2.1 -- It can be used for values of all types.
// @id: TTCN3-CORE-B.1.2.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_01_test_001 {

    type component C {}

    type enumerated E { e_a, e_b, e_c }
    type record R { integer f }
    type record of integer RoI;
    type union U { integer i, boolean b }

    template integer mw_int := (1, 2);
    template float mw_float := (1.0, 2.5);
    template boolean mw_bool := (true);
    template bitstring mw_bit := ('01'B, '10'B);
    template charstring mw_char := ("a", "b");
    template E mw_enum := (e_a, e_c);
    template R mw_rec := ({ f := 1 }, { f := 2 });
    template RoI mw_roi := ({ 1 }, { 1, 2 });
    template U mw_union := ({ i := 1 }, { b := true });
    template verdicttype mw_verdict := (pass, inconc);

    testcase TC() runs on C {
        var R v_rec := { f := 2 };
        var RoI v_roi := { 1, 2 };
        var U v_union := { b := true };
        if (match(2, mw_int) and match(2.5, mw_float) and match(true, mw_bool)
            and match('10'B, mw_bit) and match("b", mw_char) and match(e_c, mw_enum)
            and match(v_rec, mw_rec) and match(v_roi, mw_roi) and match(v_union, mw_union)
            and match(inconc, mw_verdict)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
