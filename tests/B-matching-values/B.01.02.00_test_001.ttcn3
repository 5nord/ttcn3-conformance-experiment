// @requirement: B.1.2.0 -- The following matching mechanisms may be used in place of explicit values.
// @id: TTCN3-CORE-B.1.2.0-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_00_test_001 {

    type component C {}

    type record R {
        integer f1,
        integer f2,
        integer f3,
        integer f4,
        integer f5 optional
    }

    template R mw_r := {
        f1 := (1, 2, 3),
        f2 := complement(0),
        f3 := ?,
        f4 := (10 .. 20),
        f5 := *
    }

    testcase TC() runs on C {
        var R v_r := { f1 := 2, f2 := 7, f3 := 100, f4 := 15, f5 := omit };
        if (match(v_r, mw_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
