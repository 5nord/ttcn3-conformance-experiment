// @requirement: B.1.2.9 -- A template field that uses this symbol matches the corresponding field if, and only if, the field can be successfully decoded as an instance of the same type as the decoding target and if the decoded instance can be successfully matched by the decoding target.
// @id: TTCN3-CORE-B.1.2.9-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_09_test_002 {

    type component C {}

    type integer Payload (0 .. 255) with { encode "RAW" }

    type record Msg {
        integer id,
        bitstring payload
    }

    template Msg mw_msg := { id := ?, payload := decmatch Payload:(10 .. 20) };

    testcase TC() runs on C {
        var Payload v_in := 15;
        var Payload v_out := 30;
        var Msg v_matching := { id := 1, payload := encvalue(v_in) };
        var Msg v_wrongValue := { id := 1, payload := encvalue(v_out) };
        var Msg v_undecodable := { id := 1, payload := ''B };
        if (match(v_matching, mw_msg) and not match(v_wrongValue, mw_msg)
            and not match(v_undecodable, mw_msg)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
