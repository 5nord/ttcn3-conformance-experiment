// @requirement: B.1.5.2 -- The reference shall be enclosed within the "{" "}" characters and reference shall resolve a compatible character string type.
// @id: TTCN3-CORE-B.1.5.2-002b
// @verdict: pass reject
module M_B_01_05_02_test_003 {

    type component C {}

    const integer c_int := 5;

    template charstring mw_ref := pattern "x{c_int}y"; // error: reference is not of a character string type

    testcase TC() runs on C {
        if (match("x5y", mw_ref)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
