// @requirement: B.1.5.0 -- If it is required to interpret any metacharacter literally it shall be preceded with the metacharacter "\".
// @id: TTCN3-CORE-B.1.5.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_test_005 {

    type component C {}

    template charstring mw_escaped := pattern "a\?b\*c";

    testcase TC() runs on C {
        if (match("a?b*c", mw_escaped) and
            not match("axb*c", mw_escaped) and
            not match("a?bxc", mw_escaped)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
