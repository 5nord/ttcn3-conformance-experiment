// @requirement: B.1.5.0 -- The referred value or template shall be of the charstring or universal charstring type and it shall contain either a specific value or pattern.
// @id: TTCN3-CORE-B.1.5.0-060b
// @verdict: pass reject
module M_B_01_05_00_test_044 {

    type component C {}

    template charstring mw_any := ?;

    template charstring mw_pattern := pattern mw_any; // error: referenced template contains neither a specific value nor a pattern

    testcase TC() runs on C {
        if (match("a", mw_pattern)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
