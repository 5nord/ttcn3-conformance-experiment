// @requirement: B.1.5.2 -- The opening bracket can be optionally followed by a backslash.
// @id: TTCN3-CORE-B.1.5.2-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_02_test_004 {

    type component C {}

    const charstring c_str := "ab";

    template charstring mw_ref := pattern "x{\c_str}y";

    testcase TC() runs on C {
        if (match("xaby", mw_ref) and not match("xy", mw_ref)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
