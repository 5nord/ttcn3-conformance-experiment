// @requirement: B.1.2.2 -- A template field that uses complement matches the corresponding field if and only if the corresponding field's value does not match any of the values or templates listed in the template list.
// @id: TTCN3-CORE-B.1.2.2-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_02_complemented_template_list_003 {

    type component C {}

    type record R {
        integer field1,
        boolean field2
    }

    template R mw_r := {
        field1 := complement(1, 3, (10 .. 20)),
        field2 := complement(true)
    }

    testcase TC() runs on C {
        var R v_m := { field1 := 2, field2 := false };
        var R v_n1 := { field1 := 3, field2 := false };
        var R v_n2 := { field1 := 15, field2 := false };
        var R v_n3 := { field1 := 2, field2 := true };
        if (match(v_m, mw_r) and not match(v_n1, mw_r)
            and not match(v_n2, mw_r) and not match(v_n3, mw_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
