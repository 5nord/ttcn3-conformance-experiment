// @requirement: B.1.5.2 -- If a referenced definition or field of a definition contains one or more reference expressions, then these references shall recursively be dereferenced before inserting their contents into the referencing pattern.
// @id: TTCN3-CORE-B.1.5.2-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_02_test_010 {

    type component C {}

    template charstring m_ref0 := pattern "My String";
    template charstring m_ref4 := pattern "{m_ref0}";
    template charstring m_ref5 := pattern "";
    template charstring m_ref6 := pattern "{m_ref4}{m_ref5}";

    testcase TC() runs on C {
        if (match("My String", m_ref6) and not match("{m_ref0}", m_ref6)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
