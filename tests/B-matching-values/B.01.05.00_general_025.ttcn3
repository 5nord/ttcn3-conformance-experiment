// @requirement: B.1.5.0 -- Metacharacter: \r; Description: Match the CARRIAGE RETURN (000D) control character (see ISO/IEC 10646 [2])
// @id: TTCN3-CORE-B.1.5.0-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_general_025 {

    type component C {}

    template charstring mw_cr := pattern "\r";

    testcase TC() runs on C {
        if (match(int2char(13), mw_cr) and
            not match(int2char(10), mw_cr) and
            not match("r", mw_cr)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
