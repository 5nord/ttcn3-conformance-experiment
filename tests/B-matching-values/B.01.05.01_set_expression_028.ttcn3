// @requirement: B.1.5.1 -- To include a literal closing square bracket "]", place it first or precede it with a backslash.
// @id: TTCN3-CORE-B.1.5.1-033a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_01_set_expression_028 {

    type component C {}

    template charstring mw_first := pattern "[]a]";
    template charstring mw_escaped := pattern "[a\]]";

    testcase TC() runs on C {
        if (match("]", mw_first) and match("a", mw_first) and not match("b", mw_first)
            and match("]", mw_escaped) and match("a", mw_escaped) and not match("b", mw_escaped)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
