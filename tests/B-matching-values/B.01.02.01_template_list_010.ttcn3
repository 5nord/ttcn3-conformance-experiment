// @requirement: B.1.2.1 -- c) Individual elements of the combined template in the all from clause shall not resolve to any of the following matching mechanisms: AnyElementsOrNone, permutation.
// @id: TTCN3-CORE-B.1.2.1-010a
// @verdict: pass reject
module M_B_01_02_01_template_list_010 {

    type component C {}

    type record of integer RoI;

    template RoI mw_roI := { 1, *, 3 };
    template integer mw_i := (0, all from mw_roI); // error: mw_roI contains AnyElementsOrNone

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
