// @requirement: B.1.2.7 -- f) If the length matching attribute is attached to the SubSet, the maximum length allowed by the length attribute shall not exceed the number of the elements in the SubSet.
// @id: TTCN3-CORE-B.1.2.7-014a
// @verdict: pass reject
module M_B_01_02_07_subset_016 {

    type component C {}

    type set of integer SoI;

    template SoI mw_subset := subset (1, 2, 3) length (0 .. 4); // error: maximum length 4 exceeds 3 elements
}
