// @requirement: B.1.2.9 -- c) The optional encoding format parameter can be used only for fields of r universal `charstring types.` The parameter value shall be of the charstring type and it shall contain one of the strings allowed for the decvalue_unichar predefined function (specified in clause C.5.4).
// @id: TTCN3-CORE-B.1.2.9-007c
// @verdict: pass reject
module M_B_01_02_09_test_010 {

    type component C {}

    type integer Payload with { encode "JSON" }

    type record Msg {
        integer id,
        universal charstring payload
    }

    template Msg mw_msg := { id := ?, payload := decmatch ("ISO-8859-1") Payload:? }; // error: not an encoding format allowed for decvalue_unichar
}
