// @requirement: B.1.5.1 -- NOTE 1: Embedded lists are not allowed.
// @id: TTCN3-CORE-B.1.5.1-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_01_set_expression_023 {

    type component C {}

    template charstring mw_set := pattern "[ab[r-z]]";

    testcase TC() runs on C {
        // the inner "[" is a literal, not the start of an embedded list
        if (match("[]", mw_set) and match("s]", mw_set)
            and not match("s", mw_set) and not match("a", mw_set)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
