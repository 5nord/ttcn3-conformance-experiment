// @requirement: B.1.2.10 -- To match an enumerated value with an associated value list in its definition, the enumerated value name shall be referenced followed by a non-empty list of integer templates in parenthesis.
// @id: TTCN3-CORE-B.1.2.10-001b
// @verdict: pass reject
module M_B_01_02_10_matching_enumerated_value_with_value_list_002 {

    type enumerated Days { Christmas(0), Easter(1), Other(2..365) }

    template Days mw_days := Other(); // error: empty list of integer templates
}
