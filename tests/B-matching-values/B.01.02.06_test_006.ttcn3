// @requirement: B.1.2.6 -- NOTE: The SuperSet matching mechanism imposes an implicit length restriction on the matched set of values, i.e. the set of values contains at least as many elements as the SuperSet template in order to produce a successful match.
// @id: TTCN3-CORE-B.1.2.6-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_06_test_006 {

    type component C {}

    type set of integer SoI;

    template SoI mw_superset := superset (?, ?, ?);

    testcase TC() runs on C {
        var SoI v_two := { 1, 2 };
        var SoI v_three := { 1, 2, 3 };
        if (not match(v_two, mw_superset) and match(v_three, mw_superset)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
