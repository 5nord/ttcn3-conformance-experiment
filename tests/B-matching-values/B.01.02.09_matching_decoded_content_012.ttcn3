// @requirement: B.1.2.9 -- d) If the template field is of charstring type or is of universal charstring type and the encoding format is missing, the default value "UTF-8" shall be used.
// @id: TTCN3-CORE-B.1.2.9-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_09_matching_decoded_content_012 {

    type component C {}

    type integer Payload with { encode "JSON" }

    template universal charstring mw_default := decmatch Payload:1234;

    testcase TC() runs on C {
        var Payload v_val := 1234;
        var universal charstring v_utf8 := encvalue_unichar(v_val, "UTF-8");
        var universal charstring v_utf16 := encvalue_unichar(v_val, "UTF-16");
        if (match(v_utf8, mw_default) and not match(v_utf16, mw_default)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
