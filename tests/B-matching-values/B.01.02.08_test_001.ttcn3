// @requirement: B.1.2.8 -- If used as a matching mechanism, it matches an optional field or a map key if and only if it is absent.
// @id: TTCN3-CORE-B.1.2.8-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_08_test_001 {

    type component C {}

    type record R {
        integer f1,
        boolean f2 optional
    }

    type map from charstring to integer MyMap;

    template R mw_rec := { f1 := ?, f2 := omit };
    template MyMap mw_map := { ["host"] := ?, ["port"] := omit };

    testcase TC() runs on C {
        var R v_absent := { f1 := 1, f2 := omit };
        var R v_present := { f1 := 1, f2 := false };
        var MyMap v_keyAbsent := { ["host"] := 1 };
        var MyMap v_keyPresent := { ["host"] := 1, ["port"] := 80 };
        if (match(v_absent, mw_rec) and not match(v_present, mw_rec)
            and match(v_keyAbsent, mw_map) and not match(v_keyPresent, mw_map)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
