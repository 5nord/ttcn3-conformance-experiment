// @requirement: B.1.3.1.1 -- For example: "abcdxyz", "abccxyz", "abcxxyz" etc. will all match pattern "abc?xyz".
// @id: TTCN3-CORE-B.1.3.1.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_01_01_test_002 {

    type component C {}

    template charstring mw_pattern := pattern "abc?xyz";

    testcase TC() runs on C {
        if (match("abcdxyz", mw_pattern) and match("abccxyz", mw_pattern) and
            match("abcxxyz", mw_pattern)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
