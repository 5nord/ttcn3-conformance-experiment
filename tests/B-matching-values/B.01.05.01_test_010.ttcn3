// @requirement: B.1.5.1 -- Metacharacter: #n; Indexing: Including the preceding expression; Description: Match the previous expression exactly n times (where n is a single digit) (postfix); the same as #(n). See clause B.1.5.3 for more details
// @id: TTCN3-CORE-B.1.5.1-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_01_test_010 {

    type component C {}

    template charstring mw_short := pattern "[ab]#3";
    template charstring mw_long := pattern "[ab]#(3)";

    testcase TC() runs on C {
        if (match("aba", mw_short) and not match("ab", mw_short) and not match("abab", mw_short)
            and match("aba", mw_long) and not match("ab", mw_long) and not match("abab", mw_long)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
