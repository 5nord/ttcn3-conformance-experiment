// @requirement: B.1.2.7 -- The successful match shall be produced only if there exists such a one-to-one mapping from the elements of the set of values to the SubSet elements where each element of the set of values is matched by the SubSet element it is mapped to.
// @id: TTCN3-CORE-B.1.2.7-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_07_test_003 {

    type component C {}

    type set of integer SoI;

    template SoI mw_oneAndAny := subset (1, ?);
    template SoI mw_oneAndTwo := subset (1, 2);

    testcase TC() runs on C {
        var SoI v_twoOnes := { 1, 1 };
        var SoI v_twoTwos := { 2, 2 };
        if (match(v_twoOnes, mw_oneAndAny) and not match(v_twoTwos, mw_oneAndAny)
            and not match(v_twoOnes, mw_oneAndTwo)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
