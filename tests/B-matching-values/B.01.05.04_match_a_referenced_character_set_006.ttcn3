// @requirement: B.1.5.4 -- NOTE 1: Cases when the referenced set of characters is not a subset of values allowed by the type definition of the template or template field for which the character pattern is used, are not be treated as an error (but e.g. matching never can occur if the two sets do not overlap).
// @id: TTCN3-CORE-B.1.5.4-004b
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_04_match_a_referenced_character_set_006 {

    type charstring MyChars ("a".."c");
    type charstring OtherChars ("x".."z");

    type component C {}

    testcase TC() runs on C {
        template MyChars m_p := pattern "\N{OtherChars}";
        if (not match("a", m_p) and not match("b", m_p) and not match("c", m_p)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
