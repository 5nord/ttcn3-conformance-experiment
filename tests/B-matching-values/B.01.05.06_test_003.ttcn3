// @requirement: B.1.5.6 -- When the "@nocase" modifier is used after the pattern keyword, the matching is evaluated in a case insensitive way, i.e. at positions, where without the "@nocase" modifier a small letter alphabetical character would be matched, with the "@nocase" modifier also capital letter counterpart - but only that - shall be accepted.
// @id: TTCN3-CORE-B.1.5.6-001c
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_06_test_003 {

    type component C {}

    testcase TC() runs on C {
        template charstring m_p := pattern @nocase "abc";
        if (match("aBc", m_p) and not match("abd", m_p) and not match("ABD", m_p) and
            not match("a-c", m_p) and not match("aBC1", m_p)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
