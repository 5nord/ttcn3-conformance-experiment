// @requirement: B.1.2.10 -- The template matches only those enumerated values of the same name where the associated integer values is matched by at least one of the integer templates.
// @id: TTCN3-CORE-B.1.2.10-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_10_matching_enumerated_value_with_value_list_003 {

    type enumerated Days { Christmas(0), Easter(1), Other(2..365) }

    type component C {}

    template integer mw_greater20 := complement(0 .. 20);
    template Days mw_days1 := Other(5..6, mw_greater20);
    template Days mw_days2 := Other(?);

    testcase TC() runs on C {
        if (match(Other(5), mw_days1) and match(Other(6), mw_days1) and
            match(Other(21), mw_days1) and match(Other(365), mw_days1) and
            not match(Other(7), mw_days1) and not match(Other(20), mw_days1) and
            match(Other(2), mw_days2) and
            not match(Christmas, mw_days2) and not match(Easter, mw_days2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
