// @requirement: B.1.3.3 -- For example, {permutation(1,2,*)} is equivalent to ({*,1,*,2,*},{*,2,*,1,*}), while {permutation(1,2),*} is equivalent to ({1,2,*},{2,1,*}).
// @id: TTCN3-CORE-B.1.3.3-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_03_test_008 {

    type record of integer RoI;
    type record of RoI RoRoI;

    type component C {}

    template RoI mw_perm1 := {permutation(1, 2, *)};
    template RoI mw_list1 := ({*, 1, *, 2, *}, {*, 2, *, 1, *});
    template RoI mw_perm2 := {permutation(1, 2), *};
    template RoI mw_list2 := ({1, 2, *}, {2, 1, *});

    testcase TC() runs on C {
        var RoRoI v_values := {
            {1, 2}, {2, 1}, {1, 3, 2}, {3, 2, 4, 1, 5}, {1, 2, 3}, {2, 1, 4},
            {3, 1, 2}, {1, 1}, {1}, {}
        };
        var boolean v_ok := true;
        for (var integer i := 0; i < lengthof(v_values); i := i + 1) {
            if (match(v_values[i], mw_perm1) != match(v_values[i], mw_list1) or
                match(v_values[i], mw_perm2) != match(v_values[i], mw_list2)) {
                v_ok := false;
            }
        }
        if (v_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
