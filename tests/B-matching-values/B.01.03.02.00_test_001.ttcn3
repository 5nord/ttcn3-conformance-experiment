// @requirement: B.1.3.2.0 -- The matching symbol "*" (AnyElementsOrNone) is used to indicate that it replaces none or any number of consecutive elements of a string (except character strings), a record of, a set of or an array.
// @id: TTCN3-CORE-B.1.3.2.0-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_02_00_test_001 {

    type record of integer RoI;
    type set of integer SoI;
    type integer A3[3];

    type component C {}

    template bitstring mw_bits := '10*11'B;
    template RoI mw_roi := {*, 2, 3};
    template SoI mw_soi := {*, 2, 3};
    template A3 mw_arr := {1, *};

    testcase TC() runs on C {
        var A3 v_arr := {1, 8, 9};
        if (match('1011'B, mw_bits) and match('1000111'B, mw_bits) and
            not match('1001'B, mw_bits) and
            match({2, 3}, mw_roi) and match({7, 8, 9, 2, 3}, mw_roi) and
            not match({2, 3, 4}, mw_roi) and
            match({3, 2}, mw_soi) and match({3, 9, 2, 8}, mw_soi) and
            match(v_arr, mw_arr)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
