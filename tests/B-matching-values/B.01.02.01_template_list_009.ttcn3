// @requirement: B.1.2.1 -- Elements of the combined template may contain any of the matching mechanisms or matching attributes with the exception of those described in the following restriction.
// @id: TTCN3-CORE-B.1.2.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_01_template_list_009 {

    type component C {}

    type record of integer RoI;

    template RoI mw_roI := { 1, (6 .. 9), (20, 21), complement(-1, 0) };
    template integer mw_i := (all from mw_roI);

    testcase TC() runs on C {
        if (match(1, mw_i) and match(7, mw_i) and match(21, mw_i) and match(500, mw_i)
            and not match(0, mw_i)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
