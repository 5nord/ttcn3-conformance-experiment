// @requirement: B.1.5.0 -- NOTE 4: Such use of the metacharacter "\" is deprecated as further metacharacters can be defined later.
// @id: TTCN3-CORE-B.1.5.0-048a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_test_036 {

    type component C {}

    template charstring mw_deprecated := pattern "\k\m";

    testcase TC() runs on C {
        if (match("km", mw_deprecated)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
