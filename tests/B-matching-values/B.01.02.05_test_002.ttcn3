// @id: TTCN3-CORE-B.1.2.5-003a
// @verdict: pass reject
module M_B_01_02_05_test_002 {

    type component C {}

    template integer mw_upper := ?;
    template integer mw_range := (0 .. mw_upper); // error: boundary does not evaluate to a specific value

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
