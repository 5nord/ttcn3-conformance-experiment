// @requirement: B.1.3.2.1 -- For example: "abcxyz", "abcdefxyz" "abcabcxyz" etc. will all match pattern "abc*xyz".
// @id: TTCN3-CORE-B.1.3.2.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_02_01_using_multiple_character_wildcards_002 {

    type component C {}

    template charstring mw_pattern := pattern "abc*xyz";

    testcase TC() runs on C {
        if (match("abcxyz", mw_pattern) and match("abcdefxyz", mw_pattern) and
            match("abcabcxyz", mw_pattern)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
