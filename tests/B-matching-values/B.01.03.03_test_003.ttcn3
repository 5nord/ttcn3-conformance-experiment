// @requirement: B.1.3.3 -- A permutation without AnyElementsOrNone in place of a single record of element means that any series of elements is acceptable provided that there is a one to one mapping between elements in the record of and in the permutation list such that each element matches its corresponding element in the permutation list.
// @id: TTCN3-CORE-B.1.3.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_03_test_003 {

    type record of integer RoI;

    type component C {}

    template RoI mw_roi := {permutation(1, 2, ?)};

    testcase TC() runs on C {
        var RoI v_ok1 := {2, 7, 1};
        var RoI v_ok2 := {1, 1, 2};
        var RoI v_missing := {1, 7, 7};
        var RoI v_short := {1, 2};
        var RoI v_long := {1, 2, 3, 4};
        if (match(v_ok1, mw_roi) and match(v_ok2, mw_roi) and
            not match(v_missing, mw_roi) and not match(v_short, mw_roi) and
            not match(v_long, mw_roi)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
