// @requirement: B.1.5.1 -- The set expression can also be negated by placing the caret "^" character as the first character after the opening square bracket.
// @id: TTCN3-CORE-B.1.5.1-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_01_test_006 {

    type component C {}

    template charstring mw_neg := pattern "[^a-c]";

    testcase TC() runs on C {
        if (match("x", mw_neg) and match("^", mw_neg) and not match("a", mw_neg)
            and not match("b", mw_neg) and not match("c", mw_neg)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
