// @requirement: B.1.2.7 -- However, the length matching attribute may be attached to the SubSet itself.
// @id: TTCN3-CORE-B.1.2.7-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_07_test_005 {

    type component C {}

    type set of integer SoI;

    template SoI mw_subset := subset (1, 2, 3) length (2);

    testcase TC() runs on C {
        var SoI v_two := { 3, 1 };
        var SoI v_one := { 1 };
        var SoI v_three := { 1, 2, 3 };
        if (match(v_two, mw_subset) and not match(v_one, mw_subset)
            and not match(v_three, mw_subset)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
