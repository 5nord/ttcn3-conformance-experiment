// @requirement: B.1.2.7 -- SubSet matches a set of values if, and only if, the set of values contains_ only elements defined within the SubSet, and may contain less.
// @id: TTCN3-CORE-B.1.2.7-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_07_subset_002 {

    type component C {}

    type set of integer SoI;

    template SoI mw_subset := subset (1, 2, 3);

    testcase TC() runs on C {
        var SoI v_all := { 3, 2, 1 };
        var SoI v_less := { 2 };
        var SoI v_empty := {};
        var SoI v_other := { 1, 4 };
        if (match(v_all, mw_subset) and match(v_less, mw_subset) and match(v_empty, mw_subset)
            and not match(v_other, mw_subset)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
