// @requirement: B.1.5.3 -- To specify that the preceding expression should be matched a number of times one of the following syntaxes shall be used: "#(n, m)", "#(n, )", "#(, m)", "#(n)", "#n", "#(,)", "#()" or "+".
// @id: TTCN3-CORE-B.1.5.3-001a
// @verdict: pass accept, noexecution
module M_B_01_05_03_match_expression_n_times_001 {

    template charstring m_nm := pattern "[a-z]#(2, 3)";
    template charstring m_n := pattern "[a-z]#(2, )";
    template charstring m_m := pattern "[a-z]#(, 3)";
    template charstring m_np := pattern "[a-z]#(2)";
    template charstring m_nd := pattern "[a-z]#2";
    template charstring m_any1 := pattern "[a-z]#(,)";
    template charstring m_any2 := pattern "[a-z]#()";
    template charstring m_plus := pattern "[a-z]+";
}
