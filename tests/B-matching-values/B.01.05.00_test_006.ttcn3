// @requirement: B.1.5.0 -- This template would match any character string which consists of the characters "ab", followed by any character, followed by the characters "?xyz", followed by any number of any characters.
// @id: TTCN3-CORE-B.1.5.0-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_test_006 {

    type component C {}

    template charstring mw_myTemplate := pattern "ab?\?xyz*";

    testcase TC() runs on C {
        if (match("abc?xyz", mw_myTemplate) and
            match("ab1?xyz123", mw_myTemplate) and
            not match("abcdxyz", mw_myTemplate) and
            not match("ab?xyz", mw_myTemplate)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
