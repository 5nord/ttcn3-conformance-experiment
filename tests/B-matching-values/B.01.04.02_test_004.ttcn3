// @requirement: B.1.4.2 -- b) At the time of matching during a receiving operation, it shall be applied to optional fields of record and set templates or to values associated with keys of map templates only.
// @id: TTCN3-CORE-B.1.4.2-005a
// @verdict: pass reject
module M_B_01_04_02_test_004 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    template integer mw_int := 5 ifpresent;

    function f_send() runs on C {
        p.send(5);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.receive(mw_int) { // error: ifpresent on the whole template in a receiving operation
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
