// @requirement: B.1.2.4 -- It can be assigned to templates of any type as a whole or to optional fields of set or record templates or to a value associated with a key of a map template. a) It can be assigned to templates of any type as a whole or to optional fields of set or record templates or to values associated with keys of map templates.
// @id: TTCN3-CORE-B.1.2.4-002a
// @verdict: pass accept, noexecution
module M_B_01_02_04_any_value_or_none_002 {

    type record of integer RoI;

    type record R {
        integer f1,
        RoI f2 optional
    }

    type set S {
        integer f1,
        boolean f2 optional
    }

    type map from charstring to integer MyMap;

    template RoI mw_roi := *;
    template boolean mw_bool := *;
    template R mw_rec := *;
    template R mw_recField := { f1 := 1, f2 := * };
    template S mw_setField := { f1 := 1, f2 := * };
    template MyMap mw_map := { ["port"] := * };
}
