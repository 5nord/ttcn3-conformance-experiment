// @requirement: B.1.3.3 -- The combined template shall not contain permutations.
// @id: TTCN3-CORE-B.1.3.3-014a
// @verdict: pass reject
module M_B_01_03_03_test_014 {

    type record of integer RoI;

    template RoI mw_roi1 := {permutation(1, 2)};
    template RoI mw_roi2 := {permutation(0, all from mw_roi1)}; // error: referenced combined template contains a permutation
}
