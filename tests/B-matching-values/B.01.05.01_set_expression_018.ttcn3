// @requirement: B.1.5.1 -- "-" not at the first or last positions in the list;
// @id: TTCN3-CORE-B.1.5.1-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_01_set_expression_018 {

    type component C {}

    template charstring mw_set := pattern "[a-c]";

    testcase TC() runs on C {
        if (match("b", mw_set) and not match("-", mw_set)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
