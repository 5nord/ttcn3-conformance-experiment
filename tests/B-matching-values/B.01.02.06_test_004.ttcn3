// @requirement: B.1.2.6 -- The SuperSet matching mechanism may contain templates (including template variables) obeying the present template restriction (see clause 15.8) and matching mechanisms with the restrictions given below.
// @id: TTCN3-CORE-B.1.2.6-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_06_test_004 {

    type component C {}

    type set of integer SoI;

    template(present) integer m_small := (1 .. 3);

    testcase TC() runs on C {
        var template(present) integer vt_big := complement ((0 .. 9));
        var template SoI vt_superset := superset (m_small, vt_big, (4, 5));
        var SoI v_match := { 10, 5, 2 };
        var SoI v_noMatch := { 7, 5, 2 };
        if (match(v_match, vt_superset) and not match(v_noMatch, vt_superset)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
