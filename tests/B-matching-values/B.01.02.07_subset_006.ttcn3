// @requirement: B.1.2.7 -- The SubSet matching mechanism imposes an implicit length restriction on the matched set of values: the set of values shall contain at most as many elements as the SubSet template in order to produce a successful match.
// @id: TTCN3-CORE-B.1.2.7-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_07_subset_006 {

    type component C {}

    type set of integer SoI;

    template SoI mw_subset := subset (?, ?);

    testcase TC() runs on C {
        var SoI v_two := { 1, 2 };
        var SoI v_three := { 1, 2, 3 };
        if (match(v_two, mw_subset) and not match(v_three, mw_subset)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
