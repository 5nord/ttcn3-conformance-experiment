// @requirement: B.1.5.0 -- However, it shall not be forgotten, that receiving operations require type checking of the received message before attempting to match it.
// @id: TTCN3-CORE-B.1.5.0-043a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_general_033 {

    type charstring Abc ("a".."c");

    type port P message {
        inout charstring
    }

    type component C {
        port P p;
    }

    function f_send() runs on C {
        p.send(charstring:"z");
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.receive(Abc:pattern "?") {
                setverdict(fail);
            }
            [] p.receive(charstring:"z") {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
