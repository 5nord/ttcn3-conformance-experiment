// @requirement: B.1.2.6 -- c) The member type of the set of associated with the SuperSet template and the member type of the template in the all from clause shall be compatible.
// @id: TTCN3-CORE-B.1.2.6-009a
// @verdict: pass reject
module M_B_01_02_06_test_010 {

    type component C {}

    type record of charstring RoCS;
    type set of integer SoI;

    template RoCS m_roCS := { "a", "b" };
    template SoI mw_superset := superset (all from m_roCS); // error: charstring members not compatible with integer
}
