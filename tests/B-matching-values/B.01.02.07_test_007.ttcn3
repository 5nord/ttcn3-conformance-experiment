// @requirement: B.1.2.7 -- Besides specifying individual values, it is possible to add all elements of a record of or set of template into _SubSets using an all from clause._
// @id: TTCN3-CORE-B.1.2.7-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_07_test_007 {

    type component C {}

    type record of integer RoI;
    type set of integer SoI;

    template RoI m_roI := { 1, 2 };
    template SoI m_soI := { 3 };
    template SoI mw_subset := subset (all from m_roI, all from m_soI);

    testcase TC() runs on C {
        var SoI v_match := { 3, 1 };
        var SoI v_noMatch := { 1, 9 };
        if (match(v_match, mw_subset) and not match(v_noMatch, mw_subset)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
