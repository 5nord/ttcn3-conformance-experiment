// @requirement: B.1.2.7 -- _SubSet is denoted by the keyword subset.
// @id: TTCN3-CORE-B.1.2.7-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_07_test_001 {

    type component C {}

    type set of integer SoI;

    template SoI mw_subset := subset (1, 2, 3);

    testcase TC() runs on C {
        var SoI v_val := { 3, 1 };
        if (match(v_val, mw_subset)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
