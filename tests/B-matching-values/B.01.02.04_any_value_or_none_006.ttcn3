// @requirement: B.1.2.4 -- b) At the time of matching during a receiving operation, it shall be applied to optional fields of record and set templates or to values associated with keys of map templates only.
// @id: TTCN3-CORE-B.1.2.4-007a
// @verdict: pass reject
module M_B_01_02_04_any_value_or_none_006 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    template integer mw_any := *;

    testcase TC() runs on C {
        timer T := 1.0;
        connect(mtc:p, mtc:p);
        p.send(1);
        T.start;
        alt {
            [] p.receive(mw_any) { // error: AnyValueOrNone as a whole in a receiving operation
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
