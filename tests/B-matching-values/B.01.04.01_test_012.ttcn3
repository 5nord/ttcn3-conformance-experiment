// @requirement: B.1.4.1 -- If a length restriction is added to an AnyElementsOrNone matching mechanism, it constrains the number of elements matched by this matching mechanism.
// @id: TTCN3-CORE-B.1.4.1-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_04_01_test_012 {

    type record of integer RoI;

    type component C {}

    template RoI mw_roi := {1, * length(2), 3};

    testcase TC() runs on C {
        var RoI v_two := {1, 7, 8, 3};
        var RoI v_none := {1, 3};
        var RoI v_one := {1, 7, 3};
        var RoI v_three := {1, 7, 8, 9, 3};
        if (match(v_two, mw_roi) and not match(v_none, mw_roi) and
            not match(v_one, mw_roi) and not match(v_three, mw_roi)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
