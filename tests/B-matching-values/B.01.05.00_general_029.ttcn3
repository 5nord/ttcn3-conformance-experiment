// @requirement: B.1.5.0 -- Metacharacter: ""; Description: Match the double quote character
// @id: TTCN3-CORE-B.1.5.0-032a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_general_029 {

    type component C {}

    template charstring mw_quote := pattern "a""b";

    testcase TC() runs on C {
        if (match("a" & int2char(34) & "b", mw_quote) and
            not match("ab", mw_quote) and
            not match("a" & int2char(34) & int2char(34) & "b", mw_quote)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
