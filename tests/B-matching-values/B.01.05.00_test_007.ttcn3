// @requirement: B.1.5.0 -- Metacharacters shall not contain whitespaces except a whitespace preceded by a newline character before or inside a set expression.
// @id: TTCN3-CORE-B.1.5.0-012a
// @verdict: pass reject
module M_B_01_05_00_test_007 {

    type component C {}

    const charstring c_ref := "ab";

    template charstring mw_pattern := pattern "x{ c_ref }"; // error: whitespace inside the reference metacharacter

    testcase TC() runs on C {
        if (match("xab", mw_pattern)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
