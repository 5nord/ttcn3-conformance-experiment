// @requirement: B.1.2.6 -- _SuperSet is denoted by the keyword superset.
// @id: TTCN3-CORE-B.1.2.6-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_06_superset_001 {

    type component C {}

    type set of integer SoI;

    template SoI mw_superset := superset (1, 2);

    testcase TC() runs on C {
        var SoI v_val := { 3, 2, 1 };
        if (match(v_val, mw_superset)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
