// @requirement: B.1.4.1 -- The minimum and maximum number of elements matched by the _AnyElementsOrNone matching mechanism is equal to the lower bound and upper bound of the length restriction._
// @id: TTCN3-CORE-B.1.4.1-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_04_01_length_restrictions_013 {

    type record of integer RoI;

    type component C {}

    template RoI mw_roi := {1, * length(1 .. 2), 3};

    testcase TC() runs on C {
        var RoI v_zero := {1, 3};
        var RoI v_one := {1, 7, 3};
        var RoI v_two := {1, 7, 8, 3};
        var RoI v_three := {1, 7, 8, 9, 3};
        if (not match(v_zero, mw_roi) and match(v_one, mw_roi) and
            match(v_two, mw_roi) and not match(v_three, mw_roi)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
