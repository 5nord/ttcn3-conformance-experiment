// @requirement: B.1.2.1 -- b) The template in the all from clause shall be either a specific value or combined template.
// @id: TTCN3-CORE-B.1.2.1-008a
// @verdict: pass reject
module M_B_01_02_01_template_list_008 {

    type component C {}

    type record of integer RoI;

    template RoI mw_roI := ?;
    template integer mw_i := (0, all from mw_roI); // error: mw_roI as a whole is a matching mechanism

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
