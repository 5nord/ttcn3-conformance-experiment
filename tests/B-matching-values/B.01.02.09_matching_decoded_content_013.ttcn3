// @requirement: B.1.2.9 -- Decoding is successful only if the decoding function returns 0 and the first parameter contains an empty string (i.e. the whole encoded value has been successfully decoded).
// @id: TTCN3-CORE-B.1.2.9-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_09_matching_decoded_content_013 {

    type component C {}

    type integer Payload (0 .. 255) with { encode "RAW" }

    template bitstring mw_payload := decmatch Payload:?;

    testcase TC() runs on C {
        var Payload v_val := 15;
        var bitstring v_exact := encvalue(v_val);
        var bitstring v_trailing := v_exact & v_exact;
        if (match(v_exact, mw_payload) and not match(v_trailing, mw_payload)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
