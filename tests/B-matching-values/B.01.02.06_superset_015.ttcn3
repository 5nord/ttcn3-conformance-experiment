// @requirement: B.1.2.6 -- individual elements of the combined template in the all from clause shall not resolve to AnyElementsOrNone or permutation.
// @id: TTCN3-CORE-B.1.2.6-013b
// @verdict: pass reject
module M_B_01_02_06_superset_015 {

    type component C {}

    type record of integer RoI;
    type set of integer SoI;

    template RoI mw_roI := { 1, * };
    template SoI mw_superset := superset (all from mw_roI); // error: element of all from template is AnyElementsOrNone
}
