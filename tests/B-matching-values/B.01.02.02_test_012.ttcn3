// @requirement: B.1.2.2 -- f) Templates in the complement of a template list shall obey the present template restriction (see clause 15.8).
// @id: TTCN3-CORE-B.1.2.2-013a
// @verdict: pass reject
module M_B_01_02_02_test_012 {

    type component C {}

    type record R {
        integer f1 optional
    }

    template integer mw_any := *;

    template R mw_r := {
        f1 := complement(1, mw_any) // error: mw_any does not obey the present restriction
    }

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
