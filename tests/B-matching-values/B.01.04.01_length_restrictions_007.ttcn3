// @requirement: B.1.4.1 -- The length attribute matches if the length of the field is greater than or equal to the specified lower bound and less than or equal to the upper bound.
// @id: TTCN3-CORE-B.1.4.1-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_04_01_length_restrictions_007 {

    type component C {}

    template charstring mw_str := ? length(2 .. 4);

    testcase TC() runs on C {
        if (not match("a", mw_str) and match("ab", mw_str) and match("abc", mw_str) and
            match("abcd", mw_str) and not match("abcde", mw_str)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
