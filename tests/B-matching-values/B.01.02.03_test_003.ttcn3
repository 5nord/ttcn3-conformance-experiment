// @requirement: B.1.2.3 -- A template field that uses the any value mechanism matches the corresponding field if, and only if, the field evaluates to a single element of the specified type.
// @id: TTCN3-CORE-B.1.2.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_03_test_003 {

    type component C {}

    type record R {
        integer f1,
        integer f2 optional
    }

    template R mw_r := {
        f1 := ?,
        f2 := ?
    }

    testcase TC() runs on C {
        var R v_present := { f1 := 1, f2 := 2 };
        var R v_absent := { f1 := 1, f2 := omit };
        if (match(v_present, mw_r) and not match(v_absent, mw_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
