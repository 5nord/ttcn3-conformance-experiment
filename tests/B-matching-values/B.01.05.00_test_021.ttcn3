// @requirement: B.1.5.0 -- Metacharacter: \d; Description: Match any numerical digit (equivalent to [0-9])
// @id: TTCN3-CORE-B.1.5.0-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_test_021 {

    type component C {}

    template charstring mw_digit := pattern "\d";
    template charstring mw_set := pattern "[0-9]";

    testcase TC() runs on C {
        var boolean v_ok := match("7", mw_digit) and not match("a", mw_digit);
        for (var integer i := 0; i < 128; i := i + 1) {
            if (match(int2char(i), mw_digit) != match(int2char(i), mw_set)) {
                v_ok := false;
            }
        }
        if (v_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
