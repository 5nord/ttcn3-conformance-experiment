// @requirement: B.1.5.1 -- A list of characters enclosed by a pair of "[" and "]" matches any single character in that list.
// @id: TTCN3-CORE-B.1.5.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_01_test_001 {

    type component C {}

    template charstring mw_set := pattern "[abc]";

    testcase TC() runs on C {
        if (match("a", mw_set) and match("b", mw_set) and match("c", mw_set)
            and not match("d", mw_set) and not match("ab", mw_set) and not match("", mw_set)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
