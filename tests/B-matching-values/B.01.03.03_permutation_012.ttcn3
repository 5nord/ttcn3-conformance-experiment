// @requirement: B.1.3.3 -- b) The member type of the permutation and the member type of the template in the all from clause shall be compatible.
// @id: TTCN3-CORE-B.1.3.3-012a
// @verdict: pass reject
module M_B_01_03_03_permutation_012 {

    type record of integer RoI;
    type record of charstring RoC;

    template RoC mw_roc := {"a", "b"};
    template RoI mw_roi := {permutation(0, all from mw_roc)}; // error: charstring members are not compatible with integer
}
