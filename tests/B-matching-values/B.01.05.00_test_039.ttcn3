// @requirement: B.1.5.0 -- However, errors caused by invalid references can still appear (see clauses 27.9 and B.1.5.4 for more details).
// @id: TTCN3-CORE-B.1.5.0-053a
// @verdict: pass accept, ttcn3verdict:error
module M_B_01_05_00_test_039 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_char := "ab";
        var template charstring v_pattern := pattern "\N{v_char}";
        setverdict(pass);
        if (match("a", v_pattern)) {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
