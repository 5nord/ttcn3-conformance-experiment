// @requirement: B.1.2.4 -- A map template key that uses this symbol instead of an associated value matches the corresponding key if, and only if, either the corresponding key is present and its associated value evaluates to any value of the specified type, or if the corresponding key is absent.
// @id: TTCN3-CORE-B.1.2.4-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_04_any_value_or_none_004 {

    type component C {}

    type map from charstring to integer MyMap;

    template MyMap mw_map := { ["host"] := 1, ["port"] := * };

    testcase TC() runs on C {
        var MyMap v_present := { ["host"] := 1, ["port"] := 80 };
        var MyMap v_absent := { ["host"] := 1 };
        if (match(v_present, mw_map) and match(v_absent, mw_map)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
