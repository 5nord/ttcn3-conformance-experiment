// @requirement: B.1.2.9 -- The matching mechanism will generate an unsuccessful match if decoding hasn't succeeded.
// @id: TTCN3-CORE-B.1.2.9-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_09_matching_decoded_content_014 {

    type component C {}

    type integer Payload with { encode "JSON" }

    template universal charstring mw_any := decmatch Payload:?;

    testcase TC() runs on C {
        var universal charstring v_garbage := "not an integer";
        if (not match(v_garbage, mw_any)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
