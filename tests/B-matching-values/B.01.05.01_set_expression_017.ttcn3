// @requirement: B.1.5.1 -- "]" not at the first position and not immediately following a "^" at the first position;
// @id: TTCN3-CORE-B.1.5.1-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_01_set_expression_017 {

    type component C {}

    template charstring mw_set := pattern "[ab]c";
    template charstring mw_neg := pattern "[^a]c";

    testcase TC() runs on C {
        if (match("ac", mw_set) and match("bc", mw_set) and not match("a]c", mw_set)
            and match("bc", mw_neg) and not match("ac", mw_neg) and not match("b]c", mw_neg)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
