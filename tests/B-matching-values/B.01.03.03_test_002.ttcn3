// @requirement: B.1.3.3 -- _Permutation is an operation for matching that shall be used only on values of record of and array types._ _Permutation is denoted by the keyword permutation.
// @id: TTCN3-CORE-B.1.3.3-001b
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_03_test_002 {

    type record of integer RoI;

    type component C {}

    template RoI mw_roi := {permutation(1, 2, 3), 5};

    testcase TC() runs on C {
        var RoI v_value := {3, 1, 2, 5};
        if (match(v_value, mw_roi)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
