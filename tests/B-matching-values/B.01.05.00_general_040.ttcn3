// @requirement: B.1.5.0 -- Character patterns may be composed from several fragments using the concatenation operation.
// @id: TTCN3-CORE-B.1.5.0-054a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_general_040 {

    type component C {}

    template charstring mw_myTemplate := pattern "ab?\?" & "xyz*";

    testcase TC() runs on C {
        if (match("abc?xyz123", mw_myTemplate) and
            not match("abcdxyz", mw_myTemplate)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
