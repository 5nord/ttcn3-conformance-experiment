// @requirement: B.1.2.8 -- b) At the time of matching during a receiving operation, it shall be applied to optional fields of record and set templates or to values associated with keys of map templates only.
// @id: TTCN3-CORE-B.1.2.8-004a
// @verdict: pass reject
module M_B_01_02_08_omitting_optional_fields_and_map_keys_004 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    template integer mw_omit := omit;

    testcase TC() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.receive(mw_omit) { // error: omit used as a whole in a receiving operation
                setverdict(fail);
            }
            [] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
