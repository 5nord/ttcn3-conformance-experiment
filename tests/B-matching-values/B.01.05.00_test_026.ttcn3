// @requirement: B.1.5.0 -- Metacharacter: \s; Description: Match any one of the following control characters defined in ISO/IEC 10646 [2]: CHARACTER TABULATION (0009), LINE FEED (000A), LINE TABULATION (000B), FORM FEED (000C), CARRIAGE RETURN (000D), all space characters defined in clause 17.2 of ISO/IEC 10646 [2] and SP(32) defined in Recommendation ITU-T T.50 [4] (jointly called white-space characters)
// @id: TTCN3-CORE-B.1.5.0-029a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_test_026 {

    type component C {}

    template charstring mw_space := pattern "\s";

    testcase TC() runs on C {
        var boolean v_ok := match(" ", mw_space) and not match("s", mw_space) and
            not match("ab", mw_space);
        for (var integer i := 9; i <= 13; i := i + 1) {
            if (not match(int2char(i), mw_space)) {
                v_ok := false;
            }
        }
        if (v_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
