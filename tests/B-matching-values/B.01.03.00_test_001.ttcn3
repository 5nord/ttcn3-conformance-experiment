// @requirement: B.1.3.0 -- The following matching mechanisms may be used inside explicit values of strings, records of, sets of, arrays or maps.
// @id: TTCN3-CORE-B.1.3.0-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_00_test_001 {

    type record of integer RoI;
    type set of integer SoI;
    type integer A3[3];
    type map from charstring to integer TMap;

    type component C {}

    template bitstring mw_bits := '1?0*'B;
    template RoI mw_roi := {1, ?, *};
    template SoI mw_soi := {1, ?, *};
    template A3 mw_arr := {1, ?, ?};
    template TMap mw_map := { *, ["a"] := 1 };

    testcase TC() runs on C {
        var TMap v_map := { ["a"] := 1, ["b"] := 2 };
        if (match('1101'B, mw_bits) and
            match({1, 2, 3, 4}, mw_roi) and
            match({4, 3, 1}, mw_soi) and
            match({1, 2, 3}, mw_arr) and
            match(v_map, mw_map)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
