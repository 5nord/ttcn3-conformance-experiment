// @requirement: B.1.5.0 -- In addition to literal characters,` character patterns allow the use of meta-characters (e.g. ? and * within a character pattern means matching any character and any number of any character respectively).
// @id: TTCN3-CORE-B.1.5.0-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_test_003 {

    type component C {}

    template charstring mw_pattern := pattern "ab?d*z";

    testcase TC() runs on C {
        if (match("abcdz", mw_pattern) and match("abXdlmnoz", mw_pattern) and
            not match("abdz", mw_pattern)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
