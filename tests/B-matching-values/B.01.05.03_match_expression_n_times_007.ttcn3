// @requirement: B.1.5.3 -- In the form "#n" n shall be a single digit.
// @id: TTCN3-CORE-B.1.5.3-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_03_match_expression_n_times_007 {

    type component C {}

    testcase TC() runs on C {
        template charstring m_p := pattern "a#12";
        if (match("a2", m_p) and not match("aaaaaaaaaaaa", m_p)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
