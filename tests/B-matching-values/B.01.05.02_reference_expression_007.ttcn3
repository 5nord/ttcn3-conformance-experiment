// @requirement: B.1.5.2 -- If the backslash character is present, the referenced item shall contain a character string value in this case.
// @id: TTCN3-CORE-B.1.5.2-006a
// @verdict: pass reject
module M_B_01_05_02_reference_expression_007 {

    type component C {}

    template charstring m_pat := pattern "a?c";

    template charstring mw_ref := pattern "x{\m_pat}"; // error: referenced template is a pattern, not a value

    testcase TC() runs on C {
        if (match("xabc", mw_ref)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
