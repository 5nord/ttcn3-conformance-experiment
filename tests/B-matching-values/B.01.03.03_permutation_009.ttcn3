// @requirement: B.1.3.3 -- NOTE 2: When AnyElementsOrNone is inside a permutation, a length attribute may be applied to _AnyElementsOrNone to restrict the number of elements matched by AnyElementsOrNone (see also_ clause B.1.4.1).
// @id: TTCN3-CORE-B.1.3.3-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_03_permutation_009 {

    type record of integer RoI;

    type component C {}

    template RoI mw_roi := {permutation(1, 2, * length(1))};

    testcase TC() runs on C {
        var RoI v_ok := {1, 3, 2};
        var RoI v_none := {1, 2};
        var RoI v_two := {1, 3, 4, 2};
        if (match(v_ok, mw_roi) and not match(v_none, mw_roi) and not match(v_two, mw_roi)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
