// @requirement: B.1.5.1 -- An empty list and an empty negated list are not allowed.
// @id: TTCN3-CORE-B.1.5.1-019b
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_01_set_expression_013 {

    type component C {}

    template charstring mw_set := pattern "[^]a]";

    testcase TC() runs on C {
        // "[^]" does not form an empty negated list: "^" and "]" are list members
        if (match("^", mw_set) and match("]", mw_set) and match("a", mw_set)
            and not match("b", mw_set) and not match("a]", mw_set)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
