// @requirement: B.1.5.1 -- Therefore a closing square bracket "]" immediately following an opening square bracket "[" or a caret following the opening square bracket "[" and immediately followed by a closing square bracket "]" shall be processed as literal characters.
// @id: TTCN3-CORE-B.1.5.1-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_01_test_014 {

    type component C {}

    template charstring mw_set := pattern "[]b]x";

    testcase TC() runs on C {
        if (match("]x", mw_set) and match("bx", mw_set)
            and not match("x", mw_set) and not match("b]x", mw_set)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
