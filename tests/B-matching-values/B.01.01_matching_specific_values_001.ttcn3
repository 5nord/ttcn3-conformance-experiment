// @requirement: B.1.1 -- Unless otherwise specified, a template field matches the corresponding field value if, and only if, the field value has exactly the same value as the value to which the expression in the template evaluates.
// @id: TTCN3-CORE-B.1.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_01_matching_specific_values_001 {

    type component C {}

    type record R {
        integer f1,
        charstring f2
    }

    template R m_r := {
        f1 := 3 + 2,
        f2 := "My string"
    }

    testcase TC() runs on C {
        var R v_same := { f1 := 5, f2 := "My string" };
        var R v_diff1 := { f1 := 6, f2 := "My string" };
        var R v_diff2 := { f1 := 5, f2 := "My string " };
        if (match(v_same, m_r) and not match(v_diff1, m_r) and not match(v_diff2, m_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
