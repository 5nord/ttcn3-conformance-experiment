// @requirement: B.1.2.5 -- A template field that uses a range matches the corresponding field if, and only if, the field value is equal to one of the values in the range.
// @id: TTCN3-CORE-B.1.2.5-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_05_test_001 {

    type component C {}

    type record R {
        integer f1,
        float f2
    }

    template R mw_r := {
        f1 := (1 .. !6),
        f2 := (-infinity .. 2.5)
    }

    testcase TC() runs on C {
        var R v_low := { f1 := 1, f2 := -1000.0 };
        var R v_high := { f1 := 5, f2 := 2.5 };
        var R v_n1 := { f1 := 0, f2 := 0.0 };
        var R v_n2 := { f1 := 6, f2 := 0.0 };
        var R v_n3 := { f1 := 3, f2 := 2.6 };
        if (match(v_low, mw_r) and match(v_high, mw_r)
            and not match(v_n1, mw_r) and not match(v_n2, mw_r) and not match(v_n3, mw_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
