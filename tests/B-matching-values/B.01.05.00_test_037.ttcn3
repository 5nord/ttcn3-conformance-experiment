// @requirement: B.1.5.0 -- When any of the metacharacter symbols are present in a pattern, but do not form a valid metacharacter, they retain their literal value.
// @id: TTCN3-CORE-B.1.5.0-051a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_test_037 {

    type component C {}

    template charstring mw_hash := pattern "a#b";
    template charstring mw_minus := pattern "a-b";
    template charstring mw_caret := pattern "a^b";
    template charstring mw_rbracket := pattern "a]b";
    template charstring mw_rbrace := pattern "a}b";

    testcase TC() runs on C {
        if (match("a#b", mw_hash) and
            match("a-b", mw_minus) and
            match("a^b", mw_caret) and
            match("a]b", mw_rbracket) and
            match("a}b", mw_rbrace)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
