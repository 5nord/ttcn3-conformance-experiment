// @requirement: B.1.2.6 -- The successful match shall be produced only if there exists such a one-to-one mapping from the SuperSet elements to the elements of the set of values where each SuperSet element matches the element of set of values it is mapped to.
// @id: TTCN3-CORE-B.1.2.6-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_06_superset_003 {

    type component C {}

    type set of integer SoI;

    template SoI mw_twoOnes := superset (1, 1);
    template SoI mw_oneAndAny := superset (?, 1);

    testcase TC() runs on C {
        var SoI v_oneOne := { 1 };
        var SoI v_twoOnes := { 1, 1 };
        var SoI v_oneTwo := { 2, 1 };
        if (not match(v_oneOne, mw_twoOnes) and match(v_twoOnes, mw_twoOnes)
            and not match(v_oneOne, mw_oneAndAny) and match(v_oneTwo, mw_oneAndAny)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
