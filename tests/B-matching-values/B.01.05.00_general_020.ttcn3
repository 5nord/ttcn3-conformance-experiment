// @requirement: B.1.5.0 -- Metacharacter: \N{reference}; Indexing: Including the reference; Description: Matches a single character from the (sub)set of characters denoted; see clause B.1.5.4 for more details
// @id: TTCN3-CORE-B.1.5.0-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_general_020 {

    type component C {}

    type charstring MyCharRange ("a".."f");

    const charstring c_char := "r";

    template charstring mw_value := pattern "\N{c_char}";
    template charstring mw_type := pattern "\N{MyCharRange}";

    testcase TC() runs on C {
        if (match("r", mw_value) and
            not match("s", mw_value) and
            match("c", mw_type) and
            not match("g", mw_type) and
            not match("ab", mw_type)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
