// @requirement: B.1.5.1 -- Metacharacter: #(n, m); Indexing: Including the preceding expression; Description: Match the preceding expression at least n times but no more than m times (postfix). See clause B.1.5.3 for more details
// @id: TTCN3-CORE-B.1.5.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_01_test_009 {

    type component C {}

    template charstring mw_rep := pattern "[ab]#(2,3)";

    testcase TC() runs on C {
        if (match("ab", mw_rep) and match("bba", mw_rep)
            and not match("a", mw_rep) and not match("abab", mw_rep)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
