// @requirement: B.1.5.0 -- Metacharacter: \b; Description: Match a word boundary (any graphical character except SP or DEL is preceded or followed by any of the whitespace or newline characters)
// @id: TTCN3-CORE-B.1.5.0-030a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_test_027 {

    type component C {}

    template charstring mw_boundary := pattern "ab\b cd";
    template charstring mw_noBoundary := pattern "a\bb";

    testcase TC() runs on C {
        if (match("ab cd", mw_boundary) and
            not match("ab", mw_noBoundary)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
