// @requirement: B.1.2.4 -- A record or set template field that uses this symbol matches the corresponding field if, and only if, either the field evaluates to any element of the specified type, or if the field is absent.
// @id: TTCN3-CORE-B.1.2.4-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_04_test_003 {

    type component C {}

    type record of integer RoI;

    type record R {
        integer f1,
        RoI f2 optional
    }

    type set S {
        integer f1,
        integer f2 optional
    }

    template R mw_r := { f1 := 1, f2 := * };
    template S mw_s := { f1 := 1, f2 := * };

    testcase TC() runs on C {
        var R v_r1 := { f1 := 1, f2 := { 1, 2 } };
        var R v_r2 := { f1 := 1, f2 := omit };
        var S v_s1 := { f1 := 1, f2 := 5 };
        var S v_s2 := { f1 := 1, f2 := omit };
        if (match(v_r1, mw_r) and match(v_r2, mw_r) and match(v_s1, mw_s) and match(v_s2, mw_s)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
