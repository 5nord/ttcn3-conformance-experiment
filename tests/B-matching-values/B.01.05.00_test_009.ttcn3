// @requirement: B.1.5.0 -- Metacharacter: *; Description: Match any character zero or more times; shall match the longest possible number of characters (see example 1 above) (see notes 1 and 2)
// @id: TTCN3-CORE-B.1.5.0-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_test_009 {

    type component C {}

    template charstring mw_pattern := pattern "a*c";

    testcase TC() runs on C {
        if (match("ac", mw_pattern) and
            match("abc", mw_pattern) and
            match("abxyzc", mw_pattern) and
            not match("ab", mw_pattern)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
