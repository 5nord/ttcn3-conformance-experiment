module M_B_01_02_05_value_range_005 {

    type component C {}

    template universal charstring mw_range := (char(0, 0, 3, 162) .. char(0, 0, 3, 169)); // error: U+03A2 is an empty position

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
