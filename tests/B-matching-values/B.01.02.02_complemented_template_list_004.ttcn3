// @requirement: B.1.2.2 -- The template list may be a single value, of course.
// @id: TTCN3-CORE-B.1.2.2-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_02_complemented_template_list_004 {

    type component C {}

    template integer mw_c := complement(5);

    testcase TC() runs on C {
        if (match(4, mw_c) and not match(5, mw_c)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
