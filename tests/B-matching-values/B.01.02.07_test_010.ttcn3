// @requirement: B.1.2.7 -- c) The member type of the set of type associated with the SubSet and the member type of the template in the allfrom clause shall be compatible.
// @id: TTCN3-CORE-B.1.2.7-009a
// @verdict: pass reject
module M_B_01_02_07_test_010 {

    type component C {}

    type record of boolean RoB;
    type set of integer SoI;

    template RoB m_roB := { true, false };
    template SoI mw_subset := subset (all from m_roB); // error: boolean members not compatible with integer
}
