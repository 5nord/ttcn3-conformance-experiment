// @requirement: B.1.5.0 -- The fragments of the pattern shall be concatenated before any evaluation of the pattern expression.
// @id: TTCN3-CORE-B.1.5.0-055a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_general_041 {

    type component C {}

    const charstring c_myConst := "ab";

    template charstring mw_joined := pattern "{c_my" & "Const}";

    testcase TC() runs on C {
        if (match("ab", mw_joined) and
            not match("{c_myConst}", mw_joined)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
