// @requirement: B.1.5.0 -- Pattern definitions may contain references to values or templates.
// @id: TTCN3-CORE-B.1.5.0-059a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_general_042 {

    type component C {}

    const charstring c_value := "ab?";

    template charstring mw_template2 := pattern "?xyz*0";

    template charstring mw_value := pattern c_value & mw_template2;
    template charstring mw_braces := pattern "{c_value}{mw_template2}";

    testcase TC() runs on C {
        if (match("ab12xyz0", mw_value) and
            not match("ab1xyz0", mw_value) and
            match("ab12xyz0", mw_braces) and
            not match("ab1xyz0", mw_braces)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
