// @requirement: B.1.2.1 -- Each value or template in the template list shall be of the type declared for the template field in which this mechanism is used. d) Each value or template in the template list shall be of the type declared for the template field in which this mechanism is used.
// @id: TTCN3-CORE-B.1.2.1-006a
// @verdict: pass reject
module M_B_01_02_01_template_list_006 {

    type component C {}

    type record R {
        integer f1
    }

    template R mw_r := {
        f1 := (1, "two", 3) // error: charstring value in integer template list
    }

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
