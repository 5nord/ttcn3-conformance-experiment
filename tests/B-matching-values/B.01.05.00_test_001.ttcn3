// @requirement: B.1.5.0 -- Character patterns can be used in templates to define the format of a required character string to be received.
// @id: TTCN3-CORE-B.1.5.0-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_test_001 {

    type port P message {
        inout charstring
    }

    type component C {
        port P p;
    }

    template charstring mw_pattern := pattern "ab??xyz*0";

    function f_send() runs on C {
        p.send(charstring:"ab12xyz340");
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.receive(mw_pattern) {
                setverdict(pass);
            }
            [] p.receive {
                setverdict(fail);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
