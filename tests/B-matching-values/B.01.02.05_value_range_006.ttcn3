// @requirement: B.1.2.5 -- d) Empty positions between the lower and the upper boundaries are not considered to be valid values of the specified range.
// @id: TTCN3-CORE-B.1.2.5-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_05_value_range_006 {

    type component C {}

    template universal charstring mw_range := (char(0, 0, 3, 161) .. char(0, 0, 3, 163));

    testcase TC() runs on C {
        if (match(char(0, 0, 3, 161), mw_range) and match(char(0, 0, 3, 163), mw_range)
            and not match(char(0, 0, 3, 162), mw_range)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
