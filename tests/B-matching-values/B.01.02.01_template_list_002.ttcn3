// @requirement: B.1.2.1 -- A template list may contain values, templates obeying the template (present) restriction (see clause 15.8), and members added by all from clauses.
// @id: TTCN3-CORE-B.1.2.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_02_01_template_list_002 {

    type component C {}

    type record of integer RoI;

    template RoI mw_roI := { 20, 30 };
    template(present) integer mw_range := (6 .. 9);
    template integer mw_list := (1, mw_range, all from mw_roI);

    testcase TC() runs on C {
        if (match(1, mw_list) and match(7, mw_list) and match(30, mw_list)
            and not match(5, mw_list)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
