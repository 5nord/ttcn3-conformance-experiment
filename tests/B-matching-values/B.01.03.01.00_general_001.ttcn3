// @requirement: B.1.3.1.0 -- The matching symbol "?" (AnyElement) is used to indicate that it replaces single elements of a string (except character strings, see table 4 for the lengths of the units being matched by "?" in a string), a record of, a set of or an array.
// @id: TTCN3-CORE-B.1.3.1.0-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_01_00_general_001 {

    type record of integer RoI;
    type set of integer SoI;
    type integer A3[3];

    type component C {}

    template bitstring mw_bits := '10???'B;
    template RoI mw_roi := {1, ?, 3};
    template SoI mw_soi := {1, ?, 3};
    template A3 mw_arr := {1, ?, 3};

    testcase TC() runs on C {
        var A3 v_arr := {1, 9, 3};
        if (match('10011'B, mw_bits) and not match('1001'B, mw_bits) and
            not match('100110'B, mw_bits) and
            match({1, 7, 3}, mw_roi) and not match({1, 3}, mw_roi) and
            not match({1, 7, 8, 3}, mw_roi) and
            match({3, 7, 1}, mw_soi) and not match({1, 3}, mw_soi) and
            match(v_arr, mw_arr)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
