// @requirement: B.1.3.3 -- The permutation matching is successful, if a subset of the elements in the record of matches the permutation list without the AnyElementsOrNone.
// @id: TTCN3-CORE-B.1.3.3-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_03_permutation_005 {

    type record of integer RoI;

    type component C {}

    template RoI mw_roi := {permutation(1, 2, *)};

    testcase TC() runs on C {
        var RoI v_ok := {7, 2, 8, 1};
        var RoI v_no2 := {7, 8, 1};
        var RoI v_no1 := {2, 2, 2};
        if (match(v_ok, mw_roi) and not match(v_no2, mw_roi) and not match(v_no1, mw_roi)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
