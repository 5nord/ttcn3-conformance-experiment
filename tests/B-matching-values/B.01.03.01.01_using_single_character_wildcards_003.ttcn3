// @requirement: B.1.3.1.1 -- However, "abcxyz", "abcdefxyz", etc. will not.
// @id: TTCN3-CORE-B.1.3.1.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_01_01_using_single_character_wildcards_003 {

    type component C {}

    template charstring mw_pattern := pattern "abc?xyz";

    testcase TC() runs on C {
        if (not match("abcxyz", mw_pattern) and not match("abcdefxyz", mw_pattern)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
