// @requirement: B.1.5.1 -- The set expression is delimited by the "[" "]" symbols.
// @id: TTCN3-CORE-B.1.5.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_01_set_expression_002 {

    type component C {}

    template charstring mw_set := pattern "x[ab]y";

    testcase TC() runs on C {
        if (match("xay", mw_set) and match("xby", mw_set)
            and not match("xaby", mw_set) and not match("x[ab]y", mw_set)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
