// @requirement: B.1.4.2 -- A map template key that uses the ifpresent indicator in the value associated with it matches the corresponding key if, and only if, either the corresponding key is present and its value matches according to the associated matching mechanism, or if the corresponding key is absent.
// @id: TTCN3-CORE-B.1.4.2-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_04_02_the_ifpresent_indicator_002 {

    type component C {}

    type map from charstring to charstring MyMap;

    template MyMap mw_map := { ["host"] := "::1", ["port"] := "80" ifpresent };

    testcase TC() runs on C {
        var MyMap v_present := { ["host"] := "::1", ["port"] := "80" };
        var MyMap v_absent := { ["host"] := "::1" };
        var MyMap v_wrong := { ["host"] := "::1", ["port"] := "443" };
        if (match(v_present, mw_map) and match(v_absent, mw_map) and not match(v_wrong, mw_map)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
