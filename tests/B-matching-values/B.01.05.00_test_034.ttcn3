// @requirement: B.1.5.0 -- Therefore received values not complying with the subtype specification of the template or template field are never provided for matching.
// @id: TTCN3-CORE-B.1.5.0-044a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_05_00_test_034 {

    type charstring Abc ("a".."c");

    type port P message {
        inout charstring
    }

    type component C {
        port P p;
    }

    template Abc mw_any := pattern "*";

    function f_send() runs on C {
        p.send(charstring:"xyz");
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.receive(mw_any) {
                setverdict(fail);
            }
            [] p.receive(charstring:?) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
