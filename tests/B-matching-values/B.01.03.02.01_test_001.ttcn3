// @requirement: B.1.3.2.1 -- If it is required to expressed the "*" wildcard in character strings it shall be done using character patterns (see clause B.1.5).
// @id: TTCN3-CORE-B.1.3.2.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_02_01_test_001 {

    type component C {}

    template charstring mw_literal := "abc*xyz";
    template charstring mw_pattern := pattern "abc*xyz";

    testcase TC() runs on C {
        if (not match("abcdefxyz", mw_literal) and match("abc*xyz", mw_literal) and
            match("abcdefxyz", mw_pattern)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
