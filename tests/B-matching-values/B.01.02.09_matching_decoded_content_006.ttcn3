// @verdict: pass reject
module M_B_01_02_09_matching_decoded_content_006 {

    type component C {}

    type integer Payload with { encode "JSON" }

    type record Msg {
        integer id,
        integer payload
    }

    template Msg mw_msg := { id := ?, payload := decmatch Payload:? }; // error: decmatch assigned to an integer field
