// @requirement: B.1.3.3 -- Besides specifying all individual values, it is possible to add all elements of a record of or set of template into permutations using an all from clause.
// @id: TTCN3-CORE-B.1.3.3-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_03_03_test_010 {

    type record of integer RoI;

    type component C {}

    template RoI mw_roi1 := {1, 2, *};
    template RoI mw_roi2 := {permutation(0, all from mw_roi1), 4, 5};

    testcase TC() runs on C {
        var RoI v_ok := {2, 0, 9, 1, 4, 5};
        var RoI v_no := {2, 9, 1, 4, 5};
        if (match(v_ok, mw_roi2) and not match(v_no, mw_roi2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
