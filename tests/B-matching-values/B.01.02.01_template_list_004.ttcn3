// @requirement: B.1.2.1 -- An all from clause comprises all elements of an existing record of or set of template into the template list.
// @id: TTCN3-CORE-B.1.2.1-004b
// @verdict: pass reject
module M_B_01_02_01_template_list_004 {

    type component C {}

    template integer mw_single := 5;
    template integer mw_list := (all from mw_single, 100); // error: not a record of or set of template

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
