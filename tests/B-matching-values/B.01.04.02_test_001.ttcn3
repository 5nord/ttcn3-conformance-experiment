// @requirement: B.1.4.2 -- A template field of a record or set type that uses ifpresent matches the corresponding field if, and only if, the field matches according to the associated matching mechanism, or if the field is absent.
// @id: TTCN3-CORE-B.1.4.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_B_01_04_02_test_001 {

    type component C {}

    type record R {
        integer f1,
        integer f2 optional
    }

    type set S {
        integer f1,
        integer f2 optional
    }

    template R mw_rec := { f1 := ?, f2 := 5 ifpresent };
    template S mw_set := { f1 := ?, f2 := 5 ifpresent };

    testcase TC() runs on C {
        var R v_r1 := { f1 := 1, f2 := 5 };
        var R v_r2 := { f1 := 1, f2 := omit };
        var R v_r3 := { f1 := 1, f2 := 6 };
        var S v_s1 := { f1 := 1, f2 := 5 };
        var S v_s2 := { f1 := 1, f2 := omit };
        var S v_s3 := { f1 := 1, f2 := 6 };
        if (match(v_r1, mw_rec) and match(v_r2, mw_rec) and not match(v_r3, mw_rec) and
            match(v_s1, mw_set) and match(v_s2, mw_set) and not match(v_s3, mw_set)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
