// @requirement: 24.1 -- Operation: stop; Col3: yes; Example: all timer.stop
// @id: TTCN3-CORE-24.1-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_24_01_test_007 {

    type component C {}

    testcase TC() runs on C {
        timer T1 := 5.0;
        timer T2 := 5.0;
        T1.start;
        T2.start;
        all timer.stop;
        if (not T1.running and not T2.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
