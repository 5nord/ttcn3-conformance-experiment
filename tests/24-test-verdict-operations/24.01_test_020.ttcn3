// @requirement: 24.1 -- Table 30: Overwriting rules for the verdict (rows: current value None/Pass/Inconc/Fail; columns: new verdict assignment value pass/inconc/fail/none) Pass: pass inconc fail pass
// @id: TTCN3-CORE-24.1-032b
// @verdict: pass accept, ttcn3verdict:pass
module M_24_01_test_020 {

    type component C {}

    testcase TC_set(verdicttype p_new, verdicttype p_exp) runs on C {
        setverdict(pass);
        setverdict(p_new);
        if (getverdict != p_exp) {
            testcase.stop("unexpected local verdict");
        }
    }

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var boolean v_ok := true;
        v_ok := v_ok and execute(TC_set(pass, pass)) == pass;
        v_ok := v_ok and execute(TC_set(inconc, inconc)) == inconc;
        v_ok := v_ok and execute(TC_set(fail, fail)) == fail;
        v_ok := v_ok and execute(TC_set(none, pass)) == pass;
        execute(TC(v_ok));
    }
}
