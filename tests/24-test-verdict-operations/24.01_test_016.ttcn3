// @requirement: 24.1 -- When changing the value of the local verdict (i.e. using the setverdict operation) the effect of this change shall follow the overwriting rules listed in table 30.
// @id: TTCN3-CORE-24.1-028a
// @verdict: pass accept, ttcn3verdict:fail
module M_24_01_test_016 {

    type component C {}

    function f_set(verdicttype p_new, verdicttype p_exp) runs on C {
        setverdict(p_new);
        if (getverdict != p_exp) {
            testcase.stop("unexpected local verdict");
        }
    }

    testcase TC() runs on C {
        f_set(none, none);
        f_set(pass, pass);
        f_set(none, pass);
        f_set(pass, pass);
        f_set(inconc, inconc);
        f_set(pass, inconc);
        f_set(none, inconc);
        f_set(fail, fail);
        f_set(pass, fail);
        f_set(inconc, fail);
        f_set(none, fail);
    }

    control {
        execute(TC());
    }
}
