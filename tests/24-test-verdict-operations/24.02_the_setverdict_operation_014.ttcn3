// @requirement: 24.2 -- It shall not be used to assign the value error, this is set by the test system only to indicate runtime errors.
// @id: TTCN3-CORE-24.2-018a
// @verdict: pass reject
module M_24_02_the_setverdict_operation_014 {

    type component C {}

    testcase TC() runs on C {
        setverdict(error); // error: setverdict cannot assign error
    }

    control {
        execute(TC());
    }
}
