// @requirement: 24.3 -- The value of the local verdict may be retrieved using the getverdict operation.
// @id: TTCN3-CORE-24.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_24_03_the_getverdict_operation_001 {

    type component C {}

    testcase TC() runs on C {
        var verdicttype v_verdict;
        setverdict(pass);
        v_verdict := getverdict;
        if (v_verdict == pass) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
