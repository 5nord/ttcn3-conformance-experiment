// @requirement: 24.2 -- The effect of this change shall follow the overwriting rules listed in table 30.
// @id: TTCN3-CORE-24.2-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_24_02_test_004 {

    type component C {}

    testcase TC_set(verdicttype p_first, verdicttype p_second, verdicttype p_exp) runs on C {
        setverdict(p_first);
        setverdict(p_second);
        if (getverdict != p_exp) {
            testcase.stop("unexpected local verdict");
        }
    }

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var boolean v_ok := true;
        v_ok := v_ok and execute(TC_set(pass, fail, fail)) == fail;
        v_ok := v_ok and execute(TC_set(fail, pass, fail)) == fail;
        v_ok := v_ok and execute(TC_set(pass, none, pass)) == pass;
        v_ok := v_ok and execute(TC_set(inconc, pass, inconc)) == inconc;
        execute(TC(v_ok));
    }
}
