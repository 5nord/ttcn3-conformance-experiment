// @requirement: 24.2 -- Since the optional parameters can be seen as log information, the same rules and restrictions as for the parameters of the log statement (clause 19.11) apply.
// @id: TTCN3-CORE-24.2-012a
// @verdict: pass reject
module M_24_02_test_009 {

    type component C {}

    function f_noReturn() {
    }

    testcase TC() runs on C {
        setverdict(pass, "Result: ", f_noReturn()); // error: function without return clause cannot be logged
    }

    control {
        execute(TC());
    }
}
