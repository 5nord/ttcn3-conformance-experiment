// @requirement: 24.1 -- Operation: running; Allowed: yes; Example: if (any timer.running) {…}
// @id: TTCN3-CORE-24.1-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_24_01_the_verdict_mechanism_010 {

    type component C {}

    testcase TC() runs on C {
        timer T := 5.0;
        T.start;
        if (any timer.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        T.stop;
    }

    control {
        execute(TC());
    }
}
