// @requirement: 24.1 -- The implicit charstring variable shall have no effect on the overwriting rules and on the calculation of the final test case verdict.
// @id: TTCN3-CORE-24.1-038b
// @verdict: pass accept, ttcn3verdict:pass
module M_24_01_the_verdict_mechanism_027 {

    type component C {}

    function f_ptc() runs on C {
        setverdict(pass, "fail");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc());
        v_ptc.done;
        setverdict(pass, "error");
    }

    control {
        execute(TC());
    }
}
