// @requirement: 24.2 -- This information is composed to a string and stored in an implicit charstring variable.
// @id: TTCN3-CORE-24.2-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_24_02_test_006 {

    type component C {}

    template charstring m_str := pattern "abc*";

    testcase TC() runs on C {
        var integer v_myVar := 5;
        var float v_real := 1.5;
        setverdict(pass, "Value received: ", v_myVar, ", ", v_real, ", ", m_str);
    }

    control {
        execute(TC());
    }
}
