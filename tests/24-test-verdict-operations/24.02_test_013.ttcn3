// @requirement: 24.2 -- a) The setverdict operation shall only be used with the values pass, fail, inconc and none.
// @id: TTCN3-CORE-24.2-017a
// @verdict: pass reject
module M_24_02_test_013 {

    type component C {}

    const verdicttype c_verdict := error;

    testcase TC() runs on C {
        setverdict(c_verdict); // error: value error is not allowed in setverdict
    }

    control {
        execute(TC());
    }
}
