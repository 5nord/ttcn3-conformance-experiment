// @requirement: 24.1 -- The error verdict is special in that it is set by the test system to indicate that a test case (i.e. runtime) error has occurred.
// @id: TTCN3-CORE-24.1-033a
// @verdict: pass accept, ttcn3verdict:error
module M_24_01_test_023 {

    type component C {}

    testcase TC() runs on C {
        var integer v_zero := 0;
        var integer v_result;
        setverdict(pass);
        v_result := 1 / v_zero; // runtime error: division by zero
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
