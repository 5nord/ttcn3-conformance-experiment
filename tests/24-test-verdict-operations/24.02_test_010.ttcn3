// @requirement: 24.2 -- As the result of the setverdict operation, the implicit charstring variable is overwritten whenever the local verdict of a test component is overwritten (i.e. a new value, which is different to the previous one is assigned to it).
// @id: TTCN3-CORE-24.2-013a
// @verdict: pass accept, ttcn3verdict:fail
module M_24_02_test_010 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass, "Reason one");
        setverdict(fail, "Reason two");
        if (getverdict != fail) {
            testcase.stop("verdict not overwritten");
        }
    }

    control {
        execute(TC());
    }
}
