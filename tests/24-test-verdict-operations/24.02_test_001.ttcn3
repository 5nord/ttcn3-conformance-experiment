// @requirement: 24.2 -- The local verdict is set with the setverdict operation.
// @id: TTCN3-CORE-24.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_24_02_test_001 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
        if (getverdict != pass) {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
