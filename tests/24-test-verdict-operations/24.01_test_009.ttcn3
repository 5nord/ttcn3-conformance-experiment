// @requirement: 24.1 -- Operation: read (Table 28: neither any nor all allowed)
// @id: TTCN3-CORE-24.1-011a
// @verdict: pass reject
module M_24_01_test_009 {

    type component C {}

    testcase TC() runs on C {
        timer T := 5.0;
        T.start;
        var float v_elapsed := any timer.read; // error: any is not allowed with read
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
