// @requirement: 24.1 -- Operation: start (Table 28: neither any nor all allowed)
// @id: TTCN3-CORE-24.1-009a
// @verdict: pass reject
module M_24_01_test_006 {

    type component C {}

    testcase TC() runs on C {
