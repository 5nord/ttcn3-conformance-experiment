// @requirement: 24.1 -- The effect of this implicit operation shall also follow the overwriting rules listed in table 30.
// @id: TTCN3-CORE-24.1-030a
// @verdict: pass accept, ttcn3verdict:pass
module M_24_01_test_018 {

    type component C {}

    function f_ptc(verdicttype p_v) runs on C {
        setverdict(p_v);
    }

    testcase TC_run(verdicttype p_first, verdicttype p_second) runs on C {
        var C v_ptc1 := C.create;
        v_ptc1.start(f_ptc(p_first));
        v_ptc1.done;
        var C v_ptc2 := C.create;
        v_ptc2.start(f_ptc(p_second));
        v_ptc2.done;
    }

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var boolean v_ok := true;
        v_ok := v_ok and execute(TC_run(pass, none)) == pass;
        v_ok := v_ok and execute(TC_run(pass, inconc)) == inconc;
        v_ok := v_ok and execute(TC_run(inconc, pass)) == inconc;
        v_ok := v_ok and execute(TC_run(fail, pass)) == fail;
        v_ok := v_ok and execute(TC_run(fail, inconc)) == fail;
        v_ok := v_ok and execute(TC_run(none, none)) == none;
        execute(TC(v_ok));
    }
}
