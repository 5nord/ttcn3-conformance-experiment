// @requirement: 24.1 -- This means that an error verdict can only be a result of an execute test case operation.
// @id: TTCN3-CORE-24.1-036a
// @verdict: pass accept, ttcn3verdict:pass
module M_24_01_the_verdict_mechanism_025 {

    type component C {}

    testcase TC_error() runs on C {
        var integer v_zero := 0;
        var integer v_result;
        setverdict(pass);
        v_result := 1 / v_zero;
        if (getverdict == error) {
            setverdict(fail);
        }
    }

    testcase TC(verdicttype p_res) runs on C {
        if (p_res == error) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var verdicttype v_res := execute(TC_error());
        execute(TC(v_res));
    }
}
