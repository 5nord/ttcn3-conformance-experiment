// @requirement: 24.2 -- setverdict "(" SingleExpression { "," ( FreeText | TemplateInstance ) } ")"
// @id: TTCN3-CORE-24.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_24_02_the_setverdict_operation_002 {

    type component C {}

    template integer m_int := (1 .. 10);

    testcase TC() runs on C {
        var integer v_myVar := 5;
        var verdicttype v_verdict := pass;
        setverdict(pass);
        setverdict(v_verdict, "free text");
        setverdict(pass, "Value received: ", v_myVar);
        setverdict(pass, "Template: ", m_int, " value: ", v_myVar + 1, " end");
    }

    control {
        execute(TC());
    }
}
