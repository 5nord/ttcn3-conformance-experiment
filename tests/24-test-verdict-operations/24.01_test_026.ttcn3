// @requirement: 24.1 -- The implicit charstring variable shall have no effect on the overwriting rules and on the calculation of the final test case verdict.
// @id: TTCN3-CORE-24.1-038a
// @verdict: pass accept, ttcn3verdict:pass
module M_24_01_test_026 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass, "fail");
        setverdict(none, "fail");
        if (getverdict == pass) {
            setverdict(pass, "inconc");
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
