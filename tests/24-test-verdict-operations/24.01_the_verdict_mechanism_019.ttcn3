// @requirement: 24.1 -- Table 30: Overwriting rules for the verdict (rows: current value None/Pass/Inconc/Fail; columns: new verdict assignment value pass/inconc/fail/none) None: pass inconc fail none
// @id: TTCN3-CORE-24.1-032a
// @verdict: pass accept, ttcn3verdict:pass
module M_24_01_the_verdict_mechanism_019 {

    type component C {}

    testcase TC_set(verdicttype p_new, verdicttype p_exp) runs on C {
        if (getverdict != none) {
            testcase.stop("initial verdict is not none");
        }
        setverdict(p_new);
        if (getverdict != p_exp) {
            testcase.stop("unexpected local verdict");
        }
    }

    testcase TC(boolean p_ok) runs on C {
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var boolean v_ok := true;
        v_ok := v_ok and execute(TC_set(pass, pass)) == pass;
        v_ok := v_ok and execute(TC_set(inconc, inconc)) == inconc;
        v_ok := v_ok and execute(TC_set(fail, fail)) == fail;
        v_ok := v_ok and execute(TC_set(none, none)) == none;
        execute(TC(v_ok));
    }
}
