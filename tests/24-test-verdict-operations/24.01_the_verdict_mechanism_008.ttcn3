// @requirement: 24.1 -- Operation: stop; Col3: yes; Example: all timer.stop
// @id: TTCN3-CORE-24.1-010b
// @verdict: pass reject
module M_24_01_the_verdict_mechanism_008 {

    type component C {}

    testcase TC() runs on C {
        timer T := 5.0;
        T.start;
        any timer.stop; // error: any is not allowed with stop
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
