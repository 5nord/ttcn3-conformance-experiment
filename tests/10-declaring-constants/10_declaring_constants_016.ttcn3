// @requirement: 10 -- NOTE: The only value that can be assigned to global constants of default, component, port or timer type or component constants of default or component types is the special value null.
// @id: TTCN3-CORE-10-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_10_declaring_constants_016 {

    type component C {
        const default cc_def := null;
        const C cc_comp := null;
    }

    const default c_def := null;
    const C c_comp := null;

    testcase TC() runs on C {
        if (c_def == null and c_comp == null and cc_def == null and cc_comp == null) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
