// @requirement: 10 -- They can be used on the right hand side of assignments, in expressions, in actual parameters, and in template definitions.
// @id: TTCN3-CORE-10-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_10_test_002 {

    type component C {}

    type record R {
        integer f
    }

    const integer c_x := 2;

    template R m_r := { f := c_x };

    function f_double(integer p_x) return integer {
        return 2 * p_x;
    }

    testcase TC() runs on C {
        var integer v_a := c_x;
        var integer v_b := c_x + 1;
        var integer v_c := f_double(c_x);
        if (v_a == 2 and v_b == 3 and v_c == 4 and match({ f := 2 }, m_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
