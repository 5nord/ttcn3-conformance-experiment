// @requirement: 10 -- e) _ConstantExpression shall evaluate to a value which is type compatible with TypeOrNestedTypeDef._ f) If the TypeOrNestedTypeDef part is missing from the declaration, the ArrayDef part shall be missing as well and the assignment part (i.e. ":=" ConstantExpression) shall be present.
// @id: TTCN3-CORE-10-022b
// @verdict: pass reject
module M_10_declaring_constants_020 {

    type component C {}

    const c_x[2] := { 1, 2 }; // error: ArrayDef without TypeOrNestedTypeDef

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
