// @requirement: 10 -- Constants used within type definitions have to have values known at compile-time.
// @id: TTCN3-CORE-10-004a
// @verdict: pass reject
module M_10_declaring_constants_003 {

    type component C {}

    function f_max() return integer {
        return 10;
    }

    const integer c_max := f_max();

    type integer T (0 .. c_max); // error: c_max is not known at compile-time

    testcase TC() runs on C {
        var T v_t := 1;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
