// @requirement: 10 -- A value is assigned only once to a constant, at the place of its declaration.
// @id: TTCN3-CORE-10-007a
// @verdict: pass reject
module M_10_test_005 {

    type component C {}

    testcase TC() runs on C {
        const integer c_x; // error: no value assigned at the place of declaration
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
