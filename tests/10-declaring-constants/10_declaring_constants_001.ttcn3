// @requirement: 10 -- After value assignment, they do not change their value during test execution.
// @id: TTCN3-CORE-10-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_10_declaring_constants_001 {

    type component C {
        var integer vc_x := 1;
    }

    testcase TC() runs on C {
        const integer c_x := vc_x;
        vc_x := 5;
        if (c_x == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
