// @requirement: 10 -- The type of the constant is either provided explicitly or implicitly according to the rules for automatic typing specified in the clause 6.5.
// @id: TTCN3-CORE-10-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_10_test_009 {

    type component C {}

    testcase TC() runs on C {
        const integer c_explicit := 1;
        const c_implicit := 2;
        var integer v_sum := c_explicit + c_implicit;
        if (v_sum == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
