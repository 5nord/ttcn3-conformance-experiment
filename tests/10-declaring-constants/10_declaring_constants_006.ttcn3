// @requirement: 10 -- The constant does not change its value during test execution.
// @id: TTCN3-CORE-10-008a
// @verdict: pass reject
module M_10_declaring_constants_006 {

    type component C {}

    const integer c_x := 1;

    testcase TC() runs on C {
        c_x := 2; // error: assignment to a constant
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
