// @requirement: 27.9 -- Dependent on the language element preceding the dot, the encoding configuration is valid either for all sending and receiving operations of a single port (single port reference), sending and receiving operations of all ports of the current component (all `port notation) or for all codec functions and communication operations of` the current component (self keyword).
// @id: TTCN3-CORE-27.9-004c
// @verdict: pass accept, ttcn3verdict:pass
module M_27_09_test_006 {

    type record PDU {
        charstring source,
        integer data
    } with { encode "PduCodec1"; encode "PduCodec2" }

    type port P message {
        inout PDU;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template PDU m_msg := { source := "source address", data := 1 }

    testcase TC() runs on C {
        timer T_guard := 1.0;
        connect(self:p1, self:p2);
        self.setencode(PDU, "PduCodec2");
        p1.send(m_msg);
        T_guard.start;
        alt {
            [] p2.receive(m_msg) { setverdict(pass); }
            [] T_guard.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
