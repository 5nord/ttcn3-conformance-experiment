// @requirement: 27.1.2.0 -- The override directive overrides the specified attribute for all declarations at all lower scopes that do not also declare the specified attribute.
// @id: TTCN3-CORE-27.1.2.0-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_01_02_00_test_016 {

    type component C {}

    type record of universal charstring RUC;

    type integer MyIntRef with { encode "RuleRef" }

    group myGroup {
        type record MyRecordC {
            integer field1
        } with { encode override "RuleB" }
        type record MyRecordD {
            MyRecordC fieldC,
            MyIntRef fieldR,
            integer fieldI
        } with { encode override (fieldC) "RuleC" }
    } with { encode override "RuleA" }

    testcase TC() runs on C {
        var MyRecordD v_rec;
        var RUC v_c := v_rec.fieldC.encode;
        var RUC v_r := v_rec.fieldR.encode;
        var RUC v_i := v_rec.fieldI.encode;
        var RUC v_d := MyRecordD.encode;
        if (v_c == { "RuleC" } and v_r == { "RuleA" } and v_i == { "RuleA" } and
            v_d == { "RuleA" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
