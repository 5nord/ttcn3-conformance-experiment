// @requirement: 27.7 -- a) Data type, port type, procedure signature and import statements shall not have an optional attribute associated to them directly.
// @id: TTCN3-CORE-27.7-017a
// @verdict: pass reject
module M_27_07_optional_attributes_012 {

    type record R {
        integer a,
        boolean b optional
    } with { optional "implicit omit" } // error: optional attribute directly on a data type

}
