// @requirement: 27.5 -- g) "UTF-32BE" means, when applied to the universal charstring type, that the value shall be encoded and decoded according to the UCS Encoding scheme UTF-32BE as defined in clause 10.5 of ISO/IEC 10646 [2].
// @id: TTCN3-CORE-27.5-021a
// @verdict: pass accept, noexecution
module M_27_05_variant_attributes_016 {

    type universal charstring MyUtf32BeString with { variant "UTF-32BE" }

