// @requirement: 27.2 -- b) In case multiple attributes of the same type are allowed, all of them shall be without an additional modifier (override, @local) or the modifier shall be the same for all attributes.
// @id: TTCN3-CORE-27.2-012a
// @verdict: pass reject
module M_27_02_test_008 {

    type integer MyInt with {
        encode override "Codec1";
        encode "Codec2" // error: modifier differs from the other encode attribute
    }

}
