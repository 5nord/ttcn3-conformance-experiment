// @requirement: 27.2 -- with "{" { ( encode | variant | display | extension | optional ) [ override | @local ] ["(" DefinitionRef | FieldReference | AllRef ")"] [ ( FreeText | ("{" FreeText { "," FreeText } "}") ) "." ] FreeText [";"] } "}"
// @id: TTCN3-CORE-27.2-002a
// @verdict: pass accept, noexecution
module M_27_02_test_001 {

    type record R {
        integer a,
        integer b optional
    }
    with {
        encode "Codec1";
        encode "Codec2";
        variant "Codec1"."Rule1";
        variant {"Codec1", "Codec2"}."Rule2";
        variant (a) "Codec2"."Rule3";
        display "PDU";
        extension "MyExtension"
    }

    type integer MyInt with { encode @local "Codec3" }

    template R m_r := { a := 1 } with { optional "implicit omit" }

    group G {
        type integer MyInt2;
        const integer c_value := 1;
    }
    with {
        encode override (MyInt2) "Codec4";
        display (type all) "ASP";
        extension (const all) "MyConstExtension";
    }

}
