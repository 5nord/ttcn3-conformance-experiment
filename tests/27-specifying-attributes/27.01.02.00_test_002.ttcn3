// @requirement: 27.1.2.0 -- An attribute definition that is directly attached to a lower scope unit will override ... a type-specific attribute inherited from a type reference.
// @id: TTCN3-CORE-27.1.2.0-001b
// @verdict: pass accept, ttcn3verdict:pass
module M_27_01_02_00_test_002 {

    type component C {}

    type record of universal charstring RUC;

    type integer MyInt with { encode "RuleInt" }

    type record MyRec {
        MyInt field1
    } with { encode (field1) "RuleDirect" }

    testcase TC() runs on C {
        var MyRec v_rec;
        var RUC v_enc := v_rec.field1.encode;
        if (v_enc == { "RuleDirect" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
