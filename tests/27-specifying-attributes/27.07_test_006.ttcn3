// @requirement: 27.7 -- a) "implicit omit" means that all optional fields, that have no assigned value definition in the statement on which the attribute operates, are set to omit.
// @id: TTCN3-CORE-27.7-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_07_test_006 {

    type component C {}

    type record R {
        integer a,
        boolean b optional,
        charstring c optional
    }

    template R mw_r := { a := ?, b := true } with { optional "implicit omit" }

    testcase TC() runs on C {
        var R v_r := { a := 1, b := true } with { optional "implicit omit" }
        if (isbound(v_r.c) and not ispresent(v_r.c) and v_r.b == true
            and match({ a := 1, b := true, c := omit }, mw_r)
            and not match({ a := 1, b := true, c := "x" }, mw_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
