// @requirement: 27.5 -- d) "64 bit" and "unsigned 64 bit" mean, when applied to integer and enumerated types, that the integer value or the integer numbers associated with enumerated values shall be handled as it was represented on 64-bits (eight bytes) within the system.
// @id: TTCN3-CORE-27.5-012a
// @verdict: pass accept, noexecution
module M_27_05_test_008 {

    type integer MyInt64 (-9223372036854775808 .. 9223372036854775807) with { variant "64 bit" }
    type integer MyUInt64 (0 .. 18446744073709551615) with { variant "unsigned 64 bit" }
    type enumerated MyEnum64 { e_a(0), e_b(2147483647) } with { variant "64 bit" }
    type enumerated MyUEnum64 { e_a(0), e_b(2147483647) } with { variant "unsigned 64 bit" }

}
with { encode "MyCodec" }
