// @requirement: 27.8 -- If the attribute can occur multiple times (encode, variant, extension), the operation returns a record of universal charstring type.
// @id: TTCN3-CORE-27.8-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_08_retrieving_attribute_values_008 {

    type component C {}

    type record of universal charstring RUC;

    type integer MyInt with {
        encode "Codec1";
        encode "Codec2";
        variant "Codec1"."Rule1";
        variant "Codec1"."Rule2";
        extension "Ext1";
        extension "Ext2"
    }

    testcase TC() runs on C {
        var RUC v_encode := MyInt.encode;
        var RUC v_variant := MyInt.variant("Codec1");
        var RUC v_extension := MyInt.extension;
        if (v_encode == { "Codec1", "Codec2" } and v_variant == { "Rule1", "Rule2" }
            and v_extension == { "Ext1", "Ext2" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
