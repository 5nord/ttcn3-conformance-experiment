// @requirement: 27.1.2.0 -- Attributes from higher scope will still affect attributes in lower scopes even if the @local attribute is between them.
// @id: TTCN3-CORE-27.1.2.0-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_01_02_00_test_012 {

    type component C {}

    type record of universal charstring RUC;

    type record MyRec {
        integer field1
    } with { encode @local "CodecB" }

    testcase TC() runs on C {
        var MyRec v_rec;
        var RUC v_field := v_rec.field1.encode;
        if (v_field == { "CodecA" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
} with { encode "CodecA" }
