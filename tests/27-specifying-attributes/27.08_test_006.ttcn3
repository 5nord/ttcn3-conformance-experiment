// @requirement: 27.8 -- The return value of the operations for retrieving attribute values is of a universal charstring type in case of attributes that can be present only once (display, optional) .
// @id: TTCN3-CORE-27.8-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_08_test_006 {

    type component C {}

    type record R {
        integer a,
        boolean b optional
    } with { display "blue" }

    template R m_r := { a := 1 } with { optional "implicit omit" }

    testcase TC() runs on C {
        var universal charstring v_display := R.display;
        var universal charstring v_optional := m_r.optional;
        if (v_display == "blue" and v_optional == "implicit omit") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
