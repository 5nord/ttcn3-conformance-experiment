// @requirement: 27.5 -- The encoding related attributes are valid only when the related encoding is selected.
// @id: TTCN3-CORE-27.5-038a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_05_variant_attributes_025 {

    type component C {}

    type record of universal charstring RUC;

    type charstring Multi with {
        encode "Codec1"; variant "Codec1"."Rule1";
        encode "Codec2"; variant "Codec2"."Rule3"
    }

    testcase TC() runs on C {
        var RUC v_codec1 := Multi.variant("Codec1");
        var RUC v_codec2 := Multi.variant("Codec2");
        if (v_codec1 == { "Rule1" } and v_codec2 == { "Rule3" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
