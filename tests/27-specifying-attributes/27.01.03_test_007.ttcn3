// @requirement: 27.1.3 -- Thus, if the attributes of a local definition is to be changed via the import statement, the override directive needs to be used.
// @id: TTCN3-CORE-27.1.3-010a
// @verdict: pass accept, noexecution
module M_27_01_03_test_007 {

    import from M_27_01_03_test_007_A { type MyType } with { display override "PDU" }

    const MyType c_value := 1;

}

module M_27_01_03_test_007_A {

    type integer MyType with { display "ASP" }

}
