// @requirement: 27.6 -- The with statement may contain any number of extension attributes.
// @id: TTCN3-CORE-27.6-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_06_test_001 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    } with {
        extension "Ext1";
        extension "Ext2";
        extension "Ext3"
    }

    control {
        execute(TC());
    }
}
