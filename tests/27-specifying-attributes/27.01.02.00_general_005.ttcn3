// @requirement: 27.1.2.0 -- This shall also apply to the use of the with statement with groups.
// @id: TTCN3-CORE-27.1.2.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_01_02_00_general_005 {

    type component C {}

    group myPDUs {
        type record MyPDU1 {
            integer field1
        }
        group mySpecialPDUs {
            type record MyPDU3 {
                integer field1
            }
        } with { display "SpecialPDU" }
    } with { display "PDU" }

    testcase TC() runs on C {
        if (MyPDU1.display == "PDU" and MyPDU3.display == "SpecialPDU") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
