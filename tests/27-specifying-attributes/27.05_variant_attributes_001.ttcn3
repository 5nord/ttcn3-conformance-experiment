// @requirement: 27.5 -- In TTCN-3, general or particular encoding rules can be specified by using encode and variant attributes.
// @id: TTCN3-CORE-27.5-001a
// @verdict: pass accept, noexecution
module M_27_05_variant_attributes_001 {

    group myTypes {
        type integer MyInt with { variant "Variant1" }
        type charstring MyString;
    }
    with { encode "Rule1" }

}
