// @verdict: pass accept, noexecution
module M_27_01_01_test_002 {

    type record MyRec {
        integer field1,
        record {
            integer eField1,
            boolean eField2
        } field2
    } with { display (field2.eField1) "colour blue" }

    type record of integer MyRecOfInteger with { display ([-]) "colour green" }

    const MyRecOfInteger c_recOfInt := { 0, 1, 2, 3 } with { display ([0]) "colour blue" }
}
