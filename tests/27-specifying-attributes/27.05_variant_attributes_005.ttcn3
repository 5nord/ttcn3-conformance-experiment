// @requirement: 27.5 -- a) "8 bit" and "unsigned 8 bit" mean, when applied to integer and enumerated types, that the integer value or the integer numbers associated with enumerated values shall be handled as it was represented on 8-bits (single byte) within the system.
// @id: TTCN3-CORE-27.5-009a
// @verdict: pass accept, noexecution
module M_27_05_variant_attributes_005 {

    type integer MyInt8 (-128 .. 127) with { variant "8 bit" }
    type integer MyUInt8 (0 .. 255) with { variant "unsigned 8 bit" }
    type enumerated MyEnum8 { e_a(0), e_b(127) } with { variant "8 bit" }
    type enumerated MyUEnum8 { e_a(0), e_b(255) } with { variant "unsigned 8 bit" }

}
with { encode "MyCodec" }
