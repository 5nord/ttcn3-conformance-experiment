// @requirement: 27.1.2.1 -- a variant attribute overwrites a current variant attribute according to the rules defined in clause 27.1.2;
// @id: TTCN3-CORE-27.1.2.1-006a
// @verdict: pass accept, noexecution
module M_27_01_02_01_test_003 {

    group myVariants {
        type record MyPDU {
            integer field1,
            charstring field2
        }
        with { variant (field1) "Variant2" }
    }
    with { variant "Variant1" }

}
with { encode "Encoding1" }
