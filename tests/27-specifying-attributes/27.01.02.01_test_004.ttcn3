// @requirement: 27.1.2.1 -- an encoding attribute, which overwrites a current encoding attribute according to the rules defined in clause 27.1.2, also overwrites a corresponding current variant attribute
// @id: TTCN3-CORE-27.1.2.1-007a
// @verdict: pass accept, noexecution
module M_27_01_02_01_test_004 {

    group myVariants {
        type record MyPDU {
            integer field1,
            charstring field2
        }
        with { encode (field1) "Encoding2" }
    }
    with { variant "Variant1" }

}
with { encode "Encoding1" }
