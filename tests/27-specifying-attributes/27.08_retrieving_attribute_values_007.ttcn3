// @requirement: 27.8 -- If such an attribute is not defined, the operation returns an empty string.
// @id: TTCN3-CORE-27.8-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_08_retrieving_attribute_values_007 {

    type component C {}

    type integer MyInt;

    testcase TC() runs on C {
        var MyInt v_int := 1;
        if (MyInt.display == "" and v_int.display == "") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
