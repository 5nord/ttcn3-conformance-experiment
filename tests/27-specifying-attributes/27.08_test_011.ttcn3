// @requirement: 27.8 -- If no parameter is present, the operation returns only variants that are not bound to any particular encoding.
// @id: TTCN3-CORE-27.8-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_08_test_011 {

    type component C {}

    type record of universal charstring RUC;

    type integer MyInt1 with {
        encode "Codec1";
        variant "Rule0";
        variant "Codec1"."Rule1"
    }

    type integer MyInt2 with {
        encode "Codec1";
        encode "Codec2";
        variant "Codec1"."Rule1";
        variant "Codec2"."Rule2"
    }

    testcase TC() runs on C {
        var RUC v_variant1 := MyInt1.variant;
        var RUC v_variant2 := MyInt2.variant;
        if (v_variant1 == { "Rule0" } and v_variant2 == {}) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
