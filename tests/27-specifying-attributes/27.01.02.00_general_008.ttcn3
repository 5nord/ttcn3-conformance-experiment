// @requirement: 27.1.2.0 -- The attributes are applied to the fields or elements of synonym types only if the fields or elements have no valid attributes.
// @id: TTCN3-CORE-27.1.2.0-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_01_02_00_general_008 {

    type component C {}

    type record of universal charstring RUC;

    type record SourceType {
        integer field1,
        integer field2
    } with { encode (field1) "Rule1" }

    type SourceType SynonymType with { encode "Rule2" }

    testcase TC() runs on C {
        var SynonymType v_syn;
        var RUC v_field1 := v_syn.field1.encode;
        var RUC v_field2 := v_syn.field2.encode;
        if (v_field1 == { "Rule1" } and v_field2 == { "Rule2" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
