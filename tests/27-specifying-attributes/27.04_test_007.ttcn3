// @requirement: 27.4 -- d) field: encoding applies to a field in a record or set type or template.
// @id: TTCN3-CORE-27.4-012d
// @verdict: pass accept, noexecution
module M_27_04_test_007 {

    type record MyRecord {
        integer field1,
        boolean field2
    }
    with { encode (field1) "Rule3" }

    type set MySet {
        integer field1,
        boolean field2
    }
    with { encode (field2) "Rule3" }

    template MyRecord m_rec := { field1 := 1, field2 := true } with { encode (field2) "Rule4" }

}
with { encode "Rule1" }
