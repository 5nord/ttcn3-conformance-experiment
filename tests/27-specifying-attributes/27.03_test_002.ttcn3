// @requirement: 27.3 -- All TTCN-3 language elements can have display attributes to specify how particular language elements shall be displayed in, for example, a tabular format.
// @id: TTCN3-CORE-27.3-003a
// @verdict: pass accept, noexecution
module M_27_03_test_002 {

    type record R {
        integer a,
        integer b
    }
    with { display (a) "FieldA" }

    type port P message {
        inout R
    } with { display "MyPort" }

    signature S(in integer p_x) with { display "MySignature" }

    type component C {
        port P p;
    } with { display "MyComponent" }

    modulepar integer mp_value := 1 with { display "MyModulePar" }

    const integer c_value := 1 with { display "MyConst" }

    template R m_r := { a := 1, b := 2 } with { display "MyTemplate" }

    function f_test() {} with { display "MyFunction" }

    altstep a_test() runs on C {
        [] p.receive {}
    } with { display "MyAltstep" }

    testcase TC() runs on C {
        setverdict(pass);
    } with { display "MyTestcase" }

    group G {
        type integer MyInt;
    } with { display "MyGroup" }

    control {
        execute(TC());
    } with { display "MyControl" }

}
with { display "MyModule" }
