// @requirement: 27.1.3 -- In general, a language element is imported together with its attributes.
// @id: TTCN3-CORE-27.1.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_01_03_changing_attributes_of_imported_language_elements_001 {

    import from M_27_01_03_changing_attributes_of_imported_language_elements_001_A all;

    type component C {}

    testcase TC() runs on C {
        const R c_expected := { a := 1, b := omit };
        if (match(c_expected, m_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_27_01_03_changing_attributes_of_imported_language_elements_001_A {

    type record R {
        integer a,
        integer b optional
    }

    template R m_r := { a := 1 } with { optional "implicit omit" }

}
