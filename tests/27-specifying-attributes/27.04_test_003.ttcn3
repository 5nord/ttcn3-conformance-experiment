// @requirement: 27.4 -- The encode attribute allows the association of some referenced encoding rule or encoding directive to be made to a TTCN-3 definition.
// @id: TTCN3-CORE-27.4-007a
// @verdict: pass accept, noexecution
module M_27_04_test_003 {

    type record MyPDU {
        integer field1,
        boolean field2
    }
    with { encode "Rule1" }

    template MyPDU m_pdu := { field1 := 1, field2 := true } with { encode "Rule2" }

}
