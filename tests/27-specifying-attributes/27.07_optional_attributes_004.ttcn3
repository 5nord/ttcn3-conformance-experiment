// @requirement: 27.7 -- When an optional attribute is associated to a function, altstep, test case, control or component type definitions, it shall have effect on all the constants, module parameters, templates, variables and template variables declared within these definitions and not on the enframing definition itself.
// @id: TTCN3-CORE-27.7-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_07_optional_attributes_004 {

    type record R {
        integer a,
        boolean b optional
    }

    const R c_omitted := { a := 1, b := omit };

    type component C {
        var R vc_r := { a := 1 };
    } with { optional "implicit omit" }

    function f_check() return boolean {
        const R c_r := { a := 1 };
        template R m_r := { a := 1 };
        var R v_r := { a := 1 };
        var template R vt_r := { a := 1 };
        return c_r == c_omitted and match(c_omitted, m_r) and v_r == c_omitted
            and match(c_omitted, vt_r);
    } with { optional "implicit omit" }

    testcase TC() runs on C {
        if (vc_r == c_omitted and f_check()) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
