// @requirement: 27.8 -- If such an attribute is not present, the operation returns an empty record of value.
// @id: TTCN3-CORE-27.8-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_08_test_009 {

    type component C {}

    type record of universal charstring RUC;

    type integer MyInt;

    testcase TC() runs on C {
        var RUC v_encode := MyInt.encode;
        var RUC v_variant := MyInt.variant;
        var RUC v_extension := MyInt.extension;
        if (v_encode == {} and v_variant == {} and v_extension == {}) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
