// @requirement: 27.9 -- If the extended type reference is used, following calls of the setencode operation for the whole type or any element that contains the referenced payload field won't change the encoding that was dynamically configured for this field or element (and its sub-fields).
// @id: TTCN3-CORE-27.9-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_09_dynamic_configuration_of_encoding_used_by_ports_014 {

    type record Payload {
        integer data
    } with { encode "Codec1"; encode "Codec2" }

    type record PDU {
        charstring source,
        Payload payload
    } with { encode "Codec1"; encode "Codec2" }

    type port P message {
        inout PDU;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template PDU m_msg := { source := "source address", payload := { data := 1 } }

    testcase TC() runs on C {
        timer T_guard := 1.0;
        connect(self:p1, self:p2);
        p1.setencode(PDU.payload, "Codec2");
        p1.setencode(PDU, "Codec1");
        p1.send(m_msg);
        T_guard.start;
        alt {
            [] p2.receive(m_msg) { setverdict(pass); }
            [] T_guard.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
