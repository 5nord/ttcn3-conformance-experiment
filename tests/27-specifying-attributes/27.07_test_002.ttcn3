// @requirement: 27.7 -- TTCN-3 constants, module parameters, templates, variables and template variables can have an optional attribute.
// @id: TTCN3-CORE-27.7-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_07_test_002 {

    type component C {}

    type record R {
        integer a,
        boolean b optional
    }

    const R c_omitted := { a := 1, b := omit };

    modulepar R PX_R := { a := 1 } with { optional "implicit omit" }

    const R c_r := { a := 1 } with { optional "implicit omit" }

    template R m_r := { a := 1 } with { optional "implicit omit" }

    testcase TC() runs on C {
        var R v_r := { a := 1 } with { optional "implicit omit" }
        var template R vt_r := { a := 1 } with { optional "implicit omit" }
        if (PX_R == c_omitted and c_r == c_omitted and match(c_omitted, m_r)
            and v_r == c_omitted and match(c_omitted, vt_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
