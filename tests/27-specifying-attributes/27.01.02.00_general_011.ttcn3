// @requirement: 27.1.2.0 -- They do not affect definitions inside the associated language element as the @local attribute is completely transparent to lower scopes.
// @id: TTCN3-CORE-27.1.2.0-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_01_02_00_general_011 {

    type component C {}

    type record of universal charstring RUC;

    type record MyRec {
        integer field1
    } with { encode @local "CodecB" }

    testcase TC() runs on C {
        var MyRec v_rec;
        var RUC v_field := v_rec.field1.encode;
        if (v_field == {}) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
