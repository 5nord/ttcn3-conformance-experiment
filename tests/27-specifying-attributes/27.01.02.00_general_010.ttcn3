// @requirement: 27.1.2.0 -- but they are valid for the associated language element only.
// @id: TTCN3-CORE-27.1.2.0-016b
// @verdict: pass accept, ttcn3verdict:pass
module M_27_01_02_00_general_010 {

    type component C {}

    type record of universal charstring RUC;

    type record MyRec {
        integer field1
    } with { encode @local "CodecB" }

    testcase TC() runs on C {
        var MyRec v_rec;
        var RUC v_type := MyRec.encode;
        var RUC v_field := v_rec.field1.encode;
        if (v_type == { "CodecB" } and v_field != { "CodecB" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
} with { encode "CodecA" }
