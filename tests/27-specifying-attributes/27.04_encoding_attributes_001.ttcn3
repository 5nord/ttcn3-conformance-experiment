// @requirement: 27.4 -- In TTCN-3, general or particular encoding rules can be specified by using encode and variant attributes.
// @id: TTCN3-CORE-27.4-001a
// @verdict: pass accept, noexecution
module M_27_04_encoding_attributes_001 {

    type integer MyInt with { encode "Rule1"; variant "Variant1" }

    type record MyPDU {
        integer field1,
        boolean field2
    }
    with { variant (field1) "Variant2" }

}
with { encode "GlobalRule" }
