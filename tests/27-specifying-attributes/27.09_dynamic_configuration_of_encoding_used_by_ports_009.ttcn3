// @requirement: 27.9 -- After executing the operation, all other encode attributes and variants related to them are dynamically disabled and invisible to the codec.
// @id: TTCN3-CORE-27.9-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_09_dynamic_configuration_of_encoding_used_by_ports_009 {

    type record PDU {
        charstring source,
        integer data
    } with {
        encode "PduCodec1"; variant "PduCodec1"."Rule1";
        encode "PduCodec2"; variant "PduCodec2"."Rule2"
    }

    type port P message {
        inout PDU;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template PDU m_msg := { source := "source address", data := 1 }

    testcase TC() runs on C {
        timer T_guard := 1.0;
        connect(self:p1, self:p2);
        all port.setencode(PDU, "PduCodec1");
        p1.send(m_msg);
        T_guard.start;
        alt {
            [] p2.receive(m_msg) { setverdict(pass); }
            [] T_guard.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
