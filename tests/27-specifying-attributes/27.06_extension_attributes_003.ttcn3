// @requirement: 27.6 -- All TTCN-3 language elements can have extension attributes specified by the user.
// @id: TTCN3-CORE-27.6-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_06_extension_attributes_003 {

    import from M_27_06_extension_attributes_003_A all with { extension "Ext import" }

    type integer MyInt with { extension "Ext type" }

    type port P message {
        inout integer
    } with { extension "Ext port type" }

    type component C {
        var integer vc_int := 0 with { extension "Ext component variable" }
    } with { extension "Ext component type" }

    signature S(in integer p_par) with { extension "Ext signature" }

    modulepar integer PX_PAR := 1 with { extension "Ext module parameter" }

    const integer c_int := 1 with { extension "Ext constant" }

    template integer t_int := 1 with { extension "Ext template" }

    group g_group {
        const integer c_inGroup := 2;
    } with { extension "Ext group" }

    function f_func() return integer {
        var integer v_int := c_imported with { extension "Ext variable" }
        return v_int;
    } with { extension "Ext function" }

    altstep a_step() {
        [] any port.receive {}
    } with { extension "Ext altstep" }

    testcase TC() runs on C {
        if (f_func() == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    } with { extension "Ext test case" }

    control {
        execute(TC());
    } with { extension "Ext control" }
} with { extension "Ext module" }

module M_27_06_extension_attributes_003_A {

    const integer c_imported := 1;

}
