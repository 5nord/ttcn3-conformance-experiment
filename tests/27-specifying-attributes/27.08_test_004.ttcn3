// @requirement: 27.8 -- The value preceding the dot symbol may be unitialized.
// @id: TTCN3-CORE-27.8-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_08_test_004 {

    type component C {}

    type integer MyInt with { display "blue" }

    testcase TC() runs on C {
        var MyInt v_int;
        if (v_int.display == "blue") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
