// @requirement: 27.5 -- a) When dot notation is used in the variant attribute value for an element, the strings preceding the dot symbol shall resolve into one of the encode attribute values associated with the same element.
// @id: TTCN3-CORE-27.5-043a
// @verdict: pass reject
module M_27_05_variant_attributes_028 {

    type charstring Multi with {
        encode "Codec1"; variant "Codec1"."Rule1";
        encode "Codec2"; variant "Codec3"."Rule3" // error: "Codec3" is not an encode attribute of Multi
    }

}
