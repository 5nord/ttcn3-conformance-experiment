// @requirement: 27.8 -- a) The optional parameter of the operation shall be used only for getting variant attributes.
// @id: TTCN3-CORE-27.8-014a
// @verdict: pass reject
module M_27_08_test_013 {

    type component C {}

    type record of universal charstring RUC;

    type integer MyInt with {
        encode "Codec1";
        encode "Codec2"
    }

    testcase TC() runs on C {
        var RUC v_encode := MyInt.encode("Codec1"); // error: parameter used for an encode attribute
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
