// @requirement: 27.1.3 -- NOTE 2: If a with statement is added to an import of a definition where a local definition also has a with statement, the local definition's attributes overwrite the attributes added to the import statement in the normal way.
// @id: TTCN3-CORE-27.1.3-009a
// @verdict: pass accept, noexecution
module M_27_01_03_test_006 {

    import from M_27_01_03_test_006_A { type MyType } with { display "PDU" }

    const MyType c_value := 1;

}

module M_27_01_03_test_006_A {

    type integer MyType with { display "ASP" }

}
