// @requirement: 27.8 -- The attribute kind is denoted by the keyword following the dot symbol.
// @id: TTCN3-CORE-27.8-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_08_retrieving_attribute_values_005 {

    type component C {}

    type record of universal charstring RUC;

    type integer MyInt with {
        display "D";
        encode "E";
        variant "V";
        extension "X"
    }

    testcase TC() runs on C {
        var MyInt v_int := 1 with { optional "explicit omit" }
        var RUC v_encode := MyInt.encode;
        var RUC v_variant := MyInt.variant;
        var RUC v_extension := MyInt.extension;
        if (MyInt.display == "D" and v_encode == { "E" } and v_variant == { "V" }
            and v_extension == { "X" } and v_int.optional == "explicit omit") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
