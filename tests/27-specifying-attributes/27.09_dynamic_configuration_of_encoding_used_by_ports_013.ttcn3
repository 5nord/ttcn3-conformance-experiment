// @requirement: 27.9 -- It is allowed to reference a field or element of a type using an extended type reference in the setencode operation.
// @id: TTCN3-CORE-27.9-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_09_dynamic_configuration_of_encoding_used_by_ports_013 {

    type record Payload {
        integer data
    } with { encode "PayloadCodec1"; encode "PayloadCodec2" }

    type record of Payload PayloadList;

    type record PDU {
        charstring source,
        Payload payload,
        PayloadList list
    } with { encode "PduCodec1"; encode "PduCodec2" }

    type port P message {
        inout PDU;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template PDU m_msg := {
        source := "source address",
        payload := { data := 1 },
        list := { { data := 2 } }
    }

    testcase TC() runs on C {
        timer T_guard := 1.0;
        connect(self:p1, self:p2);
        all port.setencode(PDU.payload, "PayloadCodec2");
        all port.setencode(PDU.list[-], "PayloadCodec1");
        p1.send(m_msg);
        T_guard.start;
        alt {
            [] p2.receive(m_msg) { setverdict(pass); }
            [] T_guard.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
