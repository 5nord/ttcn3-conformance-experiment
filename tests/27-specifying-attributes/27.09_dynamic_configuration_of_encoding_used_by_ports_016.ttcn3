// @requirement: 27.9 -- b) The SingleExpression used in the second parameter of the setencode operation shall be compatible with the universal charstring type.
// @id: TTCN3-CORE-27.9-016a
// @verdict: pass reject
module M_27_09_dynamic_configuration_of_encoding_used_by_ports_016 {

    type record PDU {
        charstring source,
        integer data
    } with { encode "PduCodec1"; encode "PduCodec2" }

    type port P message {
        inout PDU;
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        p.setencode(PDU, 1); // error: second parameter is not compatible with universal charstring
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
