// @requirement: 27.3 -- a) At most one display attribute shall be applied to each definition, each individual field reference or language element to which a with statement is associated.
// @id: TTCN3-CORE-27.3-008a
// @verdict: pass reject
module M_27_03_display_attributes_003 {

    type record MyService {
        integer i,
        float f
    }
    with {
        display "ServiceCall";
        display "ServiceReply" // error: second display attribute for the same definition
    }

}
