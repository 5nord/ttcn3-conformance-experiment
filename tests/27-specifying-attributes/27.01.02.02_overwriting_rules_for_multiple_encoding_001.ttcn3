// @requirement: 27.1.2.2 -- Explicitly listed encode attributes that occur on the higher scope and are not overwritten will retain all variants related to them.
// @id: TTCN3-CORE-27.1.2.2-001a
// @verdict: pass accept, noexecution
module M_27_01_02_02_overwriting_rules_for_multiple_encoding_001 {

    type integer Int with {
        encode "CodecA"; variant "CodecA"."Rule1";
        encode "CodecB"; variant "CodecB"."Rule2";
    }

    type Int Int2 with {
        encode "CodecA";
        encode "CodecC"; variant "CodecC"."Rule6";
    }

}
