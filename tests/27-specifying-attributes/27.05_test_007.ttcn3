// @requirement: 27.5 -- c) "32 bit" and "unsigned 32 bit" mean, when applied to integer and enumerated types, that the integer value or the integer numbers associated with enumerated values shall be handled as it was represented on 32-bits (four bytes) within the system.
// @id: TTCN3-CORE-27.5-011a
// @verdict: pass accept, noexecution
module M_27_05_test_007 {

    type integer MyInt32 (-2147483648 .. 2147483647) with { variant "32 bit" }
    type integer MyUInt32 (0 .. 4294967295) with { variant "unsigned 32 bit" }
    type enumerated MyEnum32 { e_a(0), e_b(2147483647) } with { variant "32 bit" }
    type enumerated MyUEnum32 { e_a(0), e_b(65536) } with { variant "unsigned 32 bit" }

}
with { encode "MyCodec" }
