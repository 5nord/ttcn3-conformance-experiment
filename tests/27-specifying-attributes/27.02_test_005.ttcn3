module M_27_02_test_005 {

    group G1 {
        type integer MyInt;
    }

    group G2 {
        type charstring MyString;
    }

    template MyInt m_int1 := 1;
    template MyInt m_int2 := 2;
    const MyInt c_int := 3;

}
with {
    display (group all) "MyGroup";
    encode (template all) "Rule1";
    display (const all) "MyConst";
}
