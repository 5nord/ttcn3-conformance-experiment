// @requirement: 27.1.1 -- If the synonym type is a structured type, attributes in the with statement may reference fields or elements of this structured type.
// @id: TTCN3-CORE-27.1.1-005a
// @verdict: pass accept, noexecution
module M_27_01_01_test_008 {

    type record MyRec {
        integer field1,
        boolean field2
    }

    type record of integer MyRecOf;

    type MyRec MyRecSynonym with { display (field1) "colour blue" }

    type MyRecOf MyRecOfSynonym with { display ([-]) "colour green" }
}
