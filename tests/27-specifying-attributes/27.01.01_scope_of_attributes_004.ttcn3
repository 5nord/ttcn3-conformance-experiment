// @requirement: 27.1.1 -- It is also possible to associate attributes to a number of language elements by, e.g. listing fields of a structured type in an attribute statement associated with a single type definition
// @id: TTCN3-CORE-27.1.1-002a
// @verdict: pass accept, noexecution
module M_27_01_01_scope_of_attributes_004 {

    type record MyPDU {
        integer field1,
        boolean field2,
        charstring field3
    } with { display (field1, field2) "colour red" }
}
