// @requirement: 27.5 -- a) "IDL:fixed FORMAL/01-12-01 v.2.6" means, when applied to a record type, that the value shall be handled as an IDL fixed point decimal value (see annex E).
// @id: TTCN3-CORE-27.5-027a
// @verdict: pass accept, noexecution
module M_27_05_variant_attributes_018 {

    type integer UnsignedShort (0 .. 65535) with { variant "unsigned 16 bit" }
    type integer Short (-32768 .. 32767) with { variant "16 bit" }

    type record IDLfixed {
        UnsignedShort digits,
        Short scale,
        charstring value_
    }
    with { variant "IDL:fixed FORMAL/01-12-01 v.2.6" }

}
with { encode "MyCodec" }
