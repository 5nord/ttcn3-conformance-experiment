// @requirement: 27.5 -- e) "IEEE754 float","IEEE754 double", "IEEE754 extended float" and "IEEE754 extended double" mean, when applied to a float type, that the value shall be encoded and decoded according to the standard IEEE 754 [6] (see annex E).
// @id: TTCN3-CORE-27.5-013a
// @verdict: pass accept, noexecution
module M_27_05_variant_attributes_009 {

    type float MyFloat with { variant "IEEE754 float" }
    type float MyDouble with { variant "IEEE754 double" }
    type float MyExtFloat with { variant "IEEE754 extended float" }
    type float MyExtDouble with { variant "IEEE754 extended double" }

}
with { encode "MyCodec" }
