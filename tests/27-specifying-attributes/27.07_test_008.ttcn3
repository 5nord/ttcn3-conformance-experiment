// @requirement: 27.7 -- b) "explicit omit" means that all optional fields, that have no assigned value definition in the statement on which the attribute operates, are left undefined.
// @id: TTCN3-CORE-27.7-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_07_test_008 {

    type component C {}

    type record R {
        integer a,
        boolean b optional
    }

    testcase TC() runs on C {
        var R v_r := { a := 1 } with { optional "explicit omit" }
        if (isbound(v_r.a) and not isbound(v_r.b)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    } with { optional "implicit omit" }

    control {
        execute(TC());
    }
}
