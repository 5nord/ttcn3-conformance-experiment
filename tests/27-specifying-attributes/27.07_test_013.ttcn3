// @requirement: 27.7 -- b) At most one optional attribute shall be applied to each definition, each individual field reference or language element to which a with statement is associated.
// @id: TTCN3-CORE-27.7-019a
// @verdict: pass reject
module M_27_07_test_013 {

    type record R {
        integer a,
        boolean b optional
    }

    template R m_r := { a := 1 } with {
        optional "implicit omit";
        optional "explicit omit" // error: second optional attribute for the same definition
    }

}
