// @requirement: 27.1.2.0 -- An attribute definition in a lower scope or those inherited from a referenced type can be overwritten in a higher scope by using the override directive.
// @id: TTCN3-CORE-27.1.2.0-022a
// @verdict: pass accept, noexecution
module M_27_01_02_00_test_015 {

    type record MyRecordA {
        integer field1
    } with { encode "RuleA" }

    type record MyRecordB {
        MyRecordA fieldA
    } with { encode override (fieldA) "RuleB" }

    group myGroup {
        type integer MyInt with { encode "RuleC" }
    } with { encode override "RuleD" }
}
