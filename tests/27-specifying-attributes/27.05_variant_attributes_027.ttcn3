// @requirement: 27.5 -- The with statement can contain any number of variant attributes.
// @id: TTCN3-CORE-27.5-041a
// @verdict: pass accept, noexecution
module M_27_05_variant_attributes_027 {

    type record R {
        integer f1,
        integer f2
    } with {
        encode "Codec1";
        variant "Rule1";
        variant "Rule2";
        variant (f1) "Rule3";
        variant (f2) "Rule4"
    }

}
