// @requirement: 27.7 -- This applies recursively to the optional fields of the entity and to subfields of the mandatory fields.
// @id: TTCN3-CORE-27.7-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_07_test_009 {

    type component C {}

    type record R1 {
        integer a,
        boolean b optional
    }

    type record R2 {
        R1 m,
        R1 o optional
    }

    testcase TC() runs on C {
        var R2 v_r2 := { m := { a := 1 } } with { optional "explicit omit" }
        if (isbound(v_r2.m.a) and not isbound(v_r2.m.b) and not isbound(v_r2.o)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    } with { optional "implicit omit" }

    control {
        execute(TC());
    }
}
