// @requirement: 27.1.2.0 -- Override attribute applied to a synonym type (clause 6.4) overrides attributes of all fields or elements of the synonym type unless the synonym type definition contains an explicit attribute definition for the field or element.
// @id: TTCN3-CORE-27.1.2.0-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_01_02_00_general_019 {

    type component C {}

    type record of universal charstring RUC;

    type record MyRecordF {
        integer field1,
        integer field2
    } with { encode "RuleA" }

    type MyRecordF MyRecordG with {
        encode override "RuleB";
        encode (field2) "RuleC"
    }

    testcase TC() runs on C {
        var MyRecordG v_rec;
        var RUC v_f1 := v_rec.field1.encode;
        var RUC v_f2 := v_rec.field2.encode;
        if (v_f1 == { "RuleB" } and v_f2 == { "RuleC" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
