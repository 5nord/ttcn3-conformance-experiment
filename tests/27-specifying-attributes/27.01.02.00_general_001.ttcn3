// @requirement: 27.1.2.0 -- An attribute definition that is directly attached to a lower scope unit will override a general attribute definition in a higher scope
// @id: TTCN3-CORE-27.1.2.0-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_01_02_00_general_001 {

    type component C {}

    group myPDUs {
        type record MyPDU1 {
            integer field1
        }
        type record MyPDU2 {
            integer field1
        } with { display "Special" }
    } with { display "PDU" }

    testcase TC() runs on C {
        if (MyPDU2.display == "Special" and MyPDU1.display == "PDU") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
