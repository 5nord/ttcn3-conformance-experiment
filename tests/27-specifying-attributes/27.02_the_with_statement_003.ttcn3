// @requirement: 27.2 -- The syntax for the argument of the with statement (i.e. the actual attributes) is defined as a free text string.
// @id: TTCN3-CORE-27.2-005a
// @verdict: pass accept, noexecution
module M_27_02_the_with_statement_003 {

    type integer MyInt with {
        encode "any free text, 1 2 3 ; { } ( )";
        display "Free text: <PDU> #1";
        extension "key=value; other key = other value"
    }

}
