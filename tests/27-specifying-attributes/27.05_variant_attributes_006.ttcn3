// @requirement: 27.5 -- b) "16 bit" and "unsigned 16 bit" mean, when applied to integer and enumerated types, that the integer value or the integer numbers associated with enumerated values shall be handled as it was represented on 16-bits (two bytes) within the system.
// @id: TTCN3-CORE-27.5-010a
// @verdict: pass accept, noexecution
module M_27_05_variant_attributes_006 {

    type integer MyInt16 (-32768 .. 32767) with { variant "16 bit" }
    type integer MyUInt16 (0 .. 65535) with { variant "unsigned 16 bit" }
    type enumerated MyEnum16 { e_a(0), e_b(32767) } with { variant "16 bit" }
    type enumerated MyUEnum16 { e_a(0), e_b(65535) } with { variant "unsigned 16 bit" }

}
with { encode "MyCodec" }
