// @requirement: 27.1.2.0 -- Attributes defined for a synonym type do not override existing attributes of fields or elements of this synonym type.
// @id: TTCN3-CORE-27.1.2.0-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_01_02_00_test_007 {

    type component C {}

    type record of universal charstring RUC;

    type record SourceType {
        integer field1,
        integer field2
    } with { encode "Rule1" }

    type SourceType SynonymType with { encode "Rule3" }

    testcase TC() runs on C {
        var SynonymType v_syn;
        var RUC v_type := SynonymType.encode;
        var RUC v_field := v_syn.field1.encode;
        if (v_type == { "Rule3" } and v_field == { "Rule1" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
