// @requirement: 27.5 -- It is not allowed to define variant attributes with no encoding reference if multiple encodings are used.
// @id: TTCN3-CORE-27.5-039a
// @verdict: pass reject
module M_27_05_variant_attributes_026 {

    type charstring Multi3 with {
        encode "Codec1";
        encode "Codec2";
        variant "Rule1" // error: no encoding reference although multiple encodings are used
    }

}
