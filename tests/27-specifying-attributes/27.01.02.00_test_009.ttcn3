// @requirement: 27.1.2.0 -- Attributes with the @local modifier override attributes from higher scope
// @id: TTCN3-CORE-27.1.2.0-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_01_02_00_test_009 {

    type component C {}

    type record of universal charstring RUC;

    type record MyRec {
        integer field1,
        integer field2
    } with { encode @local "CodecB" }

    testcase TC() runs on C {
        var RUC v_enc := MyRec.encode;
        if (v_enc == { "CodecB" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
} with { encode "CodecA" }
