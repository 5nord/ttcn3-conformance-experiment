// @requirement: 27.5 -- Therefore, for variant attributes, additional overwriting rules apply (see clause 27.1.2.1).
// @id: TTCN3-CORE-27.5-006a
// @verdict: pass accept, noexecution
module M_27_05_test_004 {

    type charstring MyType;

    group myVariantsOne {
        type record MyPDUone {
            integer field1,
            MyType field3
        }
        with { encode (field1) "Encoding 2" }
    }
    with { variant "Variant 1" }

    group myVariantsTwo {
        type record MyPDUtwo {
            integer field1,
            MyType field3
        }
        with { variant (field1) "Variant 3" }
    }
    with { encode "Encoding 3"; variant "Variant 2" }

}
with { encode "Encoding 1" }
