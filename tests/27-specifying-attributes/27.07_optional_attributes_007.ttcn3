// @requirement: 27.7 -- This applies recursively to the optional fields of the entity and to subfields of the mandatory fields.
// @id: TTCN3-CORE-27.7-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_07_optional_attributes_007 {

    type component C {}

    type record R1 {
        integer a,
        boolean b optional
    }

    type record R2 {
        R1 m,
        R1 o optional
    }

    template R1 mw_r1 := { a := ? }

    template R2 mw_r2 := { m := mw_r1 } with { optional "implicit omit" }

    testcase TC() runs on C {
        var R2 v_r2 := { m := { a := 1 } } with { optional "implicit omit" }
        if (v_r2 == { m := { a := 1, b := omit }, o := omit }
            and match({ m := { a := 1, b := omit }, o := omit }, mw_r2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
