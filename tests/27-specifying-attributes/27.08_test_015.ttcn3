// @requirement: 27.8 -- c) An error shall be produced if the Expression in the optional parameters is not one of the valid encode attributes.
// @id: TTCN3-CORE-27.8-016a
// @verdict: pass reject
module M_27_08_test_015 {

    type component C {}

    type record of universal charstring RUC;

    type integer MyInt with {
        encode "Codec1";
        encode "Codec2";
        variant "Codec1"."Rule1"
    }

    testcase TC() runs on C {
        var RUC v_variant := MyInt.variant("UnknownCodec"); // error: no such encode attribute
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
