// @requirement: 27.9 -- The procedure is applied recursively to all elements and fields or the referenced type.
// @id: TTCN3-CORE-27.9-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_27_09_dynamic_configuration_of_encoding_used_by_ports_008 {

    type record Payload {
        integer data
    } with { encode "Codec1"; encode "Codec2" }

    type record of Payload PayloadList with { encode "Codec1"; encode "Codec2" }

    type record PDU {
        charstring source,
        Payload payload,
        PayloadList list
    } with { encode "Codec1"; encode "Codec2" }

    type port P message {
        inout PDU;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template PDU m_msg := {
        source := "source address",
        payload := { data := 1 },
        list := { { data := 2 } }
    }

    testcase TC() runs on C {
        timer T_guard := 1.0;
        connect(self:p1, self:p2);
        all port.setencode(PDU, "Codec2");
        p1.send(m_msg);
        T_guard.start;
        alt {
            [] p2.receive(m_msg) { setverdict(pass); }
            [] T_guard.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
