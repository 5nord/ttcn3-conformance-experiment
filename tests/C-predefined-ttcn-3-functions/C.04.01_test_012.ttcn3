// @requirement: C.4.1 -- The parameter groupno shall be a non-negative integer.
// @id: TTCN3-CORE-C.4.1-012a
// @verdict: pass reject
module M_C_04_01_test_012 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abc";
        var charstring v_res := regexp(v_in, charstring:"(a)bc", -1); // error: negative groupno
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
