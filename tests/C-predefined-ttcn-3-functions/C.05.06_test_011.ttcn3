// @requirement: C.5.6 -- The return value 1 indicates an unspecified cause of decoding failure.
// @id: TTCN3-CORE-C.5.6-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_06_test_011 {

    type component C {}

    type record R {
        integer f1,
        integer f2
    } with { encode "JSON" }

    const R c_r := { f1 := 1, f2 := 2 };

    testcase TC() runs on C {
        var octetstring v_o := 'FFFEFDFC'O;
        var R v_r;
        if (decvalue_o(v_o, v_r) == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
