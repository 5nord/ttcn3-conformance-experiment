// @requirement: C.4.2 -- This function returns a substring or subsequence from a value that is of a binary string type (bitstring, hexstring, octetstring), a character string type (charstring, universal charstring), or a sequence type (record of, set of or array).
// @id: TTCN3-CORE-C.4.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_the_substring_function_002 {

    type record of integer RoI;
    type set of integer SoI;
    type integer Arr[3];

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '00100110'B;
        var hexstring v_h := 'ABCDEF'H;
        var octetstring v_o := '01AB23CD'O;
        var charstring v_c := "My name is JJ";
        var universal charstring v_u := "abc" & char(0, 0, 1, 0);
        var RoI v_roi := { 4, 5, 6 };
        var SoI v_soi := { 4, 5, 6 };
        var Arr v_arr := { 4, 5, 6 };
        var RoI v_res;
        v_res := substr(v_arr, 1, 2);
        if (substr(v_b, 3, 4) == '0011'B and
            substr(v_h, 2, 3) == 'CDE'H and
            substr(v_o, 1, 2) == 'AB23'O and
            substr(v_c, 11, 2) == "JJ" and
            substr(v_u, 2, 2) == "c" & char(0, 0, 1, 0) and
            substr(v_roi, 1, 2) == { 5, 6 } and
            lengthof(substr(v_soi, 1, 2)) == 2 and
            v_res == { 5, 6 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
