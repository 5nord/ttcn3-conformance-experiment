// @requirement: C.5.6 -- If the decoding was successful, then the used octets are removed from the parameter encoded_value, the rest is returned (in the parameter encoded_value), and the decoded value is returned in the parameter decoded_value.
// @id: TTCN3-CORE-C.5.6-007b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_06_test_006 {

    type component C {}

    type record R {
        integer f1,
        integer f2
    } with { encode "JSON" }

    const R c_r := { f1 := 1, f2 := 2 };

    testcase TC() runs on C {
        var integer v_len;
        var octetstring v_rest := encvalue_o(R:{ f1 := 3, f2 := 4 }, "", "", v_len);
        var octetstring v_o := encvalue_o(c_r, "", "", v_len) & v_rest;
        var R v_r;
        if (decvalue_o(v_o, v_r) == 0 and v_o == v_rest) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
