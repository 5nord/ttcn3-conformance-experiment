// @requirement: C.1.30 -- enum2int(in Enumerated_type inpar) return integer
// @id: TTCN3-CORE-C.1.30-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_30_enumerated_to_integer_001 {

    type enumerated E { e_a, e_b }

    type component C {}

    testcase TC() runs on C {
        var E v_e := e_b;
        var integer v_res := enum2int(v_e);
        if (v_res == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
