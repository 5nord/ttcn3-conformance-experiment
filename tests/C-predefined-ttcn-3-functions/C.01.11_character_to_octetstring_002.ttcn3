// @requirement: C.1.11 -- This function converts a charstring invalue to an octetstring.
// @id: TTCN3-CORE-C.1.11-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_11_character_to_octetstring_002 {

    type component C {}

    testcase TC() runs on C {
        if (char2oct("Tinky-Winky") == '54696E6B792D57696E6B79'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
