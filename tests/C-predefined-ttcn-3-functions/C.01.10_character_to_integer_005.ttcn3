// @requirement: C.1.10 -- length of invalue does not equal 1. In addition to the general error causes in clause 16.1.2, error causes are:
// @id: TTCN3-CORE-C.1.10-005a
// @verdict: pass accept, ttcn3verdict:error
module M_C_01_10_character_to_integer_005 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "ab";
        var integer v_res := char2int(v_in); // error: length of invalue is not 1
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
