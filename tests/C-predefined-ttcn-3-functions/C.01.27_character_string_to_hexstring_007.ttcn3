// @requirement: C.1.27 -- `invalue contains characters other than specified above.`
// @id: TTCN3-CORE-C.1.27-007a
// @verdict: pass accept, ttcn3verdict:error
module M_C_01_27_character_string_to_hexstring_007 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_c := "12 3";
        var hexstring v_h := str2hex(v_c); // error: space is not a hex digit character
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
