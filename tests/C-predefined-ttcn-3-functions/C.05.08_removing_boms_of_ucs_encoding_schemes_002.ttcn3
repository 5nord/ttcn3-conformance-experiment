// @requirement: C.5.8 -- The remove_bom function removes the optional FEFF ZERO WIDTH NO-BREAK SPACE sequence that may be present at the beginning of a stream of serialized (encoded) universal character strings to indicate the order of the octets within the encoding form, as defined in clause 10 of ISO/IEC 10646 [2].
// @id: TTCN3-CORE-C.5.8-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_08_removing_boms_of_ucs_encoding_schemes_002 {

    type component C {}

    testcase TC() runs on C {
        if (remove_bom('FEFF0068006900FA007A'O) == '0068006900FA007A'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
