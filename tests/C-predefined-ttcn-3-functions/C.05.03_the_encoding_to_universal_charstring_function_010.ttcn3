// @requirement: C.5.3 -- The serialized bitstring shall not include the optional signature (see clause 10 of ISO/IEC 10646 [2], also known as byte order mark).
// @id: TTCN3-CORE-C.5.3-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_03_the_encoding_to_universal_charstring_function_010 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 65;

    testcase TC() runs on C {
        var octetstring v_oct := bit2oct(encvalue(c_val));
        var universal charstring v_utf8 := encvalue_unichar(c_val, "UTF-8");
        var universal charstring v_utf16 := encvalue_unichar(c_val, "UTF-16");
        var universal charstring v_utf32 := encvalue_unichar(c_val, "UTF-32");
        if (lengthof(v_oct) == 4 and
            lengthof(v_utf8) == 4 and lengthof(v_utf16) == 2 and lengthof(v_utf32) == 1 and
            v_utf16[0] != char(0, 0, 254, 255) and v_utf32[0] != char(0, 0, 254, 255)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
