// @requirement: C.1.5 -- int2hex(in integer invalue, in integer length) return hexstring
// @id: TTCN3-CORE-C.1.5-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_05_test_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_in := 255;
        var integer v_len := 4;
        var hexstring v_res := int2hex(v_in, v_len);
        if (v_res == '00FF'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
