// @requirement: C.1.6 -- The resulting string is length octets long.
// @id: TTCN3-CORE-C.1.6-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_06_test_003 {

    type component C {}

    testcase TC() runs on C {
        if (lengthof(int2oct(3, 5)) == 5 and lengthof(int2oct(0, 1)) == 1 and lengthof(int2oct(65535, 2)) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
