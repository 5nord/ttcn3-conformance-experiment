// @requirement: C.6.1 -- Thus, the rnd function will always use the seed of the component or control part which calls it.
// @id: TTCN3-CORE-C.6.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_01_the_random_number_generator_function_008 {

    type component C {}

    function f_ptc(float p_expected) runs on C {
        timer T := 0.5;
        var float v_r := rnd(0.375);
        T.start;
        T.timeout;
        if (rnd() == p_expected) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var float v_r := rnd(0.375);
        var float v_expected := rnd();
        var C v_ptc := C.create;
        v_ptc.start(f_ptc(v_expected));
        v_r := rnd(0.8);
        v_r := rnd();
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
