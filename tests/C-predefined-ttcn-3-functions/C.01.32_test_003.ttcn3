// @requirement: C.1.32 -- Each octet of the octetstring` will contain the octets mandated by mapping the characters of invalue using the standardized mapping associated with the given string_encoding in the same order as the characters appear in inpar.
// @id: TTCN3-CORE-C.1.32-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_32_test_003 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_in := "A" & char(0, 0, 32, 172) & "B";
        if (unichar2oct(v_in, "UTF-8") == '41E282AC42'O and
            unichar2oct(v_in, "UTF-16BE") == '004120AC0042'O and
            unichar2oct(v_in, "UTF-16LE") == '4100AC204200'O and
            unichar2oct(v_in, "UTF-32BE") == '00000041000020AC00000042'O and
            unichar2oct(v_in, "UTF-32LE") == '41000000AC20000042000000'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
