// @requirement: C.5.3 -- The string_serialization parameter defines how the encoded octets (in fact the encoded bitstring received from the codec) contain the characters.
// @id: TTCN3-CORE-C.5.3-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_03_the_encoding_to_universal_charstring_function_016 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 1094861636;

    testcase TC() runs on C {
        var octetstring v_oct := bit2oct(encvalue(c_val));
        var universal charstring v_be := encvalue_unichar(c_val, "UTF-16BE");
        var universal charstring v_le := encvalue_unichar(c_val, "UTF-16LE");
        if (v_be == oct2unichar(v_oct, "UTF-16BE") and v_le == oct2unichar(v_oct, "UTF-16LE") and
            v_be != v_le) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
