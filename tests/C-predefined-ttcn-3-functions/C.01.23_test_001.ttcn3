// @requirement: C.1.23 -- oct2hex(in octetstring invalue) return hexstring
// @id: TTCN3-CORE-C.1.23-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_23_test_001 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_o := '0F'O;
        var hexstring v_h := oct2hex(v_o);
        if (v_h == '0F'H) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
