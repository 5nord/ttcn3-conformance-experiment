// @requirement: C.1.13 -- This function converts a single bitstring value to a single integer value.
// @id: TTCN3-CORE-C.1.13-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_13_test_002 {

    type component C {}

    testcase TC() runs on C {
        if (bit2int('1111'B) == 15 and bit2int('00010000'B) == 16) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
