// @requirement: C.1.1 -- int2char(in integer invalue) return charstring
// @id: TTCN3-CORE-C.1.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_01_integer_to_character_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 65;
        var charstring v_c := int2char(v_i);
        if (v_c == "A") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
