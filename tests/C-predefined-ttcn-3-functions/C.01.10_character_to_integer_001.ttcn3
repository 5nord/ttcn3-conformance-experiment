// @requirement: C.1.10 -- char2int(in charstring invalue) return integer
// @id: TTCN3-CORE-C.1.10-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_10_character_to_integer_001 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "0";
        var integer v_res := char2int(v_in);
        if (v_res == 48) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
