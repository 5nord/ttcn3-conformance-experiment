// @requirement: C.1.2 -- The integer value describes the 32-bit encoding of the character.
// @id: TTCN3-CORE-C.1.2-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_02_integer_to_universal_character_003 {

    type component C {}

    testcase TC() runs on C {
        if (int2unichar(97) == char(0, 0, 0, 97) and int2unichar(273) == char(0, 0, 1, 17) and
            int2unichar(2147483647) == char(127, 255, 255, 255)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
