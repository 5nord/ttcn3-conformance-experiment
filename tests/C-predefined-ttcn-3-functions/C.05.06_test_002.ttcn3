// @requirement: C.5.6 -- The decvalue_o function decodes an octetstring into a value.
// @id: TTCN3-CORE-C.5.6-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_06_test_002 {

    type component C {}

    type record R {
        integer f1,
        integer f2
    } with { encode "JSON" }

    const R c_r := { f1 := 1, f2 := 2 };

    testcase TC() runs on C {
        var integer v_len;
        var octetstring v_o := encvalue_o(c_r, "", "", v_len);
        var R v_r;
        if (decvalue_o(v_o, v_r) == 0 and v_r == c_r) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
