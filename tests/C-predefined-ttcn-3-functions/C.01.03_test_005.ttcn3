// @requirement: C.1.3 -- The rightmost bit is least significant, the leftmost bit is the most significant.
// @id: TTCN3-CORE-C.1.3-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_03_test_005 {

    type component C {}

    testcase TC() runs on C {
        if (int2bit(1, 4) == '0001'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
