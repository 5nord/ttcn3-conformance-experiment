// @requirement: C.1.17 -- The rightmost hexadecimal digit is least significant, the leftmost hexadecimal digit is the most significant.
// @id: TTCN3-CORE-C.1.17-004b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_17_test_005 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h1 := '100'H;
        var hexstring v_h2 := '200'H;
        if (hex2int(v_h1) == 256 and hex2int(v_h2) == 512) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
