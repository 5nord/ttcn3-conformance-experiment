// @requirement: C.2.1 -- NOTE 2: In case of record ofs and set ofs and arrays only elements of the TTCN-3 object, which is the parameter of the function are calculated; i.e. no elements of nested types are taken into account when determining the return value.
// @id: TTCN3-CORE-C.2.1-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_02_01_length_of_strings_and_lists_017 {

    type component C {}
    type record of integer RoI;
    type record of RoI RoRoI;
    type set of RoI SoRoI;

    testcase TC() runs on C {
        var RoRoI v_r := { { 1, 2, 3 }, { 4, 5 } };
        var SoRoI v_s := { { 1, 2, 3, 4 } };
        var RoI v_a[2] := { { 1, 2, 3 }, { 4 } };
        if (lengthof(v_r) == 2 and lengthof(v_s) == 1 and lengthof(v_a) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
