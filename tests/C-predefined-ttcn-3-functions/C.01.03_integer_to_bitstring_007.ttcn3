// @requirement: C.1.3 -- The bits 0 and 1 represent the decimal values 0 and 1 respectively.
// @id: TTCN3-CORE-C.1.3-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_03_integer_to_bitstring_007 {

    type component C {}

    testcase TC() runs on C {
        if (int2bit(0, 1) == '0'B and int2bit(1, 1) == '1'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
