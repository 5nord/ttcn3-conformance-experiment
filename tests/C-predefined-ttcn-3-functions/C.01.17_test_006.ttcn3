// @requirement: C.1.17 -- The hexadecimal digits 0 to F represent the decimal values 0 to 15 respectively.
// @id: TTCN3-CORE-C.1.17-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_17_test_006 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_digits := '0123456789ABCDEF'H;
        for (var integer i := 0; i < 16; i := i + 1) {
            if (hex2int(v_digits[i]) != i) {
                setverdict(fail);
            }
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
