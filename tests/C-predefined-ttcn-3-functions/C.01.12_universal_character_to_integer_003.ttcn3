// @requirement: C.1.12 -- The integer value describes the 32-bit encoding of the character.
// @id: TTCN3-CORE-C.1.12-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_12_universal_character_to_integer_003 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_in := char(1, 2, 3, 4);
        if (unichar2int(v_in) == 16909060) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
