// @requirement: C.5.4 -- If the decoding was unsuccessful, the actual parameters for encoded_value and decoded_value are not changed.
// @id: TTCN3-CORE-C.5.4-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_04_the_decoding_from_universal_charstring_function_008 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 1094861636;

    testcase TC() runs on C {
        var universal charstring v_orig := substr(encvalue_unichar(c_val), 0, 2);
        var universal charstring v_enc := v_orig;
        var I v_dec := 7;
        var integer v_res := decvalue_unichar(v_enc, v_dec);
        if (v_res != 0 and v_enc == v_orig and v_dec == 7) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
