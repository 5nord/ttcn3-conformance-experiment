// @requirement: C.1.29 -- This function converts a charstring comprising a number into a float value.
// @id: TTCN3-CORE-C.1.29-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_29_character_string_to_float_002 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_dec := "1.6";
        var charstring v_exp := "123.456E+02";
        if (str2float(v_dec) == 1.6 and str2float(v_exp) == str2float("12345.6")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
