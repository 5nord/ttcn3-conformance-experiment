// @requirement: C.5.2 -- This value is also returned if the encoded_value parameter contains an unitialized value.
// @id: TTCN3-CORE-C.5.2-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_02_test_012 {

    type component C {}

    type integer I with { variant "32 bit" };

    testcase TC() runs on C {
        var bitstring v_enc;
        var I v_dec;
        if (decvalue(v_enc, v_dec) == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
