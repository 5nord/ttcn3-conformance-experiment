// @requirement: C.1.18 -- 'C'H → '1100'B, 'D'H → '1101'B, 'E'H → '1110'B, and 'F'H → '1111'B.
// @id: TTCN3-CORE-C.1.18-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_18_hexstring_to_bitstring_007 {

    type component C {}

    testcase TC() runs on C {
        if (hex2bit('C'H) == '1100'B and
            hex2bit('D'H) == '1101'B and
            hex2bit('E'H) == '1110'B and
            hex2bit('F'H) == '1111'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
