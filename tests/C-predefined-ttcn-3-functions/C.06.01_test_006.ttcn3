// @requirement: C.6.1 -- Each time the rnd function is initialized with the same seed value, it shall repeat the same sequence of random numbers.
// @id: TTCN3-CORE-C.6.1-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_01_test_006 {

    type component C {}

    testcase TC() runs on C {
        var float v_a1 := rnd(0.125);
        var float v_a2 := rnd();
        var float v_a3 := rnd();
        var float v_b1 := rnd(0.125);
        var float v_b2 := rnd();
        var float v_b3 := rnd();
        if (v_a1 == v_b1 and v_a2 == v_b2 and v_a3 == v_b3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
