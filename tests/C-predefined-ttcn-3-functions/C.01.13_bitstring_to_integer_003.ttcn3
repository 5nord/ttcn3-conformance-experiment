// @requirement: C.1.13 -- For the purposes of this conversion, a bitstring shall be interpreted as a positive base 2 integer value.
// @id: TTCN3-CORE-C.1.13-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_13_bitstring_to_integer_003 {

    type component C {}

    testcase TC() runs on C {
        if (bit2int('11111111'B) == 255 and bit2int('10000000'B) == 128 and bit2int('0000'B) == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
