// @requirement: C.2.1 -- For array values or templates, the value to be returned is the fixed length of the corresponding record `of type.`
// @id: TTCN3-CORE-C.2.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_02_01_length_of_strings_and_lists_008 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a[5];
        var template integer v_t[3] := { 1, ?, (2, 3) };
        v_a[0] := 1;
        if (lengthof(v_a) == 5 and lengthof(v_t) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
