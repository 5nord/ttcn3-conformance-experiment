// @requirement: C.1.21 -- The rightmost hexadecimal digit is least significant, the leftmost hexadecimal digit is the most significant.
// @id: TTCN3-CORE-C.1.21-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_21_test_004 {

    type component C {}

    testcase TC() runs on C {
        if (oct2int('0001'O) == 1 and oct2int('0010'O) == 16) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
