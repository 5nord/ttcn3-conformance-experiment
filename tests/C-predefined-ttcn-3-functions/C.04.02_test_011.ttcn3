// @requirement: C.4.2 -- When used on templates of character and binary string types, inpar can contain any template that fulfils the requirements for referencing individual string elements on the right hand side of an assignment specified in clause 15.6.1.
// @id: TTCN3-CORE-C.4.2-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_test_011 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_char1 := pattern "abc[a-z]+";
        var template charstring v_char2 := ?;
        var template octetstring v_oct := 'AB?CD'O;
        var template charstring v_res1 := substr(v_char1, 2, 2);
        var template charstring v_res2 := substr(v_char2, 0, 3);
        var template octetstring v_res3 := substr(v_oct, 1, 2);
        if (match("cxyz", v_res1) and match("xyz", v_res2) and match('11CD'O, v_res3)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
