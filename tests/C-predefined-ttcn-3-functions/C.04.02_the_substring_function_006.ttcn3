// @requirement: C.4.2 -- Indexing starts from zero.
// @id: TTCN3-CORE-C.4.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_the_substring_function_006 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abc";
        if (substr(v_in, 0, 1) == "a") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
