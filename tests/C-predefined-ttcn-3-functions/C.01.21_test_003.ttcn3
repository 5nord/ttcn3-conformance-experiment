// @requirement: C.1.21 -- For the purposes of this conversion, an octetstring shall be interpreted as a positive base 16 integer value.
// @id: TTCN3-CORE-C.1.21-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_21_test_003 {

    type component C {}

    testcase TC() runs on C {
        if (oct2int('FF'O) == 255 and oct2int('8000'O) == 32768) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
