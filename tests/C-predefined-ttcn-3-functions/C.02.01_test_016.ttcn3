// @requirement: C.2.1 -- If inpar contains uninitialized elements, each of them shall be counted as 1 element, i.e. they shall be matched as if they contained the "?" (AnyElement inside value) matching character.
// @id: TTCN3-CORE-C.2.1-017b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_02_01_test_016 {

    type component C {}
    type record of integer RoI;

    testcase TC() runs on C {
        var template RoI v_uninit := { 1, -, 3 } length(3);
        var template RoI v_any := { 1, ?, 3 } length(3);
        if (lengthof(v_uninit) == lengthof(v_any) and lengthof(v_uninit) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
