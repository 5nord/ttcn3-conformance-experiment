// @requirement: C.1.3 -- This function converts a single integer value to a single bitstring value.
// @id: TTCN3-CORE-C.1.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_03_integer_to_bitstring_002 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_res := int2bit(10, 4);
        if (v_res == '1010'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
