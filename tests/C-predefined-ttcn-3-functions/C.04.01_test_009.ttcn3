// @requirement: C.4.1 -- The parameters inpar and expression shall be a value or a template of charstring or universal charstring types.
// @id: TTCN3-CORE-C.4.1-009a
// @verdict: pass reject
module M_C_04_01_test_009 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_in := 'ABCD'O;
        var charstring v_res := regexp(v_in, charstring:"(?)?", 0); // error: inpar is not a character string
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
