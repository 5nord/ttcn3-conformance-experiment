// @requirement: C.4.3 -- `* length (index..infinity) is returned when inpar contains AnyValueOrNone and repl` contains AnyValue
// @id: TTCN3-CORE-C.4.3-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_the_replace_function_018 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_in := *;
        var template charstring v_repl := ?;
        var template charstring v_res := replace(v_in, 2, 1, v_repl);
        if (match("ab", v_res) and match("abcdefg", v_res) and not match("a", v_res)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
