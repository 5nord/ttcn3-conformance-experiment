// @requirement: C.4.2 -- The third input parameter (count) defines the length of the substring or subsequence to be returned.
// @id: TTCN3-CORE-C.4.2-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_the_substring_function_007 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abcdef";
        if (lengthof(substr(v_in, 1, 4)) == 4 and lengthof(substr(v_in, 1, 0)) == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
