// @requirement: C.4.2 -- The type of the substring or subsequence returned is the root type of the input parameter.
// @id: TTCN3-CORE-C.4.2-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_the_substring_function_004 {

    type charstring Str6 length(6);
    type record of integer RoI;
    type RoI RoI3 length(3);

    type component C {}

    testcase TC() runs on C {
        var Str6 v_str := "abcdef";
        var RoI3 v_roi := { 1, 2, 3 };
        var charstring v_res1 := substr(v_str, 1, 2);
        var RoI v_res2 := substr(v_roi, 0, 2);
        if (v_res1 == "bc" and v_res2 == { 1, 2 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
