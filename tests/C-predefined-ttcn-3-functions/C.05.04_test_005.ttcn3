// @requirement: C.5.4 -- If the decoding was successful, then the characters used for decoding are removed from the parameter encoded_value, the rest is returned (in the parameter encoded_value), and the decoded value is returned in the parameter decoded_value.
// @id: TTCN3-CORE-C.5.4-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_04_test_005 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_a := 1094861636;
    const I c_b := 1162233672;

    testcase TC() runs on C {
        var universal charstring v_enc_a := encvalue_unichar(c_a);
        var universal charstring v_enc := v_enc_a & encvalue_unichar(c_b);
        var integer v_len := lengthof(v_enc);
        var I v_dec;
        var integer v_res := decvalue_unichar(v_enc, v_dec);
        if (v_res == 0 and lengthof(v_enc) == v_len - lengthof(v_enc_a)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
