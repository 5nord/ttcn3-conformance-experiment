// @requirement: C.1.21 -- The rightmost hexadecimal digit is least significant, the leftmost hexadecimal digit is the most significant.
// @id: TTCN3-CORE-C.1.21-004b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_21_octetstring_to_integer_005 {

    type component C {}

    testcase TC() runs on C {
        if (oct2int('1000'O) == 4096 and oct2int('0100'O) == 256) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
