// @requirement: C.4.3 -- The inpar parameter is allowed to contain a template.
// @id: TTCN3-CORE-C.4.3-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_test_012 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_in := pattern "ab?d";
        var template charstring v_res := replace(v_in, 1, 1, "X");
        if (match("aXzd", v_res) and not match("abzd", v_res)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
