// @requirement: C.1.18 -- '6'H → '0110'B, '7'H → '0111'B, '8'H → '1000'B, '9'H → '1001'B, 'A'H → '1010'B, 'B'H → '1011'B,
// @id: TTCN3-CORE-C.1.18-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_18_test_006 {

    type component C {}

    testcase TC() runs on C {
        if (hex2bit('6'H) == '0110'B and
            hex2bit('7'H) == '0111'B and
            hex2bit('8'H) == '1000'B and
            hex2bit('9'H) == '1001'B and
            hex2bit('A'H) == '1010'B and
            hex2bit('B'H) == '1011'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
