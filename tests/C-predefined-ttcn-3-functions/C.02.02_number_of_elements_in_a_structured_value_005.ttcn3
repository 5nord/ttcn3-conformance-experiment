// @requirement: C.2.2 -- NOTE: Only elements of the TTCN-3 object, which is the parameter of the function are calculated; i.e. no elements of nested types/values are taken into account at determining the return value.
// @id: TTCN3-CORE-C.2.2-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_02_02_number_of_elements_in_a_structured_value_005 {

    type component C {}
    type record Inner {
        integer a,
        integer b,
        integer c
    }
    type record Outer {
        Inner f1,
        integer f2 optional
    }

    testcase TC() runs on C {
        var Outer v_o := { f1 := { a := 1, b := 2, c := 3 }, f2 := omit };
        if (sizeof(v_o) == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
