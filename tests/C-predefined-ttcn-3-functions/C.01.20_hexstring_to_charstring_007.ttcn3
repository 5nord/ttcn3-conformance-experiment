// @requirement: C.1.20 -- The consecutive order of characters in the resulting charstring is the same as the order of digits in the hexstring.
// @id: TTCN3-CORE-C.1.20-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_20_hexstring_to_charstring_007 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h1 := '12A'H;
        var hexstring v_h2 := 'A21'H;
        if (hex2str(v_h1) == "12A" and hex2str(v_h2) == "A21") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
