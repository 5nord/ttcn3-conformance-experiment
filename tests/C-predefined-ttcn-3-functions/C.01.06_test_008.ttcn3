// @requirement: C.1.6 -- The hexadecimal digits 0 to F represent the decimal values 0 to 15 respectively.
// @id: TTCN3-CORE-C.1.6-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_06_test_008 {

    type component C {}

    testcase TC() runs on C {
        if (int2oct(1985229328, 4) == '76543210'O and int2oct(4275878552, 4) == 'FEDCBA98'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
