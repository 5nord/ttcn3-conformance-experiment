// @requirement: C.1.5 -- The rightmost hexadecimal digit is least significant, the leftmost hexadecimal digit is the most significant.
// @id: TTCN3-CORE-C.1.5-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_05_integer_to_hexstring_005 {

    type component C {}

    testcase TC() runs on C {
        if (int2hex(1, 3) == '001'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
