// @requirement: C.1.6 -- For the purposes of this conversion, an octetstring shall be interpreted as a positive base 16 integer value.
// @id: TTCN3-CORE-C.1.6-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_06_test_004 {

    type component C {}

    testcase TC() runs on C {
        if (int2oct(0, 1) == '00'O and int2oct(4660, 2) == '1234'O and int2oct(65535, 2) == 'FFFF'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
