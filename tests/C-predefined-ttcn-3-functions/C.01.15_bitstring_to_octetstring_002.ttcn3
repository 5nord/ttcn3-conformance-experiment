// @requirement: C.1.15 -- This function converts a single bitstring value to a single octetstring.
// @id: TTCN3-CORE-C.1.15-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_15_bitstring_to_octetstring_002 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '111010111'B;
        var octetstring v_o := bit2oct(v_b);
        if (v_o == '01D7'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
