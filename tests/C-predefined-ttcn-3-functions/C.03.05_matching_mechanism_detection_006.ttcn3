// @requirement: C.3.5 -- The kind parameter shall be one of the strings listed in table C.1.
// @id: TTCN3-CORE-C.3.5-007a
// @verdict: pass reject
module M_C_03_05_matching_mechanism_detection_006 {

    type component C {}

    testcase TC() runs on C {
        var template integer v_t := ?;
        var boolean v_res := istemplatekind(v_t, "anything"); // error: kind not listed in table C.1
