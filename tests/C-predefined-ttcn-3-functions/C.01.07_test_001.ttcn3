// @requirement: C.1.7 -- int2str(in integer invalue) return charstring
// @id: TTCN3-CORE-C.1.7-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_07_test_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_in := 12;
        var charstring v_res := int2str(v_in);
        if (v_res == "12") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
