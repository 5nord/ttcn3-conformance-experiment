// @requirement: C.5.2 -- If the decoding was successful, then the used bits are removed from the parameter encoded_value, the rest is returned (in the parameter encoded_value), and the decoded value is returned in the parameter decoded_value.
// @id: TTCN3-CORE-C.5.2-007b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_02_test_006 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_a := 1094861636;
    const I c_b := 1162233672;

    testcase TC() runs on C {
        var bitstring v_enc_b := encvalue(c_b);
        var bitstring v_enc := encvalue(c_a) & v_enc_b;
        var I v_dec;
        var integer v_res := decvalue(v_enc, v_dec);
        if (v_res == 0 and v_enc == v_enc_b) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
