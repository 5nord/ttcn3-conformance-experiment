// @requirement: C.5.4 -- function decvalue_unichar (inout universal charstring encoded_value, out any decoded_value, in charstring string_encoding := "UTF-8"", in universal charstring decoding_info := "", in universal charstring dynamic_encoding := "") return integer { var bitstring v_str = oct2bit(unichar2oct(encoded_value, string_encoding)); var integer v_result := decvalue(v_str, decoded_value, decoding_info, dynamic_encoding); if (v_result == 0) { // success encoded_value := oct2unichar(bit2oct(v_str), string_encoding); } return v_result; }
// @id: TTCN3-CORE-C.5.4-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_04_the_decoding_from_universal_charstring_function_018 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_a := 1094861636;
    const I c_b := 1162233672;

    function f_equiv(inout universal charstring p_enc, out I p_dec,
                     in charstring p_ser := "UTF-8",
                     in universal charstring p_info := "",
                     in universal charstring p_dyn := "") return integer {
        var bitstring v_str := oct2bit(unichar2oct(p_enc, p_ser));
        var integer v_result := decvalue(v_str, p_dec, p_info, p_dyn);
        if (v_result == 0) {
            p_enc := oct2unichar(bit2oct(v_str), p_ser);
        }
        return v_result;
    }

    testcase TC() runs on C {
        var universal charstring v_enc := encvalue_unichar(c_a, "UTF-16BE") & encvalue_unichar(c_b, "UTF-16BE");
        var universal charstring v_enc_ref := v_enc;
        var I v_dec, v_dec_ref;
        var integer v_res := decvalue_unichar(v_enc, v_dec, "UTF-16BE", "info", "");
        var integer v_res_ref := f_equiv(v_enc_ref, v_dec_ref, "UTF-16BE", "info", "");
        if (v_res == v_res_ref and v_dec == v_dec_ref and v_enc == v_enc_ref) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
