// @requirement: C.1.11 -- char2oct(in charstring invalue) return octetstring
// @id: TTCN3-CORE-C.1.11-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_11_test_001 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "A";
        var octetstring v_res := char2oct(v_in);
        if (v_res == '41'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
