// @requirement: C.1.4 -- The type of the out parameter determines the type into which the in parameter is converted.
// @id: TTCN3-CORE-C.1.4-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_04_test_005 {

    type enumerated E {
        e_mon, e_tue, e_wed, e_weekend(6..7)
    }

    type enumerated E2 {
        e2_sat(-3), e2_sun(0), e2_mon
    }

    type component C {}

    testcase TC() runs on C {
        var E v_first := e_tue;
        var E2 v_second := e2_sun;
        int2enum(0, v_first);
        int2enum(1, v_second);
        if (v_first == e_mon and v_second == e2_mon) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
