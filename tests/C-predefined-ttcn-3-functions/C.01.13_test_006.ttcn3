// @requirement: C.1.13 -- The bits 0 and 1 represent the decimal values 0 and 1 respectively.
// @id: TTCN3-CORE-C.1.13-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_13_test_006 {

    type component C {}

    testcase TC() runs on C {
        if (bit2int('0'B) == 0 and bit2int('1'B) == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
