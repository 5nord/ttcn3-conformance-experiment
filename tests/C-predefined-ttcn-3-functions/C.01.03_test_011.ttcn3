// @requirement: C.1.3 -- invalue is less than zero; the conversion yields a return value with more bits than specified by length. In addition to the general error causes in clause 16.1.2, error causes are:
// @id: TTCN3-CORE-C.1.3-009b
// @verdict: pass accept, ttcn3verdict:error
module M_C_01_03_test_011 {

    type component C {}

    testcase TC() runs on C {
        var integer v_in := 16;
        var bitstring v_res := int2bit(v_in, 4); // error: needs more than 4 bits
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
