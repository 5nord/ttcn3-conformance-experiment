// @requirement: C.1.3 -- If the conversion yields a value with fewer bits than specified in the length parameter, then the bitstring shall be padded on the left with zeros.
// @id: TTCN3-CORE-C.1.3-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_03_integer_to_bitstring_008 {

    type component C {}

    testcase TC() runs on C {
        if (int2bit(5, 8) == '00000101'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
