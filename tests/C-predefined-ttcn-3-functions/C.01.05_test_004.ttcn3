// @requirement: C.1.5 -- For the purposes of this conversion, a hexstring shall be interpreted as a positive base 16 integer value.
// @id: TTCN3-CORE-C.1.5-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_05_test_004 {

    type component C {}

    testcase TC() runs on C {
        if (int2hex(0, 2) == '00'H and int2hex(4660, 4) == '1234'H and int2hex(65535, 4) == 'FFFF'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
