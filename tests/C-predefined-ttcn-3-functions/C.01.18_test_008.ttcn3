// @requirement: C.1.18 -- The consecutive order of the groups of 4 bits in the resulting bitstring is the same as the order of hex digits in the hexstring.
// @id: TTCN3-CORE-C.1.18-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_18_test_008 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h1 := '12'H;
        var hexstring v_h2 := '21'H;
        if (hex2bit(v_h1) == '00010010'B and hex2bit(v_h2) == '00100001'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
