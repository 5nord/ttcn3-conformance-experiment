// @requirement: C.5.6 -- If the decoding was unsuccessful, the actual parameters for encoded_value and decoded_value are not changed.
// @id: TTCN3-CORE-C.5.6-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_06_the_decoding_from_octetstring_function_008 {

    type component C {}

    type record R {
        integer f1,
        integer f2
    } with { encode "JSON" }

    const R c_r := { f1 := 1, f2 := 2 };

    testcase TC() runs on C {
        var octetstring v_o := ''O;
        var R v_r := c_r;
        if (decvalue_o(v_o, v_r) != 0 and v_o == ''O and v_r == c_r) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
