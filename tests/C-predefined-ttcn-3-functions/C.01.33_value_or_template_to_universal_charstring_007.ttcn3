// @requirement: C.1.33 -- When the optional format parameter takes the value "canonical": unbound fields are represented in the output as "-", the fields and members of structured types are represented recursively in assignment notation.
// @id: TTCN3-CORE-C.1.33-007b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_33_value_or_template_to_universal_charstring_007 {

    type record Inner {
        integer a,
        integer b
    }

    type record Outer {
        integer field1,
        Inner field2
    }

    type component C {}

    testcase TC() runs on C {
        var Outer v_rec := { field1 := 1, field2 := { a := 2, b := 3 } };
        if (any2unistr(v_rec, "canonical") == "{ field1 := 1, field2 := { a := 2, b := 3 } }") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
