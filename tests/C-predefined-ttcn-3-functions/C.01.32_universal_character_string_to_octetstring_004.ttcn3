// @requirement: C.1.32 -- If the optional string_encoding parameter is omitted, the default value "UTF-8".
// @id: TTCN3-CORE-C.1.32-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_32_universal_character_string_to_octetstring_004 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_in := char(0, 0, 0, 196) & char(0, 0, 32, 172);
        if (unichar2oct(v_in) == 'C384E282AC'O and unichar2oct(v_in) == unichar2oct(v_in, "UTF-8")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
