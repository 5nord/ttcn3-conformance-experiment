// @requirement: C.5.3 -- The rules for dynamic selection of the encode attribute are described in clause 27.9.
// @id: TTCN3-CORE-C.5.3-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_03_test_008 {

    type component C {}

    type integer I
    with {
        encode "Codec1"; variant "Codec1"."32 bit";
        encode "Codec2"; variant "Codec2"."16 bit"
    };

    type record R {
        I f1
    } with { encode "Codec1"; encode "Codec2" };

    const R c_val := { f1 := 65 };

    testcase TC() runs on C {
        // the selection of "Codec2" is applied recursively to field f1
        var universal charstring v_enc := encvalue_unichar(c_val, "UTF-8", "", "Codec2");
        if (lengthof(v_enc) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
