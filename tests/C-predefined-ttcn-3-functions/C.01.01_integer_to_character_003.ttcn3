// @requirement: C.1.1 -- The integer value describes the 8-bit encoding of the character.
// @id: TTCN3-CORE-C.1.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_01_integer_to_character_003 {

    type component C {}

    testcase TC() runs on C {
        if (int2char(97) == "a" and int2char(48) == "0" and int2char(0) == char(0, 0, 0, 0) and
            int2char(127) == char(0, 0, 0, 127)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
