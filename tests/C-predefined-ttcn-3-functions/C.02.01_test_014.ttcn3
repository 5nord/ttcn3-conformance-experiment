// @requirement: C.2.1 -- The parameter inpar shall only match values, for which the lengthof function would give the same result.
// @id: TTCN3-CORE-C.2.1-016a
// @verdict: pass reject
module M_C_02_01_test_014 {

    type component C {}
    type record of integer RoI;

    template RoI mw_roI := { 1, *, (2, 3) };

    testcase TC() runs on C {
        var integer v_len := lengthof(mw_roI); // error: matches values of different lengths
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
