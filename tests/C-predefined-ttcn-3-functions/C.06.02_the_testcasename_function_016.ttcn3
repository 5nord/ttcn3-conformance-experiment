// @requirement: C.6.2 -- Coding scheme: UTF-32; initial octet sequence: 00 00 FE FF FF FE 00 00; comments: signature (default 00 00 FE FF)
// @id: TTCN3-CORE-C.6.2-009b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_02_the_testcasename_function_016 {

    type component C {}

    testcase TC() runs on C {
        if (oct2unichar('00000068'O, "UTF-32") == "h" and
            oct2unichar(remove_bom('0000FEFF00000068'O), "UTF-32") == "h") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
