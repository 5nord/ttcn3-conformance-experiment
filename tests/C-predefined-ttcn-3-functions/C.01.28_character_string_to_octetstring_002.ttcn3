// @requirement: C.1.28 -- This function converts a string of the type charstring to an octetstring.
// @id: TTCN3-CORE-C.1.28-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_28_character_string_to_octetstring_002 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "54696E6B792D57696E6B79";
        if (str2oct(v_in) == '54696E6B792D57696E6B79'O and str2oct("a0fF") == 'A0FF'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
