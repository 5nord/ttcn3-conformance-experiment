// @requirement: C.1.9 -- float2int(in float invalue) return integer
// @id: TTCN3-CORE-C.1.9-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_09_float_to_integer_001 {

    type component C {}

    testcase TC() runs on C {
        var float v_in := 5.0;
        var integer v_res := float2int(v_in);
        if (v_res == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
