// @requirement: C.1.5 -- In addition to the general error causes in clause 16.1.2, error causes are:
// @id: TTCN3-CORE-C.1.5-008a
// @verdict: pass accept, ttcn3verdict:error
module M_C_01_05_integer_to_hexstring_009 {

    type component C {}

    testcase TC() runs on C {
        var integer v_len;
        var hexstring v_res := int2hex(1, v_len); // error: uninitialized in parameter
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
