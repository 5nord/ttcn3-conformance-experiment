// @requirement: C.4.3 -- If either the inpar or repl parameter contain a template, the replace function returns a template with the present restriction according to the following rules:
// @id: TTCN3-CORE-C.4.3-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_test_016 {

    type component C {}

    function f_check(template (present) charstring p_t) return boolean {
        return match("aXzd", p_t) and not match("abzd", p_t);
    }

    testcase TC() runs on C {
        var template charstring v_in := pattern "ab?d";
        var template (present) charstring v_res := replace(v_in, 1, 1, "X");
        if (f_check(v_res)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
