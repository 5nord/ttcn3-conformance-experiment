// @requirement: C.1.10 -- The integer value describes the 8-bit encoding of the character.
// @id: TTCN3-CORE-C.1.10-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_10_character_to_integer_003 {

    type component C {}

    testcase TC() runs on C {
        if (char2int("A") == 65 and char2int("a") == 97 and char2int(" ") == 32) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
