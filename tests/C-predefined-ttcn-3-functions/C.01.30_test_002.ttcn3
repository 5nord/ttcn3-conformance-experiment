// @requirement: C.1.30 -- This function accepts an enumerated value and returns the integer value associated to the enumerated value (see also clause 6.2.4).
// @id: TTCN3-CORE-C.1.30-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_30_test_002 {

    type enumerated E { e_a, e_b, e_c }

    const E c_e := e_c;

    type component C {}

    testcase TC() runs on C {
        var E v_e := e_a;
        if (enum2int(v_e) == 0 and enum2int(c_e) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
