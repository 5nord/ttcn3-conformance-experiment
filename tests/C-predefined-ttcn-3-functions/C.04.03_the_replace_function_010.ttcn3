// @requirement: C.4.3 -- Note that indexing in strings starts from zero.`
// @id: TTCN3-CORE-C.4.3-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_the_replace_function_010 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_res := replace("abc", 0, 1, "x");
        if (v_res == "xbc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
