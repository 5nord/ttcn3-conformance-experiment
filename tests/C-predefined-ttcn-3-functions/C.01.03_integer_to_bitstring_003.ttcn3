// @requirement: C.1.3 -- The resulting string is length bits long.
// @id: TTCN3-CORE-C.1.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_03_integer_to_bitstring_003 {

    type component C {}

    testcase TC() runs on C {
        if (lengthof(int2bit(3, 7)) == 7 and lengthof(int2bit(0, 1)) == 1 and lengthof(int2bit(255, 8)) == 8) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
