// @requirement: C.5.4 -- If the optional string_serialization parameter is omitted, the default value "UTF-8" is used.
// @id: TTCN3-CORE-C.5.4-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_04_test_014 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 1094861636;

    testcase TC() runs on C {
        var universal charstring v_enc := oct2unichar(bit2oct(encvalue(c_val)), "UTF-8");
        var I v_dec;
        var integer v_res := decvalue_unichar(v_enc, v_dec);
        if (v_res == 0 and v_dec == c_val and lengthof(v_enc) == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
