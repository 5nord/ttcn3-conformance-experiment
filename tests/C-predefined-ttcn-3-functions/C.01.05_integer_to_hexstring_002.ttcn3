// @requirement: C.1.5 -- This function converts a single integer value to a single hexstring value.
// @id: TTCN3-CORE-C.1.5-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_05_integer_to_hexstring_002 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_res := int2hex(171, 2);
        if (v_res == 'AB'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
