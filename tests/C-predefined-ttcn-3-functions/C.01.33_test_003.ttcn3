// @requirement: C.1.33 -- The resulting universal charstring is the same as the string produced by the log operation containing the same operand as the one passed to the any2unistr function.
// @id: TTCN3-CORE-C.1.33-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_33_test_003 {

    type component C {}

    testcase TC() runs on C {
        var integer v_int := 5;
        var template integer mw_int := -1 ifpresent;
        log(v_int);
        log(mw_int);
        if (any2unistr(v_int) == "5" and any2unistr(mw_int) == "-1 ifpresent") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
