// @requirement: C.1.17 -- This function converts a single hexstring value to a single integer value.
// @id: TTCN3-CORE-C.1.17-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_17_hexstring_to_integer_002 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h := '1D7'H;
        var integer v_i := hex2int(v_h);
        if (v_i == 471) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
