// @requirement: C.1.26 -- This function converts a charstring representing an integer value to the equivalent integer.
// @id: TTCN3-CORE-C.1.26-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_26_charstring_to_integer_002 {

    type component C {}

    testcase TC() runs on C {
        if (str2int("66") == 66 and str2int("-66") == -66 and str2int("0") == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
