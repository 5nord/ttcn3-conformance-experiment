// @requirement: C.1.7 -- This function converts the integer value into its string equivalent (the base of the return string is always decimal).
// @id: TTCN3-CORE-C.1.7-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_07_test_002 {

    type component C {}

    testcase TC() runs on C {
        if (int2str(66) == "66" and int2str(-66) == "-66" and int2str(0) == "0") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
