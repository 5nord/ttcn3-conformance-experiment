// @requirement: C.4.2 -- `count is less than zero;` if inpar contains neither AnyValue nor AnyValueOrNone and index + count is greater than lengthof(inpar);
// @id: TTCN3-CORE-C.4.2-028a
// @verdict: pass accept, ttcn3verdict:error
module M_C_04_02_the_substring_function_026 {

    type component C {}

    function f_substr(in integer p_count) return charstring {
        return substr("abcdef", 1, p_count); // error: negative count
    }

    testcase TC() runs on C {
        var charstring v_res := f_substr(-1);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
