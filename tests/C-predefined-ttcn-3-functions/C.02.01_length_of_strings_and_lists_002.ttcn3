// @requirement: C.2.1 -- This function returns the length of a value or template that is of type bitstring, hexstring, octetstring, charstring, universal charstring, record of, set of, array or map. The units of length for each
// @id: TTCN3-CORE-C.2.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_02_01_length_of_strings_and_lists_002 {

    type component C {}
    type record of integer RoI;
    type set of integer SoI;
    type map from charstring to integer MyMap;

    testcase TC() runs on C {
        var integer v_arr[3] := { 1, 2, 3 };
        var MyMap v_map := { ["a"] := 1, ["b"] := 2 };
        if (lengthof('0101'B) == 4 and
            lengthof('ABC'H) == 3 and
            lengthof('0102'O) == 2 and
            lengthof("hello") == 5 and
            lengthof(universal charstring : "hi") == 2 and
            lengthof(RoI : { 1, 2, 3 }) == 3 and
            lengthof(SoI : { 1, 2 }) == 2 and
            lengthof(v_arr) == 3 and
            lengthof(v_map) == 2 and
            lengthof(charstring : ? length(4)) == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
