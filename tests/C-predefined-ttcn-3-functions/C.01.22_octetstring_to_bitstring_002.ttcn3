// @requirement: C.1.22 -- This function converts a single octetstring value to a single bitstring.
// @id: TTCN3-CORE-C.1.22-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_22_octetstring_to_bitstring_002 {

    type component C {}

    testcase TC() runs on C {
        if (oct2bit('01D7'O) == '0000000111010111'B) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
