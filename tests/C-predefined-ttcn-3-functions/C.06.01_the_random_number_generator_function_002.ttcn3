// @requirement: C.6.1 -- The rnd function returns a (pseudo) random number less than 1 but greater or equal to 0.
// @id: TTCN3-CORE-C.6.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_01_the_random_number_generator_function_002 {

    type component C {}

    testcase TC() runs on C {
        var float v_r;
        for (var integer i := 0; i < 1000; i := i + 1) {
            v_r := rnd();
            if (v_r < 0.0 or v_r >= 1.0) {
                setverdict(fail);
            }
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
