// @requirement: C.1.22 -- oct2bit(in octetstring invalue) return bitstring
// @id: TTCN3-CORE-C.1.22-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_22_test_001 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_o := '0F'O;
        var bitstring v_b := oct2bit(v_o);
        if (v_b == '00001111'B) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
