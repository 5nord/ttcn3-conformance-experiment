// @requirement: C.1.25 -- oct2char(in octetstring invalue) return charstring
// @id: TTCN3-CORE-C.1.25-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_25_test_001 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_o := '41'O;
        var charstring v_c := oct2char(v_o);
        if (v_c == "A") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
