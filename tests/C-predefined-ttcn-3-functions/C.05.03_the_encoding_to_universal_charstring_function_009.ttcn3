// @requirement: C.5.3 -- The following values (see ISO/IEC 10646 [2]) are allowed as string_serialization actual parameters (for the description of the UCS encoding scheme see clause 27.5): a) "UTF-8" b) "UTF-16" c) "UTF-16LE" d) "UTF-16BE" e) "UTF-32" f) "UTF-32LE" g) "UTF-32BE"
// @id: TTCN3-CORE-C.5.3-009a
// @verdict: pass reject
module M_C_05_03_the_encoding_to_universal_charstring_function_009 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 65;

    testcase TC() runs on C {
        var universal charstring v_enc := encvalue_unichar(c_val, "ASCII"); // error: not an allowed string_serialization value
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
