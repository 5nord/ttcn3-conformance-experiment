// @requirement: C.1.6 -- The rightmost hexadecimal digit is least significant, the leftmost hexadecimal digit is the most significant.
// @id: TTCN3-CORE-C.1.6-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_06_integer_to_octetstring_005 {

    type component C {}

    testcase TC() runs on C {
        if (int2oct(1, 2) == '0001'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
