// @requirement: C.1.1 -- This function converts an integer value in the range of 0 to 127 (8-bit encoding) into a single-character-length charstring value.
// @id: TTCN3-CORE-C.1.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_01_test_002 {

    type component C {}

    testcase TC() runs on C {
        if (lengthof(int2char(0)) == 1 and lengthof(int2char(65)) == 1 and lengthof(int2char(127)) == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
