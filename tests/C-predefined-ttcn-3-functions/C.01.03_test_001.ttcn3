// @requirement: C.1.3 -- int2bit(in integer invalue, in integer length) return bitstring
// @id: TTCN3-CORE-C.1.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_03_test_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_in := 5;
        var integer v_len := 4;
        var bitstring v_res := int2bit(v_in, v_len);
        if (v_res == '0101'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
