// @requirement: C.1.19 -- The resulting octetstring represents the same value as the hexstring.
// @id: TTCN3-CORE-C.1.19-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_19_hexstring_to_octetstring_003 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h := 'A5F03'H;
        var octetstring v_o := hex2oct(v_h);
        if (oct2int(v_o) == hex2int(v_h)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
