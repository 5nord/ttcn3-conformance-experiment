// @requirement: C.4.2 -- If inpar contains a length matching attribute, the returned value shall be without this attribute.
// @id: TTCN3-CORE-C.4.2-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_the_substring_function_019 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_in := pattern "abc[a-z]" length(4);
        var template charstring v_res := substr(v_in, 0, 2);
        if (match("ab", v_res)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
