// @requirement: C.1.8 -- This function converts an integer value into a float value.
// @id: TTCN3-CORE-C.1.8-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_08_integer_to_float_002 {

    type component C {}

    testcase TC() runs on C {
        if (int2float(4) == 4.0 and int2float(-3) == -3.0 and int2float(0) == 0.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
