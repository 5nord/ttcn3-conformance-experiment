// @requirement: C.4.3 -- `inpar contains neither AnyValue nor AnyValueOrNone and index+len is greater than` lengthof(inpar).
// @id: TTCN3-CORE-C.4.3-032a
// @verdict: pass accept, ttcn3verdict:error
module M_C_04_03_test_032 {

    type component C {}

    testcase TC() runs on C {
        var integer v_index := 12;
        var charstring v_res := replace("My name is JJ", v_index, 2, "xx"); // error: index + len greater than lengthof(inpar)
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
