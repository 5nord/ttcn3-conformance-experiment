// @requirement: C.4.3 -- This template shall fulfil the requirements on the inpar parameter of the substr function specified in clause C.4.2.
// @id: TTCN3-CORE-C.4.3-012a
// @verdict: pass reject
module M_C_04_03_the_replace_function_013 {

    type component C {}

    template charstring mw_list := ("abcd", "efgh");

    testcase TC() runs on C {
        var template charstring v_res := replace(mw_list, 1, 1, "X"); // error: value list not allowed in inpar
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
