// @requirement: C.5.7 -- The get_stringencoding function analyses the encoded_value and returns the UCS encoding scheme according to clause 10 of ISO/IEC 10646 [2] (see also clause 27.5 of the present document).
// @id: TTCN3-CORE-C.5.7-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_07_retrieving_the_type_of_string_encoding_002 {

    type component C {}

    testcase TC() runs on C {
        if (match(get_stringencoding('6869C3BA7A'O), charstring:"UTF-8")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
