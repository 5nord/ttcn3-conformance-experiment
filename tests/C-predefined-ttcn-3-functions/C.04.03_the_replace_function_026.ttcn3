// @requirement: C.4.3 -- If inpar contains a reference to a template with the value or omit restriction, the returned value shall have the value restriction.
// @id: TTCN3-CORE-C.4.3-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_the_replace_function_026 {

    type component C {}

    template (value) charstring m_in := "abcd";

    testcase TC() runs on C {
        var template (value) charstring v_res := replace(m_in, 1, 2, "XY");
        if (valueof(v_res) == "aXYd") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
