// @requirement: C.6.2 -- Coding scheme: UTF-16BE; initial octet sequence: FE FF; comments: no signature meaning
// @id: TTCN3-CORE-C.6.2-004b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_02_the_testcasename_function_006 {

    type component C {}

    testcase TC() runs on C {
        if (oct2unichar('FEFF0068'O, "UTF-16BE") == char(0, 0, 254, 255) & "h") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
