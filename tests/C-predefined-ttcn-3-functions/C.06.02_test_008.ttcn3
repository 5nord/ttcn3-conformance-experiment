// @requirement: C.6.2 -- Coding scheme: UTF-16LE; initial octet sequence: FF FE; comments: no signature meaning
// @id: TTCN3-CORE-C.6.2-005b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_02_test_008 {

    type component C {}

    testcase TC() runs on C {
        if (oct2unichar('FFFE6800'O, "UTF-16LE") == char(0, 0, 254, 255) & "h") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
