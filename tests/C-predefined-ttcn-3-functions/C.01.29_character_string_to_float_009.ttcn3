// @requirement: C.1.29 -- the format of invalue is different than defined above.
// @id: TTCN3-CORE-C.1.29-009a
// @verdict: pass accept, ttcn3verdict:error
module M_C_01_29_character_string_to_float_009 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "1.5abc";
        var float v_res := str2float(v_in); // error: invalue is not a valid number
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
