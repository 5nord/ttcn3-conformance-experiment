// @requirement: C.1.28 -- `invalue contains characters other than specified above.`
// @id: TTCN3-CORE-C.1.28-007a
// @verdict: pass accept, ttcn3verdict:error
module M_C_01_28_character_string_to_octetstring_007 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "12XY";
        var octetstring v_res := str2oct(v_in); // error: invalue contains non-hexadecimal characters
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
