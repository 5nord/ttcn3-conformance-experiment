// @requirement: C.1.14 -- The resulting hexstring represents the same value as the bitstring.
// @id: TTCN3-CORE-C.1.14-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_14_bitstring_to_hexstring_003 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_in := '1011001110001'B;
        if (hex2int(bit2hex(v_in)) == bit2int(v_in)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
