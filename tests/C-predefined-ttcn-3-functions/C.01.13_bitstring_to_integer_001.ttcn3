// @requirement: C.1.13 -- bit2int(in bitstring invalue) return integer
// @id: TTCN3-CORE-C.1.13-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_13_bitstring_to_integer_001 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_in := '101'B;
        var integer v_res := bit2int(v_in);
        if (v_res == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
