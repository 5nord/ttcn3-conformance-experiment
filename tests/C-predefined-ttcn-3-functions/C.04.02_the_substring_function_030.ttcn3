// @requirement: C.4.2 -- the template passed to the inpar parameter is not of type bitstring, hexstring, octetstring, charstring, universal charstring, record of, set of, or array.
// @id: TTCN3-CORE-C.4.2-031a
// @verdict: pass reject
module M_C_04_02_the_substring_function_030 {

    type component C {}

    testcase TC() runs on C {
        var template integer v_in := 12345;
        var template integer v_res := substr(v_in, 0, 1); // error: inpar is an integer
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
