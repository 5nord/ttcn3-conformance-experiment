// @requirement: C.4.3 -- If any of the substr calls in the previous point would yield a template with the ifpresent matching attribute, this attribute is removed before concatenation and added to the final result of the concatenation.
// @id: TTCN3-CORE-C.4.3-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_test_024 {

    type component C {}

    type record R {
        bitstring f optional
    }

    const R c_replaced := { f := '0111'B };
    const R c_omitted := { f := omit };
    const R c_original := { f := '0101'B };

    testcase TC() runs on C {
        var template bitstring v_in := '0101'B ifpresent;
        var template bitstring v_res := replace(v_in, 1, 2, '11'B);
        var template R v_r := { f := v_res };
        if (match(c_replaced, v_r) and match(c_omitted, v_r) and not match(c_original, v_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
