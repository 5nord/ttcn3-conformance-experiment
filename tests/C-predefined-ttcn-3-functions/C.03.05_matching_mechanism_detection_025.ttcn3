// @requirement: C.3.5 -- Table C.1:: "pattern"; Allowed values of kind parameter: Matching character pattern; Col3: B.1.5
// @id: TTCN3-CORE-C.3.5-034a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_03_05_matching_mechanism_detection_025 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_t := pattern "a*b";
        if (istemplatekind(v_t, "pattern")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
