// @requirement: C.1.6 -- The number of hexadecimal digits provided shall be multiples of 2 since one octet is composed of two hexadecimal digits.
// @id: TTCN3-CORE-C.1.6-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_06_integer_to_octetstring_007 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_res := int2oct(4095, 2);
        if (v_res == '0FFF'O and lengthof(oct2hex(v_res)) mod 2 == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
