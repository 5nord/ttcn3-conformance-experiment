// @requirement: C.5.4 -- The octetstring is subsequently converted into a bitstring by the oct2bit function.
// @id: TTCN3-CORE-C.5.4-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_04_the_decoding_from_universal_charstring_function_022 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_a := 1094861636;
    const I c_b := 1162233672;

    testcase TC() runs on C {
        var universal charstring v_enc := encvalue_unichar(c_a) & encvalue_unichar(c_b);
        var bitstring v_bits := oct2bit(unichar2oct(v_enc, "UTF-8"));
        var I v_dec, v_ref;
        var integer v_res_ref := decvalue(v_bits, v_ref);
        var integer v_res := decvalue_unichar(v_enc, v_dec, "UTF-8");
        if (v_res_ref == 0 and v_res == 0 and v_dec == v_ref and
            unichar2oct(v_enc, "UTF-8") == bit2oct(v_bits)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
