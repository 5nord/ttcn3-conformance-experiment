// @requirement: C.2.2 -- when inpar is a template and it can match values of different sizes;
// @id: TTCN3-CORE-C.2.2-007a
// @verdict: pass accept, ttcn3verdict:error
module M_C_02_02_number_of_elements_in_a_structured_value_007 {

    type component C {}
    type set S {
        integer f1,
        bitstring f2 optional,
        charstring f3 optional
    }

    function f_size(template (present) S p_t) return integer {
        return sizeof(p_t);
    }

    testcase TC() runs on C {
        var integer v_size := f_size(?); // error: matches values of different sizes
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
