// @requirement: C.1.25 -- The resulting charstring shall have the same length as the input octetstring.
// @id: TTCN3-CORE-C.1.25-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_25_test_004 {

    type component C {}

    testcase TC() runs on C {
        if (lengthof(oct2char('4469707379'O)) == 5) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
