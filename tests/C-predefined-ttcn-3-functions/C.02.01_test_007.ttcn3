// @requirement: C.2.1 -- In particular, the length of a fixed length record of or set of value will always be the fixed length according to the type definition.
// @id: TTCN3-CORE-C.2.1-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_02_01_test_007 {

    type component C {}
    type record length(4) of integer RoI4;
    type set length(3) of integer SoI3;

    testcase TC() runs on C {
        var RoI4 v_r;
        var SoI3 v_s;
        v_r[0] := 1;
        v_s[1] := 2;
        if (lengthof(v_r) == 4 and lengthof(v_s) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
