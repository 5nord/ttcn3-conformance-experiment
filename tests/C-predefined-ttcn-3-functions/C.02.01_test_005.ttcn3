// @requirement: C.2.1 -- For values of the map type, the function returns the number of key value pairs in the map.
// @id: TTCN3-CORE-C.2.1-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_02_01_test_005 {

    type component C {}
    type map from charstring to integer MyMap;

    testcase TC() runs on C {
        var MyMap v_map := { ["a"] := 1, ["b"] := 2, ["c"] := 3 };
        if (lengthof(v_map) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
