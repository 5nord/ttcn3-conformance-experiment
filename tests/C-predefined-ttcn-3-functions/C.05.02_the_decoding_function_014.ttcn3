module M_C_05_02_the_decoding_function_014 {

    type component C {}

    type integer I with { variant "32 bit" };

    testcase TC() runs on C {
        var octetstring v_enc := '41424344'O;
        var I v_dec;
        var integer v_res := decvalue(v_enc, v_dec); // error: encoded_value is not a bitstring
