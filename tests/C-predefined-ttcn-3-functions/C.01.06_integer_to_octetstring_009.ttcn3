// @requirement: C.1.6 -- If the conversion yields a value with fewer hexadecimal digits than specified in the length parameter, then the hexstring shall be padded on the left with zeros.
// @id: TTCN3-CORE-C.1.6-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_06_integer_to_octetstring_009 {

    type component C {}

    testcase TC() runs on C {
        if (int2oct(10, 3) == '00000A'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
