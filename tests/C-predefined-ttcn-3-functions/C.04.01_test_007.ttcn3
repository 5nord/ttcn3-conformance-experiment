// @requirement: C.4.1 -- If this matching is successful, the substring of inpar shall be returned, which matched the groupno-s group of expression during the matching.
// @id: TTCN3-CORE-C.4.1-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_01_test_007 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "  simple text for a regexp example  ";
        var charstring v_res := regexp(v_in, charstring:"(?+)(text)(?+)", 2);
        if (v_res == " for a regexp example  ") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
