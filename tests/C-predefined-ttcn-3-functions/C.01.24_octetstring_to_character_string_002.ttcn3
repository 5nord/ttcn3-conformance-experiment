// @requirement: C.1.24 -- This function converts an octetstring `invalue to an charstring representing the string equivalent of the` input value.
// @id: TTCN3-CORE-C.1.24-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_24_octetstring_to_character_string_002 {

    type component C {}

    testcase TC() runs on C {
        if (oct2str('4469707379'O) == "4469707379") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
