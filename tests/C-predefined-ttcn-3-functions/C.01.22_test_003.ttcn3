// @requirement: C.1.22 -- The resulting bitstring represents the same value as the octetstring.
// @id: TTCN3-CORE-C.1.22-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_22_test_003 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_o := 'A5C3'O;
        if (bit2int(oct2bit(v_o)) == oct2int(v_o) and lengthof(oct2bit(v_o)) == 16) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
