// @requirement: C.5.5 -- When the actual parameter that is passed to inpar is a template, it shall resolve to a specific value (the same restrictions apply as for the argument of the send statement).
// @id: TTCN3-CORE-C.5.5-003a
// @verdict: pass reject
module M_C_05_05_the_encoding_to_octetstring_function_003 {

    type component C {}

    type record R {
        integer f1,
        integer f2
    } with { encode "JSON" }

    template R mw_r := { f1 := 1, f2 := ? };

    function f_encode() return octetstring {
        var integer v_len;
        return encvalue_o(mw_r, "", "", v_len); // error: template does not resolve to a specific value
    }
}
