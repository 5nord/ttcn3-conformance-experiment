// @requirement: C.6.2 -- Coding scheme: UTF-16; initial octet sequence: FE FF FF FE; comments: signature (default FE FF)
// @id: TTCN3-CORE-C.6.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_02_test_009 {

    type component C {}

    testcase TC() runs on C {
        if (remove_bom('FEFF00680069'O) == '00680069'O and
            remove_bom('FFFE68006900'O) == '68006900'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
