module M_C_03_05_matching_mechanism_detection_005 {

    type component C {}

    testcase TC() runs on C {
        var template integer v_t1 := ?;
        var template integer v_t2 := (0, 1, 2);
        var template integer v_t3 := 5;
        if (not istemplatekind(v_t1, "AnyValueOrNone") and
            not istemplatekind(v_t2, "complement") and
            not istemplatekind(v_t3, "range") and
            not istemplatekind(v_t3, "length")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
