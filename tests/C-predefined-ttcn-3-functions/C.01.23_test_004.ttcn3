// @requirement: C.1.23 -- For the purpose of this conversion, a octetstring shall be converted into a hexstring containing the same sequence of hex digits as the octetstring.
// @id: TTCN3-CORE-C.1.23-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_23_test_004 {

    type component C {}

    testcase TC() runs on C {
        if (oct2hex('0123456789ABCDEF'O) == '0123456789ABCDEF'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
