// @requirement: C.1.18 -- '0'H → '0000'B, '1'H → '0001'B, '2'H → '0010'B, '3'H → '0011'B, '4'H → '0100'B, '5'H → '0101'B,
// @id: TTCN3-CORE-C.1.18-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_18_hexstring_to_bitstring_005 {

    type component C {}

    testcase TC() runs on C {
        if (hex2bit('0'H) == '0000'B and
            hex2bit('1'H) == '0001'B and
            hex2bit('2'H) == '0010'B and
            hex2bit('3'H) == '0011'B and
            hex2bit('4'H) == '0100'B and
            hex2bit('5'H) == '0101'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
