// @requirement: C.1.5 -- If the conversion yields a value with fewer hexadecimal digits than specified in the length parameter, then the hexstring shall be padded on the left with zeros.
// @id: TTCN3-CORE-C.1.5-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_05_test_008 {

    type component C {}

    testcase TC() runs on C {
        if (int2hex(10, 4) == '000A'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
