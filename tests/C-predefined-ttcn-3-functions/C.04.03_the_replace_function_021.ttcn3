// @requirement: C.4.3 -- To a compatible binary string containing a single AnyElementOrNone if inpar is of a binary string type
// @id: TTCN3-CORE-C.4.3-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_the_replace_function_021 {

    type component C {}

    testcase TC() runs on C {
        var template octetstring v_repl := ?;
        var template octetstring v_res := replace('AABB'O, 1, 0, v_repl);
        if (match('AABB'O, v_res) and match('AA0102BB'O, v_res) and not match('BB'O, v_res)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
