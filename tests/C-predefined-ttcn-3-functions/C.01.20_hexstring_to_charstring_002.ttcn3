// @requirement: C.1.20 -- This function converts a single hexstring value to a single charstring.
// @id: TTCN3-CORE-C.1.20-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_20_hexstring_to_charstring_002 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h := 'AB801'H;
        var charstring v_s := hex2str(v_h);
        if (v_s == "AB801") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
