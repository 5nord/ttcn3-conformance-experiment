// @requirement: C.5.1 -- encvalue(in template (value) any inpar, in universal charstring encoding_info := "", in universal charstring dynamic_encoding := "") return bitstring
// @id: TTCN3-CORE-C.5.1-001a
// @verdict: pass accept, noexecution
module M_C_05_01_the_encoding_function_001 {

    type integer MyInt with { encode "CodecA" }

    function f_encode(MyInt p_value) {
        var bitstring v_enc1 := encvalue(p_value);
        var bitstring v_enc2 := encvalue(p_value, "info");
        var bitstring v_enc3 := encvalue(p_value, "info", "CodecA");
    }
}
