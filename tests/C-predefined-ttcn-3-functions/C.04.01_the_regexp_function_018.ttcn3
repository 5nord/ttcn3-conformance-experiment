// @requirement: C.4.1 -- `inpar is of charstring type and expression is of universal charstring type;`
// @id: TTCN3-CORE-C.4.1-020a
// @verdict: pass reject
module M_C_04_01_the_regexp_function_018 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "  simple text for a regexp example  ";
        var charstring v_res := regexp(v_in, universal charstring:"?+(text)?+", 0); // error: charstring inpar with universal charstring expression
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
