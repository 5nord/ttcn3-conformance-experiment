// @requirement: C.4.2 -- If inpar contains the ifpresent matching attribute, the returned value shall contain this attribute as well.
// @id: TTCN3-CORE-C.4.2-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_the_substring_function_020 {

    type record R {
        charstring f optional
    }

    type component C {}

    testcase TC() runs on C {
        var template R v_src := { f := pattern "abc" ifpresent };
        var template R v_chk := { f := substr(v_src.f, 0, 2) };
        if (match({ f := omit }, v_chk) and match({ f := "ab" }, v_chk) and not match({ f := "abc" }, v_chk)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
