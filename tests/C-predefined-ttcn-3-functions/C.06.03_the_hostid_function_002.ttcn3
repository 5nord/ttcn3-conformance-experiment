// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_03_the_hostid_function_002 {

    type component C {}

    testcase TC() runs on C {
        if (hostid() == hostid("Ipv4orIPv6")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
