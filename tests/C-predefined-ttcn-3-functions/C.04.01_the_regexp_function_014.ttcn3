// @requirement: C.4.1 -- NOTE: This function differs from other well-known regular expression matching implementations in that: a) It matches the whole inpar string instead of only a substring.
// @id: TTCN3-CORE-C.4.1-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_01_the_regexp_function_014 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "xxabcxx";
        var charstring v_res1 := regexp(v_in, charstring:"a(b)c", 0);
        var charstring v_res2 := regexp(v_in, charstring:"?+a(b)c?+", 0);
        if (v_res1 == "" and v_res2 == "b") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
