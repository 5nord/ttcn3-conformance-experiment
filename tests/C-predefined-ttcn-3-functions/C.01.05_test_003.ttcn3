// @requirement: C.1.5 -- The resulting string is length hexadecimal digits long.
// @id: TTCN3-CORE-C.1.5-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_05_test_003 {

    type component C {}

    testcase TC() runs on C {
        if (lengthof(int2hex(3, 5)) == 5 and lengthof(int2hex(0, 1)) == 1 and lengthof(int2hex(4095, 3)) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
