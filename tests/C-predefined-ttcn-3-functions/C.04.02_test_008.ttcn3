// @requirement: C.4.2 -- The units of length for string types are as defined in table 4 of the present document.
// @id: TTCN3-CORE-C.4.2-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_test_008 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '10110011'B;
        var hexstring v_h := 'ABCDEF'H;
        var octetstring v_o := 'ABCDEF01'O;
        var charstring v_c := "abcdef";
        var universal charstring v_u := char(0, 0, 1, 0) & char(0, 0, 1, 1) & char(0, 0, 1, 2);
        if (substr(v_b, 1, 2) == '01'B and
            substr(v_h, 1, 2) == 'BC'H and
            substr(v_o, 1, 2) == 'CDEF'O and
            substr(v_c, 1, 2) == "bc" and
            substr(v_u, 1, 2) == char(0, 0, 1, 1) & char(0, 0, 1, 2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
