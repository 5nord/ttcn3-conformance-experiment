// @requirement: C.1.15 -- The resulting octetstring represents the same value as the bitstring.
// @id: TTCN3-CORE-C.1.15-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_15_bitstring_to_octetstring_003 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '1010101111110000'B;
        var octetstring v_o := bit2oct(v_b);
        if (v_o == 'ABF0'O and oct2int(v_o) == bit2int(v_b)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
