// @requirement: C.6.1 -- seed is infinity, -infinity or not_a_number.
// @id: TTCN3-CORE-C.6.1-013a
// @verdict: pass accept, ttcn3verdict:error
module M_C_06_01_test_011 {

    type component C {}

    testcase TC() runs on C {
        var float v_seed := infinity;
        var float v_r := rnd(v_seed); // seed is infinity
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
