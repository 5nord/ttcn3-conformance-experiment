// @requirement: C.5.5 -- The returned octetstring represents the encoded value of inpar, however, the TTCN-3 test system need not make any check on its correctness.
// @id: TTCN3-CORE-C.5.5-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_05_the_encoding_to_octetstring_function_005 {

    type component C {}

    type record R {
        integer f1,
        integer f2
    } with { encode "JSON" }

    const R c_r := { f1 := 1, f2 := 2 };

    testcase TC() runs on C {
        var integer v_len;
        var bitstring v_bits := encvalue(c_r);
        var octetstring v_o := encvalue_o(c_r, "", "", v_len);
        if (v_o == bit2oct(v_bits)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
