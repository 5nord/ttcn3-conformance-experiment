// @requirement: C.5.2 -- The return value 1 indicates an unspecified cause of decoding failure.
// @id: TTCN3-CORE-C.5.2-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_02_test_011 {

    type component C {}

    type integer I with { variant "32 bit" };

    type enumerated E { e_one(1), e_two(2) } with { variant "32 bit" };

    testcase TC() runs on C {
        var I v_zero := 0;
        var bitstring v_enc := encvalue(v_zero);
        var E v_dec;
        // 0 is not the ordinal value of any enumerated value of E
        if (decvalue(v_enc, v_dec) == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
