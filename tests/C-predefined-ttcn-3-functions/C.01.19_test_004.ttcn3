// @requirement: C.1.19 -- For the purpose of this conversion, a hexstring shall be converted into a octetstring, where the octetstring contains the same sequence of hex digits as the hexstring when the length of the hexstring modulo 2 is 0.
// @id: TTCN3-CORE-C.1.19-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_19_test_004 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h := '0AB1F9'H;
        var octetstring v_o := hex2oct(v_h);
        if (v_o == '0AB1F9'O and oct2hex(v_o) == v_h) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
