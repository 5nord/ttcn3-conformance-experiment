// @requirement: C.1.29 -- str2float(in charstring invalue) return float
// @id: TTCN3-CORE-C.1.29-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_29_test_001 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "2.5";
        var float v_res := str2float(v_in);
        if (v_res == 2.5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
