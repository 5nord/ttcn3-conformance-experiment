// @requirement: C.6.2 -- The testcasename function shall return the unqualified name of the actually executing test case.
// @id: TTCN3-CORE-C.6.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_02_test_002 {

    type component C {}

    function f_check() runs on C {
        if (testcasename() == "TC") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_check());
        f_check();
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
