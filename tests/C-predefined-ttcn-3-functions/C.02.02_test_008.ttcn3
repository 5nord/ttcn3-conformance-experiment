// @requirement: C.2.2 -- the template passed to the inpar parameter is not of a record or set type.
// @id: TTCN3-CORE-C.2.2-008a
// @verdict: pass reject
module M_C_02_02_test_008 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 5;
        var integer v_size := sizeof(v_i); // error: integer is not a record or set type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
