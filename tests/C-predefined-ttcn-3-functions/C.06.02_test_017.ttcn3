// @requirement: C.6.2 -- When the function testcasename is called if the control part is being executed but no testcase, it shall return the empty string.
// @id: TTCN3-CORE-C.6.2-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_02_test_017 {

    type component C {}

    testcase TC(charstring p_name) runs on C {
        if (p_name == "") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var charstring v_name := testcasename();
        execute(TC(v_name));
    }
}
