// @requirement: C.6.1 -- To produce a random integers in a given range, the following formula can be used: float2int(int2float(upperbound - lowerbound +1)*rnd()) + lowerbound
// @id: TTCN3-CORE-C.6.1-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_01_test_009 {

    type component C {}

    testcase TC() runs on C {
        const integer c_lower := 3;
        const integer c_upper := 7;
        var integer v_n;
        for (var integer i := 0; i < 1000; i := i + 1) {
            v_n := float2int(int2float(c_upper - c_lower + 1) * rnd()) + c_lower;
            if (v_n < c_lower or v_n > c_upper) {
                setverdict(fail);
            }
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
