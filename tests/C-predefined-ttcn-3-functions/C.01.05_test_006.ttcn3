// @requirement: C.1.5 -- The rightmost hexadecimal digit is least significant, the leftmost hexadecimal digit is the most significant.
// @id: TTCN3-CORE-C.1.5-005b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_05_test_006 {

    type component C {}

    testcase TC() runs on C {
        if (int2hex(256, 3) == '100'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
