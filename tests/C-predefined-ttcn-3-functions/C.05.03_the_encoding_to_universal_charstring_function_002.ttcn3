// @requirement: C.5.3 -- The encvalue_unichar function encodes a value or template into a universal charstring.
// @id: TTCN3-CORE-C.5.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_03_the_encoding_to_universal_charstring_function_002 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 1094861636;
    template I m_val := 1162233672;

    testcase TC() runs on C {
        var universal charstring v_enc_v := encvalue_unichar(c_val);
        var universal charstring v_enc_t := encvalue_unichar(m_val);
        var I v_dec_v, v_dec_t;
        var integer v_res_v := decvalue_unichar(v_enc_v, v_dec_v);
        var integer v_res_t := decvalue_unichar(v_enc_t, v_dec_t);
        if (v_res_v == 0 and v_dec_v == c_val and v_res_t == 0 and match(v_dec_t, m_val)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
