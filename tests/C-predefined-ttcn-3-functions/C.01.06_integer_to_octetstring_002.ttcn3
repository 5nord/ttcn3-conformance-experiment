// @requirement: C.1.6 -- This function converts a single integer value to a single octetstring value.
// @id: TTCN3-CORE-C.1.6-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_06_integer_to_octetstring_002 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_res := int2oct(171, 1);
        if (v_res == 'AB'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
