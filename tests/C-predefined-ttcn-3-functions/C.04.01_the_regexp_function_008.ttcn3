// @requirement: C.4.1 -- Group numbers are assigned by the order of occurrences of the opening bracket of a group and counted starting from 0 by step 1.
// @id: TTCN3-CORE-C.4.1-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_01_the_regexp_function_008 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abcd";
        if (regexp(v_in, charstring:"((a)(b))(c)d", 0) == "ab" and
            regexp(v_in, charstring:"((a)(b))(c)d", 1) == "a" and
            regexp(v_in, charstring:"((a)(b))(c)d", 2) == "b" and
            regexp(v_in, charstring:"((a)(b))(c)d", 3) == "c") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
