// @requirement: C.5.5 -- When the actual parameter that is passed to inpar is a template, it shall resolve to a specific value (the same restrictions apply as for the argument of the send statement).
// @id: TTCN3-CORE-C.5.5-003b
// @verdict: pass reject
module M_C_05_05_the_encoding_to_octetstring_function_004 {

    type component C {}

    type record R {
        integer f1,
        integer f2
    } with { encode "JSON" }

    type record S {
        integer f1,
        integer f2
    } with { encode "JSON" }

    function f_encode() return octetstring {
        var integer v_len;
        return encvalue_o({ f1 := 1, f2 := 2 }, "", "", v_len); // error: type of in-line template is ambiguous
    }
}
