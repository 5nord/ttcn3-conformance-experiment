// @requirement: C.1.29 -- leading "+" sign before positive values is allowed;
// @id: TTCN3-CORE-C.1.29-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_29_character_string_to_float_005 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "+1.5";
        if (str2float(v_in) == 1.5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
