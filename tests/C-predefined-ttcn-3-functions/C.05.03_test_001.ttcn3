// @requirement: C.5.3 -- encvalue_unichar(in template (value) any inpar, in charstring string_serialization := "UTF-8", in universal charstring encoding_info := "", in universal charstring dynamic_encoding := "") return universal charstring
// @id: TTCN3-CORE-C.5.3-001a
// @verdict: pass accept, noexecution
module M_C_05_03_test_001 {

    type integer I with { variant "32 bit" };

    template I m_val := 65;

    function f_encode(I p_val) return universal charstring {
        var universal charstring v_r1 := encvalue_unichar(p_val);
        var universal charstring v_r2 := encvalue_unichar(m_val, "UTF-16");
        var universal charstring v_r3 := encvalue_unichar(p_val, "UTF-8", "info");
        var universal charstring v_r4 := encvalue_unichar(p_val, "UTF-32", "info", "");
        return v_r1 & v_r2 & v_r3 & v_r4;
    }
}
