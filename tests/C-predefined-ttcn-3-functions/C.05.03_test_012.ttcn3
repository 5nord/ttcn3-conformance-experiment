// @requirement: C.5.3 -- function encvalue_unichar(in template(value) any inpar, in charstring enc in universal charstring encoding_info := "", in universal charstring dynamic_encoding := "") return universal charstring { return oct2unichar(bit2oct(encvalue(inpar, encoding_info, dynamic_encoding)), enc); }
// @id: TTCN3-CORE-C.5.3-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_03_test_012 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 1094861636;

    function f_equiv(in template (value) I p_inpar, in charstring p_enc,
                     in universal charstring p_info := "",
                     in universal charstring p_dyn := "") return universal charstring {
        return oct2unichar(bit2oct(encvalue(p_inpar, p_info, p_dyn)), p_enc);
    }

    testcase TC() runs on C {
        if (encvalue_unichar(c_val, "UTF-8", "info", "") == f_equiv(c_val, "UTF-8", "info", "") and
            encvalue_unichar(c_val, "UTF-16LE") == f_equiv(c_val, "UTF-16LE")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
