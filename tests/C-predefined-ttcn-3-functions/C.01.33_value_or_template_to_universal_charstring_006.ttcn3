// @requirement: C.1.33 -- When the optional format parameter takes the value "canonical": unbound fields are represented in the output as "-", the fields and members of structured types are represented recursively in assignment notation.
// @id: TTCN3-CORE-C.1.33-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_33_value_or_template_to_universal_charstring_006 {

    type component C {}

    testcase TC() runs on C {
        var template integer mw_int;
        if (any2unistr(mw_int, "canonical") == "-") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
