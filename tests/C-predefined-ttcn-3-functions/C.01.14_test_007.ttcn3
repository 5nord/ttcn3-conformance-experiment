// @requirement: C.1.14 -- The consecutive order of hex digits in the resulting hexstring is the same as the order of groups of 4 bits in the bitstring.
// @id: TTCN3-CORE-C.1.14-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_14_test_007 {

    type component C {}

    testcase TC() runs on C {
        if (bit2hex('000100100011'B) == '123'H and bit2hex('001100100001'B) == '321'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
