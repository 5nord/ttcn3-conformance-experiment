// @requirement: C.1.4 -- The integer value shall be provided as in parameter and the result of the conversion shall be stored in an out parameter.
// @id: TTCN3-CORE-C.1.4-003a
// @verdict: pass reject
module M_C_01_04_test_003 {

    type enumerated E {
        e_mon, e_tue, e_wed, e_weekend(6..7)
    }

    type component C {}

    testcase TC() runs on C {
        var E v_out;
        int2enum(1.0, v_out); // error: inpar is not an integer
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
