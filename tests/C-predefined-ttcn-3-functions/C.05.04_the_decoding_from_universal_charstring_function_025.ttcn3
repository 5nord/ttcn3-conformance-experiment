// @requirement: C.5.4 -- This universal charstring is then assigned to the encoded_value parameter.
// @id: TTCN3-CORE-C.5.4-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_04_the_decoding_from_universal_charstring_function_025 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_a := 1094861636;
    const I c_b := 1162233672;

    function f_decode(inout universal charstring p_enc) return integer {
        var I v_dec;
        return decvalue_unichar(p_enc, v_dec, "UTF-16BE");
    }

    testcase TC() runs on C {
        var universal charstring v_enc_b := encvalue_unichar(c_b, "UTF-16BE");
        var universal charstring v_enc := encvalue_unichar(c_a, "UTF-16BE") & v_enc_b;
        var integer v_res := f_decode(v_enc);
        if (v_res == 0 and v_enc == v_enc_b) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
