// @requirement: C.2.1 -- The length of an universal charstring shall be calculated by counting each combining character and hangul syllable character (including fillers) on its own (see ISO/IEC 10646 [2], clauses 23 and 24).
// @id: TTCN3-CORE-C.2.1-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_02_01_test_009 {

    type component C {}

    testcase TC() runs on C {
        // "e" followed by U+0301 COMBINING ACUTE ACCENT
        var universal charstring v_comb := "e" & char(0, 0, 3, 1);
        // U+1100 choseong kiyeok, U+1161 jungseong a
        var universal charstring v_hangul := char(0, 0, 17, 0) & char(0, 0, 17, 97);
        // U+115F choseong filler, U+1160 jungseong filler, U+1161 jungseong a
        var universal charstring v_fill := char(0, 0, 17, 95) & char(0, 0, 17, 96) & char(0, 0, 17, 97);
        if (lengthof(v_comb) == 2 and lengthof(v_hangul) == 2 and lengthof(v_fill) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
