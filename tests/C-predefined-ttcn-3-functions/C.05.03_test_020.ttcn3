// @requirement: C.5.3 -- In addition to the general error causes in clause 16.1.2, error causes are: The given string encoding is not recognized.
// @id: TTCN3-CORE-C.5.3-021a
// @verdict: pass accept, ttcn3verdict:error
module M_C_05_03_test_020 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 65;

    function f_encode(charstring p_ser) return universal charstring {
        return encvalue_unichar(c_val, p_ser);
    }

    testcase TC() runs on C {
        setverdict(pass);
        var universal charstring v_enc := f_encode("UTF-7"); // error: string encoding not recognized
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
