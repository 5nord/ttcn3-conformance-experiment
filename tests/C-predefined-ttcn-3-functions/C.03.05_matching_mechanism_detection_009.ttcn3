// @requirement: C.3.5 -- a) Calling the istemplatekind function with a different second parameter than stated in table C.1 shall lead to an error.
// @id: TTCN3-CORE-C.3.5-016a
// @verdict: pass accept, ttcn3verdict:error
module M_C_03_05_matching_mechanism_detection_009 {

    type component C {}

    function f_check(template integer p_t, charstring p_kind) return boolean {
        return istemplatekind(p_t, p_kind);
    }

    testcase TC() runs on C {
        var boolean v_res := f_check(?, "anyvalue"); // error: kind not listed in table C.1
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
