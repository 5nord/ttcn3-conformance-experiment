// @requirement: C.1.25 -- This function converts an octetstring `invalue to a charstring.
// @id: TTCN3-CORE-C.1.25-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_25_test_002 {

    type component C {}

    testcase TC() runs on C {
        if (oct2char('4469707379'O) == "Dipsy") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
