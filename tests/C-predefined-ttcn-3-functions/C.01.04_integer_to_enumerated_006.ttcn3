// @requirement: C.1.4 -- The type of the out parameter determines the type into which the in parameter is converted. int2enum ( in integer inpar, out Enumerated_type outpar)
// @id: TTCN3-CORE-C.1.4-004b
// @verdict: pass reject
module M_C_01_04_integer_to_enumerated_006 {

    type component C {}

    testcase TC() runs on C {
        var integer v_out;
        int2enum(1, v_out); // error: outpar is not of an enumerated type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
