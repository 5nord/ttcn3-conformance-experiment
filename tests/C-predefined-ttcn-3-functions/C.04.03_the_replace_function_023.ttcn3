// @requirement: C.4.3 -- The replace function then returns a value that is equal to the following expression: **-** **substr(inpar, 0, index) & repl &** **substr(inpar, index + len, lengthof(inpar) - index - len)**
// @id: TTCN3-CORE-C.4.3-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_the_replace_function_023 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_in := pattern "ab?de";
        var template charstring v_res := replace(v_in, 1, 2, "XY");
        var template charstring v_exp := substr(v_in, 0, 1) & "XY" & substr(v_in, 3, lengthof(v_in) - 3);
        if (match("aXYde", v_res) and match("aXYde", v_exp) and
            not match("abzde", v_res) and not match("aXYzde", v_res)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
