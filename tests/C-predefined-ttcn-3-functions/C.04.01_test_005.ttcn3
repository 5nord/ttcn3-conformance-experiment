// @requirement: C.4.1 -- If inpar is a literal (i.e. type is not explicitly given) the corresponding type shall be retrieved from the value contents.
// @id: TTCN3-CORE-C.4.1-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_01_test_005 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_res := regexp("xyz", charstring:"x(?)z", 0);
        if (v_res == "y") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
