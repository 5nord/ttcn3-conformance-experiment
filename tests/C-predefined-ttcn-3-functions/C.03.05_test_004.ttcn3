// @requirement: C.3.5 -- If the matching mechanism kind enquired is a matching attribute (clause B.1.4), the function shall return true if the template in the invalue parameter has this kind of matching attribute attached to it directly (i.e. it doesn't count if the attribute is attached to a field of invalue at any level of nesting).
// @id: TTCN3-CORE-C.3.5-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_03_05_test_004 {

    type component C {}
    type record R {
        integer f1 optional
    }
    type record of charstring RoC;

    testcase TC() runs on C {
        var template integer v_t1 := (0, 1, 2) ifpresent;
        var template R v_t2 := { f1 := 1 ifpresent };
        var template RoC v_t3 := { ? length(2) };
        var template RoC v_t4 := { ? } length(1);
        if (istemplatekind(v_t1, "ifpresent") and
            not istemplatekind(v_t2, "ifpresent") and
            not istemplatekind(v_t3, "length") and
            istemplatekind(v_t4, "length")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
