// @requirement: C.3.5 -- istemplatekind (in template any_type invalue, in charstring kind) return boolean
// @id: TTCN3-CORE-C.3.5-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_03_05_test_001 {

    type component C {}

    testcase TC() runs on C {
        var template integer v_t := ?;
        var charstring v_kind := "AnyValue";
        var boolean v_res := istemplatekind(v_t, v_kind);
        if (v_res) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
