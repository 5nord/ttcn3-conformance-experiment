// @requirement: C.1.28 -- When the string invalue contains even number characters the resulting octetstring contains 0 as leftmost character followed by the same sequence of characters as in the charstring.
// @id: TTCN3-CORE-C.1.28-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_28_character_string_to_octetstring_004 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "1D7";
        if (str2oct(v_in) == '01D7'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
