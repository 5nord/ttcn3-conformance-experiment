// @requirement: C.4.2 -- If inpar contains a reference to a template with the value or omit restriction, the returned value shall have the value restriction.
// @id: TTCN3-CORE-C.4.2-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_the_substring_function_022 {

    type component C {}

    testcase TC() runs on C {
        var template (omit) charstring v_in := "abcd";
        var template (value) charstring v_res := substr(v_in, 1, 2);
        if (isvalue(v_res) and valueof(v_res) == "bc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
