// @requirement: C.1.27 -- The resulting hexstring will have the same length as the incoming charstring.
// @id: TTCN3-CORE-C.1.27-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_27_character_string_to_hexstring_005 {

    type component C {}

    testcase TC() runs on C {
        if (lengthof(str2hex("ABC")) == 3) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
