// @requirement: C.1.24 -- The consecutive order of characters in the resulting charstring is the same as the order of hex digits in the octetstring.
// @id: TTCN3-CORE-C.1.24-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_24_test_005 {

    type component C {}

    testcase TC() runs on C {
        if (oct2str('AB01'O) == "AB01") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
