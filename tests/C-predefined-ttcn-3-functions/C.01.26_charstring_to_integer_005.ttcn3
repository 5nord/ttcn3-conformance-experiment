// @requirement: C.1.26 -- `invalue contains the character "-" at another position than the leftmost one.`
// @id: TTCN3-CORE-C.1.26-005a
// @verdict: pass accept, ttcn3verdict:error
module M_C_01_26_charstring_to_integer_005 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_c := "6-6";
        var integer v_i := str2int(v_c); // error: "-" not at the leftmost position
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
