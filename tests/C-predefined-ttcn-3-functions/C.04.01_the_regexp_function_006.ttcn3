// @requirement: C.4.1 -- If this matching is unsuccessful, an empty string shall be returned.
// @id: TTCN3-CORE-C.4.1-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_01_the_regexp_function_006 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abc";
        var charstring v_res := regexp(v_in, charstring:"x(?)z", 0);
        if (v_res == "") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
