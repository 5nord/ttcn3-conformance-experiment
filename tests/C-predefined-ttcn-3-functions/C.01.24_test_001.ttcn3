// @requirement: C.1.24 -- oct2str(in octetstring invalue) return charstring
// @id: TTCN3-CORE-C.1.24-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_24_test_001 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_o := '0F'O;
        var charstring v_c := oct2str(v_o);
        if (v_c == "0F") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
