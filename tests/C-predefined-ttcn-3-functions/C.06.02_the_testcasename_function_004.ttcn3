// @requirement: C.6.2 -- Coding scheme: UTF-8; initial octet sequence: EF BB BF; comments: signature not required / no effect
// @id: TTCN3-CORE-C.6.2-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_02_the_testcasename_function_004 {

    type component C {}

    testcase TC() runs on C {
        if (get_stringencoding('6869C3BA7A'O) == "UTF-8" and
            oct2unichar('6869'O, "UTF-8") == oct2unichar(remove_bom('EFBBBF6869'O), "UTF-8")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
