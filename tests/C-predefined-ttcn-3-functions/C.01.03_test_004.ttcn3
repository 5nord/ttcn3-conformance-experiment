// @requirement: C.1.3 -- For the purposes of this conversion, a bitstring shall be interpreted as a positive base 2 integer value.
// @id: TTCN3-CORE-C.1.3-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_03_test_004 {

    type component C {}

    testcase TC() runs on C {
        if (int2bit(0, 3) == '000'B and int2bit(6, 3) == '110'B and int2bit(255, 8) == '11111111'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
