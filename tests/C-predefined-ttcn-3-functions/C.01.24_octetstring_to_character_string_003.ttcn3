// @requirement: C.1.24 -- The resulting charstring shall have the same length as the incoming octetstring.
// @id: TTCN3-CORE-C.1.24-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_24_octetstring_to_character_string_003 {

    type component C {}

    testcase TC() runs on C {
        if (lengthof(oct2str('4469707379'O)) == 10) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
