// @requirement: C.1.33 -- This function converts the content of a value or template to a single universal charstring.
// @id: TTCN3-CORE-C.1.33-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_33_test_002 {

    type component C {}

    testcase TC() runs on C {
        var integer v_int := 5;
        var template integer mw_int := ?;
        if (any2unistr(v_int) == "5" and any2unistr(mw_int) == "?") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
