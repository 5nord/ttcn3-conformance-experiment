// @requirement: C.5.3 -- The optional dynamic_encoding parameter is used for dynamic selection of encode attribute of the inpar value for this single encvalue_unichar call.
// @id: TTCN3-CORE-C.5.3-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_03_test_007 {

    type component C {}

    type integer I
    with {
        encode "Codec1"; variant "Codec1"."32 bit";
        encode "Codec2"; variant "Codec2"."16 bit"
    };

    const I c_val := 65;

    testcase TC() runs on C {
        var universal charstring v_enc2 := encvalue_unichar(c_val, "UTF-8", "", "Codec2");
        var universal charstring v_enc1 := encvalue_unichar(c_val, "UTF-8", "", "Codec1");
        if (v_enc2 == oct2unichar(bit2oct(encvalue(c_val, "", "Codec2")), "UTF-8") and
            v_enc1 == oct2unichar(bit2oct(encvalue(c_val, "", "Codec1")), "UTF-8") and
            lengthof(v_enc2) == 2 and lengthof(v_enc1) == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
