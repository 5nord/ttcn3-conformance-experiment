// @requirement: C.1.19 -- This function converts a single hexstring value to a single octetstring.
// @id: TTCN3-CORE-C.1.19-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_19_hexstring_to_octetstring_002 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h := '1D7'H;
        var octetstring v_o := hex2oct(v_h);
        if (v_o == '01D7'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
