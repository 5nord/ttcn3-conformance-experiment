// @requirement: C.1.14 -- bit2hex(in bitstring invalue) return hexstring
// @id: TTCN3-CORE-C.1.14-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_14_bitstring_to_hexstring_001 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_in := '1010'B;
        var hexstring v_res := bit2hex(v_in);
        if (v_res == 'A'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
