// @requirement: C.5.3 -- When the actual parameter that is passed to inpar is a template, it shall resolve to a specific value (the same restrictions apply as for the argument of the send statement).
// @id: TTCN3-CORE-C.5.3-003b
// @verdict: pass reject
module M_C_05_03_test_004 {

    type component C {}

    type integer I with { variant "32 bit" };

    type record R {
        I f1,
        I f2
    }

    template R m_rec := { f1 := 1, f2 := (1 .. 5) };

    testcase TC() runs on C {
        var universal charstring v_enc := encvalue_unichar(m_rec); // error: field f2 is not a specific value, not allowed as send argument
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
