// @requirement: C.1.21 -- The hexadecimal digits 0 to F represent the decimal values 0 to 15 respectively.
// @id: TTCN3-CORE-C.1.21-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_21_test_006 {

    type record of octetstring RoO;

    type component C {}

    testcase TC() runs on C {
        var RoO v_digits := { '00'O, '01'O, '02'O, '03'O, '04'O, '05'O, '06'O, '07'O,
                              '08'O, '09'O, '0A'O, '0B'O, '0C'O, '0D'O, '0E'O, '0F'O };
        for (var integer i := 0; i < 16; i := i + 1) {
            if (oct2int(v_digits[i]) != i) {
                setverdict(fail);
            }
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
