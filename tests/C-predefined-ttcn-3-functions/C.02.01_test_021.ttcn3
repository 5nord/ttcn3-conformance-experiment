// @requirement: C.2.1 -- `inpar is a record of or set of type template and it can match values of different lengths or the length` restriction matching attribute contradicts the number of elements in the template body;
// @id: TTCN3-CORE-C.2.1-021a
// @verdict: pass accept, ttcn3verdict:error
module M_C_02_01_test_021 {

    type component C {}
    type record of integer RoI;

    function f_len(template (present) RoI p_t) return integer {
        return lengthof(p_t);
    }

    testcase TC() runs on C {
        var integer v_len := f_len({ 1, *, (2, 3) }); // error: matches values of different lengths
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
