// @requirement: C.4.2 -- The starting point of substring or subsequence to return is defined by the second parameter (index).
// @id: TTCN3-CORE-C.4.2-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_test_005 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abcdef";
        if (substr(v_in, 2, 2) == "cd" and substr(v_in, 4, 2) == "ef") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
