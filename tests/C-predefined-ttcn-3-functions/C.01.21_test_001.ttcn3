// @requirement: C.1.21 -- oct2int(in octetstring invalue) return integer
// @id: TTCN3-CORE-C.1.21-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_21_test_001 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_o := '0A'O;
        var integer v_i := oct2int(v_o);
        if (v_i == 10) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
