// @requirement: C.1.27 -- Each character of invalue shall be converted to the corresponding hexadecimal digit.
// @id: TTCN3-CORE-C.1.27-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_27_test_004 {

    type component C {}

    testcase TC() runs on C {
        if (str2hex("0123456789abcdefABCDEF") == '0123456789ABCDEFABCDEF'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
