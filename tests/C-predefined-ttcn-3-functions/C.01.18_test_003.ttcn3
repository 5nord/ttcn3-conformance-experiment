// @requirement: C.1.18 -- The resulting bitstring represents the same value as the hexstring.
// @id: TTCN3-CORE-C.1.18-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_18_test_003 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h := 'A5F0'H;
        var bitstring v_b := hex2bit(v_h);
        if (bit2int(v_b) == hex2int(v_h) and bit2hex(v_b) == v_h) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
