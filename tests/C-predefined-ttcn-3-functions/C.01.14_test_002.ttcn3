// @requirement: C.1.14 -- This function converts a single bitstring value to a single hexstring.
// @id: TTCN3-CORE-C.1.14-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_14_test_002 {

    type component C {}

    testcase TC() runs on C {
        if (bit2hex('111010111'B) == '1D7'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
