// @requirement: C.1.7 -- This function converts the integer value into its string equivalent (the base of the return string is always decimal).
// @id: TTCN3-CORE-C.1.7-002b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_07_test_003 {

    type component C {}

    testcase TC() runs on C {
        var integer v_hex := hex2int('FF'H);
        var integer v_oct := oct2int('10'O);
        if (int2str(v_hex) == "255" and int2str(v_oct) == "16") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
