// @requirement: C.4.3 -- If len is 0 the string or sequence repl is inserted.
// @id: TTCN3-CORE-C.4.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_test_004 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_res := replace("My name is JJ", 11, 0, "xx");
        if (v_res == "My name is xxJJ") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
