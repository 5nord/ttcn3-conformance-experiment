// @requirement: C.1.27 -- str2hex(in charstring invalue) return hexstring
// @id: TTCN3-CORE-C.1.27-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_27_test_001 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_c := "1F";
        var hexstring v_h := str2hex(v_c);
        if (v_h == '1F'H) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
