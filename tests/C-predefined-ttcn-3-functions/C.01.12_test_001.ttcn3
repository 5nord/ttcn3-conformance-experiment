// @requirement: C.1.12 -- unichar2int(in universal charstring invalue) return integer
// @id: TTCN3-CORE-C.1.12-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_12_test_001 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_in := "A";
        var integer v_res := unichar2int(v_in);
        if (v_res == 65) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
