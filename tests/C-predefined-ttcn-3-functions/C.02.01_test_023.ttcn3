// @requirement: C.2.1 -- the template passed to the invalue parameter is not of type bitstring, hexstring, octetstring, charstring, universal charstring, record of, set of, or array.
// @id: TTCN3-CORE-C.2.1-022a
// @verdict: pass reject
module M_C_02_01_test_023 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 5;
        var integer v_len := lengthof(v_i); // error: integer is not a string or list type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
