// @requirement: C.5.7 -- The identified encoding scheme, or the value "<unknown>", if the type of encoding cannot be determined unanimously, shall be returned as a character string.
// @id: TTCN3-CORE-C.5.7-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_07_test_004 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_enc := get_stringencoding('BC'O);
        if (v_enc == "<unknown>") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
