// @requirement: C.4.3 -- If index is 0, repl is inserted at the beginning of inpar.
// @id: TTCN3-CORE-C.4.3-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_test_005 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_res := replace('AABB'O, 0, 0, '11'O);
        if (v_res == '11AABB'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
