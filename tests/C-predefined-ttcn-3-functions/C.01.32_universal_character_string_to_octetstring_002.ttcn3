// @requirement: C.1.32 -- This function converts a universal `charstring` `invalue to an octetstring.
// @id: TTCN3-CORE-C.1.32-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_32_universal_character_string_to_octetstring_002 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_in := char(0, 0, 0, 196) & char(0, 0, 0, 214) & char(0, 0, 0, 220)
            & char(0, 0, 0, 228) & char(0, 0, 0, 246) & char(0, 0, 0, 252);
        if (unichar2oct(v_in, "UTF-8") == 'C384C396C39CC3A4C3B6C3BC'O and
            unichar2oct(v_in, "UTF-16BE") == '00C400D600DC00E400F600FC'O and
            unichar2oct(v_in, "UTF-16LE") == 'C400D600DC00E400F600FC00'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
