// @requirement: C.1.23 -- The resulting hexstring represents the same value as the octetstring.
// @id: TTCN3-CORE-C.1.23-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_23_octetstring_to_hexstring_003 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_o := 'A5C3'O;
        if (hex2int(oct2hex(v_o)) == oct2int(v_o)) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
