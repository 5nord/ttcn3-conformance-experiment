// @requirement: C.4.3 -- If inpar is a literal (i.e. type is not explicitly given) the corresponding type shall be retrieved from the value contents.
// @id: TTCN3-CORE-C.4.3-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_the_replace_function_007 {

    type component C {}

    testcase TC() runs on C {
        if (replace('00000110'B, 1, 3, '111'B) == '01110110'B and
            replace('ABCDEF'H, 0, 2, '123'H) == '123CDEF'H and
            replace('01AB23CD'O, 2, 1, 'FF96'O) == '01ABFF96CD'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
