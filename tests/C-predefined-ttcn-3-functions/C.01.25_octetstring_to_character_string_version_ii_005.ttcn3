// @requirement: C.1.25 -- The octets are interpreted as Recommendation ITU-T T.50 [4] codes (according to the IRV) and the resulting characters are appended to the returned value.
// @id: TTCN3-CORE-C.1.25-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_25_octetstring_to_character_string_version_ii_005 {

    type component C {}

    testcase TC() runs on C {
        if (oct2char('3041617E'O) == "0Aa~") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
