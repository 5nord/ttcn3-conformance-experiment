// @requirement: C.5.4 -- The return value 0 indicates that decoding was successful.
// @id: TTCN3-CORE-C.5.4-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_04_the_decoding_from_universal_charstring_function_010 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 1094861636;

    testcase TC() runs on C {
        var universal charstring v_enc := encvalue_unichar(c_val);
        var I v_dec;
        if (decvalue_unichar(v_enc, v_dec) == 0 and v_dec == c_val) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
