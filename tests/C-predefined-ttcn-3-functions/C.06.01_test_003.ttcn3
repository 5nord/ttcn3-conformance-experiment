// @requirement: C.6.1 -- The random number generator is initialized per test component and for the control part by means of an optional seed value (a numerical float value).
// @id: TTCN3-CORE-C.6.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_01_test_003 {

    type component C {}

    testcase TC(boolean p_ok) runs on C {
        var float v_r := rnd(0.7);
        if (p_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var float v_first := rnd(0.25);
        var float v_ref := rnd();
        v_first := rnd(0.25);
        execute(TC(true));
        var float v_next := rnd();
        execute(TC(v_next == v_ref));
    }
}
