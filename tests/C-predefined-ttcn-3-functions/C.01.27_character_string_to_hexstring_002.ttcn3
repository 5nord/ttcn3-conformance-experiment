// @requirement: C.1.27 -- This function converts a string of the type charstring to a hexstring.
// @id: TTCN3-CORE-C.1.27-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_27_character_string_to_hexstring_002 {

    type component C {}

    testcase TC() runs on C {
        if (str2hex("54696E6B792D57696E6B7") == '54696E6B792D57696E6B7'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
