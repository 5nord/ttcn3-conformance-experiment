// @requirement: C.5.3 -- The bitstring is then converted to an octetstring by the bit2oct function and subsequently to a universal charstring using the oct2unichar function.
// @id: TTCN3-CORE-C.5.3-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_03_the_encoding_to_universal_charstring_function_014 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 1094861636;

    testcase TC() runs on C {
        var octetstring v_oct := bit2oct(encvalue(c_val));
        var universal charstring v_enc := encvalue_unichar(c_val, "UTF-8");
        if (unichar2oct(v_enc, "UTF-8") == v_oct) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
