// @requirement: C.1.17 -- For the purposes of this conversion, a hexstring shall be interpreted as a positive base 16 integer value.
// @id: TTCN3-CORE-C.1.17-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_17_test_003 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h1 := 'F'H;
        var hexstring v_h2 := 'FFFF'H;
        if (hex2int(v_h1) == 15 and hex2int(v_h2) == 65535) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
