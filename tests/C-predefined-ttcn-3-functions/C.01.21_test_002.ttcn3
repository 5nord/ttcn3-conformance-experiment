// @requirement: C.1.21 -- This function converts a single octetstring value to a single integer value.
// @id: TTCN3-CORE-C.1.21-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_21_test_002 {

    type component C {}

    testcase TC() runs on C {
        if (oct2int('1F'O) == 31) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
