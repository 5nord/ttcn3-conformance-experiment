// @requirement: C.4.3 -- `inpar or repl are not of string, record` `of, set` `of, or array type;`
// @id: TTCN3-CORE-C.4.3-028a
// @verdict: pass reject
module M_C_04_03_test_028 {

    type component C {}

    testcase TC() runs on C {
        var integer v_in := 1234;
        var integer v_res := replace(v_in, 0, 1, 5); // error: inpar and repl are of integer type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
