// @requirement: C.4.2 -- A pattern is returned if the referenced template contains a pattern.
// @id: TTCN3-CORE-C.4.2-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_test_014 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_in := pattern "abc[a-z]+";
        var template charstring v_res := substr(v_in, 2, 2);
        if (match("cxyz", v_res) and match("cq", v_res) and not match("dq", v_res) and not isvalue(v_res)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
