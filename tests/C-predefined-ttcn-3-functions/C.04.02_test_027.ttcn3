// @requirement: C.4.2 -- if inpar contains neither AnyValue nor AnyValueOrNone and index + count is greater than lengthof(inpar);
// @id: TTCN3-CORE-C.4.2-028b
// @verdict: pass accept, ttcn3verdict:error
module M_C_04_02_test_027 {

    type component C {}

    function f_substr(in integer p_count) return charstring {
        return substr("abcdef", 3, p_count); // error: index + count exceeds lengthof(inpar)
    }

    testcase TC() runs on C {
        var charstring v_res := f_substr(4);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
