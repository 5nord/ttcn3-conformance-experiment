// @requirement: C.1.12 -- This function converts a single-character-length universal charstring value into an integer value in the range of 0 to 2 147 483 647.
// @id: TTCN3-CORE-C.1.12-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_12_test_002 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_min := char(0, 0, 0, 0);
        var universal charstring v_max := char(127, 255, 255, 255);
        if (unichar2int(v_min) == 0 and unichar2int(v_max) == 2147483647) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
