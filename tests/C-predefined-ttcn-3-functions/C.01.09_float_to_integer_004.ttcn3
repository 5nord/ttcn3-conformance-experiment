// @requirement: C.1.9 -- invalue is infinity, -infinity or not_a_number. In addition to the general error causes in clause 16.1.2, error causes are:
// @id: TTCN3-CORE-C.1.9-004a
// @verdict: pass accept, ttcn3verdict:error
module M_C_01_09_float_to_integer_004 {

    type component C {}

    testcase TC() runs on C {
        var float v_in := infinity;
        var integer v_res := float2int(v_in); // error: invalue is infinity
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
