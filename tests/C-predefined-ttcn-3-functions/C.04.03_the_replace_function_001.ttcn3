// @requirement: C.4.3 -- replace( in template (present) any inpar, in integer index, in integer len, in template (present) any repl ) return any_string_or_sequence type
// @id: TTCN3-CORE-C.4.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_the_replace_function_001 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abcdef";
        var integer v_index := 1;
        var integer v_len := 2;
        var charstring v_repl := "XY";
        var charstring v_res := replace(v_in, v_index, v_len, v_repl);
        if (v_res == "aXYdef") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
