// @requirement: C.5.4 -- The function shall return an integer value to indicate success or failure of the decoding below:
// @id: TTCN3-CORE-C.5.4-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_04_test_009 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 1094861636;

    testcase TC() runs on C {
        var universal charstring v_ok := encvalue_unichar(c_val);
        var universal charstring v_short := substr(encvalue_unichar(c_val), 0, 2);
        var I v_dec;
        var integer v_res_ok := decvalue_unichar(v_ok, v_dec);
        var integer v_res_fail := decvalue_unichar(v_short, v_dec);
        if (v_res_ok == 0 and v_res_fail != 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
