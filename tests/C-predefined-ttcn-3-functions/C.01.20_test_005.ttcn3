// @requirement: C.1.20 -- For the purpose of this conversion, a hexstring shall be converted into a charstring.
// @id: TTCN3-CORE-C.1.20-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_20_test_005 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h := '1F'H;
        var charstring v_s := hex2str(v_h);
        if (v_s == "1F") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
