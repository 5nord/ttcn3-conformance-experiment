// @requirement: C.1.8 -- int2float(in integer invalue) return float
// @id: TTCN3-CORE-C.1.8-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_08_integer_to_float_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_in := 7;
        var float v_res := int2float(v_in);
        if (v_res == 7.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
