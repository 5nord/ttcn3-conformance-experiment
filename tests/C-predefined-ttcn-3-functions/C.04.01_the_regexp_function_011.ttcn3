// @requirement: C.4.1 -- When expression is a template it shall contain the specific value or pattern matching mechanisms only.
// @id: TTCN3-CORE-C.4.1-011a
// @verdict: pass reject
module M_C_04_01_the_regexp_function_011 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abc";
        var charstring v_res := regexp(v_in, charstring:("(abc)", "(abd)"), 0); // error: expression is a value list
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
