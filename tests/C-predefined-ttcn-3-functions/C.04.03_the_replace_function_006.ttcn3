// @requirement: C.4.3 -- If index is lengthof(inpar), repl is inserted at the end of inpar.
// @id: TTCN3-CORE-C.4.3-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_the_replace_function_006 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "My name is JJ";
        var charstring v_res := replace(v_in, lengthof(v_in), 0, "xx");
        if (v_res == "My name is JJxx") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
