// @requirement: C.1.16 -- This function converts a single bitstring value to a single charstring.
// @id: TTCN3-CORE-C.1.16-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_16_test_002 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '1110101'B;
        var charstring v_s := bit2str(v_b);
        if (v_s == "1110101") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
