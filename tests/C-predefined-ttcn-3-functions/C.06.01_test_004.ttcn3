// @requirement: C.6.1 -- The random number generator is initialized per test component and for the control part by means of an optional seed value (a numerical float value).
// @id: TTCN3-CORE-C.6.1-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_01_test_004 {

    type component C {}

    testcase TC() runs on C {
        var float v_r := rnd(1234.5);
        if (v_r >= 0.0 and v_r < 1.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
