// @requirement: C.5.3 -- The universal charstring value is then returned as the result of the encvalue_unichar function.
// @id: TTCN3-CORE-C.5.3-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_03_test_017 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 65;

    testcase TC() runs on C {
        var universal charstring v_res := encvalue_unichar(c_val, "UTF-32BE");
        if (v_res == oct2unichar(bit2oct(encvalue(c_val)), "UTF-32BE")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
