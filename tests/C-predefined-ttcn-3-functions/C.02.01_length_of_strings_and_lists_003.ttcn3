// @requirement: C.2.1 -- charstring, universal charstring, record of, set of, array or map. The units of length for each string type are defined in table 4 in the present document.
// @id: TTCN3-CORE-C.2.1-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_02_01_length_of_strings_and_lists_003 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_u := char(0, 0, 1, 0) & "a";
        if (lengthof('010'B) == 3 and
            lengthof('F3'H) == 2 and
            lengthof('F2'O) == 1 and
            lengthof("abc") == 3 and
            lengthof(v_u) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
