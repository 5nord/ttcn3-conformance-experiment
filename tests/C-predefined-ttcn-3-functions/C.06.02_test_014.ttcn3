// @requirement: C.6.2 -- Coding scheme: UTF-32LE; initial octet sequence: FF FE 00 00; comments: no signature meaning
// @id: TTCN3-CORE-C.6.2-008b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_02_test_014 {

    type component C {}

    testcase TC() runs on C {
        if (oct2unichar('FFFE000068000000'O, "UTF-32LE") == char(0, 0, 254, 255) & "h") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
