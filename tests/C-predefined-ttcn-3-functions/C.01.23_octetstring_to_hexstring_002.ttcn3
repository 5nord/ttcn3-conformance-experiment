// @requirement: C.1.23 -- This function converts a single octetstring value to a single hexstring.
// @id: TTCN3-CORE-C.1.23-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_23_octetstring_to_hexstring_002 {

    type component C {}

    testcase TC() runs on C {
        if (oct2hex('1D74'O) == '1D74'H) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
