// @requirement: C.1.14 -- Each group of four bits is converted into a hex digit as follows: '0000'B → '0'H, '0001'B → '1'H, '0010'B → '2'H, '0011'B → '3'H, '0100'B → '4'H, '0101'B → '5'H, '0110'B → '6'H, '0111'B → '7'H, '1000'B → '8'H, '1001'B → '9'H, '1010'B → 'A'H, '1011'B → 'B'H, '1100'B → 'C'H, '1101'B → 'D'H, '1110'B → 'E'H, and '1111'B → 'F'H.
// @id: TTCN3-CORE-C.1.14-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_14_test_005 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_in := '0000000100100011010001010110011110001001101010111100110111101111'B;
        if (bit2hex(v_in) == '0123456789ABCDEF'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
