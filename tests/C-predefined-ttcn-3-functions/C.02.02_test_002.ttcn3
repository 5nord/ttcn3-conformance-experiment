// @requirement: C.2.2 -- This function returns the actual number of elements of a value or template of a record or set type (see note).
// @id: TTCN3-CORE-C.2.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_02_02_test_002 {

    type component C {}
    type record MyPDU {
        boolean field1 optional,
        integer field2
    }
    type set S {
        integer f1,
        bitstring f2 optional,
        charstring f3 optional
    }

    testcase TC() runs on C {
        var MyPDU v_r := { field1 := omit, field2 := 5 };
        var S v_s := { f1 := 1, f2 := '1'B, f3 := "a" };
        if (sizeof(v_r) == 1 and sizeof(v_s) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
