// @requirement: C.5.1 -- The encvalue function encodes a value or template into a bitstring.
// @id: TTCN3-CORE-C.5.1-002a
// @verdict: pass accept, noexecution
module M_C_05_01_the_encoding_function_002 {

    type record R {
        integer f1
    } with { encode "CodecA" }

    const R c_value := { f1 := 1 };
    template R m_template := { f1 := 2 };

    function f_encode() {
        var bitstring v_encValue := encvalue(c_value);
        var bitstring v_encTemplate := encvalue(m_template);
    }
}
