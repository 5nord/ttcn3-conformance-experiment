// @requirement: C.4.3 -- The function replace can be applied to bitstring, hexstring, octetstring, or any character string, record `of, set` `of, or arrays.
// @id: TTCN3-CORE-C.4.3-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_test_009 {

    type component C {}

    type record of integer RoI;
    type set of integer SoI;
    type integer IntArr[3];

    testcase TC() runs on C {
        var bitstring v_b := replace('0000'B, 1, 2, '11'B);
        var hexstring v_h := replace('AAAA'H, 1, 2, 'BB'H);
        var octetstring v_o := replace('AAAA'O, 1, 1, 'BB'O);
        var charstring v_c := replace("aaaa", 1, 2, "bb");
        var universal charstring v_u := replace(universal charstring:"aaaa", 1, 2, universal charstring:"bb");
        var RoI v_r := replace(RoI:{ 1, 2, 3 }, 1, 1, RoI:{ 9 });
        var SoI v_s := replace(SoI:{ 1, 2, 3 }, 1, 1, SoI:{ 9 });
        var IntArr v_a := { 1, 2, 3 };
        var RoI v_ra := replace(v_a, 1, 1, RoI:{ 9 });
        if (v_b == '0110'B and v_h == 'ABBA'H and v_o == 'AABB'O and
            v_c == "abba" and v_u == "abba" and v_r == { 1, 9, 3 } and
            v_s == { 1, 9, 3 } and v_ra == { 1, 9, 3 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
