// @requirement: C.4.1 -- regexp [@nocase] ( in template (value) any inpar, in template (present) any expression, in integer groupno ) return any_character_string_type
// @id: TTCN3-CORE-C.4.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_01_test_001 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abc";
        var charstring v_res1 := regexp(v_in, charstring:"a(?)c", 0);
        var charstring v_res2 := regexp @nocase(v_in, charstring:"A(?)C", 0);
        if (v_res1 == "b" and v_res2 == "b") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
