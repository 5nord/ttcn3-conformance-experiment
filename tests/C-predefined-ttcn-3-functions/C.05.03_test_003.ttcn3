// @requirement: C.5.3 -- When the actual parameter that is passed to inpar is a template, it shall resolve to a specific value (the same restrictions apply as for the argument of the send statement).
// @id: TTCN3-CORE-C.5.3-003a
// @verdict: pass reject
module M_C_05_03_test_003 {

    type component C {}

    type integer I with { variant "32 bit" };

    template I m_any := ?;

    testcase TC() runs on C {
        var universal charstring v_enc := encvalue_unichar(m_any); // error: template does not resolve to a specific value
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
