// @requirement: C.5.4 -- In case of "UTF-16" and "UTF-32" big-endian ordering shall be used (as described in clauses 10.4 and 10.7 of ISO/IEC 10646 [2]).
// @id: TTCN3-CORE-C.5.4-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_04_test_017 {

    type component C {}

    type integer I with { variant "32 bit" };

    testcase TC() runs on C {
        var bitstring v_bits16 := oct2bit('41424344'O);
        var bitstring v_bits32 := oct2bit('00000041'O);
        var I v_ref16, v_ref32;
        var integer v_res_ref16 := decvalue(v_bits16, v_ref16);
        var integer v_res_ref32 := decvalue(v_bits32, v_ref32);
        var universal charstring v_enc16 := char(0, 0, 65, 66) & char(0, 0, 67, 68);
        var universal charstring v_enc32 := "A";
        var I v_dec16, v_dec32;
        var integer v_res16 := decvalue_unichar(v_enc16, v_dec16, "UTF-16");
        var integer v_res32 := decvalue_unichar(v_enc32, v_dec32, "UTF-32");
        if (v_res_ref16 == 0 and v_res16 == 0 and v_dec16 == v_ref16 and
            v_res_ref32 == 0 and v_res32 == 0 and v_dec32 == v_ref32) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
