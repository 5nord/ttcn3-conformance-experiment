// @requirement: C.4.1 -- there is no groupno -s group in expression.
// @id: TTCN3-CORE-C.4.1-021b
// @verdict: pass accept, ttcn3verdict:error
module M_C_04_01_test_020 {

    type component C {}

    function f_regexp(in integer p_groupno) return charstring {
        return regexp(charstring:"abc", charstring:"(a)bc", p_groupno); // error: no group with this number
    }

    testcase TC() runs on C {
        var charstring v_res := f_regexp(1);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
