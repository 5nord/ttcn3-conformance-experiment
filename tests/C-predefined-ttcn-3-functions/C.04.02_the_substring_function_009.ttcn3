// @requirement: C.4.2 -- For sequence types, the unit of length is element.
// @id: TTCN3-CORE-C.4.2-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_the_substring_function_009 {

    type record of charstring RoCS;

    type component C {}

    testcase TC() runs on C {
        var RoCS v_in := { "aa", "bb", "cc" };
        var RoCS v_res := substr(v_in, 1, 2);
        if (v_res == { "bb", "cc" }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
