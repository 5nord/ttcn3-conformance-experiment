// @requirement: C.4.3 -- In all other cases when the AnyValue matching symbol occurs in the repl parameter, it is automatically converted prior to resolving the function evaluation if any of the following conditions is met: To pattern "*" if inpar is of a character string type
// @id: TTCN3-CORE-C.4.3-017b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_the_replace_function_020 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_repl := ?;
        var template charstring v_res := replace("abcd", 1, 2, v_repl);
        if (match("ad", v_res) and match("axyzd", v_res) and not match("abc", v_res)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
