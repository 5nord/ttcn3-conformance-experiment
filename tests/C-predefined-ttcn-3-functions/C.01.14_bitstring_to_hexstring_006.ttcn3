// @requirement: C.1.14 -- When the leftmost group of bits does contain less than 4 bits, this group is filled with '0'B from the left until it contains exactly 4 bits and is converted afterwards.
// @id: TTCN3-CORE-C.1.14-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_14_bitstring_to_hexstring_006 {

    type component C {}

    testcase TC() runs on C {
        if (bit2hex('1'B) == '1'H and bit2hex('11'B) == '3'H and bit2hex('1110000'B) == '70'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
