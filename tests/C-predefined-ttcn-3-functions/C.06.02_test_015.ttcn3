// @requirement: C.6.2 -- Coding scheme: UTF-32; initial octet sequence: 00 00 FE FF FF FE 00 00; comments: signature (default 00 00 FE FF)
// @id: TTCN3-CORE-C.6.2-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_06_02_test_015 {

    type component C {}

    testcase TC() runs on C {
        if (remove_bom('0000FEFF00000068'O) == '00000068'O and
            remove_bom('FFFE000068000000'O) == '68000000'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
