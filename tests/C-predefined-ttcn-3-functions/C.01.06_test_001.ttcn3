// @requirement: C.1.6 -- int2oct(in integer invalue, in integer length) return octetstring
// @id: TTCN3-CORE-C.1.6-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_06_test_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_in := 255;
        var integer v_len := 2;
        var octetstring v_res := int2oct(v_in, v_len);
        if (v_res == '00FF'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
