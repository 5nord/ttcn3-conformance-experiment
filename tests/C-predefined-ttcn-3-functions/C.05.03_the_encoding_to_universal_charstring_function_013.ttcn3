// @requirement: C.5.3 -- The encvalue_unichar function first invokes the encvalue function in order to encode the value passed in the inpar parameter to a bitstring.
// @id: TTCN3-CORE-C.5.3-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_03_the_encoding_to_universal_charstring_function_013 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 1094861636;

    testcase TC() runs on C {
        var universal charstring v_enc := encvalue_unichar(c_val, "UTF-16BE");
        if (oct2bit(unichar2oct(v_enc, "UTF-16BE")) == encvalue(c_val)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
