// @requirement: C.1.28 -- str2oct(in charstring invalue) return octetstring
// @id: TTCN3-CORE-C.1.28-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_28_character_string_to_octetstring_001 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "0A";
        var octetstring v_res := str2oct(v_in);
        if (v_res == '0A'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
