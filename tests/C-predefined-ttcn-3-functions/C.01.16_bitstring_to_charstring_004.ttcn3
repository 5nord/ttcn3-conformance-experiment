// @requirement: C.1.16 -- The resulting charstring has the same length as the bitstring and contains only the characters '0' and '1'.
// @id: TTCN3-CORE-C.1.16-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_16_bitstring_to_charstring_004 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_s := bit2str('1110101000110'B);
        for (var integer i := 0; i < lengthof(v_s); i := i + 1) {
            if (v_s[i] != "0" and v_s[i] != "1") {
                setverdict(fail);
            }
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
