// @requirement: C.6.1 -- rnd([in float seed]) return float
// @id: TTCN3-CORE-C.6.1-001a
// @verdict: pass accept, noexecution
module M_C_06_01_test_001 {

    type component C {}

    function f_rnd() return float {
        var float v_r1 := rnd();
        var float v_r2 := rnd(0.5);
        return v_r1 + v_r2;
    }
}
