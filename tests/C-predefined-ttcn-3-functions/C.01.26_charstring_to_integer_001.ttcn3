// @requirement: C.1.26 -- str2int(in charstring invalue) return integer
// @id: TTCN3-CORE-C.1.26-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_26_charstring_to_integer_001 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_c := "42";
        var integer v_i := str2int(v_c);
        if (v_i == 42) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
