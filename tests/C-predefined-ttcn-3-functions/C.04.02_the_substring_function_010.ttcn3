// @requirement: C.4.2 -- NOTE: Note that the root types of arrays is record of, therefore if inpar is an array the returned type is record of.
// @id: TTCN3-CORE-C.4.2-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_the_substring_function_010 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var integer v_arr[3] := { 1, 2, 3 };
        var RoI v_res := substr(v_arr, 1, 2);
        if (lengthof(v_res) == 2 and v_res[0] == 2 and v_res[1] == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
