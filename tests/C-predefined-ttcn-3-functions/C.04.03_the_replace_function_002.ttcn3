// @requirement: C.4.3 -- This function replaces the substring or subsequence of value inpar at index index of length len with the string or sequence value repl and returns the resulting string or sequence.
// @id: TTCN3-CORE-C.4.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_the_replace_function_002 {

    type component C {}

    type record of integer RoI;

    testcase TC() runs on C {
        var charstring v_str := replace("My name is JJ", 11, 1, "xx");
        var RoI v_seq := replace(RoI:{ 1, 2, 3, 4 }, 1, 2, RoI:{ 7, 8, 9 });
        if (v_str == "My name is xxJ" and v_seq == { 1, 7, 8, 9, 4 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
