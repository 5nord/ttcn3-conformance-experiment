// @requirement: C.4.2 -- A specific value is returned if the referenced template contains a specific value.
// @id: TTCN3-CORE-C.4.2-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_test_013 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_in := "abcd";
        var template charstring v_res := substr(v_in, 1, 2);
        if (isvalue(v_res) and valueof(v_res) == "bc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
