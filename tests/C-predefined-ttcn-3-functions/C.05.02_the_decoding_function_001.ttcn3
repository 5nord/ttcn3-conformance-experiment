// @requirement: C.5.2 -- decvalue(inout bitstring encoded_value, out any decoded_value, in universal charstring decoding_info := "", in universal charstring dynamic_encoding := "") return integer
// @id: TTCN3-CORE-C.5.2-001a
// @verdict: pass accept, noexecution
module M_C_05_02_the_decoding_function_001 {

    type integer I with { variant "32 bit" };

    function f_decode(inout bitstring p_enc, out I p_dec) return integer {
        var integer v_r1 := decvalue(p_enc, p_dec);
        var integer v_r2 := decvalue(p_enc, p_dec, "info");
        var integer v_r3 := decvalue(p_enc, p_dec, "info", "");
        return v_r1 + v_r2 + v_r3;
    }
}
