// @requirement: C.1.2 -- int2unichar(in integer invalue) return universal charstring
// @id: TTCN3-CORE-C.1.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_02_test_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 65;
        var universal charstring v_u := int2unichar(v_i);
        if (v_u == "A") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
