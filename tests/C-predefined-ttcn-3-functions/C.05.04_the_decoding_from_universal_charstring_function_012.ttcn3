// @requirement: C.5.4 -- This value is also returned if the encoded_value parameter contains an unitialized value.
// @id: TTCN3-CORE-C.5.4-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_04_the_decoding_from_universal_charstring_function_012 {

    type component C {}

    type integer I with { variant "32 bit" };

    testcase TC() runs on C {
        var universal charstring v_enc;
        var I v_dec;
        if (decvalue_unichar(v_enc, v_dec) == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
