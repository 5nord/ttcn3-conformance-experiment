// @requirement: C.4.3 -- inpar shall not be modified.
// @id: TTCN3-CORE-C.4.3-002b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_test_003 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abcdef";
        var charstring v_res := replace(v_in, 1, 2, "XY");
        if (v_in == "abcdef" and v_res == "aXYdef") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
