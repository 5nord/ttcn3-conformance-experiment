// @requirement: C.1.22 -- For the conversion the following holds: oct2bit(value)=hex2bit(oct2hex(value)).
// @id: TTCN3-CORE-C.1.22-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_22_test_004 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_o := '01D7FF00'O;
        if (oct2bit(v_o) == hex2bit(oct2hex(v_o))) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
