// @requirement: C.4.3 -- The repl parameter is allowed to contain a template that shall contain a specific value, pattern or AnyValue without any matching attributes attached to it.
// @id: TTCN3-CORE-C.4.3-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_03_the_replace_function_014 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_repl := pattern "x?";
        var template charstring v_res := replace("abcd", 1, 2, v_repl);
        if (match("axyd", v_res) and not match("abcd", v_res)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
