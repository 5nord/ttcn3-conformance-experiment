// @requirement: C.1.33 -- When the optional format parameter is missing or is set to an empty string the resulting universal charstring is the same as the string produced by the log operation for the same operand.
// @id: TTCN3-CORE-C.1.33-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_33_value_or_template_to_universal_charstring_005 {

    type component C {}

    testcase TC() runs on C {
        var template integer mw_int := -1 ifpresent;
        log(mw_int);
        if (any2unistr(mw_int) == "-1 ifpresent" and any2unistr(mw_int, "") == "-1 ifpresent") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
