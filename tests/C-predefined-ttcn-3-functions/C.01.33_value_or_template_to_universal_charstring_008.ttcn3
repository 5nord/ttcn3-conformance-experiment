// @requirement: C.1.33 -- If the actual value of the format parameter is different from the empty string and "canonical", the format of the result produced by the function is either tool-specific if the tool supports the specified custom format or it is the same as the string produced by the log operation (i.e. the same as if the parameter value was the empty string).
// @id: TTCN3-CORE-C.1.33-008b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_33_value_or_template_to_universal_charstring_008 {

    type component C {}

    testcase TC() runs on C {
        var template integer mw_int := -1 ifpresent;
        var universal charstring v_fmt := "x_unsupported_custom_format_x";
        if (any2unistr(mw_int, v_fmt) == any2unistr(mw_int, "")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
