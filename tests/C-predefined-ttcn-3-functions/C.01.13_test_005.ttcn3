// @requirement: C.1.13 -- The rightmost bit is least significant, the leftmost bit is the most significant.
// @id: TTCN3-CORE-C.1.13-004b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_13_test_005 {

    type component C {}

    testcase TC() runs on C {
        if (bit2int('1000'B) == 8 and bit2int('100000'B) == 32) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
