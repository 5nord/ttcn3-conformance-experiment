// @requirement: C.1.4 -- int2enum ( in integer inpar, out Enumerated_type outpar)
// @id: TTCN3-CORE-C.1.4-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_04_test_001 {

    type enumerated E {
        e_mon, e_tue, e_wed, e_weekend(6..7)
    }

    type component C {}

    testcase TC() runs on C {
        var integer v_in := 2;
        var E v_out;
        int2enum(v_in, v_out);
        if (v_out == e_wed) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
