// @requirement: C.6.3 -- hostid(in charstring idkind := "Ipv4orIPv6") return charstring
// @id: TTCN3-CORE-C.6.3-001a
// @verdict: pass accept, noexecution
module M_C_06_03_test_001 {

    type component C {}

    function f_host(in charstring p_kind) return charstring {
        return hostid(p_kind);
    }

    testcase TC() runs on C {
        var charstring v_id := hostid();
        v_id := hostid("Ipv4");
        v_id := f_host("Ipv6");
        setverdict(pass);
    }
}
