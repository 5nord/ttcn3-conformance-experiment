// @requirement: C.5.3 -- The returned universal charstring represents the encoded value of inpar, however, the TTCN-3 test system need not make any check on its correctness.
// @id: TTCN3-CORE-C.5.3-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_03_the_encoding_to_universal_charstring_function_005 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_val := 1094861636;

    testcase TC() runs on C {
        var universal charstring v_enc := encvalue_unichar(c_val, "UTF-8");
        if (unichar2oct(v_enc, "UTF-8") == bit2oct(encvalue(c_val))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
