// @requirement: C.4.2 -- substr( in template (present) any inpar, in integer index, in integer count ) return input_string_or_sequence_type
// @id: TTCN3-CORE-C.4.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_04_02_test_001 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abcdef";
        var charstring v_res := substr(v_in, 1, 3);
        if (v_res == "bcd") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
