// @requirement: C.2.1 -- If inpar contains uninitialized elements, each of them shall be counted as 1 element, i.e. they shall be matched as if they contained the "?" (AnyElement inside value) matching character.
// @id: TTCN3-CORE-C.2.1-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_02_01_length_of_strings_and_lists_015 {

    type component C {}
    type record of integer RoI;

    testcase TC() runs on C {
        var template RoI v_t := { 1, -, -, 4 };
        if (lengthof(v_t) == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
