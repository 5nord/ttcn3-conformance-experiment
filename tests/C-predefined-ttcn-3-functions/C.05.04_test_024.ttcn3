// @requirement: C.5.4 -- In case of successful decoding, the undecoded part of the message is automatically converted from bitstring to octetstring by the bit2oct function and then to universal charstring using the oct2unichar function.
// @id: TTCN3-CORE-C.5.4-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_04_test_024 {

    type component C {}

    type integer I with { variant "32 bit" };

    const I c_a := 1094861636;
    const I c_b := 1162233672;

    testcase TC() runs on C {
        var universal charstring v_enc := encvalue_unichar(c_a, "UTF-16BE") & encvalue_unichar(c_b, "UTF-16BE");
        var bitstring v_rest := oct2bit(unichar2oct(v_enc, "UTF-16BE"));
        var I v_dec, v_ref;
        var integer v_res_ref := decvalue(v_rest, v_ref);
        var integer v_res := decvalue_unichar(v_enc, v_dec, "UTF-16BE");
        if (v_res_ref == 0 and v_res == 0 and v_enc == oct2unichar(bit2oct(v_rest), "UTF-16BE")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
