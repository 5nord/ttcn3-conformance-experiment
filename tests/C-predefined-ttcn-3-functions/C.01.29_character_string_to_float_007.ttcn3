// @requirement: C.1.29 -- no numbers after the dot in the decimal notation are allowed.
// @id: TTCN3-CORE-C.1.29-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_29_character_string_to_float_007 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "12.";
        if (str2float(v_in) == 12.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
