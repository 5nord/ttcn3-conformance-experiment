// @requirement: C.1.20 -- The resulting charstring has the same length as the hexstring and contains only the characters '0' to '9'and 'A' to 'F'.
// @id: TTCN3-CORE-C.1.20-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_20_hexstring_to_charstring_003 {

    type component C {}

    type record of hexstring HexList;

    testcase TC() runs on C {
        var HexList v_list := { ''H, '0'H, 'AB801'H, '0123456789ABCDEF'H };
        for (var integer i := 0; i < lengthof(v_list); i := i + 1) {
            if (lengthof(hex2str(v_list[i])) != lengthof(v_list[i])) {
                setverdict(fail);
            }
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
