// @requirement: C.4.2 -- `index is less than zero;`
// @id: TTCN3-CORE-C.4.2-027a
// @verdict: pass accept, ttcn3verdict:error
module M_C_04_02_the_substring_function_025 {

    type component C {}

    function f_substr(in integer p_index) return charstring {
        return substr("abcdef", p_index, 2); // error: negative index
    }

    testcase TC() runs on C {
        var charstring v_res := f_substr(-1);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
