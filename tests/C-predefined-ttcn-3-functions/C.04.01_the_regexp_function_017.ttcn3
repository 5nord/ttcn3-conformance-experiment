// @requirement: C.4.1 -- when expression is a template, it contains other matching mechanism than specific value or character pattern;
// @id: TTCN3-CORE-C.4.1-019a
// @verdict: pass accept, ttcn3verdict:error
module M_C_04_01_the_regexp_function_017 {

    type component C {}

    function f_regexp(in template charstring p_expr) return charstring {
        return regexp(charstring:"abc", p_expr, 0); // error: expression contains a value list
    }

    testcase TC() runs on C {
        var charstring v_res := f_regexp(("(abc)", "(abd)"));
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
