// @requirement: C.5.5 -- The bit length can be assigned to a variable by usage of the formal out parameter bit_length.
// @id: TTCN3-CORE-C.5.5-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_05_05_the_encoding_to_octetstring_function_008 {

    type component C {}

    type record R {
        integer f1,
        integer f2
    } with { encode "JSON" }

    const R c_r := { f1 := 1, f2 := 2 };

    testcase TC() runs on C {
        var integer v_len := -1;
        var octetstring v_o := encvalue_o(c_r, "", "", v_len);
        if (v_len == lengthof(encvalue(c_r)) and v_len > 8 * (lengthof(v_o) - 1) and v_len <= 8 * lengthof(v_o)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
