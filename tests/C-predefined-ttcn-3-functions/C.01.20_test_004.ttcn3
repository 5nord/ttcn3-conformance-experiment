// @requirement: C.1.20 -- The resulting charstring has the same length as the hexstring and contains only the characters '0' to '9'and 'A' to 'F'.
// @id: TTCN3-CORE-C.1.20-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_20_test_004 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_s := hex2str('FEDCBA9876543210'H);
        for (var integer i := 0; i < lengthof(v_s); i := i + 1) {
            var integer v_c := char2int(v_s[i]);
            if (not ((v_c >= char2int("0") and v_c <= char2int("9")) or
                     (v_c >= char2int("A") and v_c <= char2int("F")))) {
                setverdict(fail);
            }
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
