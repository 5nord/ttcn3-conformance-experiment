// @requirement: C.1.9 -- This function converts a float value into an integer value by removing the fractional part of the argument and returning the resulting integer.
// @id: TTCN3-CORE-C.1.9-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_09_float_to_integer_002 {

    type component C {}

    testcase TC() runs on C {
        if (float2int(3.12345E2) == 312 and float2int(312.9) == 312 and float2int(-2.7) == -2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
