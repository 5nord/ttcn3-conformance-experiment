// @requirement: C.4.3 -- inpar and repl, and the returned string or sequence shall be of the same root type.
// @id: TTCN3-CORE-C.4.3-006b
// @verdict: pass reject
module M_C_04_03_the_replace_function_008 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_res := replace('0101'B, 0, 1, '1'B); // error: returned bitstring assigned to octetstring
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
