// @requirement: C.1.16 -- Each bit of the bitstring is converted into a character '0' or '1' depending on the value 0 or 1 of the bit.
// @id: TTCN3-CORE-C.1.16-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_16_test_005 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b0 := '0'B;
        var bitstring v_b1 := '1'B;
        if (bit2str(v_b0) == "0" and bit2str(v_b1) == "1") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
