// @requirement: C.4.1 -- groupno is a negative integer;
// @id: TTCN3-CORE-C.4.1-021a
// @verdict: pass accept, ttcn3verdict:error
module M_C_04_01_the_regexp_function_019 {

    type component C {}

    function f_regexp(in integer p_groupno) return charstring {
        return regexp(charstring:"abc", charstring:"(a)bc", p_groupno); // error: negative groupno
    }

    testcase TC() runs on C {
        var charstring v_res := f_regexp(-1);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
