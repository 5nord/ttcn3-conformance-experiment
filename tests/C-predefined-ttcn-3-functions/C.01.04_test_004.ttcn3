// @requirement: C.1.4 -- The integer value shall be provided as in parameter and the result of the conversion shall be stored in an out parameter.
// @id: TTCN3-CORE-C.1.4-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_04_test_004 {

    type enumerated E {
        e_mon, e_tue, e_wed, e_weekend(6..7)
    }

    type component C {}

    testcase TC() runs on C {
        var E v_out := e_mon;
        int2enum(1, v_out);
        if (v_out == e_tue) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
