// @requirement: C.1.18 -- This function converts a single hexstring value to a single bitstring.
// @id: TTCN3-CORE-C.1.18-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_18_test_002 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h := '1D7'H;
        var bitstring v_b := hex2bit(v_h);
        if (v_b == '000111010111'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
