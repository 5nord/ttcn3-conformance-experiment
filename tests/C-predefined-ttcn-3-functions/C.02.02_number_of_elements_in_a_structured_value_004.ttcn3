// @requirement: C.2.2 -- The function is applicable only if the sizeof function gives the same result on all values that match the template.
// @id: TTCN3-CORE-C.2.2-004a
// @verdict: pass reject
module M_C_02_02_number_of_elements_in_a_structured_value_004 {

    type component C {}
    type set S {
        integer f1,
        bitstring f2 optional,
        charstring f3 optional
    }

    template S mw_s2 := { f3 := *, f1 := 1, f2 := '00'B ifpresent };

    testcase TC() runs on C {
        var integer v_size := sizeof(mw_s2); // error: matches values of different sizes
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
