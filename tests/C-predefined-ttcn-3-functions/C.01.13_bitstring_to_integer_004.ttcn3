// @requirement: C.1.13 -- The rightmost bit is least significant, the leftmost bit is the most significant.
// @id: TTCN3-CORE-C.1.13-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_C_01_13_bitstring_to_integer_004 {

    type component C {}

    testcase TC() runs on C {
        if (bit2int('0001'B) == 1 and bit2int('0110'B) == 6 and bit2int('0111'B) == 7) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
