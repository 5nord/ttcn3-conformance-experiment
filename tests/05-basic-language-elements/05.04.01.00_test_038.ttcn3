// @requirement: 5.4.1.0 -- The templates for the signatures can be parameterized, however.
// @id: TTCN3-CORE-5.4.1.0-031a
// @verdict: pass accept, noexecution
module M_05_04_01_00_test_038 {

    signature S(in integer p_in, out integer p_out) return integer;

    template S s_call(template integer p_v) := {
        p_in := p_v,
        p_out := -
    }

    template S s_reply(integer p_v) := {
        p_in := -,
        p_out := p_v
    }
}
