// @requirement: 5.4.1.2 -- Formal template parameters may be in, inout or out parameters.
// @id: TTCN3-CORE-5.4.1.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_02_test_005 {
    type component C {}

    function f_kinds(in template integer p_in, inout template integer p_inout,
                     out template integer p_out) {
        p_inout := (1, 2);
        p_out := p_in;
    }

    testcase TC() runs on C {
        var template integer vt_inout := 0, vt_out;
        f_kinds(?, vt_inout, vt_out);
        if (match(2, vt_inout) and not match(0, vt_inout) and match(9, vt_out)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
