// @requirement: 5.4.0 -- **function** Value and template Dynamic at runtime all basic types, all user-defined types, address parameterization type, component type, port type, default, template and timer.
// @id: TTCN3-CORE-5.4.0-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_00_general_013 {

    function f_check(integer p_value, template integer p_tmpl) return boolean {
        return match(p_value, p_tmpl);
    }

    type component C {}

    testcase TC() runs on C {
        if (f_check(5, (1 .. 10)) and not f_check(11, (1 .. 10))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
