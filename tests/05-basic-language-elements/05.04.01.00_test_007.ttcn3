// @requirement: 5.4.1.0 -- Formal parameters can be used directly as actual parameters for other parameterized objects, e.g. as actual parameters in function invocations or as actual parameters in template instances.
// @id: TTCN3-CORE-5.4.1.0-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_test_007 {

    type component C {}

    template integer m_int(integer p_v) := p_v;

    function f_double(in integer p_x) return integer {
        return 2 * p_x;
    }

    function f_inc(inout integer p_x) {
        p_x := p_x + 1;
    }

    function f_check(in integer p_x, inout integer p_y) return boolean {
        f_inc(p_y);
        return match(f_double(p_x), m_int(2 * p_x));
    }

    testcase TC() runs on C {
        var integer v_y := 1;
        if (f_check(3, v_y) and v_y == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
