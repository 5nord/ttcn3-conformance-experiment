// @requirement: 5.4.1.0 -- Keyword: function; Allowed kind of Parameterization: Value and template parameterization; Allowed form of Parameterization: Dynamic at runtime; Allowed types in formal parameter lists: all basic types, all user-defined types, address type, component type, port type, default, template and timer.
// @id: TTCN3-CORE-5.4.1.0-027c
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_test_030 {

    type integer address;

    type record R {
        integer a
    }

    type port P message {
        inout integer
    }

    type component C {
        port P p;
        timer T;
    }

    function f_all(boolean p_bool, R p_rec, address p_addr, C p_comp, P p_port,
                   default p_def, template integer p_t, timer p_timer) return boolean {
        return p_bool and p_rec.a == 1 and p_addr == 2 and p_comp != null
            and p_def != null and match(3, p_t) and not p_timer.running;
    }

    altstep a_dummy() runs on C {
        [] T.timeout {}
    }

    testcase TC() runs on C {
        var default v_def := activate(a_dummy());
        if (f_all(true, { a := 1 }, 2, self, p, v_def, ?, T)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        deactivate(v_def);
    }

    control {
        execute(TC());
    }
}
