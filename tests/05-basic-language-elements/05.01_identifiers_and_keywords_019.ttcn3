// @requirement: 5.1 -- Language element: Test component definitions; Associated keyword: component; Specified in module definitions: Yes
// @id: TTCN3-CORE-5.1-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_01_identifiers_and_keywords_019 {

    type component C {
        var integer v_value := 1;
    }

    testcase TC() runs on C {
        if (v_value == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
