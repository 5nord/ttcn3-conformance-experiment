// @requirement: 5.4.0 -- TTCN-3 allows to parameterize modules, templates, functions, altsteps and testcases.
// @id: TTCN3-CORE-5.4.0-001b
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_00_test_002 {

    type record R {
        integer f_a
    }

    template R m_r(integer p_a) := { f_a := p_a };

    type component C {}

    testcase TC() runs on C {
        var R v_r := { f_a := 5 };
        if (match(v_r, m_r(5)) and not match(v_r, m_r(6))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
