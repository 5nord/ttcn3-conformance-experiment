// @requirement: 5.4.2 -- Modification of parameters passed this way affects the original structured value or template.
// @id: TTCN3-CORE-5.4.2-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_02_actual_parameters_023 {

    type record of integer RoI;

    type component C {}

    function f_swapElements(inout integer p_int1, inout integer p_int2) {
        var integer v_tmp := p_int1;
        p_int1 := p_int2;
        p_int2 := v_tmp;
    }

    testcase TC() runs on C {
        var RoI v_roi := { 0, 1, 2, 3, 4, 5 };
        f_swapElements(v_roi[0], v_roi[5]);
        if (v_roi == { 5, 1, 2, 3, 4, 0 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
