// @requirement: 5.0 -- The concept of global variables is not supported in TTCN-3.
// @id: TTCN3-CORE-5.0-008a
// @verdict: pass reject
module M_05_00_general_006 {

    var integer v_global := 0; // error: global variables are not supported

    type component C {}

    function f_increment() {
        v_global := v_global + 1;
    }

    testcase TC() runs on C {
        f_increment();
        if (v_global == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
