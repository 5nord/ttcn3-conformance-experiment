// @requirement: 5.4.1.2 -- d) The default template instance has to be compatible with the type of the parameter.
// @id: TTCN3-CORE-5.4.1.2-018a
// @verdict: pass reject
module M_05_04_01_02_test_017 {
    type component C {}

    function f_match(template integer p_t := "abc") return boolean { // error: default of wrong type
        return match(1, p_t);
    }

    testcase TC() runs on C {
        if (f_match(1)) {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
