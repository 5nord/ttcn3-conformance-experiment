// @requirement: 5.4.1.2 -- j) If a lazy or fuzzy template parameter is used in deterministic contexts (i.e. during the evaluation of a snapshot or initialization of global non-fuzzy templates), it shall be declared @deterministic.
// @id: TTCN3-CORE-5.4.1.2-025a
// @verdict: pass reject
module M_05_04_01_02_test_025 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    function f(template @lazy integer p_t) runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.receive(p_t) { // error: lazy template parameter not @deterministic used in snapshot
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    testcase TC() runs on C {
        connect(self:p, self:p);
        p.send(1);
        f(1);
    }

    control {
        execute(TC());
    }
}
