// @requirement: 5.2.0 -- NOTE 4: Built in TTCN-3 types like integer, charstring, anytype, etc. are not scope units, but all named user defined types are scope units, independent of their kinds.
// @id: TTCN3-CORE-5.2.0-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_02_00_test_003 {

    type component C {}

    testcase TC() runs on C {
        var integer v_int := 1;
        var charstring v_str := "a";
        var anytype v_any;
        v_any.integer := v_int;
        if (v_any.integer == 1 and v_str == "a") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
