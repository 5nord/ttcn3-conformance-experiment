// @requirement: 5.1 -- Language element: Communication port definitions; Associated keyword: port; Specified in module definitions: Yes
// @id: TTCN3-CORE-5.1-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_01_identifiers_and_keywords_017 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(mtc:p, mtc:p);
        p.send(1);
        T.start;
        alt {
            [] p.receive(1) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
