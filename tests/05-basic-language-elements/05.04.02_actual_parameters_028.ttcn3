// @requirement: 5.4.2 -- If for some formal parameters, no actual parameter has been provided, if they are out parameters, the dash symbol "-" and for in parameters their default values are taken.
// @id: TTCN3-CORE-5.4.2-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_02_actual_parameters_028 {

    type component C {}

    function f(in integer p_i, out integer p_o) return integer {
        p_o := p_i;
        return p_o + 1;
    }

    testcase TC() runs on C {
        if (f(1) == 2 and f(1, -) == 2 and f(p_i := 1) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
