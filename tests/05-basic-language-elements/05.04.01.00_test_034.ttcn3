// @requirement: 5.4.1.0 -- Keyword: testcase; Allowed kind of Parameterization: Value and template parameterization; Allowed form of Parameterization: Dynamic at runtime; Allowed types in formal parameter lists: all basic types and of all user-defined types, address type, component type and template.
// @id: TTCN3-CORE-5.4.1.0-029a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_test_034 {

    type component C {}

    testcase TC(integer p_v, template integer p_t) runs on C {
        if (match(p_v, p_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC(1, (0 .. 2)));
    }
}
