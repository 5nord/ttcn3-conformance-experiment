// @requirement: 5.4.1.0 -- NOTE 1: Although out parameters can be read within the parameterized object, they do not inherit the value of their actual parameter; i.e. they should be set before they are read.
// @id: TTCN3-CORE-5.4.1.0-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_test_013 {

    type component C {}

    function f_out(out integer p_x) return boolean {
        var boolean v_bound := isbound(p_x);
        p_x := 1;
        return v_bound;
    }

    testcase TC() runs on C {
        var integer v_x := 5;
        var boolean v_bound := f_out(v_x);
        if (not v_bound and v_x == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
