// @requirement: 5.4.2 -- p) Actual parameters passed to @deterministic fuzzy or lazy formal parameters shall fulfill the restrictions imposed on content of functions used in special places given in clause 16.1.4.
// @id: TTCN3-CORE-5.4.2-061a
// @verdict: pass reject
module M_05_04_02_actual_parameters_064 {

    type component C {}

    function f_test(in @lazy @deterministic float p_val) return float {
        return p_val;
    }

    testcase TC() runs on C {
        var float v_res := f_test(rnd()); // error: rnd is not allowed for @deterministic lazy parameters
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
