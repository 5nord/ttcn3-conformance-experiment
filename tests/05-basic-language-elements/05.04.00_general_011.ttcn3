// @requirement: 5.4.0 -- **template** Value and template Dynamic at runtime all basic types, all user-defined types, address type parameterization and template.
// @id: TTCN3-CORE-5.4.0-008b
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_00_general_011 {

    template integer m_range(integer p_min, integer p_max) := (p_min .. p_max);

    type component C {}

    testcase TC() runs on C {
        var integer v_i;
        var integer v_matches := 0;
        for (v_i := 0; v_i < 3; v_i := v_i + 1) {
            if (match(5, m_range(v_i * 3, v_i * 3 + 2))) {
                v_matches := v_matches + 1;
            }
        }
        if (v_matches == 1 and match(5, m_range(3, 5))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
