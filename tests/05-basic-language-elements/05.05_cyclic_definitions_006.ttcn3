// @requirement: 5.5 -- For example, field identifiers are not used.
// @id: TTCN3-CORE-5.5-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_05_cyclic_definitions_006 {

    type record R {
        integer c_value
    }

    const R c_value := { c_value := 1 };

    type component C {}

    testcase TC() runs on C {
        if (c_value.c_value == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
