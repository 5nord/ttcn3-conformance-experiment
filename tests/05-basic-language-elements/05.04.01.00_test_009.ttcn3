// @requirement: 5.4.1.0 -- When parameters are passed by reference, strong typing is required.
// @id: TTCN3-CORE-5.4.1.0-011a
// @verdict: pass reject
module M_05_04_01_00_test_009 {

    type component C {}

    type integer MyInt (0 .. 10);

    function f_inc(inout MyInt p_x) {
        p_x := p_x + 1;
    }

    testcase TC() runs on C {
        var integer v_x := 1;
        f_inc(v_x); // error: integer and MyInt are compatible, but not the same type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
