// @requirement: 5.4.3 -- The actual parameter is equal to a record of value or template that contains all the comma-separated values in their declaration order.
// @id: TTCN3-CORE-5.4.3-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_03_variadic_parameters_007 {

    type record of integer RoI;

    type component C {}

    function f_test(integer p_values...) return RoI {
        return p_values;
    }

    testcase TC() runs on C {
        if (f_test(3, 1, 2) == { 3, 1, 2 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
