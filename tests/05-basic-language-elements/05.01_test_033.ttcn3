// @requirement: 5.1 -- Language element: Value variable declarations; Associated keyword: var; Specified in module control: Yes; Specified in functions/ altsteps/test cases: Yes; Specified in test component type: Yes
// @id: TTCN3-CORE-5.1-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_01_test_033 {

    type component C {
        var integer v_component := 2;
    }

    function f_value() return integer {
        var integer v_function := 3;
        return v_function;
    }

    altstep a_timeout(timer p_timer) {
        var integer v_altstep := 4;
        [] p_timer.timeout {
            if (v_altstep == 4) {
                setverdict(pass);
            } else {
                setverdict(fail);
            }
        }
    }

    testcase TC(integer p_control) runs on C {
        var integer v_testcase := 5;
        timer T := 0.1;
        if (v_component == 2 and f_value() == 3 and v_testcase == 5 and p_control == 6) {
            T.start;
            a_timeout(T);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_control := 6;
        execute(TC(v_control));
    }
}
