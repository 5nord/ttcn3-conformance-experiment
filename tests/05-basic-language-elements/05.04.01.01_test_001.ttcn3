// @requirement: 5.4.1.1 -- Values of all basic and user-defined types, address, component, port and timer types, and the default type can be passed as value parameters.
// @id: TTCN3-CORE-5.4.1.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_01_test_001 {
    type integer address;
    type record R { integer f1 }
    type port P message { inout integer }
    type component C {
        port P p;
        timer T;
    }

    altstep a_dummy() runs on C {
        [] T.timeout {}
    }

    function f_check(integer p_int, R p_rec, address p_addr, C p_comp, P p_port,
                     timer p_timer, default p_def) return boolean {
        return p_int == 1 and p_rec.f1 == 2 and p_addr == 3 and p_comp == mtc
            and p_timer.running and p_def != null;
    }

    testcase TC() runs on C {
        var R v_rec := { f1 := 2 };
        var address v_addr := 3;
        var default v_def := activate(a_dummy());
        T.start(5.0);
        if (f_check(1, v_rec, v_addr, mtc, p, T, v_def)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        T.stop;
        deactivate(v_def);
    }

    control {
        execute(TC());
    }
}
