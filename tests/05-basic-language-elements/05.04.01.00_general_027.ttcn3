// @requirement: 5.4.1.0 -- Keyword: template; Allowed kind of Parameterization: Value and template parameterization; Allowed form of Parameterization: Dynamic at runtime; Allowed types in formal parameter lists: all basic types, all user-defined types, address type and template.
// @id: TTCN3-CORE-5.4.1.0-026c
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_general_027 {

    type integer address;

    type record R {
        integer a
    }

    type record Msg {
        boolean f_bool,
        R f_rec,
        address f_addr,
        integer f_int
    }

    template Msg m_msg(boolean p_bool, R p_rec, address p_addr, template integer p_t) := {
        f_bool := p_bool,
        f_rec := p_rec,
        f_addr := p_addr,
        f_int := p_t
    }

    type component C {}

    testcase TC() runs on C {
        var Msg v_msg := { f_bool := true, f_rec := { a := 1 }, f_addr := 3, f_int := 4 };
        if (match(v_msg, m_msg(true, { a := 1 }, 3, ?))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
