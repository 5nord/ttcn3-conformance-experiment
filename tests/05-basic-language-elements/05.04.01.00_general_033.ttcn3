// @requirement: 5.4.1.0 -- Keyword: altstep; Allowed kind of Parameterization: Value and template parameterization; Allowed form of Parameterization: Dynamic at runtime; Allowed types in formal parameter lists: all basic types, all user-defined types, address type, component type, port type, default, template and timer.
// @id: TTCN3-CORE-5.4.1.0-028c
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_general_033 {

    type integer address;

    type record R {
        integer a
    }

    type port P message {
        inout integer
    }

    type component C {
        port P p;
        timer T;
    }

    altstep a_all(boolean p_bool, R p_rec, address p_addr, C p_comp, P p_port,
                  default p_def, template integer p_t, timer p_timer) {
        [] p_port.receive(p_t) {
            if (p_bool and p_rec.a == 1 and p_addr == 2 and p_comp != null and p_def != null) {
                setverdict(pass);
            } else {
                setverdict(fail);
            }
        }
        [] p_timer.timeout {
            setverdict(fail);
        }
    }

    altstep a_dummy() runs on C {
        [] T.timeout {}
    }

    testcase TC() runs on C {
        var default v_def := activate(a_dummy());
        timer T_guard := 1.0;
        connect(self:p, self:p);
        p.send(3);
        T_guard.start;
        a_all(true, { a := 1 }, 2, self, p, v_def, 3, T_guard);
        deactivate(v_def);
    }

    control {
        execute(TC());
    }
}
