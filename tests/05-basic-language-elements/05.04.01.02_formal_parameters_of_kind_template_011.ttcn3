// @requirement: 5.4.1.2 -- Formal template parameters can be restricted to accept actual parameters containing a restricted set of matching mechanisms only.
// @id: TTCN3-CORE-5.4.1.2-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_02_formal_parameters_of_kind_template_011 {
    type record R {
        integer f1 optional
    }
    type component C {}

    template R m_rec(template (omit) integer p_x) := { f1 := p_x };

    testcase TC() runs on C {
        var R v_omit := { f1 := omit };
        var R v_five := { f1 := 5 };
        if (match(v_omit, m_rec(omit)) and match(v_five, m_rec(5))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
