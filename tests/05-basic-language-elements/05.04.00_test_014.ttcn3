// @requirement: 5.4.0 -- **function** Value and template Dynamic at runtime all basic types, all user-defined types, address parameterization type, component type, port type, default, template and timer.
// @id: TTCN3-CORE-5.4.0-009b
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_00_test_014 {

    function f_square(integer p_x) return integer {
        return p_x * p_x;
    }

    type component C {}

    testcase TC() runs on C {
        var integer v_i;
        var integer v_sum := 0;
        for (v_i := 1; v_i <= 3; v_i := v_i + 1) {
            v_sum := v_sum + f_square(v_i);
        }
        if (v_sum == 14) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
