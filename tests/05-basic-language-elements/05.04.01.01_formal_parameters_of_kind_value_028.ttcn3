// @requirement: 5.4.1.1 -- f) Default values of component type formal parameters shall be one of the special values null, mtc, self, or system.
// @id: TTCN3-CORE-5.4.1.1-025a
// @verdict: pass reject
module M_05_04_01_01_formal_parameters_of_kind_value_028 {
    type component C {}

    function f_getComp() return C {
        return null;
    }

    function f_check(C p_comp := f_getComp()) return boolean { // error: not null, mtc, self or system
        return p_comp == null;
    }

    testcase TC() runs on C {
        if (f_check()) {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
