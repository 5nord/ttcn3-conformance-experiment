// @requirement: 5.1 -- If more than one modifier is applied to a language element, they may be applied in any order.
// @id: TTCN3-CORE-5.1-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_01_test_008 {

    type component C {}

    function f_first(in @lazy @deterministic integer p_value) return integer {
        return p_value;
    }

    function f_second(in @deterministic @lazy integer p_value) return integer {
        return p_value;
    }

    testcase TC() runs on C {
        if (f_first(1) == 1 and f_second(2) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
