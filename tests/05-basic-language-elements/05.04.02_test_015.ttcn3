// @requirement: 5.4.2 -- Furthermore it is allowed to use the dash symbol "-" as an actual out parameter, signifying that a possible result for that parameter will not be passed back.
// @id: TTCN3-CORE-5.4.2-011b
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_02_test_015 {

    type component C {
        var template integer vc_t := 0;
    }

    function f(out template integer p_t) runs on C {
        p_t := (1..5);
        if (not match(3, p_t)) {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var template integer v_t := 0;
        f(-);
        if (match(0, v_t) and not match(3, v_t) and match(0, vc_t) and not match(3, vc_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
