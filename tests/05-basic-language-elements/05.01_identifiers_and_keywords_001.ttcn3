// @requirement: 5.1 -- TTCN-3 identifiers are case sensitive.
// @id: TTCN3-CORE-5.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_01_identifiers_and_keywords_001 {

    const integer c_value := 1;
    const integer C_VALUE := 2;

    type component C {}

    testcase TC() runs on C {
        if (c_value == 1 and C_VALUE == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
