// @requirement: 5.3 -- Declarations in the module definitions part and in a component type definition may be made in any order.
// @id: TTCN3-CORE-5.3-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_03_ordering_of_language_elements_003 {

    testcase TC() runs on C {
        var R v_r := c_r;
        if (v_r.f_a == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    const R c_r := { f_a := c_one };

    type record R {
        integer f_a
    }

    const integer c_one := 1;

    type component C {}

    control {
        execute(TC());
    }
}
