// @requirement: 5.4.1.0 -- For all these three sorts of parameter passing, the formal parameters can both be read and set (i.e. get new values being assigned) within the parameterized object.
// @id: TTCN3-CORE-5.4.1.0-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_general_006 {

    type component C {}

    function f_in(in integer p_x) return integer {
        p_x := p_x + 1;
        return p_x;
    }

    function f_inout(inout integer p_x) {
        p_x := p_x + 1;
    }

    function f_out(out integer p_x) {
        p_x := 5;
        p_x := p_x + 1;
    }

    testcase TC() runs on C {
        var integer v_in := 1, v_inout := 1, v_out := 1;
        var integer v_res := f_in(v_in);
        f_inout(v_inout);
        f_out(v_out);
        if (v_res == 2 and v_in == 1 and v_inout == 2 and v_out == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
