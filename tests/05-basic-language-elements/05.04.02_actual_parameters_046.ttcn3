// @requirement: 5.4.2 -- Strong typing is required for inout formal (parameters passed by reference).
// @id: TTCN3-CORE-5.4.2-042a
// @verdict: pass reject
module M_05_04_02_actual_parameters_046 {

    type record R1 {
        integer a
    }

    type record R2 {
        integer a
    }

    type component C {}

    function f(inout R1 p_r) {
        p_r.a := 2;
    }

    testcase TC() runs on C {
        var R2 v_r := { a := 1 };
        f(v_r); // error: R2 is compatible with R1, but not the same type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
