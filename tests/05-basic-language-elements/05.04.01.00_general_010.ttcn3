// @requirement: 5.4.1.0 -- Both the actual and formal parameter shall be of the same type.
// @id: TTCN3-CORE-5.4.1.0-012a
// @verdict: pass reject
module M_05_04_01_00_general_010 {

    type component C {}

    type record R1 {
        integer a
    }

    type record R2 {
        integer a
    }

    function f_inc(inout R1 p_r) {
        p_r.a := p_r.a + 1;
    }

    testcase TC() runs on C {
        var R2 v_r := { a := 1 };
        f_inc(v_r); // error: actual parameter type R2 differs from formal parameter type R1
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
