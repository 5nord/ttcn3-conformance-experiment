// @requirement: 5.3 -- Inside a statement block, such as a function body or a branch of an if-else statement, declarations (if any) can occur at any place where a statement can occur.
// @id: TTCN3-CORE-5.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_03_ordering_of_language_elements_002 {

    type component C {}

    function f_compute() return integer {
        var integer v_a := 1;
        v_a := v_a + 1;
        const integer c_b := 3;
        var integer v_result := 0;
        if (v_a + c_b > 4) {
            v_result := 1;
        } else {
            v_result := 2;
            var integer v_c := 10;
            v_result := v_result + v_c;
        }
        return v_result;
    }

    testcase TC() runs on C {
        var integer v_x := f_compute();
        if (v_x == 12) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
