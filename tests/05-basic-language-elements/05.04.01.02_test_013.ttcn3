// @requirement: 5.4.1.2 -- The restriction template (omit) can be replaced by the shorthand notation omit.
// @id: TTCN3-CORE-5.4.1.2-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_02_test_013 {
    type record R {
        integer f1 optional
    }
    type component C {}

    template R m_rec(omit integer p_x) := { f1 := p_x };

    testcase TC() runs on C {
        var R v_omit := { f1 := omit };
        var R v_five := { f1 := 5 };
        if (match(v_omit, m_rec(omit)) and match(v_five, m_rec(5))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
