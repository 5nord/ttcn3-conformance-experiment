// @requirement: 5.4.2 -- When a formal parameter is an out parameter or has been defined with a default value or template, respectively, then it is not necessary to provide an actual parameter.
// @id: TTCN3-CORE-5.4.2-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_02_actual_parameters_025 {

    type component C {}

    function f_skip(out integer p_par1, in integer p_par2 := 2, in template integer p_par3 := ?)
    return integer {
        p_par1 := 1 + p_par2;
        return p_par1;
    }

    testcase TC() runs on C {
        if (f_skip() == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
