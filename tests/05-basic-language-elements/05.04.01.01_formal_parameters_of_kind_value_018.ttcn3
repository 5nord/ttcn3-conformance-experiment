// @requirement: 5.4.1.1 -- NOTE 2: Component and default references are also handled as value parameters.
// @id: TTCN3-CORE-5.4.1.1-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_01_formal_parameters_of_kind_value_018 {
    type component C {
        timer T;
    }

    altstep a_dummy() runs on C {
        [] T.timeout {}
    }

    function f_reset(C p_comp, default p_def) return boolean {
        var boolean v_ok := p_comp != null and p_def != null;
        p_comp := null;
        p_def := null;
        return v_ok;
    }

    testcase TC() runs on C {
        var C v_comp := mtc;
        var default v_def := activate(a_dummy());
        if (f_reset(v_comp, v_def) and v_comp == mtc and v_def != null) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        deactivate(v_def);
    }

    control {
        execute(TC());
    }
}
