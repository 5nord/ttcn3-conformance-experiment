// @requirement: 5.4.2 -- NOTE 3: If assignment notation has been used for the actual parameter list, the order of the evaluation of actual parameters may differ from the order of the parameters in the formal parameter list.
// @id: TTCN3-CORE-5.4.2-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_02_actual_parameters_032 {

    type component C {
        var integer vc_count := 0;
    }

    function f_next() runs on C return integer {
        vc_count := vc_count + 1;
        return vc_count;
    }

    function f(integer p_a, integer p_b) return boolean {
        return p_a == 2 and p_b == 1;
    }

    testcase TC() runs on C {
        if (f(p_b := f_next(), p_a := f_next())) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
