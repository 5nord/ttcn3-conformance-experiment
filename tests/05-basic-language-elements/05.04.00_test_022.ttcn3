// @requirement: 5.4.0 -- The templates for the signatures can be parameterized, however.
// @id: TTCN3-CORE-5.4.0-015a
// @verdict: pass accept, noexecution
module M_05_04_00_test_022 {

    signature S(in integer p_a, in charstring p_b);

    template S s_call(integer p_x, template charstring p_y) := {
        p_a := p_x,
        p_b := p_y
    }

    template S s_concrete := s_call(1, ?);
}
