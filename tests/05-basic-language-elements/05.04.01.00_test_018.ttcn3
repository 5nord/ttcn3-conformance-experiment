// @requirement: 5.4.1.0 -- Formal value or template parameters that are declared lazy or fuzzy can be additionally declared deterministic using the @deterministic modifier.
// @id: TTCN3-CORE-5.4.1.0-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_test_018 {

    type component C {}

    function f_check(in @lazy @deterministic integer p_lazy,
                     in @fuzzy @deterministic integer p_fuzzy) return boolean {
        return p_lazy == 1 and p_fuzzy == 2;
    }

    testcase TC() runs on C {
        if (f_check(1, 2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
