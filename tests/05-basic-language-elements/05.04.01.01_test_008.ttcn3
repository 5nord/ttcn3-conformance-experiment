// @requirement: 5.4.1.1 -- In parameters may have a default value, which is given by an expression assigned to the parameter.
// @id: TTCN3-CORE-5.4.1.1-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_01_test_008 {
    type component C {}

    function f_comp(in integer p_int1, in integer p_int2 := 3) return integer {
        return p_int1 + p_int2;
    }

    testcase TC() runs on C {
        if (f_comp(1) == 4 and f_comp(1, 2) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
