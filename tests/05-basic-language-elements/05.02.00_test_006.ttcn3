// @requirement: 5.2.0 -- Definitions made in the module definitions part but outside of other scope units are globally visible, i.e. may be used elsewhere in the module, including all functions, test cases and altsteps defined within the module.
// @id: TTCN3-CORE-5.2.0-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_02_00_test_006 {

    const integer c_global := 7;

    type component C {
        timer T := 0.1;
    }

    function f_get() return integer {
        return c_global;
    }

    altstep a_check() runs on C {
        [c_global == 7] T.timeout {
            setverdict(pass);
        }
    }

    testcase TC() runs on C {
        if (f_get() != c_global) {
            setverdict(fail);
            stop;
        }
        T.start;
        a_check();
    }

    control {
        execute(TC());
    }
}
