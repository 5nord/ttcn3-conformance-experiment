// @requirement: 5.4.1.0 -- Keyword: template; Allowed kind of Parameterization: Value and template parameterization; Allowed form of Parameterization: Dynamic at runtime; Allowed types in formal parameter lists: all basic types, all user-defined types, address type and template.
// @id: TTCN3-CORE-5.4.1.0-026b
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_general_026 {

    type component C {}

    template integer m_range(integer p_low, template integer p_t) := (p_low .. 10) ifpresent;

    template integer m_int(template integer p_t) := p_t;

    testcase TC() runs on C {
        var integer v_i;
        for (v_i := 0; v_i < 3; v_i := v_i + 1) {
            if (not match(v_i, m_int(v_i)) or match(v_i + 1, m_int(v_i))) {
                setverdict(fail);
            }
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
