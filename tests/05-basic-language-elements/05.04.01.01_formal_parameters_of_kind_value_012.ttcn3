// @requirement: 5.4.1.1 -- the language element module allows static value parameterization to support test suite parameters, i.e. this parameterization may or may not be resolvable at compile-time but shall be resolved by the commencement of runtime (i.e. static at runtime).
// @id: TTCN3-CORE-5.4.1.1-013b
// @verdict: pass accept, noexecution
module M_05_04_01_01_formal_parameters_of_kind_value_012 {
    modulepar integer PX_VALUE;

    function f_use() return integer {
        return PX_VALUE + 1;
    }
}
