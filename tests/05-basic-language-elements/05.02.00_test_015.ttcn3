// @requirement: 5.2.0 -- Declarations made within a statement block have local visibility.
// @id: TTCN3-CORE-5.2.0-024a
// @verdict: pass reject
module M_05_02_00_test_015 {

    type component C {}

    testcase TC() runs on C {
        {
            var integer v_block := 1;
        }
        if (v_block == 1) { // error: v_block is local to the statement block
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
