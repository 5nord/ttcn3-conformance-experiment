// @requirement: 5.4.1.1 -- e) The expression of formal parameter's default value has to be compatible with the type of the parameter.
// @id: TTCN3-CORE-5.4.1.1-023a
// @verdict: pass reject
module M_05_04_01_01_formal_parameters_of_kind_value_025 {
    type component C {}

    function f_id(integer p_x := "abc") return integer { // error: default value of wrong type
        return p_x;
    }

    testcase TC() runs on C {
        if (f_id(1) == 1) {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
