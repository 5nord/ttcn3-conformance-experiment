// @requirement: 5.4.3 -- The actual parameter is equal to an empty record of value or template in this case.
// @id: TTCN3-CORE-5.4.3-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_03_variadic_parameters_005 {

    type record of integer RoI;

    type component C {}

    function f_test(integer p_values...) return RoI {
        return p_values;
    }

    testcase TC() runs on C {
        var RoI v_empty := {};
        if (f_test() == v_empty and f_test(-) == v_empty) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
