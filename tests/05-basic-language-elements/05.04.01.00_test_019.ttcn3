// @requirement: 5.4.1.0 -- NOTE 2: The actual values of component variables used in the delayed evaluation of a lazy or fuzzy parameter may differ from their values at the time, when the parameterized function or altstep was called.
// @id: TTCN3-CORE-5.4.1.0-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_test_019 {

    type component C {
        var integer vc_int := 1;
    }

    function f_lazy(in @lazy integer p_v) runs on C {
        vc_int := 5;
        if (p_v == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        f_lazy(vc_int);
    }

    control {
        execute(TC());
    }
}
