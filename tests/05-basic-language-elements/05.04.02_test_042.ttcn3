// @requirement: 5.4.2 -- For each formal parameter without default value, there shall be an actual parameter.
// @id: TTCN3-CORE-5.4.2-038a
// @verdict: pass reject
module M_05_04_02_test_042 {

    type component C {}

    function f(integer p_a, integer p_b) {
    }

    testcase TC() runs on C {
        f(p_a := 1); // error: no actual parameter for p_b
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
