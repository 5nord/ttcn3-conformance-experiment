// @requirement: 5.2.0 -- NOTE 4: Built in TTCN-3 types like integer, charstring, anytype, etc. are not scope units, but all named user defined types are scope units, independent of their kinds.
// @id: TTCN3-CORE-5.2.0-015b
// @verdict: pass accept, ttcn3verdict:pass
module M_05_02_00_test_004 {

    type record R {
        integer f_a,
        integer f_b
    }

    type set S {
        integer f_a,
        integer f_b
    }

    type union U {
        integer f_a,
        charstring f_b
    }

    type component C {}

    testcase TC() runs on C {
        var R v_r := { f_a := 1, f_b := 2 };
        var S v_s := { f_a := 3, f_b := 4 };
        var U v_u := { f_a := 5 };
        if (v_r.f_a + v_s.f_a + v_u.f_a == 9) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
