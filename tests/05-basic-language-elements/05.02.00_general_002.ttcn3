// @requirement: 5.2.0 -- They may occur as stand-alone statement blocks, embedded in another statement block or within compound statements, e.g. as body of a while loop.
// @id: TTCN3-CORE-5.2.0-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_02_00_general_002 {

    type component C {}

    testcase TC() runs on C {
        var integer v_sum := 0;
        var integer v_i := 0;
        {
            var integer v_a := 1;
            {
                var integer v_b := 2;
                v_sum := v_sum + v_a + v_b;
            }
        }
        while (v_i < 3) {
            var integer v_c := 10;
            v_sum := v_sum + v_c;
            v_i := v_i + 1;
        }
        if (v_sum == 33) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
