// @requirement: 5.4.1.0 -- If not stated otherwise, a formal parameter is an in parameter.
// @id: TTCN3-CORE-5.4.1.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_test_005 {

    type component C {}

    function f_set(integer p_x) {
        p_x := 2;
    }

    testcase TC() runs on C {
        var integer v_x := 1;
        f_set(v_x);
        if (v_x == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
