// @requirement: 5.4.2 -- Values, templates, timers and/or ports can be passed into parameterized TTCN-3 objects as actual parameters.
// @id: TTCN3-CORE-5.4.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_02_actual_parameters_001 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
    }

    function f(integer p_v, template integer p_t, timer p_timer, P p_port) runs on C {
        if (match(p_v, p_t) and p_timer.running) {
            p_port.send(p_v);
        }
        alt {
            [] p.receive(5) {
                setverdict(pass);
            }
            [] p_timer.timeout {
                setverdict(fail);
            }
        }
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p, self:p);
        T.start;
        f(5, (1..10), T, p);
    }

    control {
        execute(TC());
    }
}
