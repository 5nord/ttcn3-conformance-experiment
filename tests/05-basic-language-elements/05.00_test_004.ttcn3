// @requirement: 5.0 -- The control function may also declare (local) variables, etc.
// @id: TTCN3-CORE-5.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_00_test_004 {

    type component C {}

    testcase TC(integer p_value) runs on C {
        if (p_value == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_value := 1;
        v_value := v_value + 1;
        execute(TC(v_value));
    }
}
