// @requirement: 5.4.2 -- For out formal template parameters, the template restriction of the actual parameter shall not be more restrictive than the one of the formal parameter.
// @id: TTCN3-CORE-5.4.2-044a
// @verdict: pass reject
module M_05_04_02_actual_parameters_048 {

    type component C {}

    function f(out template integer p_t) {
        p_t := 1;
    }

    testcase TC() runs on C {
        var template(value) integer v_t := 0;
        f(v_t); // error: template(value) actual for unrestricted out formal template parameter
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
