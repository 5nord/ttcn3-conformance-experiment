// @requirement: 5.4.2 -- The actual parameters are evaluated in the order of their appearance.
// @id: TTCN3-CORE-5.4.2-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_02_test_027 {

    type component C {
        var integer vc_count := 0;
    }

    function f_next() runs on C return integer {
        vc_count := vc_count + 1;
        return vc_count;
    }

    function f(integer p_a, integer p_b, integer p_c) return boolean {
        return p_a == 1 and p_b == 2 and p_c == 3;
    }

    testcase TC() runs on C {
        if (f(f_next(), f_next(), f_next())) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
