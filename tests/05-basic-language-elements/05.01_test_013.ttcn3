module M_05_01_test_013 {

    group g_constants {
        const integer c_value := 1;
    }

    type component C {}

    testcase TC() runs on C {
        if (c_value == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
