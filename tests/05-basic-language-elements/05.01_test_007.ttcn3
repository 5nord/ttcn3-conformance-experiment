// @requirement: 5.1 -- Special TTCN-3 modifiers are identifiers prefixed with the @-symbol (see annex A).
// @id: TTCN3-CORE-5.1-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_01_test_007 {

    type component C {}

    testcase TC() runs on C {
        if (match("ABC", pattern @nocase "abc")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
