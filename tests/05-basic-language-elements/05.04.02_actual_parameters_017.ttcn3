// @requirement: 5.4.2 -- When actual parameters that are passed to in formal value or template parameters contain a value or template reference, rules for using references on the right hand side of assignments apply.
// @id: TTCN3-CORE-5.4.2-013a
// @verdict: pass accept, ttcn3verdict:error
module M_05_04_02_actual_parameters_017 {

    type union U {
        integer a,
        integer b
    }

    type component C {}

    function f(in integer p_i) {
    }

    testcase TC() runs on C {
        var U v_u := { a := 1 };
        f(v_u.b); // non-chosen union alternative referenced as on a right hand side: error
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
