// @requirement: 5.4.1.1 -- Value formal parameters may be in, inout or out parameters.
// @id: TTCN3-CORE-5.4.1.1-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_01_test_004 {
    type component C {}

    function f_kinds(in integer p_in, inout integer p_inout, out integer p_out) {
        p_inout := p_inout + p_in;
        p_out := p_in * 2;
    }

    testcase TC() runs on C {
        var integer v_inout := 10, v_out;
        f_kinds(3, v_inout, v_out);
        if (v_inout == 13 and v_out == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
