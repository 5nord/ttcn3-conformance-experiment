// @requirement: 5.4.1.0 -- This default value is used when no actual parameter is provided.
// @id: TTCN3-CORE-5.4.1.0-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_test_012 {

    type component C {}

    function f_add(in integer p_x, in integer p_y := 3) return integer {
        return p_x + p_y;
    }

    testcase TC() runs on C {
        if (f_add(1) == 4 and f_add(1, -) == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
