// @requirement: 5.4.2 -- If for some formal parameters, no actual parameter has been provided, if they are out parameters, the dash symbol "-" and for in parameters their default values are taken.
// @id: TTCN3-CORE-5.4.2-026b
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_02_test_029 {

    type component C {}

    function f(in integer p_a, in integer p_b := 5) return integer {
        return p_a + p_b;
    }

    testcase TC() runs on C {
        if (f(1) == 6 and f(p_a := 1) == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
