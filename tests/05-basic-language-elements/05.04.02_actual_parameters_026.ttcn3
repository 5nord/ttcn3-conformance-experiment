// @requirement: 5.4.2 -- In such a case the default value or template is taken as actual parameter.
// @id: TTCN3-CORE-5.4.2-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_02_actual_parameters_026 {

    type component C {}

    function f(in integer p_v := 2, in template integer p_t := (1..3)) return boolean {
        return p_v == 2 and match(3, p_t) and not match(4, p_t);
    }

    testcase TC() runs on C {
        if (f() and f(-, -)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
