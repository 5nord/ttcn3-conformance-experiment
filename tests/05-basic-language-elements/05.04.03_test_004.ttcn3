// @requirement: 5.4.3 -- The actual parameter is not present in the list of actual parameters or skipped by using the dash symbol.
// @id: TTCN3-CORE-5.4.3-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_03_test_004 {

    type component C {}

    function f_count(integer p_values...) return integer {
        return lengthof(p_values);
    }

    testcase TC() runs on C {
        var integer v_absent := f_count();
        var integer v_skipped := f_count(-);
        if (v_absent == 0 and v_skipped == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
