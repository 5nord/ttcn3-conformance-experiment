// @requirement: 5.2.0 -- Stand-alone statement blocks and statements within compound statements, like e.g. if-else, while, do-while, or `alt` statements may be used within test cases, altsteps, functions, or may be embedded in other statement blocks or compound statements, e.g. an if-else statement that is used within a while loop.
// @id: TTCN3-CORE-5.2.0-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_02_00_general_013 {

    type component C {
        timer T := 0.1;
    }

    function f_count() return integer {
        var integer v_i := 0;
        var integer v_even := 0;
        while (v_i < 4) {
            if (v_i mod 2 == 0) {
                v_even := v_even + 1;
            } else {
                {
                    do {
                        v_i := v_i + 0;
                    } while (false);
                }
            }
            v_i := v_i + 1;
        }
        return v_even;
    }

    altstep a_wait() runs on C {
        [] T.timeout {
            {
                if (f_count() == 2) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
        }
    }

    testcase TC() runs on C {
        {
            T.start;
            if (true) {
                alt {
                    [] a_wait();
                }
            }
        }
    }

    control {
        execute(TC());
    }
}
