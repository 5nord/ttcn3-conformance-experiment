// @requirement: 5.4.1.1 -- h) The dash (don't change) symbol shall be used with formal parameters of modified templates only (see also clause 15.5).
// @id: TTCN3-CORE-5.4.1.1-027a
// @verdict: pass reject
module M_05_04_01_01_formal_parameters_of_kind_value_030 {
    type component C {}

    function f_id(integer p_x := -) return integer { // error: dash outside a modified template
        return p_x;
    }

    testcase TC() runs on C {
        if (f_id(1) == 1) {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
