// @requirement: 5.4.2 -- Furthermore it is allowed to use the dash symbol "-" as an actual out parameter, signifying that a possible result for that parameter will not be passed back.
// @id: TTCN3-CORE-5.4.2-006b
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_02_test_009 {

    type component C {
        var integer vc_i := 0;
    }

    function f(out integer p_o) runs on C {
        p_o := 5;
        if (p_o != 5) {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var integer v_i := 0;
        f(-);
        if (v_i == 0 and vc_i == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
