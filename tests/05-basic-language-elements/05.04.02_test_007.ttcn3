// @requirement: 5.4.2 -- Actual parameters that are passed to out formal value parameters shall be (template) variables, formal (template) parameters (of in, inout or out parameterization) or references to elements of (template) variables or formal (template) parameters of structured types.
// @id: TTCN3-CORE-5.4.2-005a
// @verdict: pass reject
module M_05_04_02_test_007 {

    type component C {}

    const integer c_i := 1;

    function f(out integer p_i) {
        p_i := 2;
    }

    testcase TC() runs on C {
        f(c_i); // error: constant passed to out formal value parameter
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
