// @requirement: 5.4.1.2 -- i) When template parameters are referenced (e.g. in assignments, expressions, template bodies, etc.), the rules for template variables shall apply.
// @id: TTCN3-CORE-5.4.1.2-024a
// @verdict: pass reject
module M_05_04_01_02_formal_parameters_of_kind_template_024 {

    type component C {}

    function f(template integer p_t) {
        var integer v_i := p_t; // error: template parameter assigned to a value variable
    }

    testcase TC() runs on C {
        f(1);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
