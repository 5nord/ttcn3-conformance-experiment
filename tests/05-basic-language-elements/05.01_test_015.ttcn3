// @requirement: 5.1 -- Language element: Data type definitions; Associated keyword: type; Specified in module definitions: Yes
// @id: TTCN3-CORE-5.1-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_01_test_015 {

    type integer MyInt (1 .. 10);

    type component C {}

    testcase TC() runs on C {
        var MyInt v_value := 5;
        if (v_value == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
