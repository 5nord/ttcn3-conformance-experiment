// @requirement: 5.4.0 -- TTCN-3 allows to parameterize modules, templates, functions, altsteps and testcases.
// @id: TTCN3-CORE-5.4.0-001d
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_00_general_004 {

    type component C {
        timer T := 0.1;
    }

    altstep a_check(integer p_x) runs on C {
        [p_x == 1] T.timeout {
            setverdict(pass);
        }
        [p_x != 1] T.timeout {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        T.start;
        a_check(1);
    }

    control {
        execute(TC());
    }
}
