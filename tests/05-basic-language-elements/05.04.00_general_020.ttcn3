// @requirement: 5.4.0 -- **testcase** Value and template Dynamic at runtime all basic types and of all user-defined types, parameterization `address type, component type and template.`
// @id: TTCN3-CORE-5.4.0-013b
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_00_general_020 {

    type component C {}

    testcase TC(integer p_x, integer p_expected) runs on C {
        if (p_x * 2 == p_expected) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_i;
        for (v_i := 1; v_i <= 2; v_i := v_i + 1) {
            execute(TC(v_i, v_i + v_i));
        }
    }
}
