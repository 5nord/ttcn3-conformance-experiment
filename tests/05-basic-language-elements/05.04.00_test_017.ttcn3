// @requirement: 5.4.0 -- **altstep** Value and template Dynamic at runtime all basic types, all user-defined types, address parameterization type, component type, port type, default, template and timer.
// @id: TTCN3-CORE-5.4.0-011b
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_00_test_017 {

    type component C {
        timer T := 0.1;
        var integer vc_hits := 0;
    }

    altstep a_count(integer p_x) runs on C {
        [p_x mod 2 == 0] T.timeout {
            vc_hits := vc_hits + 1;
        }
        [p_x mod 2 != 0] T.timeout {
        }
    }

    testcase TC() runs on C {
        var integer v_i;
        for (v_i := 0; v_i < 4; v_i := v_i + 1) {
            T.start;
            a_count(v_i);
        }
        if (vc_hits == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
