// @requirement: 5.4.0 -- **testcase** Value and template Dynamic at runtime all basic types and of all user-defined types, parameterization `address type, component type and template.`
// @id: TTCN3-CORE-5.4.0-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_00_general_019 {

    type component C {}

    testcase TC(integer p_value, template integer p_tmpl) runs on C {
        if (match(p_value, p_tmpl)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC(5, (1 .. 10)));
    }
}
