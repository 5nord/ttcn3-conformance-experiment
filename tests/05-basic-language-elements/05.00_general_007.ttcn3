// @requirement: 5.0 -- Finally, TTCN-3 language elements may be assigned attributes such as encoding information and display attributes.
// @id: TTCN3-CORE-5.0-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_00_general_007 {

    type integer MyInt with { encode "MyEncoding"; display "red" }

    type component C {}

    testcase TC() runs on C {
        var MyInt v_value := 1;
        if (v_value == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
