// @requirement: 5.4.3 -- Using a single parameter of a compatible record of the specified type followed by ....
// @id: TTCN3-CORE-5.4.3-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_03_test_008 {

    type record of integer RoI;

    type component C {}

    function f_count(integer p_values...) return integer {
        return lengthof(p_values);
    }

    testcase TC() runs on C {
        var RoI v_list := { 1, 2, 3 };
        if (f_count(v_list...) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
