// @requirement: 5.4.1.2 -- If a default template is used, it is evaluated in the scope of the parameterized entity, not the scope of the actual parameter list.
// @id: TTCN3-CORE-5.4.1.2-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_02_test_010 {
    import from M_05_04_01_02_test_010_A { function f_check };

    type component C {}

    const integer c_val := 1;

    testcase TC() runs on C {
        if (f_check()) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_05_04_01_02_test_010_A {
    const integer c_val := 7;

    function f_check(template integer p_t := c_val) return boolean {
        return match(7, p_t) and not match(1, p_t);
    }
}
