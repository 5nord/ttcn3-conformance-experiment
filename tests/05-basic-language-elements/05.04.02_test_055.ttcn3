// @requirement: 5.4.2 -- j) Unless specified differently in the relevant clause(s), actual parameters passed to in or inout formal parameters shall be at least partially initialized (for an exemption see e.g. clause 16.1.2).
// @id: TTCN3-CORE-5.4.2-053a
// @verdict: pass accept, ttcn3verdict:error
module M_05_04_02_test_055 {

    type component C {}

    function f(in integer p_i) return integer {
        return 1;
    }

    testcase TC() runs on C {
        var integer v_i;
        if (f(v_i) == 1) { // uninitialized actual parameter: error
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
