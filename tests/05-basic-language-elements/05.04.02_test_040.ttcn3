// @requirement: 5.4.2 -- c) When using assignment notation, each formal parameter shall be assigned an actual parameter at most once.
// @id: TTCN3-CORE-5.4.2-036a
// @verdict: pass reject
module M_05_04_02_test_040 {

    type component C {}

    function f(integer p_a, integer p_b) {
    }

    testcase TC() runs on C {
        f(p_a := 1, p_b := 2, p_a := 3); // error: p_a assigned twice
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
