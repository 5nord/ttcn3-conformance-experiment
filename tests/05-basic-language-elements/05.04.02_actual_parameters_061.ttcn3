// @requirement: 5.4.2 -- n) If two or more actual parameters passed to inout parameters of the same parameterized TTCN-3 object contain a reference to distinct alternatives of the same union or anytype value, an error shall be produced.
// @id: TTCN3-CORE-5.4.2-059a
// @verdict: pass reject
module M_05_04_02_actual_parameters_061 {

    type union U {
        integer i,
        boolean b
    }

    type component C {}

    function f_test(inout integer p_int, inout boolean p_bool) {
        p_int := 1;
        p_bool := true;
    }

    testcase TC() runs on C {
        var U v_u := { i := 0 };
        f_test(v_u.i, v_u.b); // error: distinct alternatives of the same union value
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
