// @requirement: 5.4.2 -- The actual parameter of a formal out parameter or in parameter with default value can be skipped by using dash "-" as actual parameter.
// @id: TTCN3-CORE-5.4.2-032a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_02_actual_parameters_037 {

    type component C {}

    function f_skip(out integer p_par1, in integer p_par2 := 2, in integer p_par3) return integer {
        p_par1 := 1 + p_par2;
        return p_par1 + p_par3;
    }

    testcase TC() runs on C {
        if (f_skip(-, -, 10) == 13) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
