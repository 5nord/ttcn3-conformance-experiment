// @requirement: 5.4.1.0 -- Formal value or template parameters may be declared lazy using the @lazy modifier.
// @id: TTCN3-CORE-5.4.1.0-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_test_014 {

    type component C {}

    function f_lazy(in @lazy integer p_v, in template @lazy integer p_t) return boolean {
        return match(p_v, p_t);
    }

    testcase TC() runs on C {
        if (f_lazy(1, (0 .. 2))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
