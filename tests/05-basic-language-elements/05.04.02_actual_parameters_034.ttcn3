// @requirement: 5.4.2 -- a) When using list notation, the order of elements in the actual parameter list shall be the same as their order in the corresponding formal parameter list.
// @id: TTCN3-CORE-5.4.2-030a
// @verdict: pass reject
module M_05_04_02_actual_parameters_034 {

    type component C {}

    function f(integer p_i, boolean p_b) {
    }

    testcase TC() runs on C {
        f(true, 1); // error: actual parameters not in the order of the formal parameters
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
