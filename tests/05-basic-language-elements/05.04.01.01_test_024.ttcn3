// @requirement: 5.4.1.1 -- d) Default values can be provided for in parameters only.
// @id: TTCN3-CORE-5.4.1.1-022a
// @verdict: pass reject
module M_05_04_01_01_test_024 {
    type component C {}

    function f_inc(inout integer p_x := 1) { // error: default value for inout parameter
        p_x := p_x + 1;
    }

    testcase TC() runs on C {
        var integer v_x := 0;
        f_inc(v_x);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
