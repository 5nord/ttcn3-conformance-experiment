// @requirement: 5.4.1.0 -- Similarly, if it is passed to a lazy formal parameter, it becomes lazy within the called function.
// @id: TTCN3-CORE-5.4.1.0-035a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_general_041 {

    type component C {
        var integer vc_count := 0;
    }

    function f_next() runs on C return integer {
        vc_count := vc_count + 1;
        return vc_count;
    }

    function f_lazy(in @lazy integer p_v) runs on C {
        var integer v_before := vc_count;
        var integer v_first := p_v;
        var integer v_second := p_v;
        if (v_before == 0 and v_first == 1 and v_second == 1 and vc_count == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    function f_fuzzy(in @fuzzy integer p_v) runs on C {
        f_lazy(p_v);
    }

    testcase TC() runs on C {
        f_fuzzy(f_next());
    }

    control {
        execute(TC());
    }
}
