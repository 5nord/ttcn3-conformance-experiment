// @requirement: 5.4.1.2 -- Such limitations can be expressed by the restrictions omit, present, and value.
// @id: TTCN3-CORE-5.4.1.2-012a
// @verdict: pass accept, noexecution
module M_05_04_01_02_test_012 {
    function f_restricted(template (omit) integer p_omit,
                          template (present) integer p_present,
                          template (value) integer p_value) return boolean {
        return match(1, p_omit) or match(1, p_present) or match(1, p_value);
    }
}
