// @requirement: 5.4.1.0 -- Keyword: function; Allowed kind of Parameterization: Value and template parameterization; Allowed form of Parameterization: Dynamic at runtime; Allowed types in formal parameter lists: all basic types, all user-defined types, address type, component type, port type, default, template and timer.
// @id: TTCN3-CORE-5.4.1.0-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_test_028 {

    type component C {}

    function f_match(integer p_v, template integer p_t) return boolean {
        return match(p_v, p_t);
    }

    testcase TC() runs on C {
        if (f_match(1, (0 .. 2)) and not f_match(3, (0 .. 2))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
