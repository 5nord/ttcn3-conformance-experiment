// @requirement: 5.4.2 -- The value is passed back to the actual parameter only if within the invoked object a value is assigned to it.
// @id: TTCN3-CORE-5.4.2-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_02_test_020 {

    type component C {}

    function f(boolean p_assign, out integer p_o) {
        if (p_assign) {
            p_o := 5;
        }
    }

    testcase TC() runs on C {
        var integer v_a := 10;
        var integer v_b := 20;
        f(true, v_a);
        f(false, v_b);
        if (v_a == 5 and v_b == 20) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
