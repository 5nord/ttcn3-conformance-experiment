// @requirement: 5.4.1.1 -- the language elements template, testcase, `altstep and function support dynamic value` parameterization (i.e. this parameterization shall be resolved at runtime).
// @id: TTCN3-CORE-5.4.1.1-015b
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_01_formal_parameters_of_kind_value_017 {
    type component C {
        timer T;
    }

    template integer m_value(integer p_x) := p_x;

    function f_id(integer p_x) return integer {
        return p_x;
    }

    altstep a_check(integer p_x, integer p_expected) runs on C {
        [] T.timeout {
            if (p_x == p_expected) {
                setverdict(pass);
            } else {
                setverdict(fail);
            }
        }
    }

    testcase TC(integer p_x) runs on C {
        var integer v_x := p_x + float2int(rnd() * 100.0);
        if (f_id(v_x) != v_x or not match(v_x, m_value(v_x))) {
            setverdict(fail);
        }
        T.start(0.1);
        alt {
            [] a_check(v_x, v_x);
        }
    }

    control {
        var integer v_arg := float2int(rnd() * 100.0);
        execute(TC(v_arg));
    }
}
