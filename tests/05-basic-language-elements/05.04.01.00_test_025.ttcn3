// @requirement: 5.4.1.0 -- Keyword: template; Allowed kind of Parameterization: Value and template parameterization; Allowed form of Parameterization: Dynamic at runtime; Allowed types in formal parameter lists: all basic types, all user-defined types, address type and template.
// @id: TTCN3-CORE-5.4.1.0-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_00_test_025 {

    type component C {}

    type record R {
        integer a,
        integer b
    }

    template R m_r(integer p_v, template integer p_t) := {
        a := p_v,
        b := p_t
    }

    testcase TC() runs on C {
        var R v_r := { a := 1, b := 5 };
        if (match(v_r, m_r(1, (0 .. 9))) and not match(v_r, m_r(1, 2))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
