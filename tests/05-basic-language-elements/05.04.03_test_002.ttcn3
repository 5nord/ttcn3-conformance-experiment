// @requirement: 5.4.3 -- Such formal parameter is called variadic parameter and accepts zero or more values of the specified type.
// @id: TTCN3-CORE-5.4.3-002b
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_03_test_002 {

    type component C {}

    function f_count(integer p_values...) return integer {
        return lengthof(p_values);
    }

    testcase TC() runs on C {
        if (f_count() == 0 and f_count(7) == 1 and f_count(1, 2, 3) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
