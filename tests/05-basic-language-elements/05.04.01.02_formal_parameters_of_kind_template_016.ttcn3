// @requirement: 5.4.1.2 -- c) Default templates can be provided for in parameters only.
// @id: TTCN3-CORE-5.4.1.2-017a
// @verdict: pass reject
module M_05_04_01_02_formal_parameters_of_kind_template_016 {
    type component C {}

    function f_set(out template integer p_t := ?) { // error: default template for out parameter
        p_t := 1;
    }

    testcase TC() runs on C {
        var template integer vt_x;
        f_set(vt_x);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
