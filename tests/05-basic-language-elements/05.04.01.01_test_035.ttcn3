// @requirement: 5.4.1.1 -- l) Only function and altstep definitions with the exception of functions or altsteps started as test component behaviour (see clause 21.3.2) may have formal parameters of a port, timer or default type or of a type that contains a direct or indirect element or field of a port, default or timer type.
// @id: TTCN3-CORE-5.4.1.1-031b
// @verdict: pass reject
module M_05_04_01_01_test_035 {
    type component C {
        timer T;
    }

    function f_ptc(timer p_timer) runs on C {
        setverdict(pass);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc(T)); // error: started function has a timer parameter
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
