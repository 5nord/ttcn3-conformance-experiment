// @requirement: 5.0 -- Modules can have module parameters to allow test suite parameterization.
// @id: TTCN3-CORE-5.0-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_00_general_003 {

    modulepar integer mp_value := 1;

    type component C {}

    testcase TC() runs on C {
        if (mp_value == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
