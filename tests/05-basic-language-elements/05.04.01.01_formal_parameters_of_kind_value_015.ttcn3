// @requirement: 5.4.1.1 -- This means that, at runtime, module parameter values are globally visible but not changeable (see more details in clause 8.2);
// @id: TTCN3-CORE-5.4.1.1-014b
// @verdict: pass reject
module M_05_04_01_01_formal_parameters_of_kind_value_015 {
    modulepar integer PX_VALUE := 3;

    type component C {}

    testcase TC() runs on C {
        PX_VALUE := 4; // error: module parameter changed at runtime
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
