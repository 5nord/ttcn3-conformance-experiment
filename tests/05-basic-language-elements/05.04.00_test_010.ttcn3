// @requirement: 5.4.0 -- **template** Value and template Dynamic at runtime all basic types, all user-defined types, address type parameterization and template.
// @id: TTCN3-CORE-5.4.0-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_00_test_010 {

    type record R {
        integer f_a,
        integer f_b
    }

    template R m_r(integer p_a, template integer p_b) := { f_a := p_a, f_b := p_b };

    type component C {}

    testcase TC() runs on C {
        var R v_r := { f_a := 1, f_b := 7 };
        if (match(v_r, m_r(1, (5 .. 9))) and not match(v_r, m_r(1, (1 .. 3)))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
