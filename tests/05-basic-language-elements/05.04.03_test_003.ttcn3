// @requirement: 5.4.3 -- Inside the parameterized scope, the type of the formal variadic parameter is a record of the specified type.
// @id: TTCN3-CORE-5.4.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_03_test_003 {

    type record of integer RoI;

    type component C {}

    function f_test(integer p_values...) return RoI {
        var RoI v_list := p_values;
        return v_list;
    }

    testcase TC() runs on C {
        if (f_test(1, 2) == { 1, 2 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
