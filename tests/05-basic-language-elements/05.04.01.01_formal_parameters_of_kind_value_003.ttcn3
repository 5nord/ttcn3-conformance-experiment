// @requirement: 5.4.1.1 -- Value formal parameters can be used within the parameterized object the same way as values, for example in expressions.
// @id: TTCN3-CORE-5.4.1.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_01_01_formal_parameters_of_kind_value_003 {
    type component C {}

    function f_calc(integer p_x) return integer {
        var integer v_y := p_x * 2 + 1;
        if (p_x > 0) {
            return v_y;
        }
        return -1;
    }

    testcase TC() runs on C {
        if (f_calc(3) == 7) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
