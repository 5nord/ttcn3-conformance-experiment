// @requirement: 5.4.0 -- TTCN-3 allows to parameterize modules, templates, functions, altsteps and testcases.
// @id: TTCN3-CORE-5.4.0-001c
// @verdict: pass accept, ttcn3verdict:pass
module M_05_04_00_general_003 {

    function f_add(integer p_a, integer p_b) return integer {
        return p_a + p_b;
    }

    type component C {}

    testcase TC() runs on C {
        if (f_add(1, 2) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
