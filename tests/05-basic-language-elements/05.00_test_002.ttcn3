// @requirement: 5.0 -- A module can import definitions from other modules.
// @id: TTCN3-CORE-5.0-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_00_test_002 {

    import from M_05_00_test_002_imported all;

    type component C {}

    testcase TC() runs on C {
        if (c_value == 42) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_05_00_test_002_imported {
    const integer c_value := 42;
}
