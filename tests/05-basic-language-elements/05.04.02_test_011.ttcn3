// @requirement: 5.4.2 -- NOTE 1: Reference to a string element cannot be passed by reference as string types are not structured types.
// @id: TTCN3-CORE-5.4.2-008a
// @verdict: pass reject
module M_05_04_02_test_011 {

    type component C {}

    function f(inout charstring p_s) {
        p_s := "x";
    }

    testcase TC() runs on C {
        var charstring v_s := "abc";
        f(v_s[0]); // error: string element passed by reference
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
