// @requirement: 5.0 -- It is also possible to specify (non-standardized) user-defined attributes.
// @id: TTCN3-CORE-5.0-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_05_00_general_008 {

    type integer MyInt with { extension "MyUserDefinedAttribute" }

    type component C {}

    testcase TC() runs on C {
        var MyInt v_value := 1;
        if (v_value == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
