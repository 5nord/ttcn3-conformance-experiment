// @requirement: 12 -- a) In case of a single timer, the default duration value shall resolve to a non-negative numerical float value (i.e. the value shall be greater or equal 0.0, infinity and not_a_number are disallowed).
// @id: TTCN3-CORE-12-022b
// @verdict: pass reject
module M_12_test_023 {
    type component C {}

    testcase TC() runs on C {
        timer T_t := infinity; // error: infinity as default duration
        setverdict(pass);
    }
}
