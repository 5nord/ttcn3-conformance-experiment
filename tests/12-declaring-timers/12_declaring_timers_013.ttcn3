// @requirement: 12 -- Timers are local to components.
// @id: TTCN3-CORE-12-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_12_declaring_timers_013 {
    type component C {
        timer T_c := 5.0;
    }

    function f_ptc() runs on C {
        if (not T_c.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        T_c.start;
        v_ptc.start(f_ptc());
        v_ptc.done;
        if (T_c.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }}
