// @requirement: 12 -- The timer shall be started with this value if no other value is specified.
// @id: TTCN3-CORE-12-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_12_declaring_timers_005 {
    type component C {}

    testcase TC() runs on C {
        timer T_d := 0.2;
        timer T_guard := 2.0;
        T_d.start;
        T_guard.start;
        alt {
            [] T_d.timeout {
                setverdict(pass);
            }
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }}
