// @requirement: 12 -- b) In case of a timer array, it shall resolve to an array of float values obeying to restriction a) above of the same size as the size of the timer array.
// @id: TTCN3-CORE-12-023a
// @verdict: pass reject
module M_12_test_024 {
    type component C {}

    testcase TC() runs on C {
        timer T_arr[2] := { 1.0, -1.0 }; // error: negative default duration of an element
        setverdict(pass);
    }
}
