// @requirement: 12 -- Timers can be declared and used in test cases, functions and altsteps.
// @id: TTCN3-CORE-12-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_12_declaring_timers_001 {
    type component C {}

    function f_wait() {
        timer T_f := 0.05;
        T_f.start;
        T_f.timeout;
    }

    altstep a_wait() {
        timer T_a;
        [] any timer.timeout {
            T_a.start(0.05);
            T_a.timeout;
        }
    }

    testcase TC() runs on C {
        timer T_tc := 0.05;
        f_wait();
        T_tc.start;
        a_wait();
        setverdict(pass);
    }

    control {
        execute(TC());
    }}
