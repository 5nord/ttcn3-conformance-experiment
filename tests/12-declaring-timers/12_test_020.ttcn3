// @requirement: 12 -- If a timer ceases to exist, it stops running, will never timeout and cannot be referenced via the any timer or all timer constructs.
// @id: TTCN3-CORE-12-018c
// @verdict: pass accept, ttcn3verdict:pass
module M_12_test_020 {
    type component C {
        timer T_c := 5.0;
    }

    function f_start() {
        timer T_loc := 5.0;
        T_loc.start;
    }

    testcase TC() runs on C {
        T_c.start;
        f_start();
        var boolean v_ok := any timer.running;
        T_c.stop;
        v_ok := v_ok and not any timer.running;
        all timer.stop;
        if (v_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }}
