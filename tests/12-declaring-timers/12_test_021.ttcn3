// @requirement: 12 -- If not stated otherwise, timers have the same semantics as constants of a timer type.
// @id: TTCN3-CORE-12-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_12_test_021 {
    type component C {}

    function f_check(timer p_t) return boolean {
        return p_t.running;
    }

    testcase TC() runs on C {
        timer T_t := 0.1;
        var timer v_ref := T_t;
        v_ref.start;
        if (T_t.running and f_check(T_t)) {
            T_t.timeout;
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }}
