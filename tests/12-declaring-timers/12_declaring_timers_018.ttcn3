// @requirement: 12 -- If a timer ceases to exist, it stops running, will never timeout and cannot be referenced via the any timer or all timer constructs.
// @id: TTCN3-CORE-12-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_12_declaring_timers_018 {
    type component C {}

    function f_start() {
        timer T_loc := 0.5;
        T_loc.start;
    }

    testcase TC() runs on C {
        timer T_w := 0.1;
        f_start();
        T_w.start;
        T_w.timeout;
        if (any timer.running) {
            setverdict(fail);
        } else {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }}
