// @requirement: 12 -- Default duration(s) of the elements of a timer array shall be assigned using a value array.
// @id: TTCN3-CORE-12-009a
// @verdict: pass reject
module M_12_test_009 {
    type component C {}

    testcase TC() runs on C {
        timer T_arr[2] := 1.0; // error: default durations of a timer array not given as a value array
        setverdict(pass);
    }
}
