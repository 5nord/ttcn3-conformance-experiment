// @requirement: 12 -- The timer value shall be a non-negative float value (i.e. greater than or equal to 0.0) where the base unit is seconds.
// @id: TTCN3-CORE-12-007b
// @verdict: pass accept, ttcn3verdict:pass
module M_12_declaring_timers_007 {
    type component C {}

    testcase TC() runs on C {
        timer T_d := 0.3;
        timer T_ref := 10.0;
        T_ref.start;
        T_d.start;
        T_d.timeout;
        var float v_elapsed := T_ref.read;
        if (v_elapsed >= 0.3 and v_elapsed < 5.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }}
