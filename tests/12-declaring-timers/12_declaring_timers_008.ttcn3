// @requirement: 12 -- In addition to single timer instances, timer arrays can also be declared.
// @id: TTCN3-CORE-12-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_12_declaring_timers_008 {
    type component C {}

    testcase TC() runs on C {
        timer T_arr[3];
        T_arr[1].start(0.05);
        T_arr[1].timeout;
        setverdict(pass);
    }

    control {
        execute(TC());
    }}
