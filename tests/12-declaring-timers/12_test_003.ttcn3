// @requirement: 12 -- These timers can be used in test cases, functions and altsteps which are running on the given component type.
// @id: TTCN3-CORE-12-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_12_test_003 {
    type component C {
        timer T_c := 0.05;
    }

    function f_wait() runs on C {
        T_c.start;
        T_c.timeout;
    }

    altstep a_wait() runs on C {
        [] T_c.timeout {}
    }

    testcase TC() runs on C {
        f_wait();
        T_c.start;
        a_wait();
        T_c.start;
        T_c.timeout;
        setverdict(pass);
    }

    control {
        execute(TC());
    }}
