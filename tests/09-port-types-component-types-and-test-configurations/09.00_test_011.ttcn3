// @requirement: 9.0 -- Test component types and port types, denoted by the keywords component and port, shall be defined in the module definitions part.
// @id: TTCN3-CORE-9.0-019b
// @verdict: pass reject
module M_09_00_test_011 {

    type component C {}

    testcase TC() runs on C {
        type port P message { inout integer; } // error: port type defined outside the module definitions part
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
