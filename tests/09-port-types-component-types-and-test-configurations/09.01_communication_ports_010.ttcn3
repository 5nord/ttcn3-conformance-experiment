// @requirement: 9.1 -- Connections within the test system interface are not allowed (see figure 7 (f)).
// @id: TTCN3-CORE-9.1-018a
// @verdict: pass reject
module M_09_01_communication_ports_010 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P p_sys1, p_sys2;
    }

    testcase TC() runs on C system S {
        connect(system:p_sys1, system:p_sys2); // error: connection within the test system interface
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
