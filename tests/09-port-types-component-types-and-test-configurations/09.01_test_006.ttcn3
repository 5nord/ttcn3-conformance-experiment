// @requirement: 9.1 -- A port owned by a component A shall not be connected with two or more ports owned by the same component (figure 7 (a) and (e)).
// @id: TTCN3-CORE-9.1-012a
// @verdict: pass accept, ttcn3verdict:error
module M_09_01_test_006 {

    type port P message { inout integer; }

    type component C {
        port P p1, p2, p3;
    }

    testcase TC() runs on C {
        connect(mtc:p1, mtc:p2);
        connect(mtc:p1, mtc:p3); // error: p1 connected with two ports of the same component
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
