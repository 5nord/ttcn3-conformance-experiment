// @requirement: 9.2 -- a) The same as for component type definitions (see clause 6.2.10.1).
// @id: TTCN3-CORE-9.2-027a
// @verdict: pass reject
module M_09_02_test_010 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P p_sys;
        port P p_sys; // error: port names in a component type shall be unique
    }

    testcase TC() runs on C system S {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
