// @requirement: 9.1 -- Each port is modelled as an infinite FIFO queue which stores the incoming messages or procedure calls until they are processed by the component owning that port (see figure 5).
// @id: TTCN3-CORE-9.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_09_01_test_002 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    function f() runs on C {
        for (var integer i := 1; i <= 100; i := i + 1) {
            p.send(i);
        }
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var integer v_val;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f());
        v_ptc.done;
        for (var integer i := 1; i <= 100; i := i + 1) {
            T.start;
            alt {
                [] p.receive(integer:?) -> value v_val {
                    if (v_val != i) {
                        setverdict(fail);
                    }
                }
                [] T.timeout { setverdict(fail); }
            }
            T.stop;
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
