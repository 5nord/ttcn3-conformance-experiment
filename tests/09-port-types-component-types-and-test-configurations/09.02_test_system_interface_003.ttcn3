// @requirement: 9.2 -- However, the connections between the test system interface and the TTCN-3 test components are dynamic in nature and may be modified during a test run by using map and unmap operations (see clause 21.1).
// @id: TTCN3-CORE-9.2-011b
// @verdict: pass accept, ttcn3verdict:pass
module M_09_02_test_system_interface_003 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P p_sys1, p_sys2;
    }

    testcase TC() runs on C system S {
        map(mtc:p, system:p_sys1);
        if (not p.checkstate("Mapped")) {
            setverdict(fail);
        }
        unmap(mtc:p, system:p_sys1);
        if (p.checkstate("Mapped")) {
            setverdict(fail);
        }
        map(mtc:p, system:p_sys2);
        if (p.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        unmap(mtc:p, system:p_sys2);
    }

    control {
        execute(TC());
    }
}
