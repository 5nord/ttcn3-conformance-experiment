// @requirement: 9.1 -- The checks shall be made at runtime and shall lead to a test case error when failing.
// @id: TTCN3-CORE-9.1-021b
// @verdict: pass accept, ttcn3verdict:error
module M_09_01_test_014 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P p_sys1, p_sys2;
    }

    testcase TC() runs on C system S {
        var C v_ptc := C.create;
        map(v_ptc:p, system:p_sys1);
        map(v_ptc:p, system:p_sys2); // error: failing connection check leads to a test case error
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
