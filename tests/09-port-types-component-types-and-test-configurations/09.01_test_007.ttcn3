// @requirement: 9.1 -- A port of a test system interface cannot have connection with more than one port owned by a component A. This means, connections as shown in figure 7 (b) are not allowed.
// @id: TTCN3-CORE-9.1-014a
// @verdict: pass accept, ttcn3verdict:error
module M_09_01_test_007 {

    type port P message { inout integer; }

    type component C {
        port P p1, p2;
    }

    type component S {
        port P p_sys;
    }

    testcase TC() runs on C system S {
        map(mtc:p1, system:p_sys);
        map(mtc:p2, system:p_sys); // error: system port mapped to a second port of the same component
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
