// @requirement: 9.0 -- All other PTCs are treated equally i.e. there is no explicit hierarchical relationship among them and the termination of a single PTC terminates neither other components nor the MTC.
// @id: TTCN3-CORE-9.0-016c
// @verdict: pass accept, ttcn3verdict:pass
module M_09_00_test_007 {

    type component C {}

    function f() runs on C {
        stop;
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f());
        v_ptc.done;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
