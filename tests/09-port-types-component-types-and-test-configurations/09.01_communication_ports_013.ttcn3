// @requirement: 9.1 -- The checks shall be made at runtime and shall lead to a test case error when failing.
// @id: TTCN3-CORE-9.1-021a
// @verdict: pass accept, ttcn3verdict:error
module M_09_01_communication_ports_013 {

    type port P message { inout integer; }

    type component C {
        port P p1, p2;
    }

    function f_select(C p_a, C p_b, boolean p_first) return C {
        if (p_first) {
            return p_a;
        }
        return p_b;
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        var C v_peer := f_select(v_ptc1, v_ptc2, rnd() >= 0.0);
        connect(mtc:p1, v_ptc1:p1);
        connect(mtc:p1, v_peer:p2); // error: only detectable at runtime, v_peer refers to v_ptc1
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
