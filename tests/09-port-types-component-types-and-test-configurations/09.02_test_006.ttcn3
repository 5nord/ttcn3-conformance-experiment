// @requirement: 9.2 -- The operation returning the component reference of the test system interface is system.
// @id: TTCN3-CORE-9.2-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_09_02_test_006 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P p_sys;
    }

    testcase TC() runs on C system S {
        var S v_sys := system;
        map(mtc:p, v_sys:p_sys);
        if (v_sys != null and p.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        unmap(mtc:p, system:p_sys);
    }

    control {
        execute(TC());
    }
}
