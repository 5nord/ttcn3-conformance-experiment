// @requirement: 9.2 -- This shall be used to address the ports of the test system.
// @id: TTCN3-CORE-9.2-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_09_02_test_007 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P p_sys1, p_sys2;
    }

    testcase TC() runs on C system S {
        map(mtc:p, system:p_sys2);
        if (p.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        unmap(mtc:p, system:p_sys2);
    }

    control {
        execute(TC());
    }
}
