// @requirement: 9.1 -- Test components are connected via their ports, i.e. connections among components and between a component and the test system interface are port-oriented.
// @id: TTCN3-CORE-9.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_09_01_communication_ports_001 {

    type port P message { inout integer; }

    type component C {
        port P p1, p2;
    }

    function f() runs on C {
        p2.send(2);
        p1.send(1);
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var C v_ptc := C.create;
        connect(mtc:p1, v_ptc:p1);
        connect(mtc:p2, v_ptc:p2);
        v_ptc.start(f());
        T.start;
        alt {
            [] p1.receive(1) { setverdict(pass); }
            [] p1.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
        alt {
            [] p2.receive(2) { setverdict(pass); }
            [] p2.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
