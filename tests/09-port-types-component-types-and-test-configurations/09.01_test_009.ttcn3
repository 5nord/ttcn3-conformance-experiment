// @requirement: 9.1 -- A port owned by a component A can only have a one-to-one connection with the test system interface. This means, connections as shown in figure 7 (d) are not allowed.
// @id: TTCN3-CORE-9.1-016a
// @verdict: pass accept, ttcn3verdict:error
module M_09_01_test_009 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P p_sys1, p_sys2;
    }

    testcase TC() runs on C system S {
        map(mtc:p, system:p_sys1);
        map(mtc:p, system:p_sys2); // error: component port mapped to a second system port
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
