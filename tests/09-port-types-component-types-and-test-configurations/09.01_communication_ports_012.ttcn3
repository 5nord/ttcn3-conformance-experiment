// @requirement: 9.1 -- A port that is connected shall not be mapped and a port that is mapped shall not be connected (see figure 7 (g)).
// @id: TTCN3-CORE-9.1-019b
// @verdict: pass accept, ttcn3verdict:error
module M_09_01_communication_ports_012 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    testcase TC() runs on C system C {
        var C v_ptc := C.create;
        map(mtc:p, system:p);
        connect(mtc:p, v_ptc:p); // error: mapped port is connected
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
