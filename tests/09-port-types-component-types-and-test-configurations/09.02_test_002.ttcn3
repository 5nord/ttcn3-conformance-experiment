// @requirement: 9.2 -- The test system interface statically defines the number and type of the port connections to the SUT during a test run.
// @id: TTCN3-CORE-9.2-010a
// @verdict: pass reject
module M_09_02_test_002 {

    type port P message { inout integer; }

    type component C {
        port P p1, p2;
    }

    type component S {
        port P p_sys1;
    }

    testcase TC() runs on C system S {
        map(mtc:p1, system:p_sys1);
        map(mtc:p2, system:p_sys2); // error: p_sys2 is not a port of the test system interface
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
