// @requirement: 9.2 -- In the case where the MTC is the only component that is instantiated during test execution, a test system interface need not be associated to the test case.
// @id: TTCN3-CORE-9.2-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_09_02_test_008 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
