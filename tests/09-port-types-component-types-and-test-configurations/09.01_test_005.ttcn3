// @requirement: 9.1 -- One-to-many connections are also allowed (e.g. figure 6 (g) or (h)).
// @id: TTCN3-CORE-9.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_09_01_test_005 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    function f() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.receive(1) { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
    }

    testcase TC() runs on C {
        var C v_ptc1 := C.create;
        var C v_ptc2 := C.create;
        connect(mtc:p, v_ptc1:p);
        connect(mtc:p, v_ptc2:p);
        v_ptc1.start(f());
        v_ptc2.start(f());
        p.send(1) to v_ptc1;
        p.send(1) to v_ptc2;
        all component.done;
    }

    control {
        execute(TC());
    }
}
