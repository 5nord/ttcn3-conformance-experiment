// @requirement: 9.0 -- The component ports are connected to the ports of the test system interface by means of the map operation (see clause 21.1.1).
// @id: TTCN3-CORE-9.0-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_09_00_test_013 {

    type port P message { inout integer; }

    type component C {
        port P p;
    }

    type component S {
        port P p_sys;
    }

    testcase TC() runs on C system S {
        map(mtc:p, system:p_sys);
        if (p.checkstate("Mapped")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        unmap(mtc:p, system:p_sys);
    }

    control {
        execute(TC());
    }
}
