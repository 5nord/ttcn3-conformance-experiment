// @requirement: 23.2 -- The start operation may be applied to a running timer, in which case the timer is stopped and re-started.
// @id: TTCN3-CORE-23.2-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_02_the_start_timer_operation_011 {

    type component C {}

    testcase TC() runs on C {
        timer T := 5.0;
        T.start;
        T.start(1.0);
        if (T.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
