// @requirement: 23.1 -- The timeout-lists are part of the snapshots that are taken when a test case is executed.
// @id: TTCN3-CORE-23.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_01_test_001 {

    type component C {}

    testcase TC() runs on C {
        timer T := 0.05;
        timer T_wait := 0.3;
        T.start;
        T_wait.start;
        T_wait.timeout;
        alt {
            [] T.timeout {
                setverdict(pass);
            }
            [else] {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
