// @requirement: 23.6 -- c) The index redirection shall only be used for any from timer array timeout operations.
// @id: TTCN3-CORE-23.6-016b
// @verdict: pass reject
module M_23_06_test_015 {

    type component C {}

    testcase TC() runs on C {
        timer T := 0.01;
        var integer v_i;
        T.start;
        T.timeout -> @index value v_i; // error: index redirection without any from
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
