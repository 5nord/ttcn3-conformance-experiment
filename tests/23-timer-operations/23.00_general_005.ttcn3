// @requirement: 23.0 -- Table 26: Any and: disconnect / unmap; Col3: yes; Col4: unmap(self : all port)
// @id: TTCN3-CORE-23.0-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_00_general_005 {

    type port P message { inout integer }

    type component C {
        port P p1;
        port P p2;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        disconnect(self:all port);
        unmap(self:all port);
        if (not any port.checkstate("Connected")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
