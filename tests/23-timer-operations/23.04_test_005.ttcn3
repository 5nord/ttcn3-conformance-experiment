// @requirement: 23.4 -- a) The ObjectReference shall be of the timer type.
// @id: TTCN3-CORE-23.4-007a
// @verdict: pass reject
module M_23_04_test_005 {

    type component C {}

    testcase TC() runs on C {
        var float v_f := 1.0;
        var float v_elapsed;
        v_elapsed := v_f.read; // error: not a timer
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
