// @requirement: 23.6 -- If the @nodefault modifier is placed before a stand-alone timeout operation, the implicit alt statement also contains the @nodefault modifier.
// @id: TTCN3-CORE-23.6-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_06_the_timeout_operation_007 {

    type component C {
        timer T_short := 0.05;
        var boolean v_defaultUsed := false;
    }

    altstep a_default() runs on C {
        [] T_short.timeout { v_defaultUsed := true; }
    }

    testcase TC() runs on C {
        timer T_long := 0.5;
        T_long.start;
        T_short.start;
        activate(a_default());
        @nodefault T_long.timeout;
        if (not v_defaultUsed) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
