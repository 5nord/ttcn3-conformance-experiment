// @requirement: 23.2 -- Starting a timer with a negative timer value, e.g. the timer value is the result of an expression, or without a specified timer value shall cause a runtime error.
// @id: TTCN3-CORE-23.2-007b
// @verdict: pass accept, ttcn3verdict:error
module M_23_02_the_start_timer_operation_009 {

    type component C {}

    function f_start(timer p_t) {
        p_t.start; // runtime error: no timer value and no default duration
    }

    testcase TC() runs on C {
        timer T;
        setverdict(pass);
        f_start(T);
    }

    control {
        execute(TC());
    }
}
