// @requirement: 23.6 -- d) If the index redirection is used for single-dimensional timer arrays, the type of the integer variable shall allow storing the highest index of the respective timer array.
// @id: TTCN3-CORE-23.6-017a
// @verdict: pass reject
module M_23_06_test_016 {

    type component C {}

    type integer SmallIndex (0..2);

    testcase TC() runs on C {
        timer TA[5];
        var SmallIndex v_i;
        TA[0].start(0.01);
        any from TA.timeout -> @index value v_i; // error: highest index 4 not in 0..2
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
