// @requirement: 23.0 -- Table 27: Overview of TTCN-3 timer operations: Start timer; Col2: start
// @id: TTCN3-CORE-23.0-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_00_test_011 {

    type component C {}

    testcase TC() runs on C {
        timer T;
        T.start(1.0);
        if (T.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
