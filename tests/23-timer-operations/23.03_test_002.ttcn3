// @requirement: 23.3 -- A stop operation removes a running timer from the list of running timers.
// @id: TTCN3-CORE-23.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_03_test_002 {

    type component C {}

    testcase TC() runs on C {
        timer T := 5.0;
        T.start;
        T.stop;
        if (not T.running and not any timer.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
