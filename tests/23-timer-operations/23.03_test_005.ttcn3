// @requirement: 23.3 -- Stopping an inactive timer is a valid operation, although it does not have any effect.
// @id: TTCN3-CORE-23.3-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_03_test_005 {

    type component C {}

    testcase TC() runs on C {
        timer T := 5.0;
        T.stop;
        if (not T.running and T.read == 0.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
