// @requirement: 23.5 -- The index of the first timer found running can optionally be stored in an integer variable for a single-dimensional array, or to an integer array or record of integer variable for multi-dimensional timer arrays.
// @id: TTCN3-CORE-23.5-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_05_test_009 {

    type component C {}

    type record of integer RoI;

    testcase TC() runs on C {
        timer TA1[3];
        timer TA2[2][3];
        var integer v_i := -1;
        var integer v_arr[2] := { -1, -1 };
        var RoI v_roi := { -1, -1 };
        TA1[2].start(5.0);
        TA2[1][2].start(5.0);
        if (any from TA1.running -> @index value v_i
            and any from TA2.running -> @index value v_arr
            and any from TA2.running -> @index value v_roi
            and v_i == 2 and v_arr == { 1, 2 } and v_roi == { 1, 2 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
