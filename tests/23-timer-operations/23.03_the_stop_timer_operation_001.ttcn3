// @requirement: 23.3 -- ( ObjectReference | all timer ) "." stop
// @id: TTCN3-CORE-23.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_03_the_stop_timer_operation_001 {

    type component C {}

    testcase TC() runs on C {
        timer T1 := 5.0, T2 := 5.0;
        T1.start;
        T2.start;
        T1.stop;
        all timer.stop;
        if (not T1.running and not T2.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
