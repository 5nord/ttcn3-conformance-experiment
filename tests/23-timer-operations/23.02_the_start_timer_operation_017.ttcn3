// @requirement: 23.2 -- b) The ObjectReference shall be of the timer type.
// @id: TTCN3-CORE-23.2-013a
// @verdict: pass reject
module M_23_02_the_start_timer_operation_017 {

    type component C {}

    testcase TC() runs on C {
        var float v_f := 1.0;
        v_f.start(1.0); // error: ObjectReference is not a timer
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
