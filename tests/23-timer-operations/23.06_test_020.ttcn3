// @requirement: 23.6 -- g) The @nodefault modifier is allowed only in stand-alone timeout statements.
// @id: TTCN3-CORE-23.6-020a
// @verdict: pass reject
module M_23_06_test_020 {

    type component C {}

    testcase TC() runs on C {
        timer T := 0.01;
        T.start;
        alt {
            [] @nodefault T.timeout { setverdict(pass); } // error: @nodefault inside an alt branch
        }
    }

    control {
        execute(TC());
    }
}
