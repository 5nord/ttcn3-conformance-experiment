// @requirement: 23.2 -- Starting a timer with a negative timer value, e.g. the timer value is the result of an expression, or without a specified timer value shall cause a runtime error.
// @id: TTCN3-CORE-23.2-007a
// @verdict: pass accept, ttcn3verdict:error
module M_23_02_the_start_timer_operation_008 {

    type component C {}

    testcase TC() runs on C {
        timer T;
        var float v_a := 1.0;
        var float v_b := 2.0;
        setverdict(pass);
        T.start(v_a - v_b); // runtime error: negative timer value
    }

    control {
        execute(TC());
    }
}
