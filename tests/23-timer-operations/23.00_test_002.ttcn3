// @requirement: 23.0 -- Table 26: Any and: receive, trigger, getcall, getreply, catch, check); All with ports: yes; Col4: any port.receive
// @id: TTCN3-CORE-23.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_00_test_002 {

    signature S();

    type port P message { inout integer }
    type port PP procedure { inout S }

    type component C {
        port P p1;
        port P p2;
        port PP pp;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.send(1);
        p1.send(2);
        p1.send(3);
        T.start;
        alt {
            [] any port.getcall { setverdict(fail); }
            [] any port.getreply { setverdict(fail); }
            [] any port.catch { setverdict(fail); }
            [] any port.check { setverdict(pass); }
            [] T.timeout { setverdict(fail); }
        }
        alt {
            [] any port.receive {}
            [] T.timeout { setverdict(fail); }
        }
        alt {
            [] any port.trigger {}
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
