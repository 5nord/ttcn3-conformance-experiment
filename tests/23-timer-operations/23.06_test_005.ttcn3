// @requirement: 23.6 -- The timeout can be used to determine an alternative in an alt statement or as stand-alone statement in a behaviour description.
// @id: TTCN3-CORE-23.6-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_06_test_005 {

    type component C {}

    testcase TC() runs on C {
        timer T1 := 0.01;
        timer T2 := 5.0;
        T1.start;
        T1.timeout;
        T1.start;
        T2.start;
        alt {
            [] T1.timeout { setverdict(pass); }
            [] T2.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
