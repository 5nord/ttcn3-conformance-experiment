// @requirement: 23.4 -- The read operation returns the time that has elapsed since the specified timer was started.
// @id: TTCN3-CORE-23.4-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_04_test_002 {

    type component C {}

    testcase TC() runs on C {
        timer T := 5.0;
        timer T_wait := 0.2;
        var float v_elapsed;
        T.start;
        T_wait.start;
        T_wait.timeout;
        v_elapsed := T.read;
        if (v_elapsed >= 0.15 and v_elapsed < 5.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
