// @requirement: 23.2 -- The start operation may be applied to a timer that has already expired; in this case, any entry in the timeout list for this timer shall be removed.
// @id: TTCN3-CORE-23.2-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_02_test_013 {

    type component C {}

    testcase TC() runs on C {
        timer T := 0.05;
        timer T_wait := 0.3;
        T.start;
        T_wait.start;
        T_wait.timeout;
        T.start(1.0);
        if (T.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
