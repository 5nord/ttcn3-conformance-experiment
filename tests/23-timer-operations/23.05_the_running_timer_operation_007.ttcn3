// @requirement: 23.5 -- The first timer to be found in the running state causes the operation returning with the true value.
// @id: TTCN3-CORE-23.5-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_05_the_running_timer_operation_007 {

    type component C {}

    testcase TC() runs on C {
        timer TA[4] := { 5.0, 5.0, 5.0, 5.0 };
        var integer v_i := -1;
        var boolean v_res;
        TA[3].start;
        TA[1].start;
        v_res := any from TA.running -> @index value v_i;
        if (v_res == true and v_i == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
