// @requirement: 23.0 -- Table 27: Overview of TTCN-3 timer operations: Check if timer running; Col2: running
// @id: TTCN3-CORE-23.0-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_00_general_014 {

    type component C {}

    testcase TC() runs on C {
        timer T := 1.0;
        var boolean v_before := T.running;
        T.start;
        if (not v_before and T.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
