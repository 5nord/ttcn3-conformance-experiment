// @requirement: 23.6 -- The index of the matched timer can be optionally stored in an integer variable for single-dimensional arrays or to an integer array or record of integer variable for multi-dimensional timer arrays.
// @id: TTCN3-CORE-23.6-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_06_test_012 {

    type component C {}

    type record of integer RoI;

    testcase TC() runs on C {
        timer TA1[3];
        timer TA2[2][3];
        var integer v_i := -1;
        var integer v_arr[2] := { -1, -1 };
        var RoI v_roi := { -1, -1 };
        TA1[2].start(0.01);
        any from TA1.timeout -> @index value v_i;
        TA2[1][2].start(0.01);
        any from TA2.timeout -> @index value v_arr;
        TA2[0][1].start(0.01);
        any from TA2.timeout -> @index value v_roi;
        if (v_i == 2 and v_arr == { 1, 2 } and v_roi == { 0, 1 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
