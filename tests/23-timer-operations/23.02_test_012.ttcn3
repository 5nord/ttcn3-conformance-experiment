// @requirement: 23.2 -- The start operation may be applied to a running timer, in which case the timer is stopped and re-started.
// @id: TTCN3-CORE-23.2-009b
// @verdict: pass accept, ttcn3verdict:pass
module M_23_02_test_012 {

    type component C {}

    testcase TC() runs on C {
        timer T := 0.5;
        timer T_wait := 0.3;
        var float v_elapsed;
        T.start;
        T_wait.start;
        T_wait.timeout;
        T.start;
        v_elapsed := T.read;
        if (T.running and v_elapsed < 0.25) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
