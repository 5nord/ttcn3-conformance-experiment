// @requirement: 23.5 -- e) The ObjectReference shall be of the timer type.
// @id: TTCN3-CORE-23.5-014a
// @verdict: pass reject
module M_23_05_test_015 {

    type component C {}

    testcase TC() runs on C {
        var boolean v_b := true;
        if (v_b.running) { // error: not a timer
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
