// @requirement: 23.3 -- A stopped timer becomes inactive and its elapsed time is set to the float value zero (0.0).
// @id: TTCN3-CORE-23.3-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_03_test_003 {

    type component C {}

    testcase TC() runs on C {
        timer T := 5.0;
        T.start;
        T.stop;
        if (T.running) {
            setverdict(fail);
            stop;
        }
        alt {
            [] T.timeout { setverdict(fail); }
            [else] { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
