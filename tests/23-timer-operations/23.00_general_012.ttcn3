// @requirement: 23.0 -- Table 27: Overview of TTCN-3 timer operations: Stop timer; Col2: stop
// @id: TTCN3-CORE-23.0-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_00_general_012 {

    type component C {}

    testcase TC() runs on C {
        timer T := 1.0;
        T.start;
        T.stop;
        if (not T.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
