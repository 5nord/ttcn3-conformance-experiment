// @requirement: 23.6 -- When the any from `TimerArrayRef` notation is used, where TimerArrayRef shall be a timer array identifier, the timers from the referenced array are iterated over and individually checked for timeout from innermost to outermost dimension from lowest to highest index for each dimension.
// @id: TTCN3-CORE-23.6-011b
// @verdict: pass accept, ttcn3verdict:pass
module M_23_06_the_timeout_operation_010 {

    type component C {}

    testcase TC() runs on C {
        timer TA[2][2];
        timer T_wait := 0.5;
        var integer v_i[2] := { -1, -1 };
        TA[1][0].start(0.01);
        TA[0][1].start(0.01);
        T_wait.start;
        T_wait.timeout;
        alt {
            [] any from TA.timeout -> @index value v_i {
                if (v_i == { 0, 1 }) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [else] { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
