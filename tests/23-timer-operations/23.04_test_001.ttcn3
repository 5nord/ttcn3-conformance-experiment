// @requirement: 23.4 -- ObjectReference "." read
// @id: TTCN3-CORE-23.4-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_04_test_001 {

    type component C {}

    testcase TC() runs on C {
        timer T := 5.0;
        var float v_elapsed;
        T.start;
        v_elapsed := T.read;
        if (v_elapsed >= 0.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
