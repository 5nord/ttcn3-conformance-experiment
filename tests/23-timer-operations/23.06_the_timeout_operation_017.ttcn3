// @requirement: 23.6 -- e) If the index redirection is used for multi-dimensional timer arrays, the size of the integer array or record of integer type shall exactly be the same as the dimension of the respective timer array, and its type shall allow storing the highest index (from all dimensions) of the timer array.
// @id: TTCN3-CORE-23.6-018a
// @verdict: pass reject
module M_23_06_the_timeout_operation_017 {

    type component C {}

    testcase TC() runs on C {
        timer TA[2][2];
        var integer v_i[3];
        TA[0][0].start(0.01);
        any from TA.timeout -> @index value v_i; // error: 3 elements for a 2-dimensional array
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
