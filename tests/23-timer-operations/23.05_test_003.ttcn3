// @requirement: 23.5 -- The operation returns the value true if the timer is listed on the list, false otherwise.
// @id: TTCN3-CORE-23.5-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_05_test_003 {

    type component C {}

    testcase TC() runs on C {
        timer T1 := 5.0, T2 := 5.0;
        T1.start;
        if (T1.running == true and T2.running == false) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
