// @requirement: 23.6 -- When a timeout operation is processed, if a timer name is indicated, the timeout-list is searched according to the TTCN-3 scope rules.
// @id: TTCN3-CORE-23.6-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_06_test_003 {

    type component C {
        timer T_comp := 0.01;
    }

    function f_checkTimeout() runs on C {
        alt {
            [] T_comp.timeout { setverdict(pass); }
            [else] { setverdict(fail); }
        }
    }

    testcase TC() runs on C {
        timer T_wait := 0.5;
        T_comp.start;
        T_wait.start;
        T_wait.timeout;
        f_checkTimeout();
    }

    control {
        execute(TC());
    }
}
