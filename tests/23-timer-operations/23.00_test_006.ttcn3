// @requirement: 23.0 -- Table 26: Any and: disconnect / unmap; Col3: yes; Col4: unmap(self : all port)
// @id: TTCN3-CORE-23.0-009b
// @verdict: pass reject
module M_23_00_test_006 {

    type port P message { inout integer }

    type component C {
        port P p1;
        port P p2;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        disconnect(self:any port); // error: any port not allowed with disconnect
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
