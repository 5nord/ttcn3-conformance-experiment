// @requirement: 23.5 -- b) The index redirection shall only be used for any from timer array running operations.
// @id: TTCN3-CORE-23.5-011b
// @verdict: pass reject
module M_23_05_test_011 {

    type component C {}

    testcase TC() runs on C {
        timer T := 5.0;
        var integer v_i;
        T.start;
        if (T.running -> @index value v_i) { // error: index redirection without any from
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
