// @requirement: 23.2 -- The timer clock runs from the float value zero (0.0) up to maximum stated by the duration parameter.
// @id: TTCN3-CORE-23.2-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_02_test_010 {

    type component C {}

    testcase TC() runs on C {
        timer T := 1.0;
        timer T_wait := 0.2;
        var float v_first, v_second;
        T.start;
        v_first := T.read;
        T_wait.start;
        T_wait.timeout;
        v_second := T.read;
        if (v_first >= 0.0 and v_first < v_second and v_second <= 1.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
