// @requirement: 23.1 -- When a timer expires, the timer becomes immediately inactive.
// @id: TTCN3-CORE-23.1-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_01_test_005 {

    type component C {}

    testcase TC() runs on C {
        timer T := 0.05;
        timer T_wait := 0.3;
        T.start;
        T_wait.start;
        T_wait.timeout;
        if (not T.running and T.read == 0.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
