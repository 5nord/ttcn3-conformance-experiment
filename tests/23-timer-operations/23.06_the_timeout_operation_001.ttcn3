// @requirement: 23.6 -- [ @nodefault ] ( ObjectReference | any timer | any from TimerArrayRef ) "." timeout ["->" @index value ValueRef]
// @id: TTCN3-CORE-23.6-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_06_the_timeout_operation_001 {

    type component C {}

    testcase TC() runs on C {
        timer T := 0.01;
        timer TA[3];
        var integer v_i := -1;
        T.start;
        T.timeout;
        T.start;
        @nodefault T.timeout;
        T.start;
        any timer.timeout;
        TA[1].start(0.01);
        any from TA.timeout;
        TA[2].start(0.01);
        any from TA.timeout -> @index value v_i;
        if (v_i == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
