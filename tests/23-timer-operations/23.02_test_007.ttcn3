// @requirement: 23.2 -- Starting a timer with the timer value 0.0 means that the timer times out immediately.
// @id: TTCN3-CORE-23.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_02_test_007 {

    type component C {}

    testcase TC() runs on C {
        timer T;
        timer T_guard := 0.5;
        T_guard.start;
        T.start(0.0);
        alt {
            [] T.timeout {
                setverdict(pass);
            }
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
