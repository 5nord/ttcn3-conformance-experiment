// @requirement: 23.3 -- A stopped timer becomes inactive and its elapsed time is set to the float value zero (0.0).
// @id: TTCN3-CORE-23.3-004b
// @verdict: pass accept, ttcn3verdict:pass
module M_23_03_the_stop_timer_operation_004 {

    type component C {}

    testcase TC() runs on C {
        timer T := 5.0;
        timer T_wait := 0.1;
        T.start;
        T_wait.start;
        T_wait.timeout;
        T.stop;
        if (T.read == 0.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
