// @requirement: 23.2 -- When a timer is started, its name is added to the list of running timers (for the given scope unit).
// @id: TTCN3-CORE-23.2-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_02_the_start_timer_operation_002 {

    type component C {}

    function f_any_running() runs on C return boolean {
        return any timer.running;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        if (f_any_running()) {
            setverdict(fail);
        }
        T.start;
        if (T.running and f_any_running()) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
