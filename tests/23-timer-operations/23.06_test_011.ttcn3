// @requirement: 23.6 -- The first timer to be found in the timeout-list causes that timer to be removed from the list and the timeout operation succeeds.
// @id: TTCN3-CORE-23.6-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_23_06_test_011 {

    type component C {}

    testcase TC() runs on C {
        timer TA[4];
        timer T_wait := 0.5;
        var integer v_i := -1;
        var boolean v_firstRemoved := false;
        var boolean v_otherKept := false;
        TA[3].start(0.01);
        TA[1].start(0.01);
        T_wait.start;
        T_wait.timeout;
        alt {
            [] any from TA.timeout -> @index value v_i {}
            [else] {}
        }
        alt {
            [] TA[1].timeout {}
            [else] { v_firstRemoved := true; }
        }
        alt {
            [] TA[3].timeout { v_otherKept := true; }
            [else] {}
        }
        if (v_i == 1 and v_firstRemoved and v_otherKept) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
