// @requirement: 15.14 -- Unchanged template in all other cases.
// @id: TTCN3-CORE-15.14-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_14_presentness_conversion_007 {

    type component C {}

    template integer m_range := (1 .. 5);
    template charstring m_pattern := pattern "a?c";

    testcase TC() runs on C {
        var template(present) integer v_range := m_range.present;
        var template(present) charstring v_pattern := m_pattern.present;
        if (match(1, v_range) and match(5, v_range) and not match(6, v_range) and
            match("abc", v_pattern) and not match("abd", v_pattern)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
