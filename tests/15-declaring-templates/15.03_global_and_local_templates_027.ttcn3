// @requirement: 15.3 -- Initialization of parameterized templates is completed at the time of their use.
// @id: TTCN3-CORE-15.3-030a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_03_global_and_local_templates_027 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r(integer p_i) := { f1 := p_i, f2 := "abc", f3 := true };

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        var R v_a := valueof(m_r(v_i));
        v_i := 2;
        var R v_b := valueof(m_r(v_i));
        if (v_a.f1 == 1 and v_b.f1 == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
