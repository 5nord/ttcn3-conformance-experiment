// @requirement: 15.3 -- c) There exist a number of restrictions on the functions used in expressions when specifying templates or template fields; these are specified in clause 16.1.4.
// @id: TTCN3-CORE-15.3-021a
// @verdict: pass reject
module M_15_03_test_016 {

    type record MyMessageType {
        integer field1,
        charstring field2
    }

    type port P message {
        inout MyMessageType;
    }

    type component C {
        port P p1;
        port P p2;
    }

    function f_value() runs on C return integer {
        p1.send(MyMessageType:{ field1 := 0, field2 := "x" });
        return 1;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.send(MyMessageType:{ field1 := 1, field2 := "abc" });
        T.start;
        alt {
            [] p2.receive(MyMessageType:{ field1 := f_value(), field2 := ? }) { setverdict(pass); } // error: function with a port operation used in a receiving template
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
