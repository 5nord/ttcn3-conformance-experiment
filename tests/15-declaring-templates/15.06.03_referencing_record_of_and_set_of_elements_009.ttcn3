// @requirement: 15.6.3 -- When a length attribute is attached to AnyValue, the attribute shall be conveyed to the new template or field transparently.
// @id: TTCN3-CORE-15.6.3-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_03_referencing_record_of_and_set_of_elements_009 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := ? length (2 .. 5);
        v_roI[0] := -5;
        if (match({-5, 1}, v_roI) and match({-5, 1, 2, 3, 4}, v_roI) and
            not match({-5}, v_roI) and not match({-5, 1, 2, 3, 4, 5}, v_roI)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
