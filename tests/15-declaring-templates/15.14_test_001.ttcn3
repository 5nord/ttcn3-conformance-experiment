// @requirement: 15.14 -- The conversion of a general (unrestricted) template to a template with the present restriction can be achieved by applying the .present notation to the template.
// @id: TTCN3-CORE-15.14-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_14_test_001 {

    type record R {
        integer a,
        boolean b optional
    }

    type component C {}

    template R m_example := { 1, * };

    testcase TC() runs on C {
        var template(present) boolean v_field := m_example.b.present;
        if (match(true, v_field) and match(false, v_field)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
