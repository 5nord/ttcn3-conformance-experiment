// @requirement: 15.3 -- Templates declared this way are safe to be used in reply and getreply operations, but they shall not be used in call and getcall operations. All out and inout procedure parameters are completely initialized and all in procedure parameters are either unitialized or marked as not relevant using the NotUsedSymbol.
// @id: TTCN3-CORE-15.3-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_03_global_and_local_templates_024 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    type port P procedure {
        inout RemoteProc;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template RemoteProc s_reply := { Par1 := -, Par2 := 2, Par3 := 3 }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.call(RemoteProc:{ Par1 := 1, Par2 := -, Par3 := 3 }, nowait);
        T.start;
        alt {
            [] p2.getcall { }
            [] T.timeout { setverdict(fail); stop; }
        }
        p2.reply(s_reply value 4);
        alt {
            [] p1.getreply(s_reply value 4) { setverdict(pass); }
            [] p1.getreply { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
