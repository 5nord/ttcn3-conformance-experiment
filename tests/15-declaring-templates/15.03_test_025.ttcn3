// @requirement: 15.3 -- Templates declared this way are safe to be used in reply and getreply operations, but they shall not be used in call and getcall operations. All out and inout procedure parameters are completely initialized and all in procedure parameters are either unitialized or marked as not relevant using the NotUsedSymbol.
// @id: TTCN3-CORE-15.3-028b
// @verdict: pass reject
module M_15_03_test_025 {

    signature S(in integer p_in, out integer p_out);

    type port P procedure { inout S }

    type component C {
        port P p;
    }

    template S s_reply := { p_in := -, p_out := 1 };

    testcase TC() runs on C {
        p.call(s_reply, nowait); // error: reply-only signature template used in call
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
