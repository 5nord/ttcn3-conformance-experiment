// @requirement: 15.2 -- a) At the time of a call, reply and raise operation, the used template shall be completely initialized and all
// @id: TTCN3-CORE-15.2-014a
// @verdict: pass accept, ttcn3verdict:error
module M_15_02_declaring_signature_templates_014 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    type port P procedure {
        inout RemoteProc;
    }

    type component C {
        port P p1;
        port P p2;
    }

    testcase TC() runs on C {
        var template integer v_par3;
        connect(self:p1, self:p2);
        setverdict(pass);
        p1.call(RemoteProc:{ Par1 := 1, Par2 := -, Par3 := v_par3 }, nowait); // error: inout parameter Par3 is uninitialized at the time of the call
    }

    control {
        execute(TC());
    }
}
