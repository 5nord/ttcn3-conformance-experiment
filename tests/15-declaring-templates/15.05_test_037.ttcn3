// @requirement: 15.5 -- NOTE 3: Initialization of modified templates without parameters is completed at the place of their declaration.
// @id: TTCN3-CORE-15.5-041a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_test_037 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        template R m_r1 := { f1 := 0, f2 := "A string", f3 := true };
        template R m_r2 modifies m_r1 := { f1 := v_i };
        v_i := 2;
        if (valueof(m_r2) == { f1 := 1, f2 := "A string", f3 := true }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
