// @requirement: 15.6.6 -- Both templates and template variables allow referencing elements of a map template or field using the index notation.
// @id: TTCN3-CORE-15.6.6-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_06_test_001 {

    type map from charstring to integer TMap;

    type component C {}

    template TMap t_map := { ["a"] := 1 };
    template integer t_int := t_map["a"];

    testcase TC() runs on C {
        var template TMap v_map := { ["b"] := 2 };
        var template integer v_int := v_map["b"];
        if (match(1, t_int) and match(2, v_int)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
