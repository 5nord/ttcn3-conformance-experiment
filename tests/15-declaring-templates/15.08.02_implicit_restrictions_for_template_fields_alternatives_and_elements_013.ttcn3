// @requirement: 15.8.2 -- Referenced field, alternative or element: Optional field of a record or set; ... Col4: template; Col5: template
// @id: TTCN3-CORE-15.8.2-012b
// @verdict: pass accept, ttcn3verdict:pass
module M_15_08_02_implicit_restrictions_for_template_fields_alternatives_and_elements_013 {

    type record R { integer a, integer b optional }

    const R c_rOmit := { a := 1, b := omit };
    const R c_r5 := { a := 1, b := 5 };

    type component C {}

    testcase TC() runs on C {
        var template(present) R v_t := { a := 1, b := 2 };
        v_t.b := *;
        if (match(c_rOmit, v_t) and match(c_r5, v_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
