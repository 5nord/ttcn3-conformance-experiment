// @requirement: 15.6.1 -- c) When referencing an item of a character string template to which a specific value is assigned, if the index is non-negative and less than the length of the specific value and the right hand side contains a specific value, the referenced item shall be replaced with the item from the right hand sign of the assignment.
// @id: TTCN3-CORE-15.6.1-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_01_test_026 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_char := "abc";
        v_char[1] := "x";
        if (match("axc", v_char) and not match("abc", v_char)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
