// @requirement: 15.6.1 -- It is allowed to reference individual string elements inside templates or template fields if any of the following conditions is fulfilled:
// @id: TTCN3-CORE-15.6.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_01_referencing_individual_string_elements_001 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_char := "MYCHAR", v_e;
        v_e := v_char[1];
        if (match("Y", v_e) and not match("M", v_e)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
