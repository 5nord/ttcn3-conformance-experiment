// @requirement: 15.6.0 -- When referencing elements of templates or templates fields with the value or omit restriction, the rules for referencing elements of values are used.
// @id: TTCN3-CORE-15.6.0-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_00_general_001 {

    type component C {}

    testcase TC() runs on C {
        var template(value) charstring v_t := "abc";
        var template(omit) octetstring v_o := '0102'O;
        var template(value) charstring v_e := v_t[1];
        v_t[3] := "d";
        v_o[2] := '03'O;
        if (match("b", v_e) and match("abcd", v_t) and match('010203'O, v_o)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
