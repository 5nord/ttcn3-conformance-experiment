// @requirement: 15.5 -- In-line modified template: modifies BaseTemplateBody ":=" BaseTemplateBody
// @id: TTCN3-CORE-15.5-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_test_004 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r1(integer p_i) := { f1 := p_i, f2 := "A string", f3 := true };

    type component C {}

    testcase TC() runs on C {
        var template R v_t := modifies m_r1(5) := { f2 := "G string" };
        if (match({ f1 := 5, f2 := "G string", f3 := true }, v_t) and match({ f1 := 6, f2 := "A string", f3 := false }, modifies m_r1(6) := { f3 := false })) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
