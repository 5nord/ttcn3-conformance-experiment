// @requirement: 15.6.1 -- l) If the referenced template contains the ifpresent matching attribute, the attribute is not removed by the assignment.
// @id: TTCN3-CORE-15.6.1-040a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_01_referencing_individual_string_elements_039 {

    type component C {}

    type record R {
        octetstring f optional
    }

    const R c_omit := { f := omit };

    testcase TC() runs on C {
        var template octetstring v_oct := 'AB'O ifpresent;
        v_oct[0] := 'CD'O;
        var template R v_r := { f := v_oct };
        if (match('CD'O, v_oct) and not match('AB'O, v_oct) and match(c_omit, v_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
