// @requirement: 15.6.4 -- While signature templates do not allow referencing their parameters directly (e.g. using dot notation), such a reference is possible when modifying a signature template.
// @id: TTCN3-CORE-15.6.4-001a
// @verdict: pass reject
module M_15_06_04_referencing_signature_parameters_001 {

    signature S(in integer par1, in integer par2);

    type component C {}

    template S s_sig := { par1 := 1, par2 := 2 };
    template integer t_par := s_sig.par1; // error: direct reference to a signature template parameter

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
