// @requirement: 15.1 -- A template used in a send operation defines a complete set of field values comprising the message to be transmitted over a port.
// @id: TTCN3-CORE-15.1-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_01_test_002 {

    type record MyMessageType {
        integer field1 optional,
        charstring field2,
        boolean field3
    }

    type port P message {
        inout MyMessageType;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template MyMessageType m_myTemplate := {
        field1 := 1,
        field2 := "My string",
        field3 := true
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var MyMessageType v_msg;
        connect(self:p1, self:p2);
        p1.send(m_myTemplate);
        T.start;
        alt {
            [] p2.receive(MyMessageType:?) -> value v_msg {
                if (v_msg == { field1 := 1, field2 := "My string", field3 := true }) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
