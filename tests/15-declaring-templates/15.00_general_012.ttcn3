// @requirement: 15.0 -- A fuzzy template can be declared deterministic using the @deterministic modifier.
// @id: TTCN3-CORE-15.0-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_00_general_012 {

    type component C {}

    function @deterministic f_inc(integer p_x) return integer {
        return p_x + 1;
    }

    template @fuzzy @deterministic integer m_det := f_inc(1);

    testcase TC() runs on C {
        if (match(2, m_det)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
