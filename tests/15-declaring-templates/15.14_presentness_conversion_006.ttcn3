// @requirement: 15.14 -- _TemplateList where all the alternatives that evaluate to omit are removed and the presentness conversion is_ applied to all other alternatives.
// @id: TTCN3-CORE-15.14-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_14_presentness_conversion_006 {

    type record R {
        integer a,
        charstring s optional
    }

    type component C {}

    template R m_example := { 1, (omit, "ab", "xyz") };

    testcase TC() runs on C {
        var template R v_check := { 1, m_example.s.present };
        if (match({ 1, "ab" }, v_check) and match({ 1, "xyz" }, v_check) and
            not match({ 1, "x" }, v_check) and not match({ 1, omit }, v_check)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
