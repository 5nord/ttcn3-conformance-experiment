// @requirement: 15.1 -- a) At the time of a send operation, the used template shall be completely initialized and all fields shall resolve to actual values or to omit and no other matching mechanisms shall be used in the template fields, neither directly nor indirectly.
// @id: TTCN3-CORE-15.1-010c
// @verdict: pass reject
module M_15_01_declaring_message_templates_009 {

    type record MyMessageType {
        integer field1 optional,
        charstring field2,
        boolean field3
    }

    type port P message {
        inout MyMessageType;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template charstring mw_anyString := pattern "abc*";

    template MyMessageType mw_myTemplate := {
        field1 := 1,
        field2 := mw_anyString,
        field3 := true
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(mw_myTemplate); // error: field2 indirectly contains a matching mechanism
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
