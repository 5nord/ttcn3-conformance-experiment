// @requirement: 15.2 -- Instances of procedure parameter lists with actual values may be specified using templates.
// @id: TTCN3-CORE-15.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_02_test_001 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    type port P procedure {
        inout RemoteProc;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template RemoteProc s_template1 := {
        Par1 := 1,
        Par2 := 2,
        Par3 := 3
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.call(s_template1, nowait);
        T.start;
        alt {
            [] p2.getcall(s_template1) { setverdict(pass); }
            [] p2.getcall { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
