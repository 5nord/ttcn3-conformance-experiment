// @requirement: 15.5 -- A modified field with the @fuzzy modifier becomes fuzzy even if it wasn't fuzzy in the base template and will be evaluated for fuzzy fields described in the clause 6.2.1.0.
// @id: TTCN3-CORE-15.5-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_test_022 {

    type record R2 {
        integer num,
        charstring str
    }

    type component C {
        var integer v_count := 0;
    }

    function f_next() runs on C return integer {
        v_count := v_count + 1;
        return v_count;
    }

    testcase TC() runs on C {
        template R2 m_base := { num := 0, str := "a" };
        template R2 m_mod modifies m_base := { @fuzzy num := f_next() };
        var integer v_a := valueof(m_mod).num;
        var integer v_b := valueof(m_mod).num;
        if (v_a != v_b) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
