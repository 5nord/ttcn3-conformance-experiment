// @requirement: 15.7.3 -- **permutation: all of the elements listed but in an arbitrary order (note, that ? and * are also allowed as** elements of the permutation list and all elements of a template can be added to permutation using the all from clause).
// @id: TTCN3-CORE-15.7.3-007b
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_03_special_symbols_that_can_be_used_inside_values_005 {

    type component C {}

    type record of integer RoI;

    template RoI m_permAny := { permutation(1, ?) };
    template RoI m_permAnys := { permutation(1, 2, *) };

    testcase TC() runs on C {
        var RoI v_91 := { 9, 1 };
        var RoI v_1 := { 1 };
        var RoI v_29185 := { 2, 9, 1, 8, 5 };
        var RoI v_12 := { 1, 2 };
        var RoI v_193 := { 1, 9, 3 };
        if (match(v_91, m_permAny) and not match(v_1, m_permAny) and
            match(v_29185, m_permAnys) and match(v_12, m_permAnys) and not match(v_193, m_permAnys)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
