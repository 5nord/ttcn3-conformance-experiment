// @requirement: 15.8.1 -- Used with template restriction: value; Value: Yes; Instead of values: Note 1
// @id: TTCN3-CORE-15.8.1-039c
// @verdict: pass reject
module M_15_08_01_explicit_restrictions_026 {
    type record R {
        integer a,
        boolean b optional
    }

    type component C {}

    testcase TC() runs on C {
        var template(value) R vt_r;
        vt_r := omit; // error: value restricted template resolves to omit
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
