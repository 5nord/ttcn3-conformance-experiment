// @requirement: 15.5 -- The modifications occur in a linked fashion, eventually tracing back to the original template:
// @id: TTCN3-CORE-15.5-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_modified_templates_009 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r1 := { f1 := 1, f2 := "a", f3 := true };
    template R m_r2 modifies m_r1 := { f2 := "b" };
    template R m_r3 modifies m_r2 := { f3 := false };

    type component C {}

    testcase TC() runs on C {
        if (valueof(m_r3) == { f1 := 1, f2 := "b", f3 := false }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
