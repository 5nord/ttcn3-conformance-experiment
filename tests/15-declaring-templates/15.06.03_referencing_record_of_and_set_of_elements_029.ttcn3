// @requirement: 15.6.3 -- If the AnyElementsOrNone symbol had a length restriction, only as many AnyElement symbols can be added as is the value of the upper bound of the restriction. If the position of the referenced item is greater or equal to the position of an AnyElementsOrNone symbol in the transformed form and this AnyElementsOrNone is the last symbol in the template, the value or matching symbol at the right hand side of the assignment shall be assigned to the referenced element.
// @id: TTCN3-CORE-15.6.3-051a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_03_referencing_record_of_and_set_of_elements_029 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := {1, * length (1 .. 2)};
        v_roI[4] := 5;
        if (istemplatekind(v_roI[1], "AnyValue") and istemplatekind(v_roI[2], "AnyValue") and
            not isbound(v_roI[3]) and match(5, v_roI[4])) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
