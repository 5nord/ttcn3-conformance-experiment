// @requirement: 15.5 -- In case of record of and set of types first apply rule (c) to the complete structure (e.g. truncation) than apply further rules for the remaining individual type structure elements (see example 3).
// @id: TTCN3-CORE-15.5-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_modified_templates_018 {

    type record Elem {
        integer a,
        integer b
    }

    type record of Elem List;

    template List mw_base := { ?, { a := 1, b := 2 }, ?, { a := 3, b := 4 } };
    template List mw_mod modifies mw_base := { -, { a := 42 }, - };

    type component C {}

    testcase TC() runs on C {
        if (match({ { 0, 0 }, { 42, 2 }, { 5, 5 } }, mw_mod) and not match({ { 0, 0 }, { 42, 2 }, { 5, 5 }, { 3, 4 } }, mw_mod) and not match({ { 0, 0 }, { 42, 3 }, { 5, 5 } }, mw_mod)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
