// @requirement: 15.5 -- a) In case of templates, template fields or list elements of simple types, union and enumerated types, the matching mechanism specified in the modified template is simply replacing its corresponding content in its parent.
// @id: TTCN3-CORE-15.5-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_test_010 {

    type integer I;

    type union U {
        integer i,
        charstring s
    }

    type enumerated E { e_a, e_b }

    template integer m_i1 := (1..10);
    template integer m_i2 modifies m_i1 := 20;
    template U m_u1 := { i := 1 };
    template U m_u2 modifies m_u1 := { s := "a" };
    template E m_e1 := e_a;
    template E m_e2 modifies m_e1 := e_b;

    const U c_us := { s := "a" };
    const U c_ui := { i := 1 };

    type component C {}

    testcase TC() runs on C {
        if (match(20, m_i2) and not match(5, m_i2) and match(c_us, m_u2) and not match(c_ui, m_u2) and match(e_b, m_e2) and not match(e_a, m_e2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
