// @requirement: 15.4 -- In-line templates not containing matching mechanisms can be defined wherever values are allowed.
// @id: TTCN3-CORE-15.4-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_04_test_008 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    function f_get(R p_r) return integer {
        return p_r.f1;
    }

    type component C {}

    testcase TC() runs on C {
        var R v_r := valueof(R:{ f1 := 1, f2 := "a", f3 := true });
        var integer v_i := f_get(R:{ f1 := 2, f2 := "b", f3 := false });
        if (v_r.f1 == 1 and v_i == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
