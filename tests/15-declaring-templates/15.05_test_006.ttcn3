// @requirement: 15.5 -- This parent template may be either an original template or a modified template or also a matching mechanism.
// @id: TTCN3-CORE-15.5-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_test_006 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r1 := { f1 := 1, f2 := "a", f3 := true };
    template R m_r2 modifies m_r1 := { f2 := "b" };
    template R m_r3 modifies m_r2 := { f3 := false };
    template R m_any modifies ? := { f2 := "c" };

    type component C {}

    testcase TC() runs on C {
        if (valueof(m_r3) == { f1 := 1, f2 := "b", f3 := false } and match({ f1 := omit, f2 := "c", f3 := false }, m_any) and not match({ f1 := 1, f2 := "d", f3 := true }, m_any)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
