// @requirement: 15.11 -- The length matching attribute shall not follow a template or template field produced by concatenation directly, but in this case the concatenation shall be placed within a pair of parentheses.
// @id: TTCN3-CORE-15.11-022a
// @verdict: pass reject
module M_15_11_test_026 {

    template octetstring mw_t := 'ABCD'O & ? length(2) length(4); // error: length directly follows concatenation

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
