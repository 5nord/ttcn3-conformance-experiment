// @requirement: 15.10 -- a) The template shall be completely initialized and resolve to a specific value.
// @id: TTCN3-CORE-15.10-006a
// @verdict: pass accept, ttcn3verdict:error
module M_15_10_valueof_operation_004 {

    type record R { integer a, integer b optional }

    type component C {}

    testcase TC() runs on C {
        var template R v_t;
        v_t.a := 1;
        var R v_r := valueof(v_t); // error: v_t.b is not initialized
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
