// @requirement: 15.6.3 -- The transformed form is equal to the original value where all occurrences of AnyElementsOrNone with a length restriction are replaced with a sequence of AnyElements of the same size as the lower bound.
// @id: TTCN3-CORE-15.6.3-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_03_referencing_record_of_and_set_of_elements_018 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := {1, * length (2), 5};
        var template integer v_int1 := v_roI[1];
        var template integer v_int2 := v_roI[2];
        var template integer v_int3 := v_roI[3];
        if (istemplatekind(v_int1, "AnyValue") and istemplatekind(v_int2, "AnyValue") and
            match(5, v_int3)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
