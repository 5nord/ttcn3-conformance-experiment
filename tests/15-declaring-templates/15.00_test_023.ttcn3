// @requirement: 15.0 -- template @fuzzy charstring m_fuzzy := fx_garble("foobar"); // every usage of m_fuzzy re evaluates the function call
// @id: TTCN3-CORE-15.0-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_00_test_023 {

    type component C {
        var integer v_count := 0;
    }

    function f_next() runs on C return integer {
        v_count := v_count + 1;
        return v_count;
    }

    testcase TC() runs on C {
        template @fuzzy integer m_fuzzy := f_next();
        var boolean v_first := match(1, m_fuzzy);
        var boolean v_second := match(2, m_fuzzy);
        if (v_first and v_second and v_count == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
