// @requirement: 15.5 -- Initialization of modified parameterized templates is completed at the time of their use.
// @id: TTCN3-CORE-15.5-042a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_test_038 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r1 := { f1 := 0, f2 := "A string", f3 := true };
    template R m_r2(integer p_i) modifies m_r1 := { f1 := p_i };

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        var R v_a := valueof(m_r2(v_i));
        v_i := 2;
        var R v_b := valueof(m_r2(v_i));
        if (v_a.f1 == 1 and v_b.f1 == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
