// @requirement: 15.2 -- all in/inout parameters in a call ... shall resolve to specific values or to omit
// @id: TTCN3-CORE-15.2-015a
// @verdict: pass reject
module M_15_02_test_015 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    type port P procedure {
        inout RemoteProc;
    }

    type component C {
        port P p1;
        port P p2;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.call(RemoteProc:{ Par1 := (1, 2), Par2 := -, Par3 := 3 }, nowait); // error: in parameter Par1 is not a specific value
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
