// @requirement: 15.6.3 -- e) _Permutation: when referencing an element of a record of template or field, which is located inside a_ permutation (based on its index), this shall cause an error.
// @id: TTCN3-CORE-15.6.3-019a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_03_referencing_record_of_and_set_of_elements_013 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := {permutation(0, 1, 3, ?), 2, *};
        var template integer v_int := v_roI[2]; // error: index 2 is inside the permutation
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
