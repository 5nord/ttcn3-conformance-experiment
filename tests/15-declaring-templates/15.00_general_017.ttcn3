// @requirement: 15.0 -- d) The expression or template body initializing a template shall evaluate to a value or a template that is at least partially initialized or to a matching mechanism.
// @id: TTCN3-CORE-15.0-021a
// @verdict: pass reject
module M_15_00_general_017 {

    type component C {}

    testcase TC() runs on C {
        var template integer v_uninit;
        template integer m_int := v_uninit; // error: initialized from an uninitialized template variable
        setverdict(pass);
    }
}
