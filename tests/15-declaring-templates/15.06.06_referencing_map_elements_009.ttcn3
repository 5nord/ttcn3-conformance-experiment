// @requirement: 15.6.6 -- d) _AnyValueOrNone: referencing an element within a map template or field to which AnyValueOrNone is_ assigned on the right-hand side of an assignment shall cause an error.
// @id: TTCN3-CORE-15.6.6-013a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_06_referencing_map_elements_009 {

    type map from charstring to integer TMap;

    type component C {}

    testcase TC() runs on C {
        var template TMap v_map := *;
        var template integer v_int;
        v_int := v_map["test"]; // error: AnyValueOrNone is assigned to v_map
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
