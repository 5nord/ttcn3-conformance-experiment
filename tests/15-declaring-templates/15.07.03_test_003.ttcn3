// @requirement: 15.7.3 -- ***: wildcard for any number of consecutive elements in a string, array,** `record of or set of, or no` element at all (i.e. an omitted element);
// @id: TTCN3-CORE-15.7.3-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_03_test_003 {

    type component C {}

    type record of integer RoI;
    type set of integer SoI;

    template octetstring m_os := 'AA*BB'O;
    template RoI m_roi := { 1, *, 3 };
    template SoI m_soi := { 1, * };

    testcase TC() runs on C {
        var RoI v_roiNone := { 1, 3 };
        var RoI v_roiMany := { 1, 5, 6, 7, 3 };
        var RoI v_roiNok := { 1, 5, 6 };
        var SoI v_soiNone := { 1 };
        var SoI v_soiMany := { 4, 1, 5 };
        var SoI v_soiNok := { 4, 5 };
        if (match('AABB'O, m_os) and match('AA0102BB'O, m_os) and not match('AA01'O, m_os) and
            match(v_roiNone, m_roi) and match(v_roiMany, m_roi) and not match(v_roiNok, m_roi) and
            match(v_soiNone, m_soi) and match(v_soiMany, m_soi) and not match(v_soiNok, m_soi)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
