// @requirement: 15.6.3 -- Indexes of elements sheltered by a permutation shall be determined based on the number of permutation elements.
// @id: TTCN3-CORE-15.6.3-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_03_referencing_record_of_and_set_of_elements_014 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := {permutation(0, 1, 3, ?), 2, ?};
        var template integer v_int := v_roI[4];
        if (match(2, v_int) and not match(3, v_int)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
