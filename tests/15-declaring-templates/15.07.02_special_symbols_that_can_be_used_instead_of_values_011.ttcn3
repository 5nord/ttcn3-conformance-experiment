// @requirement: 15.7.2 -- **(lowerBound** `..` _upperBound): a range of integer or float values between and including the lower- and upper_ bounds;
// @id: TTCN3-CORE-15.7.2-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_02_special_symbols_that_can_be_used_instead_of_values_011 {

    type component C {}

    template integer m_intRange := (1 .. 5);
    template float m_floatRange := (1.5 .. 2.5);

    testcase TC() runs on C {
        if (match(1, m_intRange) and match(3, m_intRange) and match(5, m_intRange) and
            not match(0, m_intRange) and not match(6, m_intRange) and
            match(1.5, m_floatRange) and match(2.0, m_floatRange) and match(2.5, m_floatRange) and
            not match(1.4, m_floatRange) and not match(2.6, m_floatRange)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
