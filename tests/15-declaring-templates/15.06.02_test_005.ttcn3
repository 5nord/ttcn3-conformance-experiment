// @requirement: 15.6.2 -- During this expansion an AnyValue shall be assigned to mandatory subfields and AnyValueOrNone shall be assigned to optional subfields.
// @id: TTCN3-CORE-15.6.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_02_test_005 {

    type record R2 {
        integer g1,
        R2 g2 optional
    }

    type record R1 {
        integer f1 optional,
        R2 f2 optional
    }

    type component C {}

    testcase TC() runs on C {
        var template R1 v_r1 := {f1 := 5, f2 := omit};
        v_r1.f2.g2.g1 := 3;
        if (match({f1 := 5, f2 := {g1 := -9, g2 := {g1 := 3, g2 := omit}}}, v_r1) and
            match({f1 := 5, f2 := {g1 := 100, g2 := {g1 := 3, g2 := {g1 := 0, g2 := omit}}}}, v_r1)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
