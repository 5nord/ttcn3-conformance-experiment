// @requirement: 15.11 -- Concatenation operand: ? length(1) or * length(1); Transformed string: "?"
// @id: TTCN3-CORE-15.11-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_11_test_032 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_t1 := "AB" & ? length(1) & "C";
        var template charstring v_t2 := "AB" & * length(1) & "C";
        if (match("ABxC", v_t1) and not match("ABC", v_t1) and not match("ABxyC", v_t1) and
            match("ABxC", v_t2) and not match("ABC", v_t2) and not match("ABxyC", v_t2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
