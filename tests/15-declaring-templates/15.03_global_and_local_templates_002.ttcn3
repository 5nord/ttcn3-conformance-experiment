// @requirement: 15.3 -- template [ TemplateRestriction ] [ @fuzzy ] [ @deterministic ] [ @abstract ] Type TemplateIdentifier ["(" TemplateFormalParList ")"] [ modifies TemplateRef ] ":=" BaseTemplateBody
// @id: TTCN3-CORE-15.3-002a
// @verdict: pass accept, noexecution
module M_15_03_global_and_local_templates_002 {

    type record MyMessageType {
        integer field1 optional,
        charstring field2,
        boolean field3
    }

    type component C {}

    template MyMessageType mw_base := {
        field1 := ?,
        field2 := pattern "abc*xyz",
        field3 := true
    }
    template (present) MyMessageType mw_par(integer p_myFormalParam) modifies mw_base := {
        field1 := p_myFormalParam
    }
    template (value) MyMessageType m_value := { field1 := omit, field2 := "a", field3 := false }
    template (omit) integer m_omit := omit;
    template @fuzzy integer mw_fuzzy := ?;
    template @fuzzy @deterministic integer mw_det := (1 .. 3);
    template @abstract MyMessageType mw_abstract := { field1 := 1, field2 := -, field3 := true }

    function f() runs on C {
        template (present) MyMessageType mw_local(integer p_x) := {
            field1 := p_x,
            field2 := ?,
            field3 := ?
        }
    }
}
