// @requirement: 15.6.3 -- If the lower bound is greater than the upper bound, the sequence shall be followed by a single AnyElementsOrNone symbol with a length restriction.
// @id: TTCN3-CORE-15.6.3-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_03_test_019 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := {1, * length (1 .. 3), 5};
        v_roI[1] := 7;
        if (match({1, 7, 5}, v_roI) and match({1, 7, 0, 5}, v_roI)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
