// @requirement: 15.6.1 -- Then, if the referenced template contained the AnyValueOrNone matching symbol, the ifpresent matching attribute shall be added to the referenced template if it does not contain it.
// @id: TTCN3-CORE-15.6.1-038a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_01_referencing_individual_string_elements_037 {

    type component C {}

    type record R {
        charstring f optional
    }

    const R c_omit := { f := omit };

    testcase TC() runs on C {
        var template charstring v_char := *;
        v_char[0] := "x";
        var template R v_r := { f := v_char };
        if (match("x", v_char) and not match("y", v_char) and match(c_omit, v_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
