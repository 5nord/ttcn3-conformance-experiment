// @requirement: 15.7.2 -- **omit: the optional field, in which it is used, is not present;**
// @id: TTCN3-CORE-15.7.2-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_02_special_symbols_that_can_be_used_instead_of_values_002 {

    type component C {}

    type record R {
        integer a,
        integer f optional
    }

    template R m_omit := { a := ?, f := omit };

    testcase TC() runs on C {
        var R v_absent := { a := 1, f := omit };
        var R v_present := { a := 1, f := 2 };
        if (match(v_absent, m_omit) and not match(v_present, m_omit)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
