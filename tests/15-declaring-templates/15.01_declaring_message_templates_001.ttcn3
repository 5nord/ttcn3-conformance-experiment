// @requirement: 15.1 -- Instances of messages with actual values may be specified using templates.
// @id: TTCN3-CORE-15.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_01_declaring_message_templates_001 {

    type record MyMessageType {
        integer field1 optional,
        charstring field2,
        boolean field3
    }

    type port P message {
        inout MyMessageType;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template MyMessageType m_myTemplate := {
        field1 := omit,
        field2 := "My string",
        field3 := true
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.send(m_myTemplate);
        T.start;
        alt {
            [] p2.receive(m_myTemplate) { setverdict(pass); }
            [] p2.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
