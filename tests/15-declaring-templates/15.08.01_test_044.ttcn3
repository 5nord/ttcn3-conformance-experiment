// @requirement: 15.8.1 -- Parameter restriction in base template: template(omit); Allowed parameter restrictions in modified template: Yes; Col3: Yes; Col4: No; Col5: No
// @id: TTCN3-CORE-15.8.1-052b
// @verdict: pass reject
module M_15_08_01_test_044 {
    type record R {
        integer a,
        boolean b optional
    }

    template R m_base(template(omit) integer p_a) := {a := p_a, b := omit};
    template R m_mod(template(present) integer p_a) modifies m_base := {b := true}; // error: present not allowed for omit base parameter

    type component C {}
}
