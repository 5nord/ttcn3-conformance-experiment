// @requirement: 15.7.0 -- Matching mechanisms may also be used in-line (see clause 15.4).
// @id: TTCN3-CORE-15.7.0-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_00_general_003 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(mtc:p, mtc:p);
        p.send(5);
        T.start;
        alt {
            [] p.receive(integer:(1 .. 10)) { setverdict(pass); }
            [] p.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
