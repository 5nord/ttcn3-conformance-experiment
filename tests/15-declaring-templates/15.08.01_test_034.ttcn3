// @requirement: 15.8.1 -- Col1: template(omit); Value: Yes; Template (omit): Yes; Template (value): Yes; Template (present): No; Template: No
// @id: TTCN3-CORE-15.8.1-045a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_08_01_test_034 {
    type record R {
        integer a,
        boolean b optional
    }

    template(omit) R m_omit := omit;
    template(value) R m_value := {a := 1, b := true};

    function f_check(template(omit) R p_r) {
        setverdict(pass);
    }

    type component C {}

    testcase TC() runs on C {
        var R v_r := {a := 1, b := true};
        var template(omit) R vt_r;
        vt_r := v_r;
        vt_r := m_omit;
        vt_r := m_value;
        f_check(v_r);
        f_check(m_omit);
        f_check(m_value);
    }

    control {
        execute(TC());
    }
}
