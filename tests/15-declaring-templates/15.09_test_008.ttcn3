// @requirement: 15.9 -- Thus, matching a value_ expression against a template instance which evaluates to the omit matching mechanism shall return false.
// @id: TTCN3-CORE-15.9-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_09_test_008 {

    const integer c_c := 1;

    type component C {}

    testcase TC() runs on C {
        var template(omit) integer v_o := omit;
        if (not match(5, omit) and not match(c_c, v_o)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
