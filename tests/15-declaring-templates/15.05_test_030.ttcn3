// @requirement: 15.5 -- 4) if the dash (don't change) symbol is used at the place of a default value or default template, the corresponding parameter of the parent template shall have a valid default value or default template, either assigned directly or inherited.
// @id: TTCN3-CORE-15.5-034a
// @verdict: pass reject
module M_15_05_test_030 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r1(integer p_i) := { f1 := p_i, f2 := "A string", f3 := true };
    template R m_r2(integer p_i := -) modifies m_r1 := { f2 := "B string" }; // error: parent parameter has no default

    type component C {}

    testcase TC() runs on C {
        if (match({ f1 := 1, f2 := "B string", f3 := true }, m_r2(1))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
