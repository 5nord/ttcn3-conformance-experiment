// @requirement: 15.6.3 -- The symbol is always appended if the original AnyElementsOrNone symbol was unrestricted. If the position of the referenced item is greater or equal to the position of an AnyElementsOrNone symbol in the transformed form and this AnyElementsOrNone is the last symbol in the template, the value or matching symbol at the right hand side of the assignment shall be assigned to the referenced element.
// @id: TTCN3-CORE-15.6.3-053a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_03_test_030 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := {1, 2, *};
        v_roI[4] := 5;
        if (match({1, 2, 0, 0, 5}, v_roI) and match({1, 2, 0, 0, 5, 6, 7}, v_roI)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
