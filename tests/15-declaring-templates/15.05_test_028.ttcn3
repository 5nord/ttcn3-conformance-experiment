// @requirement: 15.5 -- b) If a base template has a formal parameter list, the following rules apply to all modified templates derived from that base template, whether or not they are derived in one or several modification steps: 2) a template parameter restriction of a derived template specified at any of the modification steps between the base template and the actual modified template can be changed to a stricter one (see table 13a in clause 15.8);
// @id: TTCN3-CORE-15.5-032a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_test_028 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R mw_r1(template integer p_t) := { f1 := p_t, f2 := "A string", f3 := true };
    template R mw_r2(template(value) integer p_t) modifies mw_r1 := { f2 := "B string" };

    type component C {}

    testcase TC() runs on C {
        if (match({ f1 := 1, f2 := "B string", f3 := true }, mw_r2(1))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
