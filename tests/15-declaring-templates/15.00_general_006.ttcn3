// @requirement: 15.0 -- Templates may be specified for any TTCN-3 type or procedure signature.
// @id: TTCN3-CORE-15.0-009a
// @verdict: pass accept, noexecution
module M_15_00_general_006 {

    type record R { integer i, float f }
    type set St { boolean b }
    type record of integer RoI;
    type set of charstring SoC;
    type enumerated E { e_a, e_b }
    type union U { integer i, charstring c }
    type integer A[2];

    type component C {}

    signature S(in integer p_in) return integer;

    template integer m_int := ?;
    template float m_float := (0.0 .. 1.0);
    template boolean m_bool := true;
    template verdicttype m_verdict := pass;
    template bitstring m_bit := '1*'B;
    template hexstring m_hex := 'AB'H;
    template octetstring m_oct := ?;
    template charstring m_char := pattern "a*";
    template universal charstring m_uchar := ?;
    template R m_rec := { i := 1, f := ? }
    template St m_set := { b := ? }
    template RoI m_roi := { 1, * }
    template SoC m_soc := ?;
    template E m_enum := e_a;
    template U m_union := { i := ? }
    template A m_array := { 1, ? }
    template C m_comp := ?;
    template S s_sig := { p_in := ? }
}
