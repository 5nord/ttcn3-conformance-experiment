// @requirement: 15.7.2 -- ***: wildcard for any value or no value at all, i.e. the field is not present;**
// @id: TTCN3-CORE-15.7.2-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_02_test_008 {

    type component C {}

    type record R {
        integer a,
        integer f optional
    }

    template R m_rec := { a := 1, f := * };

    testcase TC() runs on C {
        var R v_present := { a := 1, f := 2 };
        var R v_absent := { a := 1, f := omit };
        var R v_wrong := { a := 2, f := omit };
        if (match(v_present, m_rec) and match(v_absent, m_rec) and not match(v_wrong, m_rec)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
