// @requirement: 15.7.0 -- Some of the mechanisms may be used in combination.
// @id: TTCN3-CORE-15.7.0-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_00_test_004 {

    type record of integer RoI;

    type component C {}

    template RoI m_roi := { 1, * } length(2 .. 3);

    testcase TC() runs on C {
        var RoI v_two := { 1, 2 };
        var RoI v_three := { 1, 2, 3 };
        var RoI v_four := { 1, 2, 3, 4 };
        if (match(v_two, m_roi) and match(v_three, m_roi) and not match(v_four, m_roi)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
