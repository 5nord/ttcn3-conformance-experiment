// @requirement: 15.12 -- A template with the omit restriction and with the same content as the operand, if the operand fulfils conditions of the omit template restriction as described in clause 15.8.
// @id: TTCN3-CORE-15.12-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_12_the_omit_operation_002 {

    type record R {
        integer a,
        boolean b optional
    }

    type component C {}

    testcase TC() runs on C {
        var template R v_value := { 1, omit };
        var template boolean v_omit := omit;
        var template(omit) R v_res1 := omit(v_value);
        var template(omit) boolean v_res2 := omit(v_omit);
        var template R v_check := { 1, v_res2 };
        if (match({ 1, omit }, v_res1) and not match({ 1, true }, v_res1) and
            match({ 1, omit }, v_check) and not match({ 1, true }, v_check)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
