// @requirement: 15.6.1 -- If the index is a negative number.
// @id: TTCN3-CORE-15.6.1-043a
// @verdict: pass reject
module M_15_06_01_referencing_individual_string_elements_042 {

    type component C {}

    testcase TC() runs on C {
        var template octetstring v_oct := '0123'O;
        v_oct[-1] := 'FF'O; // error: negative index
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
