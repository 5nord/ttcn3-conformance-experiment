// @requirement: 15.6.6 -- When referencing an element of a map template or field that contains AnyElementsOrNone, if the referenced element is not present and the reference occurs on the left-hand side of an assignment, the template or field is implicitly expanded recursively up to and including, the depth of the referenced subfield and AnyValue is assigned to the referenced field.
// @id: TTCN3-CORE-15.6.6-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_06_referencing_map_elements_013 {

    type map from charstring to integer TMap;

    type component C {}

    testcase TC() runs on C {
        var template TMap v_map := { *, ["id"] := 1 };
        var TMap v_ok := { ["id"] := 1, ["test"] := 2 };
        var TMap v_nok := { ["id"] := 1 };
        v_map["test"] := 2;
        if (match(v_ok, v_map) and not match(v_nok, v_map)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
