// @requirement: 15.8.1 -- (value) ... but the whole template shall not resolve to omit).
// @id: TTCN3-CORE-15.8.1-008c
// @verdict: pass reject
module M_15_08_01_explicit_restrictions_011 {
    type record R {
        integer a,
        boolean b optional
    }

    template(value) R m_r := omit; // error: value restricted template resolves to omit

    type component C {}
}
