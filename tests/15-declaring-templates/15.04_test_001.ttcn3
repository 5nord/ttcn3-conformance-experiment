// @requirement: 15.4 -- Templates can be specified directly at the place they are used.
// @id: TTCN3-CORE-15.4-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_04_test_001 {

    type port P message { inout charstring }

    type component C {
        port P p;
        timer T := 1.0;
    }

    function f_send() runs on C {
        p.send(charstring:"abcxyz");
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send());
        T.start;
        alt {
            [] p.receive(charstring:"abcxyz") { setverdict(pass); }
            [] p.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
