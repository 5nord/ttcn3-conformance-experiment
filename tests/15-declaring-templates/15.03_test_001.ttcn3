// @requirement: 15.3 -- TTCN-3 allows defining global templates and local templates.
// @id: TTCN3-CORE-15.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_03_test_001 {

    type component C {}

    template integer m_global := 1;

    testcase TC() runs on C {
        template integer m_local := 2;
        if (match(1, m_global) and match(2, m_local)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
