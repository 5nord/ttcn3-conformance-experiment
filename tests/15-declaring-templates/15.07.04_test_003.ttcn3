// @requirement: 15.7.4 -- **ifpresent: for matching of optional field values (if not omitted).**
// @id: TTCN3-CORE-15.7.4-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_04_test_003 {
    type record R {
        integer a,
        boolean b optional
    }

    template R mw_r := {a := 1, b := true ifpresent};

    type component C {}

    testcase TC() runs on C {
        var R v_omit := {a := 1, b := omit};
        var R v_true := {a := 1, b := true};
        var R v_false := {a := 1, b := false};
        if (match(v_omit, mw_r) and match(v_true, mw_r) and not match(v_false, mw_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
