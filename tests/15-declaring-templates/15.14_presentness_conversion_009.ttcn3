// @requirement: 15.14 -- Applying the presentness conversion to a template expression that has the present or value restriction yields the same template with the same template restriction.
// @id: TTCN3-CORE-15.14-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_14_presentness_conversion_009 {

    type component C {}

    template(present) integer m_present := (1 .. 5);
    template(value) integer m_value := 7;

    testcase TC() runs on C {
        var template(present) integer v_present := m_present.present;
        var template(value) integer v_value := m_value.present;
        if (match(3, v_present) and not match(6, v_present) and
            match(7, v_value) and not match(8, v_value)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
