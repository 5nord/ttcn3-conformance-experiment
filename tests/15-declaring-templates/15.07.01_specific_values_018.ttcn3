// @requirement: 15.7.1 -- Col1: anytype; Col2: Yes; Table 11: TTCN-3 Matching Mechanisms: Yes1; Col4: Yes; Col5: Yes; Col6: Yes; Col7: Yes1; Col17: Yes1
// @id: TTCN3-CORE-15.7.1-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_01_specific_values_018 {

    type component C {}

    type record R {
        anytype f optional
    }

    template anytype m_spec := { integer := 1 };
    template anytype m_omit := omit;
    template anytype m_compl := complement({ integer := 1 });
    template anytype m_list := ({ integer := 1 }, { charstring := "a" });
    template anytype m_any := ?;
    template anytype m_anyOrNone := *;
    template R m_rOmit := { f := omit };
    template R m_rAnyOrNone := { f := * };
    template R m_rIfPresent := { f := { integer := 1 } ifpresent };

    testcase TC() runs on C {
        var anytype v_i1 := { integer := 1 };
        var anytype v_sa := { charstring := "a" };
        var anytype v_i2 := { integer := 2 };
        var R v_absent := { f := omit };
        var R v_present := { f := v_i1 };
        var R v_other := { f := v_sa };
        if (match(v_i1, m_spec) and not match(v_i2, m_spec) and
            match(v_sa, m_compl) and not match(v_i1, m_compl) and
            match(v_sa, m_list) and not match(v_i2, m_list) and
            match(v_i2, m_any) and
            match(v_absent, m_rOmit) and not match(v_present, m_rOmit) and
            match(v_absent, m_rAnyOrNone) and match(v_present, m_rAnyOrNone) and
            match(v_absent, m_rIfPresent) and match(v_present, m_rIfPresent) and
            not match(v_other, m_rIfPresent)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
