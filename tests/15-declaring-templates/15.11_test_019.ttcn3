// @requirement: 15.11 -- In the next step, the strings are concatenated and a pattern is created from the concatenation result.
// @id: TTCN3-CORE-15.11-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_11_test_019 {

    template charstring mw_t := (pattern "A") & ? length(1) & (pattern "[0-9]");

    type component C {}

    testcase TC() runs on C {
        if (match("Ax5", mw_t) and not match("Axy", mw_t) and not match("A5", mw_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
