// @requirement: 15.3 -- At the time of their use (e.g. in communication operations send, receive, call, getcall, etc.), it is allowed to change template fields by in-line modified templates, to pass in values via value parameters as well as to pass in templates via template parameters.
// @id: TTCN3-CORE-15.3-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_03_test_012 {

    type record MyMessageType {
        integer field1,
        charstring field2
    }

    type port P message {
        inout MyMessageType;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template MyMessageType m_base := { field1 := 1, field2 := "abc" }
    template MyMessageType m_par(integer p_value) := { field1 := p_value, field2 := "abc" }
    template MyMessageType mw_par(template integer p_template) := { field1 := p_template, field2 := ? }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.send(modifies m_base := { field1 := 5 });
        p1.send(m_par(6));
        T.start;
        alt {
            [] p2.receive(modifies m_base := { field1 := 5 }) { }
            [] p2.receive { setverdict(fail); stop; }
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] p2.receive(mw_par((6 .. 10))) { setverdict(pass); }
            [] p2.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
