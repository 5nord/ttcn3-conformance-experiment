// @requirement: 15.5 -- d) Limitations on template restrictions described in clause 15.8 shall apply.
// @id: TTCN3-CORE-15.5-037a
// @verdict: pass reject
module M_15_05_modified_templates_033 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template(value) R m_r1 := { f1 := 123, f2 := "A string", f3 := true };
    template(value) R m_r2 modifies m_r1 := { f2 := ? }; // error: AnyValue in a value restricted template

    type component C {}

    testcase TC() runs on C {
        if (match({ f1 := 123, f2 := "x", f3 := true }, m_r2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
