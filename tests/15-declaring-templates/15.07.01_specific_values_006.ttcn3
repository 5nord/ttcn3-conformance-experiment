// @requirement: 15.7.1 -- Col1: float; Col2: Yes; Table 11: TTCN-3 Matching Mechanisms: Yes1; Col4: Yes; Col5: Yes; Col6: Yes; Col7: Yes1; Col8: Yes; Col17: Yes1
// @id: TTCN3-CORE-15.7.1-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_01_specific_values_006 {

    type component C {}

    type record R {
        float f optional
    }

    template float m_spec := 1.0;
    template float m_omit := omit;
    template float m_compl := complement(1.0, 2.0);
    template float m_list := (1.0, 2.0);
    template float m_any := ?;
    template float m_anyOrNone := *;
    template float m_range := (1.0 .. 5.0);
    template R m_rOmit := { f := omit };
    template R m_rAnyOrNone := { f := * };
    template R m_rIfPresent := { f := 1.0 ifpresent };

    testcase TC() runs on C {
        var R v_absent := { f := omit };
        var R v_one := { f := 1.0 };
        var R v_two := { f := 2.0 };
        if (match(1.0, m_spec) and not match(2.0, m_spec) and
            match(3.0, m_compl) and not match(2.0, m_compl) and
            match(2.0, m_list) and not match(3.0, m_list) and
            match(-7.5, m_any) and
            match(4.5, m_range) and not match(5.5, m_range) and
            match(v_absent, m_rOmit) and not match(v_one, m_rOmit) and
            match(v_absent, m_rAnyOrNone) and match(v_one, m_rAnyOrNone) and
            match(v_absent, m_rIfPresent) and match(v_one, m_rIfPresent) and
            not match(v_two, m_rIfPresent)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
