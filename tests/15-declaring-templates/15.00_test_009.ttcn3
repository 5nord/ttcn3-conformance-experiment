// @requirement: 15.0 -- A template can be declared fuzzy using the @fuzzy modifier.
// @id: TTCN3-CORE-15.0-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_00_test_009 {

    type component C {}

    template @fuzzy integer m_fuzzy := (1 .. 5);

    testcase TC() runs on C {
        if (match(3, m_fuzzy)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
