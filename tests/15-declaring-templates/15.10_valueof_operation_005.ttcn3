// @requirement: 15.10 -- a) The template shall be completely initialized and resolve to a specific value.
// @id: TTCN3-CORE-15.10-006b
// @verdict: pass reject
module M_15_10_valueof_operation_005 {

    template integer mw_any := ?;

    type component C {}

    testcase TC() runs on C {
        var integer v_i := valueof(mw_any); // error: template does not resolve to a specific value
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
