// @requirement: 15.2 -- The values or matching mechanisms for a return have to be defined within the reply (see clause 22.3.3) or getreply operation (see clause 22.3.4).
// @id: TTCN3-CORE-15.2-005a
// @verdict: pass reject
module M_15_02_declaring_signature_templates_004 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    type component C {}

    template RemoteProc s_template := { 1, 2, 3, 4 } // error: the return value cannot be part of a signature template

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
