// @requirement: 15.1 -- NOTE: For sending templates, omitting an optional field is considered to be a value notation rather than a matching mechanism.
// @id: TTCN3-CORE-15.1-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_01_declaring_message_templates_003 {

    type record MyMessageType {
        integer field1 optional,
        charstring field2,
        boolean field3
    }

    type port P message {
        inout MyMessageType;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template (value) MyMessageType m_myTemplate := {
        field1 := omit,
        field2 := "My string",
        field3 := true
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var MyMessageType v_msg;
        connect(self:p1, self:p2);
        p1.send(m_myTemplate);
        T.start;
        alt {
            [] p2.receive(MyMessageType:?) -> value v_msg {
                if (not ispresent(v_msg.field1)) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
