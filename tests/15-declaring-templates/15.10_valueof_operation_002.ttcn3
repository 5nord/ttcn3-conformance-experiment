// @requirement: 15.10 -- valueof "(" TemplateInstance ")"
// @id: TTCN3-CORE-15.10-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_10_valueof_operation_002 {

    template integer m_int := 5;

    type component C {}

    testcase TC() runs on C {
        var integer v_i := valueof(m_int);
        if (v_i == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
