// @requirement: 15.11 -- Concatenation operand: pattern "content"; Transformed string: "content"
// @id: TTCN3-CORE-15.11-033a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_11_concatenating_templates_of_string_and_list_types_037 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_t := "X?" & (pattern "a?c") & "*";
        if (match("X?abc*", v_t) and match("X?azc*", v_t) and
            not match("Xyabc*", v_t) and not match("X?abcd", v_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
