// @requirement: 15.14 -- NOTE: Other matching attributes such as length are unaffected by the conversion, e.g. * length(2..10) would be converted to ? length(2..10)
// @id: TTCN3-CORE-15.14-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_14_test_008 {

    type record R {
        integer a,
        charstring s optional
    }

    type component C {}

    template R m_example := { 1, * length(2 .. 3) };

    testcase TC() runs on C {
        var template R v_check := { 1, m_example.s.present };
        if (match({ 1, "ab" }, v_check) and match({ 1, "abc" }, v_check) and
            not match({ 1, "a" }, v_check) and not match({ 1, "abcd" }, v_check) and
            not match({ 1, omit }, v_check)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
