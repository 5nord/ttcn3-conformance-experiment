// @requirement: 15.2 -- At the time of a getcall, getreply and catch operation, the matching template shall be completely initialized.
// @id: TTCN3-CORE-15.2-018a
// @verdict: pass accept, ttcn3verdict:error
module M_15_02_test_019 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    type port P procedure {
        inout RemoteProc;
    }

    type component C {
        port P p1;
        port P p2;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var template integer v_par3;
        connect(self:p1, self:p2);
        p1.call(RemoteProc:{ Par1 := 1, Par2 := -, Par3 := 3 }, nowait);
        setverdict(pass);
        T.start;
        alt {
            [] p2.getcall(RemoteProc:{ Par1 := 1, Par2 := -, Par3 := v_par3 }) { } // error: inout parameter Par3 of the matching template is uninitialized
            [] T.timeout { }
        }
    }

    control {
        execute(TC());
    }
}
