// @requirement: 15.8.1 -- (omit) ... and the whole template may also resolve to omit).
// @id: TTCN3-CORE-15.8.1-006c
// @verdict: pass accept, ttcn3verdict:pass
module M_15_08_01_explicit_restrictions_006 {
    type record R {
        integer a,
        boolean b optional
    }

    type record Outer {
        R r optional
    }

    template(omit) R m_r := omit;
    template Outer m_outer := {r := m_r};

    type component C {}

    testcase TC() runs on C {
        var Outer v_outer := {r := omit};
        if (match(v_outer, m_outer)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
