// @requirement: 15.6.6 -- g) Special value null: referencing an element of an address type that is derived from a map type and whose actual value is null shall cause an error.
// @id: TTCN3-CORE-15.6.6-025a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_06_test_017 {

    type map from charstring to integer TMap;
    type TMap address;

    type component C {}

    testcase TC() runs on C {
        var address v_addr := null;
        var integer v_int;
        v_int := v_addr["a"]; // error: the actual value of v_addr is null
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
