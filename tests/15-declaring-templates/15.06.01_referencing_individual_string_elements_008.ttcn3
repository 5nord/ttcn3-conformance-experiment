// @requirement: 15.6.1 -- In any of the cases mentioned above, the reference template might contain ifpresent and length matching attributes.
// @id: TTCN3-CORE-15.6.1-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_01_referencing_individual_string_elements_008 {

    type component C {}

    testcase TC() runs on C {
        var template octetstring v_oct := 'ABCD'O length(2) ifpresent, v_e;
        var template charstring v_char := pattern "a?c" length(3) ifpresent, v_e2;
        v_e := v_oct[1];
        v_e2 := v_char[2];
        if (match('CD'O, v_e) and match("c", v_e2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
