// @requirement: 15.7.2 -- **complement (…): complement of a list of values or templates;**
// @id: TTCN3-CORE-15.7.2-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_02_special_symbols_that_can_be_used_instead_of_values_006 {

    type component C {}

    template integer m_range := (10 .. 20);
    template integer m_compl := complement(1, 2, m_range);

    testcase TC() runs on C {
        if (match(3, m_compl) and match(21, m_compl) and
            not match(1, m_compl) and not match(2, m_compl) and not match(15, m_compl)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
