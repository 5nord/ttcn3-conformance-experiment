// @requirement: 15.6.3 -- a) _Omit: referencing an element within a record of, set of or array field to which omit is assigned shall follow the_ rules specified in clause 6.2.3.
// @id: TTCN3-CORE-15.6.3-004a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_03_referencing_record_of_and_set_of_elements_002 {

    type record of integer RoI;

    type record R {
        RoI field1 optional
    }

    type component C {}

    testcase TC() runs on C {
        var template R v_r := {field1 := omit};
        var template integer v_int := v_r.field1[0]; // error: field1 is omit
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
