// @requirement: 15.7.1 -- SingleExpression
// @id: TTCN3-CORE-15.7.1-003a
// @verdict: pass accept, noexecution
module M_15_07_01_test_002 {

    type record R {
        integer f1,
        boolean f2
    }

    const integer c_i := 5;

    function f_double(integer p_i) return integer {
        return 2 * p_i;
    }

    template integer m_lit := 1;
    template integer m_arith := (c_i + 3) mod 4;
    template integer m_call := f_double(c_i);
    template boolean m_bool := c_i > 3 and not (c_i == 7);
    template charstring m_concat := "ab" & "cd";
    template R m_rec := { f1 := c_i * 2, f2 := 1 < 2 };
}
