// @requirement: 15.2 -- all out/inout parameters in a reply or raise operation shall resolve to specific values or to omit
// @id: TTCN3-CORE-15.2-015b
// @verdict: pass reject
module M_15_02_test_016 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    type port P procedure {
        inout RemoteProc;
    }

    type component C {
        port P p1;
        port P p2;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p2.reply(RemoteProc:{ Par1 := -, Par2 := ?, Par3 := 30 } value 1); // error: out parameter Par2 is not a specific value
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
