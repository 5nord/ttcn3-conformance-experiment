// @requirement: 15.6.3 -- c) _AnyValue: when referencing an element of a record of or set of template or field to which AnyValue is_ assigned (without a length attribute), at the right hand side of an assignment, AnyValue shall be returned.
// @id: TTCN3-CORE-15.6.3-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_03_referencing_record_of_and_set_of_elements_004 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := ?;
        var template integer v_int := v_roI[5];
        if (match(0, v_int) and match(-12, v_int) and istemplatekind(v_int, "AnyValue")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
