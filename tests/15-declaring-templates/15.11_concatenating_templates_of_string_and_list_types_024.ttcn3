// @requirement: 15.11 -- The concatenation shall be performed completely before using the resulting template (e.g. for assignment or matching) and the result shall be type-compatible with the place of its use.
// @id: TTCN3-CORE-15.11-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_11_concatenating_templates_of_string_and_list_types_024 {

    type component C {}

    testcase TC() runs on C {
        var integer v_n := 2;
        var template charstring v_t := "A" & ? length(v_n) & "B";
        v_n := 3;
        if (match("AxxB", v_t) and not match("AxxxB", v_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
