// @requirement: 15.6.3 -- When referencing an element within a record of or set of template or field to which AnyValue is assigned (without a length attribute), at the left hand side of an assignment, the value or matching mechanism at the right hand side of the assignment shall be assigned to the referenced element, AnyElement shall be assigned to all elements before the referenced one (if any) and a single AnyElementsOrNone shall be added at the end.
// @id: TTCN3-CORE-15.6.3-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_03_test_006 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := ?;
        v_roI[2] := 7;
        if (match({0, 0, 7}, v_roI) and not match({0, 0, 8}, v_roI)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
