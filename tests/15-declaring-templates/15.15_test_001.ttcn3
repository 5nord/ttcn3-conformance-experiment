// @requirement: 15.15 -- The extraction of the underlying value from a charstring pattern matching mechanism or a template with the omit restriction can be achieved with the .value notation applied to a TemplateInstance.
// @id: TTCN3-CORE-15.15-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_15_test_001 {

    type component C {}

    template charstring m_pattern := pattern "ab?c";
    template(omit) integer m_omit := 5;

    testcase TC() runs on C {
        var charstring v_str := m_pattern.value;
        var integer v_int := m_omit.value;
        if (v_str == "ab?c" and v_int == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
