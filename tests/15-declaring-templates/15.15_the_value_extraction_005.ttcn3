// @requirement: 15.15 -- Applying this extraction to a template that evaluates to Value `ifpresent will yield the value Value.`
// @id: TTCN3-CORE-15.15-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_15_the_value_extraction_005 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_ifpresent := "abc" ifpresent;
        var charstring v_str := v_ifpresent.value;
        if (v_str == "abc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
