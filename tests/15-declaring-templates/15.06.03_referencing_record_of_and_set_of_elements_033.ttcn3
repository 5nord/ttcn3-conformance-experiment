// @requirement: 15.6.3 -- The index of the referenced item shall not violate type restrictions in any of the above cases.
// @id: TTCN3-CORE-15.6.3-058a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_03_referencing_record_of_and_set_of_elements_033 {

    type record length (0 .. 3) of integer RoI3;

    type component C {}

    testcase TC() runs on C {
        var template RoI3 v_roI := {1, *};
        var integer v_idx := 5;
        v_roI[v_idx] := 1; // error: index violates the length restriction of RoI3
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
