// @requirement: 15.11 -- Concatenation operand: ? length(0) or * length(0); Transformed string: empty string
// @id: TTCN3-CORE-15.11-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_11_test_031 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_t1 := "AB" & ? length(0) & "C" & ?;
        var template charstring v_t2 := "AB" & * length(0) & "C" & ?;
        if (match("ABC", v_t1) and match("ABCxy", v_t1) and not match("ABxC", v_t1) and
            match("ABC", v_t2) and match("ABCxy", v_t2) and not match("ABxC", v_t2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
