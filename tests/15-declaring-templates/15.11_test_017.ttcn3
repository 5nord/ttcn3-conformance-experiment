// @requirement: 15.11 -- In all other cases, if possible, a pattern will be produced.
// @id: TTCN3-CORE-15.11-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_11_test_017 {

    template charstring mw_t := "ABC" & ? & "EF";

    type component C {}

    testcase TC() runs on C {
        if (match("ABCEF", mw_t) and match("ABCxyzEF", mw_t) and not match("ABCxyz", mw_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
