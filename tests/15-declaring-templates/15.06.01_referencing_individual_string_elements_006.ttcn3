// @requirement: 15.6.1 -- The template is of a binary string type and it contains a combined template.
// @id: TTCN3-CORE-15.6.1-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_01_referencing_individual_string_elements_006 {

    type component C {}

    testcase TC() runs on C {
        var template hexstring v_comb := 'A?B*'H, v_e1, v_e2;
        v_e1 := v_comb[2];
        v_e2 := v_comb[1];
        if (match('B'H, v_e1) and not match('A'H, v_e1) and match('5'H, v_e2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
