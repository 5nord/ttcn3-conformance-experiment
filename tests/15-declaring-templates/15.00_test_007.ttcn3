// @requirement: 15.0 -- The type-based templates are used for message-based communications and the signature templates are used in procedure-based communications.
// @id: TTCN3-CORE-15.0-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_00_test_007 {

    type record R { integer i, charstring c }

    type port P message { inout R }

    type component C {
        port P p1;
        port P p2;
        timer T := 1.0;
    }

    template R m_send := { i := 1, c := "abc" }
    template R mw_receive := { i := 1, c := ? }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(m_send);
        T.start;
        alt {
            [] p2.receive(mw_receive) { setverdict(pass); }
            [] p2.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
