// @requirement: 15.8.1 -- Such a template can be used to define a field of a record and set template and the latter one could still be used in a send statement.
// @id: TTCN3-CORE-15.8.1-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_08_01_test_007 {
    type record R {
        integer a,
        boolean b optional
    }

    type set S {
        integer a,
        boolean b optional
    }

    template(omit) boolean m_true := true;
    template(omit) boolean m_omit := omit;
    template R m_r := {a := 1, b := m_true};
    template S m_s := {a := 1, b := m_omit};

    type component C {}

    testcase TC() runs on C {
        var R v_r := {a := 1, b := true};
        var S v_s := {a := 1, b := omit};
        if (match(v_r, m_r) and match(v_s, m_s)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
