// @requirement: 15.5 -- Global or local modified template: template [ TemplateRestriction ] [ @fuzzy ] [ @deterministic ] [ @abstract ] Type TemplateIdentifier ["(" TemplateFormalParList ")"] modifies ( TemplateRef | BaseTemplateBody ) ":=" BaseTemplateBody
// @id: TTCN3-CORE-15.5-005a
// @verdict: pass accept, noexecution
module M_15_05_test_003 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r1 := { f1 := 123, f2 := "A string", f3 := true };
    template(present) R m_r2 := { f1 := ?, f2 := "A string", f3 := true };

    template R m_mod1(integer p_i) modifies m_r1 := { f1 := p_i };
    template(present) R m_mod2 modifies m_r2 := { f2 := "B string" };
    template @fuzzy @deterministic R m_mod3 modifies m_r1 := { f3 := false };
    template @abstract R m_mod4 modifies m_r1 := { f2 := "C string" };
    template R m_mod5 modifies { f1 := 1, f2 := "D string", f3 := true } := { f1 := 2 };
}
