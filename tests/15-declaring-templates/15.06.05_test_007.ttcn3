// @requirement: 15.6.5 -- Referencing an alternative of a union template field to which template lists or complemented template lists are assigned, at the left hand side of an assignment, shall cause an error.
// @id: TTCN3-CORE-15.6.5-008a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_05_test_007 {

    type union U {
        integer c1,
        charstring c2
    }

    type record R2 {
        integer g1,
        U g2 optional
    }

    type component C {}

    testcase TC() runs on C {
        var template R2 v_t1 := { g1 := 5, g2 := ({ c1 := 1 }, { c1 := 2 }) };
        v_t1.g2.c1 := 3; // error: a template list is assigned to v_t1.g2
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
