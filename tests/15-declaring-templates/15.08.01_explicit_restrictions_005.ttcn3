// @requirement: 15.8.1 -- (omit) ... (i.e. the fields of it shall resolve to a specific value or omit, ...)
// @id: TTCN3-CORE-15.8.1-006b
// @verdict: pass reject
module M_15_08_01_explicit_restrictions_005 {
    type record R {
        integer a,
        boolean b optional
    }

    template(omit) R mw_r := {a := ?, b := omit}; // error: field is not a specific value or omit

    type component C {}
}
