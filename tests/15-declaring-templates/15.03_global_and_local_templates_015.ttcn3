// @requirement: 15.3 -- The "->" symbol shall be used for this purpose (see clause 23).
// @id: TTCN3-CORE-15.3-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_03_global_and_local_templates_015 {

    type record MyMessageType {
        integer field1,
        charstring field2
    }

    type port P message {
        inout MyMessageType;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template MyMessageType mw_myTemplate := { field1 := ?, field2 := ? }

    testcase TC() runs on C {
        timer T := 1.0;
        var MyMessageType v_msg;
        connect(self:p1, self:p2);
        p1.send(MyMessageType:{ field1 := 7, field2 := "abc" });
        T.start;
        alt {
            [] p2.receive(mw_myTemplate) -> value v_msg {
                if (v_msg.field1 == 7) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
