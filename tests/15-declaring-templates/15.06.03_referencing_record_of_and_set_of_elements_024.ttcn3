// @requirement: 15.6.3 -- If the referenced item is not a result of transformation, the value or matching symbol at the right hand side of the assignment shall replace the referenced symbol in the original template. When the reference is used at the left hand side of the assignment, the following applies: If positions of all AnyElementsOrNone matching symbols in the transformed form are greater than the position of the referenced item the following rules are used.
// @id: TTCN3-CORE-15.6.3-042a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_03_referencing_record_of_and_set_of_elements_024 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := {1, 2, * length (2), 5};
        v_roI[1] := 10;
        if (match({1, 10, 0, 0, 5}, v_roI) and not match({1, 2, 0, 0, 5}, v_roI) and
            not match({1, 10, 0, 5}, v_roI)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
