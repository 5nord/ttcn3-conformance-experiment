// @requirement: 15.1 -- No binding of the incoming values to the template shall occur.
// @id: TTCN3-CORE-15.1-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_01_declaring_message_templates_006 {

    type record MyMessageType {
        integer field1,
        charstring field2
    }

    type port P message {
        inout MyMessageType;
    }

    type component C {
        port P p1;
        port P p2;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var template MyMessageType v_mw := { field1 := ?, field2 := ? };
        connect(self:p1, self:p2);
        p1.send(MyMessageType:{ field1 := 1, field2 := "a" });
        p1.send(MyMessageType:{ field1 := 2, field2 := "b" });
        T.start;
        alt {
            [] p2.receive(v_mw) { }
            [] T.timeout { setverdict(fail); }
        }
        if (isvalue(v_mw)) {
            setverdict(fail);
        }
        alt {
            [] p2.receive(v_mw) { setverdict(pass); }
            [] p2.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
