// @requirement: 15.8.1 -- Col1: template(present); Value: Yes; Template (omit): No; Template (value): Yes; Template (present): Yes; Template: No
// @id: TTCN3-CORE-15.8.1-047a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_08_01_explicit_restrictions_039 {
    type record R {
        integer a,
        boolean b optional
    }

    template(value) R m_value := {a := 1, b := true};
    template(present) R mw_present := {a := ?, b := *};

    function f_check(template(present) R p_r) {
        setverdict(pass);
    }

    type component C {}

    testcase TC() runs on C {
        var R v_r := {a := 1, b := true};
        var template(present) R vt_r;
        vt_r := v_r;
        vt_r := m_value;
        vt_r := mw_present;
        f_check(v_r);
        f_check(m_value);
        f_check(mw_present);
    }

    control {
        execute(TC());
    }
}
