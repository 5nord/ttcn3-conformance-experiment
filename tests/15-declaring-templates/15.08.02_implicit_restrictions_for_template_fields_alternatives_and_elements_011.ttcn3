// @requirement: 15.8.2 -- Referenced field, alternative or element: Mandatory field of a record or set, ...; Col4: template (present); Col5: template (present)
// @id: TTCN3-CORE-15.8.2-011b
// @verdict: pass accept, ttcn3verdict:pass
module M_15_08_02_implicit_restrictions_for_template_fields_alternatives_and_elements_011 {

    type record R { integer a, integer b optional }

    function f_matchesOne(template(present) integer p_t) return boolean {
        return match(1, p_t);
    }

    type component C {}

    testcase TC() runs on C {
        var template R v_t := { a := 1, b := * };
        if (f_matchesOne(v_t.a)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
