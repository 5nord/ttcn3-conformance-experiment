// @requirement: 15.6.3 -- AnyElementsOrNone as a permutation element causes that the permutation shelters all record of element indexes.
// @id: TTCN3-CORE-15.6.3-021a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_03_referencing_record_of_and_set_of_elements_015 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := {permutation(0, 1, 3, *), 2, ?};
        var template integer v_int := v_roI[5]; // error: permutation with * covers all indexes
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
