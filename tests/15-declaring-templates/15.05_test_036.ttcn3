// @requirement: 15.5 -- If the base template does not have a template restriction, the modified template derived from it shall not have a template restriction.
// @id: TTCN3-CORE-15.5-040a
// @verdict: pass reject
module M_15_05_test_036 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r1 := { f1 := 123, f2 := "A string", f3 := true };
    template(value) R m_r2 modifies m_r1 := { f2 := "B string" }; // error: base template is unrestricted

    type component C {}

    testcase TC() runs on C {
        if (match({ f1 := 123, f2 := "B string", f3 := true }, m_r2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
