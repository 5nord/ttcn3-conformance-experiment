// @requirement: 15.8.2 -- All rules for templates with an explicit restriction specified in the clause 15.8.1 are valid for template fields, alternatives and elements with an implicit restriction as well.
// @id: TTCN3-CORE-15.8.2-002a
// @verdict: pass reject
module M_15_08_02_test_002 {

    type record R { integer a, integer b optional }

    function f(template(value) integer p_t) {}

    type component C {}

    testcase TC() runs on C {
        var template(present) R v_t := { a := 1, b := omit };
        f(v_t.a); // error: template(present) field passed to template(value) parameter
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
