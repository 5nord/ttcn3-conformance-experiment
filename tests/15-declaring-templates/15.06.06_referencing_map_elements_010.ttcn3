// @requirement: 15.6.6 -- When referencing an element within a map template or field to which AnyValueOrNone is assigned on the left-hand side of an assignment, the rules for AnyValue shall apply (see item c) for more details).
// @id: TTCN3-CORE-15.6.6-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_06_referencing_map_elements_010 {

    type map from charstring to integer TMap;

    type component C {}

    testcase TC() runs on C {
        var template TMap v_map := *;
        var TMap v_ok := { ["test"] := 2, ["other"] := 7 };
        var TMap v_nok := { ["test"] := 3 };
        v_map["test"] := 2;
        if (istemplatekind(v_map, "AnyElementsOrNone") and match(v_ok, v_map)
            and not match(v_nok, v_map)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
