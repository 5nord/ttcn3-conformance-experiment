// @requirement: 15.1 -- Matching mechanisms, as defined in clauses 15.6.6 and 15.8 and in annex B, may be used in receive templates.
// @id: TTCN3-CORE-15.1-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_01_test_005 {

    type record MyMessageType {
        integer field1 optional,
        charstring field2,
        boolean field3,
        integer field4
    }

    type port P message {
        inout MyMessageType;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template MyMessageType mw_myTemplate := {
        field1 := *,
        field2 := pattern "abc*xyz",
        field3 := ?,
        field4 := (1 .. 10)
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.send(MyMessageType:{ field1 := omit, field2 := "abc123xyz", field3 := false, field4 := 5 });
        T.start;
        alt {
            [] p2.receive(mw_myTemplate) { setverdict(pass); }
            [] p2.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
