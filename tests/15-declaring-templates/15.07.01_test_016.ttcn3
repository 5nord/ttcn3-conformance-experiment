// @requirement: 15.7.1 -- Col1: enumerated; Col2: Yes; Table 11: TTCN-3 Matching Mechanisms: Yes1; Col4: Yes; Col5: Yes; Col6: Yes; Col7: Yes1; Col17: Yes1
// @id: TTCN3-CORE-15.7.1-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_01_test_016 {

    type component C {}

    type enumerated E { e_red, e_green, e_blue }

    type record R {
        E f optional
    }

    template E m_spec := e_red;
    template E m_omit := omit;
    template E m_compl := complement(e_red);
    template E m_list := (e_red, e_green);
    template E m_any := ?;
    template E m_anyOrNone := *;
    template R m_rOmit := { f := omit };
    template R m_rAnyOrNone := { f := * };
    template R m_rIfPresent := { f := e_red ifpresent };

    testcase TC() runs on C {
        var E v_red := e_red;
        var E v_green := e_green;
        var E v_blue := e_blue;
        var R v_absent := { f := omit };
        var R v_present := { f := e_red };
        var R v_other := { f := e_green };
        if (match(v_red, m_spec) and not match(v_green, m_spec) and
            match(v_green, m_compl) and not match(v_red, m_compl) and
            match(v_green, m_list) and not match(v_blue, m_list) and
            match(v_blue, m_any) and
            match(v_absent, m_rOmit) and not match(v_present, m_rOmit) and
            match(v_absent, m_rAnyOrNone) and match(v_present, m_rAnyOrNone) and
            match(v_absent, m_rIfPresent) and match(v_present, m_rIfPresent) and
            not match(v_other, m_rIfPresent)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
