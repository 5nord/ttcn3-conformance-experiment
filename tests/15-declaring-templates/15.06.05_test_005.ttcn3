// @requirement: 15.6.5 -- If the referenced alternative is not the last element of the dot notation, rules in clause 15.6.2 valid for AnyValue shall apply recursively for further expansion. When referencing an alternative of a union template or template field to which AnyValueOrNone or Omit is assigned, at the left hand side of an assignment, the template field is implicitly set to be present and the referenced alternative becomes the chosen one.
// @id: TTCN3-CORE-15.6.5-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_05_test_005 {

    type record R1 {
        integer f1,
        integer f2
    }

    type union U {
        integer c1,
        R1 c2
    }

    type record R2 {
        integer g1,
        U g2 optional
    }

    type component C {}

    testcase TC() runs on C {
        var template R2 v_t1 := { g1 := 5, g2 := omit };
        var R2 v_ok := { g1 := 5, g2 := { c2 := { f1 := 1, f2 := 99 } } };
        var R2 v_nok := { g1 := 5, g2 := { c2 := { f1 := 2, f2 := 99 } } };
        v_t1.g2.c2.f1 := 1;
        if (match(v_ok, v_t1) and not match(v_nok, v_t1)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
