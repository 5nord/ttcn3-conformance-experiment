// @requirement: 15.3 -- Both global and local templates can be parameterized.
// @id: TTCN3-CORE-15.3-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_03_global_and_local_templates_006 {

    type record MyMessageType {
        integer field1 optional,
        charstring field2,
        boolean field3
    }

    type component C {}

    template MyMessageType mw_global(integer p_myFormalParam) := {
        field1 := p_myFormalParam,
        field2 := pattern "abc*xyz",
        field3 := true
    }

    testcase TC() runs on C {
        template MyMessageType mw_local(boolean p_flag) := {
            field1 := ?,
            field2 := ?,
            field3 := p_flag
        }
        var MyMessageType v_msg := { field1 := 123, field2 := "abcxyz", field3 := true };
        if (match(v_msg, mw_global(123)) and not match(v_msg, mw_global(1)) and
            match(v_msg, mw_local(true)) and not match(v_msg, mw_local(false))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
