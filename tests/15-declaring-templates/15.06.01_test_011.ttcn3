// @requirement: 15.6.1 -- The value can contain either a single item of the string type (bit, hex, octet or character) or a matching mechanism inside a value (such as AnyElement or AnyElementOrNone).
// @id: TTCN3-CORE-15.6.1-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_01_test_011 {

    type component C {}

    testcase TC() runs on C {
        var template hexstring v_hex := 'A?*'H, v_e1, v_e2, v_e3;
        v_e1 := v_hex[0];
        v_e2 := v_hex[1];
        v_e3 := v_hex[2];
        if (match('A'H, v_e1) and not match('B'H, v_e1)
            and match('B'H, v_e2) and not match('BC'H, v_e2)
            and match(''H, v_e3) and match('BC'H, v_e3)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
