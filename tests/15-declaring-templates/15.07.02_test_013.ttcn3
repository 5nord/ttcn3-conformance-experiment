// @requirement: 15.7.2 -- **subset: at most the elements listed, i.e. possibly less;**
// @id: TTCN3-CORE-15.7.2-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_02_test_013 {

    type component C {}

    type set of integer SoI;

    template SoI m_subset := subset(1, 2, 3);

    testcase TC() runs on C {
        var SoI v_exact := { 3, 2, 1 };
        var SoI v_less := { 2, 1 };
        var SoI v_empty := {};
        var SoI v_more := { 1, 2, 3, 4 };
        var SoI v_other := { 1, 4 };
        if (match(v_exact, m_subset) and match(v_less, m_subset) and match(v_empty, m_subset) and
            not match(v_more, m_subset) and not match(v_other, m_subset)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
