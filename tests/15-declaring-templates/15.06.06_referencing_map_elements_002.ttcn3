// @requirement: 15.6.6 -- a) _Omit: referencing an element within a map to which omit is assigned shall follow the rules specified in_ clause 6.2.15.7.
// @id: TTCN3-CORE-15.6.6-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_06_referencing_map_elements_002 {

    type map from charstring to integer TMap;

    type component C {}

    testcase TC() runs on C {
        var template TMap v_map := omit;
        var TMap v_ok := { ["a"] := 1 };
        var TMap v_nok := { ["a"] := 2 };
        v_map["a"] := 1;
        if (match(v_ok, v_map) and not match(v_nok, v_map)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
