// @requirement: 15.7.1 -- The matching mechanism for a specific value is an expression that evaluates to a specific value.
// @id: TTCN3-CORE-15.7.1-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_01_specific_values_003 {

    type port P message {
        inout charstring, octetstring
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p, self:p);
        p.send(charstring:"abc" & "xyz");
        p.send('AAAA'O);
        T.start;
        alt {
            [] p.receive(charstring:"abcxyz") {
                T.stop;
                T.start;
                alt {
                    [] p.receive('AA'O & 'AA'O) {
                        setverdict(pass);
                    }
                    [] p.receive {
                        setverdict(fail);
                    }
                    [] T.timeout {
                        setverdict(fail);
                    }
                }
            }
            [] p.receive {
                setverdict(fail);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
