// @requirement: 15.6.3 -- When resolving the reference, a transformed form of the record of or set of template is used.
// @id: TTCN3-CORE-15.6.3-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_03_test_017 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := {1, * length (2), 5};
        var template integer v_int := v_roI[3];
        if (match(5, v_int) and not match(4, v_int)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
