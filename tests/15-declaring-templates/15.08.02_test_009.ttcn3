// @requirement: 15.8.2 -- Restriction of base template: Template; Allowed restrictions of modified template: No; Col3: No; Col4: No; Col5: Yes
// @id: TTCN3-CORE-15.8.2-008b
// @verdict: pass reject
module M_15_08_02_test_009 {

    type record R { integer a, integer b optional }

    template R m_base := { a := 1, b := omit };
    template(present) R m_mod modifies m_base := { a := 2 }; // error: present restriction not allowed for unrestricted base

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
