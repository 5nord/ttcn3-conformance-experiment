// @requirement: 15.6.3 -- h) Special value null: referencing an element of an address type, which actual value is null shall cause an error.
// @id: TTCN3-CORE-15.6.3-032a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_03_test_021 {

    type record of integer address;

    type component C {}

    testcase TC() runs on C {
        var template address v_addr := null;
        var template integer v_int := v_addr[0]; // error: v_addr is null
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
