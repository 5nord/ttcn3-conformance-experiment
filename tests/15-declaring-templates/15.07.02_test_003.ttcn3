// @requirement: 15.7.2 -- NOTE 1: **omit can be assigned to templates of any type as a whole or to optional fields of record and set types.** **omit can only be used for matching optional fields.**
// @id: TTCN3-CORE-15.7.2-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_02_test_003 {

    type component C {}

    type record R {
        integer f optional
    }

    type set S {
        charstring f optional
    }

    template integer m_intOmit := omit;
    template R m_recWholeOmit := omit;
    template R m_rec := { f := m_intOmit };
    template S m_set := { f := omit };

    testcase TC() runs on C {
        var R v_r := { f := omit };
        var S v_s := { f := omit };
        var R v_rp := { f := 1 };
        if (match(v_r, m_rec) and not match(v_rp, m_rec) and match(v_s, m_set)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
