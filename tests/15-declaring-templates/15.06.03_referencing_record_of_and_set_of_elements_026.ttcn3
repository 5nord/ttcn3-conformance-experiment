// @requirement: 15.6.3 -- If the position of the referenced item is greater or equal to the position of any AnyElementsOrNone symbol in the transformed form and this AnyElementsOrNone symbol is not the last element in the template, an error is generated. When the reference is used at the left hand side of the assignment, the following applies:
// @id: TTCN3-CORE-15.6.3-046a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_03_referencing_record_of_and_set_of_elements_026 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := {1, 2, *, 5};
        v_roI[3] := 4; // error: * is not the last element
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
