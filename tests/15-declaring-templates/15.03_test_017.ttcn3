// @requirement: 15.3 -- d) After completing initialization, global and local message templates that do not contain the @abstract modifier shall be fully initialized.
// @id: TTCN3-CORE-15.3-022a
// @verdict: pass reject
module M_15_03_test_017 {

    type record MyMessageType {
        integer field1,
        charstring field2,
        boolean field3
    }

    type component C {}

    testcase TC() runs on C {
        template MyMessageType m_local := { field1 := 1, field2 := "abc" }; // error: field3 is not initialized
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
