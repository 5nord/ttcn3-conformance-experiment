// @requirement: 15.5 -- a) A modified template shall not refer to itself, either directly or indirectly, i.e. recursive derivation is not allowed.
// @id: TTCN3-CORE-15.5-029a
// @verdict: pass reject
module M_15_05_test_025 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r1 modifies m_r1 := { f2 := "A string" }; // error: modified template refers to itself

    type component C {}

    testcase TC() runs on C {
        if (match({ f1 := 1, f2 := "A string", f3 := true }, m_r1)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
