// @requirement: 15.3 -- NOTE 2: Initialization of templates without parameters is completed at the place of their declaration.
// @id: TTCN3-CORE-15.3-029a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_03_global_and_local_templates_026 {


    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        template integer t_i := v_i;
        v_i := 2;
        if (match(1, t_i) and not match(2, t_i)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
