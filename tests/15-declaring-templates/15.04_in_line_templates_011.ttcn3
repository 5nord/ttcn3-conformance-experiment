// @requirement: 15.4 -- e) There exist a number of restrictions on the functions used in expressions when specifying templates or template fields; these are specified in clause 16.1.4.
// @id: TTCN3-CORE-15.4-017a
// @verdict: pass reject
module M_15_04_in_line_templates_011 {

    type port P message { inout integer }

    type component C {
        port P p;
        var integer v_count := 0;
    }

    function f_value() runs on C return integer {
        v_count := v_count + 1;
        return 1;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.receive(integer:f_value()) { setverdict(pass); } // error: function changes a component variable
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
