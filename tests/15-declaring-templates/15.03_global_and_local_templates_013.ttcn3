// @requirement: 15.3 -- The effects of these changes on the values of the template fields do not persist in the template subsequent to the corresponding communication event.
// @id: TTCN3-CORE-15.3-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_03_global_and_local_templates_013 {

    type record MyMessageType {
        integer field1,
        charstring field2
    }

    type port P message {
        inout MyMessageType;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template MyMessageType m_base := { field1 := 1, field2 := "abc" }

    testcase TC() runs on C {
        timer T := 1.0;
        var MyMessageType v_msg;
        connect(self:p1, self:p2);
        p1.send(modifies m_base := { field1 := 5 });
        p1.send(m_base);
        T.start;
        alt {
            [] p2.receive(MyMessageType:?) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        alt {
            [] p2.receive(MyMessageType:?) -> value v_msg {
                if (v_msg.field1 == 1) { setverdict(pass); } else { setverdict(fail); }
            }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
