// @requirement: 15.11 -- Concatenation of character strings in a pattern definition always takes precedence over concatenation of templates.
// @id: TTCN3-CORE-15.11-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_11_concatenating_templates_of_string_and_list_types_022 {

    template charstring mw_t := pattern "ABC" & "?EF";

    type component C {}

    testcase TC() runs on C {
        if (match("ABCxEF", mw_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
