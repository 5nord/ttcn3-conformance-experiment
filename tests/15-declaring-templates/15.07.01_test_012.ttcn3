// @requirement: 15.7.1 -- Col1: record of; Col2: Yes; Table 11: TTCN-3 Matching Mechanisms: Yes1; Col4: Yes; Col5: Yes; Col6: Yes; Col7: Yes1; Col13: Yes; Col14: Yes; Col15: Yes; Col16: Yes; Col17: Yes1
// @id: TTCN3-CORE-15.7.1-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_01_test_012 {

    type component C {}

    type record of integer RoI;

    type record R {
        RoI f optional
    }

    template RoI m_spec := { 1, 2 };
    template RoI m_omit := omit;
    template RoI m_compl := complement({ 1, 2 });
    template RoI m_list := ({ 1, 2 }, { 3 });
    template RoI m_any := ?;
    template RoI m_anyOrNone := *;
    template RoI m_anyElem := { 1, ?, 3 };
    template RoI m_anyElems := { 1, * };
    template RoI m_perm := { permutation(1, 2, 3) };
    template RoI m_length := ? length(2);
    template R m_rOmit := { f := omit };
    template R m_rAnyOrNone := { f := * };
    template R m_rIfPresent := { f := { 1, 2 } ifpresent };

    testcase TC() runs on C {
        var R v_absent := { f := omit };
        var R v_present := { f := { 1, 2 } };
        var R v_other := { f := { 3 } };
        if (match({ 1, 2 }, m_spec) and not match({ 2, 1 }, m_spec) and
            match({ 2, 1 }, m_compl) and not match({ 1, 2 }, m_compl) and
            match({ 3 }, m_list) and not match({ 4 }, m_list) and
            match({}, m_any) and
            match({ 1, 9, 3 }, m_anyElem) and not match({ 1, 3 }, m_anyElem) and
            match({ 1 }, m_anyElems) and match({ 1, 5, 6 }, m_anyElems) and not match({ 2, 1 }, m_anyElems) and
            match({ 3, 1, 2 }, m_perm) and not match({ 1, 2, 4 }, m_perm) and
            match({ 7, 8 }, m_length) and not match({ 7 }, m_length) and
            match(v_absent, m_rOmit) and not match(v_present, m_rOmit) and
            match(v_absent, m_rAnyOrNone) and match(v_present, m_rAnyOrNone) and
            match(v_absent, m_rIfPresent) and match(v_present, m_rIfPresent) and
            not match(v_other, m_rIfPresent)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
