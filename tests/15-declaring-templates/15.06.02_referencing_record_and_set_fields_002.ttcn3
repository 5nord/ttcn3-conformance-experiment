// @requirement: 15.6.2 -- a) _Omit, AnyValueOrNone, template lists and complemented lists: referencing a subfield within a structured field_ to which Omit, AnyValueOrNone, a template list or a complemented list is assigned, at the right hand side of an assignment, shall cause an error.
// @id: TTCN3-CORE-15.6.2-004a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_02_referencing_record_and_set_fields_002 {

    type record R2 {
        integer g1,
        R2 g2 optional
    }

    type record R1 {
        integer f1 optional,
        R2 f2 optional
    }

    type component C {}

    testcase TC() runs on C {
        var template R1 v_r1 := {f1 := 5, f2 := omit};
        var template integer v_int := v_r1.f2.g1; // error: f2 is omit
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
