// @requirement: 15.5 -- when individual values of a modified template or a modified template field of record of or set of type wished to be changed, and only in these cases, the index assignment notation may also be used, where the left hand side of the assignment is the index of the element to be altered.
// @id: TTCN3-CORE-15.5-019b
// @verdict: pass reject
module M_15_05_test_017 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r1 := { f1 := 123, f2 := "A string", f3 := true };
    template R m_r2 modifies m_r1 := { [0] := 5 }; // error: index assignment notation for a record template

    type component C {}

    testcase TC() runs on C {
        if (match({ f1 := 5, f2 := "A string", f3 := true }, m_r2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
