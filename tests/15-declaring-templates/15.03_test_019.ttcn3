// @requirement: 15.3 -- All procedure parameters are fully initialized.
// @id: TTCN3-CORE-15.3-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_03_test_019 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    type port P procedure {
        inout RemoteProc;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template RemoteProc s_template1 := { Par1 := 1, Par2 := 2, Par3 := 3 }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.call(s_template1, nowait);
        T.start;
        alt {
            [] p2.getcall(s_template1) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        p2.reply(s_template1 value 4);
        alt {
            [] p1.getreply(s_template1 value 4) { setverdict(pass); }
            [] p1.getreply { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
