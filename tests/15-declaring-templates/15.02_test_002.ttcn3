// @requirement: 15.2 -- Templates may be defined for any procedure by referencing the associated signature definition.
// @id: TTCN3-CORE-15.2-002a
// @verdict: pass accept, noexecution
module M_15_02_test_002 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;
    signature NoParProc();
    signature NonBlockingProc(in charstring Par1) noblock;
    signature ExcProc(in boolean Par1) exception (integer);

    template RemoteProc s_remote := { Par1 := 1, Par2 := 2, Par3 := 3 }
    template NoParProc s_noPar := {}
    template NonBlockingProc s_nonBlocking := { Par1 := "a" }
    template ExcProc s_exc := { Par1 := true }
}
