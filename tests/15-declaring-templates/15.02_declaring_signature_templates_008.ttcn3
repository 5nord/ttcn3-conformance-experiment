// @requirement: 15.2 -- Any template specification for out parameters is simply ignored, therefore it is allowed to specify matching mechanisms for these fields, or to omit them (see annex B).
// @id: TTCN3-CORE-15.2-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_02_declaring_signature_templates_008 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    type port P procedure {
        inout RemoteProc;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template RemoteProc s_call := { Par1 := 1, Par2 := 99, Par3 := 3 }

    testcase TC() runs on C {
        timer T := 1.0;
        var integer v_par1, v_par3;
        connect(self:p1, self:p2);
        p1.call(s_call, nowait);
        T.start;
        alt {
            [] p2.getcall(RemoteProc:{ Par1 := 1, Par2 := -, Par3 := 3 }) -> param(v_par1 := Par1, v_par3 := Par3) {
                if (v_par1 == 1 and v_par3 == 3) { setverdict(pass); } else { setverdict(fail); }
            }
            [] p2.getcall { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
