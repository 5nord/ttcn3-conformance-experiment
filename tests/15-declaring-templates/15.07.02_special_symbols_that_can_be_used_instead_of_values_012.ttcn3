// @requirement: 15.7.2 -- **superset: at least all of the elements listed, i.e. possibly more;**
// @id: TTCN3-CORE-15.7.2-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_02_special_symbols_that_can_be_used_instead_of_values_012 {

    type component C {}

    type set of integer SoI;

    template SoI m_superset := superset(1, 2);

    testcase TC() runs on C {
        var SoI v_exact := { 2, 1 };
        var SoI v_more := { 3, 1, 2 };
        var SoI v_less := { 1 };
        var SoI v_other := { 1, 3 };
        if (match(v_exact, m_superset) and match(v_more, m_superset) and
            not match(v_less, m_superset) and not match(v_other, m_superset)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
