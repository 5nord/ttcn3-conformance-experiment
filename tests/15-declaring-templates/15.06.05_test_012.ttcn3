// @requirement: 15.6.5 -- c) Ifpresent attribute: referencing an alternative of a union template field to which the ifpresent attribute is attached, shall cause an error (irrespective of the value or the matching mechanism to which ifpresent is appended).
// @id: TTCN3-CORE-15.6.5-017a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_05_test_012 {

    type union U {
        integer c1,
        charstring c2
    }

    type record R2 {
        integer g1,
        U g2 optional
    }

    type component C {}

    testcase TC() runs on C {
        var template R2 v_t1 := { g1 := 5, g2 := { c1 := 1 } ifpresent };
        var template integer v_t2;
        v_t2 := v_t1.g2.c1; // error: ifpresent is attached to v_t1.g2
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
