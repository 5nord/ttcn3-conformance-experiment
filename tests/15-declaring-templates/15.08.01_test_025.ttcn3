// @requirement: 15.8.1 -- Used with template restriction: value; Value: Yes; Instead of values: Note 1
// @id: TTCN3-CORE-15.8.1-039b
// @verdict: pass accept, ttcn3verdict:pass
module M_15_08_01_test_025 {
    type record R {
        integer a,
        boolean b optional
    }

    template(value) R m_r := {a := 1, b := omit};

    type component C {}

    testcase TC() runs on C {
        var R v_r := {a := 1, b := omit};
        if (match(v_r, m_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
