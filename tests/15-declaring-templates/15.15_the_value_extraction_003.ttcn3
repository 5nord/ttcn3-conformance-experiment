// @requirement: 15.15 -- Applying this extraction to a pattern matching mechanism of the form pattern _StringValue will yield the value_ _StringValue.
// @id: TTCN3-CORE-15.15-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_15_the_value_extraction_003 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_pattern := pattern "a?c*[0-9]";
        var charstring v_str := v_pattern.value;
        if (v_str == "a?c*[0-9]") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
