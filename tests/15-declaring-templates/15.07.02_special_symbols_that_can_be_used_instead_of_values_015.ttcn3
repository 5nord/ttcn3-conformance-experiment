// @requirement: 15.7.2 -- **decmatch: used for matching of encoded payload fields;**
// @id: TTCN3-CORE-15.7.2-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_02_special_symbols_that_can_be_used_instead_of_values_015 {

    type component C {}

    type integer Payload (0 .. 255) with { encode "RAW" }

    type record Msg {
        integer id,
        bitstring payload
    }

    template Msg m_msg := { id := ?, payload := decmatch Payload:(10 .. 20) };

    testcase TC() runs on C {
        var Payload v_in := 15;
        var Payload v_out := 30;
        var Msg v_matching := { id := 1, payload := encvalue(v_in) };
        var Msg v_notMatching := { id := 1, payload := encvalue(v_out) };
        if (match(v_matching, m_msg) and not match(v_notMatching, m_msg)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
