// @requirement: 15.8.1 -- d) A modified template may have a less strict restriction than the base template according to table 13b.
// @id: TTCN3-CORE-15.8.1-036a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_08_01_test_020 {
    type record R {
        integer a,
        boolean b optional
    }

    template(value) R m_base := {a := 1, b := true};
    template(present) R mw_mod modifies m_base := {a := ?};

    type component C {}

    testcase TC() runs on C {
        var R v_r := {a := 5, b := true};
        if (match(v_r, mw_mod)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
