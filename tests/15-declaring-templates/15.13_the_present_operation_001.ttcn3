// @requirement: 15.13 -- present "(" TemplateInstance ")"
// @id: TTCN3-CORE-15.13-002a
// @verdict: pass accept, noexecution
module M_15_13_the_present_operation_001 {

    type record R {
        integer a,
        boolean b optional
    }

    template R m_original := ?;
    template(present) R m_target := present(m_original);
}
