// @requirement: 15.3 -- Both global and local templates shall adhere to the scoping rules specified in clause 5.
// @id: TTCN3-CORE-15.3-006a
// @verdict: pass reject
module M_15_03_global_and_local_templates_005 {

    type component C {}

    function f() {
        template integer m_local := 1;
    }

    testcase TC() runs on C {
        if (match(1, m_local)) { // error: local template of f is not visible here
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
