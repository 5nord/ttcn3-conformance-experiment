// @requirement: 15.4 -- In-line templates do not have names, therefore they cannot be referenced or reused.
// @id: TTCN3-CORE-15.4-006b
// @verdict: pass reject
module M_15_04_test_004 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    type component C {}

    testcase TC() runs on C {
        var template integer v_t := R:{ f1 := ?, f2 := "a", f3 := true }.f1; // error: in-line template referenced
        if (match(1, v_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
