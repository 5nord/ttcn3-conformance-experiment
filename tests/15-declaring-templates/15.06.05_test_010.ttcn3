// @requirement: 15.6.5 -- If the referenced alternative is not the last element of the dot notation, rules in clause 15.6.2 valid for AnyValue shall apply recursively for further expansion. When referencing an alternative of a union template or template field to which AnyValue is assigned, at the left hand side of an assignment, the referenced alternative becomes the chosen one.
// @id: TTCN3-CORE-15.6.5-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_05_test_010 {

    type record R1 {
        integer f1,
        integer f2
    }

    type union U {
        integer c1,
        R1 c2
    }

    type component C {}

    testcase TC() runs on C {
        var template U v_t3 := ?;
        var U v_ok := { c2 := { f1 := 1, f2 := 99 } };
        var U v_nok := { c2 := { f1 := 2, f2 := 99 } };
        v_t3.c2.f1 := 1;
        if (match(v_ok, v_t3) and not match(v_nok, v_t3)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
