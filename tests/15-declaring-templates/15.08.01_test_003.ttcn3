// @requirement: 15.8.1 -- template "(" ( omit | present | value ) ")" Type
// @id: TTCN3-CORE-15.8.1-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_08_01_test_003 {
    type record R {
        integer a,
        boolean b optional
    }

    template(omit) R m_omit := {a := 1, b := omit};
    template(value) R m_value := {a := 1, b := true};
    template(present) R mw_present := {a := ?, b := *};

    type component C {}

    testcase TC() runs on C {
        var template(omit) R vt_omit := m_omit;
        var template(value) R vt_value := m_value;
        var template(present) R vt_present := mw_present;
        if (match({a := 1, b := omit}, vt_omit) and match({a := 1, b := true}, vt_value) and match({a := 2, b := omit}, vt_present)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
