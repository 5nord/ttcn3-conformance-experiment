// @requirement: 15.9 -- The return value of the match operation indicates whether the expression matches the specified template instance.
// @id: TTCN3-CORE-15.9-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_09_match_operation_005 {

    template integer mw_lessThan10 := (-infinity .. 9);

    type component C {}

    testcase TC() runs on C {
        if (match(5, mw_lessThan10) and not match(15, mw_lessThan10)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
