// @requirement: 15.5 -- A modified template or fields of a modified record or set template may also be declared fuzzy using the @fuzzy modifier.
// @id: TTCN3-CORE-15.5-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_modified_templates_021 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r1 := { f1 := 123, f2 := "A string", f3 := true };
    template @fuzzy R m_r2 modifies m_r1 := { f2 := "B string" };
    template R m_r3 modifies m_r1 := { @fuzzy f2 := "C string" };

    type component C {}

    testcase TC() runs on C {
        if (valueof(m_r2) == { f1 := 123, f2 := "B string", f3 := true } and valueof(m_r3) == { f1 := 123, f2 := "C string", f3 := true }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
