// @requirement: 15.14 -- Applying the presentness conversion to a template expression with the omit template restriction yields the same template with the value restriction.
// @id: TTCN3-CORE-15.14-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_14_test_010 {

    type component C {}

    template(omit) integer m_omit := 7;

    testcase TC() runs on C {
        var template(value) integer v_value := m_omit.present;
        if (match(7, v_value) and not match(8, v_value)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
