// @requirement: 15.6.3 -- If the position of the referenced item is greater or equal to the position of any AnyElementsOrNone symbol in the transformed template, an error is generated. When the reference is used at the right hand side of the assignment, the following applies:
// @id: TTCN3-CORE-15.6.3-037a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_03_referencing_record_of_and_set_of_elements_023 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := {1, 2, *, 5};
        var template integer v_int := v_roI[3]; // error: index is at or after the position of *
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
