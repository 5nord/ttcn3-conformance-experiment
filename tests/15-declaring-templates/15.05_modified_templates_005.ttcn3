// @requirement: 15.5 -- The modifies keyword denotes the parent template from which the new modified template shall be derived.
// @id: TTCN3-CORE-15.5-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_modified_templates_005 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_p1 := { f1 := 1, f2 := "a", f3 := true };
    template R m_p2 := { f1 := 2, f2 := "b", f3 := false };
    template R m_mod1 modifies m_p1 := { f2 := "x" };
    template R m_mod2 modifies m_p2 := { f2 := "x" };

    type component C {}

    testcase TC() runs on C {
        if (valueof(m_mod1) == { f1 := 1, f2 := "x", f3 := true } and valueof(m_mod2) == { f1 := 2, f2 := "x", f3 := false }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
