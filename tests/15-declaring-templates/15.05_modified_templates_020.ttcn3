// @requirement: 15.5 -- Modified templates may also be restricted. Template restrictions are specified in clause 15.8.
// @id: TTCN3-CORE-15.5-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_modified_templates_020 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template(value) R m_r1 := { f1 := 123, f2 := "A string", f3 := true };
    template(value) R m_r2 modifies m_r1 := { f2 := "A modified string" };

    type component C {}

    testcase TC() runs on C {
        if (valueof(m_r2) == { f1 := 123, f2 := "A modified string", f3 := true }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
