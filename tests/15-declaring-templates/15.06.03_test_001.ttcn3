// @requirement: 15.6.3 -- Both templates and template variables allow referencing elements of a record of, array or set of template or field using the index notation.
// @id: TTCN3-CORE-15.6.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_03_test_001 {

    type record of integer RoI;

    type integer IntArr[3];

    template RoI m_roI := {1, 2, 3};

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := m_roI;
        var template IntArr v_arr := {4, 5, 6};
        var template integer v_int1 := m_roI[1];
        var template integer v_int2 := v_arr[2];
        v_roI[0] := 7;
        if (match(2, v_int1) and match(6, v_int2) and match({7, 2, 3}, v_roI)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
