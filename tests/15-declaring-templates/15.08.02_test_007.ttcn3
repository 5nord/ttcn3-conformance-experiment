// @requirement: 15.8.2 -- Restriction of base template: template(present); Allowed restrictions of modified template: No; Col3: No; Col4: Yes; Col5: Yes
// @id: TTCN3-CORE-15.8.2-007b
// @verdict: pass reject
module M_15_08_02_test_007 {

    type record R { integer a, integer b optional }

    template(present) R m_base := { a := 1, b := omit };
    template(omit) R m_mod modifies m_base := { a := 2 }; // error: omit restriction not allowed for present base

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
