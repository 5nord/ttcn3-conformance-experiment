// @requirement: 15.7.1 -- Specific values in templates are expressions which do not contain any matching mechanisms.
// @id: TTCN3-CORE-15.7.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_01_test_001 {

    type component C {}

    const integer c_base := 10;

    template integer m_spec := c_base * 2 + 1;

    testcase TC() runs on C {
        if (match(21, m_spec) and not match(20, m_spec) and not match(22, m_spec)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
