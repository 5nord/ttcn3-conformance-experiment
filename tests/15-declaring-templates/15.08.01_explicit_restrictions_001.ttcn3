// @requirement: 15.8.1 -- Template restrictions are applicable to template definitions and template variables, formal template parameters, and return template types of functions.
// @id: TTCN3-CORE-15.8.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_08_01_explicit_restrictions_001 {
    type record R {
        integer a,
        boolean b optional
    }

    template(value) R m_r := {a := 1, b := true};

    function f_get(template(omit) R p_r) return template(present) R {
        return p_r;
    }

    type component C {}

    testcase TC() runs on C {
        var template(value) R vt_r := m_r;
        if (match({a := 1, b := true}, f_get(vt_r))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
