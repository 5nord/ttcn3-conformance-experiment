// @requirement: 15.7.3 -- **permutation: all of the elements listed but in an arbitrary order (note, that ? and * are also allowed as** elements of the permutation list and all elements of a template can be added to permutation using the all from clause).
// @id: TTCN3-CORE-15.7.3-007c
// @verdict: pass accept, ttcn3verdict:pass
module M_15_07_03_special_symbols_that_can_be_used_inside_values_006 {

    type component C {}

    type record of integer RoI;

    template RoI m_ints := { 2, 3 };
    template RoI m_perm := { permutation(1, all from m_ints) };

    testcase TC() runs on C {
        var RoI v_321 := { 3, 2, 1 };
        var RoI v_213 := { 2, 1, 3 };
        var RoI v_12 := { 1, 2 };
        var RoI v_124 := { 1, 2, 4 };
        if (match(v_321, m_perm) and match(v_213, m_perm) and
            not match(v_12, m_perm) and not match(v_124, m_perm)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
