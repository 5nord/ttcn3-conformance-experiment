// @requirement: 15.11 -- When concatenating templates of charstring and universal charstring types, each single template shall be either of the charstring or universal charstring type.
// @id: TTCN3-CORE-15.11-008a
// @verdict: pass reject
module M_15_11_test_012 {

    template charstring mw_t := "ABC" & '0A'O; // error: operand is not a character string

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
