// @requirement: 15.9 -- The match operation returns a boolean value.
// @id: TTCN3-CORE-15.9-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_09_test_002 {

    type component C {}

    testcase TC() runs on C {
        var boolean v_b := match(5, integer:?);
        if (v_b == true) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
