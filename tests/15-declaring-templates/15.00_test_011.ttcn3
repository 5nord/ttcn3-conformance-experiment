// @requirement: 15.0 -- Thus, for unparameterized non-fuzzy templates, the result of the used fuzzy templates will stay the same for every usage. NOTE: Using a fuzzy template from a non-fuzzy template causes evaluation of the fuzzy template.
// @id: TTCN3-CORE-15.0-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_00_test_011 {

    type component C {
        var integer v_count := 0;
    }

    function f_next() runs on C return integer {
        v_count := v_count + 1;
        return v_count;
    }

    testcase TC() runs on C {
        template @fuzzy integer m_fuzzy := f_next();
        template integer m_nonFuzzy := m_fuzzy;
        var boolean v_first := match(1, m_nonFuzzy);
        var boolean v_second := match(1, m_nonFuzzy);
        if (v_first and v_second and v_count == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
