// @requirement: 15.11 -- Concatenation operand: ? length(n .. m) or * length(n .. m); Transformed string: "?#(n,m)"
// @id: TTCN3-CORE-15.11-032a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_11_test_036 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_t1 := "AB" & ? length(2 .. 3) & "C";
        var template charstring v_t2 := "AB" & * length(2 .. 3) & "C";
        if (match("ABxyC", v_t1) and match("ABxyzC", v_t1) and
            not match("ABxC", v_t1) and not match("ABxyzwC", v_t1) and
            match("ABxyC", v_t2) and match("ABxyzC", v_t2) and
            not match("ABxC", v_t2) and not match("ABxyzwC", v_t2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
