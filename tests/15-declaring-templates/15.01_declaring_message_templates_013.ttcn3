// @requirement: 15.1 -- // This template will match only the integer values 1, 2 or 3 template integer mw_myTemplate := (1, 2, 3);
// @id: TTCN3-CORE-15.1-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_01_declaring_message_templates_013 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template integer mw_myTemplate := (1, 2, 3);

    testcase TC() runs on C {
        timer T := 1.0;
        var integer v_received;
        var integer v_matched := 0;
        connect(self:p1, self:p2);
        for (var integer i := 0; i <= 4; i := i + 1) {
            p1.send(i);
        }
        T.start;
        for (var integer i := 0; i <= 4; i := i + 1) {
            alt {
                [] p2.receive(mw_myTemplate) -> value v_received {
                    if (v_received >= 1 and v_received <= 3) {
                        v_matched := v_matched + 1;
                    } else {
                        setverdict(fail);
                    }
                }
                [] p2.receive(integer:?) -> value v_received {
                    if (v_received >= 1 and v_received <= 3) {
                        setverdict(fail);
                    }
                }
                [] T.timeout { setverdict(fail); }
            }
        }
        if (v_matched == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
