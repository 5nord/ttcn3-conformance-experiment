// @requirement: 15.8.2 -- Restriction of base template: template(present); Allowed restrictions of modified template: No; Col3: No; Col4: Yes; Col5: Yes
// @id: TTCN3-CORE-15.8.2-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_08_02_test_006 {

    type record R { integer a, integer b optional }

    const R c_r2 := { a := 2, b := omit };
    const R c_r5 := { a := 5, b := omit };

    template(present) R mw_base := { a := 1, b := * };
    template(present) R mw_modPresent modifies mw_base := { a := 2 };
    template R mw_modAny modifies mw_base := { a := ? };

    type component C {}

    testcase TC() runs on C {
        if (match(c_r2, mw_modPresent) and match(c_r5, mw_modAny)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
