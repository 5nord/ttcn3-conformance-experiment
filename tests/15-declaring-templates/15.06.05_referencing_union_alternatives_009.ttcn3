// @requirement: 15.6.5 -- When referencing an alternative of a union template or template field to which AnyValue is assigned, at the left hand side of an assignment, the referenced alternative becomes the chosen one.
// @id: TTCN3-CORE-15.6.5-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_05_referencing_union_alternatives_009 {

    type union U {
        integer c1,
        charstring c2
    }

    type component C {}

    testcase TC() runs on C {
        var template U v_t3 := ?;
        var U v_c2 := { c2 := "abc" };
        var U v_c1 := { c1 := 1 };
        v_t3.c2 := "abc";
        if (match(v_c2, v_t3) and not match(v_c1, v_t3)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
