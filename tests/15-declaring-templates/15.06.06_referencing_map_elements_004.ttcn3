// @requirement: 15.6.6 -- c) _AnyValue: when referencing an element of a map template or field to which AnyValue is assigned, at the_ right- hand side of an assignment, AnyValueOrNone shall be returned.
// @id: TTCN3-CORE-15.6.6-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_06_referencing_map_elements_004 {

    type map from charstring to integer TMap;

    type component C {}

    testcase TC() runs on C {
        var template TMap v_map := ?;
        var template integer v_int;
        v_int := v_map["test"];
        if (istemplatekind(v_int, "AnyValueOrNone")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
