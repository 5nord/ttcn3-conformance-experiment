// @requirement: 15.7.2 -- * can** only be used for matching optional fields.
// @id: TTCN3-CORE-15.7.2-011a
// @verdict: pass reject
module M_15_07_02_special_symbols_that_can_be_used_instead_of_values_010 {

    type component C {}

    type record R {
        integer f
    }

    template R m_r := { f := * }; // error: AnyValueOrNone used for a mandatory field

    testcase TC() runs on C {
        var R v_r := { f := 1 };
        if (match(v_r, m_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
