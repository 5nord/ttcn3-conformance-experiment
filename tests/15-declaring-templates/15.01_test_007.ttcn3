// @requirement: 15.1 -- a) At the time of a send operation, the used template shall be completely initialized and all fields shall resolve to actual values or to omit and no other matching mechanisms shall be used in the template fields, neither directly nor indirectly.
// @id: TTCN3-CORE-15.1-010a
// @verdict: pass accept, ttcn3verdict:error
module M_15_01_test_007 {

    type record MyMessageType {
        integer field1,
        charstring field2
    }

    type port P message {
        inout MyMessageType;
    }

    type component C {
        port P p1;
        port P p2;
    }

    testcase TC() runs on C {
        var template MyMessageType v_m;
        connect(self:p1, self:p2);
        v_m.field1 := 1;
        setverdict(pass);
        p1.send(v_m); // error: field2 is uninitialized at the time of the send operation
    }

    control {
        execute(TC());
    }
}
