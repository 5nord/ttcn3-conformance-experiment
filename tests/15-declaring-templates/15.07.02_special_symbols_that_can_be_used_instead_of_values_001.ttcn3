// @requirement: 15.7.2 -- omit | "(" { (TemplateInstance | all from TemplateInstance) [","] } ")" | complement "(" { (TemplateInstance | all from TemplateInstance) [","] } ")" | "?" | " *" | "(" ( ConstantExpression | -infinity ) ".." ( ConstantExpression | infinity ) ")" | superset "(" { (TemplateInstance | all from TemplateInstance) [","] } ")" | subset "(" { (TemplateInstance | all from TemplateInstance) [","] } ")" | pattern [@nocase] Cstring decmatch [ "(" Expression ]")" ] TemplateInstance EnumValueIdentifier "(" TemplateBody {"," TemplateBody} ")"
// @id: TTCN3-CORE-15.7.2-002a
// @verdict: pass accept, noexecution
module M_15_07_02_special_symbols_that_can_be_used_instead_of_values_001 {

    type record of integer RoI;
    type set of integer SoI;
    type integer Payload with { encode "RAW" }
    type enumerated E { e_single(0), e_other(1 .. 100) }

    type record R {
        integer f optional
    }

    template RoI m_ints := { 1, 2 };

    template R m_omit := { f := omit };
    template integer m_list := (1, 2, all from m_ints);
    template integer m_compl := complement(1, all from m_ints);
    template integer m_any := ?;
    template R m_anyOrNone := { f := * };
    template integer m_range1 := (1 .. 10);
    template integer m_range2 := (-infinity .. 10);
    template float m_range3 := (0.0 .. infinity);
    template SoI m_superset := superset(1, all from m_ints);
    template SoI m_subset := subset(3, all from m_ints);
    template charstring m_pattern1 := pattern "a*z";
    template charstring m_pattern2 := pattern @nocase "abc";
    template octetstring m_decmatch1 := decmatch Payload:?;
    template universal charstring m_decmatch2 := decmatch("UTF-8") Payload:?;
    template E m_enumList := e_other(1, 5 .. 10, ?);
}
