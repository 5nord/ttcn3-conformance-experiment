// @requirement: 15.6.3 -- If positions of all AnyElementsOrNone matching symbols in the transformed form are greater than the position of the referenced item, rules from the clause 6.2.3.2 are used for resolving the reference. When the reference is used at the right hand side of the assignment, the following applies:
// @id: TTCN3-CORE-15.6.3-034a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_03_test_022 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template RoI v_roI := {1, 2, * length (2), 5};
        var template integer v_int1 := v_roI[1];
        var template integer v_int2 := v_roI[2];
        if (match(2, v_int1) and not match(3, v_int1) and istemplatekind(v_int2, "AnyValue")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
