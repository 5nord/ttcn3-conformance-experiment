// @requirement: 15.3 -- All out and inout procedure parameters are completely initialized and all in procedure parameters are either unitialized or marked as not relevant using the NotUsedSymbol.
// @id: TTCN3-CORE-15.3-027a
// @verdict: pass accept, noexecution
module M_15_03_test_023 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    template RemoteProc s_notUsed := { Par1 := -, Par2 := 2, Par3 := 3 }
    template RemoteProc s_uninitialized := { Par2 := 2, Par3 := 3 }
}
