// @requirement: 15.13 -- NOTE: This means that the result of present(m_myTemplate) can be safely assigned to templates with the present restriction.
// @id: TTCN3-CORE-15.13-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_13_the_present_operation_004 {

    type component C {}

    function f_check(template(present) integer p_t) return boolean {
        return match(5, p_t);
    }

    testcase TC() runs on C {
        var template integer v_t := ?;
        var template(present) integer v_res := present(v_t);
        if (match(5, v_res) and f_check(present(v_t))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
