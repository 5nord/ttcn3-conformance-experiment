// @requirement: 15.3 -- Template fields affected by parameterization are initialized at the time of template use.
// @id: TTCN3-CORE-15.3-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_03_global_and_local_templates_011 {

    type record MyMessageType {
        integer field1,
        charstring field2
    }

    type component C {}

    template MyMessageType mw_myTemplate(integer p_value) := {
        field1 := p_value,
        field2 := "abc"
    }

    testcase TC() runs on C {
        var integer v_value := 1;
        var MyMessageType v_msg1 := { field1 := 1, field2 := "abc" };
        var MyMessageType v_msg2 := { field1 := 2, field2 := "abc" };
        var boolean v_first := match(v_msg1, mw_myTemplate(v_value));
        v_value := 2;
        if (v_first and match(v_msg2, mw_myTemplate(v_value)) and not match(v_msg1, mw_myTemplate(v_value))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
