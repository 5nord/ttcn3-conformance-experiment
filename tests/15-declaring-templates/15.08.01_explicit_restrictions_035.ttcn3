// @requirement: 15.8.1 -- Col1: template(omit); Value: Yes; Template (omit): Yes; Template (value): Yes; Template (present): No; Template: No
// @id: TTCN3-CORE-15.8.1-045b
// @verdict: pass reject
module M_15_08_01_explicit_restrictions_035 {
    type record R {
        integer a,
        boolean b optional
    }

    template R mw_r := {a := ?, b := omit};

    type component C {}

    testcase TC() runs on C {
        var template(omit) R vt_r;
        vt_r := mw_r; // error: unrestricted template assigned to omit restricted variable
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
