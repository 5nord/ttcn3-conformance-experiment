// @requirement: 15.0 -- The type-based templates are used for message-based communications and the signature templates are used in procedure-based communications.
// @id: TTCN3-CORE-15.0-010b
// @verdict: pass accept, ttcn3verdict:pass
module M_15_00_general_008 {

    signature S(in integer p_in);

    type port P procedure { inout S }

    type component C {
        port P p1;
        port P p2;
        timer T := 1.0;
    }

    template S s_call := { p_in := 1 }
    template S sw_getcall := { p_in := ? }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.call(s_call, nowait);
        T.start;
        alt {
            [] p2.getcall(sw_getcall) { setverdict(pass); }
            [] p2.getcall { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
