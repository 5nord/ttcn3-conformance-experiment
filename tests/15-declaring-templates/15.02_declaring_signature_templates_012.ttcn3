// @requirement: 15.2 -- No binding of incoming values to the template shall occur.
// @id: TTCN3-CORE-15.2-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_02_declaring_signature_templates_012 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    type port P procedure {
        inout RemoteProc;
    }

    type component C {
        port P p1;
        port P p2;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        var template RemoteProc v_s := { Par1 := ?, Par2 := ?, Par3 := ? };
        connect(self:p1, self:p2);
        p1.call(RemoteProc:{ Par1 := 1, Par2 := -, Par3 := 3 }, nowait);
        p1.call(RemoteProc:{ Par1 := 2, Par2 := -, Par3 := 4 }, nowait);
        T.start;
        alt {
            [] p2.getcall(v_s) { }
            [] T.timeout { setverdict(fail); stop; }
        }
        if (isvalue(v_s)) {
            setverdict(fail);
        }
        alt {
            [] p2.getcall(v_s) { setverdict(pass); }
            [] p2.getcall { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
