// @requirement: 15.8.1 -- Col1: template(present); Value: Yes; Template (omit): No; Template (value): Yes; Template (present): Yes; Template: No
// @id: TTCN3-CORE-15.8.1-047b
// @verdict: pass reject
module M_15_08_01_test_040 {
    type record R {
        integer a,
        boolean b optional
    }

    template(omit) R m_omit := omit;

    type component C {}

    testcase TC() runs on C {
        var template(present) R vt_r;
        vt_r := m_omit; // error: omit restricted template assigned to present restricted variable
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
