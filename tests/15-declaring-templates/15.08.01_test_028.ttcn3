// @requirement: 15.8.1 -- Used with template restriction: present; Value: Yes; Instead of values: Note 1; Col4: Yes; Col5: Yes; Col6: Yes; Col7: Note 1; Col8: Yes; Col9: Yes; Col10: Yes; Col11: Yes; Col12: Note 2; Inside values: Yes; Col14: Yes; Col15: Yes; Attributes: Yes; Col17: Note 1
// @id: TTCN3-CORE-15.8.1-040a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_08_01_test_028 {
    type record of integer RoI;
    type set of integer SoI;

    template(present) integer mw_spec := 1;
    template(present) integer mw_compl := complement(2);
    template(present) integer mw_list := (1, 3);
    template(present) integer mw_any := ?;
    template(present) integer mw_range := (0 .. 10);
    template(present) SoI mw_superset := superset(1);
    template(present) SoI mw_subset := subset(1, 2, 3);
    template(present) charstring mw_pattern := pattern "a*b";
    template(present) RoI mw_elems := {1, ?, *};
    template(present) RoI mw_perm := {permutation(1, 2)};
    template(present) RoI mw_length := ? length (2);

    type component C {}

    testcase TC() runs on C {
        var SoI v_so := {1, 2};
        var RoI v_ro := {1, 2};
        var RoI v_ro3 := {1, 5, 7};
        if (match(1, mw_spec) and match(1, mw_compl) and match(3, mw_list) and match(9, mw_any) and match(4, mw_range) and match(v_so, mw_superset) and match(v_so, mw_subset) and match("axxb", mw_pattern) and match(v_ro3, mw_elems) and match({2, 1}, mw_perm) and match(v_ro, mw_length)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
