// @requirement: 15.11 -- Concatenation operand: ? length(n .. infinity) or * length(n .. infinity); Transformed string: "?#(n,)"
// @id: TTCN3-CORE-15.11-031a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_11_test_035 {

    type component C {}

    testcase TC() runs on C {
        var template charstring v_t1 := "AB" & ? length(2 .. infinity) & "C";
        var template charstring v_t2 := "AB" & * length(2 .. infinity) & "C";
        if (match("ABxyC", v_t1) and match("ABxyzwC", v_t1) and not match("ABxC", v_t1) and
            match("ABxyC", v_t2) and match("ABxyzwC", v_t2) and not match("ABxC", v_t2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
