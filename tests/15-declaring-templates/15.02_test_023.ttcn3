// @requirement: 15.2 -- // Valid getreply, in parameters will be ignored, matches if return value is 4
// @id: TTCN3-CORE-15.2-030a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_02_test_023 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    type port P procedure {
        inout RemoteProc;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template RemoteProc s_template2 := { Par1 := 1, Par2 := ?, Par3 := 3 }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.call(RemoteProc:{ Par1 := 99, Par2 := -, Par3 := 3 }, nowait);
        T.start;
        alt {
            [] p2.getcall { }
            [] T.timeout { setverdict(fail); stop; }
        }
        p2.reply(RemoteProc:{ Par1 := -, Par2 := 20, Par3 := 3 } value 4);
        alt {
            [] p1.getreply(s_template2 value 5) { setverdict(fail); }
            [] p1.getreply(s_template2 value 4) { setverdict(pass); }
            [] p1.getreply { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
