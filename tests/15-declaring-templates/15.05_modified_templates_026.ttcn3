// @requirement: 15.5 -- b) If a base template has a formal parameter list, the following rules apply to all modified templates derived from that base template, whether or not they are derived in one or several modification steps: 1) the derived template shall not omit parameters and change types or names of parameters defined at any of the modification steps between the base template and the actual modified template;
// @id: TTCN3-CORE-15.5-031a
// @verdict: pass reject
module M_15_05_modified_templates_026 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r1(integer p_i) := { f1 := p_i, f2 := "A string", f3 := true };
    template R m_r2 modifies m_r1 := { f2 := "B string" }; // error: parameter p_i omitted

    type component C {}

    testcase TC() runs on C {
        if (match({ f1 := 1, f2 := "B string", f3 := true }, m_r2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
