// @requirement: 15.6.2 -- When referencing a subfield within a structured field to which template lists or complemented template lists are assigned, at the left hand side of an assignment, shall cause an error.
// @id: TTCN3-CORE-15.6.2-008a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_02_test_007 {

    type record R2 {
        integer g1,
        R2 g2 optional
    }

    type record R1 {
        integer f1 optional,
        R2 f2 optional
    }

    type component C {}

    testcase TC() runs on C {
        var template R1 v_r1 := {f1 := 5, f2 := ({g1 := 1, g2 := omit}, {g1 := 2, g2 := omit})};
        v_r1.f2.g1 := 3; // error: template list is assigned to f2
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
