// @requirement: 15.3 -- The rules for formal and actual parameter lists shall be followed as defined in clause 5.2.
// @id: TTCN3-CORE-15.3-009a
// @verdict: pass reject
module M_15_03_global_and_local_templates_008 {

    type component C {}

    template integer mw_myTemplate(integer p_value) := p_value;

    testcase TC() runs on C {
        if (match(1, mw_myTemplate(?))) { // error: template passed to a value formal parameter
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
