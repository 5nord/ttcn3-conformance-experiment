// @requirement: 15.5 -- b) If a base template has a formal parameter list, the following rules apply to all modified templates derived from that base template, whether or not they are derived in one or several modification steps: 3) a derived template can have additional (appended) parameters if wished;
// @id: TTCN3-CORE-15.5-033a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_05_modified_templates_029 {

    type record R {
        integer f1 optional,
        charstring f2,
        boolean f3
    }

    template R m_r1(integer p_i) := { f1 := p_i, f2 := "A string", f3 := true };
    template R m_r2(integer p_i, charstring p_s) modifies m_r1 := { f2 := p_s };

    type component C {}

    testcase TC() runs on C {
        if (valueof(m_r2(1, "B string")) == { f1 := 1, f2 := "B string", f3 := true }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
