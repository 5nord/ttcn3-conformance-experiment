// @requirement: 15.6.4 -- While signature templates do not allow referencing their parameters directly (e.g. using dot notation), such a reference is possible when modifying a signature template.
// @id: TTCN3-CORE-15.6.4-001b
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_04_referencing_signature_parameters_002 {

    signature S(in integer par1, in integer par2);

    type port P procedure {
        inout S;
    }

    type component C {
        port P p;
    }

    template S s_base := { par1 := 1, par2 := 2 };
    template S s_mod modifies s_base := { par1 := 3 };

    function f_receiver() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.getcall(s_mod) { setverdict(pass); }
            [] p.getcall { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_receiver());
        p.call(S:{ par1 := 3, par2 := 2 }, nowait);
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
