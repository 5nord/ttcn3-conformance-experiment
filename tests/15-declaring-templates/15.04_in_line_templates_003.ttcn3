// @requirement: 15.4 -- In-line templates can be defined directly at the place of its use.
// @id: TTCN3-CORE-15.4-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_04_in_line_templates_003 {

    function f_match(template integer p_t) return boolean {
        return match(5, p_t);
    }

    type component C {}

    testcase TC() runs on C {
        if (f_match(integer:(1..10)) and match(5, integer:?)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
