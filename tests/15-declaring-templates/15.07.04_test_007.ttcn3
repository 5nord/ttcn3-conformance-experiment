// @requirement: 15.7.4 -- b) All values used in the length matching attribute shall be completely initialized.
// @id: TTCN3-CORE-15.7.4-011a
// @verdict: pass accept, ttcn3verdict:error
module M_15_07_04_test_007 {

    type component C {}

    testcase TC() runs on C {
        var integer v_len;
        var template charstring vt_s := ? length (v_len); // error: v_len is not initialized
        if (match("abc", vt_s)) {
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
