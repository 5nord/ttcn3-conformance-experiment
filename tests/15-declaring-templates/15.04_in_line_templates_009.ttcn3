// @requirement: 15.4 -- d) When used in communication operations, the type of the in-line template shall be in the port list over which the template is sent or received.
// @id: TTCN3-CORE-15.4-015a
// @verdict: pass reject
module M_15_04_in_line_templates_009 {

    type port P message { inout integer }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        p.send(charstring:"abc"); // error: charstring is not in the message list of P
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
