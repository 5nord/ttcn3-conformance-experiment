// @requirement: 15.2 -- Any out parameters shall be ignored in the matching process.
// @id: TTCN3-CORE-15.2-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_02_test_013 {

    signature RemoteProc(in integer Par1, out integer Par2, inout integer Par3) return integer;

    type port P procedure {
        inout RemoteProc;
    }

    type component C {
        port P p1;
        port P p2;
    }

    template RemoteProc s_getcall := { Par1 := 1, Par2 := 0, Par3 := 3 }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.call(RemoteProc:{ Par1 := 1, Par2 := 99, Par3 := 3 }, nowait);
        T.start;
        alt {
            [] p2.getcall(s_getcall) { setverdict(pass); }
            [] p2.getcall { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
