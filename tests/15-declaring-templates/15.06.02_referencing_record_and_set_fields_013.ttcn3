// @requirement: 15.6.2 -- d) Special value null: referencing a field of an address type, which actual value is null shall cause an error.
// @id: TTCN3-CORE-15.6.2-018a
// @verdict: pass accept, ttcn3verdict:error
module M_15_06_02_referencing_record_and_set_fields_013 {

    type record address {
        integer f1
    }

    type component C {}

    testcase TC() runs on C {
        var template address v_addr := null;
        var template integer v_int := v_addr.f1; // error: v_addr is null
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
