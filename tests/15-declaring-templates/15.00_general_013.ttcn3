// @requirement: 15.0 -- A deterministic template shall be evaluated to the same result in the same deterministic evaluation context whenever it is evaluated.
// @id: TTCN3-CORE-15.0-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_15_00_general_013 {

    type port P message { inout integer }

    type component C {
        port P p1;
        port P p2;
        timer T := 1.0;
    }

    function @deterministic f_square(integer p_x) return integer {
        return p_x * p_x;
    }

    template @fuzzy @deterministic integer mw_det := f_square(3);

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(9);
        T.start;
        alt {
            [match(9, mw_det)] p2.receive(mw_det) { setverdict(pass); }
            [] p2.receive { setverdict(fail); }
            [] T.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
