// @requirement: 15.6.6 -- Then the value or matching mechanism at the right-hand side of the assignment shall be assigned to the referenced field and _AnyElementsOrNone shall be added to the map template._ When referencing an element within a map template or field to which AnyValue is assigned, at the left-hand side of an assignment, the template or field is implicitly expanded recursively up to and including, the depth of the referenced subfield and AnyValue is assigned to the referenced field.
// @id: TTCN3-CORE-15.6.6-010b
// @verdict: pass accept, ttcn3verdict:pass
module M_15_06_06_test_008 {

    type map from charstring to integer TMap;

    type component C {}

    testcase TC() runs on C {
        var template TMap v_map := ?;
        var TMap v_ok := { ["test"] := 2, ["other"] := 7 };
        v_map["test"] := 2;
        if (istemplatekind(v_map, "AnyElementsOrNone") and match(v_ok, v_map)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
