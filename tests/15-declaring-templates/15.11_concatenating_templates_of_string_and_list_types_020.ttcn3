// @requirement: 15.11 -- If one of the single templates is a pattern with the @nocase modifier, then all other single templates shall also be patterns with the @nocase modifier and the resulting pattern will also have the @nocase modifier.
// @id: TTCN3-CORE-15.11-015a
// @verdict: pass reject
module M_15_11_concatenating_templates_of_string_and_list_types_020 {

    template charstring mw_t := (pattern @nocase "abc") & (pattern "d"); // error: second pattern lacks @nocase

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
