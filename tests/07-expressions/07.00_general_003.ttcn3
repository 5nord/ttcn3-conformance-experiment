// @requirement: 7.0 -- NOTE: Templates can be used at the RHS of assignment, parameter passing and (predefined) functions where template passing is explicitly allowed.
// @id: TTCN3-CORE-7.0-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_00_general_003 {

    type component C {}

    template integer m_t := (1 .. 10);

    function f_check(template integer p_t) return boolean {
        return match(5, p_t);
    }

    testcase TC() runs on C {
        var template integer v_t := m_t;
        if (f_check(m_t) and match(5, v_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
