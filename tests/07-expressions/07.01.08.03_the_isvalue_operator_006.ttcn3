// @requirement: 7.1.8.3 -- The specific value null is considered as concrete value.
// @id: TTCN3-CORE-7.1.8.3-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_03_the_isvalue_operator_006 {

    type component C {}

    testcase TC() runs on C {
        var default v_default := null;
        var C v_comp := null;
        if (isvalue(v_default) and isvalue(v_comp)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
