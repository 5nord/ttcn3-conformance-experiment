// @requirement: 7.1.0 -- Unary **ispresent, ischosen, isvalue, isbound** Unary **+, -** Binary ***, /, mod, rem** Binary **+, -, &** Unary **not4b** Binary **and4b** Binary **xor4b** Binary **or4b** Binary **<<, >>, <@, @>** Binary **<, >, <=, >=** Binary **==, !=** Unary **not** Binary **and**
// @id: TTCN3-CORE-7.1.0-052a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_general_037 {

    type component C {}

    type record R {
        integer a optional
    }

    testcase TC() runs on C {
        var R v_r := { a := 1 };
        var integer v_i := -v_r.a + 2;
        if (isbound(v_r.a) and ispresent(v_r.a) == (v_i > 0)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
