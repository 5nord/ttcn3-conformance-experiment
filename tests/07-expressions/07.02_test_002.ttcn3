// @requirement: 7.2 -- Elements of record of, set of, array and string types are referenced with the index notation "[index]".
// @id: TTCN3-CORE-7.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_02_test_002 {

    type component C {}

    type record of integer RoI;
    type set of integer SoI;

    testcase TC() runs on C {
        var RoI v_ro := { 1, 2, 3 };
        var SoI v_so := { 4, 5 };
        var integer v_arr[2] := { 6, 7 };
        var charstring v_str := "abc";
        if (v_ro[1] == 2 and v_so[0] == 4 and v_arr[1] == 7 and v_str[2] == "c") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
