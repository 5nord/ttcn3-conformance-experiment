// @requirement: 7.1.5 -- The bitwise xor4b operator accepts two operands of equal length.
// @id: TTCN3-CORE-7.1.5-024a
// @verdict: pass reject
module M_07_01_05_test_010 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_r := '3915'O xor4b '15'O; // error: operands of different length
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
