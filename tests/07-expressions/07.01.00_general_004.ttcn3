// @requirement: 7.1.0 -- If more than one operator of equal precedence appears in an expression, the operations are evaluated from left to right.
// @id: TTCN3-CORE-7.1.0-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_general_004 {

    type component C {}

    testcase TC() runs on C {
        if (100 / 10 / 2 == 5 and 10 - 3 - 2 == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
