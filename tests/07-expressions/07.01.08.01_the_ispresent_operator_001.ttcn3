// @requirement: 7.1.8.1 -- ispresent "(" TemplateInstance ")"
// @id: TTCN3-CORE-7.1.8.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_01_the_ispresent_operator_001 {

    type record R { integer f1 optional, integer f2 optional }

    type component C {}

    template R m_r(template integer p_f1) := { f1 := p_f1, f2 := omit };

    testcase TC() runs on C {
        var R v_r := { f1 := 1, f2 := omit };
        var template R v_t := { f1 := ?, f2 := * };
        if (ispresent(v_r.f1) and ispresent(v_t.f1) and ispresent(m_r(5).f1) and
            not ispresent(m_r(5).f2) and ispresent(integer:1)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
