// @requirement: 7.3 -- In case the ReferencedValue is of the universal charstring type and the extended syntax with parentheses is used, the Type can be followed by an optional parameter defining the encoding format.
// @id: TTCN3-CORE-7.3-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_03_test_005 {

    type component C {}

    type record R {
        integer f1,
        charstring f2
    }

    testcase TC() runs on C {
        var R v_rec := { f1 := 7, f2 := "abc" };
        var universal charstring v_uc := encvalue_unichar(v_rec, "UTF-16");
        var R v_dec := v_uc => (R, "UTF-16");
        if (v_dec == v_rec) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
