// @requirement: 7.1.3 -- The address type is allowed for the equality (==) and non-equality (!=) operators, independent of its actual type, but when its actual type differs from the types specified above, it can be compared to the literal special value null only.
// @id: TTCN3-CORE-7.1.3-005b
// @verdict: pass reject
module M_07_01_03_test_005 {

    type function F_t();
    type F_t address;

    function f_a() {}

    type component C {}

    testcase TC() runs on C {
        var address v_a := refers(f_a);
        var address v_b := refers(f_a);
        if (v_a == v_b) { // error: address of a type without equality compared to non-null
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
