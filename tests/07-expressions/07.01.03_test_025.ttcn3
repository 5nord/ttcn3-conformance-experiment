// @requirement: 7.1.3 -- Two charstring or two universal charstring values are equal if and only if they have equal lengths and the characters at all positions are the same.
// @id: TTCN3-CORE-7.1.3-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_025 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_a := "abc";
        var charstring v_b := "abc";
        var universal charstring v_u1 := "ab" & char(0, 0, 1, 113);
        var universal charstring v_u2 := "ab" & char(0, 0, 1, 113);
        var universal charstring v_u3 := "ab" & char(0, 0, 1, 114);
        if (v_a == v_b and v_a != "abd" and v_a != "abcd" and v_a != "ab" and v_u1 == v_u2 and v_u1 != v_u3 and v_u1 != "ab") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
