// @requirement: 7.1.6 -- Their right-hand operand shall be a non-negative` integer.
// @id: TTCN3-CORE-7.1.6-003a
// @verdict: pass reject
module M_07_01_06_shift_operators_002 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '1010'B;
        var bitstring v_r := v_b << -1; // error: negative right-hand operand
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
