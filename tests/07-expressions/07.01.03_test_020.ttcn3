// @requirement: 7.1.3 -- Otherwise, normal mathematical ordering is applied. Two floating-point numbers are equal if and only if they contain the same value.
// @id: TTCN3-CORE-7.1.3-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_020 {

    type component C {}

    testcase TC() runs on C {
        var float v_a := -1.5;
        var float v_b := 2.5;
        var float v_c := 2.4999;
        if (v_a < v_b and v_c < v_b and v_b > v_c and v_b >= v_b and v_a <= v_c and not (v_b < v_c)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
