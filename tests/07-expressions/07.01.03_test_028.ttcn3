// @requirement: 7.1.3 -- Two record of values, set of values or array values, respectively, are equal if and only if they are mutually compatible with the type of the other operand (see clause 6.3.2.3), they both have the same length, and each element of one value is equal to the corresponding element of the other value.
// @id: TTCN3-CORE-7.1.3-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_028 {

    type component C {}

    type record of integer RoI1;
    type record of integer RoI2;

    testcase TC() runs on C {
        var RoI1 v_r1 := { 1, 2, 3 };
        var RoI2 v_r2a := { 1, 2, 3 };
        var RoI2 v_r2b := { 1, 2 };
        var RoI2 v_r2c := { 1, 2, 4 };
        var integer v_a1[3] := { 1, 2, 3 };
        var integer v_a2[3] := { 1, 2, 3 };
        var integer v_a3[3] := { 1, 0, 3 };
        if (v_r1 == v_r2a and v_r1 != v_r2b and v_r1 != v_r2c and
            v_a1 == v_a2 and v_a1 != v_a3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
