// @requirement: 7.1.4 -- Their operands shall be of root type boolean.
// @id: TTCN3-CORE-7.1.4-002a
// @verdict: pass reject
module M_07_01_04_logical_operators_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        var boolean v_b := v_i and true; // error: operand not of root type boolean
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
