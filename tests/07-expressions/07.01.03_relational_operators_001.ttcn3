// @requirement: 7.1.3 -- The result type of all these operations is boolean.
// @id: TTCN3-CORE-7.1.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_relational_operators_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_x := 1;
        var integer v_y := 2;
        var boolean v_r1 := v_x == v_y;
        var boolean v_r2 := v_x < v_y;
        var boolean v_r3 := v_x > v_y;
        var boolean v_r4 := v_x != v_y;
        var boolean v_r5 := v_x >= v_y;
        var boolean v_r6 := v_x <= v_y;
        if (not v_r1 and v_r2 and not v_r3 and v_r4 and not v_r5 and v_r6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
