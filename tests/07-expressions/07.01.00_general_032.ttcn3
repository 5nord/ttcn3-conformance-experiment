// @requirement: 7.1.0 -- Category: Presence checking operators; Operator: field presence check; Symbol or Keyword: ispresent
// @id: TTCN3-CORE-7.1.0-045a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_general_032 {

    type component C {}

    type record R {
        integer a optional
    }

    testcase TC() runs on C {
        var R v_r := { a := 1 };
        if (ispresent(v_r.a)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
