// @requirement: 7.1.6 -- a) `bitstring then the shift unit applied is 1 bit;` b) `hexstring then the shift unit applied is 1 hexadecimal digit;` c) `octetstring then the shift unit applied is 1 octet.` If the type of the left-hand operand is:
// @id: TTCN3-CORE-7.1.6-007b
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_06_shift_operators_005 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_h := '1234'H;
        if ((v_h << 1) == '2340'H and (v_h >> 1) == '0123'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
