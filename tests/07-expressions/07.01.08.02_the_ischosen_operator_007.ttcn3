// @requirement: 7.1.8.2 -- The result is false if there is another alternative of the union type or anytype on which ischosen would return true.
// @id: TTCN3-CORE-7.1.8.2-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_02_the_ischosen_operator_007 {

    type union U { integer f1, octetstring f2 }

    type component C {}

    template U m_u4 := ({ f1 := 2 }, { f2 := 'AB'O });

    testcase TC() runs on C {
        if (not ischosen(m_u4.f1) and not ischosen(m_u4.f2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
