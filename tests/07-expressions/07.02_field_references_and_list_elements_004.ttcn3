// @requirement: 7.2 -- Field references and list elements are evaluated from left to right.
// @id: TTCN3-CORE-7.2-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_02_field_references_and_list_elements_004 {

    type component C {}

    type record of integer RoI;
    type record of RoI RoRoI;

    type record R {
        RoRoI a
    }

    testcase TC() runs on C {
        var R v_rec := { a := { { 1, 2 }, { 3, 4 } } };
        if (v_rec.a[0][1] == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
