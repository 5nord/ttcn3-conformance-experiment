// @requirement: 7.1.0 -- Lowest Binary **xor**
// @id: TTCN3-CORE-7.1.0-053a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_test_050 {

    type component C {}

    testcase TC() runs on C {
        var boolean v_a := true;
        var boolean v_b := false;
        var boolean v_c := true;
        var boolean v_r := v_a or v_b xor v_c;
        if (v_r == true) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
