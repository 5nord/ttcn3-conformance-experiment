// @requirement: 7.1.7 -- Excess shift units (bits, hexadecimal digits, octets, characters, or elements) are re-inserted into the left-hand operand from its right-hand side.
// @id: TTCN3-CORE-7.1.7-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_07_test_012 {

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '110000'B;
        var hexstring v_h := 'AB000'H;
        var octetstring v_o := 'FF0000'O;
        var charstring v_c := "xy---";
        var RoI v_r := { 7, 0, 0 };
        if (v_b <@ 2 == '000011'B and v_h <@ 2 == '000AB'H and v_o <@ 1 == '0000FF'O and
            v_c <@ 2 == "---xy" and v_r <@ 1 == { 0, 0, 7 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
