// @requirement: 7.1.0 -- Category: String operators; Operator: concatenation; Symbol or Keyword: &
// @id: TTCN3-CORE-7.1.0-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_test_013 {

    type component C {}

    testcase TC() runs on C {
        if ("ab" & "cd" == "abcd") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
