// @requirement: 7.2 -- Dot and brackets have the same binding power.
// @id: TTCN3-CORE-7.2-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_02_field_references_and_list_elements_003 {

    type component C {}

    type record Inner {
        integer x
    }

    type record of Inner InnerList;

    type record Outer {
        InnerList list
    }

    type record of Outer OuterList;

    testcase TC() runs on C {
        var OuterList v_ol := {
            { list := { { x := 1 }, { x := 2 } } },
            { list := { { x := 3 }, { x := 4 } } }
        };
        if (v_ol[1].list[0].x == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
