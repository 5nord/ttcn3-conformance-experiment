// @requirement: 7.1.5 -- For each corresponding bit position, the resulting value is 0 if both bits are set to 0, otherwise the value for the resulting bit is 1. That is:
// @id: TTCN3-CORE-7.1.5-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_05_test_009 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_1 := '1'B;
        var bitstring v_0 := '0'B;
        var bitstring v_b := '1001'B;
        var hexstring v_h := '9'H;
        var octetstring v_o := 'A9'O;
        if ((v_1 or4b v_1) == '1'B and (v_1 or4b v_0) == '1'B and
            (v_0 or4b v_1) == '1'B and (v_0 or4b v_0) == '0'B and
            (v_b or4b '0101'B) == '1101'B and (v_h or4b '5'H) == 'D'H and
            (v_o or4b 'F5'O) == 'FD'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
