// @requirement: 7.1.0 -- Unary **ispresent, ischosen, isvalue, isbound** Unary **+, -** Binary ***, /, mod, rem** Binary **+, -, &** Unary **not4b** Binary **and4b** Binary **xor4b** Binary **or4b** Binary **<<, >>, <@, @>** Binary **<, >, <=, >=** Binary **==, !=** Unary **not** Binary **and**
// @id: TTCN3-CORE-7.1.0-052h
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_test_044 {

    type component C {}

    testcase TC() runs on C {
        if ('0001'B or4b '0010'B << 1 == '0110'B and '1000'B or4b '0001'B <@ 1 == '0011'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
