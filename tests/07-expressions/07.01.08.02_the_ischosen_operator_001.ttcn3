// @requirement: 7.1.8.2 -- ischosen "(" TemplateInstance ")"
// @id: TTCN3-CORE-7.1.8.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_02_the_ischosen_operator_001 {

    type union U { integer f1, octetstring f2 }

    type component C {}

    template U m_u := { f1 := 1 };

    testcase TC() runs on C {
        var U v_u := { f1 := 1 };
        var template U v_t := { f2 := ? };
        if (ischosen(v_u.f1) and ischosen(v_t.f2) and ischosen(m_u.f1)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
