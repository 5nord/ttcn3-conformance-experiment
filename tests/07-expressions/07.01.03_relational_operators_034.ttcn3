// @requirement: 7.1.3 -- For anytype values the same rule apply as to union values, with the addition that names of user-defined types defined with the same name in different modules do not denote the same type name of the selected alternatives.
// @id: TTCN3-CORE-7.1.3-033a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_relational_operators_034 {

    type component C {}

    type integer MyInt;

    testcase TC() runs on C {
        var anytype v_a := { integer := 1 };
        var anytype v_same := { integer := 1 };
        var anytype v_otherName := { MyInt := 1 };
        var anytype v_otherValue := { integer := 2 };
        if (v_a == v_same and v_a != v_otherName and v_a != v_otherValue) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
