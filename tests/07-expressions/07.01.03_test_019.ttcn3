// @requirement: 7.1.3 -- The values minus zero and plus zero are two distinct values (e.g. they are encoded differently in some standardized languages) and minus zero is less than plus zero, which represents zero.
// @id: TTCN3-CORE-7.1.3-019b
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_019 {

    type component C {}

    testcase TC() runs on C {
        var float v_pz := 0.0;
        var float v_mz := -0.0;
        if (v_mz < v_pz and v_pz > v_mz) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
