// @requirement: 7.1.2 -- NOTE 2: It is also possible to concatenate two or more value list notation expressions if the result is to be used as a record of or array of the same root type as the concatenated expressions.
// @id: TTCN3-CORE-7.1.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_02_list_operator_007 {

    type record of integer RI;

    type component C {}

    testcase TC() runs on C {
        var RI v_r := { 1, 2 } & { 3, 4 } & { 5, 6 };
        var integer v_a[4] := { 1, 2 } & { 3, 4 };
        if (v_r == { 1, 2, 3, 4, 5, 6 } and v_a == { 1, 2, 3, 4 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
