// @requirement: 7.1.3 -- The special value infinity is greater than any numerical float values and -infinity.
// @id: TTCN3-CORE-7.1.3-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_023 {

    type component C {}

    testcase TC() runs on C {
        var float v_inf := infinity;
        if (v_inf > 1.0E300 and v_inf > 0.0 and v_inf > -1.0E300 and v_inf > -infinity) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
