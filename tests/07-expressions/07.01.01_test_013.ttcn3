// @requirement: 7.1.1 -- Therefore, they are only defined for non-zero operands y.
// @id: TTCN3-CORE-7.1.1-014a
// @verdict: pass accept, ttcn3verdict:error
module M_07_01_01_test_013 {

    type component C {}

    testcase TC() runs on C {
        var integer v_x := 5;
        var integer v_y := 0;
        var integer v_r;
        setverdict(pass);
        v_r := v_x rem v_y; // error: zero right operand
        v_r := v_x mod v_y;
    }

    control {
        execute(TC());
    }
}
