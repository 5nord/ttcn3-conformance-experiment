// @requirement: 7.1.5 -- These operators are known as not4b, and4b, or4b and xor4b respectively.
// @id: TTCN3-CORE-7.1.5-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_05_bitwise_operators_001 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_x := '1001'B;
        var bitstring v_y := '0101'B;
        if (not4b v_x == '0110'B and (v_x and4b v_y) == '0001'B and
            (v_x or4b v_y) == '1101'B and (v_x xor4b v_y) == '1100'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
