// @requirement: 7.1.2 -- The predefined list operator (&) performs concatenation of values of string types, record of, set of, or array of the same root types.
// @id: TTCN3-CORE-7.1.2-001b
// @verdict: pass reject
module M_07_01_02_test_002 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_c := "ab";
        var bitstring v_b := '01'B;
        var charstring v_r := v_c & v_b; // error: operands of different root types
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
