// @requirement: 7.1.1 -- **x** **-3** **-2** **-1** **0** **1** **2** **3** **x mod 3** 0 1 2 0 1 2 0
// @id: TTCN3-CORE-7.1.1-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_01_test_019 {

    type record of integer RI;

    type component C {}

    testcase TC() runs on C {
        var RI v_x := { -3, -2, -1, 0, 1, 2, 3 };
        var RI v_exp := { 0, 1, 2, 0, 1, 2, 0 };
        setverdict(pass);
        for (var integer i := 0; i < lengthof(v_x); i := i + 1) {
            if (v_x[i] mod 3 != v_exp[i]) {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
