// @requirement: 7.1.1 -- With float types, the result type of arithmetic operations is float.
// @id: TTCN3-CORE-7.1.1-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_01_arithmetic_operators_005 {

    type component C {}

    testcase TC() runs on C {
        var float v_a := 1.5;
        var float v_b := 2.0;
        var float v_r := v_a + v_b * v_a - v_a / v_b;
        if (v_r == 3.75) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
