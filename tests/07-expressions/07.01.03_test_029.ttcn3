// @requirement: 7.1.3 -- Record of values and array values may also be compared, in which case the corresponding record of type of the array is being considered.
// @id: TTCN3-CORE-7.1.3-029a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_029 {

    type component C {}

    type record of integer RoI;

    testcase TC() runs on C {
        var RoI v_r := { 1, 2, 3 };
        var integer v_a[3] := { 1, 2, 3 };
        var integer v_b[3] := { 1, 2, 4 };
        if (v_r == v_a and v_r != v_b) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
