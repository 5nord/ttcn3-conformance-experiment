// @requirement: 7.1.1 -- With integer types, the result type of arithmetic operations is integer.
// @id: TTCN3-CORE-7.1.1-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_01_test_004 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a := 7;
        var integer v_b := 2;
        var integer v_r := v_a + v_b * v_a - v_a / v_b;
        if (v_r == 18) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
