// @requirement: 7.3 -- Any other value shall cause an error. The parameter shall be of the charstring type and it shall contain one of the strings allowed for the decvalue_unichar function (specified in clause C.5.4).
// @id: TTCN3-CORE-7.3-010a
// @verdict: pass accept, ttcn3verdict:error
module M_07_03_test_008 {

    type component C {}

    type record R {
        integer f1
    }

    testcase TC() runs on C {
        var R v_rec := { f1 := 7 };
        var universal charstring v_uc := encvalue_unichar(v_rec);
        var charstring v_format := "UTF-9";
        var R v_dec;
        setverdict(pass);
        v_dec := v_uc => (R, v_format); // error: not an allowed encoding format
        setverdict(fail);
    }

    control {
        execute(TC());
    }
}
