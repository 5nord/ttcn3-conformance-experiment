// @requirement: 7.1.1 -- x rem y = x - y * (x/y) x mod y = x rem |y| when x >= 0 = 0 when x < 0 and x rem |y| = 0 = |y| + x rem |y| when x < 0 and x rem |y| < 0
// @id: TTCN3-CORE-7.1.1-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_01_test_015 {

    type component C {}

    testcase TC() runs on C {
        var integer v_x := 7;
        var integer v_y := 3;
        if (v_x rem v_y == v_x - v_y * (v_x / v_y) and
            (-v_x) rem v_y == -v_x - v_y * (-v_x / v_y) and
            v_x rem (-v_y) == v_x - (-v_y) * (v_x / (-v_y)) and
            (-v_x) rem (-v_y) == -v_x - (-v_y) * (-v_x / (-v_y)) and
            (-v_x) rem v_y == -1 and v_x rem (-v_y) == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
