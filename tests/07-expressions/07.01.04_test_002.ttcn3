// @requirement: 7.1.4 -- The result type of logical operations is boolean.
// @id: TTCN3-CORE-7.1.4-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_04_test_002 {

    type component C {}

    type boolean MyBool;

    testcase TC() runs on C {
        var MyBool v_x := true;
        var MyBool v_y := false;
        var boolean v_not := not v_x;
        var boolean v_and := v_x and v_y;
        var boolean v_or := v_x or v_y;
        var boolean v_xor := v_x xor v_y;
        if (not v_not and not v_and and v_or and v_xor) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
