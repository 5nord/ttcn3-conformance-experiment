// @requirement: 7.1.7 -- Their right-hand operand shall be a non-negative integer.
// @id: TTCN3-CORE-7.1.7-003a
// @verdict: pass reject
module M_07_01_07_test_002 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '101001'B;
        var bitstring v_res := v_b <@ -2; // error: negative right-hand operand
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
