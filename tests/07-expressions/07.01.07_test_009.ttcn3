// @requirement: 7.1.7 -- a) `bitstring then the rotate unit applied is 1 bit;` b) `hexstring then the rotate unit applied is 1 hexadecimal digit;` c) `octetstring then the rotate unit applied is 1 octet;` d) `charstring or universal` `charstring then the rotate unit applied is one character;` e) `record of, set of, or array then the rotate unit applied is one element.` If the type of the left-hand operand is:
// @id: TTCN3-CORE-7.1.7-008e
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_07_test_009 {

    type record of charstring RoC;
    type set of integer SoI;

    type component C {}

    testcase TC() runs on C {
        var RoC v_r := { "ab", "cd", "ef" };
        var SoI v_s := { 1, 2, 3 };
        var integer v_a[3] := { 1, 2, 3 };
        var RoC v_resR := v_r <@ 1;
        var SoI v_resS := v_s @> 1;
        var integer v_resA[3] := v_a <@ 2;
        if (v_resR[0] == "cd" and v_resR[1] == "ef" and v_resR[2] == "ab" and
            v_resS[0] == 3 and v_resS[1] == 1 and v_resS[2] == 2 and
            v_resA[0] == 3 and v_resA[1] == 1 and v_resA[2] == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
