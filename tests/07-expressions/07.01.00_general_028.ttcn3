// @requirement: 7.1.0 -- Category: Shift operators; Operator: shift left; Symbol or Keyword: <<
// @id: TTCN3-CORE-7.1.0-041a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_general_028 {

    type component C {}

    testcase TC() runs on C {
        if (('0011'B << 1) == '0110'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
