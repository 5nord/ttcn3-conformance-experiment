// @requirement: 7.1.8.2 -- In case of a value list, the operator returns true if all data objects present in the value list have the given alternative selected.
// @id: TTCN3-CORE-7.1.8.2-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_02_test_006 {

    type union U { integer f1, octetstring f2 }

    type component C {}

    template U mw_u5 := ({ f2 := '12?'O }, { f2 := '*34'O length(2) });

    testcase TC() runs on C {
        if (ischosen(mw_u5.f2) and not ischosen(mw_u5.f1)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
