// @requirement: 7.1.1 -- The operations x rem y and x mod y compute the rest that remains from an integer division of x by y.
// @id: TTCN3-CORE-7.1.1-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_01_arithmetic_operators_012 {

    type component C {}

    testcase TC() runs on C {
        var integer v_x := 8;
        var integer v_y := 5;
        if (v_x rem v_y == 3 and v_x mod v_y == 3 and 10 rem v_y == 0 and 10 mod v_y == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
