// @requirement: 7.1.4 -- In the case of the or operator, if the left argument evaluates to true, then the right argument is not evaluated and the whole expression evaluates to true.
// @id: TTCN3-CORE-7.1.4-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_04_test_009 {

    type component C {}

    testcase TC() runs on C {
        var integer v_arr[2] := { 1, 2 };
        var integer v_i := 5;
        // evaluating v_arr[v_i] would cause an index overflow error
        if (v_i >= 2 or v_arr[v_i] == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
