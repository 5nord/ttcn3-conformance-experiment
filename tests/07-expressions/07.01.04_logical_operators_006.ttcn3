// @requirement: 7.1.4 -- The logical xor returns the value true if one of its operands is true; it returns the value false if both operands are false or if both operands are true.
// @id: TTCN3-CORE-7.1.4-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_04_logical_operators_006 {

    type component C {}

    testcase TC() runs on C {
        var boolean v_t := true;
        var boolean v_f := false;
        if ((v_t xor v_t) == false and (v_t xor v_f) == true and
            (v_f xor v_t) == true and (v_f xor v_f) == false) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
