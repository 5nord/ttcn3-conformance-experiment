// @requirement: 7.1.3 -- The special values -infinity, `infinity and not_a_number are equal to themselves only.
// @id: TTCN3-CORE-7.1.3-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_021 {

    type component C {}

    testcase TC() runs on C {
        var float v_inf := infinity;
        var float v_minf := -infinity;
        var float v_nan := not_a_number;
        if (v_inf == infinity and v_minf == -infinity and v_nan == not_a_number and v_inf != v_minf and v_inf != v_nan and v_minf != v_nan and v_inf != 1.0E300 and v_minf != -1.0E300 and v_nan != 0.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
