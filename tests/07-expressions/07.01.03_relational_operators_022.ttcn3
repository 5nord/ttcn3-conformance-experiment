// @requirement: 7.1.3 -- The special` value -infinity is less than any other float value.
// @id: TTCN3-CORE-7.1.3-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_relational_operators_022 {

    type component C {}

    testcase TC() runs on C {
        var float v_minf := -infinity;
        if (v_minf < -1.0E300 and v_minf < 0.0 and v_minf < -0.0 and v_minf < infinity and v_minf < not_a_number) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
