// @requirement: 7.0 -- This means also that all fields and elements of structured types referenced in an expression shall contain completely initialized values, while other fields and elements, not used in the expression, may be uninitialized or contain omit.
// @id: TTCN3-CORE-7.0-013b
// @verdict: pass accept, ttcn3verdict:pass
module M_07_00_test_014 {

    type component C {}

    type record R {
        integer a,
        integer b,
        integer c optional
    }

    testcase TC() runs on C {
        var R v_r;
        v_r.a := 1;
        v_r.c := omit;
        var integer v_i := v_r.a + 1;
        if (v_i == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
