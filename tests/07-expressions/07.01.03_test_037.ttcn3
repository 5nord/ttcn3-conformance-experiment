// @requirement: 7.1.3 -- It is also possible to use compound expressions (field assignment or value list notation) directly as operands of comparison operations of structured types.
// @id: TTCN3-CORE-7.1.3-035a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_037 {

    type component C {}

    type record R {
        integer a,
        integer b
    }

    testcase TC() runs on C {
        var R v_r := { a := 1, b := 2 };
        if (v_r == { a := 1, b := 2 } and { 1, 2 } == v_r) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
