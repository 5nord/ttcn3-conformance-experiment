// @requirement: 7.1.1 -- a) `integer values gives the whole integer part of the value resulting from dividing the first integer by` the second (i.e. fractions are discarded);
// @id: TTCN3-CORE-7.1.1-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_01_test_009 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a := 7;
        var integer v_b := 2;
        if (v_a / v_b == 3 and -v_a / v_b == -3 and v_a / -v_b == -3 and 6 / v_b == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
