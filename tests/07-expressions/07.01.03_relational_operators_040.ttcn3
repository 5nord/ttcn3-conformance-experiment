// @requirement: 7.1.3 -- If there is a compound expression on both sides of the comparison operator, they shall both be value list notation expressions where the elements shall be of the same root type and they shall be compared like record of values with elements of that root type.
// @id: TTCN3-CORE-7.1.3-036c
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_relational_operators_040 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 2;
        if ({ 1, v_i, 3 } == { 1, 2, 3 } and { 1, v_i } != { 1, 2, 3 } and { 1, v_i, 3 } != { 1, 2, 4 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
