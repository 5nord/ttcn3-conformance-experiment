// @requirement: 7.1.7 -- Their left-hand operand shall be of root type bitstring, hexstring, octetstring, charstring, universal `charstring,` record of, or set of.
// @id: TTCN3-CORE-7.1.7-002a
// @verdict: pass reject
module M_07_01_07_test_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 12;
        var integer v_res := v_i <@ 1; // error: integer is not a permitted left-hand operand type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
