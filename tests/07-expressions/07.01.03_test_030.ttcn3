// @requirement: 7.1.3 -- Values of the same union type, and values of different union types in which at least one of the alternatives is compatible with the other type (see clause 6.3.2.4) can be compared (independent if a compatible alternative is the selected one or not).
// @id: TTCN3-CORE-7.1.3-030a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_030 {

    type component C {}

    type union U1 {
        integer d1,
        integer d2
    }

    type union U3 {
        integer d1,
        integer d2,
        boolean d3
    }

    testcase TC() runs on C {
        var U1 v_u1a := { d1 := 0 };
        var U1 v_u1b := { d2 := 0 };
        var U3 v_u3a := { d1 := 0 };
        var U3 v_u3b := { d3 := true };
        if (v_u1a != v_u1b and v_u1a == v_u3a and v_u1a != v_u3b) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
