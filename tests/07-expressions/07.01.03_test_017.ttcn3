// @requirement: 7.1.3 -- Two floating-point numbers are equal if and only if they contain the same value.
// @id: TTCN3-CORE-7.1.3-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_017 {

    type component C {}

    testcase TC() runs on C {
        var float v_a := 1.5;
        var float v_b := 1.5;
        var float v_c := 1.50001;
        var float v_d := 1.0E1;
        if (v_a == v_b and v_a != v_c and not (v_a == v_c) and v_d == 10.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
