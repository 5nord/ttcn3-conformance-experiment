// @requirement: 7.1.1 -- The operators rem and mod compute on operands of type integer and have a result of type integer.
// @id: TTCN3-CORE-7.1.1-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_01_test_011 {

    type component C {}

    testcase TC() runs on C {
        var integer v_x := 7;
        var integer v_y := 3;
        var integer v_r := v_x rem v_y;
        var integer v_m := v_x mod v_y;
        if (v_r == 1 and v_m == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
