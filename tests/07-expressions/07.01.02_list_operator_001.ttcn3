// @requirement: 7.1.2 -- The predefined list operator (&) performs concatenation of values of string types, record of, set of, or array of the same root types.
// @id: TTCN3-CORE-7.1.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_02_list_operator_001 {

    type record of integer RI;
    type set of integer SI;

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '01'B;
        var hexstring v_h := 'A'H;
        var octetstring v_o := 'FF'O;
        var charstring v_c := "ab";
        var universal charstring v_u := char(0, 0, 1, 113);
        var RI v_ri := { 1, 2 };
        var SI v_si := { 3 };
        var integer v_a1[2] := { 1, 2 };
        var integer v_a2[1] := { 3 };
        var integer v_ar[3] := v_a1 & v_a2;
        if (v_b & '10'B == '0110'B and v_h & 'B'H == 'AB'H and v_o & '00'O == 'FF00'O and
            v_c & "c" == "abc" and lengthof(v_u & v_u) == 2 and v_ri & { 3 } == { 1, 2, 3 } and
            v_si & v_si == { 3, 3 } and v_ar == { 1, 2, 3 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
