// @requirement: 7.1.3 -- If only one operand of the comparison operation is a compound expression it shall be compatible with the root type of the other operand and they shall be compared like values of that root type.
// @id: TTCN3-CORE-7.1.3-037b
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_relational_operators_042 {

    type component C {}

    type set S {
        integer a optional,
        integer b optional
    }

    type record of integer RoI;

    testcase TC() runs on C {
        var S v_s := { a := 1, b := omit };
        var RoI v_r := { 1, 2 };
        if (v_s == { b := omit, a := 1 } and v_s != { a := 1, b := 2 } and
            v_r == { 1, 2 } and v_r != { 1, 2, 3 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
