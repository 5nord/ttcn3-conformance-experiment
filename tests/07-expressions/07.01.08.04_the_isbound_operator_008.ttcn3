// @id: TTCN3-CORE-7.1.8.4-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_04_the_isbound_operator_008 {

    type component C {}

    testcase TC() runs on C {
        var default v_default := null;
        var C v_comp := null;
        if (isbound(v_default) and isbound(v_comp)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
