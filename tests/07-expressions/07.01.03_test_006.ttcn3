// @requirement: 7.1.3 -- Operands of equality (==) and non-equality (!=) shall be completely initialized values or field references, and with the exception of enumerated types, shall be of compatible root types.
// @id: TTCN3-CORE-7.1.3-006a
// @verdict: pass accept, ttcn3verdict:error
module M_07_01_03_test_006 {

    type record of integer RI;

    type component C {}

    testcase TC() runs on C {
        var RI v_a := { 0, -, 2 };
        var RI v_b := { 0, 1, 2 };
        setverdict(pass);
        if (v_a == v_b) { // error: v_a is not completely initialized
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
