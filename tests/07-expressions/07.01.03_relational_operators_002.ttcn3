// @requirement: 7.1.3 -- The relational operators less than (<), greater than (>), greater than or equal to (>=), and less than or equal to (<=) shall have only operands of type integer (including derivations of integer), float (including derivations of float), or instances of the same enumerated type.
// @id: TTCN3-CORE-7.1.3-003a
// @verdict: pass reject
module M_07_01_03_relational_operators_002 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_a := "a";
        var charstring v_b := "b";
        if (v_a < v_b) { // error: charstring operands of <
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
