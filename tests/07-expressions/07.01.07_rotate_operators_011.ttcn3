// @requirement: 7.1.7 -- It rotates the left-hand operand by the number of shift units to the left as specified by the right-hand operand.
// @id: TTCN3-CORE-7.1.7-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_07_rotate_operators_011 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '101001'B;
        var hexstring v_h := '12345'H;
        var octetstring v_o := '1122334455'O;
        var charstring v_c := "abcdefg";
        if (v_b <@ 2 == '100110'B and v_h <@ 2 == '34512'H and
            v_o <@ (1 + 2) == '4455112233'O and v_c <@ 3 == "defgabc" and
            v_c <@ 0 == "abcdefg") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
