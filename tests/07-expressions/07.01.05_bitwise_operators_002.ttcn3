// @requirement: 7.1.5 -- Their operands shall be of root type `bitstring, hexstring or octetstring.
// @id: TTCN3-CORE-7.1.5-004a
// @verdict: pass reject
module M_07_01_05_bitwise_operators_002 {

    type component C {}

    testcase TC() runs on C {
