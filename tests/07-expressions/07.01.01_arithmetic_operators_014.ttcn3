// @requirement: 7.1.1 -- For positive x and y, both x `rem` `y and x` `mod` `y have the same result but for` negative arguments they differ.
// @id: TTCN3-CORE-7.1.1-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_01_arithmetic_operators_014 {

    type component C {}

    testcase TC() runs on C {
        var integer v_x := 7;
        var integer v_y := 3;
        if (v_x rem v_y == v_x mod v_y and (-v_x) rem v_y != (-v_x) mod v_y) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
