// @requirement: 7.1.8.4 -- set type, omitted optional fields shall be considered as initialized, i.e. the operator shall also yield true if at least one If the operand is of a record or optional field of the operand is set to omit.
// @id: TTCN3-CORE-7.1.8.4-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_04_test_004 {

    type component C {}

    type set S {
        integer f1,
        integer f2 optional,
        integer f3 optional
    }

    testcase TC() runs on C {
        var S v_set;
        var template S v_setT;
        v_set.f3 := omit;
        v_setT.f2 := omit;
        if (isbound(v_set) and isbound(v_setT)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
