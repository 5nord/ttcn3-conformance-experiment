// @requirement: 7.1.0 -- Category: Bitwise operators; Operator: bitwise not; Symbol or Keyword: not4b
// @id: TTCN3-CORE-7.1.0-037a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_test_024 {

    type component C {}

    testcase TC() runs on C {
        if (not4b '1010'B == '0101'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
