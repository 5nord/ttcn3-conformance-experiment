// @requirement: 7.1.0 -- Category: Rotate operators; Operator: rotate left; Symbol or Keyword: <@
// @id: TTCN3-CORE-7.1.0-043a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_general_030 {

    type component C {}

    testcase TC() runs on C {
        if (('1001'B <@ 1) == '0011'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
