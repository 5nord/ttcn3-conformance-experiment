// @requirement: 7.1.3 -- The special value not_a_number is greater than any other float value (including infinity).
// @id: TTCN3-CORE-7.1.3-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_024 {

    type component C {}

    testcase TC() runs on C {
        var float v_nan := not_a_number;
        if (v_nan > infinity and v_nan > -infinity and v_nan > 1.0E300 and v_nan > 0.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
