// @requirement: 7.0 -- SingleExpression | "{" { ( FieldReference ":=" ( Expression | "-" )) [","] } "}" | // compound expression "{" [ { ( Expression | "-" ) [","] } ] "}" // compound expression
// @id: TTCN3-CORE-7.0-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_00_test_004 {

    type component C {}

    type record R {
        integer a,
        boolean b
    }

    type record of integer RoI;

    testcase TC() runs on C {
        var integer v_i := (1 + 2) * 3;
        var R v_r := { a := 1, b := true };
        var RoI v_l := { 1, 2, 3 };
        v_r := { a := 2, b := - };
        v_l := { -, 5 };
        if (v_i == 9 and v_r == { 2, true } and v_l == { 1, 5, 3 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
