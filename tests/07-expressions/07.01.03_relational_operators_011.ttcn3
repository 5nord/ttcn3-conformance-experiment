// @requirement: 7.1.3 -- A field reference is equal to a value if the referenced field is initialized with a value and both values are equal.
// @id: TTCN3-CORE-7.1.3-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_relational_operators_011 {

    type set S1 {
        integer a1 optional,
        integer a2 optional,
        integer a3 optional
    }
    type set S2 {
        integer b1 optional,
        integer b2 optional,
        integer b3 optional
    }

    type component C {}

    testcase TC() runs on C {
        var S1 v_s1 := { a1 := 0, a2 := omit, a3 := 2 };
        if (v_s1.a1 == 0 and v_s1.a3 != 3 and not (v_s1.a2 == 3)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
