// @requirement: 7.1.1 -- b) numeric float values gives the float value resulting from dividing the first float by the second (i.e. fractions are not discarded).
// @id: TTCN3-CORE-7.1.1-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_01_arithmetic_operators_010 {

    type component C {}

    testcase TC() runs on C {
        var float v_a := 7.0;
        var float v_b := 2.0;
        if (v_a / v_b == 3.5 and -v_a / v_b == -3.5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
