// @requirement: 7.1.0 -- Binary **or**
// @id: TTCN3-CORE-7.1.0-054a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_general_051 {

    type component C {}

    testcase TC() runs on C {
        var boolean v_t := true;
        var boolean v_f := false;
        var integer v_x := 1;
        var boolean v_r1 := v_t or v_f and v_f;
        var boolean v_r2 := v_t or v_f xor v_t;
        var boolean v_r3 := v_f or not v_f;
        var boolean v_r4 := v_x == 2 or v_x < 2;
        if (v_r1 and v_r2 and v_r3 and v_r4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
