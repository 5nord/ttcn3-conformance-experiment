// @requirement: 7.1.4 -- The logical and returns the value true if both its operands are true; otherwise it returns the value false.
// @id: TTCN3-CORE-7.1.4-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_04_logical_operators_004 {

    type component C {}

    testcase TC() runs on C {
        var boolean v_t := true;
        var boolean v_f := false;
        if ((v_t and v_t) == true and (v_t and v_f) == false and
            (v_f and v_t) == false and (v_f and v_f) == false) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
