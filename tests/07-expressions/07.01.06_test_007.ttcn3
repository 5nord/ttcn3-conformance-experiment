// @requirement: 7.1.6 -- It shifts the left-hand operand by the number of shift units to the left as specified by the right-hand operand.
// @id: TTCN3-CORE-7.1.6-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_06_test_007 {

    type component C {}

    testcase TC() runs on C {
        var integer v_n := 2;
        var bitstring v_b := '111001'B;
        var hexstring v_h := '12345'H;
        var octetstring v_o := '1122334455'O;
        if ((v_b << v_n) == '100100'B and (v_h << v_n) == '34500'H and
            (v_o << (1 + 1)) == '3344550000'O and (v_b << 0) == '111001'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
