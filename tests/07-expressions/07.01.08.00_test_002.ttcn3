// @requirement: 7.1.8.0 -- The operand of these operators can be of any type.
// @id: TTCN3-CORE-7.1.8.0-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_00_test_002 {

    type record R { integer f1, charstring f2 optional }
    type record of float RoF;
    type enumerated E { e_a, e_b }

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        var float v_f := 1.0;
        var boolean v_b := true;
        var verdicttype v_vt := pass;
        var E v_e := e_b;
        var R v_r := { f1 := 1, f2 := omit };
        var RoF v_l := { 1.0 };
        var C v_comp := self;
        if (isbound(v_i) and isbound(v_f) and isbound(v_b) and isbound(v_vt) and
            isbound(v_e) and isbound(v_r) and isbound(v_l) and isbound(v_comp) and
            isvalue(v_i) and isvalue(v_e) and isvalue(v_r) and isvalue(v_l) and
            ispresent(v_r.f1) and not ispresent(v_r.f2) and ispresent(v_l[0])) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
