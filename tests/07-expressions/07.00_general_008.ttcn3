// @requirement: 7.0 -- The operands of the operators used in an expression shall be values and their root types shall be the types specified for the appropriate operator in the subsequent clauses.
// @id: TTCN3-CORE-7.0-007b
// @verdict: pass reject
module M_07_00_general_008 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1 + true; // error: boolean operand of arithmetic operator
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
