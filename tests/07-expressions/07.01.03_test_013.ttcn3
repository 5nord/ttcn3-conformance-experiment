// @requirement: 7.1.3 -- Otherwise, normal mathematical ordering is applied. Two integer values are equal if and only if they contain the same value.
// @id: TTCN3-CORE-7.1.3-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_013 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a := -3;
        var integer v_b := 2;
        var integer v_c := 100;
        if (v_a < v_b and v_b < v_c and v_c > v_a and v_b >= v_b and v_a <= v_b and not (v_c < v_b)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
