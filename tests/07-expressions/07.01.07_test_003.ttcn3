// @requirement: 7.1.7 -- The result type of these operators shall be the same as the root type of the left-hand operand.
// @id: TTCN3-CORE-7.1.7-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_07_test_003 {

    type bitstring MyBits length(6);
    type charstring MyChars length(7);
    type record length(3) of integer MyList;

    type component C {}

    testcase TC() runs on C {
        var MyBits v_b := '101001'B;
        var MyChars v_c := "abcdefg";
        var MyList v_l := { 1, 2, 3 };
        var bitstring v_resB := v_b <@ 2;
        var charstring v_resC := v_c @> 3;
        var record of integer v_resL := v_l <@ 1;
        if (v_resB == '100110'B and v_resC == "efgabcd" and v_resL == { 2, 3, 1 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
