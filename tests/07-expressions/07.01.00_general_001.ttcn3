// @requirement: 7.1.0 -- TTCN-3 supports a number of predefined operators that may be used in the terms of TTCN-3 expressions.
// @id: TTCN3-CORE-7.1.0-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_general_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 2 + 3 * 4 - 1;
        var boolean v_b := v_i > 10 and not (v_i == 0);
        if (v_i == 13 and v_b) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
