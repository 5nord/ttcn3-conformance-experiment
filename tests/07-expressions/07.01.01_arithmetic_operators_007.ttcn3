// @requirement: 7.1.1 -- The result of using the minus operator is the negative value of the operand if it was positive and vice versa.
// @id: TTCN3-CORE-7.1.1-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_01_arithmetic_operators_007 {

    type component C {}

    testcase TC() runs on C {
        var integer v_p := 5;
        var integer v_n := -5;
        var float v_fp := 2.5;
        var float v_fn := -2.5;
        if (-v_p == -5 and -v_n == 5 and -v_fp == -2.5 and -v_fn == 2.5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
