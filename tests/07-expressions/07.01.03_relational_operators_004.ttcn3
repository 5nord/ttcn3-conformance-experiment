// @requirement: 7.1.3 -- The address type is allowed for the equality (==) and non-equality (!=) operators, independent of its actual type, but when its actual type differs from the types specified above, it can be compared to the literal special value null only.
// @id: TTCN3-CORE-7.1.3-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_relational_operators_004 {

    type record address {
        charstring host,
        integer portNr
    }

    type component C {}

    testcase TC() runs on C {
        var address v_a := { host := "h", portNr := 1 };
        var address v_b := { host := "h", portNr := 1 };
        var address v_n := null;
        if (v_a == v_b and v_a != v_n and v_n == null and not (v_a == null)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
