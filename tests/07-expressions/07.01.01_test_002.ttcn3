// @requirement: 7.1.1 -- Operands of these operators shall be of integer values (including derivations of integer) or floating-point numbers (including derivations of float, containing numeric values only), except for mod and rem which shall be used with integer (including derivations of integer) types only.
// @id: TTCN3-CORE-7.1.1-002b
// @verdict: pass reject
module M_07_01_01_test_002 {

    type component C {}

    testcase TC() runs on C {
        var float v_f := 5.0 mod 2.0; // error: mod operands are not integer
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
