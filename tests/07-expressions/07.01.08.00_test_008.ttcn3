// @requirement: 7.1.8.0 -- The rule on special handling of dot notation, index notation and decoded field references is not applied recursively.
// @id: TTCN3-CORE-7.1.8.0-010a
// @verdict: pass accept, ttcn3verdict:error
module M_07_01_08_00_test_008 {

    type record of integer RoI;
    type record R { integer idx optional }

    type component C {}

    testcase TC() runs on C {
        var RoI v_l := { 1, 2 };
        var R v_r := { idx := omit };
        var boolean v_res := isbound(v_l[v_r.idx]); // error: omitted field used in a nested index expression
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
