// @requirement: 7.1.5 -- The bitwise or4b operator accepts two operands of equal length.
// @id: TTCN3-CORE-7.1.5-018a
// @verdict: pass reject
module M_07_01_05_test_008 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_r := '9A'H or4b '5'H; // error: operands of different length
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
