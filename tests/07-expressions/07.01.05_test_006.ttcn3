// @requirement: 7.1.5 -- The bitwise and4b operator accepts two operands of equal length.
// @id: TTCN3-CORE-7.1.5-012a
// @verdict: pass reject
module M_07_01_05_test_006 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_r := '1001'B and4b '01'B; // error: operands of different length
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
