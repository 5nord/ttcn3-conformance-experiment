// @requirement: 7.1.3 -- If only one operand of the comparison operation is a compound expression it shall be compatible with the root type of the other operand and they shall be compared like values of that root type.
// @id: TTCN3-CORE-7.1.3-037a
// @verdict: pass reject
module M_07_01_03_relational_operators_041 {

    type component C {}

    type record R {
        integer a,
        integer b
    }

    testcase TC() runs on C {
        var R v_r := { a := 1, b := 2 };
        if (v_r == { 1, "x" }) { // error: compound expression not compatible with R
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
