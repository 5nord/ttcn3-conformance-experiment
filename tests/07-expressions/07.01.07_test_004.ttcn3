// @requirement: 7.1.7 -- NOTE 1: Note that the root types of arrays is record of, therefore arrays are allowed as left-hand operands of rotate operators.
// @id: TTCN3-CORE-7.1.7-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_07_test_004 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a[3] := { 1, 2, 3 };
        var integer v_left[3] := v_a <@ 1;
        var integer v_right[3] := v_a @> 1;
        if (v_left[0] == 2 and v_left[1] == 3 and v_left[2] == 1 and
            v_right[0] == 3 and v_right[1] == 1 and v_right[2] == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
