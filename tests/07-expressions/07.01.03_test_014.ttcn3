// @requirement: 7.1.3 -- Enumerated values of the same, or different types can be compared.
// @id: TTCN3-CORE-7.1.3-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_014 {

    type enumerated EWeekDays {
        Mon, Tue, Wed, Thu, Fri, Sat, Sun
    }
    type enumerated EWorkDays {
        Mon, Tue, Wed, Thu, Fri
    }

    type component C {}

    testcase TC() runs on C {
        var EWeekDays v_weekMon := Mon;
        var EWeekDays v_weekSun := Sun;
        var EWorkDays v_workMon := Mon;
        if (v_weekMon == v_workMon and v_weekSun != v_workMon and v_weekMon != v_weekSun) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
