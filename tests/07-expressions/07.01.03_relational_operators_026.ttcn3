// @requirement: 7.1.3 -- For values of bitstring, hexstring or octetstring types, the same equality rule applies as for charstring values with the exception, that fractions which shall equal at all positions are bits, hexadecimal digits or pairs of hexadecimal digits accordingly. Two charstring or two universal charstring values are equal if and only if they have equal lengths and the characters at all positions are the same.
// @id: TTCN3-CORE-7.1.3-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_relational_operators_026 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '1010'B;
        var hexstring v_h := 'A5'H;
        var octetstring v_o := '01A5'O;
        if (v_b == '1010'B and v_b != '1011'B and v_b != '10100'B and v_b != '101'B and
            v_h == 'A5'H and v_h != 'A4'H and v_h != 'A50'H and v_h != 'A'H and
            v_o == '01A5'O and v_o != '01A4'O and v_o != '01A500'O and v_o != '01'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
