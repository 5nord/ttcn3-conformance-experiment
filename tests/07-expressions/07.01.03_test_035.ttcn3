// @requirement: 7.1.3 -- For anytype values the same rule apply as to union values, with the addition that names of user-defined types defined with the same name in different modules do not denote the same type name of the selected alternatives.
// @id: TTCN3-CORE-7.1.3-033b
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_035 {

    import from M_07_01_03_test_035_A { const c_any };

    type component C {}

    type integer MyInt;

    testcase TC() runs on C {
        var anytype v_a := { MyInt := 1 };
        if (v_a != c_any) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_07_01_03_test_035_A {
    type integer MyInt;
    const anytype c_any := { MyInt := 1 };
}
