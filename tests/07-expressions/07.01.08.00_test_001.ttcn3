// @requirement: 7.1.8.0 -- The result type of the presence checking operators is boolean.
// @id: TTCN3-CORE-7.1.8.0-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_00_test_001 {

    type record R { integer f1 optional }
    type union U { integer a, boolean b }

    type component C {}

    testcase TC() runs on C {
        var R v_r := { f1 := 1 };
        var U v_u := { a := 1 };
        var boolean v_p := ispresent(v_r.f1);
        var boolean v_c := ischosen(v_u.a);
        var boolean v_v := isvalue(v_r);
        var boolean v_bd := isbound(v_r);
        if (v_p and v_c and v_v and v_bd) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
