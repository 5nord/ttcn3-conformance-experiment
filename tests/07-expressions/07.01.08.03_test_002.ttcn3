// @requirement: 7.1.8.3 -- The isvalue operator yields true, if the operand is completely initialized and resolves to a specific value.
// @id: TTCN3-CORE-7.1.8.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_03_test_002 {

    type component C {}

    type record R {
        integer f1,
        charstring f2
    }

    template charstring m_char0 := "ABCD";
    template charstring m_char1 := "AB?D";
    template charstring m_char4 := ("ABCD");

    testcase TC() runs on C {
        var R v_rec := { f1 := 1, f2 := "a" };
        var template R v_recT := { f1 := 2, f2 := "b" };
        if (isvalue(m_char0) and isvalue(m_char1) and isvalue(m_char4)
            and isvalue(v_rec) and isvalue(v_recT)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
