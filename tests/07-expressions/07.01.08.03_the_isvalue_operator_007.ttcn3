// @requirement: 7.1.8.3 -- // note, this is different from ischosen(mw_myUnion.ch1) as isvalue checks the content of the choice ch1, while ischosen is checking if ch1 has been selected or not
// @id: TTCN3-CORE-7.1.8.3-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_03_the_isvalue_operator_007 {

    type component C {}

    type union U {
        integer ch1,
        integer ch2
    }

    template U mw_union := { ch1 := ? }

    testcase TC() runs on C {
        if (ischosen(mw_union.ch1) and not isvalue(mw_union.ch1)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
