// @requirement: 7.1.4 -- The logical or returns the value true if at least one of its operands is true; it returns the value false only if both operands are false.
// @id: TTCN3-CORE-7.1.4-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_04_logical_operators_005 {

    type component C {}

    testcase TC() runs on C {
        var boolean v_t := true;
        var boolean v_f := false;
        if ((v_t or v_t) == true and (v_t or v_f) == true and
            (v_f or v_t) == true and (v_f or v_f) == false) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
