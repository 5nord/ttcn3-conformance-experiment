// @requirement: 7.1.4 -- The logical not is the unary operator that returns the value true if its operand was of value false and returns the value false if the operand was of value true.
// @id: TTCN3-CORE-7.1.4-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_04_logical_operators_003 {

    type component C {}

    testcase TC() runs on C {
        var boolean v_t := true;
        var boolean v_f := false;
        if ((not v_f) == true and (not v_t) == false) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
