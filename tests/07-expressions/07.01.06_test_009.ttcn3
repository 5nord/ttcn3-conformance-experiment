// @requirement: 7.1.6 -- For each shift unit shifted to the left, a zero ('0'B, '0'H, or '00'O determined according to the type of the left-hand operand) is inserted from the right-hand side of the left operand.
// @id: TTCN3-CORE-7.1.6-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_06_test_009 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '1111'B;
        var hexstring v_h := 'FFFF'H;
        var octetstring v_o := 'FFFF'O;
        if ((v_b << 3) == '1000'B and (v_h << 3) == 'F000'H and (v_o << 1) == 'FF00'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
