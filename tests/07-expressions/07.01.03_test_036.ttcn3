// @requirement: 7.1.3 -- Two default, two port, two timer or two component values are equal if and only if they both are initialized with the special value null or they both contain a reference to the same entity (i.e. they designate the same default, port, timer or test component, independent of the actual state of the denoted object).
// @id: TTCN3-CORE-7.1.3-034a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_test_036 {

    type component C {}

    altstep a_dummy() {
        [] any timer.timeout {}
    }

    testcase TC() runs on C {
        var C v_null1 := null;
        var C v_null2 := null;
        var C v_ptc1 := C.create;
        var C v_ptc2 := v_ptc1;
        var C v_ptc3 := C.create;
        var default v_dnull := null;
        var default v_d1 := activate(a_dummy());
        var default v_d2 := v_d1;
        var default v_d3 := activate(a_dummy());
        var boolean v_ok := v_null1 == v_null2 and v_ptc1 == v_ptc2 and v_ptc1 != v_ptc3 and
            v_ptc1 != v_null1 and v_dnull == null and v_d1 == v_d2 and v_d1 != v_d3 and
            v_d1 != v_dnull;
        v_ptc1.stop;
        deactivate(v_d1);
        v_ok := v_ok and v_ptc1 == v_ptc2 and v_ptc1 != v_ptc3 and v_d1 == v_d2 and v_d1 != v_d3;
        if (v_ok) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
