// @requirement: 7.1.3 -- Two field references are equal if the referenced fields are both optional fields and both fields are set to omit or if both referenced fields (regardless if they are optional or not) are initialized with values and these values are equal.
// @id: TTCN3-CORE-7.1.3-009b
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_relational_operators_010 {

    type set S1 {
        integer a1 optional,
        integer a2 optional,
        integer a3 optional
    }
    type set S2 {
        integer b1 optional,
        integer b2 optional,
        integer b3 optional
    }

    type record R {
        integer f
    }

    type component C {}

    testcase TC() runs on C {
        var S1 v_s1 := { a1 := 0, a2 := omit, a3 := 2 };
        var S2 v_s2 := { b1 := 0, b2 := omit, b3 := 2 };
        var R v_r1 := { f := 5 };
        var R v_r2 := { f := 5 };
        if (v_s1.a1 == v_s2.b1 and v_r1.f == v_r2.f and v_s1.a3 == v_s2.b3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
