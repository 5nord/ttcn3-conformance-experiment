// @requirement: 7.3 -- In case the ReferencedValue is not a universal `charstring, the optional parameter shall not be` present.
// @id: TTCN3-CORE-7.3-011a
// @verdict: pass reject
module M_07_03_test_009 {

    type component C {}

    type record R {
        integer f1
    }

    testcase TC() runs on C {
        var R v_rec := { f1 := 7 };
        var bitstring v_bs := encvalue(v_rec);
        var R v_dec := v_bs => (R, "UTF-8"); // error: encoding format with a bitstring operand
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
