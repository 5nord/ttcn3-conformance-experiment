// @requirement: 7.1.3 -- Two integer values are equal if and only if they contain the same value.
// @id: TTCN3-CORE-7.1.3-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_relational_operators_012 {

    type integer MyInt (0 .. 10);

    type component C {}

    testcase TC() runs on C {
        var integer v_a := 5;
        var integer v_b := 5;
        var integer v_c := 6;
        var MyInt v_d := 5;
        if (v_a == v_b and not (v_a == v_c) and v_a != v_c and v_d == v_a) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
