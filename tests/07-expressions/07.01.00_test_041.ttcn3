// @requirement: 7.1.0 -- Unary **ispresent, ischosen, isvalue, isbound** Unary **+, -** Binary ***, /, mod, rem** Binary **+, -, &** Unary **not4b** Binary **and4b** Binary **xor4b** Binary **or4b** Binary **<<, >>, <@, @>** Binary **<, >, <=, >=** Binary **==, !=** Unary **not** Binary **and**
// @id: TTCN3-CORE-7.1.0-052e
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_test_041 {

    type component C {}

    testcase TC() runs on C {
        if (not4b '1100'B and4b '1010'B == '0010'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
