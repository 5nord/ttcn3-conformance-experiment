// @requirement: 7.1.2 -- NOTE 1: In case of the list types, both the outer type (i.e. record of, set of or array) and the iterated inner type need to have the same root type in a recursive manner.
// @id: TTCN3-CORE-7.1.2-005a
// @verdict: pass reject
module M_07_01_02_test_006 {

    type record of integer RI;
    type record of charstring RC;

    type component C {}

    testcase TC() runs on C {
        var RI v_i := { 1 };
        var RC v_c := { "a" };
        var RI v_r := v_i & v_c; // error: inner types have different root types
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
