// @requirement: 7.1.8.3 -- If the operand is of record or set type, omitted optional fields shall be considered as initialized, i.e. the operator shall also yield true if optional fields of the operand are set to omit.
// @id: TTCN3-CORE-7.1.8.3-004b
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_03_test_004 {

    type component C {}

    type set S {
        integer f1,
        integer f2 optional,
        integer f3 optional
    }

    template S m_set := { f1 := 1, f2 := omit, f3 := omit }

    testcase TC() runs on C {
        var S v_set := { f1 := 5, f2 := omit, f3 := omit };
        if (isvalue(v_set) and isvalue(m_set)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
