// @requirement: 7.1.3 -- Two record values, or set values are equal respectively if and only if they are mutually compatible with the type of the other operand (see clause 6.3.2.2), the actual values of all present fields are equal to their corresponding fields and all fields corresponding to omitted fields are also omitted in the peer value.
// @id: TTCN3-CORE-7.1.3-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_03_relational_operators_027 {

    type component C {}

    type record R1 {
        integer a1 optional,
        integer a2 optional,
        integer a3 optional
    }

    type record R2 {
        integer b1 optional,
        integer b2 optional,
        integer b3 optional
    }

    testcase TC() runs on C {
        var R1 v_r1 := { a1 := 0, a2 := omit, a3 := 2 };
        var R2 v_r2a := { b1 := 0, b2 := omit, b3 := 2 };
        var R2 v_r2b := { b1 := omit, b2 := 0, b3 := 2 };
        var R2 v_r2c := { b1 := 0, b2 := omit, b3 := 3 };
        if (v_r1 == v_r2a and v_r1 != v_r2b and v_r1 != v_r2c) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
