// @requirement: 7.1.7 -- NOTE 2: Note that for the right hand operand restriction a) in clause 6.5 further on applies.
// @id: TTCN3-CORE-7.1.7-014a
// @verdict: pass accept, ttcn3verdict:error
module M_07_01_07_test_014 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '101001'B;
        var integer v_n;
        var bitstring v_res := v_b <@ v_n; // error: right-hand operand is uninitialized
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
