// @requirement: 7.1.0 -- Category: bitwise and; Operator: and4b
// @id: TTCN3-CORE-7.1.0-038a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_general_025 {

    type component C {}

    testcase TC() runs on C {
        if (('1100'B and4b '1010'B) == '1000'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
