// @requirement: 7.1.6 -- Their left-hand operand shall be of root type `bitstring, hexstring or octetstring.
// @id: TTCN3-CORE-7.1.6-002a
// @verdict: pass reject
module M_07_01_06_shift_operators_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 5;
        var integer v_r := v_i << 1; // error: left-hand operand of root type integer
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
