// @requirement: 7.1.8.4 -- Inaccessible fields (e.g. non-selected alternatives of union types, subfields of omitted record and set types or subfields of non-selected union fields) shall be considered as uninitialized, i.e. isbound shall yield for them false.
// @id: TTCN3-CORE-7.1.8.4-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_04_the_isbound_operator_006 {

    type component C {}

    type record R {
        integer f1,
        R f2 optional
    }

    type set S {
        integer g1
    }

    type record P {
        S s optional
    }

    testcase TC() runs on C {
        var R v_rec := { f1 := 5, f2 := omit };
        var P v_p := { s := omit };
        if (not isbound(v_rec.f2.f1) and not isbound(v_p.s.g1)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
