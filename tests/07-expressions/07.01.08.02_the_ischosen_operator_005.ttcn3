// @requirement: 7.1.8.2 -- The ischosen operator is applicable to data objects of union types or of anytype containing a specific value or a value list.
// @id: TTCN3-CORE-7.1.8.2-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_02_the_ischosen_operator_005 {

    type union U { integer f1, octetstring f2 }

    type component C {}

    template U m_u1 := { f1 := 1 };
    template U m_u2 := ({ f1 := 1 }, { f1 := 2 });
    template U mw_u3 := ?;
    template anytype m_a1 := { integer := 1 };

    testcase TC() runs on C {
        if (ischosen(m_u1.f1) and ischosen(m_u2.f1) and ischosen(m_a1.integer) and
            not ischosen(mw_u3.f1) and not ischosen(mw_u3.f2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
} with {
    extension "anytype integer"
}
