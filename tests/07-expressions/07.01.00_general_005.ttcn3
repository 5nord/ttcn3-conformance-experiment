// @requirement: 7.1.0 -- Parentheses may be used to group operands in expressions, in which case a parenthesized expression has the highest precedence for evaluation.
// @id: TTCN3-CORE-7.1.0-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_general_005 {

    type component C {}

    testcase TC() runs on C {
        if ((1 + 2) == 3 and ((4 - 1) * (2 + 1)) == 9) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
