// @requirement: 7.3 -- The parameter shall be of the charstring type and it shall contain one of the strings allowed for the decvalue_unichar function (specified in clause C.5.4).
// @id: TTCN3-CORE-7.3-009b
// @verdict: pass reject
module M_07_03_decoded_field_reference_007 {

    type component C {}

    type record R {
        integer f1
    }

    testcase TC() runs on C {
        var R v_rec := { f1 := 7 };
        var universal charstring v_uc := encvalue_unichar(v_rec);
        var R v_dec := v_uc => (R, "UTF-9"); // error: not an allowed encoding format
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
