// @requirement: 7.1.0 -- Category: bitwise xor; Operator: xor4b
// @id: TTCN3-CORE-7.1.0-040a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_general_027 {

    type component C {}

    testcase TC() runs on C {
        if (('1100'B xor4b '1010'B) == '0110'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
