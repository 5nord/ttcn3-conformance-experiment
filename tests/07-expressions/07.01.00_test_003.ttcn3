// @requirement: 7.1.0 -- Within any row in this table, the listed operators have equal precedence.
// @id: TTCN3-CORE-7.1.0-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_test_003 {

    type component C {}

    testcase TC() runs on C {
        if (12 / 2 * 3 == 18 and 7 mod 4 * 2 == 6 and 10 - 2 + 3 == 11) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
