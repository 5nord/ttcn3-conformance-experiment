// @requirement: 7.1.0 -- Category: bitwise or; Operator: or4b
// @id: TTCN3-CORE-7.1.0-039a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_general_026 {

    type component C {}

    testcase TC() runs on C {
        if (('1100'B or4b '1010'B) == '1110'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
