module M_07_01_00_general_046 {

    type component C {}

    testcase TC() runs on C {
        if (1 < 2 == true and 2 > 1 != false and 3 >= 4 == 2 <= 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
