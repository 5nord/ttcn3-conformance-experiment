// @requirement: 7.1.8.0 -- The presence checking operator yields the value false. In these cases, if resolving dot notation, index notation (see clause 7.2) or decoded field references (see clause 7.3) included in the _ExtendedFieldReference would produce an error (e.g. if an index is out of range, when referencing a sub-field of an_ omitted field etc.), the following happens:
// @id: TTCN3-CORE-7.1.8.0-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_00_general_007 {

    type union U { integer f1, octetstring f2 }
    type record R { U u optional }
    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        template R m_r1 := { u := omit };
        var R v_r := { u := omit };
        var RoI v_l := { 1, 2 };
        if (not ischosen(m_r1.u.f1) and not ispresent(v_r.u.f1) and
            not isvalue(v_r.u.f2) and not isbound(v_l[2])) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
