// @requirement: 7.1.5 -- For each corresponding bit position, the resulting value is 0 if both bits are set to 0 or if both bits are set to 1, otherwise the value for the resulting bit is 1. That is:
// @id: TTCN3-CORE-7.1.5-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_05_test_011 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_1 := '1'B;
        var bitstring v_0 := '0'B;
        var bitstring v_b := '1001'B;
        var hexstring v_h := '9'H;
        var octetstring v_o := '39'O;
        if ((v_1 xor4b v_1) == '0'B and (v_0 xor4b v_0) == '0'B and
            (v_0 xor4b v_1) == '1'B and (v_1 xor4b v_0) == '1'B and
            (v_b xor4b '0101'B) == '1100'B and (v_h xor4b '5'H) == 'C'H and
            (v_o xor4b '15'O) == '2C'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
