// @requirement: 7.1.2 -- a) When the list concatenation operator is used for record of-s, set of-s and arrays, its operands shall be at least partially initialized.
// @id: TTCN3-CORE-7.1.2-008a
// @verdict: pass accept, ttcn3verdict:error
module M_07_01_02_test_008 {

    type record of integer RI;

    type component C {}

    testcase TC() runs on C {
        var RI v_a;
        var RI v_b := { 1 };
        var RI v_r;
        setverdict(pass);
        v_r := v_a & v_b; // error: v_a is not initialized
    }

    control {
        execute(TC());
    }
}
