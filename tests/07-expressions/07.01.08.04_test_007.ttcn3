// @requirement: 7.1.8.4 -- Inaccessible fields (e.g. non-selected alternatives of union types, subfields of omitted record and set types or subfields of non-selected union fields) shall be considered as uninitialized, i.e. isbound shall yield for them false.
// @id: TTCN3-CORE-7.1.8.4-008b
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_08_04_test_007 {

    type component C {}

    type record R {
        integer f1,
        integer f2 optional
    }

    type union U {
        integer ch1,
        R ch2
    }

    testcase TC() runs on C {
        var template U v_union := { ch1 := 5 };
        if (not isbound(v_union.ch2) and not isbound(v_union.ch2.f1)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
