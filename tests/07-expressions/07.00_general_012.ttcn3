// @requirement: 7.0 -- c) With the exception of the equality and non-equality operators, the special value null shall not be used as an operand of expressions (see clause 7.1.3).
// @id: TTCN3-CORE-7.0-012a
// @verdict: pass reject
module M_07_00_general_012 {

    type component C {}

    type integer address;

    testcase TC() runs on C {
        var address v_addr := 1;
        var boolean v_b := v_addr < null; // error: null as operand of <
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
