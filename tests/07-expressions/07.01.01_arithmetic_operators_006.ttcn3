// @requirement: 7.1.1 -- In the case where plus (+) or minus (-) is used as the unary operator the rules for operands apply as well.
// @id: TTCN3-CORE-7.1.1-006a
// @verdict: pass reject
module M_07_01_01_arithmetic_operators_006 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_s := -"abc"; // error: operand of unary - is not integer or float
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
