// @requirement: 7.1.0 -- Category: Arithmetic operators; Operator: addition; Symbol or Keyword: +
// @id: TTCN3-CORE-7.1.0-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_07_01_00_general_007 {

    type component C {}

    testcase TC() runs on C {
        if (2 + 3 == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
