// @requirement: 8.2.5 -- Top-level module definitions and import statements have a visibility, which can be explicitly set.
// @id: TTCN3-CORE-8.2.5-001a
// @verdict: pass accept, noexecution
module M_08_02_05_visibility_of_definitions_001 {

    public type integer MyInteger;
    friend type record MyRecord {
        integer field1
    }
    private const MyInteger c_value := 1;
    public template MyRecord m_record := { field1 := c_value };
    friend function f_value() return MyInteger {
        return c_value;
    }
    type boolean MyBoolean;
}
