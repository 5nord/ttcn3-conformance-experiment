// @requirement: 8.2.2 -- A group of definitions can be specified wherever a single definition is allowed.
// @id: TTCN3-CORE-8.2.2-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_02_test_004 {

    const integer c_single := 1;

    group g_defs {
        type component C {}

        function f_value() return integer {
            return 2;
        }

        testcase TC() runs on C {
            if (c_single + f_value() == 3) {
                setverdict(pass);
            } else {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
