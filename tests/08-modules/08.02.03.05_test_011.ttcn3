// @requirement: 8.2.3.5 -- a) If all visible definitions of a module are imported by using the all keyword, no other form of import (import of single definitions, import of the same kind, etc.) shall be used for the same import statement.
// @id: TTCN3-CORE-8.2.3.5-011a
// @verdict: pass reject
module M_08_02_03_05_test_011 {

    import from M_08_02_03_05_test_011_A all {
        const c_a // error: other form of import in an all import statement
    }

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_05_test_011_A {
    const integer c_a := 1;
}
