// @requirement: 8.2.4 -- Friendship can be cyclic.
// @id: TTCN3-CORE-8.2.4-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_04_test_004 {

    friend module M_08_02_04_test_004_A;

    import from M_08_02_04_test_004_A { const c_valueA }

    friend const integer c_value := 1;

    type component C {}

    testcase TC() runs on C {
        if (c_valueA == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_04_test_004_A {

    friend module M_08_02_04_test_004;

    import from M_08_02_04_test_004 { const c_value }

    friend const integer c_valueA := c_value + 1;
}
