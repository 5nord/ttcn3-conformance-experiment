// @requirement: 8.2.2 -- However, top-level group identifiers and all group identifiers of subgroups of a single group shall be unique.
// @id: TTCN3-CORE-8.2.2-013a
// @verdict: pass reject
module M_08_02_02_test_010 {

    group g_top {
        const integer c_a := 1;
    }

    group g_top { // error: top-level group identifier is not unique
        const integer c_b := 2;
    }
}
