// @requirement: 8.2.3.1 -- Importable Definition: Altstep; Possible Local Definitions: Parameter names; Possible Referenced Definitions: Parameter types, component type (runs on clause)
// @id: TTCN3-CORE-8.2.3.1-056a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_test_025 {

    import from M_08_02_03_01_test_025_A { altstep a_timeout }

    type component C {}

    testcase TC() runs on C {
        timer T_guard := 0.1;
        T_guard.start;
        a_timeout(p_timer := T_guard, p_expected := 1);
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_test_025_A {
    altstep a_timeout(timer p_timer, integer p_expected) {
        [p_expected == 1] p_timer.timeout {
            setverdict(pass);
        }
    }
}
