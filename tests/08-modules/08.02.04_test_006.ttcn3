// @requirement: 8.2.4 -- For non-friend modules, public top-level definitions are visible only.
// @id: TTCN3-CORE-8.2.4-006a
// @verdict: pass reject
module M_08_02_04_test_006 {

    import from M_08_02_04_test_006_A all;

    type component C {}

    testcase TC() runs on C {
        if (c_public == 1 and c_friend == 2) { // error: c_friend is not visible to a non-friend module
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_04_test_006_A {
    public const integer c_public := 1;
    friend const integer c_friend := 2;
}
