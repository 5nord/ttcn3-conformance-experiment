// @requirement: 8.2.3.5 -- The effect of importing all visible definitions of a module is identical to an import statement that lists all importable definitions of that module except of those that are listed in the except specification.
// @id: TTCN3-CORE-8.2.3.5-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_05_importing_all_definitions_of_a_module_010 {

    import from M_08_02_03_05_importing_all_definitions_of_a_module_010_A all except {
        const c_b
    }

    const integer c_b := 20;

    type component C {}

    testcase TC() runs on C {
        var MyInt v_i := f_add(c_a, c_b);
        if (v_i == 21) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_05_importing_all_definitions_of_a_module_010_A {
    type integer MyInt;
    const integer c_a := 1;
    const integer c_b := 2;
    function f_add(integer p_a, integer p_b) return integer {
        return p_a + p_b;
    }
}
