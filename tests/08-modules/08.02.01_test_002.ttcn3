// @requirement: 8.2.1 -- They can be used on the right hand side of assignments, in expressions, in actual parameters, and in template definitions, but not within type definitions.
// @id: TTCN3-CORE-8.2.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_01_test_002 {

    modulepar integer mp_value := 3;

    template integer m_value := mp_value;

    type component C {}

    function f_double(integer p_x) return integer {
        return 2 * p_x;
    }

    testcase TC() runs on C {
        var integer v_assigned := mp_value;
        var integer v_expr := mp_value + 1;
        var integer v_param := f_double(mp_value);
        if (v_assigned == 3 and v_expr == 4 and v_param == 6 and match(3, m_value)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
