// @requirement: 8.2.3.3 -- Import statements contained in the group or in its subgroups are not part of this list, only definitions are.
// @id: TTCN3-CORE-8.2.3.3-010a
// @verdict: pass reject
module M_08_02_03_03_test_010 {

    import from M_08_02_03_03_test_010_A {
        group g_group
    }

    type component C {}

    testcase TC() runs on C {
        if (c_inGroup == 1 and c_fromB == 2) { // error: c_fromB is not imported by the group import
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_03_test_010_A {
    group g_group {
        public import from M_08_02_03_03_test_010_B all;
        const integer c_inGroup := 1;
    }
}

module M_08_02_03_03_test_010_B {
    const integer c_fromB := 2;
}
