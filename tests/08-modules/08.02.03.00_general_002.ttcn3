// @requirement: 8.2.3.0 -- Every definition in a TTCN-3 module has an associated visibility, which is by default public (see clause 8.2.5).
// @id: TTCN3-CORE-8.2.3.0-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_00_general_002 {

    public type integer MyPublicInt;
    friend type integer MyFriendInt;
    private type integer MyPrivateInt;

    public const MyPublicInt c_public := 1;
    friend const MyFriendInt c_friend := 2;
    private const MyPrivateInt c_private := 3;

    public type component C {}

    private function f_sum() return integer {
        return c_public + c_friend + c_private;
    }

    public testcase TC() runs on C {
        if (f_sum() == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
