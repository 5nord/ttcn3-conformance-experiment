// @requirement: 8.2.1 -- It is allowed to specify a default value or template for each module parameter as part of the modulepar declaration.
// @id: TTCN3-CORE-8.2.1-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_01_module_parameters_008 {

    modulepar integer mp_value := 5;
    modulepar template charstring mp_template := pattern "ab*";

    type component C {}

    testcase TC() runs on C {
        if (mp_value == 5 and match("abbb", mp_template) and not match("ba", mp_template)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
