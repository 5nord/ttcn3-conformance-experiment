// @requirement: 8.2.1 -- Optional fields of record and set module parameters or module parameter fields can be initialized explicitly or implicitly.
// @id: TTCN3-CORE-8.2.1-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_01_module_parameters_015 {

    type record R {
        integer a,
        integer b optional
    }

    type set S {
        integer a,
        integer b optional
    }

    modulepar R mp_explicitRecord := { a := 1, b := omit };
    modulepar S mp_explicitSet := { a := 1, b := omit };
    modulepar R mp_implicitRecord := { a := 1 } with { optional "implicit omit" }
    modulepar S mp_implicitSet := { a := 1 } with { optional "implicit omit" }

    type component C {}

    testcase TC() runs on C {
        if (not ispresent(mp_explicitRecord.b) and not ispresent(mp_explicitSet.b)
            and not ispresent(mp_implicitRecord.b) and not ispresent(mp_implicitSet.b)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
