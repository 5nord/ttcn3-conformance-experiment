// @requirement: 8.2.3.3 -- It is important to point out, that the except statement does not exclude the definitions listed from being imported in general; all statements importing definitions of the same kind can be seen as a shorthand notation for an equivalent list of identifiers of single definitions.
// @id: TTCN3-CORE-8.2.3.3-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_03_test_011 {

    import from M_08_02_03_03_test_011_A {
        group g_group except { const c_value2 };
        const c_value2
    }

    type component C {}

    testcase TC() runs on C {
        if (c_value1 == 1 and c_value2 == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_03_test_011_A {
    group g_group {
        const integer c_value1 := 1;
        const integer c_value2 := 2;
    }
}
