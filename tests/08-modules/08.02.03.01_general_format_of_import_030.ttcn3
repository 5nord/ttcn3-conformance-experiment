// @requirement: 8.2.3.1 -- If an imported definition has attributes (defined by means of a with statement) then the attributes shall also be imported.
// @id: TTCN3-CORE-8.2.3.1-065a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_general_format_of_import_030 {

    import from M_08_02_03_01_general_format_of_import_030_A {
        type MyRec;
        template m_rec
    }

    type component C {}

    testcase TC() runs on C {
        var MyRec v_rec := { a := 1, b := omit };
        if (match(v_rec, m_rec)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_general_format_of_import_030_A {

    type record MyRec {
        integer a,
        integer b optional
    }

    template MyRec m_rec := { a := 1 } with { optional "implicit omit" }
}
