// @requirement: 8.2.3.1 -- NOTE 7: Definitions with the same name defined in different modules are always assumed to be different, even if the actual definitions in the different modules are identical.
// @id: TTCN3-CORE-8.2.3.1-109a
// @verdict: pass reject
module M_08_02_03_01_general_format_of_import_068 {

    import from M_08_02_03_01_general_format_of_import_068_A all;
    import from M_08_02_03_01_general_format_of_import_068_B all;

    type component C {}

    testcase TC() runs on C {
        if (c_value == 42) { // error: two different definitions c_value, prefix needed
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_general_format_of_import_068_A {
    const integer c_value := 42;
}

module M_08_02_03_01_general_format_of_import_068_B {
    const integer c_value := 42;
}
