// @requirement: 8.2.5 -- All other module definitions are by default public.
// @id: TTCN3-CORE-8.2.5-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_05_visibility_of_definitions_018 {

    import from M_08_02_05_visibility_of_definitions_018_A all;

    type component C {}

    testcase TC() runs on C {
        var MyInteger v_value := f_value();
        if (match(v_value, m_value) and v_value == c_value) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_05_visibility_of_definitions_018_A {
    type integer MyInteger;
    const MyInteger c_value := 1;
    template MyInteger m_value := 1;
    function f_value() return MyInteger {
        return c_value;
    }
}
