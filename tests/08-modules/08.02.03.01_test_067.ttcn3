// @requirement: 8.2.3.1 -- j) If an imported module is renamed in the import clause, the new local name of the module shall be unique in the scope of the importing module.
// @id: TTCN3-CORE-8.2.3.1-102a
// @verdict: pass reject
module M_08_02_03_01_test_067 {

    import from M_08_02_03_01_test_067_A -> M_Short all;
    import from M_08_02_03_01_test_067_B -> M_Short all; // error: new local name M_Short is not unique

    type component C {}

    testcase TC() runs on C {
        if (c_valueA == 1 and c_valueB == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_test_067_A {
    const integer c_valueA := 1;
}

module M_08_02_03_01_test_067_B {
    const integer c_valueB := 2;
}
