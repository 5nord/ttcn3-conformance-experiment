// @requirement: 8.2.2 -- a) Group identifiers across the whole module need not necessarily be unique.
// @id: TTCN3-CORE-8.2.2-012a
// @verdict: pass accept, noexecution
module M_08_02_02_groups_of_definitions_009 {

    group g_first {
        group g_sub {
            const integer c_a := 1;
        }
    }

    group g_second {
        group g_sub {
            const integer c_b := 2;
            group g_first {
                const integer c_c := 3;
            }
        }
    }
}
