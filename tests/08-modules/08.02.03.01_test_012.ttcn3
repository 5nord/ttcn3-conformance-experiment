// @requirement: 8.2.3.1 -- Importable Definition: • port type; Possible Referenced Definitions: Message types, signatures
// @id: TTCN3-CORE-8.2.3.1-048a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_test_012 {

    import from M_08_02_03_01_test_012_B { type P }

    type component C {
        port P p;
    }

    function f_send() runs on C {
        p.send({ a := 1 });
    }

    testcase TC() runs on C {
        timer T_guard := 1.0;
        var C v_ptc := C.create;
        connect(mtc:p, v_ptc:p);
        v_ptc.start(f_send());
        T_guard.start;
        alt {
            [] p.receive({ a := 1 }) {
                setverdict(pass);
            }
            [] p.receive {
                setverdict(fail);
            }
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_test_012_B {
    import from M_08_02_03_01_test_012_A all;
    type port P message {
        inout MyMsg;
    }
}

module M_08_02_03_01_test_012_A {
    type record MyMsg {
        integer a
    }
}
