// @requirement: 8.2.3.1 -- All import statements and definitions within import statements are considered to be treated independently one after the other in the order of their appearance.
// @id: TTCN3-CORE-8.2.3.1-071a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_general_format_of_import_033 {

    import from M_08_02_03_01_general_format_of_import_033_A all except { const c_b }
    import from M_08_02_03_01_general_format_of_import_033_A { const c_b }

    type component C {}

    testcase TC() runs on C {
        if (c_a + c_b == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_general_format_of_import_033_A {
    const integer c_a := 1;
    const integer c_b := 2;
}
