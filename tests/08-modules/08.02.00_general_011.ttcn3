// @requirement: 8.2.0 -- TTCN-3 does not support the declaration of variables in the module definitions part, i.e. global variables cannot be defined in TTCN-3.
// @id: TTCN3-CORE-8.2.0-016a
// @verdict: pass reject
module M_08_02_00_general_011 {

    var integer v_global := 1; // error: variable declared in the module definitions part

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
