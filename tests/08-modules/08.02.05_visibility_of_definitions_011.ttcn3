// @requirement: 8.2.5 -- A top-level definition or an import statement with public visibility is importable by any other module.
// @id: TTCN3-CORE-8.2.5-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_05_visibility_of_definitions_011 {

    import from M_08_02_05_visibility_of_definitions_011_A { type MyRecord; template m_record };
    import from M_08_02_05_visibility_of_definitions_011_B { import all };

    type component C {}

    testcase TC() runs on C {
        var MyRecord v_record := { field1 := c_value };
        if (match(v_record, m_record)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_05_visibility_of_definitions_011_A {
    public type record MyRecord {
        integer field1
    }
    public template MyRecord m_record := { field1 := 1 };
    public const integer c_value := 1;
}

module M_08_02_05_visibility_of_definitions_011_B {
    public import from M_08_02_05_visibility_of_definitions_011_A { const c_value };
}
