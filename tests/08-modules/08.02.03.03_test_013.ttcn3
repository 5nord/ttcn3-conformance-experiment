// @requirement: 8.2.3.3 -- The except statement excludes definitions from this single list only.
// @id: TTCN3-CORE-8.2.3.3-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_03_test_013 {

    import from M_08_02_03_03_test_013_A {
        group g_group except { const c_value2 }
    }
    import from M_08_02_03_03_test_013_A {
        group g_other
    }

    type component C {}

    testcase TC() runs on C {
        if (c_value1 == 1 and c_value2 == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_03_test_013_A {
    group g_other {
        group g_group {
            const integer c_value1 := 1;
            const integer c_value2 := 2;
        }
    }
}
