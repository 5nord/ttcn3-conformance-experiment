// @requirement: 8.2.3.1 -- There is one exception to this rule: when in the context of an enumerated type (see clause 6.2.4), an enumerated value is clashing with the name of a definition in the importing module, the enumerated value shall take precedence and the definition in the importing module shall be referenced by using its qualified name (see example 5 below in this clause).
// @id: TTCN3-CORE-8.2.3.1-076b
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_general_format_of_import_040 {

    import from M_08_02_03_01_general_format_of_import_040_A {
        type MyEnum, MyRec
    }

    const MyRec e_second := { f := e_first };

    type component C {}

    testcase TC() runs on C {
        var MyEnum v_enum := e_second;
        var MyEnum v_def := M_08_02_03_01_general_format_of_import_040.e_second.f;
        if (enum2int(v_enum) == 1 and enum2int(v_def) == 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_general_format_of_import_040_A {
    type enumerated MyEnum { e_first, e_second }
    type record MyRec {
        MyEnum f
    }
}
