// @requirement: 8.2.3.4 -- The all keyword used with the constant keyword identifies all visible constants declared in the definitions part of the module the import statement refers to.
// @id: TTCN3-CORE-8.2.3.4-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_04_test_002 {

    import from M_08_02_03_04_test_002_A {
        const all
    }

    type component C {}

    testcase TC() runs on C {
        if (c_a == 1 and c_b == 2 and c_c == "c") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_04_test_002_A {
    const integer c_a := 1;
    public const integer c_b := 2;
    group G {
        const charstring c_c := "c";
    }
}
