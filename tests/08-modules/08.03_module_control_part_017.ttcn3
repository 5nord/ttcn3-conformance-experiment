// @requirement: 8.3 -- Visibility of import: friend; Import imported by a non-friend module: no; Import imported by a friend module: yes
// @id: TTCN3-CORE-8.3-010a
// @verdict: pass reject
module M_08_03_module_control_part_017 {

    import from M_08_03_module_control_part_017_B { import all };

    type component C {}

    testcase TC() runs on C {
        if (c_value == 1) { // error: the friend import statement of B is not imported by a non-friend module
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_03_module_control_part_017_B {
    friend import from M_08_03_module_control_part_017_A { const c_value };
}

module M_08_03_module_control_part_017_A {
    const integer c_value := 1;
}
