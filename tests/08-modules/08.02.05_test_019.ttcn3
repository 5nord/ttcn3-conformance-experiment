// @requirement: 8.2.5 -- The visibility of a top-level definition or an import statement defines their importability by another module.
// @id: TTCN3-CORE-8.2.5-017a
// @verdict: pass reject
module M_08_02_05_test_019 {

    import from M_08_02_05_test_019_A { altstep all };

    type component C {
        timer T := 0.1;
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [] a_public() {}
            [] a_private() {} // error: a_private is private and therefore not imported
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_05_test_019_A {
    import from M_08_02_05_test_019 { type C };

    public altstep a_public() runs on C {
        [] T.timeout {
            setverdict(pass);
        }
    }

    private altstep a_private() runs on C {
        [] T.timeout {
            setverdict(pass);
        }
    }
}
