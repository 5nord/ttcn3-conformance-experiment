// @requirement: 8.2.0 -- Definitions in the module definitions part may be made in any order.
// @id: TTCN3-CORE-8.2.0-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_00_test_005 {

    testcase TC() runs on C {
        if (f_get() == c_value) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    function f_get() return MyInt {
        return c_value;
    }

    const MyInt c_value := 5;

    type integer MyInt;

    type component C {}

    control {
        execute(TC());
    }
}
