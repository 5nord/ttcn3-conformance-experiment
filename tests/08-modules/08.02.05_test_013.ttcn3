// @requirement: 8.2.5 -- A top-level definition or an import statement with private visibility cannot be imported at all.
// @id: TTCN3-CORE-8.2.5-011a
// @verdict: pass reject
module M_08_02_05_test_013 {

    import from M_08_02_05_test_013_A { template m_value }; // error: m_value is private

    type component C {}

    testcase TC() runs on C {
        if (match(1, m_value)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_05_test_013_A {
    friend module M_08_02_05_test_013;

    private template integer m_value := 1;
}
