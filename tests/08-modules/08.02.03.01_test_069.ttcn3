// @requirement: 8.2.3.1 -- For example, importing a type that is already defined locally, even with the same name, would lead to two different types being available in the module.
// @id: TTCN3-CORE-8.2.3.1-110a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_test_069 {

    type bitstring MyTypeA;

    import from M_08_02_03_01_test_069_A {
        type MyTypeA
    }

    type component C {}

    testcase TC() runs on C {
        var MyTypeA v_local := '10110011'B;
        var M_08_02_03_01_test_069_A.MyTypeA v_imported := "Test String";
        if (v_local == '10110011'B and v_imported == "Test String") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_test_069_A {
    type charstring MyTypeA;
}
