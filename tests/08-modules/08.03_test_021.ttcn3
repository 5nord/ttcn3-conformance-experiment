// @requirement: 8.3 -- NOTE: As the control part is a short hand notation of a control function with the name "control", at most 1 control part can be defined in a TTCN-3 module.
// @id: TTCN3-CORE-8.3-015a
// @verdict: pass reject
module M_08_03_test_021 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }

    control { // error: second control part in the same module
        execute(TC());
    }
}
