// @requirement: 8.2.4 -- If a module is friend to a module from which it imports top-level definitions, all top-level definitions with public and friend visibility are visible to the friend module.
// @id: TTCN3-CORE-8.2.4-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_04_test_005 {

    import from M_08_02_04_test_005_A all;

    type component C {}

    testcase TC() runs on C {
        if (c_public == 1 and c_friend == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_04_test_005_A {

    friend module M_08_02_04_test_005;

    public const integer c_public := 1;
    friend const integer c_friend := 2;
}
