// @requirement: 8.2.3.4 -- If some visible declarations of a kind are wished to be excluded from the given import statement, their identifiers shall be listed following the except keyword.
// @id: TTCN3-CORE-8.2.3.4-004a
// @verdict: pass reject
module M_08_02_03_04_test_004 {

    import from M_08_02_03_04_test_004_A {
        type all except MyType2, MyType3
    }

    type component C {}

    testcase TC() runs on C {
        var MyType1 v_a := 1;
        var MyType2 v_b := 2; // error: MyType2 is excluded from the import
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_04_test_004_A {
    type integer MyType1;
    type integer MyType2;
    type integer MyType3;
}
