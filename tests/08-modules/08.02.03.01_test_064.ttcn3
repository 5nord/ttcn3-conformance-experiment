// @requirement: 8.2.3.1 -- i) If an imported module is renamed in the import clause, the original module name is not imported and cannot be used for referencing the imported module.
// @id: TTCN3-CORE-8.2.3.1-100a
// @verdict: pass reject
module M_08_02_03_01_test_064 {

    import from M_08_02_03_01_test_064_VeryLongName -> M_Short all;

    type component C {}

    testcase TC() runs on C {
        var M_08_02_03_01_test_064_VeryLongName.MyType v_str := "Test String"; // error: original module name is not imported
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_test_064_VeryLongName {
    type charstring MyType;
}
