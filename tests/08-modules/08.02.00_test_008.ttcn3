// @requirement: 8.2.0 -- They may be used elsewhere in the module.
// @id: TTCN3-CORE-8.2.0-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_00_test_008 {

    type record R {
        integer a
    }

    template R m_r := { a := 3 };

    function f_make(integer p_a) return R {
        return { a := p_a };
    }

    type component C {
        var R v_r := { a := 3 };
    }

    testcase TC() runs on C {
        var R v_local := valueof(m_r);
        if (v_local == v_r and match(f_make(3), m_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var R v_ctrl := f_make(3);
        if (match(v_ctrl, m_r)) {
            execute(TC());
        }
    }
}
