// @requirement: 8.2.2 -- Groups and nested groups have no scoping.
// @id: TTCN3-CORE-8.2.2-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_02_test_006 {

    group g_outer {
        group g_inner {
            const integer c_inner := 2;
        }
        const integer c_outer := c_inner + 1;
    }

    group g_other {
        const integer c_other := c_outer + c_inner;
    }

    type component C {}

    testcase TC() runs on C {
        if (c_other == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
