module M_08_02_03_00_test_003 {

    import from M_08_02_03_00_test_003_A all;

    type component C {}

    testcase TC() runs on C {
        var MyInt v_value := c_value;
        if (v_value == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_00_test_003_A {

