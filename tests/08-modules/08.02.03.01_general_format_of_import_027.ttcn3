// @requirement: 8.2.3.1 -- Importable Definition: Test case; Possible Local Definitions: Parameter names; Possible Referenced Definitions: Parameter types, component types (runs on- and system clause)
// @id: TTCN3-CORE-8.2.3.1-057a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_general_format_of_import_027 {

    import from M_08_02_03_01_general_format_of_import_027_A { testcase TC }

    control {
        execute(TC(p_a := 5, p_b := 1));
    }
}

module M_08_02_03_01_general_format_of_import_027_A {

    type component C {}

    testcase TC(integer p_a, integer p_b) runs on C {
        if (p_a - p_b == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }
}
