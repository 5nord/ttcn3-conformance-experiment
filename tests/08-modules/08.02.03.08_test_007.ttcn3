// @requirement: 8.2.3.8 -- c) A TTCN-3 module shall only import from earlier or same editions of TTCN-3 but not from later editions, e.g. the TTCN-3 language specification in an import statement has to be lower or equal to the TTCN-3 language specification of the importing module.
// @id: TTCN3-CORE-8.2.3.8-008b
// @verdict: pass reject
module M_08_02_03_08_test_007 language "TTCN-3:2010" {

    import from M_08_02_03_08_test_007_A language "TTCN-3:2023" { const c_value } // error: later than the importing module's edition

    type component C {}

    testcase TC() runs on C {
        if (c_value == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_08_test_007_A {
    const integer c_value := 1;
}
