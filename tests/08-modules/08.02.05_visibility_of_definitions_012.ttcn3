// @requirement: 8.2.5 -- A top-level definition or an import statement with friend visibility is importable by friend modules only (see clause 8.2.4).
// @id: TTCN3-CORE-8.2.5-010a
// @verdict: pass reject
module M_08_02_05_visibility_of_definitions_012 {

    import from M_08_02_05_visibility_of_definitions_012_A { function f_value }; // error: f_value is friend and this module is no friend of A

    type component C {}

    testcase TC() runs on C {
        if (f_value() == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_05_visibility_of_definitions_012_A {
    friend module M_08_02_05_visibility_of_definitions_012_B;

    friend function f_value() return integer {
        return 1;
    }
}

module M_08_02_05_visibility_of_definitions_012_B {
    import from M_08_02_05_visibility_of_definitions_012_A { function f_value };
}
