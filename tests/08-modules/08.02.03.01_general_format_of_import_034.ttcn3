// @requirement: 8.2.3.1 -- All TTCN-3 modules shall have their own name space in which all definitions shall be uniquely identified.
// @id: TTCN3-CORE-8.2.3.1-072a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_general_format_of_import_034 {

    import from M_08_02_03_01_general_format_of_import_034_A { function f_value }

    const integer c_value := 1;

    type component C {}

    testcase TC() runs on C {
        if (c_value == 1 and f_value() == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_general_format_of_import_034_A {

    const integer c_value := 2;

    function f_value() return integer {
        return c_value;
    }
}
