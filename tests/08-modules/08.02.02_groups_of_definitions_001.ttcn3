// @requirement: 8.2.2 -- In the module definitions part, definitions can be collected in named groups.
// @id: TTCN3-CORE-8.2.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_02_groups_of_definitions_001 {

    group g_definitions {
        type integer MyInt;
        const MyInt c_value := 1;
    }

    type component C {}

    testcase TC() runs on C {
        if (c_value == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
