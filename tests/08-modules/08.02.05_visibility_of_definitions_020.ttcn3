// @requirement: 8.2.5 -- If the top-level definition or the import statement is part of a group, this has no effect on the importability of the module definition.
// @id: TTCN3-CORE-8.2.5-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_05_visibility_of_definitions_020 {

    import from M_08_02_05_visibility_of_definitions_020_A { const c_public, c_friend };

    type component C {}

    testcase TC() runs on C {
        if (c_public == 1 and c_friend == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_05_visibility_of_definitions_020_A {
    friend module M_08_02_05_visibility_of_definitions_020;

    group G {
        public const integer c_public := 1;
        group G2 {
            friend const integer c_friend := 2;
        }
    }
}
