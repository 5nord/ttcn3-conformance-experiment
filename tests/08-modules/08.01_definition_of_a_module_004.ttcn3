// @requirement: 8.1 -- It is possible to hide definitions in a TTCN-3 module (see clause 8.2.5).
// @id: TTCN3-CORE-8.1-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_01_definition_of_a_module_004 {

    import from M_08_01_definition_of_a_module_004_A all;

    type component C {}

    testcase TC() runs on C {
        if (f_getValue() == 42) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_01_definition_of_a_module_004_A {

    private const integer c_hidden := 42;

    public function f_getValue() return integer {
        return c_hidden;
    }
}
