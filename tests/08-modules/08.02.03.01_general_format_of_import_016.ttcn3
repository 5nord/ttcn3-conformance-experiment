// @requirement: 8.2.3.1 -- Importable Definition: Signature; Possible Local Definitions: Parameter names; Possible Referenced Definitions: Parameter types, return type, types of exceptions
// @id: TTCN3-CORE-8.2.3.1-050b
// @verdict: pass accept, noexecution
module M_08_02_03_01_general_format_of_import_016 {

    import from M_08_02_03_01_general_format_of_import_016_B { signature S }

    type port P procedure {
        inout S;
    }

    type component C {
        port P p;
    }

    template S s_call := { p_par := { a := 1 } };

    function f_client() runs on C {
        p.call(s_call, 1.0) {
            [] p.getreply(S:{ p_par := ? } value { b := true }) {}
            [] p.catch(S, { c := "error" }) {}
            [] p.catch(timeout) {}
        }
    }
}

module M_08_02_03_01_general_format_of_import_016_B {
    import from M_08_02_03_01_general_format_of_import_016_A all;
    signature S(in MyPar p_par) return MyReturn exception (MyExc);
}

module M_08_02_03_01_general_format_of_import_016_A {
    type record MyPar {
        integer a
    }
    type record MyReturn {
        boolean b
    }
    type record MyExc {
        charstring c
    }
}
