// @requirement: 8.2.1 -- Module parameters behave as global constants or unparameterized templates at runtime.
// @id: TTCN3-CORE-8.2.1-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_01_test_005 {

    modulepar integer mp_value := 5;
    modulepar template integer mp_template := (1 .. 10);

    const integer c_value := 5;
    template integer m_template := (1 .. 10);

    type component C {}

    testcase TC() runs on C {
        if (mp_value == c_value
            and match(7, mp_template) == match(7, m_template)
            and match(11, mp_template) == match(11, m_template)
            and match(mp_value, mp_template)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
