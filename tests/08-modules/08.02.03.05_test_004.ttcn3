// @requirement: 8.2.3.5 -- The all keyword is also allowed to be used in the exception list; this will exclude all visible declarations of the same kind from the import statement.
// @id: TTCN3-CORE-8.2.3.5-003b
// @verdict: pass reject
module M_08_02_03_05_test_004 {

    import from M_08_02_03_05_test_004_A all except {
        template all
    }

    type component C {}

    testcase TC() runs on C {
        if (match(c_a, m_b)) { // error: m_b is excluded by "template all"
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_05_test_004_A {
    const integer c_a := 1;
    template integer m_a := ?;
    template integer m_b := 1;
}
