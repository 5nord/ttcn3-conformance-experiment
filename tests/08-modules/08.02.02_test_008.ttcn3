// @requirement: 8.2.2 -- Import statements may import groups so that all visible elements of a group are imported (see clause 8.2.3.3).
// @id: TTCN3-CORE-8.2.2-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_02_test_008 {

    import from M_08_02_02_test_008_A {
        group g_defs
    }

    type component C {}

    testcase TC() runs on C {
        var MyInt v_value := c_a + c_b;
        if (v_value == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_02_test_008_A {

    group g_defs {
        type integer MyInt;
        const integer c_a := 1;
        const integer c_b := 2;
    }
}
