// @requirement: 8.2.3.5 -- If some visible definitions are wished not to be imported, their kinds and identifiers shall be listed in the exception list within a pair of curly brackets following the except keyword.
// @id: TTCN3-CORE-8.2.3.5-002a
// @verdict: pass reject
module M_08_02_03_05_importing_all_definitions_of_a_module_002 {

    import from M_08_02_03_05_importing_all_definitions_of_a_module_002_A all except {
        const c_b
    }

    type component C {}

    testcase TC() runs on C {
        var integer v_i := c_a;
        v_i := c_b; // error: c_b is excluded from the import
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_05_importing_all_definitions_of_a_module_002_A {
    const integer c_a := 1;
    const integer c_b := 2;
}
