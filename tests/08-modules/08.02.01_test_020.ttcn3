// @requirement: 8.2.1 -- b) Module parameters shall not be of port, default, timer or component type and shall not be of a structured type that contains a sub-element of port or timer type at any level of nesting.
// @id: TTCN3-CORE-8.2.1-021b
// @verdict: pass reject
module M_08_02_01_test_020 {

    type port P message {
        inout integer
    }

    type record Inner {
        P p
    }

    type record R {
        integer a,
        Inner b
    }

    type component C {}

    modulepar R mp_r; // error: structured type with a nested port sub-element

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
