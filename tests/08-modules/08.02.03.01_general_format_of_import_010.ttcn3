// @requirement: 8.2.3.1 -- Importable Definition: • structured type; Possible Local Definitions: Field names, nested type definitions; Possible Referenced Definitions: Field types
// @id: TTCN3-CORE-8.2.3.1-047a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_general_format_of_import_010 {

    import from M_08_02_03_01_general_format_of_import_010_A { type MyRec }

    type component C {}

    testcase TC() runs on C {
        var MyRec v_rec := { a := 1, inner := { x := 2 } };
        var MyRec.inner v_inner := { x := 3 };
        v_rec.inner := v_inner;
        if (v_rec.a == 1 and v_rec.inner.x == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_general_format_of_import_010_A {
    type record MyRec {
        integer a,
        record {
            integer x
        } inner
    }
}
