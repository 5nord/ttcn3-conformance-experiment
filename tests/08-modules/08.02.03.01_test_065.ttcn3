// @requirement: 8.2.3.1 -- i) If an imported module is renamed in the import clause, the original module name is not imported and cannot be used for referencing the imported module.
// @id: TTCN3-CORE-8.2.3.1-100b
// @verdict: pass reject
module M_08_02_03_01_test_065 {

    import from M_08_02_03_01_test_065_VeryLongName -> M_Short all;

    type component C {}

    testcase TC() runs on C {
        if (M_08_02_03_01_test_065_VeryLongName.c_value == 42) { // error: original module name used after renaming
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_test_065_VeryLongName {
    const integer c_value := 42;
}
