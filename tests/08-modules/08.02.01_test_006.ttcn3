// @requirement: 8.2.1 -- For module parameterization, TTCN-3 only supports value parameterization which has to be resolved static at start of runtime.
// @id: TTCN3-CORE-8.2.1-006a
// @verdict: pass reject
module M_08_02_01_test_006 {

    type component C {
        var integer v_comp := 1;
    }

    function f_comp() runs on C return integer {
        return v_comp;
    }

    modulepar integer mp_value := f_comp(); // error: value depends on a test component and cannot be resolved at start of runtime

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
