// @requirement: 8.3 -- Visibility of module definition: private; Module definition importable directly by a non-friend module: no; Module definition importable directly by a friend module: no; Module definition importable via group import by a non-friend module: no; Module definition importable via group import by a friend module: no
// @id: TTCN3-CORE-8.3-007b
// @verdict: pass reject
module M_08_03_test_012 {

    import from M_08_03_test_012_A { const c_value };

    type component C {}

    testcase TC() runs on C {
        if (c_value == 1) { // error: private c_value is not importable even by a friend module
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_03_test_012_A {
    friend module M_08_03_test_012;

    private const integer c_value := 1;
}
