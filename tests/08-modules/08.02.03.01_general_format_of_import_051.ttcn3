// @requirement: 8.2.3.1 -- Definitions which are top-level but invisible to the importing module or which occur at a lower scope (e.g. local constants defined in a function) shall not be imported.
// @id: TTCN3-CORE-8.2.3.1-085b
// @verdict: pass reject
module M_08_02_03_01_general_format_of_import_051 {

    import from M_08_02_03_01_general_format_of_import_051_A {
        const c_local // error: constant local to a function cannot be imported
    }

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_general_format_of_import_051_A {
    function f_get() return integer {
        const integer c_local := 42;
        return c_local;
    }
}
