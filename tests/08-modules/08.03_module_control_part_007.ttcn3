// @requirement: 8.3 -- Visibility of module definition: friend; Module definition importable directly by a non-friend module: no; Module definition importable directly by a friend module: yes; Module definition importable via group import by a non-friend module: no; Module definition importable via group import by a friend module: yes
// @id: TTCN3-CORE-8.3-006a
// @verdict: pass reject
module M_08_03_module_control_part_007 {

    import from M_08_03_module_control_part_007_A { const c_value };

    type component C {}

    testcase TC() runs on C {
        if (c_value == 1) { // error: friend c_value is not importable by a non-friend module
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_03_module_control_part_007_A {
    friend const integer c_value := 1;
}
