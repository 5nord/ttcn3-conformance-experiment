// @requirement: 8.2.1 -- They can be used on the right hand side of assignments, in expressions, in actual parameters, and in template definitions, but not within type definitions.
// @id: TTCN3-CORE-8.2.1-003b
// @verdict: pass reject
module M_08_02_01_test_003 {

    modulepar integer mp_max := 10;

    type integer MyInt (0 .. mp_max); // error: module parameter used within a type definition

    type component C {}

    testcase TC() runs on C {
        var MyInt v_value := 1;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
