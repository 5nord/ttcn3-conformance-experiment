// @requirement: 8.2.3.1 -- Importable Definition: Function; Possible Local Definitions: Parameter names; Possible Referenced Definitions: Parameter types, return type, component type (runs on clause)
// @id: TTCN3-CORE-8.2.3.1-054a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_test_021 {

    import from M_08_02_03_01_test_021_A { function f_diff }

    type component C {}

    testcase TC() runs on C {
        if (f_diff(p_a := 5, p_b := 1) == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_test_021_A {
    function f_diff(integer p_a, integer p_b) return integer {
        return p_a - p_b;
    }
}
