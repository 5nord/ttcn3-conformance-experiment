module M_08_02_03_01_test_024 {

    import from M_08_02_03_01_test_024_B { function fx_inc }

    function f_use() return integer {
        return fx_inc({ x := 1 }).y;
    }
}

module M_08_02_03_01_test_024_B {
    import from M_08_02_03_01_test_024_A all;
    external function fx_inc(MyPar p_par) return MyResult;
}

module M_08_02_03_01_test_024_A {
    type record MyPar {
        integer x
    }
    type record MyResult {
        integer y
    }
}
