// @requirement: 8.2.3.3 -- If some visible definitions of a group are wished not to be imported, their kinds and identifiers shall be listed in the exception list within a pair of curly brackets following the except keyword.
// @id: TTCN3-CORE-8.2.3.3-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_03_test_005 {

    import from M_08_02_03_03_test_005_A {
        group g_group except { type MyType2; const c_value2 }
    }

    type component C {}

    testcase TC() runs on C {
        var MyType1 v_value := c_value1;
        if (v_value == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_03_test_005_A {
    group g_group {
        type integer MyType1;
        type integer MyType2;
        const integer c_value1 := 1;
        const integer c_value2 := 2;
    }
}
