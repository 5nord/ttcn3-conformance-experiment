// @requirement: 8.2.3.2 -- Import of an invisible definition shall cause an error.
// @id: TTCN3-CORE-8.2.3.2-005a
// @verdict: pass reject
module M_08_02_03_02_test_004 {

    import from M_08_02_03_02_test_004_A {
        type MyFriendType // error: friend definition is invisible to a non-friend module
    }

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_02_test_004_A {
    friend type integer MyFriendType;
}
