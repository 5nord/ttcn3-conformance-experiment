// @requirement: 8.2.3.0 -- Importing a group means that only the visible elements of the group are being imported.
// @id: TTCN3-CORE-8.2.3.0-004a
// @verdict: pass reject
module M_08_02_03_00_test_005 {

    import from M_08_02_03_00_test_005_A {
        group g_defs
    }

    type component C {}

    testcase TC() runs on C {
        if (c_public + c_private == 3) { // error: c_private is not visible, hence not imported
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_00_test_005_A {

    group g_defs {
        public const integer c_public := 1;
        private const integer c_private := 2;
    }
}
