// @requirement: 8.2.3.1 -- In cases where there are no ambiguities the prefixing need not (but may) be present when the imported definitions are used.
// @id: TTCN3-CORE-8.2.3.1-077a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_test_041 {

    import from M_08_02_03_01_test_041_A {
        type MyType;
        const c_value
    }

    type component C {}

    testcase TC() runs on C {
        var MyType v_value := c_value;
        if (v_value == "abc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_test_041_A {
    type charstring MyType;
    const MyType c_value := "abc";
}
