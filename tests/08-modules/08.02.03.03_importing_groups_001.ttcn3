// @requirement: 8.2.3.3 -- Groups of definitions may be imported.
// @id: TTCN3-CORE-8.2.3.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_03_importing_groups_001 {

    import from M_08_02_03_03_importing_groups_001_A {
        group g_group
    }

    type component C {}

    testcase TC() runs on C {
        var MyType v_value := c_value;
        if (v_value == 42) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_03_importing_groups_001_A {
    group g_group {
        type integer MyType;
        const integer c_value := 42;
    }
}
