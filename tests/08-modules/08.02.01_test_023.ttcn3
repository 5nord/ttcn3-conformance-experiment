// @requirement: 8.2.1 -- e) More than one occurrence of module parameters declaration is allowed but each parameter shall be declared only once (i.e. redefinition of the module parameter is not allowed).
// @id: TTCN3-CORE-8.2.1-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_01_test_023 {

    modulepar integer mp_a := 1;
    modulepar charstring mp_b := "b";

    type component C {}

    modulepar integer mp_c := 3, mp_d := 4;

    testcase TC() runs on C {
        if (mp_a + mp_c + mp_d == 8 and mp_b == "b") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
