// @requirement: 8.2.3.1 -- Importable Definition: • component type; Possible Local Definitions: Constant names, variable names, timer names and port names; Possible Referenced Definitions: Constant types, variable types, port types
// @id: TTCN3-CORE-8.2.3.1-049a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_test_013 {

    import from M_08_02_03_01_test_013_A { type C }

    testcase TC() runs on C {
        v_var := v_var + c_const;
        p.clear;
        T_guard.start;
        T_guard.stop;
        if (v_var == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_test_013_A {

    type port P message {
        inout integer;
    }

    type component C {
        const integer c_const := 1;
        var integer v_var := 2;
        timer T_guard := 1.0;
        port P p;
    }
}
