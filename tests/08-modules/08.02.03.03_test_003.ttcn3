// @requirement: 8.2.3.3 -- It is allowed to import sub-groups (i.e. a group which is defined within another group) directly, i.e. without the groups in which the sub-group is embedded.
// @id: TTCN3-CORE-8.2.3.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_03_test_003 {

    import from M_08_02_03_03_test_003_A {
        group g_inner
    }

    type component C {}

    testcase TC() runs on C {
        if (c_inner == 42) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_03_test_003_A {
    group g_outer {
        const integer c_outer := 1;
        group g_inner {
            const integer c_inner := 42;
        }
    }
}
