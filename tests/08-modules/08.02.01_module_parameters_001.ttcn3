// @requirement: 8.2.1 -- Module parameters do not change during test execution.
// @id: TTCN3-CORE-8.2.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_01_module_parameters_001 {

    modulepar integer mp_value := 5;

    type component C {
        var integer v_atStart := mp_value;
    }

    function f_ptc(integer p_expected) runs on C {
        if (mp_value == p_expected and v_atStart == p_expected) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC(integer p_fromControl) runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc(p_fromControl));
        v_ptc.done;
        if (mp_value == p_fromControl and v_atStart == p_fromControl) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var integer v_first := mp_value;
        execute(TC(v_first));
        execute(TC(v_first));
    }
}
