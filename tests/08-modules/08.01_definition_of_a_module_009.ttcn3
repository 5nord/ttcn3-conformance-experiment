module M_08_01_definition_of_a_module_009 language "TTCN-3:2023" {

    type component C {}

    type record R {
        integer f1
    }

    testcase TC() runs on C {
        var template R v_t := { f1 := 1 };
        if (isvalue(v_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
