// @requirement: 8.2.3.2 -- Single visible definitions can be imported by referring to the definition kind and the definition name(s).
// @id: TTCN3-CORE-8.2.3.2-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_02_test_001 {

    import from M_08_02_03_02_test_001_A {
        type MyType;
        const c_value1, c_value2
    }

    type component C {}

    testcase TC() runs on C {
        var MyType v_value := c_value1 + c_value2;
        if (v_value == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_02_test_001_A {
    type integer MyType;
    const integer c_value1 := 1;
    const integer c_value2 := 2;
}
