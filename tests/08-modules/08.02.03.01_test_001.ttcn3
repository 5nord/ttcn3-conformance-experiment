// @id: TTCN3-CORE-8.2.3.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_test_001 {

    import from M_08_02_03_01_test_001_A { const c_a }

    type component C {}

    import from M_08_02_03_01_test_001_A { const c_b }

    testcase TC() runs on C {
        if (c_a + c_b + c_c == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    import from M_08_02_03_01_test_001_A { const c_c }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_test_001_A {
    const integer c_a := 1;
    const integer c_b := 2;
    const integer c_c := 3;
}
