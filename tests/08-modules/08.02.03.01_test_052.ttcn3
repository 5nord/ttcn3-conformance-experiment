// @requirement: 8.2.3.1 -- c) A definition is imported together with its name and all local definitions.
// @id: TTCN3-CORE-8.2.3.1-086a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_02_03_01_test_052 {

    import from M_08_02_03_01_test_052_A {
        type MyRec, MyEnum
    }

    type component C {}

    testcase TC() runs on C {
        var MyRec v_rec := { field1 := 1, field2 := "A" };
        var MyEnum v_enum := e_second;
        v_rec.field1 := 5;
        if (v_rec.field1 == 5 and v_rec.field2 == "A" and v_enum == e_second) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}

module M_08_02_03_01_test_052_A {
    type record MyRec {
        integer field1,
        charstring field2
    }
    type enumerated MyEnum { e_first, e_second }
}
