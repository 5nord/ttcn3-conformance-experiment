// @requirement: 8.2.1 -- h) All sub-elements of component or default type of a default value of a module parameter shall be initialized with the special value null.
// @id: TTCN3-CORE-8.2.1-028a
// @verdict: pass reject
module M_08_02_01_module_parameters_030 {

    type component C {}

    type record R {
        integer a,
        C comp
    }

    modulepar R mp_r := { a := 1, comp := mtc }; // error: component sub-element not initialized with null

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
