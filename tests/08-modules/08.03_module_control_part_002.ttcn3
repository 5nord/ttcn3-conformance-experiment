// @requirement: 8.3 -- The shorthand notation is equivalent to a module control function with the same statement block, no parameters, no runs on clause and no return clause (see clause 16.1).
// @id: TTCN3-CORE-8.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_08_03_module_control_part_002 {

    import from M_08_03_module_control_part_002_A { function control };

    control {
        M_08_03_module_control_part_002_A.control();
    }
}

module M_08_03_module_control_part_002_A {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
