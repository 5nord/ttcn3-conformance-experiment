// @requirement: 25 -- Items to be displayed shall be identified by a comma-separated list in the argument of the action statement.
// @id: TTCN3-CORE-25-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_25_test_001 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_myString := " now.";
        var integer v_myInt := 1;
        action("Send ", v_myInt, " on lower PCO", v_myString);
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
