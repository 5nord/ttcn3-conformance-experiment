// @requirement: 25 -- action "(" { ( FreeText | TemplateInstance ) [","] } ")"
// @id: TTCN3-CORE-25-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_25_external_actions_003 {

    type component C {}

    template charstring m_str := "template";

    testcase TC() runs on C {
        var integer v_int := 1;
        action("free text");
        action("free text", v_int, m_str, integer:(1 .. 3));
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
