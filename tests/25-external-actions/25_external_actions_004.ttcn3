// @requirement: 25 -- External actions can be used in test cases, functions and altsteps.
// @id: TTCN3-CORE-25-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_25_external_actions_004 {

    type component C {
        timer T := 0.0;
    }

    function f_action() runs on C {
        action("in function");
    }

    altstep a_action() runs on C {
        [] T.timeout {
            action("in altstep");
        }
    }

    testcase TC() runs on C {
        action("in testcase");
        f_action();
        T.start;
        a_action();
        setverdict(pass);
    }

    control {
        action("in control");
        execute(TC());
    }
}
