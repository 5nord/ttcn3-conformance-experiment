// @requirement: 25 -- Items may be individual language elements specified in table 18 or expressions composed of such items.
// @id: TTCN3-CORE-25-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_25_test_002 {

    type component C {
        timer T := 1.0;
    }

    const integer c_int := 5;
    template integer m_int := (1 .. 10);

    function f_twice(integer p_x) return integer {
        return 2 * p_x;
    }

    testcase TC() runs on C {
        var integer v_int := 3;
        T.start;
        action("literal", c_int, v_int, m_int, v_int + c_int, f_twice(v_int), T.read, getverdict, self);
        T.stop;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
