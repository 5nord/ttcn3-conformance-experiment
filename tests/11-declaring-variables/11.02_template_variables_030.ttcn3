// @requirement: 11.2 -- m) The template body at the right-hand side of the assignment symbol shall evaluate to an object that is at least partially initialized.
// @id: TTCN3-CORE-11.2-030a
// @verdict: pass reject
module M_11_02_template_variables_030 {
    type component C {}

    testcase TC() runs on C {
        var integer v_i;
        var template integer v_t := v_i; // error: right hand side is uninitialized
        setverdict(pass);
    }
}
