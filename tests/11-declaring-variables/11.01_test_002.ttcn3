// @requirement: 11.1 -- An initial value can be assigned at variable declaration.
// @id: TTCN3-CORE-11.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_11_01_test_002 {

    type component C {}

    testcase TC() runs on C {
        var integer v_int := 1;
        var record of integer v_numbers := { 1, 2, 3 };
        if (v_int == 1 and v_numbers == { 1, 2, 3 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
