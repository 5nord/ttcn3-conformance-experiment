// @requirement: 11.2 -- NOTE 2: While it is not allowed to directly apply TTCN-3 operations to template variables, it is allowed to use the dot notation and the index notation to inspect and modify template variable fields.
// @id: TTCN3-CORE-11.2-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_11_02_template_variables_019 {
    type record R {
        integer f1,
        integer f2
    }

    type record of integer RoI;

    type component C {}

    testcase TC() runs on C {
        var template R v_r := { f1 := 1, f2 := ? };
        var template RoI v_l := { 1, ?, 3 };
        v_r.f2 := 2;
        v_l[1] := 2;
        var template integer v_e := v_l[0];
        var template integer v_f := v_r.f1;
        if (match({ f1 := 1, f2 := 2 }, v_r) and match({ 1, 2, 3 }, v_l)
            and not match({ 1, 5, 3 }, v_l) and match(1, v_e) and match(1, v_f)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }}
