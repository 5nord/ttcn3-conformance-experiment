// @requirement: 11.0 -- Lazy and fuzzy features are valid only in the scope, where the variables' names are visible.
// @id: TTCN3-CORE-11.0-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_11_00_general_012 {

    type component C {
        var integer vc_count := 0;
    }

    function f_next() runs on C return integer {
        vc_count := vc_count + 1;
        return vc_count;
    }

    function f_check(integer p_value) runs on C return boolean {
        return vc_count == 1 and p_value == 1;
    }

    testcase TC() runs on C {
        var @lazy integer v_lazy := f_next();
        if (vc_count == 0 and f_check(v_lazy)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
