// @requirement: 11.2 -- b) When used on the right hand side of assignments template variables shall not be operands of TTCN-3 operators (see clause 7.1) and the variable on the left hand side shall be a template variable too.
// @id: TTCN3-CORE-11.2-017a
// @verdict: pass reject
module M_11_02_template_variables_016 {
    type component C {}

    testcase TC() runs on C {
        var template integer v_a := 1;
        var template integer v_b := v_a + 1; // error: template variable as operand of an operator
        setverdict(pass);
    }
}
