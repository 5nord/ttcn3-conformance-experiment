// @requirement: 11.1 -- It may be used at the right hand side as well as at the left hand side of assignments, in expressions, following the return keyword in bodies of functions with a return clause in their headers and may be passed to both value and template-type formal parameters.
// @id: TTCN3-CORE-11.1-004d
// @verdict: pass accept, ttcn3verdict:pass
module M_11_01_value_variables_006 {

    type component C {}

    function f_value(integer p_value) return boolean {
        return p_value == 3;
    }

    function f_template(template integer p_template) return boolean {
        return match(3, p_template);
    }

    testcase TC() runs on C {
        var integer v_a := 3;
        if (f_value(v_a) and f_template(v_a)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
