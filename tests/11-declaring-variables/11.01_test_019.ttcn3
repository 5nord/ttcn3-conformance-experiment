// @requirement: 11.1 -- f) If a lazy or fuzzy value variable is used in deterministic contexts (i.e. during the evaluation of a snapshot or initialization of global non-fuzzy templates), it shall be declared @deterministic and the expression assigned to the variable shall fulfill the restrictions imposed on content of functions used in special places given in clause 16.1.4.
// @id: TTCN3-CORE-11.1-016b
// @verdict: pass reject
module M_11_01_test_019 {

    type component C {}

    testcase TC() runs on C {
        var @lazy @deterministic float v_lazy := rnd(); // error: rnd is not allowed in deterministic contexts
        timer T := 0.1;
        T.start;
        alt {
            [v_lazy >= 0.0] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
