// @requirement: 11.2 -- c) When accessing element of template variables either on the left hand side or on the right hand side of assignments, the rules given in clause 15.6 shall apply.
// @id: TTCN3-CORE-11.2-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_11_02_test_018 {
    type record R {
        integer f1,
        integer f2
    }

    type component C {}

    testcase TC() runs on C {
        var template R v_t := ?;
        v_t.f1 := 1;
        var template integer v_f2 := v_t.f2;
        if (match({ f1 := 1, f2 := 5 }, v_t) and not match({ f1 := 2, f2 := 5 }, v_t)
            and match(7, v_f2)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }}
