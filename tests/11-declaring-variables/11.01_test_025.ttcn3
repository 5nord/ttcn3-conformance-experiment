// @requirement: 11.1 -- var timer v_timer1; ... timer t_myTimer1; ... v_timer1 := t_myTimer1;
// @id: TTCN3-CORE-11.1-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_11_01_test_025 {

    type component C {}

    testcase TC() runs on C {
        var timer v_timer1;
        timer t_myTimer1;
        v_timer1 := t_myTimer1;
        t_myTimer1.start(1.0);
        if (v_timer1.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        t_myTimer1.stop;
    }

    control {
        execute(TC());
    }
}
