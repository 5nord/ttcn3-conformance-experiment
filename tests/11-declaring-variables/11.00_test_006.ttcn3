// @requirement: 11.0 -- Additionally, variables can be declared in component type definitions.
// @id: TTCN3-CORE-11.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_11_00_test_006 {

    type component C {
        var integer vc_int := 1;
        var boolean vc_flag;
    }

    testcase TC() runs on C {
        if (vc_int == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
