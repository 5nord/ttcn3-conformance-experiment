// @requirement: 11.1 -- c) Value variables shall not be declared or used in a module definitions part (i.e. global variables are not supported in TTCN-3).
// @id: TTCN3-CORE-11.1-012a
// @verdict: pass reject
module M_11_01_test_013 {

    var integer v_global := 1; // error: variable in module definitions part

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
