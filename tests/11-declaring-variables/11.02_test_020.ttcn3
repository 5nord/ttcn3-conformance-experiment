// @requirement: 11.2 -- d) Use of uninitialized template variables at other places than the left hand side of assignments, in return statements, or as actual parameters passed to formal parameters shall cause an error.
// @id: TTCN3-CORE-11.2-020a
// @verdict: pass accept, ttcn3verdict:error
module M_11_02_test_020 {
    type record R {
        integer f1,
        integer f2
    }

    type component C {}

    testcase TC() runs on C {
        var template R v_t := { f1 := 1, f2 := - };
        setverdict(pass);
        if (match(5, v_t.f2)) { // error: v_t.f2 is uninitialized
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }}
