// @requirement: 11.1 -- i) The expression shall evaluate to a value, which is at least partially initialized.
// @id: TTCN3-CORE-11.1-020a
// @verdict: pass accept, ttcn3verdict:error
module M_11_01_value_variables_022 {

    type record R {
        integer f1,
        integer f2
    }

    type component C {}

    testcase TC() runs on C {
        var R v_a;
        setverdict(pass);
        var R v_b := v_a; // error: expression evaluates to a completely uninitialized value
    }

    control {
        execute(TC());
    }
}
