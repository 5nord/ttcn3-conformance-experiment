// @requirement: 11.1 -- c) Value variables shall not be declared or used in a module definitions part (i.e. global variables are not supported in TTCN-3).
// @id: TTCN3-CORE-11.1-012b
// @verdict: pass reject
module M_11_01_value_variables_014 {

    group G {
        var integer v_global; // error: global variable inside a group of the module definitions part
    }

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
