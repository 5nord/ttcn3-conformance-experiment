// @requirement: 11.1 -- A value can be assigned several times to a value variable.
// @id: TTCN3-CORE-11.1-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_11_01_test_009 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a := 1;
        v_a := 2;
        v_a := 3;
        if (v_a == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
