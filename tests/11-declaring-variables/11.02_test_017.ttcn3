// @requirement: 11.2 -- b) When used on the right hand side of assignments template variables shall not be operands of TTCN-3 operators (see clause 7.1) and the variable on the left hand side shall be a template variable too.
// @id: TTCN3-CORE-11.2-017b
// @verdict: pass reject
module M_11_02_test_017 {
    type component C {}

    testcase TC() runs on C {
        var template integer v_t := 1;
        var integer v_i := 0;
        v_i := v_t; // error: left hand side is not a template variable
        setverdict(pass);
    }
}
