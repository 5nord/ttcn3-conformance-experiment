// @requirement: 11.2 -- j) If a lazy or fuzzy template variable is used in deterministic contexts (i.e. during the evaluation of a snapshot or initialization of global non-fuzzy templates), it shall be declared @deterministic and the template body assigned to the variable shall fulfill the restrictions imposed on content of functions used in special places given in clause 16.1.4.
// @id: TTCN3-CORE-11.2-027b
// @verdict: pass reject
module M_11_02_test_027 {
    type port P message {
        inout float
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        var template @fuzzy @deterministic float v_t := rnd(); // error: rnd not allowed in deterministic context
        timer T_guard := 1.0;
        connect(mtc:p, mtc:p);
        p.send(0.5);
        T_guard.start;
        alt {
            [] p.receive(v_t) {
                setverdict(pass);
            }
            [] p.receive {
                setverdict(pass);
            }
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
    }
}
