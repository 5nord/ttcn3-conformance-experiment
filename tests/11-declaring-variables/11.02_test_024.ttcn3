// @requirement: 11.2 -- i) The initialization or assignment of a fuzzy or lazy variable shall not contain function calls of functions with inout or out parameters.
// @id: TTCN3-CORE-11.2-025a
// @verdict: pass reject
module M_11_02_test_024 {
    type component C {}

    function f_inc(inout integer p_i) return integer {
        p_i := p_i + 1;
        return p_i;
    }

    testcase TC() runs on C {
        var integer v_i := 0;
        var template @lazy integer v_t := f_inc(v_i); // error: call of function with inout parameter
        setverdict(pass);
    }
}
