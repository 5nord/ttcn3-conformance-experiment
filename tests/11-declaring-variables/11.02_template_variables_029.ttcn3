// @requirement: 11.2 -- l) The template body at the right-hand side of the assignment symbol shall evaluate to a value or template, which is type compatible with the variable being declared.
// @id: TTCN3-CORE-11.2-029a
// @verdict: pass reject
module M_11_02_template_variables_029 {
    type component C {}

    testcase TC() runs on C {
        var template integer v_t := "abc"; // error: value of wrong type
        setverdict(pass);
    }
}
