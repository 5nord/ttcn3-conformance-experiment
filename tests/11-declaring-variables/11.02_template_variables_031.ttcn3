// @requirement: 11.2 -- n) If the TypeOrNestedTypeDef part is missing from the declaration, the ArrayDef part shall be missing as well and the assignment part (i.e. ":=" TemplateBody) shall be present.
// @id: TTCN3-CORE-11.2-031a
// @verdict: pass reject
module M_11_02_template_variables_031 {
    type component C {}

    testcase TC() runs on C {
        var template v_t[2] := { 1, 2 }; // error: ArrayDef without TypeOrNestedTypeDef
        setverdict(pass);
    }
}
