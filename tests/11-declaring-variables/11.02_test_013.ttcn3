// @requirement: 11.2 -- The restriction template (omit) can be replaced by the shorthand notation omit.
// @id: TTCN3-CORE-11.2-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_11_02_test_013 {
    type record R {
        integer f1,
        integer f2 optional
    }

    type component C {}

    testcase TC() runs on C {
        var omit R v_t := { f1 := 1, f2 := omit };
        if (match({ f1 := 1, f2 := omit }, v_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }}
