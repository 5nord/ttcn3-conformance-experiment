// @requirement: 11.0 -- If a variable is declared fuzzy or lazy they can additionally declared with the @deterministic modifier to indicate that when used in a deterministic evaluation context, any evaluation of the variable would have no side effect and would yield the same result.
// @id: TTCN3-CORE-11.0-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_11_00_general_011 {

    type component C {}

    testcase TC() runs on C {
        var integer v_base := 1;
        var @lazy @deterministic integer v_lazy := v_base + 1;
        var @fuzzy @deterministic integer v_fuzzy := v_base + 2;
        if (v_lazy == 2 and v_fuzzy == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
