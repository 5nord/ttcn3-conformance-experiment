// @requirement: 11.0 -- When automatic typing is used, the TypeOrNestedParDef part of the declaration is missing and the type of the variable is equal to the type of the expression or template body on the right-hand side of the assignment.
// @id: TTCN3-CORE-11.0-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_11_00_general_003 {

    type component C {}

    testcase TC() runs on C {
        var v_int := 5;
        var v_str := "abc";
        if (v_int == 5 and v_str == "abc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
