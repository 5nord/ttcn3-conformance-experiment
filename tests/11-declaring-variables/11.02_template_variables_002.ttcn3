// @requirement: 11.2 -- An initial content can be assigned at declaration.
// @id: TTCN3-CORE-11.2-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_11_02_template_variables_002 {
    type component C {}

    testcase TC() runs on C {
        var template integer v_t := (1 .. 3);
        if (match(2, v_t) and not match(4, v_t)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }}
