// @requirement: 20.5.0 -- The deactivate operation either removes a default from the list or suspends it in which case the default remains in the list, but is temporarily inactive.
// @id: TTCN3-CORE-20.5.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_00_general_005 {

    type component C {
        timer T;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; }
    }

    altstep a_2() runs on C {
        [] T.timeout { v_log := v_log & "2"; }
    }

    function f_wait() runs on C {
        T.start(0.1);
        T_guard.start(0.5);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        T_guard.stop;
    }

    testcase TC() runs on C {
        activate(a_1());
        var default v_def2 := activate(a_2());
        deactivate(v_def2, true);
        f_wait();
        activate(v_def2);
        f_wait();
        deactivate(v_def2);
        f_wait();
        if (v_log == "121") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
