// @requirement: 20.5.1 -- If the execution of the selected top alternative of the default ends with a break statement or without a repeat statement the control flow of the test component will continue immediately after the alt statement.
// @id: TTCN3-CORE-20.5.1-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_01_test_016 {

    type component C {
        timer T;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_break() runs on C {
        [] T.timeout { v_log := v_log & "b"; break; }
    }

    altstep a_plain() runs on C {
        [] T.timeout { v_log := v_log & "p"; }
    }

    testcase TC() runs on C {
        var default v_def := activate(a_break());
        T.start(0.1);
        T_guard.start(0.5);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        v_log := v_log & "a";
        deactivate(v_def);
        activate(a_plain());
        T.start(0.1);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        v_log := v_log & "a";
        if (v_log == "bapa") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
