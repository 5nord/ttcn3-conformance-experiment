// @requirement: 20.4 -- The loop statements for, while, and do-while can be used within statements blocks that do not contain reception statements.
// @id: TTCN3-CORE-20.4-025b
// @verdict: pass reject
module M_20_04_the_interleave_statement_017 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(integer:1);
        p1.send(integer:2);
        p1.send(integer:2);
        interleave {
            [] p2.receive(integer:1) {
                for (var integer i := 0; i < 2; i := i + 1) { // error: loop containing a reception statement
                    p2.receive(integer:2);
                }
            }
        }
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
