// @requirement: 20.4 -- b) If none of the alternatives of the `interleave` statement can be executed, the default mechanism will be invoked.
// @id: TTCN3-CORE-20.4-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_04_the_interleave_statement_005 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
        var boolean v_def := false;
    }

    altstep a_def() runs on C {
        [] p2.receive(integer:9) {
            v_def := true;
            repeat;
        }
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        activate(a_def());
        p1.send(integer:9);
        p1.send(integer:1);
        interleave {
            [] p2.receive(integer:1) {}
        }
        if (v_def) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
