// @requirement: 20.5.1 -- An unsuccessful default execution will also be indicated if the list of defaults is empty or if it contains only suspended defaults.
// @id: TTCN3-CORE-20.5.1-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_01_the_default_mechanism_011 {

    type component C {
        timer T;
        timer T_def;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T_def.timeout { v_log := v_log & "1"; }
    }

    testcase TC() runs on C {
        T.start(0.2);
        alt {
            [] T.timeout { v_log := v_log & "e"; }
        }
        var default v_def := activate(a_1());
        deactivate(v_def, true);
        T_def.start(0.05);
        T.start(0.3);
        alt {
            [] T.timeout { v_log := v_log & "s"; }
        }
        if (v_log == "es") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
