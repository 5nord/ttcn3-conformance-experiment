// @requirement: 20.2 -- An altstep-branch is selected if the Boolean guard is fulfilled.
// @id: TTCN3-CORE-20.2-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_test_013 {
    type component C {
        timer T_step := 0.1;
    }

    altstep a_step() runs on C {
        [] T_step.timeout {}
    }

    testcase TC() runs on C {
        T_step.start;
        alt {
            [false] a_step() {
                setverdict(fail);
            }
            [true] a_step() {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
