// @requirement: 20.4 -- a) Whenever a reception statement is executed, the following non-reception statements are subsequently executed until the next reception statement is reached, a break statement is reached, or the interleaved sequence ends.
// @id: TTCN3-CORE-20.4-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_04_the_interleave_statement_004 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        var charstring v_trace := "";
        connect(self:p1, self:p2);
        p1.send(integer:1);
        p1.send(integer:2);
        p2.check(receive(integer:1));
        interleave {
            [] p2.receive(integer:1) {
                v_trace := v_trace & "a";
                p1.send(integer:3);
                v_trace := v_trace & "b";
                p2.receive(integer:3);
                v_trace := v_trace & "c";
            }
            [] p2.receive(integer:2) {
                v_trace := v_trace & "x";
            }
        }
        if (v_trace == "abxc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
