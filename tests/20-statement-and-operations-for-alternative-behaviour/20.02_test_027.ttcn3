// @requirement: 20.2 -- In the case of the trigger operation the top message of the queue is also removed if the Boolean guard is fulfilled but the matching criteria is not.
// @id: TTCN3-CORE-20.2-035a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_test_027 {
    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    function f_send() runs on C {
        p.send(1);
        p.send(2);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_send());
        v_ptc.done;
        timer T_guard := 1.0;
        T_guard.start;
        alt {
            [] p.trigger(2) {
                setverdict(pass);
            }
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
