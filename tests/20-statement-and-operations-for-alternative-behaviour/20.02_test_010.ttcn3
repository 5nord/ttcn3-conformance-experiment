// @requirement: 20.2 -- Else-branches are always chosen and executed when they are reached (see below).
// @id: TTCN3-CORE-20.2-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_test_010 {
    type component C {}

    testcase TC() runs on C {
        timer T_1 := 5.0;
        T_1.start;
        alt {
            [] T_1.timeout {
                setverdict(fail);
            }
            [else] {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
