// @requirement: 20.2 -- The alt statement can also be left by using a goto statement in the selected branch of the alt (i.e. no branches of altsteps and defaults can be considered in this case), and execution continues with the statement following the label, `goto` is pointing to.
// @id: TTCN3-CORE-20.2-069a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_test_050 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        var boolean v_skipped := true;
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.send(integer:1);
        T.start;
        alt {
            [] p2.receive(integer:1) {
                goto L_after;
            }
            [] T.timeout {}
        }
        v_skipped := false;
        label L_after;
        if (v_skipped and T.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
