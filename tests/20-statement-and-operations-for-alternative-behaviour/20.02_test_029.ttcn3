// @requirement: 20.2 -- Dynamically unmapped and disconnected ports contribute to a snapshot in the same manner as mapped and connected ports.
// @id: TTCN3-CORE-20.2-042a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_test_029 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.send(integer:1);
        p2.check(receive(integer:1));
        disconnect(self:p1, self:p2);
        T.start;
        alt {
            [] p2.receive(integer:1) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
