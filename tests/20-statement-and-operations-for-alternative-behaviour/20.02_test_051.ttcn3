// @requirement: 20.2 -- The alt statement can also be left by using a goto statement in the selected branch of the alt (i.e. no branches of altsteps and defaults can be considered in this case), and execution continues with the statement following the label, `goto` is pointing to.
// @id: TTCN3-CORE-20.2-069b
// @verdict: pass reject
module M_20_02_test_051 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    altstep a_step() runs on C {
        [] p2.receive(integer:1) {
            goto L_after; // error: goto in altstep branch leaving the alt
        }
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(integer:1);
        alt {
            [] a_step();
        }
        setverdict(fail);
        label L_after;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
