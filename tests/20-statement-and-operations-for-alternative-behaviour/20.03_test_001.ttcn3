// @requirement: 20.3 -- repeat
// @id: TTCN3-CORE-20.3-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_03_test_001 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.send(integer:1);
        p1.send(integer:2);
        T.start;
        alt {
            [] p2.receive(integer:1) {
                repeat
            }
            [] p2.receive(integer:2) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
