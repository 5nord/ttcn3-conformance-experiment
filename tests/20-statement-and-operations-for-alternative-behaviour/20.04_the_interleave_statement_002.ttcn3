// @requirement: 20.4 -- interleave [ @nodefault ] "{" { "[]" ( TimeoutStatement | ReceiveStatement | TriggerStatement | GetCallStatement | CatchStatement | CheckStatement | GetReplyStatement | DoneStatement | KilledStatement ) StatementBlock } "}"
// @id: TTCN3-CORE-20.4-002b
// @verdict: pass reject
module M_20_04_the_interleave_statement_002 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        interleave {
            [] p1.send(integer:1) { // error: branch does not start with a reception statement
                setverdict(pass);
            }
            [] p2.receive(integer:1) {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
