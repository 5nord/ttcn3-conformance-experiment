// @requirement: 20.5.2 -- An activate operation if it is called with an AltstepRef will put the referenced altstep as the first element into the list of defaults and return a default reference.
// @id: TTCN3-CORE-20.5.2-003b
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_02_test_003 {

    type component C {
        timer T;
    }

    altstep a_1() runs on C {
        [] T.timeout {}
    }

    testcase TC() runs on C {
        var default v_def := null;
        v_def := activate(a_1());
        if (v_def != null) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
