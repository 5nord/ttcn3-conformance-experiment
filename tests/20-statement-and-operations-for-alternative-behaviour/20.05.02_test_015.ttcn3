// @requirement: 20.5.2 -- d) The ObjectReference shall be of default type.
// @id: TTCN3-CORE-20.5.2-017a
// @verdict: pass reject
module M_20_05_02_test_015 {

    type component C {}

    testcase TC() runs on C {
        var C v_comp := self;
        activate(v_comp); // error: ObjectReference is not of default type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
