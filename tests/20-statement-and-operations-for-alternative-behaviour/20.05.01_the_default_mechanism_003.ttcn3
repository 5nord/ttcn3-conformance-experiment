// @requirement: 20.5.1 -- An evoked default mechanism invokes the first altstep in the list of defaults, i.e. the last activated default, and waits for the result of its termination.
// @id: TTCN3-CORE-20.5.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_01_the_default_mechanism_003 {

    type component C {
        timer T;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; }
    }

    altstep a_2() runs on C {
        [] T.timeout {
            v_log := v_log & "2";
            f_work();
        }
    }

    function f_work() runs on C {
        timer T_work := 0.1;
        T_work.start;
        T_work.timeout;
        v_log := v_log & "w";
    }

    testcase TC() runs on C {
        activate(a_1());
        activate(a_2());
        T.start(0.1);
        T_guard.start(1.0);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        v_log := v_log & "m";
        if (v_log == "2wm") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
