// @requirement: 20.2 -- If an else branch is defined, the default mechanism will never be called, i.e. active defaults will never be entered.
// @id: TTCN3-CORE-20.2-057a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_test_039 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    altstep a_def() runs on C {
        [] p2.receive {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(integer:1);
        p2.check(receive(integer:1));
        activate(a_def());
        alt {
            [] p2.receive(integer:2) {
                setverdict(fail);
            }
            [else] {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
