// @requirement: 20.2 -- c) The evaluation of the event of an alt branch shall not have side effects.
// @id: TTCN3-CORE-20.2-075a
// @verdict: pass reject
module M_20_02_test_055 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
        var integer v_count := 0;
    }

    function f_value() runs on C return integer {
        v_count := v_count + 1;
        return v_count;
    }

    testcase TC() runs on C {
        alt {
            [] p.receive(integer:f_value()) { // error: event has side effect on component variable
                setverdict(pass);
            }
            [else] {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
