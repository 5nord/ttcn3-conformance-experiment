// @requirement: 20.2 -- NOTE 6: It is allowed to define more than one else branch in an alt statement or in an altstep, however always only the first else branch is executed.
// @id: TTCN3-CORE-20.2-060a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_the_alt_statement_042 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    altstep a_step() runs on C {
        [] p.receive {
            setverdict(fail);
        }
        [else] {
            setverdict(pass);
        }
        [else] {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        alt {
            [] p.receive {
                setverdict(fail);
            }
            [else] {
                a_step();
            }
            [else] {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
