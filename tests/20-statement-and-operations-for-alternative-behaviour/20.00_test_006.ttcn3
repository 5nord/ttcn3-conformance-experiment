// @requirement: 20.0 -- Deactivate a default; Col2: deactivate
// @id: TTCN3-CORE-20.0-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_00_test_006 {
    type component C {
        timer T_def := 0.1;
    }

    altstep a_default() runs on C {
        [] T_def.timeout {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var default v_def;
        timer T_guard := 0.5;
        v_def := activate(a_default());
        deactivate(v_def);
        T_def.start;
        T_guard.start;
        alt {
            [] T_guard.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
