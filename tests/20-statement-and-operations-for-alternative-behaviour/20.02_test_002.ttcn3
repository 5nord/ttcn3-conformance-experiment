// @requirement: 20.2 -- An alt statement may define some local definitions before its alternative branches.
// @id: TTCN3-CORE-20.2-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_test_002 {
    type component C {}

    testcase TC() runs on C {
        timer T_1 := 0.1;
        T_1.start;
        alt {
            var integer v_x := 1;
            const integer c_y := 2;
            [] T_1.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
