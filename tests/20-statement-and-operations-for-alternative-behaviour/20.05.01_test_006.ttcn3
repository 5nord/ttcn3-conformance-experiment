// @requirement: 20.5.1 -- NOTE 2: Due to the possibility of defining dynamic test configurations, an alternative in an altstep activated as default may refer to a disconnected or unmapped port at the time of its evaluation.
// @id: TTCN3-CORE-20.5.1-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_01_test_006 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1;
        port P p2;
        timer T;
    }

    altstep a_1() runs on C {
        [] p2.receive { setverdict(fail); }
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        disconnect(self:p1, self:p2);
        activate(a_1());
        T.start(0.2);
        alt {
            [] T.timeout { setverdict(pass); }
        }
    }

    control {
        execute(TC());
    }
}
