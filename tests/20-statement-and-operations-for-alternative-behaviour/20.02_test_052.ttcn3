// @requirement: 20.2 -- a) The open and close square brackets ("[…]") shall be present at the start of each alternative, even if they are empty.
// @id: TTCN3-CORE-20.2-071a
// @verdict: pass reject
module M_20_02_test_052 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        T.start;
        alt {
            [] p.receive {
                setverdict(fail);
            }
            T.timeout { // error: missing "[]"
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
