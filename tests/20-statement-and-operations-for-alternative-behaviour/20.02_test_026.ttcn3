// @requirement: 20.2 -- The selection causes execution of the receiving operation, i.e. removal of the matching message, call, reply or exception from the port queue, maybe an assignment of the received information to a variable and the execution of the statement block following the receiving operation.
// @id: TTCN3-CORE-20.2-034a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_test_026 {
    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    function f_send() runs on C {
        p.send(1);
        p.send(2);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        connect(self:p, v_ptc:p);
        v_ptc.start(f_send());
        v_ptc.done;
        var integer v_x := 0;
        var boolean v_blockExecuted := false;
        timer T_guard := 1.0;
        T_guard.start;
        alt {
            [] p.receive(integer:?) -> value v_x {
                v_blockExecuted := true;
            }
            [] T_guard.timeout {
                setverdict(fail);
                stop;
            }
        }
        alt {
            [] p.receive(2) {
                if (v_x == 1 and v_blockExecuted) {
                    setverdict(pass);
                } else {
                    setverdict(fail);
                }
            }
            [] p.receive {
                setverdict(fail);
            }
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
