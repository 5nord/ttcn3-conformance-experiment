// @requirement: 20.4 -- The goto statement can be used for defining jumps with statements blocks that do not contain reception statements and for specifying jumps out of interleave statements.
// @id: TTCN3-CORE-20.4-026b
// @verdict: pass accept, ttcn3verdict:pass
module M_20_04_the_interleave_statement_019 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        var boolean v_skipped := true;
        timer T := 2.0;
        connect(self:p1, self:p2);
        p1.send(integer:1);
        T.start;
        interleave {
            [] p2.receive(integer:1) {
                goto L_after;
            }
            [] T.timeout {}
        }
        v_skipped := false;
        label L_after;
        if (v_skipped and T.running) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        T.stop;
    }

    control {
        execute(TC());
    }
}
