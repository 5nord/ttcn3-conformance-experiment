// @requirement: 20.5.2 -- If the activate operation is called with an ObjectReference, it will re-activate the referenced default which was previously suspended by a deactivate operation.
// @id: TTCN3-CORE-20.5.2-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_02_test_007 {

    type component C {
        timer T;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; }
    }

    function f_wait() runs on C {
        T.start(0.1);
        T_guard.start(0.5);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        T_guard.stop;
    }

    testcase TC() runs on C {
        var default v_def := activate(a_1());
        deactivate(v_def, true);
        f_wait();
        activate(v_def);
        f_wait();
        if (v_log == "g1") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
