// @requirement: 20.2 -- f) An alt statement used inside control behaviour shall only contain timeout statements.
// @id: TTCN3-CORE-20.2-080a
// @verdict: pass reject
module M_20_02_test_059 {

    control {
        timer T := 1.0;
        T.start;
        alt {
            [] T.timeout {}
            [] all component.done {} // error: non-timeout event in control part
        }
    }
}
