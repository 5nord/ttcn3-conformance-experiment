// @requirement: 20.5.1 -- This means, the default mechanism also applies to interleave statements.
// @id: TTCN3-CORE-20.5.1-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_01_the_default_mechanism_004 {

    type component C {
        timer T;
        timer T_a;
        timer T_b;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; repeat; }
    }

    testcase TC() runs on C {
        activate(a_1());
        T.start(0.1);
        T_a.start(0.3);
        T_b.start(0.4);
        interleave {
            [] T_a.timeout { v_log := v_log & "a"; }
            [] T_b.timeout { v_log := v_log & "b"; }
        }
        if (v_log == "1ab") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
