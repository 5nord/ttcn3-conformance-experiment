// @requirement: 20.1 -- When entering an alt statement, a snapshot is taken.
// @id: TTCN3-CORE-20.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_01_the_snapshot_mechanism_001 {
    type component C {}

    testcase TC() runs on C {
        timer T_1 := 0.1;
        timer T_wait := 0.3;
        timer T_2 := 1.0;
        T_1.start;
        T_wait.start;
        T_wait.timeout;
        T_2.start;
        alt {
            [] T_2.timeout {
                setverdict(fail);
            }
            [] T_1.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
