// @requirement: 20.2 -- Execution also continues with the statement following the alt statement if a break statement is reached in the statement block of the selected branch of an alt statement, of an altstep used in an altstep-branch, or of an `altstep` invoked as default.
// @id: TTCN3-CORE-20.2-068a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_the_alt_statement_049 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
        var charstring v_trace := "";
    }

    altstep a_step() runs on C {
        [] p2.receive(integer:2) {
            v_trace := v_trace & "s";
            break;
        }
    }

    altstep a_def() runs on C {
        [] p2.receive(integer:3) {
            v_trace := v_trace & "d";
            break;
        }
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.send(integer:1);
        p1.send(integer:2);
        p1.send(integer:3);
        T.start;
        alt {
            [] p2.receive(integer:1) {
                v_trace := v_trace & "a";
                break;
            }
            [] T.timeout {}
        }
        v_trace := v_trace & "1";
        alt {
            [] a_step();
            [] T.timeout {}
        }
        v_trace := v_trace & "2";
        activate(a_def());
        alt {
            [] T.timeout {}
        }
        v_trace := v_trace & "3";
        if (v_trace == "a1s2d3") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
