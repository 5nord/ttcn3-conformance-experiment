// @requirement: 20.5.3 -- a) The ObjectReference shall be of default type.
// @id: TTCN3-CORE-20.5.3-011a
// @verdict: pass reject
module M_20_05_03_test_010 {

    type component C {}

    testcase TC() runs on C {
        var C v_comp := self;
        deactivate(v_comp); // error: ObjectReference is not of default type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
