// @requirement: 20.5.3 -- c) The optional Expression shall evaluate to a value, which is initialized.
// @id: TTCN3-CORE-20.5.3-014a
// @verdict: pass accept, ttcn3verdict:error
module M_20_05_03_test_014 {

    type component C {
        timer T;
    }

    altstep a_1() runs on C {
        [] T.timeout {}
    }

    testcase TC() runs on C {
        var boolean v_suspend;
        var default v_def := activate(a_1());
        setverdict(pass);
        deactivate(v_def, v_suspend); // error: Expression is uninitialized
    }

    control {
        execute(TC());
    }
}
