// @requirement: 20.5.1 -- An unsuccessful default execution may cause a new snapshot or a dynamic error if the test component is blocked (see clause 20.1).
// @id: TTCN3-CORE-20.5.1-015a
// @verdict: pass accept, ttcn3verdict:error
module M_20_05_01_the_default_mechanism_012 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1;
        port P p2;
    }

    altstep a_1() runs on C {
        [] p2.receive(3) {}
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        activate(a_1());
        p1.send(1);
        setverdict(pass);
        alt {
            [] p2.receive(2) {} // blocked: queued message matches neither alternative nor default
        }
    }

    control {
        execute(TC());
    }
}
