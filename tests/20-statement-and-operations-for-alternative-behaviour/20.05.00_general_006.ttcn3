// @requirement: 20.5.0 -- A default in the default list can be identified by means of default reference that is generated as a result of the corresponding activate operation.
// @id: TTCN3-CORE-20.5.0-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_00_general_006 {

    type component C {
        timer T;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; }
    }

    altstep a_2() runs on C {
        [] T.timeout { v_log := v_log & "2"; }
    }

    function f_wait() runs on C {
        T.start(0.1);
        T_guard.start(0.5);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        T_guard.stop;
    }

    testcase TC() runs on C {
        var default v_def1 := activate(a_1());
        var default v_def2 := activate(a_2());
        deactivate(v_def2);
        f_wait();
        if (v_def1 != v_def2 and v_log == "1") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
