// @requirement: 20.2 -- To avoid side effects the restrictions imposed on the contents of functions called from special places (clause 16.1.4) shall apply to the actual parameters of the invoked altstep.
// @id: TTCN3-CORE-20.2-078a
// @verdict: pass reject
module M_20_02_test_058 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
        var integer v_count := 0;
    }

    function f_inc() runs on C return integer {
        v_count := v_count + 1;
        return v_count;
    }

    altstep a_step(integer p_x) runs on C {
        [] p.receive(integer:p_x) {}
    }

    testcase TC() runs on C {
        alt {
            [] a_step(f_inc()); // error: actual parameter has side effect on component variable
            [else] {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
