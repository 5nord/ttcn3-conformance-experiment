// @requirement: 20.5.2 -- The activate operation can be called without saving the returned default reference.
// @id: TTCN3-CORE-20.5.2-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_02_the_activate_operation_012 {

    type component C {
        timer T;
        timer T_guard;
    }

    altstep a_1() runs on C {
        [] T.timeout { setverdict(pass); }
    }

    testcase TC() runs on C {
        activate(a_1());
        T.start(0.1);
        T_guard.start(1.0);
        alt {
            [] T_guard.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
