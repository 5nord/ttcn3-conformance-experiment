// @requirement: 20.2 -- b) The evaluation of a Boolean expression guarding an alternative shall not have side effects.
// @id: TTCN3-CORE-20.2-073a
// @verdict: pass reject
module M_20_02_test_053 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
        var integer v_count := 0;
    }

    function f_guard() runs on C return boolean {
        v_count := v_count + 1;
        return true;
    }

    testcase TC() runs on C {
        alt {
            [f_guard()] p.receive { // error: guard has side effect on component variable
                setverdict(pass);
            }
            [else] {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
