// @requirement: 20.5.1 -- The default mechanism is evoked at the end of each alt statement not annotated with the @nodefault modifier, if due to the actual snapshot none of the specified alternatives could be executed.
// @id: TTCN3-CORE-20.5.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_01_test_001 {

    type component C {
        timer T;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; }
    }

    testcase TC() runs on C {
        activate(a_1());
        T.start(0.1);
        T_guard.start(0.5);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        if (v_log == "1") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
