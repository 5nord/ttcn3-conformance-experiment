// @requirement: 20.5.1 -- In the case of an unsuccessful termination, the default mechanism invokes the next default in the list that is not in the suspended state.
// @id: TTCN3-CORE-20.5.1-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_01_test_009 {

    type component C {
        timer T;
        timer T_never;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; }
    }

    altstep a_2() runs on C {
        [] T.timeout { v_log := v_log & "2"; }
    }

    altstep a_3() runs on C {
        [] T_never.timeout { v_log := v_log & "3"; }
    }

    testcase TC() runs on C {
        activate(a_1());
        var default v_def2 := activate(a_2());
        activate(a_3());
        deactivate(v_def2, true);
        T.start(0.1);
        T_guard.start(0.5);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        if (v_log == "1") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
