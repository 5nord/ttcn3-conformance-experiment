// @requirement: 20.2 -- A killed-branch is selected if the Boolean guard is fulfilled and if the specified test component is in the list of killed components of the snapshot.
// @id: TTCN3-CORE-20.2-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_the_alt_statement_020 {
    type component C {}

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        timer T_guard := 1.0;
        v_ptc.kill;
        T_guard.start;
        alt {
            [false] v_ptc.killed {
                setverdict(fail);
            }
            [] v_ptc.killed {
                setverdict(pass);
            }
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
