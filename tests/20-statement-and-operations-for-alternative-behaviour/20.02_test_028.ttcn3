// @requirement: 20.2 -- In this case the statement block of the given alternative is not executed.
// @id: TTCN3-CORE-20.2-036a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_test_028 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.send(integer:1);
        T.start;
        alt {
            [] p2.trigger(integer:2) {
                setverdict(fail);
            }
            [] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
