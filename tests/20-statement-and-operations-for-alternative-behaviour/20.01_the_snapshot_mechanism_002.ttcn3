// @requirement: 20.1 -- A snapshot is considered to be a partial state of a test component that includes all information necessary to evaluate the Boolean conditions that guard alternative branches, all relevant stopped test components, all relevant timeout events and the top messages, calls, replies and exceptions in the relevant incoming port queues.
// @id: TTCN3-CORE-20.1-010b
// @verdict: pass accept, ttcn3verdict:pass
module M_20_01_the_snapshot_mechanism_002 {
    type component C {}

    testcase TC() runs on C {
        var integer v_x := 2;
        timer T_1 := 0.1;
        T_1.start;
        alt {
            [v_x <= 1] T_1.timeout {
                setverdict(fail);
            }
            [v_x > 1] T_1.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
