// @requirement: 20.5.2 -- This form is useful in test cases which do not require explicit deactivation of the activated default, i.e. deactivation of a default is done implicitly at MTC termination.
// @id: TTCN3-CORE-20.5.2-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_02_the_activate_operation_013 {

    type component C {
        timer T;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; }
    }

    function f_wait() runs on C {
        T.start(0.1);
        T_guard.start(0.5);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        T_guard.stop;
    }

    testcase TC_activate() runs on C {
        activate(a_1());
        f_wait();
        if (v_log == "1") { setverdict(pass); } else { setverdict(fail); }
    }

    testcase TC() runs on C {
        f_wait();
        if (v_log == "g") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC_activate());
        execute(TC());
    }
}
