// @requirement: 20.5.3 -- A deactivate operation without parameter deactivates all defaults of a test component.
// @id: TTCN3-CORE-20.5.3-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_03_the_deactivate_operation_007 {

    type component C {
        timer T;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; }
    }

    altstep a_2() runs on C {
        [] T.timeout { v_log := v_log & "2"; }
    }

    testcase TC() runs on C {
        activate(a_1());
        activate(a_2());
        deactivate;
        T.start(0.1);
        T_guard.start(0.5);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        if (v_log == "g") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
