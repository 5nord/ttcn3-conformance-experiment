// @requirement: 20.5.3 -- Calling a deactivate operation with the special value null as its ObjectReference has no effect.
// @id: TTCN3-CORE-20.5.3-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_03_the_deactivate_operation_008 {

    type component C {
        timer T;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; }
    }

    testcase TC() runs on C {
        var default v_null := null;
        activate(a_1());
        deactivate(v_null);
        T.start(0.1);
        T_guard.start(0.5);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        if (v_log == "1") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
