// @requirement: 20.5.3 -- A deactivate operation will remove the referenced default from the list of defaults if the optional Expression evaluates to false, otherwise it marks the referenced default in the list of defaults as suspended.
// @id: TTCN3-CORE-20.5.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_03_test_002 {

    type component C {
        timer T;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; }
    }

    altstep a_2() runs on C {
        [] T.timeout { v_log := v_log & "2"; }
    }

    function f_wait() runs on C {
        T.start(0.1);
        T_guard.start(0.5);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        T_guard.stop;
    }

    testcase TC() runs on C {
        var default v_def1 := activate(a_1());
        var default v_def2 := activate(a_2());
        deactivate(v_def2, false);
        f_wait();
        deactivate(v_def1, false);
        f_wait();
        if (v_log == "1g") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
