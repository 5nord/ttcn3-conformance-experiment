// @requirement: 20.5.0 -- If an activate operation creates a new default, it is inserted as the first element into the list.
// @id: TTCN3-CORE-20.5.0-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_00_general_003 {

    type component C {
        timer T;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; }
    }

    altstep a_2() runs on C {
        [] T.timeout { v_log := v_log & "2"; }
    }

    function f_wait() runs on C {
        T.start(0.1);
        T_guard.start(0.5);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        T_guard.stop;
    }

    testcase TC() runs on C {
        activate(a_1());
        f_wait();
        activate(a_2());
        f_wait();
        if (v_log == "12") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
