// @requirement: 20.4 -- It is also not allowed to specify else branches in interleaved behaviour.
// @id: TTCN3-CORE-20.4-022a
// @verdict: pass reject
module M_20_04_the_interleave_statement_013 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(integer:1);
        interleave {
            [] p2.receive(integer:1) {
                setverdict(pass);
            }
            [else] { // error: else branch in interleave
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
