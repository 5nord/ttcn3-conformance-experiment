// @requirement: 20.5.1 -- Dynamically unmapped and disconnected ports contribute to a snapshot in the same manner as mapped and connected ports.
// @id: TTCN3-CORE-20.5.1-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_01_the_default_mechanism_007 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1;
        port P p2;
        timer T_guard;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(5);
        T_guard.start(1.0);
        alt {
            [] p2.check(receive(5)) {}
            [] T_guard.timeout { setverdict(fail); stop; }
        }
        disconnect(self:p1, self:p2);
        alt {
            [] p2.receive(5) { setverdict(pass); }
            [] T_guard.timeout { setverdict(fail); }
        }
    }

    control {
        execute(TC());
    }
}
