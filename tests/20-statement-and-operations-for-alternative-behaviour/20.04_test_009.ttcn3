// @requirement: 20.4 -- c) The evaluation then continues by taking the next snapshot if no break statement was encountered.
// @id: TTCN3-CORE-20.4-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_04_test_009 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_trace := "";
        timer T1 := 0.1;
        timer T2 := 0.3;
        T1.start;
        T2.start;
        interleave {
            [] T2.timeout {
                v_trace := v_trace & "2";
            }
            [] T1.timeout {
                v_trace := v_trace & "1";
            }
        }
        if (v_trace == "12") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
