// @requirement: 20.4 -- The loop statements for, while, and do-while can be used within statements blocks that do not contain reception statements.
// @id: TTCN3-CORE-20.4-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_04_the_interleave_statement_016 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        var integer v_for := 0;
        var integer v_while := 0;
        var integer v_do := 0;
        connect(self:p1, self:p2);
        p1.send(integer:1);
        p1.send(integer:2);
        p1.send(integer:3);
        interleave {
            [] p2.receive(integer:1) {
                for (var integer i := 0; i < 3; i := i + 1) {
                    v_for := v_for + 1;
                }
            }
            [] p2.receive(integer:2) {
                while (v_while < 3) {
                    v_while := v_while + 1;
                }
            }
            [] p2.receive(integer:3) {
                do {
                    v_do := v_do + 1;
                } while (v_do < 3);
            }
        }
        if (v_for == 3 and v_while == 3 and v_do == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
