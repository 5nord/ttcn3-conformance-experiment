// @requirement: 20.2 -- These can be used by all the branches.
// @id: TTCN3-CORE-20.2-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_test_003 {
    type component C {}

    testcase TC() runs on C {
        timer T_1 := 0.1;
        timer T_2 := 1.0;
        T_1.start;
        T_2.start;
        alt {
            var integer v_x := 5;
            [v_x > 10] T_1.timeout {
                setverdict(fail);
            }
            [v_x == 5] T_1.timeout {
                if (v_x == 5) {
                    setverdict(pass);
                }
            }
            [] T_2.timeout {
                v_x := 0;
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
