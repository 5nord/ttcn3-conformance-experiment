// @requirement: 20.2 -- TTCN-3 allows the invocation of altsteps as alternatives in alt statements (see clause 16.2.1).
// @id: TTCN3-CORE-20.2-064a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_02_test_045 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    altstep a_step() runs on C {
        [] p2.receive(integer:1) {
            setverdict(pass);
        }
    }

    testcase TC() runs on C {
        timer T := 1.0;
        connect(self:p1, self:p2);
        p1.send(integer:1);
        T.start;
        alt {
            [] a_step();
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
