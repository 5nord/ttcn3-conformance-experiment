// @requirement: 20.2 -- The test case shall stop and indicate a dynamic error if a test component is completely blocked.
// @id: TTCN3-CORE-20.2-046a
// @verdict: pass accept, ttcn3verdict:error
module M_20_02_test_033 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(integer:1);
        p2.check(receive(integer:1));
        disconnect(self:p1, self:p2);
        setverdict(pass);
        alt {
            [] p2.receive(integer:2) { // completely blocked: dynamic error
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
