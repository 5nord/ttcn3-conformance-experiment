// @requirement: 20.5.1 -- If the last default in the list has terminated unsuccessfully, the default mechanism will return to the place in the alt statement in which it has been invoked, i.e. at the end of the alt statement, and indicate an unsuccessful default execution.
// @id: TTCN3-CORE-20.5.1-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_01_test_010 {

    type component C {
        timer T;
        timer T_never;
        timer T_other;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T_never.timeout { v_log := v_log & "1"; }
    }

    altstep a_2() runs on C {
        [] T_other.timeout { v_log := v_log & "2"; }
    }

    testcase TC() runs on C {
        activate(a_1());
        activate(a_2());
        T.start(0.2);
        alt {
            [] T.timeout { v_log := v_log & "m"; }
        }
        if (v_log == "m") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
