// @requirement: 20.4 -- d) The restricted use of the control transfer statements for, while, do-while, and goto within interleave statements is allowed under the following conditions:
// @id: TTCN3-CORE-20.4-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_04_the_interleave_statement_015 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p1, p2;
    }

    testcase TC() runs on C {
        var integer v_sum := 0;
        connect(self:p1, self:p2);
        p1.send(integer:1);
        p1.send(integer:2);
        interleave {
            [] p2.receive(integer:1) {
                for (var integer i := 0; i < 3; i := i + 1) {
                    v_sum := v_sum + 1;
                }
                while (v_sum < 5) {
                    v_sum := v_sum + 1;
                }
                do {
                    v_sum := v_sum + 1;
                } while (v_sum < 6);
            }
            [] p2.receive(integer:2) {
                goto L_skip;
                v_sum := v_sum + 100;
                label L_skip;
            }
        }
        if (v_sum == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
