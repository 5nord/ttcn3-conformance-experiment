// @requirement: 20.0 -- Activate a default; Col2: activate
// @id: TTCN3-CORE-20.0-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_00_test_005 {
    type component C {
        timer T_def := 0.1;
    }

    altstep a_default() runs on C {
        [] T_def.timeout {
            setverdict(pass);
        }
    }

    testcase TC() runs on C {
        var default v_def;
        timer T_guard := 1.0;
        v_def := activate(a_default());
        T_def.start;
        T_guard.start;
        alt {
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
