// @requirement: 20.5.0 -- Re-activated defaults that were previously suspended retain their position in the list.
// @id: TTCN3-CORE-20.5.0-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_20_05_00_test_004 {

    type component C {
        timer T;
        timer T_guard;
        var charstring v_log := "";
    }

    altstep a_1() runs on C {
        [] T.timeout { v_log := v_log & "1"; }
    }

    altstep a_2() runs on C {
        [] T.timeout { v_log := v_log & "2"; }
    }

    altstep a_3() runs on C {
        [] T.timeout { v_log := v_log & "3"; }
    }

    function f_wait() runs on C {
        T.start(0.1);
        T_guard.start(0.5);
        alt {
            [] T_guard.timeout { v_log := v_log & "g"; }
        }
        T_guard.stop;
    }

    testcase TC() runs on C {
        var default v_def1 := activate(a_1());
        var default v_def2 := activate(a_2());
        var default v_def3 := activate(a_3());
        deactivate(v_def2, true);
        activate(v_def2);
        f_wait();
        deactivate(v_def3);
        f_wait();
        if (v_log == "32") { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
