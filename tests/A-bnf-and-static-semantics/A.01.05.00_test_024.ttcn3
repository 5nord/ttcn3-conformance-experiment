// @requirement: A.1.5.0 -- The TTCN-3 terminals listed in table A.3 shall not be used as identifiers in a TTCN-3 module.
// @id: TTCN3-CORE-A.1.5.0-030a
// @verdict: pass reject
module M_A_01_05_00_test_024 {

    type component C {}

    testcase TC() runs on C {
        var integer repeat := 1; // error: reserved word used as identifier
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
