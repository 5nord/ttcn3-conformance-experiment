// @requirement: A.1.3 -- TTCN-3 identifiers are case sensitive and shall only contain lowercase letters (a-z) uppercase letters (A-Z), numeric digits (0-9) and the underscore ( _ ) symbol.
// @id: TTCN3-CORE-A.1.3-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_03_test_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_value := 1;
        var integer V_VALUE := 2;
        var integer v_Value := 3;
        if (v_value == 1 and V_VALUE == 2 and v_Value == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
