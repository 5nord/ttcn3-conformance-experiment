// @requirement: A.1.5.1 -- A single CR(13) character directly followed by an LF(10) character denote a single end of line (i.e. the sequence CRLFCRLFVT denotes 3 lines):
// @id: TTCN3-CORE-A.1.5.1-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_01_test_004 {

    type component C {}

    testcase TC() runs on C {
        var integer v_n := 0;
        // CR LF
        v_n := v_n + 1;
        // CR LF CR LF VT

        v_n := v_n + 1;
        if (v_n == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
