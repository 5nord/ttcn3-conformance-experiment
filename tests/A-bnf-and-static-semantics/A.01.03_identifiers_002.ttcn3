// @requirement: A.1.3 -- TTCN-3 identifiers are case sensitive and shall only contain lowercase letters (a-z) uppercase letters (A-Z), numeric digits (0-9) and the underscore ( _ ) symbol.
// @id: TTCN3-CORE-A.1.3-001b
// @verdict: pass reject
module M_A_01_03_identifiers_002 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a$b := 1; // error: identifier contains a character other than a-z, A-Z, 0-9 and _
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
