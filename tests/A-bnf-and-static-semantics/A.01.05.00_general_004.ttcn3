// @requirement: A.1.5.0 -- Begin/end block symbols: Ellipsis; { }: ...
// @id: TTCN3-CORE-A.1.5.0-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_general_004 {

    type component C {}

    function f_count(integer p_a...) return integer {
        return lengthof(p_a);
    }

    testcase TC() runs on C {
        if (f_count(1, 2, 3) == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
