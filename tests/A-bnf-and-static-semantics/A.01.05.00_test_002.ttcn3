// @requirement: A.1.5.0 -- Begin/end block symbols: Element specifier symbols; { }: [ ]
// @id: TTCN3-CORE-A.1.5.0-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_test_002 {

    type component C {}

    testcase TC() runs on C {
        var integer v_arr[3] := { 1, 2, 3 };
        var charstring v_s := "abc";
        v_arr[1] := 5;
        if (v_arr[1] == 5 and v_s[2] == "c") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
