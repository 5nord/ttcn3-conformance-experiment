// @requirement: A.1.6.8.1 -- The square brackets with dash shall be used when referencing inner types of a record of, set of or array type.
// @id: TTCN3-CORE-A.1.6.8.1-001c
// @verdict: pass accept, noexecution
module M_A_01_06_08_01_with_statement_003 {

    type record R {
        record of record {
            integer f_inner
        } f_list
    }
    with {
        display (f_list[-].f_inner) "inner type field"
    }
}
