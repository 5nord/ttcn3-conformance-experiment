// @requirement: A.1.6.4.2 -- FieldReference shall not be ParRef
// @id: TTCN3-CORE-A.1.6.4.2-002a
// @verdict: pass reject
module M_A_01_06_04_02_port_operations_003 {

    type record R {
        integer f1
    }

    signature S(inout integer p_a) return R;

    type port P procedure {
        inout S
    }

    type component C {
        port P p;
    }

    function f_client() runs on C {
        var integer v_x;
        p.call(S:{p_a := 1}, 1.0) {
            [] p.getreply(S:{p_a := ?} value ?) -> value (v_x := p_a) {} // error: signature parameter used as field reference
            [] p.catch(timeout) {}
        }
    }
}
