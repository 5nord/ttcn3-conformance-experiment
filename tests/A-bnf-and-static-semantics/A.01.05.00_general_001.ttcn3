// @requirement: A.1.5.0 -- Begin/end block symbols: Begin/end list symbols; { }: ( )
// @id: TTCN3-CORE-A.1.5.0-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_general_001 {

    type component C {}

    function f_mul(integer p_a, integer p_b) return integer {
        return p_a * p_b;
    }

    testcase TC() runs on C {
        if (f_mul((1 + 2), 3) == 9) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
