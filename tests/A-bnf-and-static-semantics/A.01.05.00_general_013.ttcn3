// @requirement: A.1.5.0 -- Begin/end block symbols: Wildcard/matching symbols; { }: ? *
// @id: TTCN3-CORE-A.1.5.0-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_general_013 {

    type record R {
        integer f1,
        integer f2 optional
    }

    template R mw_r := { f1 := ?, f2 := * };

    type component C {}

    testcase TC() runs on C {
        var R v_r1 := { f1 := 1, f2 := omit };
        var R v_r2 := { f1 := 2, f2 := 3 };
        if (match(v_r1, mw_r) and match(v_r2, mw_r)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
