// @requirement: A.1.6.8.3 -- If only one MulExpression exists, it shall not derive to a CompoundExpression.
// @id: TTCN3-CORE-A.1.6.8.3-016d
// @verdict: pass reject
module M_A_01_06_08_03_basic_statements_023 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := {'01'B} << 1; // error: shift operand is a compound expression
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
