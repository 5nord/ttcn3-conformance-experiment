// @requirement: A.1.2 -- The semi-colon is optional if the language construct ends with a right-hand curly brace (}) or the following symbol is a right-hand curly brace (}), i.e. the language construct is the last statement in a statement block.
// @id: TTCN3-CORE-A.1.2-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_02_test_002 {

    type record R {
        integer f1
    }
    const R c_r := { f1 := 1 }

    type component C {}

    testcase TC() runs on C {
        var integer v_a := 0;
        if (c_r.f1 == 1) {
            v_a := 1;
        }
        for (var integer i := 0; i < 2; i := i + 1) {
            v_a := v_a + 1;
        }
        if (v_a == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
