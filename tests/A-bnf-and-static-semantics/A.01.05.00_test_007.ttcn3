// @requirement: A.1.5.0 -- Begin/end block symbols: Arithmetic operator symbols; { }: + / - *
// @id: TTCN3-CORE-A.1.5.0-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_test_007 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a := 3 + 4 * 2 - 6 / 3;
        if (v_a == 9) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
