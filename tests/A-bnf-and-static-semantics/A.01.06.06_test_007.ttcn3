// @requirement: A.1.6.6 -- Any sequence of newline characters that constitute a newline by using the following C0 control characters: LF(10), VT(11), FF(12), CR(13) (jointly called newline characters, see clause A.1.5.1) from the character set defined in Recommendation ITU-T T.50.
// @id: TTCN3-CORE-A.1.6.6-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_06_06_test_007 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '0101\
1010'B;
        if (v_b == '01011010'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
