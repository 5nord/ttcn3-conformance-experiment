// @requirement: A.1.5.0 -- These terminals shall also be written in all lowercase letters.
// @id: TTCN3-CORE-A.1.5.0-033a
// @verdict: pass reject
module M_A_01_05_00_test_027 {

    type component C {}

    testcase TC() runs on C {
        if (match("ABC", pattern @NoCase "abc")) { // error: modifier not written in lowercase letters
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
