// @requirement: A.1.6.8.1 -- The Identifier refers to a type definition if the type of the VarInstance or ReferencedValue in which the ExtendedFieldOrReference is used is anytype.
// @id: TTCN3-CORE-A.1.6.8.1-001a
// @verdict: pass accept, noexecution
module M_A_01_06_08_01_test_001 {

    type integer MyInt;

    type record R {
        anytype f_any
    }
    with {
        display (f_any.MyInt) "alternative selected by type name"
    }
}
with {
    extension "anytype MyInt"
}
