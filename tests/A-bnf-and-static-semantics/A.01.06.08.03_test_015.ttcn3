// @requirement: A.1.6.8.3 -- if the shift op is "<<" or ">>" then the left-hand operand shall resolve to either bitstring, hexstring or octetstring type or derivatives of these types. If the shift op is "
// @id: TTCN3-CORE-A.1.6.8.3-011c
// @verdict: pass reject
module M_A_01_06_08_03_test_015 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        v_i := v_i >> 1; // error: left-hand operand of >> is not a binary string
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
