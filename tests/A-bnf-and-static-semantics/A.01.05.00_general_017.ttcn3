// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_general_017 {

    type component C {}

    testcase TC() runs on C {
        var float v_f := 1.5E2;
        if (v_f == 150.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
