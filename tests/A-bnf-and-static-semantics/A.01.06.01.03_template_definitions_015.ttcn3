// @requirement: A.1.6.1.3 -- Characters "?", "*", "\", "[", "]", "{", "}", """, "|", "(", ")", "#", "+", "d", "^", "N" have special semantics – they are metacharacters for the definition of pattern elements – only if they follow the BNF as defined above, if not they are interpreted like normal characters
// @id: TTCN3-CORE-A.1.6.1.3-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_06_01_03_template_definitions_015 {

    type component C {}

    testcase TC() runs on C {
        template charstring t_a := pattern "dN^}";

        if (match("dN^}", t_a) and not match("1N^}", t_a)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
