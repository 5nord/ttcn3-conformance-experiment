// @requirement: A.1.6.8.3 -- If more than one XorExpression exists, then the XorExpressions shall evaluate to specific values of compatible types
// @id: TTCN3-CORE-A.1.6.8.3-005a
// @verdict: pass reject
module M_A_01_06_08_03_test_006 {

    type component C {}

    testcase TC() runs on C {
        var boolean v_b := true;
        var integer v_i := 1;
        if (v_b or v_i) { // error: operands of or have incompatible types
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
