// @requirement: A.1.6.1.3 -- if a value parameter is used, an in-line template shall evaluate to a value
// @id: TTCN3-CORE-A.1.6.1.3-015a
// @verdict: pass reject
module M_A_01_06_01_03_test_021 {

    type component C {}

    function f_a(in integer p_x) return integer {
        return p_x;
    }

    testcase TC() runs on C {
        var integer v_a := f_a(p_x := ?); // error: template for value parameter
        setverdict(pass);
    }
}
