// @requirement: A.1.6.8.3 -- DecodedFieldReference shall not appear on the left-hand side of assignments
// @id: TTCN3-CORE-A.1.6.8.3-019c
// @verdict: pass reject
module M_A_01_06_08_03_basic_statements_029 {

    type record Inner {
        integer f1
    }
    with {
        encode "MyCodec"
    }

    type record PDU {
        octetstring payload
    }

    type component C {}

    testcase TC() runs on C {
        var PDU v_pdu := {payload := '00'O};
        var Inner v_inner := {f1 := 1};
        v_pdu.payload=>Inner := v_inner; // error: decoded field reference on the left-hand side
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
