// @requirement: A.1.5.0 -- Additionally, there are special TTCN-3 terminals consisting of an @-symbol, directly followed by an identifier.
// @id: TTCN3-CORE-A.1.5.0-032a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_test_026 {

    type component C {}

    testcase TC() runs on C {
        if (match("ABC", pattern @nocase "abc")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
