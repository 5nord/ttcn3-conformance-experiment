// @requirement: A.1.6.8.3 -- If the not4b operator exists, the operand shall be of type bitstring, octetstring or hexstring or derivatives of these types.
// @id: TTCN3-CORE-A.1.6.8.3-015a
// @verdict: pass reject
module M_A_01_06_08_03_test_019 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        v_i := not4b v_i; // error: operand of not4b is not a binary string
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
