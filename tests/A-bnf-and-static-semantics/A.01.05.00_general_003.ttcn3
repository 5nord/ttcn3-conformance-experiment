// @requirement: A.1.5.0 -- Begin/end block symbols: Range symbol; { }: ..
// @id: TTCN3-CORE-A.1.5.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_general_003 {

    type integer Small (1 .. 10);

    type component C {}

    testcase TC() runs on C {
        var Small v_s := 5;
        if (match(v_s, (1..5)) and not match(6, (1..5))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
