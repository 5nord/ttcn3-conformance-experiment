// @requirement: A.1.5.1 -- The characters of the C0 set of Recommendation ITU-T T.50 [4] and of annex A of Recommendation ITU-T T.50 [4] below are denoting newline (end of line). LF - LINE FEED (10); VT - VERTICAL TABULATION (11); FF - FORM FEED (12); CR - CARRIAGE RETURN (13)
// @id: TTCN3-CORE-A.1.5.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_01_use_of_whitespaces_and_newlines_003 {

    type component C {}

    testcase TC() runs on C {
        var integer v_n := 0;
        // LF
        v_n := v_n + 1;
        // VT        v_n := v_n + 1;
        // FF        v_n := v_n + 1;
        // CR
        v_n := v_n + 1;
        if (v_n == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
