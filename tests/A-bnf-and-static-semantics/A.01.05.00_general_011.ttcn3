// @requirement: A.1.5.0 -- Begin/end block symbols: Rotate operator symbols; { }: <@ @>
// @id: TTCN3-CORE-A.1.5.0-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_general_011 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '1001'B;
        if ((v_b <@ 1) == '0011'B and (v_b @> 1) == '1100'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
