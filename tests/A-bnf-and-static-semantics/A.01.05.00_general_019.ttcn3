// @requirement: A.1.5.0 -- Begin/end block symbols: Field reference; { }: .
// @id: TTCN3-CORE-A.1.5.0-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_general_019 {

    type record R {
        integer f1
    }

    type component C {}

    testcase TC() runs on C {
        var R v_r := { f1 := 0 };
        v_r.f1 := 7;
        if (v_r.f1 == 7) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
