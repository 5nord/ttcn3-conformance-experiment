// @requirement: A.1.6.8.3 -- Each UnaryExpression shall resolve to a specific Value.
// @id: TTCN3-CORE-A.1.6.8.3-017a
// @verdict: pass reject
module M_A_01_06_08_03_test_024 {

    type component C {}

    testcase TC() runs on C {
        var template integer vt_i := (1 .. 3);
        var integer v_i := vt_i * 2; // error: operand of * is not a specific value
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
