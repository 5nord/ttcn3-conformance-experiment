// @requirement: A.1.6.6 -- The second option is used only for referencing enumerated values,
// @id: TTCN3-CORE-A.1.6.6-001a
// @verdict: pass reject
module M_A_01_06_06_value_001 {

    type integer MyInt;

    const MyInt c_one := 1;

    type component C {}

    testcase TC() runs on C {
        var MyInt v_x := MyInt.c_one; // error: type-qualified reference to a value that is not an enumerated value
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
