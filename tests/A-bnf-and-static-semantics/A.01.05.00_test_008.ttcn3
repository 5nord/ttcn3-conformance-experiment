// @requirement: A.1.5.0 -- Begin/end block symbols: Concatenation operator symbol; { }: &
// @id: TTCN3-CORE-A.1.5.0-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_test_008 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_s := "ab" & "cd";
        if (v_s == "abcd") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
