// @requirement: A.1.5.0 -- Begin/end block symbols: Statement separator symbol; { }: ;
// @id: TTCN3-CORE-A.1.5.0-010a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_test_006 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a := 0; v_a := v_a + 1; v_a := v_a * 2;
        if (v_a == 2) { setverdict(pass); } else { setverdict(fail); }
    }

    control {
        execute(TC());
    }
}
