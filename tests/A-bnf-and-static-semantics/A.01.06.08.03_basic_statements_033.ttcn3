// @requirement: A.1.6.8.3 -- Operands of the "*", "/", rem or mod operators shall be of type integer or float or derivations of integer or float (i.e. subrange)
// @id: TTCN3-CORE-A.1.6.8.3-022a
// @verdict: pass reject
module M_A_01_06_08_03_basic_statements_033 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_s := "7";
        var integer v_i := v_s mod 2; // error: operand of mod is not integer or float
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
