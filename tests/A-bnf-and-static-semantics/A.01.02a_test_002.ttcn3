// @requirement: A.1.2a -- In addition TTCN-3 allows optional trailing commas in comma-separated lists with a variable number of items, i.e. an optional comma is allowed immediately before the closing right hand brace (")") or a right-hand curly brace (}) of a list or before the start of the next lexical symbol indicated by a left-hand curly brace ("{") or a semi-colon (";").
// @id: TTCN3-CORE-A.1.2a-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_02a_test_002 {

    type enumerated E { e_a, e_b, }

    type component C1 {}
    type component C2 {}
    type component C extends C1, C2, {}

    const integer c_a := 1, c_b := 2,;

    function f_add(integer p_a, integer p_b,) return integer {
        return p_a + p_b;
    }

    testcase TC() runs on C {
        var E v_e := e_b;
        if (f_add(c_a, c_b,) == 3 and v_e == e_b) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
