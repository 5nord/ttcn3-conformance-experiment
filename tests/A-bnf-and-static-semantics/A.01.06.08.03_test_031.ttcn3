// @requirement: A.1.6.8.3 -- The Identifier shall resolve into a type
// @id: TTCN3-CORE-A.1.6.8.3-020a
// @verdict: pass reject
module M_A_01_06_08_03_test_031 {

    type record Inner {
        integer f1
    }
    with {
        encode "MyCodec"
    }

    type record PDU {
        octetstring payload
    }

    const Inner c_inner := {f1 := 1};

    type component C {}

    testcase TC() runs on C {
        var PDU v_pdu := {payload := '00'O};
        var Inner v_inner := v_pdu.payload=>c_inner; // error: identifier after => is not a type
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
