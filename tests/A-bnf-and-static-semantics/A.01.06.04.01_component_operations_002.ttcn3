// @verdict: pass reject
module M_A_01_06_04_01_component_operations_002 {

    type component C {}

    function f_ptc() runs on C {
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_ptc());
