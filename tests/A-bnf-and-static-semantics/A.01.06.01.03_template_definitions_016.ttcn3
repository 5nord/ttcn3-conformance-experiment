// @requirement: A.1.6.1.3 -- Characters "[", "-", "^", "]", "\", "q", ","have special semantics – they are metacharacters for the definition of pattern class characters – only if they follow the BNF as defined above, if not they are interpreted like normal characters
// @id: TTCN3-CORE-A.1.6.1.3-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_06_01_03_template_definitions_016 {

    type component C {}

    testcase TC() runs on C {
        template charstring t_a := pattern "[q,][-a]";

        if (match("q-", t_a) and match(",a", t_a) and not match("(a", t_a)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
