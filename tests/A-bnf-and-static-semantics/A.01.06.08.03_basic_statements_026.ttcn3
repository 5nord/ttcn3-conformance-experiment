// @requirement: A.1.6.8.3 -- Primary shall resolve to a specific Value of type integer or float or derivatives of these types.
// @id: TTCN3-CORE-A.1.6.8.3-018a
// @verdict: pass reject
module M_A_01_06_08_03_basic_statements_026 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '01'B;
        v_b := -v_b; // error: operand of unary - is not integer or float
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
