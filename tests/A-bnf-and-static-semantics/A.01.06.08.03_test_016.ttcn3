// @requirement: A.1.6.8.3 -- If more than one BitXorExpression exists, then the BitXorExpressions shall evaluate to specific values of compatible types
// @id: TTCN3-CORE-A.1.6.8.3-012a
// @verdict: pass reject
module M_A_01_06_08_03_test_016 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '00001111'B;
        var octetstring v_o := '0F'O;
        var bitstring v_r := v_b or4b v_o; // error: operands of or4b have incompatible types
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
