// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_06_06_test_002 {

    type record R {
        integer f1
    }

    const R c_rec := {f1 := 1};

    type component C {}

    testcase TC() runs on C {
        var integer v_x := M_A_01_06_06_test_002.c_rec.f1;
        if (v_x == 1 and c_rec.f1 == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
