// @requirement: A.1.6.8.3 -- The Identifier refers to a type definition if the type of the VarInstance or ReferencedValue in which the ExtendedFieldReference is used is anytype.
// @id: TTCN3-CORE-A.1.6.8.3-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_06_08_03_test_027 {

    type integer MyInt;

    type component C {}

    testcase TC() runs on C {
        var anytype v_any;
        v_any.MyInt := 5;
        if (ischosen(v_any.MyInt) and v_any.MyInt == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
with {
    extension "anytype MyInt"
}
