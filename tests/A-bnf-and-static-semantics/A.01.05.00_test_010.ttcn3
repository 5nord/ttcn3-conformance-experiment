// @requirement: A.1.5.0 -- Begin/end block symbols: Shift operator symbols; { }: << >>
// @id: TTCN3-CORE-A.1.5.0-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_test_010 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '0110'B;
        if ((v_b << 1) == '1100'B and (v_b >> 1) == '0011'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
