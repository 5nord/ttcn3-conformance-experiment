// @requirement: A.1.6.1.3 -- IndexRef shall be optionally used for array types and TTCN-3 record of, set of and map types.
// @id: TTCN3-CORE-A.1.6.1.3-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_06_01_03_template_definitions_009 {

    type record of integer RoI;
    type set of integer SoI;
    type map from integer to integer MapI;

    type component C {}

    testcase TC() runs on C {
        var RoI v_roi := { [0] := 1, [1] := 2 };
        var SoI v_soi := { [0] := 3, [1] := 4 };
        var integer v_arr[2] := { [0] := 5, [1] := 6 };
        var MapI v_map := { [10] := 7, [20] := 8 };

        if (v_roi[1] == 2 and v_soi[0] == 3 and v_arr[1] == 6 and v_map[20] == 8) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
