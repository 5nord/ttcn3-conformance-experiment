// @requirement: A.1.6.4.2 -- TemplateBody shall be type compatible with the return type.
// @id: TTCN3-CORE-A.1.6.4.2-001a
// @verdict: pass reject
module M_A_01_06_04_02_test_001 {

    signature S() return integer;

    type port P procedure {
        inout S
    }

    type component C {
        port P p;
    }

    function f_server() runs on C {
        p.getcall(S:{});
        p.reply(S:{} value "abc"); // error: reply value not compatible with return type integer
    }
}
