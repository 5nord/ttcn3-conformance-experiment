// @requirement: A.1.2 -- The semi-colon is optional if the language construct ends with a right-hand curly brace (}) or the following symbol is a right-hand curly brace (}), i.e. the language construct is the last statement in a statement block.
// @id: TTCN3-CORE-A.1.2-002b
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_02_statement_terminator_symbols_003 {

    type component C {
        var integer v_c := 1
    }

    function f_get() runs on C return integer {
        return v_c
    }

    testcase TC() runs on C {
        if (f_get() == 1) {
            setverdict(pass)
        } else {
            setverdict(fail)
        }
    }

    control {
        execute(TC())
    }
}
