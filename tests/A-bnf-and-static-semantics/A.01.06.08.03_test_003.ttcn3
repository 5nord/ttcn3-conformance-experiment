// @requirement: A.1.6.8.3 -- Within CompoundConstExpression the ArrayConstExpression can be used for arrays, record, record of and set of types.
// @id: TTCN3-CORE-A.1.6.8.3-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_06_08_03_test_003 {

    type record R {
        integer f1,
        boolean f2
    }

    type record of integer RoI;

    type set of integer SoI;

    type integer IntArray[2];

    const R c_rec := {1, true};
    const RoI c_list := {1, 2};
    const SoI c_set := {3, 4};
    const IntArray c_arr := {5, 6};

    type component C {}

    testcase TC() runs on C {
        if (c_rec.f1 == 1 and c_rec.f2 and c_list[1] == 2 and lengthof(c_set) == 2
            and c_arr[0] == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
