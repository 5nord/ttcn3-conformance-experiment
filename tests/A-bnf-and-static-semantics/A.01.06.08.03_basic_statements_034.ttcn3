// @requirement: A.1.6.8.3 -- Operands of the "+" or "-" operators shall be of type integer or float or derivations of integer or float (i.e. subrange)
// @id: TTCN3-CORE-A.1.6.8.3-023a
// @verdict: pass reject
module M_A_01_06_08_03_basic_statements_034 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_s := "abc";
        v_s := +v_s; // error: operand of unary + is not integer or float
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
