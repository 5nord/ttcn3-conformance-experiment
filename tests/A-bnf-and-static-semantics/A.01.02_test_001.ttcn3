// @requirement: A.1.2 -- In general all TTCN-3 language constructs (i.e. definitions, declarations, statements and operations) are terminated with a semi-colon (;).
// @id: TTCN3-CORE-A.1.2-001a
// @verdict: pass reject
module M_A_01_02_test_001 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a, v_b;
        v_a := 1 // error: missing semi-colon
        v_b := 2;
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
