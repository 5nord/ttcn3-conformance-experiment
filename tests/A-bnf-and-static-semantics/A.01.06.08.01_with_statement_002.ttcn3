// @requirement: A.1.6.8.1 -- IndexRef shall be used when referencing elements of values or arrays.
// @id: TTCN3-CORE-A.1.6.8.1-001b
// @verdict: pass accept, noexecution
module M_A_01_06_08_01_with_statement_002 {

    type record of integer RoI;

    type record R {
        RoI f_list
    }

    const R c_rec := {f_list := {1, 2}}
    with {
        display (f_list[0]) "first element"
    }
}
