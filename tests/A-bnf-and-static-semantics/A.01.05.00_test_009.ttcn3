// @requirement: A.1.5.0 -- Begin/end block symbols: Relational operator symbols; { }: != == >= <= < >
// @id: TTCN3-CORE-A.1.5.0-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_test_009 {

    type component C {}

    testcase TC() runs on C {
        var integer v_a := 1, v_b := 2;
        if (v_a != v_b and v_a == 1 and v_b >= 2 and v_a <= 1 and v_a < v_b and v_b > v_a) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
