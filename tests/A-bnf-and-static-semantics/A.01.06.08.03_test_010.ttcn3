// @requirement: A.1.6.8.3 -- If more than one RelExpression exists, then the RelExpressions shall evaluate to specific values of compatible types.
// @id: TTCN3-CORE-A.1.6.8.3-009a
// @verdict: pass reject
module M_A_01_06_08_03_test_010 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        var charstring v_s := "1";
        if (v_i == v_s) { // error: operands of == have incompatible types
            setverdict(pass);
        }
    }

    control {
        execute(TC());
    }
}
