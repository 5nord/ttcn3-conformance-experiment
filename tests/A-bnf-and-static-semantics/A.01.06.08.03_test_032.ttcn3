// @requirement: A.1.6.8.3 -- Operands of the "+" or "-" operators shall be of type integer or float or derivations of integer or float (i.e. subrange)
// @id: TTCN3-CORE-A.1.6.8.3-021a
// @verdict: pass reject
module M_A_01_06_08_03_test_032 {

    type component C {}

    testcase TC() runs on C {
        var boolean v_b := true;
        var integer v_i := v_b - 1; // error: operand of binary - is not integer or float
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
