// @requirement: A.1.4 -- Line comments shall be opened by the symbol pair // and closed by a <newline> or <end-of-file>.
// @id: TTCN3-CORE-A.1.4-008b
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_04_comments_007 {

    const // This is c_myConst
        integer c_myConst := 1;

    type component C {}

    testcase TC() runs on C {
        if (c_myConst == 1) { // the next line is not part of this comment
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
// line comment closed by end-of-file