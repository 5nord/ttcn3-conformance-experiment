// @requirement: A.1.6.8.3 -- If more than one UnaryExpression exists then the UnaryExpressions shall resolve to type integer or float or derivatives of these types.
// @id: TTCN3-CORE-A.1.6.8.3-017b
// @verdict: pass reject
module M_A_01_06_08_03_basic_statements_025 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_o := '01'O;
        var octetstring v_r := v_o * 2; // error: operand of * is not integer or float
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
