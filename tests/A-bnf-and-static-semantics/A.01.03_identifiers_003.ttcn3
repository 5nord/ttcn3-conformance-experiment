// @requirement: A.1.3 -- An identifier shall begin with a letter (i.e. not with a number and not an underscore).
// @id: TTCN3-CORE-A.1.3-002a
// @verdict: pass reject
module M_A_01_03_identifiers_003 {

    type component C {}

    testcase TC() runs on C {
        var integer _v_a := 1; // error: identifier begins with an underscore
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
