// @requirement: A.1.6.8.3 -- If more than one Result exists the right-hand operand shall be of type integer or derivatives
// @id: TTCN3-CORE-A.1.6.8.3-011b
// @verdict: pass reject
module M_A_01_06_08_03_test_014 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_b := '0101'B;
        v_b := v_b << 1.0; // error: right-hand operand of << is not an integer
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
