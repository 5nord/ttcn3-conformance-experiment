// @requirement: A.1.6.8.3 -- Operands of the not operator shall be of type boolean or derivatives of type Boolean.
// @id: TTCN3-CORE-A.1.6.8.3-008a
// @verdict: pass reject
module M_A_01_06_08_03_basic_statements_009 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i := 1;
        var boolean v_b := not v_i; // error: operand of not is not boolean
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
