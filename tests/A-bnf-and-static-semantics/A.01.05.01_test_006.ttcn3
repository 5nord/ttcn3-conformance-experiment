// @requirement: A.1.5.1 -- @abstract @control; @decoded @default @deterministic @fuzzy; @index @lazy @local; @nocase @nodefault
// @id: TTCN3-CORE-A.1.5.1-016a
// @verdict: pass accept, noexecution
module M_A_01_05_01_test_006 {

    type union U {
        @default integer f_int,
        charstring f_cs
    }

    type record R {
        octetstring f_payload
    }

    type port P message {
        inout R, integer
    }

    type component C {
        port P p_port;
    }

    template @abstract integer t_abs := ?;

    function @deterministic f_det(@lazy integer p_x) return integer {
        return p_x;
    }

    function f_mods() runs on C {
        var @fuzzy integer v_fuzzy := f_det(1);
        var integer v_int;
        var integer v_idx;
        var C v_ptcs[2];
        var boolean v_match := match("ABC", pattern @nocase "abc");
        alt @nodefault {
            [] p_port.receive(R:?) -> value (v_int := @decoded f_payload) {}
        }
        any from v_ptcs.done -> @index value v_idx;
    }

    function @control f_ctrl() {
    }
} with { encode @local "RAW" }
