// @requirement: A.1.5.0 -- Begin/end block symbols: String enclosure symbols; { }: " '
// @id: TTCN3-CORE-A.1.5.0-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_A_01_05_00_general_012 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_c := "abc";
        var octetstring v_o := '0A0B'O;
        if (lengthof(v_c) == 3 and lengthof(v_o) == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
