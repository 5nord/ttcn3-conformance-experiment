// @requirement: 16.1.4 -- g) Changing of component variables, i.e. using component variables on the left-hand side of assignments, and in the instantiation of out and inout parameters (see notes 4 and 6).
// @id: TTCN3-CORE-16.1.4-010b
// @verdict: pass reject
module M_16_01_04_test_009 {

    function f_set(out integer p_x) {
        p_x := 1;
    }

    type component C {
        var integer v_count := 0;
        timer T := 0.1;
    }

    function f_guard() runs on C return boolean {
        f_set(v_count); // error: component variable as actual out parameter
        return true;
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
