// @requirement: 16.2.1 -- [ @nodefault ] AltstepRef "(" [ { ActualPar [","] } ] ")"
// @id: TTCN3-CORE-16.2.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_01_invoking_altsteps_002 {

    type component C {
        timer T1;
        timer T2;
    }

    altstep a_step(integer p_a, integer p_b) runs on C {
        [] T1.timeout {
            if (p_a + p_b == 3) {
                setverdict(pass);
            } else {
                setverdict(fail);
            }
        }
    }

    altstep a_empty() runs on C {
        [] T2.timeout {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        T1.start(0.1);
        T2.start(5.0);
        alt {
            [] a_empty();
            [] a_step(1, 2);
        }
        T1.start(0.1);
        @nodefault a_step(1, 2);
    }

    control {
        execute(TC());
    }
}
