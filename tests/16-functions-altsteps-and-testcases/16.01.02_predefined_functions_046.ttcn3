// @id: TTCN3-CORE-16.1.2-055a
// @verdict: pass accept, noexecution
module M_16_01_02_predefined_functions_046 {

    type component C {}

    type record R {
        integer f1
    }

    function f_decode(octetstring p_enc) return integer {
        var octetstring v_enc := p_enc;
        var R v_r;
        var integer v_res := decvalue_o(v_enc, v_r);
        return v_res;
    }
}
