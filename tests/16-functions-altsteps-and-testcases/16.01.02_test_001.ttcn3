// @requirement: 16.1.2 -- TTCN-3 contains a number of predefined (built-in) functions that need not be declared before use.
// @id: TTCN3-CORE-16.1.2-001b
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_001 {

    type component C {}

    testcase TC() runs on C {
        if (lengthof("abc") == 3 and int2str(7) == "7") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
