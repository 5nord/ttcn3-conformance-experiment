// @requirement: 16.2.0 -- NOTE: As an interleave statement is semantically equivalent with the expanded alt statement, there are no further restrictions on usages of interleave altsteps than on usages of normal altsteps.
// @id: TTCN3-CORE-16.2.0-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_00_test_006 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        var integer v_count := 0;
        timer T_guard := 1.0;
    }

    altstep interleave a_il(in integer p_a, in integer p_b) runs on C {
        var integer v_inc := 1;
        [] p2.receive(p_a) {
            v_count := v_count + v_inc;
        }
        [] p2.receive(p_b) {
            v_count := v_count + v_inc;
        }
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        T_guard.start;
        p1.send(2);
        p1.send(1);
        a_il(1, 2);
        p1.send(3);
        p1.send(4);
        alt {
            [] a_il(4, 3);
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
        if (v_count == 4) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
