// @requirement: 16.2.1 -- The alternatives of the altstep are checked and executed the same way as alternatives of an alt statement (see clause 20.1) with the exception that no new snapshot is taken when entering the altstep.
// @id: TTCN3-CORE-16.2.1-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_01_test_009 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
        timer T;
    }

    altstep a_step(integer p_sel) runs on C {
        [false] p.receive {
            setverdict(fail);
        }
        [p_sel == 1] p.receive(integer:2) {
            setverdict(fail);
        }
        [p_sel == 1] p.receive(integer:1) {
            setverdict(pass);
        }
        [] p.receive {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        connect(self:p, self:p);
        p.send(1);
        T.start(1.0);
        alt {
            [] a_step(1);
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
