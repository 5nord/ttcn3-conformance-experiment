// @requirement: 16.3 -- This behaviour is performed by the MTC which is automatically created when a test case is being executed.
// @id: TTCN3-CORE-16.3-008a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_03_test_cases_001 {

    type component C {}

    testcase TC() runs on C {
        if (self == mtc) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
