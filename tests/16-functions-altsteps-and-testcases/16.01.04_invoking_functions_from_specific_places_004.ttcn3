// @requirement: 16.1.4 -- c) The action operation (see notes 2 and 6).
// @id: TTCN3-CORE-16.1.4-006a
// @verdict: pass reject
module M_16_01_04_invoking_functions_from_specific_places_004 {

    type component C {
        timer T := 0.1;
    }

    function f_guard() runs on C return boolean {
        action("operator action"); // error: action operation in a function called in a guard
        return true;
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
