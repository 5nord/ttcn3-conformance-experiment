// @requirement: 16.2.1 -- This means, an explicitly invoked altstep may execute receiving operations that empty the queues of unmapped and disconnected ports without causing a test case error.
// @id: TTCN3-CORE-16.2.1-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_01_test_017 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
        timer T;
    }

    altstep a_drain() runs on C {
        [] p.receive {
            repeat;
        }
        [] T.timeout {}
    }

    testcase TC() runs on C {
        connect(self:p, self:p);
        p.send(1);
        p.check(receive(integer:1));
        disconnect(self:p, self:p);
        T.start(0.5);
        alt {
            [] a_drain();
        }
        T.start(0.1);
        alt {
            [] p.receive {
                setverdict(fail);
            }
            [] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
