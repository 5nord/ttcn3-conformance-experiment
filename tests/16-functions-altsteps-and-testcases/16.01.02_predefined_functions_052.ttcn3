// @id: TTCN3-CORE-16.1.2-062a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_052 {

    type component C {}

    type record of integer RoI;

    testcase TC() runs on C {
        var RoI v_list := { 1, 2, 3 };
        var float v_rnd := rnd(0.5);
        var charstring v_host := hostid("Ipv4orIPv6");
        if (int2bit(5, 4) == '0101'B
            and int2char(65) == "A"
            and bit2hex('111010111'B) == '1D7'H
            and unichar2oct("A", "UTF-8") == '41'O
            and lengthof(v_list) == 3
            and substr('01AB23CD'O, 1, 2) == 'AB23'O
            and replace("abc", 1, 1, "x") == "axc"
            and remove_bom('FEFF0041'O) == '0041'O
            and v_rnd >= 0.0 and v_rnd < 1.0
            and rnd() < 1.0
            and testcasename() == "TC"
            and lengthof(v_host) >= 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
