// @requirement: 16.1.0 -- i) If the function header includes a return clause, the function, when terminating, shall do so by executing a return statement.
// @id: TTCN3-CORE-16.1.0-033a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_00_general_031 {

    type component C {}

    function f_firstAbove(integer p_limit) return integer {
        for (var integer i := 0; i < 100; i := i + 1) {
            if (i > p_limit) {
                return i;
            }
        }
        return -1;
    }

    testcase TC() runs on C {
        if (f_firstAbove(3) == 4 and f_firstAbove(200) == -1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
