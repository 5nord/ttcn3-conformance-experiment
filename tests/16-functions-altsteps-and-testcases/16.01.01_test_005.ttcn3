// @requirement: 16.1.1 -- Actual parameters are passed into the statement block.
// @id: TTCN3-CORE-16.1.1-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_01_test_005 {

    type component C {}

    function f_check(integer p_int, charstring p_str) return boolean {
        return p_int == 42 and p_str == "abc";
    }

    testcase TC() runs on C {
        if (f_check(42, "abc")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
