// @requirement: 16.1.2 -- Col1: Codec functions; Table 15: List of TTCN-3 predefined functions: Encode a value into a bitstring; Col3: encvalue
// @id: TTCN3-CORE-16.1.2-050a
// @verdict: pass accept, noexecution
module M_16_01_02_test_041 {

    type component C {}

    type record R {
        integer f1
    }

    function f_encode(R p_r) return bitstring {
        var bitstring v_enc := encvalue(p_r);
        return v_enc;
    }
}
