// @requirement: 16.1.4 -- h) Calling the setverdict operation (see notes 4 and 6).
// @id: TTCN3-CORE-16.1.4-011a
// @verdict: pass reject
module M_16_01_04_invoking_functions_from_specific_places_010 {

    type component C {
        timer T := 0.1;
    }

    function f_guard() runs on C return boolean {
        setverdict(pass); // error: setverdict in a function called in a guard
        return true;
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
