// @requirement: 16.1.2 -- Col1: Convert bitstring value to charstring value; Table 15: List of TTCN-3 predefined functions: bit2str
// @id: TTCN3-CORE-16.1.2-027a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_018 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_res := bit2str('0101'B);
        if (v_res == "0101") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
