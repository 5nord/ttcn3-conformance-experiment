// @requirement: 16.1.2 -- Col1: Convert float value to integer value; Table 15: List of TTCN-3 predefined functions: float2int
// @id: TTCN3-CORE-16.1.2-019a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_010 {

    type component C {}

    testcase TC() runs on C {
        var integer v_res := float2int(3.7);
        if (v_res == 3) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
