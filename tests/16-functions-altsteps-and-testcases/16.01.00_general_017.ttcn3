// @requirement: 16.1.0 -- Using the @deterministic modifier, a function can be declared to be deterministic.
// @id: TTCN3-CORE-16.1.0-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_00_general_017 {

    type component C {}

    function @deterministic f_double(integer p_a) return integer {
        return 2 * p_a;
    }

    testcase TC() runs on C {
        if (f_double(21) == 42) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
