// @requirement: 16.1.0 -- Value return is denoted by the return keyword followed by a type expression.
// @id: TTCN3-CORE-16.1.0-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_00_general_005 {

    type component C {}

    function f_value() return charstring {
        return "abc";
    }

    testcase TC() runs on C {
        var charstring v_res := f_value();
        if (v_res == "abc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
