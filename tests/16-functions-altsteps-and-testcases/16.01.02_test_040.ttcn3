// @requirement: 16.1.2 -- Col1: Replaces a substring of a string with or inserts the input string into a string, and similarly for lists; Table 15: List of TTCN-3 predefined functions: replace
// @id: TTCN3-CORE-16.1.2-049a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_040 {

    type component C {}

    type record of integer RoI;

    testcase TC() runs on C {
        var RoI v_list := { 1, 2, 3 };
        var RoI v_new := { 9 };
        if (replace("My name is JJ", 11, 1, "xx") == "My name is xxJ"
            and replace("My name is JJ", 11, 0, "xx") == "My name is xxJJ"
            and replace(v_list, 1, 1, v_new) == { 1, 9, 3 }) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
