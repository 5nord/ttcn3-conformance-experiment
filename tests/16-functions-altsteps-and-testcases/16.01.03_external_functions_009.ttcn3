// @requirement: 16.1.3 -- The @control modifier is used in the same way as described in clause 16.1.5.
// @id: TTCN3-CORE-16.1.3-007a
// @verdict: pass accept, noexecution
module M_16_01_03_external_functions_009 {

    external function @control fx_prepare() return boolean;

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        if (fx_prepare()) {
            execute(TC());
        }
    }
}
