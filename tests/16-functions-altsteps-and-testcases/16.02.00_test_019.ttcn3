// @requirement: 16.2.0 -- a) The local definitions of an altstep shall be defined before the set of alternatives.
// @id: TTCN3-CORE-16.2.0-022a
// @verdict: pass reject
module M_16_02_00_test_019 {

    type component C {
        timer T_guard := 0.1;
    }

    altstep a_step() runs on C {
        [] T_guard.timeout {
            setverdict(pass);
        }
        var integer v_loc := 1; // error: local definition after the alternatives
    }

    testcase TC() runs on C {
        T_guard.start;
        a_step();
    }

    control {
        execute(TC());
    }
}
