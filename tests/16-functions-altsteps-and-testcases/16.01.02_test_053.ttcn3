// @id: TTCN3-CORE-16.1.2-062b
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_053 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "ABCdef";
        if (regexp @nocase (v_in, charstring:"(abc)(DEF)", 1) == "def") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
