// @requirement: 16.1.2 -- Col1: Convert integer value to universal charstring value; Table 15: List of TTCN-3 predefined functions: int2unichar
// @id: TTCN3-CORE-16.1.2-012a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_003 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_res := int2unichar(256);
        if (v_res == char(0, 0, 1, 0)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
