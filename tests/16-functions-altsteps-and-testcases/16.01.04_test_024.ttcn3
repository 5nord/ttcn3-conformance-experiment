// @requirement: 16.1.4 -- NOTE 9: Calling functions and external functions with @fuzzy parameters causes an error, because fuzzy objects are re-evaluated each time referenced and this may lead to different results of subsequent evaluations of the same snapshot.
// @id: TTCN3-CORE-16.1.4-028a
// @verdict: pass reject
module M_16_01_04_test_024 {

    type component C {
        timer T := 0.1;
    }

    external function @deterministic fx_check(in @fuzzy integer p_x) return boolean;

    testcase TC() runs on C {
        T.start;
        alt {
            [fx_check(1)] T.timeout { // error: external function with @fuzzy parameter called in a guard
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
