// @requirement: 16.1.0 -- Functions may return a value or a template.
// @id: TTCN3-CORE-16.1.0-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_00_general_004 {

    type component C {}

    function f_value() return integer {
        return 7;
    }

    function f_template() return template integer {
        return ?;
    }

    testcase TC() runs on C {
        if (f_value() == 7 and match(42, f_template())) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
