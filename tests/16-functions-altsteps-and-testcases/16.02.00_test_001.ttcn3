// @requirement: 16.2.0 -- altstep [ @control ] [ interleave ] AltstepIdentifier "(" [ { ( FormalValuePar | FormalTemplatePar ) [","] } ] ")" [ runs on ComponentType ] [ mtc ComponentType ] [ system ComponentType ] "{" { ( VarInstance | TimerInstance | ConstDef | TemplateDef ) [";"] } AltGuardList "}"
// @id: TTCN3-CORE-16.2.0-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_00_test_001 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
    }

    altstep a_step(integer p_exp, template integer p_tmpl) runs on C mtc C system C {
        var integer v_loc := p_exp;
        timer T_loc := 1.0;
        const integer c_one := 1;
        template integer t_loc := p_tmpl;
        [] p2.receive(t_loc) -> value v_loc {
            if (v_loc == p_exp + c_one - 1) {
                setverdict(pass);
            } else {
                setverdict(fail);
            }
        }
        [] T_loc.timeout {
            setverdict(fail);
        }
    }

    testcase TC() runs on C system C {
        connect(self:p1, self:p2);
        p1.send(5);
        a_step(5, integer:?);
    }

    control {
        execute(TC());
    }
}
