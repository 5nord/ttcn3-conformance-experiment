// @requirement: 16.1.2 -- Col1: Decode a universal charstring into a value; Table 15: List of TTCN-3 predefined functions: decvalue_unichar
// @id: TTCN3-CORE-16.1.2-053a
// @verdict: pass accept, noexecution
module M_16_01_02_test_044 {

    type component C {}

    type record R {
        integer f1
    }

    function f_decode(universal charstring p_enc) return integer {
        var universal charstring v_enc := p_enc;
        var R v_r;
        var integer v_res := decvalue_unichar(v_enc, v_r);
        return v_res;
    }
}
