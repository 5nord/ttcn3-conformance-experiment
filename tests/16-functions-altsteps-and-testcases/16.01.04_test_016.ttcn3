// @requirement: 16.1.4 -- m) Referencing lazy or fuzzy variables, parameters or templates that have not been declared deterministic.
// @id: TTCN3-CORE-16.1.4-016a
// @verdict: pass reject
module M_16_01_04_test_016 {

    type component C {
        timer T := 0.1;
    }

    function f_lazy(@lazy integer p_x) return boolean {
        return p_x > 0; // error: lazy parameter not declared @deterministic
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [f_lazy(1)] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
