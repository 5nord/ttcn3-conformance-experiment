// @requirement: 16.1.2 -- Col1: Convert value or template to universal charstring value; Table 15: List of TTCN-3 predefined functions: any2unistr
// @id: TTCN3-CORE-16.1.2-043a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_034 {

    type component C {}

    template integer mw_any := ?;

    testcase TC() runs on C {
        var integer v_int := 5;
        var universal charstring v_res1 := any2unistr(v_int);
        var universal charstring v_res2 := any2unistr(mw_any);
        if (v_res1 == "5" and v_res2 == "?") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
