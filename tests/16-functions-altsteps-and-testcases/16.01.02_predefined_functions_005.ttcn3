// @requirement: 16.1.2 -- Col1: Convert integer value to enumerated value; Table 15: List of TTCN-3 predefined functions: int2enum
// @id: TTCN3-CORE-16.1.2-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_005 {

    type component C {}

    type enumerated E { e_first(0), e_second(1), e_third(5) }

    testcase TC() runs on C {
        var E v_res;
        int2enum(5, v_res);
        if (v_res == e_third) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
