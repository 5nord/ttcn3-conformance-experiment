// @requirement: 16.3 -- c) all formal parameter types of the test case shall be of a data type.
// @id: TTCN3-CORE-16.3-018a
// @verdict: pass reject
module M_16_03_test_012 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    testcase TC(P p_port) runs on C { // error: port type is not a data type
        setverdict(pass);
    }
}
