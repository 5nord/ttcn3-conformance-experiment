// @requirement: 16.1.2 -- Col1: Convert integer value to charstring value; Table 15: List of TTCN-3 predefined functions: int2str
// @id: TTCN3-CORE-16.1.2-017a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_008 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_res := int2str(-42);
        if (v_res == "-42") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
