// @requirement: 16.1.1 -- a) Functions that do not return values shall be invoked directly.
// @id: TTCN3-CORE-16.1.1-008a
// @verdict: pass reject
module M_16_01_01_invoking_functions_007 {

    type component C {}

    function f_noReturn() {
        log("no return value");
    }

    testcase TC() runs on C {
        var integer v_var;
        v_var := f_noReturn(); // error: function without return clause used in an expression
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
