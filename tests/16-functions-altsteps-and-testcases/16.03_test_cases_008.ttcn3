// @requirement: 16.3 -- b) test system part (optional): denoted by the keyword system which references the component type which defines the required ports for the test system interface.
// @id: TTCN3-CORE-16.3-014b
// @verdict: pass accept, ttcn3verdict:pass
module M_16_03_test_cases_008 {

    type port P message {
        inout integer;
    }

    type component C {}

    type component S {
        port P p;
    }

    testcase TC_with() runs on C system S {
        setverdict(pass);
    }

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        execute(TC_with());
        execute(TC());
    }
}
