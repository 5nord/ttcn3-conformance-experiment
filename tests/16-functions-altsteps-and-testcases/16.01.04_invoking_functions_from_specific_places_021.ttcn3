// @requirement: 16.1.4 -- NOTE 6: Restrictions except the limitation on the use of out or inout parameterization in restriction j) apply recursively, i.e. it is disallowed to use them directly, or via an arbitrary long chain of function invocations.
// @id: TTCN3-CORE-16.1.4-025a
// @verdict: pass reject
module M_16_01_04_invoking_functions_from_specific_places_021 {

    type component C {
        timer T := 0.1;
    }

    function f_level2() return float {
        return rnd(); // error: rnd reached via a chain of function calls from a guard
    }

    function f_level1() return boolean {
        return f_level2() < 2.0;
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [f_level1()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
