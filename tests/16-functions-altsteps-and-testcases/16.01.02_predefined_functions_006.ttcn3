// @requirement: 16.1.2 -- Col1: Convert integer value to hexstring value; Table 15: List of TTCN-3 predefined functions: int2hex
// @id: TTCN3-CORE-16.1.2-015a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_006 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_res := int2hex(255, 3);
        if (v_res == '0FF'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
