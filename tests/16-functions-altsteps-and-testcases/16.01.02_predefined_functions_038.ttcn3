// @requirement: 16.1.2 -- Col1: String/list handling functions; Table 15: List of TTCN-3 predefined functions: Returns part of the input string matching the specified pattern group within a character pattern; Col3: regexp
// @id: TTCN3-CORE-16.1.2-047a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_038 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_in := "abc123";
        if (regexp(v_in, charstring:"([a-z]+)([0-9]+)", 1) == "123") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
