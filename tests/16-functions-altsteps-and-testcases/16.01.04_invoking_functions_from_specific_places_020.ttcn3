// @requirement: 16.1.4 -- NOTE 5: The use of operations activate and deactivate causes an error because they modify the set of defaults that is considered during the evaluation of the current snapshot.
// @id: TTCN3-CORE-16.1.4-024a
// @verdict: pass reject
module M_16_01_04_invoking_functions_from_specific_places_020 {

    type component C {
        timer T := 0.1;
    }

    altstep a_other() runs on C {
        [] any timer.timeout {
            setverdict(fail);
        }
    }

    function f_activate() runs on C return default {
        return activate(a_other()); // error: activate in an altstep local definition initialization
    }

    altstep a_main() runs on C {
        var default v_def := f_activate();
        [] T.timeout {
            setverdict(pass);
        }
    }

    testcase TC() runs on C {
        T.start;
        a_main();
    }

    control {
        execute(TC());
    }
}
