// @requirement: 16.1.2 -- Col1: Convert octetstring value to charstring value, version II; Table 15: List of TTCN-3 predefined functions: oct2char
// @id: TTCN3-CORE-16.1.2-036a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_027 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_res := oct2char('4142'O);
        if (v_res == "AB") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
