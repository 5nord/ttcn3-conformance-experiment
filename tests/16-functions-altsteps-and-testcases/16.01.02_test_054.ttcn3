// @id: TTCN3-CORE-16.1.2-062c
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_054 {

    type component C {}

    type record of integer RoI;

    type record R {
        integer f1,
        integer f2
    }

    testcase TC() runs on C {
        var template RoI v_t := { 1, ?, 3 };
        var template charstring v_pat := pattern "([a-z]+)([0-9]+)";
        var template RoI v_sub := substr(v_t, 0, 2);
        if (lengthof(v_t) == 3
            and sizeof(R:{ f1 := ?, f2 := 2 }) == 2
            and istemplatekind(v_t, "AnyElement")
            and regexp("abc123", v_pat, 1) == "123"
            and match({ 1, 5 }, v_sub)) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
