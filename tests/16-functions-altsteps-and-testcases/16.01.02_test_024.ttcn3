// @requirement: 16.1.2 -- Col1: Convert octetstring value to bitstring value; Table 15: List of TTCN-3 predefined functions: oct2bit
// @id: TTCN3-CORE-16.1.2-033a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_024 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_res := oct2bit('0F'O);
        if (v_res == '00001111'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
