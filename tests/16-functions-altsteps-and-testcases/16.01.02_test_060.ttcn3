// @requirement: 16.1.2 -- the encoded_value parameter of the decvalue and decvalue_unichar function may be uninitialized.
// @id: TTCN3-CORE-16.1.2-071a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_060 {

    type component C {}

    type record R {
        integer f1
    }

    testcase TC() runs on C {
        var bitstring v_bs;
        var universal charstring v_us;
        var R v_r1, v_r2;
        var integer v_res1 := decvalue(v_bs, v_r1);
        var integer v_res2 := decvalue_unichar(v_us, v_r2);
        if (v_res1 == 1 and v_res2 == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
