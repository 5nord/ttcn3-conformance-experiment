// @requirement: 16.1.2 -- 3) all actual in and inout parameters shall be initialized with the following exceptions:
// @id: TTCN3-CORE-16.1.2-068a
// @verdict: pass accept, ttcn3verdict:error
module M_16_01_02_test_057 {

    type component C {}

    testcase TC() runs on C {
        var integer v_i;
        var charstring v_c;
        setverdict(pass);
        v_c := int2char(v_i); // error: uninitialized actual in parameter
    }

    control {
        execute(TC());
    }
}
