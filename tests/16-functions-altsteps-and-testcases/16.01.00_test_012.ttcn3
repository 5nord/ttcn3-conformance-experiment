// @requirement: 16.1.0 -- If a function has an mtc clause, the type referenced by this clause shall be mtccompatible (see clause 6.3.2.7) with the type of the mtc component reference.
// @id: TTCN3-CORE-16.1.0-011a
// @verdict: pass reject
module M_16_01_00_test_012 {

    type port P message {
        inout integer
    }

    type component A {
        port P p_a;
    }

    type component B {}

    function f_mtcA() mtc A {
    }

    testcase TC() runs on B {
        f_mtcA(); // error: A is not mtc-compatible with the mtc type B
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
