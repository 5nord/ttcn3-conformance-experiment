// @requirement: 16.2.0 -- If an altstep has a system clause, the type referenced by this clause shall by system-compatible (see clause 6.3.2.7) with the type of the system component reference.
// @id: TTCN3-CORE-16.2.0-017a
// @verdict: pass reject
module M_16_02_00_test_015 {

    type port P message {
        inout integer
    }

    type component C {
        timer T_guard := 0.1;
    }

    type component CS {
        port P p_extra;
    }

    altstep a_step() system CS {
        [] any timer.timeout {
            setverdict(pass);
        }
    }

    testcase TC() runs on C system C {
        T_guard.start;
        a_step(); // error: CS is not system-compatible with C
    }

    control {
        execute(TC());
    }
}
