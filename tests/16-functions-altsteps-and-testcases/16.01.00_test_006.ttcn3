// @requirement: 16.1.0 -- Template return is denoted by the return keywords followed by a TemplateModifier and a type expression.
// @id: TTCN3-CORE-16.1.0-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_00_test_006 {

    type component C {}

    function f_template() return template octetstring {
        return 'FF?FF'O;
    }

    function f_present() return template(present) integer {
        return (1 .. 3);
    }

    testcase TC() runs on C {
        if (match('FF00FF'O, f_template()) and match(2, f_present()) and
            not match(4, f_present())) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
