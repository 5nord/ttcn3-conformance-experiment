// @requirement: 16.1.2 -- Col1: Convert charstring value to octetstring value; Table 15: List of TTCN-3 predefined functions: char2oct
// @id: TTCN3-CORE-16.1.2-021a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_012 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_res := char2oct("AB");
        if (v_res == '4142'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
