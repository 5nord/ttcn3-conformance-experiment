// @requirement: 16.1.2 -- Col1: Convert octetstring value to universal charstring value; Table 15: List of TTCN-3 predefined functions: oct2unichar
// @id: TTCN3-CORE-16.1.2-037a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_028 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_res := oct2unichar('4142'O, "UTF-8");
        if (v_res == "AB") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
