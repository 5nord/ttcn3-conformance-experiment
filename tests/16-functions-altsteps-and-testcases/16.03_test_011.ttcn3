// @requirement: 16.3 -- If both runs` `on and system clauses are missing, the test system` interface has no ports;
// @id: TTCN3-CORE-16.3-017a
// @verdict: pass reject
module M_16_03_test_011 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
    }

    testcase TC() {
        var C v_comp := null;
        map(v_comp:p, system:p); // error: the test system interface has no port p
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
