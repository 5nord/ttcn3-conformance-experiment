// @requirement: 16.1.4 -- k) Calling functions and external functions with @fuzzy formal parameters and variables (see notes 4 and 9).
// @id: TTCN3-CORE-16.1.4-014a
// @verdict: pass reject
module M_16_01_04_test_014 {

    type component C {
        timer T := 0.1;
    }

    function f_fuzzy(@fuzzy integer p_x) return boolean {
        return true;
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [f_fuzzy(1)] T.timeout { // error: function with @fuzzy formal parameter called in a guard
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
