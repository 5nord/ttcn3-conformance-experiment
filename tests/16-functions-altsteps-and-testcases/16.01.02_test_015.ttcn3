// @requirement: 16.1.2 -- Col1: Convert bitstring value to integer value; Table 15: List of TTCN-3 predefined functions: bit2int
// @id: TTCN3-CORE-16.1.2-024a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_015 {

    type component C {}

    testcase TC() runs on C {
        var integer v_res := bit2int('101'B);
        if (v_res == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
