// @requirement: 16.1.2 -- Col1: Convert universal charstring value to integer value; Table 15: List of TTCN-3 predefined functions: unichar2int
// @id: TTCN3-CORE-16.1.2-023a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_014 {

    type component C {}

    testcase TC() runs on C {
        var integer v_res := unichar2int(char(0, 0, 1, 0));
        if (v_res == 256) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
