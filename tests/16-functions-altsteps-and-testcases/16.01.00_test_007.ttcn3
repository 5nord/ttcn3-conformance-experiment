// @requirement: 16.1.0 -- Execution of a return statement in the body of the function causes evaluation of the return value or template, the function to terminate and to return the result to the location of the call of the function.
// @id: TTCN3-CORE-16.1.0-007a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_00_test_007 {

    type component C {}

    function f_compute(integer p_a, integer p_b) return integer {
        return p_a * 10 + p_b;
    }

    function f_range(integer p_low) return template integer {
        return (p_low .. p_low + 2);
    }

    testcase TC() runs on C {
        if (f_compute(4, 2) == 42 and match(6, f_range(5)) and not match(8, f_range(5))) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
