// @requirement: 16.2.0 -- g) If the altstep is an interleave altstep, all restrictions of the interleave statement (see clause 20.4) apply to the top alternatives of the altstep as well.
// @id: TTCN3-CORE-16.2.0-033a
// @verdict: pass reject
module M_16_02_00_test_032 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
    }

    altstep interleave a_il() runs on C {
        [] p2.receive(integer:1) {
            repeat; // error: repeat not allowed in interleave alternatives
        }
        [] p2.receive(integer:2) {
        }
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(1);
        p1.send(2);
        a_il();
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
