// @requirement: 16.1.2 -- Col1: Other functions; Table 15: List of TTCN-3 predefined functions: Generate a random float number; Col3: rnd
// @id: TTCN3-CORE-16.1.2-058a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_049 {

    type component C {}

    testcase TC() runs on C {
        var float v_rnd := rnd();
        if (v_rnd >= 0.0 and v_rnd < 1.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
