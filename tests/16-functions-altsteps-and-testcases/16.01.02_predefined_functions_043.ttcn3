// @requirement: 16.1.2 -- Col1: Encode a value into a universal charstring; Table 15: List of TTCN-3 predefined functions: encvalue_unichar
// @id: TTCN3-CORE-16.1.2-052a
// @verdict: pass accept, noexecution
module M_16_01_02_predefined_functions_043 {

    type component C {}

    type record R {
        integer f1
    }

    function f_encode(R p_r) return universal charstring {
        var universal charstring v_enc := encvalue_unichar(p_r);
        return v_enc;
    }
}
