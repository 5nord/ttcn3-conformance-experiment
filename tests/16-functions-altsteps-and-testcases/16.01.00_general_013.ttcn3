// @requirement: 16.1.0 -- If the mtc clause is not present, the type of the mtc component reference is unknown in the scope of this function.
// @id: TTCN3-CORE-16.1.0-012a
// @verdict: pass reject
module M_16_01_00_general_013 {

    type component C {}

    function f_noMtc() runs on C {
        var C v_mtc := mtc; // error: mtc type unknown without mtc clause
    }

    testcase TC() runs on C {
        f_noMtc();
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
