// @requirement: 16.1.4 -- b) All port operations, i.e. start (port), stop (port), halt, clear, checkstate, send, receive, trigger, call, getcall, reply, getreply, raise, catch, check, connect, disconnect, map and unmap (see notes 1, 2, 3, 4 and 6).
// @id: TTCN3-CORE-16.1.4-004a
// @verdict: pass reject
module M_16_01_04_invoking_functions_from_specific_places_003 {

    type port P message {
        inout integer
    }

    type component C {
        port P p;
        timer T := 0.1;
    }

    function f_guard() runs on C return boolean {
        p.send(1); // error: port operation in a function called in a guard
        return true;
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
