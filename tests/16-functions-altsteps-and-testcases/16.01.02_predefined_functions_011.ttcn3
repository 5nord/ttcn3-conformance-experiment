// @requirement: 16.1.2 -- Col1: Convert charstring value to integer value; Table 15: List of TTCN-3 predefined functions: char2int
// @id: TTCN3-CORE-16.1.2-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_011 {

    type component C {}

    testcase TC() runs on C {
        var integer v_res := char2int("A");
        if (v_res == 65) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
