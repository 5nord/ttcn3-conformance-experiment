// @requirement: 16.1.5 -- e) The restrictions on the use of statements and operations usable in control functions given in table 15 shall be followed.
// @id: TTCN3-CORE-16.1.5-007a
// @verdict: pass reject
module M_16_01_05_explicit_control_functions_009 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    function @control f_runTC() {
        execute(TC());
        setverdict(pass); // error: setverdict cannot be invoked by control behaviour
    }

    control {
        f_runTC();
    }
}
