// @requirement: 16.1.2 -- Col1: Returns the name of the currently executing test case; Table 15: List of TTCN-3 predefined functions: testcasename
// @id: TTCN3-CORE-16.1.2-059a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_050 {

    type component C {}

    testcase TC() runs on C {
        if (testcasename() == "TC") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
