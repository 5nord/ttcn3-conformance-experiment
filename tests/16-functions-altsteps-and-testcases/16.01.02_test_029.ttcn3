// @requirement: 16.1.2 -- Col1: Convert charstring value to integer value; Table 15: List of TTCN-3 predefined functions: str2int
// @id: TTCN3-CORE-16.1.2-038a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_029 {

    type component C {}

    testcase TC() runs on C {
        var integer v_res := str2int("-123");
        if (v_res == -123) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
