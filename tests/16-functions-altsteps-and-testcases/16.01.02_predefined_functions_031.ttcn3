// @requirement: 16.1.2 -- Col1: Convert charstring value to octetstring value; Table 15: List of TTCN-3 predefined functions: str2oct
// @id: TTCN3-CORE-16.1.2-040a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_031 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_res := str2oct("1A2B");
        if (v_res == '1A2B'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
