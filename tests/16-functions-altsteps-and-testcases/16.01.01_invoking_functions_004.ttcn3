// @requirement: 16.1.1 -- The invoked function is performed by the test component invoking it.
// @id: TTCN3-CORE-16.1.1-004a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_01_invoking_functions_004 {

    type component C {}

    function f_whoAmI() runs on C return C {
        return self;
    }

    function f_ptcBehaviour() runs on C {
        if (f_whoAmI() == self and self != mtc) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        if (f_whoAmI() == self and f_whoAmI() == mtc) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
        v_ptc.start(f_ptcBehaviour());
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
