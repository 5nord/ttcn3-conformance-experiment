// @requirement: 16.1.4 -- i) Activation and deactivation of defaults, i.e. the activate and deactivate statements (see notes 5 and 6).
// @id: TTCN3-CORE-16.1.4-012b
// @verdict: pass reject
module M_16_01_04_test_012 {

    type component C {
        timer T := 0.1;
    }

    function f_guard() runs on C return boolean {
        deactivate; // error: deactivate in a function called in a guard
        return true;
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
