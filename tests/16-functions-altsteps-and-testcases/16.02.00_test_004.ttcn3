// @requirement: 16.2.0 -- An altstep can also be used to define a named interleave statement by usage of the interleave keyword.
// @id: TTCN3-CORE-16.2.0-006a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_00_test_004 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        var integer v_count := 0;
    }

    altstep interleave a_both() runs on C {
        [] p2.receive(integer:1) {
            v_count := v_count + 1;
        }
        [] p2.receive(integer:2) {
            v_count := v_count + 1;
        }
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(2);
        p1.send(1);
        a_both();
        if (v_count == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
