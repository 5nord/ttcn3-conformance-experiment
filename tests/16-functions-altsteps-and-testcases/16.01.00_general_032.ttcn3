// @requirement: 16.1.0 -- The function will cause a test case error if it terminates (i.e. reaches the end of the function body) without executing a return statement.
// @id: TTCN3-CORE-16.1.0-034a
// @verdict: pass accept, ttcn3verdict:error
module M_16_01_00_general_032 {

    type component C {}

    function f_myFunction5(inout integer p_myPar1) return integer {
        if (p_myPar1 > 5) {
            p_myPar1 := 5;
            return p_myPar1;
        }
    }

    testcase TC() runs on C {
        var integer v_par := 3;
        var integer v_res;
        setverdict(pass);
        v_res := f_myFunction5(v_par); // test case error: end of function body reached
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
