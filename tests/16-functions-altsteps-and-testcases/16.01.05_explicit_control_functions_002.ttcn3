// @requirement: 16.1.5 -- a) No system and no mtc clause shall be declared.
// @id: TTCN3-CORE-16.1.5-003a
// @verdict: pass reject
module M_16_01_05_explicit_control_functions_002 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    function @control f_runTC() system C { // error: system clause in control function
        execute(TC());
    }

    control {
        f_runTC();
    }
}
