// @requirement: 16.1.1 -- A function invocation results in the execution of the statement block of the invoked function.
// @id: TTCN3-CORE-16.1.1-003a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_01_invoking_functions_003 {

    type component C {}

    function f_myFunction(inout integer p_par) {
        p_par := 10 * p_par;
        p_par := p_par + 1;
    }

    testcase TC() runs on C {
        var integer v_var := 2;
        f_myFunction(v_var);
        if (v_var == 21) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
