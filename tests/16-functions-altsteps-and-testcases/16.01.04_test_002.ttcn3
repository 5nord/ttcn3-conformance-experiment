// @requirement: 16.1.4 -- a) All component operations, i.e. create, `start (component),` `stop (component),` `kill,` running (component), alive, done and killed (see notes 1, 3, 4 and 6).
// @id: TTCN3-CORE-16.1.4-002a
// @verdict: pass reject
module M_16_01_04_test_002 {

    type component C {
        timer T := 0.1;
    }

    function f_alive(C p_c) return boolean {
        return p_c.alive; // error: component operation in a function called in a guard
    }

    testcase TC() runs on C {
        var C v_ptc := C.create alive;
        T.start;
        alt {
            [f_alive(v_ptc)] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
