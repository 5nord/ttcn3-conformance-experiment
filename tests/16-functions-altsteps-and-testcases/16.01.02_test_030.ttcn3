// @requirement: 16.1.2 -- Col1: Convert charstring value to hexstring value; Table 15: List of TTCN-3 predefined functions: str2hex
// @id: TTCN3-CORE-16.1.2-039a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_030 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_res := str2hex("1A2");
        if (v_res == '1A2'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
