// @requirement: 16.1.2 -- Col1: Presence checking functions; Table 15: List of TTCN-3 predefined functions: Determine if a template contains certain matching mechanism; Col3: istemplatekind
// @id: TTCN3-CORE-16.1.2-046a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_037 {

    type component C {}

    testcase TC() runs on C {
        var template integer v_t1 := ?;
        var template integer v_t2 := (0, 1, 2);
        if (istemplatekind(v_t1, "AnyValue") and not istemplatekind(v_t1, "list")
            and istemplatekind(v_t2, "list")) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
