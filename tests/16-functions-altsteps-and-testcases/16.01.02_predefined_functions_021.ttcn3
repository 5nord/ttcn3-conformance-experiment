// @requirement: 16.1.2 -- Col1: Convert hexstring value to octetstring value; Table 15: List of TTCN-3 predefined functions: hex2oct
// @id: TTCN3-CORE-16.1.2-030a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_021 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_res := hex2oct('1A2'H);
        if (v_res == '01A2'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
