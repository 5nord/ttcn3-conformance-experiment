// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_047 {

    type component C {}

    testcase TC() runs on C {
        if (get_stringencoding('6869C3BA7A'O) == "UTF-8") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
