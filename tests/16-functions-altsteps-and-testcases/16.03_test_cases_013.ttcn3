// @requirement: 16.3 -- Test cases may be parameterized as described in clause 5.4.
// @id: TTCN3-CORE-16.3-020a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_03_test_cases_013 {

    type component C {}

    testcase TC(integer p_a, charstring p_b) runs on C {
        if (p_a == 1 and p_b == "abc") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC(1, "abc"));
    }
}
