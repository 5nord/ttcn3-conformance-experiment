// @requirement: 16.1.5 -- d) Parameters and the return type of module control functions shall not be of a default type and shall not be of a structured type that contains fields of a default type on any level of nesting.
// @id: TTCN3-CORE-16.1.5-006b
// @verdict: pass reject
module M_16_01_05_explicit_control_functions_008 {

    type record R {
        record {
            default f_def
        } f_inner
    }

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    function control(R p_rec) { // error: parameter type contains a nested default field
        execute(TC());
    }
}
