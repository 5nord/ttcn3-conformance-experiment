// @requirement: 16.2.1 -- NOTE 1: A new snapshot within an altstep will of course be taken, if within a selected top alternative a new alt statement is specified and entered.
// @id: TTCN3-CORE-16.2.1-005a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_01_test_005 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
        timer T;
    }

    altstep a_step() runs on C {
        [] p.receive(integer:1) {
            p.send(2);
            alt {
                [] p.receive(integer:2) { // message 2 is only in a new snapshot
                    setverdict(pass);
                }
                [] T.timeout {
                    setverdict(fail);
                }
            }
        }
    }

    testcase TC() runs on C {
        connect(self:p, self:p);
        p.send(1);
        T.start(1.0);
        alt {
            [] a_step();
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
