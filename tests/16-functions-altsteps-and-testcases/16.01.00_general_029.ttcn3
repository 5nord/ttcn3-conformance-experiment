// @requirement: 16.1.0 -- h) A return statement in a template returning function shall always have a template reference (including calling a value or template returning function)or template instance compatible to the type specified in the function header return clause.
// @id: TTCN3-CORE-16.1.0-031a
// @verdict: pass reject
module M_16_01_00_general_029 {

    template charstring m_str := pattern "ab*";

    function f_myFunction() return template integer {
        return m_str; // error: template of wrong type
    }
}
