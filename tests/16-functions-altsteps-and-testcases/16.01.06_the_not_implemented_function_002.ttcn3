module M_16_01_06_the_not_implemented_function_002 {

    type component C {}

    function f_double(integer p_x := ???) return integer {
        return p_x * 2;
    }

    testcase TC() runs on C {
        var boolean v_flag := false;
        var integer v_res := 0;
        if (v_flag) {
            v_res := ??? + 1;
        }
        if (v_res == 0 and f_double(8) == 16) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
