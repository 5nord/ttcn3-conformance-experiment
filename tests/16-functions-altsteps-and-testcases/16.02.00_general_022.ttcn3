// @requirement: 16.2.0 -- c) If an altstep includes port operations or uses component variables, constants or timers the associated component type shall be referenced using the `runs on` keywords in the altstep header.
// @id: TTCN3-CORE-16.2.0-025a
// @verdict: pass reject
module M_16_02_00_general_022 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
    }

    altstep a_step() {
        [] p2.receive { // error: component port used without runs on clause
            setverdict(pass);
        }
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(1);
        a_step();
    }

    control {
        execute(TC());
    }
}
