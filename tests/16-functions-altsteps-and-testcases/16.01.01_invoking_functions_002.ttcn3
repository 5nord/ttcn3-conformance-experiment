// @requirement: 16.1.1 -- FunctionRef "(" [ { ActualPar [","] } ] ")"
// @id: TTCN3-CORE-16.1.1-002a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_01_invoking_functions_002 {

    type component C {}

    function f_none() return integer {
        return 0;
    }

    function f_one(integer p_a) return integer {
        return p_a;
    }

    function f_two(integer p_a, integer p_b) return integer {
        return p_a * p_b;
    }

    testcase TC() runs on C {
        if (f_none() == 0 and f_one(4) == 4 and f_two(2, 3) == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
