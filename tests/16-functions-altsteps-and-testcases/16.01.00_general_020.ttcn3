// @requirement: 16.1.0 -- a) A function without runs on clause shall never invoke a function or altstep or activate an altstep as default with a runs on clause locally.
// @id: TTCN3-CORE-16.1.0-022c
// @verdict: pass reject
module M_16_01_00_general_020 {

    type component C {
        timer T := 0.1;
    }

    altstep a_runsOn() runs on C {
        [] T.timeout {}
    }

    function f_noRunsOn() {
        var default v_def := activate(a_runsOn()); // error: activating an altstep with runs on clause
    }

    testcase TC() runs on C {
        f_noRunsOn();
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
