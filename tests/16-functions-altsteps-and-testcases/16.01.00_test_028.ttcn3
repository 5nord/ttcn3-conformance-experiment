// @requirement: 16.1.0 -- g) A return statement in a value returning function shall always have a value expression compatible to the type specified in the function header return clause.
// @id: TTCN3-CORE-16.1.0-030a
// @verdict: pass reject
module M_16_01_00_test_028 {

    function f_myFunction() return integer {
        return "seven"; // error: value of wrong type
    }
}
