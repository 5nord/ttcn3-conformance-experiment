// @requirement: 16.1.2 -- Col1: Convert integer value to bitstring value; Table 15: List of TTCN-3 predefined functions: int2bit
// @id: TTCN3-CORE-16.1.2-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_004 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_res := int2bit(5, 4);
        if (v_res == '0101'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
