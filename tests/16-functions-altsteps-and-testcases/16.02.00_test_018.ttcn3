// @verdict: pass reject
module M_16_02_00_test_018 {

    type component C {}

    altstep @control a_ctrl() system C { // error: system clause in @control altstep
        [] any timer.timeout {
            log("timeout");
        }
    }

    testcase TC() runs on C {
        setverdict(pass);
    }

    control {
        timer T_guard := 0.1;
        execute(TC());
        T_guard.start;
        a_ctrl();
    }
