// @requirement: 16.1.2 -- Col1: Convert integer value to float value; Table 15: List of TTCN-3 predefined functions: int2float
// @id: TTCN3-CORE-16.1.2-018a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_009 {

    type component C {}

    testcase TC() runs on C {
        var float v_res := int2float(3);
        if (v_res == 3.0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
