// @requirement: 16.1.2 -- Col1: Decode a bitstring into a value; Table 15: List of TTCN-3 predefined functions: decvalue
// @id: TTCN3-CORE-16.1.2-051a
// @verdict: pass accept, noexecution
module M_16_01_02_test_042 {

    type component C {}

    type record R {
        integer f1
    }

    function f_decode(bitstring p_enc) return integer {
        var bitstring v_enc := p_enc;
        var R v_r;
        var integer v_res := decvalue(v_enc, v_r);
        return v_res;
    }
}
