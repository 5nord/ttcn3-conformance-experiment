// @requirement: 16.1.2 -- Col1: Convert integer value to octetstring value; Table 15: List of TTCN-3 predefined functions: int2oct
// @id: TTCN3-CORE-16.1.2-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_007 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_res := int2oct(255, 2);
        if (v_res == '00FF'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
