// @requirement: 16.1.2 -- Col1: Convert bitstring value to hexstring value; Table 15: List of TTCN-3 predefined functions: bit2hex
// @id: TTCN3-CORE-16.1.2-025a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_016 {

    type component C {}

    testcase TC() runs on C {
        var hexstring v_res := bit2hex('111010111'B);
        if (v_res == '1D7'H) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
