// @requirement: 16.1.0 -- Functions may be parameterized.
// @id: TTCN3-CORE-16.1.0-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_00_general_010 {

    type component C {}

    function f_param(in integer p_in, inout integer p_inout, out integer p_out,
                     template integer p_tmpl) {
        p_inout := p_inout * 10;
        p_out := p_in + 1;
        if (not match(p_in, p_tmpl)) {
            p_out := -1;
        }
    }

    testcase TC() runs on C {
        var integer v_inout := 3;
        var integer v_out;
        f_param(4, v_inout, v_out, ?);
        if (v_inout == 30 and v_out == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
