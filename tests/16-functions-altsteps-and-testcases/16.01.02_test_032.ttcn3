// @requirement: 16.1.2 -- Col1: Convert charstring value to float value; Table 15: List of TTCN-3 predefined functions: str2float
// @id: TTCN3-CORE-16.1.2-041a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_032 {

    type component C {}

    testcase TC() runs on C {
        var float v_res := str2float("1.5");
        if (v_res == 1.5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
