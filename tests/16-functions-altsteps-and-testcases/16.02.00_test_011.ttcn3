// @requirement: 16.2.0 -- Altsteps may have an mtc clause.
// @id: TTCN3-CORE-16.2.0-013a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_00_test_011 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
    }

    altstep a_step() runs on C mtc C {
        [] p2.receive(integer:1) {
            var C v_mtc := mtc;
            if (v_mtc == self) {
                setverdict(pass);
            } else {
                setverdict(fail);
            }
        }
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        p1.send(1);
        a_step();
    }

    control {
        execute(TC());
    }
}
