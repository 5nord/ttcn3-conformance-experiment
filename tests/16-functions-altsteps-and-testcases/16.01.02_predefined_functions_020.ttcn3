// @requirement: 16.1.2 -- Col1: Convert hexstring value to bitstring value; Table 15: List of TTCN-3 predefined functions: hex2bit
// @id: TTCN3-CORE-16.1.2-029a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_020 {

    type component C {}

    testcase TC() runs on C {
        var bitstring v_res := hex2bit('A3'H);
        if (v_res == '10100011'B) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
