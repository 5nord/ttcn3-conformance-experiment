// @requirement: 16.1.4 -- f) Calling the rnd predefined function (see notes 4 and 6).
// @id: TTCN3-CORE-16.1.4-009a
// @verdict: pass reject
module M_16_01_04_invoking_functions_from_specific_places_007 {

    type component C {
        timer T := 0.1;
    }

    function f_guard() runs on C return boolean {
        return rnd() < 2.0; // error: rnd called in a function called in a guard
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
