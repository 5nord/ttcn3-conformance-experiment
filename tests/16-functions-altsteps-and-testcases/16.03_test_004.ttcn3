// @requirement: 16.3 -- The result of a test case execution is a test verdict.
// @id: TTCN3-CORE-16.3-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_03_test_004 {

    type component C {}

    testcase TC_first() runs on C {
        setverdict(inconc);
    }

    testcase TC(verdicttype p_res) runs on C {
        if (p_res == inconc) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        var verdicttype v_res := execute(TC_first());
        execute(TC(v_res));
    }
}
