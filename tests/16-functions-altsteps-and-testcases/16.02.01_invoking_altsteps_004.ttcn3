// @requirement: 16.2.1 -- The invocation of an altstep causes no new snapshot and the evaluation of the top alternatives of an altstep is done by using the actual snapshot of the alt statement from which the altstep was called.
// @id: TTCN3-CORE-16.2.1-004b
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_01_invoking_altsteps_004 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
        timer T;
    }

    altstep a_step() runs on C {
        [] p.receive(integer:5) {
            setverdict(pass);
        }
    }

    testcase TC() runs on C {
        connect(self:p, self:p);
        p.send(5);
        T.start(1.0);
        alt {
            [] p.receive(integer:99) {
                setverdict(fail);
            }
            [] a_step();
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
