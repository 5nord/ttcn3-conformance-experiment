// @requirement: 16.1.2 -- Col1: Convert universal charstring value to octetstring value; Table 15: List of TTCN-3 predefined functions: unichar2oct
// @id: TTCN3-CORE-16.1.2-022a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_013 {

    type component C {}

    testcase TC() runs on C {
        var universal charstring v_str := "AB";
        var octetstring v_res := unichar2oct(v_str, "UTF-8");
        if (v_res == '4142'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
