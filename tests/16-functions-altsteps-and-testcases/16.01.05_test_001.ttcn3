// @requirement: 16.1.5 -- Explicit control functions are declared either by use of the name control or by use of the @control modifier.
// @id: TTCN3-CORE-16.1.5-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_05_test_001 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    function @control f_runTC() {
        execute(TC());
    }

    function control() {
        f_runTC();
    }
}
