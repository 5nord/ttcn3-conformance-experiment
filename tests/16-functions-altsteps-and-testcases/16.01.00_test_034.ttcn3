// @requirement: 16.1.0 -- The one exception to` this rule is if all the necessary component-wide information is passed in the function as parameters.
// @id: TTCN3-CORE-16.1.0-037a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_00_test_034 {

    type component C {
        var integer v_compVar := 1;
    }

    function f_increment(inout integer p_var) {
        p_var := p_var + 1;
    }

    testcase TC() runs on C {
        f_increment(v_compVar);
        if (v_compVar == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
