// @requirement: 16.1.1 -- b) The rules for actual parameter lists shall be followed as defined in clause 5.4.
// @id: TTCN3-CORE-16.1.1-010a
// @verdict: pass reject
module M_16_01_01_test_009 {

    type component C {}

    function f_add(integer p_a, integer p_b) return integer {
        return p_a + p_b;
    }

    testcase TC() runs on C {
        var integer v_res := f_add(1, 2, 3); // error: too many actual parameters
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
