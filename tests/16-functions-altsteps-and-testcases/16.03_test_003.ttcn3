// @verdict: pass accept, ttcn3verdict:pass
module M_16_03_test_003 {

    type component C {}

    type component S {}

    testcase TC(integer p_val, template integer p_tmpl) runs on C system S {
        if (match(p_val, p_tmpl)) {
