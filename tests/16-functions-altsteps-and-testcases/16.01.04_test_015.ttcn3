// @requirement: 16.1.4 -- l) The setencode operation (see note 8 and clause 27.9).
// @id: TTCN3-CORE-16.1.4-015a
// @verdict: pass reject
module M_16_01_04_test_015 {

    type record R {
        integer f1
    } with {
        encode "Codec1";
        encode "Codec2"
    }

    type port P message {
        inout R
    }

    type component C {
        port P p;
        timer T := 0.1;
    }

    function f_guard() runs on C return boolean {
        p.setencode(R, "Codec1"); // error: setencode in a function called in a guard
        return true;
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
