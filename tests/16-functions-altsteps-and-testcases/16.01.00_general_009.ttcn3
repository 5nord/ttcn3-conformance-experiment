// @requirement: 16.1.0 -- Execution of a return statement in the body of the function causes evaluation of the return value or template, the function to terminate and to return the result to the location of the call of the function.
// @id: TTCN3-CORE-16.1.0-007c
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_00_general_009 {

    type component C {
        var integer v_step := 0;
    }

    function f_value() runs on C return integer {
        v_step := 1;
        return 5;
    }

    testcase TC() runs on C {
        var integer v_res := f_value() + 1;
        if (v_step == 1) {
            v_step := 2;
        }
        if (v_res == 6 and v_step == 2) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
