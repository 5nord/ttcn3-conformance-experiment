// @requirement: 16.1.2 -- Col1: Returns the host id of the test component or module; Table 15: List of TTCN-3 predefined functions: hostid
// @id: TTCN3-CORE-16.1.2-060a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_051 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_id := hostid();
        if (lengthof(v_id) >= 0) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
