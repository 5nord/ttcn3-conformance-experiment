// @requirement: 16.1.2 -- Col1: Convert hexstring value to integer value; Table 15: List of TTCN-3 predefined functions: hex2int
// @id: TTCN3-CORE-16.1.2-028a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_test_019 {

    type component C {}

    testcase TC() runs on C {
        var integer v_res := hex2int('1FF'H);
        if (v_res == 511) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
