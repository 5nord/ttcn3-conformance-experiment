// @requirement: 16.1.2 -- Col1: Convert hexstring value to charstring value; Table 15: List of TTCN-3 predefined functions: hex2str
// @id: TTCN3-CORE-16.1.2-031a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_022 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_res := hex2str('AB01'H);
        if (v_res == "AB01") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
