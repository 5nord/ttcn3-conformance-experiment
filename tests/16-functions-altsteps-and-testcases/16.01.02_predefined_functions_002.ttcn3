// @requirement: 16.1.2 -- Col1: Conversion functions; Table 15: List of TTCN-3 predefined functions: Convert integer value to charstring value; Col3: int2char
// @id: TTCN3-CORE-16.1.2-011a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_002 {

    type component C {}

    testcase TC() runs on C {
        var charstring v_res := int2char(65);
        if (v_res == "A") {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
