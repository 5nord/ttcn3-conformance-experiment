// @requirement: 16.2.0 -- Altsteps may have a system clause.
// @id: TTCN3-CORE-16.2.0-016a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_00_general_014 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
    }

    altstep a_step() runs on C system C {
        [] p2.receive(integer:1) {
            var C v_sys := system;
            if (v_sys != self) {
                setverdict(pass);
            } else {
                setverdict(fail);
            }
        }
    }

    testcase TC() runs on C system C {
        connect(self:p1, self:p2);
        p1.send(1);
        a_step();
    }

    control {
        execute(TC());
    }
}
