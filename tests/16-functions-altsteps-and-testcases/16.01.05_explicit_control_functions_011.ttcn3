// @requirement: 16.1.5 -- g) When invoking a module control function explicitly, the compatibility to the test component type of the invoking control component as described in clause 6.3.2.7 need to be fulfilled.
// @id: TTCN3-CORE-16.1.5-009a
// @verdict: pass reject
module M_16_01_05_explicit_control_functions_011 {

    import from M_16_01_05_explicit_control_functions_011_A all;

    type component CB {
        var float v_f := 0.0;
    }

    function control() runs on CB {
        M_16_01_05_explicit_control_functions_011_A.control(); // error: CB is not runs on compatible with CA
    }
}

module M_16_01_05_explicit_control_functions_011_A {

    type component C {}

    type component CA {
        var integer v_i := 0;
    }

    testcase TC() runs on C {
        setverdict(pass);
    }

    function control() runs on CA {
        execute(TC());
    }
}
