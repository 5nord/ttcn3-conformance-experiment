// @requirement: 16.1.4 -- d) All timer operations, i.e. start (timer), stop (timer), running (timer), read, timeout (see notes 4 and 6).
// @id: TTCN3-CORE-16.1.4-007a
// @verdict: pass reject
module M_16_01_04_invoking_functions_from_specific_places_005 {

    type component C {
        timer T := 0.1;
        timer T_other := 1.0;
    }

    function f_guard() runs on C return boolean {
        T_other.start; // error: timer operation in a function called in a guard
        return true;
    }

    testcase TC() runs on C {
        T.start;
        alt {
            [f_guard()] T.timeout {
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
