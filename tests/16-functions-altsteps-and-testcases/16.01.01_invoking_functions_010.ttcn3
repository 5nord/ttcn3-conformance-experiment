// @requirement: 16.1.1 -- c) Special restrictions apply to functions bound to test components using the start test component operation. These restrictions are described in clause 21.3.2.
// @id: TTCN3-CORE-16.1.1-011a
// @verdict: pass reject
module M_16_01_01_invoking_functions_010 {

    type component C {}

    function f_behaviour() {
        setverdict(pass);
    }

    testcase TC() runs on C {
        var C v_ptc := C.create;
        v_ptc.start(f_behaviour()); // error: started function has no runs on clause
        v_ptc.done;
    }

    control {
        execute(TC());
    }
}
