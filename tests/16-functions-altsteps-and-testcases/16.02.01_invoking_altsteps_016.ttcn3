// @requirement: 16.2.1 -- Dynamically unmapped and disconnected ports contribute to a snapshot in the same manner as mapped and connected ports.
// @id: TTCN3-CORE-16.2.1-014a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_01_invoking_altsteps_016 {

    type port P message {
        inout integer;
    }

    type component C {
        port P p;
        timer T;
    }

    testcase TC() runs on C {
        connect(self:p, self:p);
        p.send(1);
        p.check;
        disconnect(self:p, self:p);
        T.start(1.0);
        alt {
            [] p.receive(integer:1) {
                setverdict(pass);
            }
            [] T.timeout {
                setverdict(fail);
            }
        }
    }

    control {
        execute(TC());
    }
}
