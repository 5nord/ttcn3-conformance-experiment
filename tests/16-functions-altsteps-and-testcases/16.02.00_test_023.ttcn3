// @requirement: 16.2.0 -- The one exception to this rule is if all ports, variables, constants and timers used within the altstep are passed in as parameters.
// @id: TTCN3-CORE-16.2.0-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_00_test_023 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        var integer v_count := 0;
        const integer c_inc := 1;
        timer T_guard := 1.0;
    }

    altstep a_step(P p_port, timer p_timer, inout integer p_count, in integer p_inc) {
        [] p_port.receive(integer:1) {
            p_count := p_count + p_inc;
        }
        [] p_timer.timeout {
            setverdict(fail);
        }
    }

    testcase TC() runs on C {
        connect(self:p1, self:p2);
        T_guard.start;
        p1.send(1);
        a_step(p2, T_guard, v_count, c_inc);
        if (v_count == 1) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
