// @requirement: 16.1.0 -- j) If a function references the names of definitions that are defined inside a component type definition, the component type shall be referenced using the runs `on keywords in the function header.
// @id: TTCN3-CORE-16.1.0-036a
// @verdict: pass reject
module M_16_01_00_test_033 {

    type component C {
        var integer v_compVar := 1;
    }

    function f_myFunction() return integer {
        return v_compVar; // error: component variable referenced without runs on clause
    }
}
