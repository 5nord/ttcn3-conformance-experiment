// @requirement: 16.1.5 -- d) Parameters and the return type of module control functions shall not be of a default type and shall not be of a structured type that contains fields of a default type on any level of nesting.
// @id: TTCN3-CORE-16.1.5-006a
// @verdict: pass reject
module M_16_01_05_test_007 {

    type component C {}

    testcase TC() runs on C {
        setverdict(pass);
    }

    function control(default p_def) { // error: parameter of default type
        execute(TC());
    }
}
