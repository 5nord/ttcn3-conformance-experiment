// @requirement: 16.1.1 -- A function is invoked by referring to its name and providing the actual list of parameters.
// @id: TTCN3-CORE-16.1.1-001a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_01_test_001 {

    type component C {}

    function f_add(integer p_a, integer p_b) return integer {
        return p_a + p_b;
    }

    testcase TC() runs on C {
        var integer v_res := f_add(2, 3);
        if (v_res == 5) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
