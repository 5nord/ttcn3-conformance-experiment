// @requirement: 16.1.2 -- Col1: Convert bitstring value to octetstring value; Table 15: List of TTCN-3 predefined functions: bit2oct
// @id: TTCN3-CORE-16.1.2-026a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_01_02_predefined_functions_017 {

    type component C {}

    testcase TC() runs on C {
        var octetstring v_res := bit2oct('111010111'B);
        if (v_res == '01D7'O) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
