// @requirement: 16.1.4 -- NOTE 8: Using out or inout parameters and the setencode operation causes an error because this may lead to different results of subsequent evaluations of the same snapshot.
// @id: TTCN3-CORE-16.1.4-027a
// @verdict: pass reject
module M_16_01_04_test_023 {

    type component C {
        timer T := 0.1;
    }

    function f_inout(inout integer p_x) return boolean {
        p_x := p_x + 1;
        return true;
    }

    testcase TC() runs on C {
        var integer v_x := 0;
        T.start;
        alt {
            [f_inout(v_x)] T.timeout { // error: function with inout parameter called in a guard
                setverdict(pass);
            }
        }
    }

    control {
        execute(TC());
    }
}
