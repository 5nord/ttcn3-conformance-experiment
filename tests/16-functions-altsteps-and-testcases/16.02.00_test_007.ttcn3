// @requirement: 16.2.0 -- They can both be used as activated default alternatives and as top-level alternatives in other alt statement blocks.
// @id: TTCN3-CORE-16.2.0-009a
// @verdict: pass accept, ttcn3verdict:pass
module M_16_02_00_test_007 {

    type port P message {
        inout integer
    }

    type component C {
        port P p1, p2;
        var integer v_count := 0;
        timer T_guard := 1.0;
    }

    altstep a_normal() runs on C {
        [] p2.receive(integer:3) {
            v_count := v_count + 1;
        }
    }

    altstep interleave a_il() runs on C {
        [] p2.receive(integer:1) {
            v_count := v_count + 1;
        }
        [] p2.receive(integer:2) {
            v_count := v_count + 1;
        }
    }

    testcase TC() runs on C {
        var default v_def;
        connect(self:p1, self:p2);
        T_guard.start;

        // top-level alternatives
        p1.send(1);
        p1.send(2);
        p1.send(3);
        alt {
            [] a_il();
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
        alt {
            [] a_normal();
            [] T_guard.timeout {
                setverdict(fail);
            }
        }

        // activated defaults
        v_def := activate(a_normal());
        p1.send(3);
        alt {
            [] p2.receive(integer:100) {
                setverdict(fail);
            }
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
        deactivate(v_def);
        v_def := activate(a_il());
        p1.send(2);
        p1.send(1);
        alt {
            [] p2.receive(integer:100) {
                setverdict(fail);
            }
            [] T_guard.timeout {
                setverdict(fail);
            }
        }
        deactivate(v_def);

        if (v_count == 6) {
            setverdict(pass);
        } else {
            setverdict(fail);
        }
    }

    control {
        execute(TC());
    }
}
