// @requirement: 16.1.3 -- Deterministic functions are safe to be used when called from specific places where non-determinism could lead to unexpected side effects (see clause 16.1.4).
// @id: TTCN3-CORE-16.1.3-006a
// @verdict: pass accept, noexecution
module M_16_01_03_test_008 {

    type component C {
        timer T := 0.1;
    }

    external function @deterministic fx_check(integer p_a) return boolean;

    testcase TC() runs on C {
        T.start;
        alt {
            [fx_check(1)] T.timeout {
                setverdict(pass);
            }
        }
    }
}
