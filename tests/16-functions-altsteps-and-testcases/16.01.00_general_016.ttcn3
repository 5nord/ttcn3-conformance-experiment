// @requirement: 16.1.0 -- If the system clause is not present, the type of the system component reference is unknown in the scope of this function.
// @id: TTCN3-CORE-16.1.0-015a
// @verdict: pass reject
module M_16_01_00_general_016 {

    type component C {}

    type component S {}

    function f_noSystem() runs on C {
        var S v_system := system; // error: system type unknown without system clause
    }

    testcase TC() runs on C system S {
        f_noSystem();
        setverdict(pass);
    }

    control {
        execute(TC());
    }
}
